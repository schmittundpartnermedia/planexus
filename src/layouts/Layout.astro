---
import '../styles/global.css';
import Navbar from '../components/Navbar';
import Footer from '../components/Footer.astro';
import CookieConsent from '../components/CookieConsent';
import { planexusPostalAddress, planexusGeo, planexusContact } from '../lib/planexus-address';
import { SITE_ORIGIN, canonicalUrlForPath, stripTrailingSlash } from '../lib/canonical';
import {
  detectLocale,
  getAlternatePath,
  CH_PATHS,
  AT_PATHS,
} from '../i18n/routes';
import { t } from '../i18n/ui';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  type?: string;
  schema?: object;
  ogImage?: string;
  robots?: string;
}

const {
  title,
  description,
  canonical,
  type = 'website',
  schema,
  ogImage,
  robots = 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1',
} = Astro.props;
const isNoindex = robots.startsWith('noindex');
const fullTitle = title.includes('Planexus') ? title : `${title} | Planexus`;
const siteUrl = SITE_ORIGIN;

const rawPath = (canonical && canonical.length > 0) ? canonical : Astro.url.pathname;
const normalizedPath = stripTrailingSlash(rawPath);
const canonicalUrl = canonicalUrlForPath(normalizedPath);
const locale = detectLocale(normalizedPath);
const copy = t(locale);
const alternatePath = getAlternatePath(normalizedPath, locale);
const alternateUrl = canonicalUrlForPath(alternatePath);
const deUrl = locale === 'de' ? canonicalUrl : alternateUrl;
const enUrl = locale === 'en' ? canonicalUrl : alternateUrl;

let ogImageUrl: string;
if (!ogImage) {
  ogImageUrl = `${siteUrl}/opengraph.jpg`;
} else if (ogImage.startsWith('http')) {
  ogImageUrl = ogImage.replace(/^https?:\/\/(www\.)?planexus\.de/, siteUrl);
} else {
  ogImageUrl = `${siteUrl}${ogImage}`;
}

const pathForGeo = normalizedPath || '/';
const isCH = CH_PATHS.includes(pathForGeo);
const isAT = AT_PATHS.includes(pathForGeo);
const htmlLang = locale === 'en' ? 'en' : 'de';
const ogLocale = locale === 'en' ? 'en_GB' : isCH ? 'de_CH' : isAT ? 'de_AT' : 'de_DE';
const ogLocaleAlternate = locale === 'en' ? (isCH ? 'de_CH' : isAT ? 'de_AT' : 'de_DE') : 'en_GB';
---

<!DOCTYPE html>
<html lang={htmlLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5" />

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Planexus GmbH" />
    <meta name="robots" content={robots} />
    <meta name="googlebot" content={isNoindex ? 'noindex, nofollow' : 'index, follow'} />
    <meta name="bingbot" content={isNoindex ? 'noindex, nofollow' : 'index, follow'} />
    <meta name="geo.region" content={isCH ? "CH" : isAT ? "AT" : "DE"} />
    <meta name="geo.placename" content={isCH ? copy.geo.ch : isAT ? copy.geo.at : copy.geo.de} />
    <meta name="language" content={locale === 'en' ? 'English' : 'German'} />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:locale:alternate" content={ogLocaleAlternate} />
    <meta property="og:site_name" content="Planexus GmbH" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#bbd700" />
    <link rel="canonical" href={canonicalUrl} />

    <link rel="alternate" hreflang="de" href={deUrl} />
    <link rel="alternate" hreflang="en" href={enUrl} />
    <link rel="alternate" hreflang="x-default" href={deUrl} />

    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('consent', 'default', {
        'ad_storage': 'denied',
        'ad_user_data': 'denied',
        'ad_personalization': 'denied',
        'analytics_storage': 'denied',
        'functionality_storage': 'denied',
        'personalization_storage': 'denied',
        'security_storage': 'granted',
        'wait_for_update': 500
      });
      gtag('set', 'ads_data_redaction', true);
      gtag('set', 'url_passthrough', true);

      try {
        var savedConsent = localStorage.getItem('planexus_consent');
        if (savedConsent) {
          var consent = JSON.parse(savedConsent);
          var analytics = consent.analytics ? 'granted' : 'denied';
          var marketing = consent.marketing ? 'granted' : 'denied';
          gtag('consent', 'update', {
            'analytics_storage': analytics,
            'ad_storage': marketing,
            'ad_user_data': marketing,
            'ad_personalization': marketing
          });
          dataLayer.push({
            'event': 'consent_update',
            'analytics_storage': analytics,
            'ad_storage': marketing,
            'ad_user_data': marketing,
            'ad_personalization': marketing
          });
        }
      } catch (e) {}
    </script>

    <script is:inline>
      (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
      new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
      j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
      'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
      })(window,document,'script','dataLayer','GTM-PDDSZ44P');
    </script>

    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Organization",
      "name": "Planexus GmbH",
      "image": "https://planexus.de/android-chrome-512x512.png",
      "alternateName": "Planexus",
      "url": canonicalUrlForPath('/'),
      "logo": `${siteUrl}/android-chrome-512x512.png`,
      "description": copy.schema.orgDescription,
      "inLanguage": locale === 'en' ? 'en' : 'de-DE',
      "foundingDate": "2025",
      "award": copy.schema.award,
      "areaServed": [
        { "@type": "Country", "name": "Germany" },
        { "@type": "Country", "name": "Switzerland" },
        { "@type": "Country", "name": "Austria" }
      ],
      "contactPoint": {
        "@type": "ContactPoint",
        "telephone": planexusContact.telephone,
        "email": planexusContact.email,
        "contactType": "customer service",
        "availableLanguage": ["German", "English"]
      },
      "address": planexusPostalAddress,
      "sameAs": [
        "https://www.facebook.com/profile.php?id=61578221935839",
        "https://www.linkedin.com/company/planexus-gmbh"
      ]
    })} />

    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "LocalBusiness",
      "name": "Planexus GmbH",
      "image": `${siteUrl}/images/labtogo-industrie.webp`,
      "description": copy.schema.localDescription,
      "inLanguage": locale === 'en' ? 'en' : 'de-DE',
      "url": canonicalUrlForPath('/'),
      "priceRange": "€€€",
      "address": planexusPostalAddress,
      "geo": planexusGeo,
      "openingHoursSpecification": {
        "@type": "OpeningHoursSpecification",
        "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
        "opens": "08:00",
        "closes": "17:00"
      },
      ...planexusContact,
    })} />

    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebSite",
      "name": "Planexus GmbH",
      "url": locale === 'en' ? canonicalUrlForPath('/en') : canonicalUrlForPath('/'),
      "inLanguage": locale === 'en' ? 'en' : 'de-DE',
    })} />

    {schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}

    <slot name="head" />

    <link rel="preload" href="/fonts/Inter-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/SpaceGrotesk-latin.woff2" as="font" type="font/woff2" crossorigin />
  </head>
  <body class="min-h-screen bg-background text-foreground flex flex-col font-sans">
    <noscript>
      <iframe
        src="https://www.googletagmanager.com/ns.html?id=GTM-PDDSZ44P"
        height="0"
        width="0"
        style="display:none;visibility:hidden"
      ></iframe>
    </noscript>
    <Navbar client:load locale={locale} alternateHref={alternatePath} />
    <main class="flex-grow">
      <slot />
    </main>
    <Footer />
    <CookieConsent client:load locale={locale} />
  </body>
</html>
