---
import '../styles/global.css';
import Navbar from '../components/Navbar';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  type?: string;
  schema?: object;
  ogImage?: string;
}

const { title, description, canonical, type = 'website', schema, ogImage } = Astro.props;
const fullTitle = title.includes('Planexus') ? title : `${title} | Planexus GmbH`;
const siteUrl = 'https://planexus.de';

// Selbst-referenzierender Canonical: Wenn keine canonical-Prop übergeben wurde,
// Pfad aus Astro.url.pathname ableiten. Trailing-Slash-Normalisierung
// (Root bleibt "/", alles andere ohne Trailing Slash).
const rawPath = (canonical && canonical.length > 0) ? canonical : Astro.url.pathname;
const normalizedPath = rawPath === '/' ? '/' : rawPath.replace(/\/+$/, '');
const canonicalUrl = `${siteUrl}${normalizedPath}`;

// ogImage-Normalisierung: erzwingt www-Domain (auch wenn Autor planexus.de ohne www schrieb).
let ogImageUrl: string;
if (!ogImage) {
  ogImageUrl = `${siteUrl}/opengraph.jpg`;
} else if (ogImage.startsWith('http')) {
  ogImageUrl = ogImage.replace(/^https?:\/\/(www\.)?planexus\.de/, siteUrl);
} else {
  ogImageUrl = `${siteUrl}${ogImage}`;
}

// Hreflang-Mapping: DACH-Strategie. Eine Sprachversion (Deutsch),
// regionale Targeting-Signale für DE/CH/AT.
const chPaths = ['/laborcontainer-zuerich', '/laborcontainer-basel', '/laborcontainer-bern'];
const atPaths = ['/laborcontainer-wien', '/laborcontainer-graz', '/laborcontainer-linz'];
const isCH = chPaths.includes(normalizedPath);
const isAT = atPaths.includes(normalizedPath);
const isDE = !isCH && !isAT;
---

<!DOCTYPE html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5" />

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Planexus GmbH" />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <meta name="googlebot" content="index, follow" />
    <meta name="bingbot" content="index, follow" />
    <meta name="geo.region" content={isCH ? "CH" : isAT ? "AT" : "DE"} />
    <meta name="geo.placename" content={isCH ? "Schweiz" : isAT ? "Österreich" : "Deutschland"} />
    <meta name="language" content="German" />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={isCH ? "de_CH" : isAT ? "de_AT" : "de_DE"} />
    <meta property="og:site_name" content="Planexus GmbH" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#bbd700" />
    <link rel="canonical" href={canonicalUrl} />

    <link rel="alternate" hreflang="de" href={canonicalUrl} />
    {isDE && <link rel="alternate" hreflang="de-DE" href={canonicalUrl} />}
    {isCH && <link rel="alternate" hreflang="de-CH" href={canonicalUrl} />}
    {isAT && <link rel="alternate" hreflang="de-AT" href={canonicalUrl} />}
    <link rel="alternate" hreflang="x-default" href={canonicalUrl} />

    <script async src="https://www.googletagmanager.com/gtag/js?id=G-FZ9YKTCQFJ"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-FZ9YKTCQFJ');
    </script>

    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Organization",
      "name": "Planexus GmbH",
      "image": "https://planexus.de/android-chrome-512x512.png",
      "alternateName": "Planexus",
      "url": siteUrl,
      "logo": `${siteUrl}/android-chrome-512x512.png`,
      "description": "Spezialist für Laborcontainer, mobile Labore und Modulbau. Planung, Fertigung und schlüsselfertige Übergabe von Containerlaboren.",
      "foundingDate": "2014",
      "areaServed": [
        { "@type": "Country", "name": "Germany" },
        { "@type": "Country", "name": "Switzerland" },
        { "@type": "Country", "name": "Austria" }
      ],
      "contactPoint": {
        "@type": "ContactPoint",
        "telephone": "+49 7435 7519 700",
        "contactType": "customer service",
        "availableLanguage": ["German", "English"]
      },
      "sameAs": [
        "https://www.facebook.com/profile.php?id=61578221935839",
        "https://www.linkedin.com/company/planexus-gmbh"
      ]
    })} />

    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "LocalBusiness",
      "name": "Planexus GmbH",
      "image": "https://planexus.de/images/labtogo-industrie.webp",
      "description": "Spezialist für Laborcontainer und Modulbau",
      "url": siteUrl,
      "priceRange": "€€€",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "Am Steinbach 8",
        "addressLocality": "Albstadt",
        "postalCode": "72459",
        "addressCountry": "DE"
      },
      "geo": {
        "@type": "GeoCoordinates",
        "latitude": 48.2180461,
        "longitude": 8.9140541
      },
      "openingHoursSpecification": {
        "@type": "OpeningHoursSpecification",
        "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
        "opens": "08:00",
        "closes": "17:00"
      },
      "telephone": "+49 7435 7519 700",
      "email": "info@planexus.de"
    })} />

    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebSite",
      "name": "Planexus GmbH",
      "url": siteUrl,
      "potentialAction": {
        "@type": "SearchAction",
        "target": {
          "@type": "EntryPoint",
          "urlTemplate": `${siteUrl}/magazin?q={search_term_string}`
        },
        "query-input": "required name=search_term_string"
      }
    })} />

    {schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}

    <slot name="head" />

    <link rel="preload" href="/fonts/Inter-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/SpaceGrotesk-latin.woff2" as="font" type="font/woff2" crossorigin />
  </head>
  <body class="min-h-screen bg-background text-foreground flex flex-col font-sans">
    <Navbar client:load />
    <main class="flex-grow">
      <slot />
    </main>
    <Footer />
  </body>
</html>
