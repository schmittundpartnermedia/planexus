---
export interface Crumb {
  name: string;
  href?: string;
}
export interface Props {
  items: Crumb[];
  variant?: 'light' | 'dark';
  bar?: boolean;
}
const { items, variant = 'light', bar = false } = Astro.props;
const textBase = variant === 'dark' ? 'text-gray-400' : 'text-gray-500';
const textHover = variant === 'dark' ? 'hover:text-primary' : 'hover:text-[#7a9900]';
const textCurrent = variant === 'dark' ? 'text-primary' : 'text-primary font-medium';
---
{bar ? (
  <div class="bg-slate-50 border-b border-gray-100 py-4">
    <div class="container mx-auto px-4">
      <nav class={`flex flex-wrap items-center gap-2 text-sm ${textBase}`} aria-label="Breadcrumb">
        {items.map((item, idx) => (
          <>
            {idx > 0 && (
              <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
            )}
            {item.href && idx < items.length - 1 ? (
              <a href={item.href} class={`${textHover} transition-colors`}>{item.name}</a>
            ) : (
              <span class={textCurrent} aria-current="page">{item.name}</span>
            )}
          </>
        ))}
      </nav>
    </div>
  </div>
) : (
  <nav class={`flex flex-wrap items-center gap-2 text-sm ${textBase}`} aria-label="Breadcrumb">
    {items.map((item, idx) => (
      <>
        {idx > 0 && (
          <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m9 18 6-6-6-6"/></svg>
        )}
        {item.href && idx < items.length - 1 ? (
          <a href={item.href} class={`${textHover} transition-colors`}>{item.name}</a>
        ) : (
          <span class={`${textCurrent} font-medium`} aria-current="page">{item.name}</span>
        )}
      </>
    ))}
  </nav>
)}
