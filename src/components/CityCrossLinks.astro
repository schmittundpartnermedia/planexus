---
import { CITY_SLUGS, cityHref, type Locale } from '../i18n/routes';
import { t } from '../i18n/ui';

export interface Props {
  current: string;
  locale?: Locale;
}
const { current, locale = 'de' } = Astro.props;
const copy = t(locale);

const allCities = Object.values(CITY_SLUGS);
const others = allCities.filter(c => c.de !== current && c.en !== current);
const de = others.filter(c => c.region === 'DE');
const ch = others.filter(c => c.region === 'CH');
const at = others.filter(c => c.region === 'AT');
---
<section class="py-16 md:py-20 bg-white border-t border-gray-100">
  <div class="container mx-auto px-4">
    <div class="max-w-5xl mx-auto">
      <div class="text-center mb-10">
        <div class="text-xs uppercase tracking-wider text-[#7a9900] font-bold mb-3">{copy.cityLinks.kicker}</div>
        <h2 class="text-3xl md:text-4xl font-heading font-bold text-slate-900 mb-3">{copy.cityLinks.title}</h2>
        <p class="text-gray-600 text-lg">{copy.cityLinks.intro}</p>
      </div>

      <div class="grid md:grid-cols-3 gap-6">
        <div class="bg-slate-50 rounded-xl p-6">
          <div class="flex items-center gap-2 mb-4">
            <span class="text-2xl">🇩🇪</span>
            <h3 class="font-bold text-slate-900">{copy.footer.germany}</h3>
          </div>
          <ul class="space-y-2">
            {de.map(c => (
              <li><a href={cityHref(c.de, locale)} class="text-gray-700 hover:text-[#7a9900] hover:underline text-sm font-medium">{copy.cityLinks.prefix} {locale === 'en' ? c.nameEn : c.nameDe}</a></li>
            ))}
          </ul>
        </div>

        <div class="bg-slate-50 rounded-xl p-6">
          <div class="flex items-center gap-2 mb-4">
            <span class="text-2xl">🇨🇭</span>
            <h3 class="font-bold text-slate-900">{copy.footer.switzerland}</h3>
          </div>
          <ul class="space-y-2">
            {ch.map(c => (
              <li><a href={cityHref(c.de, locale)} class="text-gray-700 hover:text-[#7a9900] hover:underline text-sm font-medium">{copy.cityLinks.prefix} {locale === 'en' ? c.nameEn : c.nameDe}</a></li>
            ))}
          </ul>
        </div>

        <div class="bg-slate-50 rounded-xl p-6">
          <div class="flex items-center gap-2 mb-4">
            <span class="text-2xl">🇦🇹</span>
            <h3 class="font-bold text-slate-900">{copy.footer.austria}</h3>
          </div>
          <ul class="space-y-2">
            {at.map(c => (
              <li><a href={cityHref(c.de, locale)} class="text-gray-700 hover:text-[#7a9900] hover:underline text-sm font-medium">{copy.cityLinks.prefix} {locale === 'en' ? c.nameEn : c.nameDe}</a></li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </div>
</section>
