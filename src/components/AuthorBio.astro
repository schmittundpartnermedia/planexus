---
export interface Props {
  city?: string;
}
const { city } = Astro.props;
---
<section class="py-10 bg-white border-y border-gray-100">
  <div class="container mx-auto px-4">
    <div class="max-w-5xl mx-auto">
      <div class="flex flex-col md:flex-row gap-6 items-start md:items-center bg-slate-50 rounded-2xl p-6 md:p-8">
        <div class="w-20 h-20 md:w-24 md:h-24 shrink-0 rounded-full bg-gradient-to-br from-primary/30 to-primary/5 border-2 border-primary/40 flex items-center justify-center">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-10 h-10 text-[#7a9900]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M9 11h6m-6 4h6M7 21h10a2 2 0 0 0 2-2V5a2 2 0 0 0-2-2H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2Z"/><path d="M9 7h6"/></svg>
        </div>
        <div class="flex-1">
          <div class="text-xs uppercase tracking-wider text-[#7a9900] font-bold mb-1">Fachlich verantwortet von</div>
          <h2 class="text-xl md:text-2xl font-heading font-bold text-slate-900 mb-2">Planexus Engineering Team{city ? ` · Standortverantwortung ${city}` : ''}</h2>
          <p class="text-gray-700 leading-relaxed text-sm md:text-base">
            Inhaltlich verantwortet vom <strong class="text-slate-900">Planexus-Engineering-Team</strong> – Bauingenieure, Verfahrenstechniker und Laborplaner mit über 15 Jahren spezialisierter Erfahrung im modularen Laborbau. Planexus GmbH ist Teil der <strong class="text-slate-900">Wesemann Holding GmbH</strong> (Laborbau seit 1949) und realisiert seit 2015 BSL-2-, BSL-3-, GMP- und ATEX-Container für Pharma, Biotech, Forschung und Krisenstäbe in DACH.
          </p>
          <div class="flex flex-wrap gap-x-5 gap-y-1 mt-3 text-xs text-gray-500">
            <span><strong class="text-slate-700">Sitz:</strong> Albstadt, BW</span>
            <span><strong class="text-slate-700">Werk:</strong> Am Steinbach 8, 72459 Albstadt</span>
            <span><strong class="text-slate-700">Auszeichnung:</strong> German CEO Excellence Award 2026</span>
            <span><strong class="text-slate-700">Letzte fachliche Prüfung:</strong> April 2026</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
