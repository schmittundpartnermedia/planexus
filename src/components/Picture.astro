---
/**
 * <Picture> — leichtes Wrapper-Element für WebP + Fallback.
 *
 * Erwartet: einen Bildpfad (z.B. /attached_assets/foo.jpg).
 * Liefert: <picture><source srcset="foo.webp" type="image/webp"><img src="foo.jpg" ...></picture>
 *
 * Voraussetzung: Die WebP-Variante muss neben dem Original existieren
 * (siehe scripts/convert-images-webp.mjs).
 *
 * Wenn kein WebP existiert, wird einfach das Original als <img> gerendert
 * (kein <picture>-Wrapper).
 */
import { existsSync } from 'node:fs';
import { join } from 'node:path';

export interface Props {
  src: string;
  alt: string;
  width?: number;
  height?: number;
  loading?: 'lazy' | 'eager';
  fetchpriority?: 'high' | 'low' | 'auto';
  decoding?: 'sync' | 'async' | 'auto';
  class?: string;
  sizes?: string;
}

const {
  src,
  alt,
  width,
  height,
  loading = 'lazy',
  fetchpriority,
  decoding = 'async',
  class: className,
  sizes,
} = Astro.props;

// WebP-Pendant berechnen
const webpSrc = src.replace(/\.(jpe?g|png)(\?.*)?$/i, '.webp$2');

// Prüfen ob WebP-Datei in public/ existiert (für lokale Pfade)
let hasWebp = false;
if (src.startsWith('/')) {
  const localPath = join('public', webpSrc.split('?')[0]);
  hasWebp = existsSync(localPath);
}
---

{hasWebp ? (
  <picture>
    <source srcset={webpSrc} type="image/webp" sizes={sizes} />
    <img
      src={src}
      alt={alt}
      width={width}
      height={height}
      loading={loading}
      fetchpriority={fetchpriority}
      decoding={decoding}
      class={className}
    />
  </picture>
) : (
  <img
    src={src}
    alt={alt}
    width={width}
    height={height}
    loading={loading}
    fetchpriority={fetchpriority}
    decoding={decoding}
    class={className}
  />
)}
