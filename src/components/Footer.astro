---
import Picture from './Picture.astro';
import { detectLocale, localizeHref, cityHref, CITY_SLUGS } from '../i18n/routes';
import { t } from '../i18n/ui';

const locale = detectLocale(Astro.url.pathname);
const copy = t(locale);
const href = (path: string) => localizeHref(path, locale);
const homeHref = locale === 'en' ? '/en' : '/';
const cities = Object.values(CITY_SLUGS);
---

<footer class="bg-slate-900 border-t border-slate-800 pt-16 pb-8 text-slate-300">
  <div class="container mx-auto px-4">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-12 mb-12">
      <div class="space-y-6">
        <a href={homeHref} class="flex items-center gap-2">
          <Picture src="/images/planexus-logo.png" alt="Planexus" class="h-10 w-auto" width={800} height={169} />
        </a>
        <p class="text-slate-400 text-sm leading-relaxed">
          {copy.footer.tagline}
        </p>
      </div>

      <div>
        <h4 class="font-heading font-bold text-lg mb-6 text-white">{copy.footer.navigation}</h4>
        <ul class="space-y-3">
          <li><a href={href('/ueber-uns')} class="text-slate-400 hover:text-primary transition-colors">{copy.nav.aboutCompany}</a></li>
          <li><a href={href('/ueber-uns/auszeichnungen')} class="text-slate-400 hover:text-primary transition-colors">{copy.nav.awards}</a></li>
          <li><a href={href('/leistungen')} class="text-slate-400 hover:text-primary transition-colors">{copy.nav.services}</a></li>
          <li><a href={href('/projekte')} class="text-slate-400 hover:text-primary transition-colors">{copy.nav.projects}</a></li>
          <li><a href={href('/magazin')} class="text-slate-400 hover:text-primary transition-colors">{copy.nav.magazine}</a></li>
          <li><a href={href('/team')} class="text-slate-400 hover:text-primary transition-colors">{copy.nav.team}</a></li>
          <li><a href={href('/partner')} class="text-slate-400 hover:text-primary transition-colors">{copy.nav.partners}</a></li>
          <li><a href={href('/kontakt')} class="text-slate-400 hover:text-primary transition-colors">{copy.nav.contact}</a></li>
        </ul>
      </div>

      <div>
        <h4 class="font-heading font-bold text-lg mb-6 text-white">{copy.footer.office}</h4>
        <ul class="space-y-4">
          <li class="flex items-start gap-3 text-slate-400">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-primary shrink-0 mt-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0"/><circle cx="12" cy="10" r="3"/></svg>
            <span>Am Steinbach 8<br />72459 Albstadt – Laufen</span>
          </li>
          <li class="flex items-center gap-3 text-slate-400 hover:text-primary transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-primary shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
            <a href="tel:+4974357519700">+49 7435 7519 700</a>
          </li>
          <li class="flex items-center gap-3 text-slate-400 hover:text-primary transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-primary shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
            <a href="mailto:info@planexus.de">info@planexus.de</a>
          </li>
        </ul>
      </div>

      <div>
        <h4 class="font-heading font-bold text-lg mb-6 text-white">{copy.footer.production}</h4>
        <div class="flex items-start gap-3 text-slate-400">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-primary shrink-0 mt-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0"/><circle cx="12" cy="10" r="3"/></svg>
          <span>Emil-Mayer-Straße 1<br />72461 Albstadt</span>
        </div>
      </div>

    </div>

    <div class="border-t border-slate-800 pt-8 mb-8">
      <h4 class="font-heading font-bold text-lg mb-6 text-white">{copy.footer.industries}</h4>
      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-x-8 gap-y-2">
        <a href={href('/branchen')} class="text-slate-300 hover:text-primary transition-colors text-sm font-medium">{copy.footer.industriesOverview}</a>
        <a href={href('/branchen/pharma-biotech')} class="text-slate-400 hover:text-primary transition-colors text-sm">{copy.footer.pharma}</a>
        <a href={href('/branchen/forschung-hochschule')} class="text-slate-400 hover:text-primary transition-colors text-sm">{copy.footer.research}</a>
        <a href={href('/branchen/industrie-werkstoffpruefung')} class="text-slate-400 hover:text-primary transition-colors text-sm">{copy.footer.industry}</a>
        <a href={href('/branchen/bildung')} class="text-slate-400 hover:text-primary transition-colors text-sm">{copy.footer.education}</a>
        <a href={href('/branchen/public-health-krisenvorsorge')} class="text-slate-400 hover:text-primary transition-colors text-sm">{copy.footer.publicHealth}</a>
        <a href={href('/branchen/energiewende-h2-batterie')} class="text-slate-400 hover:text-primary transition-colors text-sm">{copy.footer.energy}</a>
        <a href={href('/branchen/oel-gas')} class="text-slate-400 hover:text-primary transition-colors text-sm">{copy.footer.oilGas}</a>
      </div>
    </div>

    <div class="border-t border-slate-800 pt-8 mb-12">
      <h4 class="font-heading font-bold text-lg mb-6 text-white">{copy.footer.locations}</h4>
      <div class="grid grid-cols-1 md:grid-cols-4 gap-8">
        <div>
          <h5 class="text-sm font-bold text-slate-300 uppercase tracking-wider mb-4">{copy.footer.germany}</h5>
          <ul class="space-y-2">
            {cities.filter(c => c.region === 'DE').map(c => (
              <li><a href={cityHref(c.de, locale)} class="text-slate-400 hover:text-primary transition-colors text-sm">{locale === 'en' ? c.nameEn : c.nameDe}</a></li>
            ))}
          </ul>
        </div>
        <div>
          <h5 class="text-sm font-bold text-slate-300 uppercase tracking-wider mb-4">{copy.footer.switzerland}</h5>
          <ul class="space-y-2">
            {cities.filter(c => c.region === 'CH').map(c => (
              <li><a href={cityHref(c.de, locale)} class="text-slate-400 hover:text-primary transition-colors text-sm">{locale === 'en' ? c.nameEn : c.nameDe}</a></li>
            ))}
          </ul>
        </div>
        <div>
          <h5 class="text-sm font-bold text-slate-300 uppercase tracking-wider mb-4">{copy.footer.austria}</h5>
          <ul class="space-y-2">
            {cities.filter(c => c.region === 'AT').map(c => (
              <li><a href={cityHref(c.de, locale)} class="text-slate-400 hover:text-primary transition-colors text-sm">{locale === 'en' ? c.nameEn : c.nameDe}</a></li>
            ))}
          </ul>
        </div>
        <div>
          <h5 class="text-sm font-bold text-slate-300 uppercase tracking-wider mb-4">{copy.footer.service}</h5>
          <ul class="space-y-2">
            <li><a href={href('/laborcontainer')} class="text-slate-400 hover:text-primary transition-colors text-sm">{copy.footer.overview}</a></li>
            <li><a href={href('/laborcontainer-mieten')} class="text-slate-400 hover:text-primary transition-colors text-sm">{copy.nav.rent}</a></li>
            <li><a href={href('/laborcontainer-kaufen')} class="text-slate-400 hover:text-primary transition-colors text-sm">{copy.nav.buy}</a></li>
            <li><a href={href('/laborcontainer/labtogo')} class="text-slate-400 hover:text-primary transition-colors text-sm">LABtoGO</a></li>
            <li><a href={href('/leistungen')} class="text-slate-400 hover:text-primary transition-colors text-sm">{copy.footer.allServices}</a></li>
            <li><a href={href('/kontakt')} class="text-slate-400 hover:text-primary transition-colors text-sm">{copy.footer.requestConsulting}</a></li>
          </ul>
        </div>
      </div>
    </div>

    <div class="border-t border-slate-800 pt-8 flex flex-col md:flex-row justify-between items-center gap-4 text-sm text-slate-500">
      <div class="flex items-center gap-6">
        <p>&copy; 2026 Planexus GmbH. {copy.footer.rights}</p>
        <div class="flex gap-4">
          <a href="https://www.facebook.com/profile.php?id=61578221935839" target="_blank" rel="noopener noreferrer" class="w-8 h-8 rounded-full bg-slate-800 flex items-center justify-center text-slate-400 hover:bg-primary hover:text-slate-900 transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>
          </a>
          <a href="https://www.linkedin.com/company/planexus-gmbh" target="_blank" rel="noopener noreferrer" class="w-8 h-8 rounded-full bg-slate-800 flex items-center justify-center text-slate-400 hover:bg-primary hover:text-slate-900 transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect width="4" height="12" x="2" y="9"/><circle cx="4" cy="4" r="2"/></svg>
          </a>
        </div>
      </div>
      <div class="flex gap-6">
        <a href={href('/impressum')} class="hover:text-white">{copy.footer.imprint}</a>
        <a href={href('/datenschutz')} class="hover:text-white">{copy.footer.privacy}</a>
        <button
          type="button"
          id="cookie-settings-trigger"
          class="hover:text-white cursor-pointer"
        >
          {copy.footer.cookieSettings}
        </button>
      </div>
    </div>
  </div>
</footer>

<script is:inline>
  document.getElementById('cookie-settings-trigger')?.addEventListener('click', function () {
    window.dispatchEvent(new CustomEvent('planexus:open-cookie-settings'));
  });
</script>
