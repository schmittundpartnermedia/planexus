---
export interface Props {
  current?: string;
}
const { current } = Astro.props;

const branchen = [
  { slug: 'pharma-biotech', name: 'Pharma & Biotech', icon: 'flask' },
  { slug: 'forschung-hochschule', name: 'Forschung & Hochschule', icon: 'book' },
  { slug: 'industrie-werkstoffpruefung', name: 'Industrie & Werkstoffprüfung', icon: 'cog' },
  { slug: 'bildung', name: 'Bildung & Berufsschulen', icon: 'graduation' },
  { slug: 'public-health-krisenvorsorge', name: 'Public Health & Krisenvorsorge', icon: 'shield' },
  { slug: 'energiewende-h2-batterie', name: 'Energiewende H₂ & Batterie', icon: 'bolt' },
  { slug: 'oel-gas', name: 'Öl, Gas & Raffinerie', icon: 'droplet' },
];

const others = current ? branchen.filter(b => b.slug !== current) : branchen;
---
<section class="py-16 md:py-20 bg-white border-t border-gray-100">
  <div class="container mx-auto px-4">
    <div class="max-w-5xl mx-auto">
      <div class="text-center mb-10">
        <div class="text-xs uppercase tracking-wider text-[#7a9900] font-bold mb-3">Branchen-Lösungen</div>
        <h2 class="text-3xl md:text-4xl font-heading font-bold text-slate-900 mb-3">Laborcontainer für Ihre Branche</h2>
        <p class="text-gray-600 text-lg">Wir liefern für Pharma, Forschung, Industrie, Bildung, Public Health, Energiewende sowie Öl, Gas und Raffinerie – jeweils mit den branchenspezifischen Normen, Schutzklassen und Qualifizierungsdokumenten.</p>
      </div>
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {others.map(b => (
          <a href={`/branchen/${b.slug}`} class="block bg-slate-50 hover:bg-primary/10 border border-gray-100 hover:border-primary/40 rounded-xl p-5 transition-all group">
            <div class="font-bold text-slate-900 group-hover:text-[#7a9900] mb-1">{b.name}</div>
            <div class="text-xs text-gray-500">Laborcontainer für {b.name}</div>
          </a>
        ))}
      </div>
      <div class="text-center mt-8">
        <a href="/branchen" class="inline-flex items-center gap-2 text-[#7a9900] font-bold hover:underline">Alle Branchen-Lösungen ansehen
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
        </a>
      </div>
    </div>
  </div>
</section>
