---
import { localizeHref, type Locale } from '../i18n/routes';

export interface Props {
  current?: string;
  locale?: Locale;
}
const { current, locale = 'de' } = Astro.props;

const branchen = [
  { slug: 'pharma-biotech', enSlug: 'pharma-biotech', nameDe: 'Pharma & Biotech', nameEn: 'Pharma & biotech' },
  { slug: 'forschung-hochschule', enSlug: 'research-universities', nameDe: 'Forschung & Hochschule', nameEn: 'Research & universities' },
  { slug: 'industrie-werkstoffpruefung', enSlug: 'industry-materials-testing', nameDe: 'Industrie & Werkstoffprüfung', nameEn: 'Industry & materials testing' },
  { slug: 'bildung', enSlug: 'education', nameDe: 'Bildung & Berufsschulen', nameEn: 'Education & vocational schools' },
  { slug: 'public-health-krisenvorsorge', enSlug: 'public-health-emergency-preparedness', nameDe: 'Public Health & Krisenvorsorge', nameEn: 'Public health & emergency preparedness' },
  { slug: 'energiewende-h2-batterie', enSlug: 'energy-transition-h2-battery', nameDe: 'Energiewende H₂ & Batterie', nameEn: 'Energy transition, H₂ & batteries' },
  { slug: 'oel-gas', enSlug: 'oil-gas', nameDe: 'Öl, Gas & Raffinerie', nameEn: 'Oil, gas & refining' },
];

const others = current
  ? branchen.filter(b => b.slug !== current && b.enSlug !== current)
  : branchen;

const overviewHref = localizeHref('/branchen', locale);
---
<section class="py-16 md:py-20 bg-white border-t border-gray-100">
  <div class="container mx-auto px-4">
    <div class="max-w-5xl mx-auto">
      <div class="text-center mb-10">
        <div class="text-xs uppercase tracking-wider text-[#7a9900] font-bold mb-3">
          {locale === 'en' ? 'Industry solutions' : 'Branchen-Lösungen'}
        </div>
        <h2 class="text-3xl md:text-4xl font-heading font-bold text-slate-900 mb-3">
          {locale === 'en' ? 'Lab containers for your industry' : 'Laborcontainer für Ihre Branche'}
        </h2>
        <p class="text-gray-600 text-lg">
          {locale === 'en'
            ? 'We supply pharma, research, industry, education, public health, the energy transition, and oil, gas and refining — each with the relevant standards, containment classes and qualification documents.'
            : 'Wir liefern für Pharma, Forschung, Industrie, Bildung, Public Health, Energiewende sowie Öl, Gas und Raffinerie – jeweils mit den branchenspezifischen Normen, Schutzklassen und Qualifizierungsdokumenten.'}
        </p>
      </div>
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {others.map(b => {
          const name = locale === 'en' ? b.nameEn : b.nameDe;
          const href = locale === 'en' ? `/en/industries/${b.enSlug}` : `/branchen/${b.slug}`;
          return (
            <a href={href} class="block bg-slate-50 hover:bg-primary/10 border border-gray-100 hover:border-primary/40 rounded-xl p-5 transition-all group">
              <div class="font-bold text-slate-900 group-hover:text-[#7a9900] mb-1">{name}</div>
              <div class="text-xs text-gray-500">{locale === 'en' ? `Lab containers for ${name}` : `Laborcontainer für ${name}`}</div>
            </a>
          );
        })}
      </div>
      <div class="text-center mt-8">
        <a href={overviewHref} class="inline-flex items-center gap-2 text-[#7a9900] font-bold hover:underline">
          {locale === 'en' ? 'See all industry solutions' : 'Alle Branchen-Lösungen ansehen'}
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
        </a>
      </div>
    </div>
  </div>
</section>
