---
import Layout from '../../../layouts/Layout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';

const orgSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": "Planexus GmbH",
  "url": "https://planexus.de/",
  "logo": "https://planexus.de/Planexus-logo.png"
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://planexus.de/en" },
    { "@type": "ListItem", "position": 2, "name": "About us", "item": "https://planexus.de/en/about" },
    { "@type": "ListItem", "position": 3, "name": "Awards", "item": "https://planexus.de/en/about/awards" }
  ]
};
---

<Layout
  title="Awards – German CEO Excellence Awards 2026 | Planexus"
  description="Planexus GmbH and Sven Biewald are winners of the German CEO Excellence Awards 2026 from EU Business News — as a leading provider of modular laboratory containers."
  canonical="/en/about/awards"
  ogImage="/attached_assets/generated_images/laborcontainer-aufstellung-kran-bodenplatte.png"
>
  <div class="pt-20 min-h-screen bg-white">
    <script type="application/ld+json" set:html={JSON.stringify(orgSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

    <section class="relative py-20 bg-slate-900 text-white overflow-hidden">
      <div class="absolute inset-0 bg-gradient-to-br from-slate-900 via-slate-900 to-slate-800"></div>
      <div class="absolute inset-0 opacity-20" style="background-image: radial-gradient(circle at 20% 50%, #bbd700 0%, transparent 50%), radial-gradient(circle at 80% 20%, #bbd700 0%, transparent 40%);"></div>
      <div class="container mx-auto px-4 relative z-10">
        <div class="max-w-4xl mx-auto">
          <div class="flex items-center gap-3 mb-6">
            <span class="px-3 py-1 bg-primary/20 text-primary text-sm font-semibold rounded-full uppercase tracking-wider">
              Awards 2026
            </span>
          </div>

          <h1 class="text-4xl md:text-5xl font-heading font-bold mb-6">
            German CEO Excellence Awards 2026
          </h1>
          <p class="text-xl text-gray-300 leading-relaxed max-w-3xl">
            Planexus GmbH and Managing Director Sven Biewald were recognised in 2026 by <strong class="text-white">EU Business News</strong> in two categories of the German CEO Excellence Awards — as a leading provider of modular laboratory containers and as the most innovative thought leader in laboratory space solutions.
          </p>
        </div>
      </div>
    </section>

    <Breadcrumbs bar items={[{ name: 'Home', href: '/en' }, { name: 'About us', href: '/en/about' }, { name: 'Awards' }]} />

    <section class="py-16 bg-white">
      <div class="container mx-auto px-4">
        <div class="max-w-4xl mx-auto">

          <div class="grid md:grid-cols-2 gap-6 mb-12">
            <div class="bg-gradient-to-br from-primary/10 to-primary/5 border-2 border-primary/30 rounded-2xl p-8">
              <div class="flex items-start gap-3 mb-4">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-10 h-10 text-primary shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="6"/><path d="M15.477 12.89 17 22l-5-3-5 3 1.523-9.11"/></svg>
                <div>
                  <p class="text-xs uppercase tracking-wider text-primary font-bold mb-1">Company award</p>
                  <h2 class="text-xl font-heading font-bold text-slate-900 leading-tight">
                    Leading Modular Laboratory Containers Provider 2026
                  </h2>
                </div>
              </div>
              <p class="text-slate-700 leading-relaxed">
                Awarded to Planexus GmbH as a leading provider of modular laboratory containers in the German-speaking region — for turnkey, standards-compliant container laboratories in BSL-2 and BSL-3 configurations on the LABtoGO 2.0 platform.
              </p>
            </div>

            <div class="bg-gradient-to-br from-slate-900 to-slate-800 text-white rounded-2xl p-8">
              <div class="flex items-start gap-3 mb-4">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-10 h-10 text-primary shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6.5 6.5h11"/><path d="m21 21-1-1"/><path d="m3 3 1 1"/><path d="m18 22 4-4"/><path d="m2 6 4-4"/><path d="m3 10 7-7"/><path d="m14 21 7-7"/></svg>
                <div>
                  <p class="text-xs uppercase tracking-wider text-primary font-bold mb-1">CEO award</p>
                  <h2 class="text-xl font-heading font-bold leading-tight">
                    Most Innovative Laboratory Spaces Leader 2026
                  </h2>
                  <p class="text-sm text-slate-300 mt-1">Sven Biewald, Managing Director</p>
                </div>
              </div>
              <p class="text-slate-300 leading-relaxed">
                A personal award for Sven Biewald — for pioneering the first fully functional laboratory container in 2016 and for the continuous development of modular laboratory spaces, from research containers through to BSL-3 high-containment facilities.
              </p>
            </div>
          </div>

          <h2 class="text-2xl font-heading font-bold text-slate-900 mb-4 mt-12">
            What are the German CEO Excellence Awards?
          </h2>
          <p class="text-gray-600 leading-relaxed mb-4">
            The German CEO Excellence Awards are presented annually by <strong>EU Business News</strong> — a publication of the British <a href="https://www.aiglobalmedialtd.com/" target="_blank" rel="noopener" class="text-primary hover:underline font-medium">AI Global Media Ltd.</a>, which has awarded independent business prizes in Europe and internationally for more than a decade through brands such as Corporate Vision, Acquisition International, BUILD Magazine and CEO Monthly.
          </p>
          <p class="text-gray-600 leading-relaxed mb-4">
            The awards recognise leaders and companies in Germany that stand out in their sector through innovation, market position, client focus and sustainable growth. Selection is made by an editorial research team on the basis of nominations, publicly available data, client and partner feedback and market analysis — not through self-application with fees or a pay-to-win model.
          </p>
          <p class="text-gray-600 leading-relaxed mb-8">
            The 2026 awards covered winners from industry, life sciences, technology, finance and construction. Planexus sits at the intersection of modular construction and life-science infrastructure as one of few German specialists at home in both worlds — and was recognised twice for that reason.
          </p>

          <h2 class="text-2xl font-heading font-bold text-slate-900 mb-4 mt-12">
            What the award means for our clients
          </h2>
          <ul class="space-y-3 mb-12">
            <li class="flex items-start gap-3 text-gray-700">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-primary shrink-0 mt-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><path d="m9 11 3 3L22 4"/></svg>
              <span><strong>External validation:</strong> An independent specialist editorial team confirms what our clients experience — Planexus delivers reliably high quality in modular laboratory construction.</span>
            </li>
            <li class="flex items-start gap-3 text-gray-700">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-primary shrink-0 mt-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><path d="m9 11 3 3L22 4"/></svg>
              <span><strong>Innovation capability:</strong> Recognition of continuous development — from LABtoGO 2.0 through BSL-3 containment to H₂ and battery-test containers with ATEX protection.</span>
            </li>
            <li class="flex items-start gap-3 text-gray-700">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-primary shrink-0 mt-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><path d="m9 11 3 3L22 4"/></svg>
              <span><strong>Accountability:</strong> An award-winning Managing Director stands personally behind the quality of every project — not anonymous corporate process.</span>
            </li>
          </ul>

          <div class="bg-slate-50 border border-slate-200 rounded-2xl p-8 mb-12">
            <h3 class="text-xl font-heading font-bold text-slate-900 mb-6">Original sources at EU Business News</h3>
            <div class="space-y-4">
              <a
                href="https://www.eubusinessnews.com/winners/planexus-gmbh/"
                target="_blank"
                rel="noopener"
                class="flex items-start gap-4 p-4 bg-white rounded-xl border border-slate-200 hover:border-primary hover:shadow-md transition-all group"
              >
                <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-primary shrink-0 mt-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 3h6v6"/><path d="M10 14 21 3"/><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/></svg>
                <div class="flex-1">
                  <p class="font-semibold text-slate-900 group-hover:text-primary transition-colors">Planexus GmbH profile at EU Business News</p>
                  <p class="text-sm text-slate-600 mt-1">Official winner page covering both awards.</p>
                  <p class="text-xs text-slate-400 mt-2 font-mono break-all">eubusinessnews.com/winners/planexus-gmbh/</p>
                </div>
              </a>

              <a
                href="https://www.eubusinessnews.com/eu-business-news-unveils-the-winners-of-the-german-ceo-excellence-awards-2026/"
                target="_blank"
                rel="noopener"
                class="flex items-start gap-4 p-4 bg-white rounded-xl border border-slate-200 hover:border-primary hover:shadow-md transition-all group"
              >
                <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-primary shrink-0 mt-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 3h6v6"/><path d="M10 14 21 3"/><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/></svg>
                <div class="flex-1">
                  <p class="font-semibold text-slate-900 group-hover:text-primary transition-colors">Official press release: German CEO Excellence Awards 2026</p>
                  <p class="text-sm text-slate-600 mt-1">Announcement of all winners of this year’s awards.</p>
                  <p class="text-xs text-slate-400 mt-2 font-mono break-all">eubusinessnews.com/eu-business-news-unveils-the-winners-of-the-german-ceo-excellence-awards-2026/</p>
                </div>
              </a>
            </div>
          </div>

          <div class="bg-primary/10 border border-primary/30 rounded-2xl p-8 text-center">
            <h3 class="text-2xl font-heading font-bold text-slate-900 mb-3">
              Planexus for your next laboratory project
            </h3>
            <p class="text-slate-700 mb-6 max-w-2xl mx-auto">
              Benefit from award-winning engineering in modular laboratory construction — turnkey, standards-compliant and predictable.
            </p>
            <div class="flex flex-wrap justify-center gap-4">
              <a href="/en/contact" class="inline-flex items-center gap-2 px-6 py-3 bg-slate-900 text-white font-semibold rounded-lg hover:bg-slate-800 transition-colors">
                Request a consultation
              </a>
              <a href="/en/lab-containers" class="inline-flex items-center gap-2 px-6 py-3 bg-white text-slate-900 font-semibold rounded-lg border border-slate-200 hover:border-primary transition-colors">
                Explore lab containers
              </a>
            </div>
          </div>

        </div>
      </div>
    </section>
  </div>
</Layout>
