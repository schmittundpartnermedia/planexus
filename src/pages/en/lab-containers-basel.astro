---
import Layout from '../../layouts/Layout.astro';
import ContactForm from '../../components/ContactForm.tsx';
import AuthorBio from '../../components/AuthorBio.astro';
import CityCrossLinks from '../../components/CityCrossLinks.astro';

const title = "Lab containers Basel – cleanroom, GMP, pharma";
const description = "Rent lab containers in Basel: BSL-3, GMP, SIA 261 seismic zone Z2 for the pharma and biotech cluster. Turnkey from Albstadt in 8–14 weeks. Request a quotation now.";
const canonical = "/en/lab-containers-basel";

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "serviceType": "Lab containers and modular laboratory construction Basel",
  "provider": {
    "@type": "Organization",
    "name": "Planexus GmbH",
    "image": "https://planexus.de/android-chrome-512x512.png",
    "url": "https://planexus.de",
    "telephone": "+49 7435 7519 700",
    "email": "info@planexus.de",
    "address": { "@type": "PostalAddress", "streetAddress": "Am Steinbach 8", "addressLocality": "Albstadt-Laufen", "addressRegion": "Baden-Württemberg", "postalCode": "72459", "addressCountry": "DE" },
    "parentOrganization": { "@type": "Organization", "name": "Wesemann Holding GmbH" }
  },
  "areaServed": [
    { "@type": "City", "name": "Basel" },
    { "@type": "AdministrativeArea", "name": "Canton of Basel-Stadt" },
    { "@type": "AdministrativeArea", "name": "Canton of Basel-Landschaft" },
    { "@type": "Country", "name": "Switzerland" }
  ],
  "description": "Container laboratories, mobile laboratories and modular laboratory buildings for pharma, biotech, universities and hospitals in the Basel area — customs-cleared from the Albstadt works to Basel via Weil am Rhein.",
  "offers": { "@type": "AggregateOffer", "priceCurrency": "CHF", "availability": "https://schema.org/InStock" }
};

const localBusinessSchema = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "name": "Planexus GmbH – Lab containers Basel",
      "image": "https://planexus.de/images/labtogo-industrie.webp",
  "url": "https://planexus.de/en/lab-containers-basel",
  "telephone": "+49 7435 7519 700",
  "email": "info@planexus.de",
  "address": { "@type": "PostalAddress", "streetAddress": "Am Steinbach 8", "addressLocality": "Albstadt-Laufen", "addressRegion": "Baden-Württemberg", "postalCode": "72459", "addressCountry": "DE" },
  "areaServed": { "@type": "City", "name": "Basel", "containedInPlace": { "@type": "Country", "name": "Switzerland" } },
  "priceRange": "CHF",
  "openingHoursSpecification": [{ "@type": "OpeningHoursSpecification", "dayOfWeek": ["Monday","Tuesday","Wednesday","Thursday","Friday"], "opens": "08:00", "closes": "17:00" }]
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://planexus.de/en" },
    { "@type": "ListItem", "position": 2, "name": "Locations", "item": "https://planexus.de/en/lab-containers" },
    { "@type": "ListItem", "position": 3, "name": "Lab containers Basel", "item": "https://planexus.de/en/lab-containers-basel" }
  ]
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "How long does it take to deliver a lab container from the Albstadt works to Basel?",
      "acceptedAnswer": { "@type": "Answer", "text": "The heavy-haulage route from the Albstadt works to Basel runs south on the A81 via Singen/Stockach, then west on the A98 along the German–Swiss border, and through the Weil am Rhein/Basel-Hiltalingerstrasse border crossing directly into the Basel area. Driving time is around 2 hours over approximately 130 kilometres — the shortest heavy-haulage route from a German works to any Swiss location. Customs clearance is at the Weil am Rhein customs office under the T1 transit procedure, with an ATA Carnet for temporary import. Standard delivery points: Basel-Nord for port and industrial sites, Basel-Süd for the sites in St. Johann and Wettstein, Basel-Ost (A2/A3 junction) for the sites on Münchensteinerstrasse and in Rosental. From order to operational handover in Basel takes 8 to 14 weeks." }
    },
    {
      "@type": "Question",
      "name": "Which permits do I need for a lab container in the Canton of Basel-Stadt or Basel-Landschaft?",
      "acceptedAnswer": { "@type": "Answer", "text": "In Basel-Stadt the Bau- und Planungsgesetz (BPG, Building and Planning Act of Basel-Stadt) and the Bau- und Planungsverordnung (BPV, Building and Planning Ordinance) apply. The competent authority is the Bauinspektorat Basel-Stadt (Building Inspectorate) at Rittergasse 4, 4051 Basel. In Basel-Landschaft the Raumplanungs- und Baugesetz (RBG BL, Spatial Planning and Building Act) applies, with the Building Inspectorate in Liestal. Containers are treated as buildings and installations; a building permit is required in most cases. Temporary siting of under three months may, depending on the site, be possible under a simplified notification. For GMP, BSL-2 and BSL-3 containers, the Einschliessungsverordnung (ESV, Containment Ordinance) at FOEN/FOPH and the Therapeutic Products Act with Swissmedic competence also apply — particularly important in the pharmaceutical environment. We classify your site in advance and submit procedure-ready building documents for both half-cantons." }
    },
    {
      "@type": "Question",
      "name": "Which seismic requirements apply to lab containers in Basel under SIA 261?",
      "acceptedAnswer": { "@type": "Answer", "text": "Under SIA 261, Basel lies in seismic zone Z2 with a horizontal design ground acceleration of agd = 1.0 m/s² — around 67 per cent higher than Zurich (Z1a, agd 0.6 m/s²). The background is the Basel earthquake of 1356, the strongest historically documented earthquake north of the Alps, with an estimated magnitude of 6.6. For Z2 the anchoring of container laboratories is structurally considerably more demanding — Bauwerksklasse II (BWK II) is virtually standard for safety-relevant pharmaceutical and hospital sites, because safety-critical functions are housed here. Planexus supplies Basel with structural design to SIA 261 with the Z2 factor and an SIA 263 anchoring concept from the Albstadt works — not DIN alone, but procedure-ready for the Basel-Stadt Building Inspectorate." }
    },
    {
      "@type": "Question",
      "name": "How does Weil am Rhein customs clearance work for containers into Basel?",
      "acceptedAnswer": { "@type": "Answer", "text": "The Weil am Rhein/Basel border crossing is the most direct Swiss crossing from the Albstadt works — with no detour. We clear goods under the T1 transit procedure, with processing at the Weil am Rhein (DE) and Basel/Hiltalingerstrasse (CH) customs offices. Permanent import attracts Swiss VAT of 8.1 per cent (as at 2026). Temporary import (for example a rental container for clinical studies at hospitals or a pilot container for pharmaceutical companies) can be cleared under temporary admission with an ATA Carnet — no VAT, with a security deposit. Basel trinational special case: sites in French Saint-Louis (the life-sciences corridor towards the EuroAirport region) are in the EU single market — we then do not clear customs. We co-ordinate the entire process." }
    },
    {
      "@type": "Question",
      "name": "Can you deliver containers by ship to the Port of Basel?",
      "acceptedAnswer": { "@type": "Answer", "text": "Yes. Basel is the only Swiss city location with its own inland port (Swiss Rhine Ports, Kleinhüningen harbour and Auhafen Birsfelden). For oversized or several parallel modules, delivery by container vessel from Rotterdam/Antwerp is possible — from the Albstadt works we would take the modules by HGV to the Rhine port of Mannheim or Karlsruhe, then inland vessel to Basel. This is usually only economic for very large orders (≥ 10 modules); for individual containers the direct heavy-haulage route via Weil am Rhein is cheaper and faster. We calculate both variants transparently." }
    },
    {
      "@type": "Question",
      "name": "What must I consider on brownfield sites in Basel?",
      "acceptedAnswer": { "@type": "Answer", "text": "The former chemical and pharmaceutical sites in Basel-Nord are classic brownfields with contaminated land from more than 100 years of chemical production. Siting there requires, before construction, a preliminary investigation under the Altlasten-Verordnung (AltlV, Contaminated Sites Ordinance) and the Technische Verordnung über Abfälle (TVA, Technical Ordinance on Waste), co-ordinated with the Amt für Umwelt und Energie Basel-Stadt (Office for the Environment and Energy). We supply construction-preparation recommendations (base slab with barrier layer, drainage concept, possibly a lifting arrangement over existing contamination) and work closely with Swiss ground consultants. These sites are developing into Basel’s new life-science addresses — for transitional uses, pilot and GMP containers are a suitable solution." }
    },
    {
      "@type": "Question",
      "name": "Which applications are particularly in demand in Basel?",
      "acceptedAnswer": { "@type": "Answer", "text": "Basel is Switzerland’s pharmaceutical capital and one of the world’s most important life-science locations. Typical uses for lab containers arise around the region’s pharmaceutical and biotech sites — GMP pilot containers and BSL-3 research modules as well as cleanroom and containment containers — around university and basic research — BSL-2 third-party-funded containers and high-end research containers — and around the university hospitals — study containers during hospital refurbishments." }
    }
  ]
};
---

<Layout title={title} description={description} canonical={canonical}>
  <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(localBusinessSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <div class="bg-white">

    <!-- HERO -->
    <section class="relative bg-slate-900 text-white overflow-hidden">
      <div class="relative z-10 container mx-auto px-4 py-20 md:py-28">
        <div class="max-w-4xl">
          <nav class="flex items-center gap-2 text-sm text-gray-400 mb-8" aria-label="Breadcrumb">
            <a href="/en" class="hover:text-primary transition-colors">Home</a>
            <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m9 18 6-6-6-6"/></svg>
            <span>Locations</span>
            <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m9 18 6-6-6-6"/></svg>
            <span class="text-primary">Basel</span>
          </nav>

          <div class="text-primary font-medium text-sm uppercase tracking-wider mb-4">Your specialist for lab containers · Switzerland’s pharmaceutical capital</div>

          <h1 class="text-4xl md:text-5xl lg:text-6xl font-heading font-bold mb-6 leading-tight">
            Lab containers Basel – GMP and BSL laboratories for the pharmaceutical region
          </h1>

          <p class="text-xl text-gray-300 leading-relaxed mb-4">
            <strong class="text-white">Our managing directors bring more than ten years of experience in lab-container construction.</strong> Modular, SIA 261 Z2-compliant, T1 customs-cleared. We deliver flexible research and GMP environments for pharma, biotech, universities and hospitals in the Basel area — from the Albstadt works directly to Basel, via the A81 and the Weil am Rhein border in only 130 km.
          </p>
          <p class="text-base text-gray-400 mb-8">While others are still planning, you are already researching.</p>

          <div class="flex flex-col sm:flex-row gap-4 mb-8">
            <a href="#anfrage" data-testid="button-cta-hero" class="bg-primary text-slate-900 font-bold px-8 py-4 rounded-lg hover:bg-primary/90 transition-colors inline-flex items-center justify-center gap-2 shadow-[0_0_20px_rgba(132,189,0,0.3)]">Complimentary Basel site audit<svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg></a>
            <a href="tel:+4974357519700" class="border border-white/20 text-white font-medium px-8 py-4 rounded-lg hover:bg-white/10 transition-colors inline-flex items-center justify-center gap-2"><svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>+49 7435 7519 700</a>
          </div>

          <div class="flex flex-wrap items-center gap-x-6 gap-y-2 text-sm text-gray-400">
            <div class="flex items-center gap-2"><svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6 9 17l-5-5"/></svg>Specialist in modular laboratory construction</div>
            <div class="flex items-center gap-2"><svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6 9 17l-5-5"/></svg>Award 2026 EU Business News</div>
            <div class="flex items-center gap-2"><svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6 9 17l-5-5"/></svg>Weil am Rhein customs clearance included</div>
            <div class="flex items-center gap-2"><svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6 9 17l-5-5"/></svg>Wesemann Group · 60+ years of laboratory construction</div>
          </div>
        </div>
      </div>
    </section>

    <AuthorBio city="Basel"  locale="en" />

    <!-- LABtoGO -->
    <section class="py-16 md:py-20 bg-gradient-to-br from-primary/5 via-white to-primary/10 border-y border-primary/20">
      <div class="container mx-auto px-4">
        <div class="max-w-5xl mx-auto">
          <div class="grid md:grid-cols-2 gap-10 items-center mb-10">
            <div>
              <div class="text-primary font-bold text-sm uppercase tracking-wider mb-3">Pattern interrupt · World premiere at analytica 2026</div>
              <h2 class="text-3xl md:text-4xl font-heading font-bold mb-4 text-slate-900">Planexus shows Basel what a lab container can really do in 2026</h2>
              <p class="text-lg text-gray-700 leading-relaxed mb-4">An ordinary lab container has 2,400 mm internal height. Working upright at a fume cupboard is a struggle.</p>
              <p class="text-lg text-slate-900 font-bold leading-relaxed mb-4">The Planexus LABtoGO has 2,750 mm internal height. 9.5 m external length. 3 m external width. A fully glazed front that brings genuine daylight into every Basel pharmaceutical, biotech or research laboratory.</p>
              <p class="text-lg text-gray-700 leading-relaxed"><strong>An ordinary lab container fits entirely inside a LABtoGO.</strong> We configure it for Basel to SIA 261 seismic zone Z2 (considerably higher than Zurich Z1a), SIA 380/1 energy, T1 customs clearance from the Albstadt works via Weil am Rhein, and a T13/T15 Swiss electrical connection.</p>
            </div>
            <div class="grid grid-cols-2 gap-4">
              <div class="bg-slate-900 text-white rounded-2xl p-6 text-center"><div class="text-4xl font-bold text-primary mb-1">2,750</div><div class="text-xs text-gray-400 uppercase tracking-wider">mm internal height</div><div class="text-xs text-gray-500 mt-1">Standard: 2,400 mm</div></div>
              <div class="bg-slate-900 text-white rounded-2xl p-6 text-center"><div class="text-4xl font-bold text-primary mb-1">9,500</div><div class="text-xs text-gray-400 uppercase tracking-wider">mm external length</div><div class="text-xs text-gray-500 mt-1">3,000 mm width</div></div>
              <div class="bg-slate-900 text-white rounded-2xl p-6 text-center"><div class="text-4xl font-bold text-primary mb-1">SIA Z2</div><div class="text-xs text-gray-400 uppercase tracking-wider">Seismic agd 1.0 m/s²</div><div class="text-xs text-gray-500 mt-1">~67% above Zurich</div></div>
              <div class="bg-slate-900 text-white rounded-2xl p-6 text-center"><div class="text-4xl font-bold text-primary mb-1">130 km</div><div class="text-xs text-gray-400 uppercase tracking-wider">Works → Basel</div><div class="text-xs text-gray-500 mt-1">2 h via Weil</div></div>
            </div>
          </div>
          <div class="text-center"><a href="/en/lab-containers/labtogo" class="inline-flex items-center gap-2 text-primary font-bold hover:underline">View the LABtoGO platform and all configurations<svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg></a></div>
        </div>
      </div>
    </section>

    <!-- PROBLEM-AGITATION -->
    <section class="py-16 md:py-20">
      <div class="container mx-auto px-4">
        <div class="max-w-5xl mx-auto">
          <h2 class="text-3xl md:text-4xl font-heading font-bold mb-10 text-slate-900">Planexus solves the three Basel bottlenecks at which pharma and research containers regularly fail</h2>
          <div class="grid md:grid-cols-3 gap-6">
            <div class="bg-slate-50 border-l-4 border-primary rounded-xl p-6">
              <div class="text-slate-900 font-bold text-lg mb-2">SIA 261 Z2 instead of Z1a — seismic design is critical</div>
              <p class="text-gray-700 text-sm leading-relaxed">Basel lies in SIA 261 seismic zone Z2 (agd 1.0 m/s²) — around 67 per cent higher than Zurich (Z1a, agd 0.6 m/s²). The background is the historic Basel earthquake of 1356, the strongest north of the Alps. Containers sized only for Z1a or purely to DIN fail at the Basel-Stadt Building Inspectorate. BWK II classification is virtually standard for safety-relevant pharmaceutical and hospital sites.</p>
              <p class="text-sm text-slate-900 font-semibold mt-3 pt-3 border-t border-gray-200">Planexus answer: Structural design to SIA 261 Z2 with BWK II documented from the works.</p>
            </div>
            <div class="bg-slate-50 border-l-4 border-primary rounded-xl p-6">
              <div class="text-slate-900 font-bold text-lg mb-2">Basel pharma cluster — GMP audit-ready from day one</div>
              <p class="text-gray-700 text-sm leading-relaxed">Basel’s pharmaceutical groups will not accept pilot containers without Swissmedic-ready IQ/OQ/PQ documentation, ISO 14644 cleanroom and Annex 1 compliance. Anyone offering a standard container “with a GMP option” fails in the first audit round. An ESV application to FOEN/FOPH for genetically modified installations is also mandatory and is often forgotten.</p>
              <p class="text-sm text-slate-900 font-semibold mt-3 pt-3 border-t border-gray-200">Planexus answer: GMP cleanroom containers audit-ready from the works, ESV application included.</p>
            </div>
            <div class="bg-slate-50 border-l-4 border-primary rounded-xl p-6">
              <div class="text-slate-900 font-bold text-lg mb-2">Trinational customs CH/DE/FR — more complex than any other Swiss location</div>
              <p class="text-gray-700 text-sm leading-relaxed">Basel sites may lie in Basel-Stadt, Basel-Landschaft or in French Saint-Louis. Saint-Louis = EU single market (no customs clearance); BS/BL = Swiss T1 clearance with 8.1% VAT or ATA Carnet for rental. Standard freight operators lump this into a flat rate and are often wrong — several thousand CHF of difference is possible.</p>
              <p class="text-sm text-slate-900 font-semibold mt-3 pt-3 border-t border-gray-200">Planexus answer: Site-dependent clearance at Weil am Rhein or EU single-market delivery.</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- STRATEGISCHE FUSION -->
    <section class="py-16 md:py-20 bg-slate-50">
      <div class="container mx-auto px-4">
        <div class="max-w-4xl mx-auto">
          <h2 class="text-3xl md:text-4xl font-heading font-bold mb-8 text-slate-900">Lab containers for Basel: what the pharma triad, SIA Z2 and Weil am Rhein customs clearance demand of the engineering</h2>
          <div class="prose prose-lg max-w-none text-gray-700 space-y-6">
            <p><strong>Basel is Switzerland’s pharmaceutical capital and one of the world’s most important life-science locations.</strong> Across 37 square kilometres of city area, globally active pharmaceutical groups, CDMO contract manufacturers, universities, university hospitals and extra-university research institutes compete for space, permits and engineering capacity.</p>
            <p><strong>We know this market in detail.</strong> We know that the Basel-Stadt Building Inspectorate at Rittergasse 4, 4051 Basel, decides under the BPG and BPV, and that the Liestal Building Inspectorate is competent for Basel-Landschaft (RBG BL). We know that SIA 261 defines seismic zone Z2 for Basel with agd = 1.0 m/s² — around 67 per cent higher than Zurich — and that the Basel earthquake of 1356 (magnitude 6.6) has shaped Swiss seismic standards. We know that containers for safety-relevant pharmaceutical and hospital sites are practically always classified in Bauwerksklasse II (BWK II) and that ESV notification to FOEN/FOPH plus Swissmedic inspection readiness from day one are mandatory. We know the trinational special situation: sites in Saint-Louis (FR) lie in the EU single market — without customs clearance — while Basel-Stadt and Basel-Landschaft are processed under the T1 transit procedure with clearance at the Weil am Rhein customs office. These details are not in our quotation — they are the engineering and logistics foundation of every container that leaves our Albstadt works.</p>
            <p><strong>Made in Albstadt, customs-cleared at Weil am Rhein, turnkey in Basel.</strong> Final assembly and interior fit-out are carried out with Wesemann furniture in our own works — factory visits can be arranged from either side. South on the A81 via Singen/Stockach, then west on the A98 along the German–Swiss border and through the Weil am Rhein/Basel-Hiltalingerstrasse border crossing directly into the Basel area, the heavy-haulage distance is around 130 kilometres — the shortest heavy-haulage route from a German works to any Swiss location. The Basel-Nord junctions for Kleinhüningen harbour and the industrial sites, Basel-Süd for the sites in St. Johann and Wettstein, and Basel-Ost (A2/A3 junction) for the sites on Münchensteinerstrasse and in Rosental are standard delivery points.</p>
            <p>Whether you need a <strong>mobile laboratory in Basel</strong> for a time-limited hospital refurbishment, a <strong>modular lab container in Basel</strong> for a permanent expansion on a brownfield site in Basel-Nord, or a <strong>container laboratory in Basel</strong> with BSL-3 containment and Swissmedic-ready GMP for pharmaceutical pilot plants — we deliver all three answers from the same platform: the LABtoGO from our Albstadt works, with Swiss customs, Z2 structural and energy documentation from the factory.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- 6 ENGINEERING -->
    <section class="py-16 md:py-20">
      <div class="container mx-auto px-4">
        <div class="max-w-6xl mx-auto">
          <h2 class="text-3xl md:text-4xl font-heading font-bold mb-3 text-slate-900">Six engineering disciplines for the pharmaceutical capital</h2>
          <p class="text-gray-600 text-lg mb-10 max-w-3xl">Planexus builds lab containers for Basel that are aligned in every discipline with Swiss realities and the pharma triad — not generic, but standard- and site-specific.</p>
          <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-5">
            <div class="bg-slate-50 rounded-xl p-6 border border-gray-100"><div class="text-primary text-xs font-bold uppercase tracking-wider mb-2">SIA 261 Z2 seismic</div><h3 class="font-bold text-slate-900 mb-2">agd 1.0 m/s² + BWK II</h3><p class="text-sm text-gray-600">Basel lies in Z2 (~67% higher than Zurich Z1a). Structural design with SIA 263 anchoring concept, BWK II for pharmaceutical and hospital sites — not DIN alone.</p></div>
            <div class="bg-slate-50 rounded-xl p-6 border border-gray-100"><div class="text-primary text-xs font-bold uppercase tracking-wider mb-2">GMP + Swissmedic</div><h3 class="font-bold text-slate-900 mb-2">Audit-ready from day one</h3><p class="text-sm text-gray-600">EU Annex 1 + ISO 14644 Class 7, IQ/OQ/PQ documentation Swissmedic-ready. Pharma-audit-ready without rework.</p></div>
            <div class="bg-slate-50 rounded-xl p-6 border border-gray-100"><div class="text-primary text-xs font-bold uppercase tracking-wider mb-2">Trinational customs</div><h3 class="font-bold text-slate-900 mb-2">Weil am Rhein or EU Saint-Louis</h3><p class="text-sm text-gray-600">Site-dependent: T1 from Weil am Rhein for BS/BL (8.1% Swiss VAT) or EU single-market delivery to Saint-Louis (FR) without customs clearance.</p></div>
            <div class="bg-slate-50 rounded-xl p-6 border border-gray-100"><div class="text-primary text-xs font-bold uppercase tracking-wider mb-2">ESV at FOEN/FOPH</div><h3 class="font-bold text-slate-900 mb-2">Swiss authority path</h3><p class="text-sm text-gray-600">Genetically modified installations S1/S2/S3 under the Containment Ordinance at FOEN/FOPH — not GenTSV/BVL. Application documents in Swiss form.</p></div>
            <div class="bg-slate-50 rounded-xl p-6 border border-gray-100"><div class="text-primary text-xs font-bold uppercase tracking-wider mb-2">SIA 380/1 energy</div><h3 class="font-bold text-slate-900 mb-2">U ≤ 0.17 + HR ≥ 75%</h3><p class="text-sm text-gray-600">SIA 380/1 and MuKEn 2014/2025 stricter than the German GEG. Sandwich envelope and triple glazing sized at the works.</p></div>
