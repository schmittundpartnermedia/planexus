---
import Layout from '../../layouts/Layout.astro';
import Map from '../../components/Map';
import ContactForm from '../../components/ContactForm';
---

<Layout
  title="Contact – laboratory container enquiry"
  description="Contact Planexus about your laboratory-container project. Consulting, quotations and project start. We look forward to your enquiry."
  canonical="/en/contact"
  ogImage="/attached_assets/Kopf_green-scaled_1768306688943.jpg"
>
  <div class="pt-20 min-h-screen bg-white">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://planexus.de/en" },
        { "@type": "ListItem", "position": 2, "name": "Contact", "item": "https://planexus.de/en/contact" }
      ]
    })} />
    <section class="relative py-24 bg-slate-900 text-white overflow-hidden">
      <div class="absolute inset-0 bg-[url('/images/backgrounds/kontakt-bg.webp')] bg-cover bg-center opacity-10"></div>
      <div class="absolute inset-0 bg-gradient-to-b from-slate-900 via-slate-900/95 to-slate-900"></div>
      <div class="container mx-auto px-4 text-center relative z-10">
        <h1 class="text-4xl md:text-6xl font-heading font-bold mb-6">Get in touch</h1>
        <p class="text-xl text-gray-300 max-w-2xl mx-auto">
          Start your laboratory project with a strong partner — from <a href="/en/services/consulting" class="text-primary hover:underline">consulting</a> through to turnkey handover.
        </p>
      </div>
    </section>

    <section class="py-20">
      <div class="container mx-auto px-4">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-16">
          <div class="space-y-12">
            <div>
              <h2 class="text-2xl font-bold mb-6 text-primary">Our contact details</h2>
              <p class="text-gray-600 mb-8">
                We are available at any time for questions about <strong>laboratory containers</strong> and planning services.
              </p>

              <div class="space-y-6">
                <div class="flex items-start gap-4 group">
                  <div class="w-12 h-12 bg-primary/10 rounded-lg flex items-center justify-center shrink-0 group-hover:bg-primary transition-colors">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary group-hover:text-slate-900 transition-colors"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
                  </div>
                  <div>
                    <h4 class="font-bold text-lg mb-1 text-slate-900">Office</h4>
                    <p class="text-gray-600">Am Steinbach 8<br />72459 Albstadt – Laufen</p>
                  </div>
                </div>

                <div class="flex items-start gap-4 group">
                  <div class="w-12 h-12 bg-primary/10 rounded-lg flex items-center justify-center shrink-0 group-hover:bg-primary transition-colors">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary group-hover:text-slate-900 transition-colors"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
                  </div>
                  <div>
                    <h4 class="font-bold text-lg mb-1 text-slate-900">Works</h4>
                    <p class="text-gray-600">Emil-Mayer-Straße 1<br />72461 Albstadt</p>
                  </div>
                </div>

                <div class="flex items-start gap-4 group">
                  <div class="w-12 h-12 bg-primary/10 rounded-lg flex items-center justify-center shrink-0 group-hover:bg-primary transition-colors">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary group-hover:text-slate-900 transition-colors"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
                  </div>
                  <div>
                    <h4 class="font-bold text-lg mb-1 text-slate-900">Telephone</h4>
                    <a href="tel:+4974357519700" class="text-gray-600 hover:text-primary transition-colors block">
                      +49 7435 7519 700
                    </a>
                  </div>
                </div>

                <div class="flex items-start gap-4 group">
                  <div class="w-12 h-12 bg-primary/10 rounded-lg flex items-center justify-center shrink-0 group-hover:bg-primary transition-colors">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary group-hover:text-slate-900 transition-colors"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
                  </div>
                  <div>
                    <h4 class="font-bold text-lg mb-1 text-slate-900">Email</h4>
                    <a href="mailto:info@planexus.de" class="text-gray-600 hover:text-primary transition-colors block">
                      info@planexus.de
                    </a>
                  </div>
                </div>
              </div>
            </div>

            <div class="bg-slate-50 p-6 rounded-xl border border-gray-100 mb-6">
              <p class="text-gray-600 text-sm leading-relaxed">
                Learn more about our <a href="/en/services" class="font-semibold text-slate-900 hover:text-primary transition-colors">services</a>, view our <a href="/en/projects" class="font-semibold text-slate-900 hover:text-primary transition-colors">reference projects</a>, or get to know our <a href="/en/team" class="font-semibold text-slate-900 hover:text-primary transition-colors">team</a> and <a href="/en/partners" class="font-semibold text-slate-900 hover:text-primary transition-colors">partner network</a>. Our <a href="/en/magazine" class="font-semibold text-slate-900 hover:text-primary transition-colors">magazine</a> offers technical insight into <a href="/en/services/modular-construction" class="font-semibold text-slate-900 hover:text-primary transition-colors">modular laboratory construction</a>.
              </p>
            </div>

            <div class="h-64 bg-slate-100 rounded-xl overflow-hidden border border-gray-200">
              <Map
                client:only="react"
                lat={48.2413}
                lng={8.9609}
                zoom={12}
                markers={[
                  { lat: 48.2180461, lng: 8.9140541, popupText: "Planexus GmbH - Office\nAm Steinbach 8, 72459 Albstadt-Laufen" },
                  { lat: 48.2646, lng: 9.0077, popupText: "Planexus GmbH - Works\nEmil-Mayer-Straße 1, 72461 Albstadt-Tailfingen" }
                ]}
              />
            </div>
          </div>

          <ContactForm client:load locale="en" />
        </div>
      </div>
    </section>
  </div>
</Layout>
