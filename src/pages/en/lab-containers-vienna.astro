---
import Layout from '../../layouts/Layout.astro';
import ContactForm from '../../components/ContactForm.tsx';
import AuthorBio from '../../components/AuthorBio.astro';
import CityCrossLinks from '../../components/CityCrossLinks.astro';

const title = "Lab containers Vienna – GMP, cleanroom, ATEX";
const description = "Rent lab containers in Vienna: BSL-3, OIB/ÖNORM for life science, hospitals and research. EU single market, no customs, from Albstadt in 8–14 weeks. Request a quotation now.";
const canonical = "/en/lab-containers-vienna";

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "serviceType": "Lab containers and modular laboratory construction Vienna",
  "provider": {
    "@type": "Organization",
    "name": "Planexus GmbH",
    "image": "https://planexus.de/android-chrome-512x512.png",
    "url": "https://planexus.de",
    "telephone": "+49 7435 7519 700",
    "email": "info@planexus.de",
    "address": { "@type": "PostalAddress", "streetAddress": "Am Steinbach 8", "addressLocality": "Albstadt-Laufen", "addressRegion": "Baden-Württemberg", "postalCode": "72459", "addressCountry": "DE" },
    "parentOrganization": { "@type": "Organization", "name": "Wesemann Holding GmbH" }
  },
  "areaServed": [
    { "@type": "City", "name": "Vienna" },
    { "@type": "AdministrativeArea", "name": "Federal State of Vienna" },
    { "@type": "Country", "name": "Austria" }
  ],
  "description": "Container laboratories, mobile laboratories and modular laboratory buildings for the life-science cluster, university hospitals, universities, research institutes, pharmaceutical sites and authorities such as AGES and BASG — from the Albstadt works, EU single-market compliant, to Vienna via the A8 + A1 Salzburg.",
  "offers": { "@type": "AggregateOffer", "priceCurrency": "EUR", "availability": "https://schema.org/InStock" }
};

const localBusinessSchema = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "name": "Planexus GmbH – Lab containers Vienna",
      "image": "https://planexus.de/images/labtogo-industrie.webp",
  "url": "https://planexus.de/en/lab-containers-vienna",
  "telephone": "+49 7435 7519 700",
  "email": "info@planexus.de",
  "address": { "@type": "PostalAddress", "streetAddress": "Am Steinbach 8", "addressLocality": "Albstadt-Laufen", "addressRegion": "Baden-Württemberg", "postalCode": "72459", "addressCountry": "DE" },
  "areaServed": { "@type": "City", "name": "Vienna", "containedInPlace": { "@type": "Country", "name": "Austria" } },
  "priceRange": "EUR",
  "openingHoursSpecification": [{ "@type": "OpeningHoursSpecification", "dayOfWeek": ["Monday","Tuesday","Wednesday","Thursday","Friday"], "opens": "08:00", "closes": "17:00" }]
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://planexus.de/en" },
    { "@type": "ListItem", "position": 2, "name": "Locations", "item": "https://planexus.de/en/lab-containers" },
    { "@type": "ListItem", "position": 3, "name": "Lab containers Vienna", "item": "https://planexus.de/en/lab-containers-vienna" }
  ]
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "How long does it take to deliver a lab container from the Albstadt works to Vienna?",
      "acceptedAnswer": { "@type": "Answer", "text": "The heavy-haulage route from the Albstadt works to Vienna runs north-east on the A81 to Stuttgart, then east on the A8 via Munich → Salzburg, Walserberg border crossing (DE/AT EU single market, no customs clearance), then east on the A1 via Linz → Vienna. Driving time is around 6.5 hours over approximately 580 kilometres — within driving-time regulations one transport day with a mandatory rest break. Standard delivery points: the life-science campus on Dr.-Bohr-Gasse, the hospital and university site on Währinger Gürtel, Klosterneuburg-Süd for research institutes in the surrounding area, Liesing-Süd for pharmaceutical sites, Donaustadt for AGES on Spargelfeldstrasse, Brigittenau for BASG on Traisengasse, and Floridsdorf for veterinary sites. From order to operational handover in Vienna takes 8 to 14 weeks." }
    },
    {
      "@type": "Question",
      "name": "Which permits do I need for a lab container in Vienna?",
      "acceptedAnswer": { "@type": "Answer", "text": "In Vienna the Bauordnung für Wien (BO Wien, Building Code for Vienna) applies as Viennese state law, supplemented by OIB Guidelines 1 to 6 of the Austrian Institute of Construction Engineering (instead of the German MBO/LBO or Swiss SIA standards). The competent authority is Magistratsabteilung 37 – Baupolizei (MA 37, Municipal Department 37 – Building Control) at Dresdner Straße 73-75, 1200 Vienna. Containers are treated as buildings under § 60 BO Wien; a building notification or building permit is required in most cases. Temporary siting of under six months may, depending on the site, be possible under a simplified notification procedure. We review your site in advance and file procedure-ready building documents directly with MA 37 — including ÖNORM structural design, OIB energy evidence and a fire-protection concept to OIB Guideline 2." }
    },
    {
      "@type": "Question",
      "name": "What does proximity to BASG and AGES mean for GMP and BSL-3 containers in Vienna?",
      "acceptedAnswer": { "@type": "Answer", "text": "Every genetically modified containment in Austria requires notification under the Gentechnikgesetz (GTG, Genetic Engineering Act, Federal Law Gazette 510/1994 as amended) to the Federal Ministry of Social Affairs, Health, Care and Consumer Protection (BMSGPK) — Vienna Stubenring 1 — and an opinion from the scientific commission. For every GMP cleanroom-container project with a therapeutic-products dimension, BASG (Federal Office for Safety in Health Care) at Traisengasse 5, 1200 Vienna, is the competent inspection authority — organisationally under the AGES umbrella. If your site is in Vienna, all three authorities (BMSGPK, BASG, AGES) are within the city boundary — on-site inspections can be scheduled at short notice, and written queries are generally answered in 5 to 10 working days. From Graz or Linz those are travel days — from Vienna appointments in the same district." }
    },
    {
      "@type": "Question",
      "name": "Which seismic and energy requirements apply to lab containers in Vienna under ÖNORM and OIB?",
      "acceptedAnswer": { "@type": "Answer", "text": "Under ÖNORM B 1998-1 (EC8 seismic), Vienna lies, depending on the district, in seismic zone Z2 to Z3 with a horizontal design ground acceleration of agR = 0.4 to 0.6 m/s² — moderate, but not to be neglected. Structurally the requirement is comparable with Swiss Z1a (Bern, Zurich), lower than Basel Z2. Containers for hospitals or research institutes must be classified in importance category II under ÖNORM. OIB Guideline 6 (energy saving and thermal insulation) requires strict heating-demand (HWB) values — typically HWB ≤ 25 kWh/m²a for new build. We supply Vienna with structural design to ÖNORM B 1998-1 with the Z2/Z3 factor and ÖNORM B 1991-1-3 snow load (Vienna Zone 1, sk ≈ 1.1 kN/m²) and energetically to OIB Guideline 6 with U ≤ 0.20 W/m²K and heat recovery ≥ 75% — procedure-ready for MA 37." }
    },
    {
      "@type": "Question",
      "name": "How does delivery to Austria work? EU single market and tolls?",
      "acceptedAnswer": { "@type": "Answer", "text": "Germany and Austria are both EU member states and part of the single market — there is no customs clearance. We deliver from the Albstadt works as an intra-Community supply with an Austrian VAT identification number (ATU number) — tax-free in Germany, reverse charge in Austria. The price advantage versus Swiss locations is up to 8.1% (Swiss VAT falls away entirely). For heavy haulage the Austrian HGV toll (GO-Box, ASFINAG) and a 10-day or annual vignette for escort vehicles are obligatory. Standard route via Salzburg-Walserberg (DE/AT border) — no stop since Schengen. From the Albstadt works to Vienna: ~580 km, ~6.5 h driving time + mandatory rest break." }
    },
    {
      "@type": "Question",
      "name": "Which applications are particularly in demand in Vienna?",
      "acceptedAnswer": { "@type": "Answer", "text": "Vienna is by some distance Austria’s largest life-science cluster and one of the EU’s top locations. Typical uses for lab containers arise around the life-science campus on Dr.-Bohr-Gasse with several molecular-biology research institutes and more than 2,500 scientists from more than 90 nations (BSL-2/3 research containers and pilot cleanrooms); the large university hospital on Währinger Gürtel, Austria’s largest hospital (study containers during refurbishments and IRB research); an elite research institute in the Klosterneuburg area (expansion containers); the pharmaceutical industry in Liesing (GMP pilot plants); the AGES authority on Spargelfeldstrasse (food-safety and veterinary containers); a molecular-medicine research centre near the university hospital (translational BSL-2 containers); and the city’s technical and veterinary universities." }
    },
    {
      "@type": "Question",
      "name": "Can you supply BSL-3 containers for research and hospitals?",
      "acceptedAnswer": { "@type": "Answer", "text": "Yes. We build BSL-3 containers for clinical research, infectious-disease diagnostics and translational pharmaceutical piloting at the Albstadt works — HEPA H14 dual filtration, autoclaved airlock, negative pressure with a three-stage cascade, emergency power and data loggers. Notification under the Genetic Engineering Act (GTG) to BMSGPK Vienna, opinion of the scientific commission. Structural design to ÖNORM B 1998-1 (Z2/Z3) and ÖNORM B 1991, energy to OIB Guideline 6, fire protection to OIB Guideline 2. For containers at a life-science campus, co-ordination with the site’s building department would be required; for hospital study containers, with the relevant building directorate. IQ/OQ/PQ BASG-ready — BASG proximity in Vienna-Brigittenau can favour an accelerated inspection." }
    }
  ]
};
---

<Layout title={title} description={description} canonical={canonical}>
  <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(localBusinessSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <div class="bg-white">

    <!-- HERO -->
    <section class="relative bg-slate-900 text-white overflow-hidden">
      <div class="relative z-10 container mx-auto px-4 py-20 md:py-28">
        <div class="max-w-4xl">
          <nav class="flex items-center gap-2 text-sm text-gray-400 mb-8" aria-label="Breadcrumb">
            <a href="/en" class="hover:text-primary transition-colors">Home</a>
            <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m9 18 6-6-6-6"/></svg>
            <span>Locations</span>
            <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m9 18 6-6-6-6"/></svg>
            <span class="text-primary">Vienna</span>
          </nav>

          <div class="text-primary font-medium text-sm uppercase tracking-wider mb-4">Your specialist for lab containers · EU top life-science hub with BASG on site</div>

          <h1 class="text-4xl md:text-5xl lg:text-6xl font-heading font-bold mb-6 leading-tight">
            Lab containers Vienna – BSL-3 laboratories for life science, hospitals and pharma
          </h1>

          <p class="text-xl text-gray-300 leading-relaxed mb-4">
            <strong class="text-white">Our managing directors bring more than ten years of experience in lab-container construction.</strong> Modular, OIB-compliant, ÖNORM structural. We deliver flexible research, hospital and industrial environments for the life-science cluster, university hospitals, universities, research institutes, pharmaceutical sites and authorities such as AGES and BASG — from the Albstadt works directly to Vienna, EU single-market compliant without customs clearance via the A8 + A1 Salzburg-Walserberg.
          </p>
          <p class="text-base text-gray-400 mb-8">While others are still planning, you are already researching.</p>

          <div class="flex flex-col sm:flex-row gap-4 mb-8">
            <a href="#anfrage" data-testid="button-cta-hero" class="bg-primary text-slate-900 font-bold px-8 py-4 rounded-lg hover:bg-primary/90 transition-colors inline-flex items-center justify-center gap-2 shadow-[0_0_20px_rgba(132,189,0,0.3)]">Complimentary Vienna site audit<svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg></a>
            <a href="tel:+4974357519700" class="border border-white/20 text-white font-medium px-8 py-4 rounded-lg hover:bg-white/10 transition-colors inline-flex items-center justify-center gap-2"><svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>+49 7435 7519 700</a>
          </div>

          <div class="flex flex-wrap items-center gap-x-6 gap-y-2 text-sm text-gray-400">
            <div class="flex items-center gap-2"><svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6 9 17l-5-5"/></svg>Specialist in modular laboratory construction</div>
            <div class="flex items-center gap-2"><svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6 9 17l-5-5"/></svg>Award 2026 EU Business News</div>
            <div class="flex items-center gap-2"><svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6 9 17l-5-5"/></svg>EU single market: no customs</div>
            <div class="flex items-center gap-2"><svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6 9 17l-5-5"/></svg>Wesemann Group · 60+ years of laboratory construction</div>
          </div>
        </div>
      </div>
    </section>

    <AuthorBio city="Vienna"  locale="en" />

    <!-- LABtoGO -->
    <section class="py-16 md:py-20 bg-gradient-to-br from-primary/5 via-white to-primary/10 border-y border-primary/20">
      <div class="container mx-auto px-4">
        <div class="max-w-5xl mx-auto">
          <div class="grid md:grid-cols-2 gap-10 items-center mb-10">
            <div>
              <div class="text-primary font-bold text-sm uppercase tracking-wider mb-3">Pattern interrupt · World premiere at analytica 2026</div>
              <h2 class="text-3xl md:text-4xl font-heading font-bold mb-4 text-slate-900">Planexus shows Vienna what a lab container can really do in 2026</h2>
              <p class="text-lg text-gray-700 leading-relaxed mb-4">An ordinary lab container has 2,400 mm internal height. Working upright at a fume cupboard is a struggle.</p>
              <p class="text-lg text-slate-900 font-bold leading-relaxed mb-4">The Planexus LABtoGO has 2,750 mm internal height. 9.5 m external length. 3 m external width. A fully glazed front that brings genuine daylight into every life-science, hospital, research or pharmaceutical laboratory.</p>
              <p class="text-lg text-gray-700 leading-relaxed"><strong>An ordinary lab container fits entirely inside a LABtoGO.</strong> We configure it for Vienna to ÖNORM B 1998-1 seismic zone Z2/Z3, OIB Guideline 6 energy stricter than the German GEG, EU single-market compliant without customs clearance from the Albstadt works via the A8 + A1 Salzburg-Walserberg, and Austrian HGV toll via GO-Box.</p>
            </div>
            <div class="grid grid-cols-2 gap-4">
              <div class="bg-slate-900 text-white rounded-2xl p-6 text-center"><div class="text-4xl font-bold text-primary mb-1">2,750</div><div class="text-xs text-gray-400 uppercase tracking-wider">mm internal height</div><div class="text-xs text-gray-500 mt-1">Standard: 2,400 mm</div></div>
              <div class="bg-slate-900 text-white rounded-2xl p-6 text-center"><div class="text-4xl font-bold text-primary mb-1">9,500</div><div class="text-xs text-gray-400 uppercase tracking-wider">mm external length</div><div class="text-xs text-gray-500 mt-1">3,000 mm width</div></div>
              <div class="bg-slate-900 text-white rounded-2xl p-6 text-center"><div class="text-4xl font-bold text-primary mb-1">ÖNORM Z2/Z3</div><div class="text-xs text-gray-400 uppercase tracking-wider">Seismic agR 0.4–0.6</div><div class="text-xs text-gray-500 mt-1">by district</div></div>
              <div class="bg-slate-900 text-white rounded-2xl p-6 text-center"><div class="text-4xl font-bold text-primary mb-1">580 km</div><div class="text-xs text-gray-400 uppercase tracking-wider">Works → Vienna</div><div class="text-xs text-gray-500 mt-1">~6.5 h via Walserberg</div></div>
            </div>
          </div>
          <div class="text-center"><a href="/en/lab-containers/labtogo" class="inline-flex items-center gap-2 text-primary font-bold hover:underline">View the LABtoGO platform and all configurations<svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg></a></div>
        </div>
      </div>
    </section>

    <!-- PROBLEM-AGITATION -->
    <section class="py-16 md:py-20">
      <div class="container mx-auto px-4">
        <div class="max-w-5xl mx-auto">
          <h2 class="text-3xl md:text-4xl font-heading font-bold mb-10 text-slate-900">Planexus solves the three Vienna bottlenecks at which life-science and hospital containers regularly fail</h2>
          <div class="grid md:grid-cols-3 gap-6">
            <div class="bg-slate-50 border-l-4 border-primary rounded-xl p-6">
              <div class="text-slate-900 font-bold text-lg mb-2">Life-science cluster underestimated</div>
              <p class="text-gray-700 text-sm leading-relaxed">The life-science campus on Dr.-Bohr-Gasse unites several molecular-biology research institutes and more than 2,500 scientists from more than 90 nations — one of the EU’s top life-science hubs. Containers that land here must be BSL-2/3-compliant and cluster-connectable immediately. A standard container without ÖNORM structural design and OIB energy evidence is stopped by MA 37 within 24 hours.</p>
              <p class="text-sm text-slate-900 font-semibold mt-3 pt-3 border-t border-gray-200">Planexus answer: ÖNORM- and OIB-compliant from the works, cluster-connectable.</p>
            </div>
            <div class="bg-slate-50 border-l-4 border-primary rounded-xl p-6">
              <div class="text-slate-900 font-bold text-lg mb-2">BASG therapeutic-products path not used</div>
              <p class="text-gray-700 text-sm leading-relaxed">BASG (Federal Office for Safety in Health Care) sits at Traisengasse 5, 1200 Vienna — the Austrian counterpart to BfArM and Swissmedic, organisationally under the AGES umbrella. For every GMP cleanroom-container project with a therapeutic-products dimension, BASG is the inspection authority. Anyone commissioning standard freight operators from Linz or Graz leaves this advantage unused and loses weeks.</p>
              <p class="text-sm text-slate-900 font-semibold mt-3 pt-3 border-t border-gray-200">Planexus answer: BASG inspection readiness documented from the works.</p>
            </div>
            <div class="bg-slate-50 border-l-4 border-primary rounded-xl p-6">
              <div class="text-slate-900 font-bold text-lg mb-2">EU single-market advantage given away</div>
              <p class="text-gray-700 text-sm leading-relaxed">Germany and Austria are both EU member states. There is no customs clearance, no VAT pre-financing — intra-Community supply with an ATU number is standard. Suppliers from Switzerland must present 8.1% VAT and clear through Thayngen. Suppliers outside the EU lose weeks on customs procedures. We deliver straight through.</p>
              <p class="text-sm text-slate-900 font-semibold mt-3 pt-3 border-t border-gray-200">Planexus answer: EU single-market delivery with ATU reverse charge, Salzburg-Walserberg without a stop.</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- STRATEGISCHE FUSION -->
    <section class="py-16 md:py-20 bg-slate-50">
      <div class="container mx-auto px-4">
        <div class="max-w-4xl mx-auto">
          <h2 class="text-3xl md:text-4xl font-heading font-bold mb-8 text-slate-900">Lab containers for Vienna: what life science, hospitals, research and authorities demand of the engineering</h2>
          <div class="prose prose-lg max-w-none text-gray-700 space-y-6">
            <p><strong>Vienna is Austria’s largest life-science cluster and one of the EU’s top locations.</strong> Here lies the life-science campus at Dr.-Bohr-Gasse 7, 1030 Vienna — with several molecular-biology research institutes for molecular pathology, molecular biotechnology, plant biology and structural biology, and more than 2,500 scientists from more than 90 nations — one of the EU’s top life-science hubs. Here lies the large university hospital at Währinger Gürtel 18-20, 1090 Vienna — around 9,000 staff, 2,165 beds, Austria’s largest hospital. In the Klosterneuburg area, around 25 km north-west of Vienna, lies an elite research institute with around 80 professorships. In Vienna-Liesing (1120 Vienna) lies one of the country’s largest pharmaceutical sites. Added to this are the authorities AGES (Austrian Agency for Health and Food Safety) at Spargelfeldstrasse 191, 1220 Vienna, and BASG (Federal Office for Safety in Health Care) at Traisengasse 5, 1200 Vienna, a molecular-medicine research centre at Lazarettgasse 14, 1090 Vienna (near the university hospital), and the city’s technical and veterinary universities.</p>
            <p><strong>We know this market in detail.</strong> We know that Magistratsabteilung 37 – Baupolizei (MA 37, Municipal Department 37 – Building Control) at Dresdner Strasse 73-75, 1200 Vienna, decides under the Building Code for Vienna (BO Wien) and OIB Guidelines 1–6 of the Austrian Institute of Construction Engineering. We know that ÖNORM B 1998-1 (EC8 seismic) defines zone Z2 to Z3 for Vienna with agR 0.4–0.6 m/s² depending on district — moderate, but importance category II for hospital, life-science and research sites is mandatory. We know that containers for translational research at the life-science campus must practically always be cluster-connectable (shared institute infrastructure) and BSL-2/3-compliant at the same time. We know Vienna’s decisive advantage: BASG case officers are reachable by underground in 20 minutes, AGES sits in the same district — on-site inspections for GTG notifications (BSL-3) and GMP (therapeutic products) can be scheduled at short notice, and written queries are answered in 5 to 10 working days. From Linz or Graz those are always travel days — from Vienna underground rides. These details are not in our quotation — they are the engineering and authority foundation of every container that leaves our Albstadt works.</p>
            <p><strong>Made in Albstadt, EU single-market compliant without customs, turnkey in Vienna.</strong> Final assembly and interior fit-out are carried out with Wesemann furniture in our own works — factory visits can be arranged from either side. North-east on the A81 to Stuttgart, then east on the A8 via Munich → Salzburg, Walserberg border crossing (DE/AT EU single market, no stop since Schengen), then east on the A1 via Linz → Vienna, the heavy-haulage distance is around 580 kilometres (~6.5 h). Standard delivery points: the life-science campus on Dr.-Bohr-Gasse, the hospital and university site on Währinger Gürtel, Klosterneuburg-Süd for research institutes in the surrounding area, Liesing-Süd for pharmaceutical sites, Donaustadt for AGES, Brigittenau for BASG, Floridsdorf for veterinary sites.</p>
            <p>Whether you need a <strong>mobile laboratory in Vienna</strong> for a time-limited hospital refurbishment, a <strong>modular lab container in Vienna</strong> for expansion of the life-science cluster, or a <strong>container laboratory in Vienna</strong> with BSL-3 containment and BASG-ready GMP for Viennese pharmaceutical spin-offs — we deliver all three answers from the same platform: the LABtoGO from our Albstadt works, with ÖNORM structural design, OIB energy evidence, GTG notification and BASG authority path documented from the factory.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- 6 ENGINEERING -->
    <section class="py-16 md:py-20">
      <div class="container mx-auto px-4">
        <div class="max-w-6xl mx-auto">
          <h2 class="text-3xl md:text-4xl font-heading font-bold mb-3 text-slate-900">Six engineering disciplines for Austria’s federal capital</h2>
          <p class="text-gray-600 text-lg mb-10 max-w-3xl">Planexus builds lab containers for Vienna that are aligned in every discipline with Austrian realities and EU top life-science-hub requirements — not generic, but standard- and site-specific.</p>
          <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-5">
            <div class="bg-slate-50 rounded-xl p-6 border border-gray-100"><div class="text-primary text-xs font-bold uppercase tracking-wider mb-2">ÖNORM B 1998-1 EC8</div><h3 class="font-bold text-slate-900 mb-2">Z2/Z3 + importance cat. II</h3><p class="text-sm text-gray-600">Vienna Z2/Z3 by district with agR 0.4–0.6 m/s². Structural design with ÖNORM B 1991 anchoring concept, importance category II for hospital, life-science and research sites — not DIN alone.</p></div>
            <div class="bg-slate-50 rounded-xl p-6 border border-gray-100"><div class="text-primary text-xs font-bold uppercase tracking-wider mb-2">BASG and AGES path</div><h3 class="font-bold text-slate-900 mb-2">Therapeutic products + food, direct</h3><p class="text-sm text-gray-600">BASG inspection (Traisengasse 5, Brigittenau) and AGES assessment (Spargelfeldstrasse 191, Donaustadt) — both an underground ride away. Accelerated authority path.</p></div>
