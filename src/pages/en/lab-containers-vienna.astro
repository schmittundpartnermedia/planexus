---
import Layout from '../../layouts/Layout.astro';
import ContactForm from '../../components/ContactForm.tsx';
import AuthorBio from '../../components/AuthorBio.astro';
import CityCrossLinks from '../../components/CityCrossLinks.astro';

const title = "Laborcontainer Wien mieten – GMP, Reinraum, ATEX";
const description = "Laborcontainer Wien mieten: BSL-3, OIB/ÖNORM für Life-Science, Kliniken und Forschung. EU-Binnenmarkt ohne Zoll, ab Albstadt in 8–14 Wochen. Jetzt Angebot anfordern.";
const canonical = "/laborcontainer-wien";

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "serviceType": "Laborcontainer und modularer Laborbau Wien",
  "provider": {
    "@type": "Organization",
    "name": "Planexus GmbH",
    "image": "https://planexus.de/android-chrome-512x512.png",
    "url": "https://planexus.de",
    "telephone": "+49 7435 7519 700",
    "email": "info@planexus.de",
    "address": { "@type": "PostalAddress", "streetAddress": "Am Steinbach 8", "addressLocality": "Albstadt-Laufen", "addressRegion": "Baden-Württemberg", "postalCode": "72459", "addressCountry": "DE" },
    "parentOrganization": { "@type": "Organization", "name": "Wesemann Holding GmbH" }
  },
  "areaServed": [
    { "@type": "City", "name": "Wien" },
    { "@type": "AdministrativeArea", "name": "Bundesland Wien" },
    { "@type": "Country", "name": "Österreich" }
  ],
  "description": "Containerlabore, mobile Labore und modulare Laborgebäude für den Life-Science-Cluster, Universitätskliniken, Hochschulen, Forschungsinstitute, Pharma-Standorte sowie Behörden wie AGES und BASG – ab Werk Albstadt EU-binnenmarktkonform nach Wien über A8 + A1 Salzburg.",
  "offers": { "@type": "AggregateOffer", "priceCurrency": "EUR", "availability": "https://schema.org/InStock" }
};

const localBusinessSchema = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "name": "Planexus GmbH – Laborcontainer Wien",
      "image": "https://planexus.de/images/labtogo-industrie.webp",
  "url": "https://planexus.de/en/lab-containers-vienna",
  "telephone": "+49 7435 7519 700",
  "email": "info@planexus.de",
  "address": { "@type": "PostalAddress", "streetAddress": "Am Steinbach 8", "addressLocality": "Albstadt-Laufen", "addressRegion": "Baden-Württemberg", "postalCode": "72459", "addressCountry": "DE" },
  "areaServed": { "@type": "City", "name": "Wien", "containedInPlace": { "@type": "Country", "name": "Österreich" } },
  "priceRange": "EUR",
  "openingHoursSpecification": [{ "@type": "OpeningHoursSpecification", "dayOfWeek": ["Monday","Tuesday","Wednesday","Thursday","Friday"], "opens": "08:00", "closes": "17:00" }]
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Start", "item": "https://planexus.de/en" },
    { "@type": "ListItem", "position": 2, "name": "Standorte", "item": "https://planexus.de/en/lab-containers" },
    { "@type": "ListItem", "position": 3, "name": "Laborcontainer Wien", "item": "https://planexus.de/en/lab-containers-vienna" }
  ]
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Wie lange dauert die Lieferung eines Laborcontainers nach Wien vom Werk Albstadt?",
      "acceptedAnswer": { "@type": "Answer", "text": "Die Schwerlastroute Werk Albstadt → Wien führt über die A81 nordostwärts bis Stuttgart, dann A8 ostwärts via München → Salzburg, Grenzübergang Walserberg (DE/AT EU-Binnenmarkt, keine Zollabfertigung), weiter A1 ostwärts via Linz → Wien. Reine Fahrzeit beträgt rund 6,5 Stunden bei circa 580 Kilometern Distanz – innerhalb der Lenkzeitvorschriften ein Transporttag mit Pflichtpause. Standardanlieferpunkte: der Life-Science-Campus an der Dr.-Bohr-Gasse, der Klinik- und Hochschulstandort am Währinger Gürtel, Klosterneuburg-Süd für die Forschungsinstitute im Umland, Liesing-Süd für die Pharma-Standorte, Donaustadt für die AGES an der Spargelfeldstr., Brigittenau für das BASG an der Traisengasse sowie Floridsdorf für die veterinärmedizinischen Standorte. Vom Auftrag bis zur betriebsbereiten Übergabe in Wien vergehen 8 bis 14 Wochen." }
    },
    {
      "@type": "Question",
      "name": "Welche Bewilligungen brauche ich für einen Laborcontainer in Wien?",
      "acceptedAnswer": { "@type": "Answer", "text": "In Wien gilt die Bauordnung für Wien (BO Wien) als Wiener Landesgesetz, ergänzt durch die OIB-Richtlinien 1 bis 6 des Österreichischen Institut für Bautechnik (statt der deutschen MBO/LBO oder Schweizer SIA-Normen). Zuständig ist die Magistratsabteilung 37 – Baupolizei (MA 37) an der Dresdner Straße 73-75, 1200 Wien. Container gelten als Bauten gemäss § 60 BO Wien, eine Bauanzeige oder Baubewilligung ist in den meisten Fällen nötig. Bei temporärer Aufstellung unter 6 Monaten ist je nach Standort ein vereinfachtes Anzeigeverfahren möglich. Wir prüfen Ihren Standort vorab und reichen verfahrenstaugliche Bauunterlagen direkt bei MA 37 ein – inklusive ÖNORM-Statik, OIB-Energienachweis und Brandschutzkonzept nach OIB-RL 2." }
    },
    {
      "@type": "Question",
      "name": "Was bedeutet die Nähe zu BASG und AGES für GMP- und BSL-3-Container in Wien?",
      "acceptedAnswer": { "@type": "Answer", "text": "Für jedes gentechnische Containment in Österreich braucht es eine Anzeige nach Gentechnikgesetz (GTG, BGBl. 510/1994 idgF) beim Bundesministerium für Soziales, Gesundheit, Pflege und Konsumentenschutz (BMSGPK) – Wien Stubenring 1 – und Stellungnahme der wissenschaftlichen Kommission. Für jedes GMP-Reinraumcontainer-Projekt mit Heilmittel-Bezug ist das BASG (Bundesamt für Sicherheit im Gesundheitswesen) an der Traisengasse 5, 1200 Wien, die zuständige Inspektionsbehörde – organisatorisch unter dem Dach der AGES. Wenn Ihr Standort in Wien liegt, sind alle drei Behörden (BMSGPK, BASG, AGES) innerhalb der Stadtgrenze – Vor-Ort-Inspektionen können kurzfristig terminiert werden, schriftliche Rückfragen werden in der Regel in 5 bis 10 Werktagen beantwortet. Aus Graz oder Linz sind das Reisetage – aus Wien Termine im selben Bezirk." }
    },
    {
      "@type": "Question",
      "name": "Welche Erdbeben- und Energie-Anforderungen gelten für Laborcontainer in Wien nach ÖNORM und OIB?",
      "acceptedAnswer": { "@type": "Answer", "text": "Wien liegt nach ÖNORM B 1998-1 (EC8 Erdbeben) je nach Bezirk in Erdbebenzone Z2 bis Z3 mit einer horizontalen Bemessungs-Bodenbeschleunigung von agR = 0,4 bis 0,6 m/s² – moderat, aber nicht zu vernachlässigen. Statisch-konstruktiv ist die Anforderung vergleichbar mit der Schweizer Z1a (Bern, Zürich), niedriger als Basel Z2. Container für Kliniken oder Forschungsinstitute müssen in Bedeutungskategorie II nach ÖNORM eingestuft werden. OIB-Richtlinie 6 (Energieeinsparung und Wärmeschutz) verlangt strenge HWB-Werte – meist HWB ≤ 25 kWh/m²a für Neubau. Wir liefern für Wien statisch nach ÖNORM B 1998-1 mit Z2/Z3-Faktor und ÖNORM B 1991-1-3 Schneelast (Wien Zone 1, sk ≈ 1,1 kN/m²) sowie energetisch nach OIB-RL 6 mit U ≤ 0,20 W/m²K und Wärmerückgewinnung ≥ 75 % – verfahrenstauglich für MA 37." }
    },
    {
      "@type": "Question",
      "name": "Wie funktioniert die Lieferung nach Österreich? EU-Binnenmarkt und Maut?",
      "acceptedAnswer": { "@type": "Answer", "text": "Deutschland und Österreich sind beide EU-Mitgliedstaaten und Teil des Binnenmarkts – es gibt keine Zollverzollung. Wir lieferen ab Werk Albstadt als innergemeinschaftliche Lieferung mit österreichischer USt-IdNr (ATU-Nummer) – steuerfrei in Deutschland, Reverse Charge in Österreich. Der Preisvorteil gegenüber Schweizer Standorten beträgt bis zu 8,1 % (Schweizer MwSt entfällt komplett). Für den Schwerlasttransport ist die österreichische LKW-Maut (GO-Box, ASFINAG) und die 10-Tages- oder Jahresvignette für Begleitfahrzeuge obligatorisch. Standardroute via Salzburg-Walserberg (DE/AT-Grenze) – seit Schengen kein Stopp. Vom Werk Albstadt nach Wien: ~580 km, ~6,5 h Fahrzeit + Pflichtpause." }
    },
    {
      "@type": "Question",
      "name": "Welche Anwendungen sind in Wien besonders nachgefragt?",
      "acceptedAnswer": { "@type": "Answer", "text": "Wien ist mit Abstand der grösste Life-Science-Cluster Österreichs und einer der EU-Top-Standorte. Typische Einsatzfelder für Laborcontainer ergeben sich rund um den Life-Science-Campus an der Dr.-Bohr-Gasse mit mehreren molekularbiologischen Forschungsinstituten und über 2.500 Wissenschaftlern aus mehr als 90 Nationen (BSL-2/3-Forschungs-Container und Pilot-Reinräume); die grosse Universitätsklinik am Währinger Gürtel, das grösste Spital Österreichs (Studien-Container während Sanierungen und IRB-Forschung); ein Elite-Forschungsinstitut im Umland von Klosterneuburg (Erweiterungs-Container); die Pharma-Industrie in Liesing (GMP-Pilotanlagen); die Behörde AGES an der Spargelfeldstrasse (Lebensmittelsicherheits- und Veterinär-Container); ein Forschungszentrum für Molekulare Medizin nahe der Universitätsklinik (translationale BSL-2-Container); sowie die technischen und veterinärmedizinischen Hochschulen der Stadt." }
    },
    {
      "@type": "Question",
      "name": "Können Sie BSL-3-Container für Forschung und Kliniken liefern?",
      "acceptedAnswer": { "@type": "Answer", "text": "Ja. Wir bauen BSL-3-Container für klinische Forschung, infektiologische Diagnostik und translationale Pharma-Pilotierung im Werk Albstadt – HEPA-H14-Doppelfilterung, autoklavierte Schleuse, Unterdruck mit Drei-Stufen-Kaskade, Notstromversorgung und Datenlogger. Anzeige nach Gentechnikgesetz (GTG) beim BMSGPK Wien, Stellungnahme der wissenschaftlichen Kommission. Statik nach ÖNORM B 1998-1 (Z2/Z3) und ÖNORM B 1991, Energie nach OIB-RL 6, Brandschutz nach OIB-RL 2. Für Container an einem Life-Science-Campus wäre die Abstimmung mit der zuständigen Bau-Abteilung des Standorts erforderlich, für Klinik-Studien-Container mit der jeweiligen Bau-Direktion. IQ/OQ/PQ BASG-tauglich – die BASG-Nähe in Wien-Brigittenau kann eine beschleunigte Inspektion begünstigen." }
    }
  ]
};
---

<Layout title={title} description={description} canonical={canonical}>
  <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(localBusinessSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <div class="bg-white">

    <!-- HERO -->
    <section class="relative bg-slate-900 text-white overflow-hidden">
      <div class="relative z-10 container mx-auto px-4 py-20 md:py-28">
        <div class="max-w-4xl">
          <nav class="flex items-center gap-2 text-sm text-gray-400 mb-8" aria-label="Breadcrumb">
            <a href="/" class="hover:text-primary transition-colors">Start</a>
            <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m9 18 6-6-6-6"/></svg>
            <span>Standorte</span>
            <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m9 18 6-6-6-6"/></svg>
            <span class="text-primary">Wien</span>
          </nav>

          <div class="text-primary font-medium text-sm uppercase tracking-wider mb-4">Ihr Spezialist für Laborcontainer · EU-Top-Life-Science-Hub mit BASG vor Ort</div>

          <h1 class="text-4xl md:text-5xl lg:text-6xl font-heading font-bold mb-6 leading-tight">
            Laborcontainer Wien – BSL-3-Labore für Life-Science, Kliniken und Pharma
          </h1>

          <p class="text-xl text-gray-300 leading-relaxed mb-4">
            <strong class="text-white">Unsere Geschäftsführer bringen über zehn Jahre Erfahrung im Laborcontainerbau mit.</strong> Modular, OIB-konform, ÖNORM-statisch. Wir realisieren flexible Forschungs-, Klinik- und Industrie-Umgebungen für den Life-Science-Cluster, Universitätskliniken, Hochschulen, Forschungsinstitute, Pharma-Standorte sowie Behörden wie AGES und BASG – aus dem Werk Albstadt direkt nach Wien, EU-binnenmarktkonform ohne Zollverzollung über A8 + A1 Salzburg-Walserberg.
          </p>
          <p class="text-base text-gray-400 mb-8">Während andere noch planen, forschen Sie bereits.</p>

          <div class="flex flex-col sm:flex-row gap-4 mb-8">
            <a href="#anfrage" data-testid="button-cta-hero" class="bg-primary text-slate-900 font-bold px-8 py-4 rounded-lg hover:bg-primary/90 transition-colors inline-flex items-center justify-center gap-2 shadow-[0_0_20px_rgba(132,189,0,0.3)]">Kostenfreies Standort-Audit Wien<svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg></a>
            <a href="tel:+4974357519700" class="border border-white/20 text-white font-medium px-8 py-4 rounded-lg hover:bg-white/10 transition-colors inline-flex items-center justify-center gap-2"><svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>+49 7435 7519 700</a>
          </div>

          <div class="flex flex-wrap items-center gap-x-6 gap-y-2 text-sm text-gray-400">
            <div class="flex items-center gap-2"><svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6 9 17l-5-5"/></svg>Spezialist für modularen Laborbau</div>
            <div class="flex items-center gap-2"><svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6 9 17l-5-5"/></svg>Award 2026 EU Business News</div>
            <div class="flex items-center gap-2"><svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6 9 17l-5-5"/></svg>EU-Binnenmarkt: ohne Zoll</div>
            <div class="flex items-center gap-2"><svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6 9 17l-5-5"/></svg>Wesemann-Gruppe · 60+ Jahre Laborbau</div>
          </div>
        </div>
      </div>
    </section>

    <AuthorBio city="Wien"  locale="en" />

    <!-- LABtoGO -->
    <section class="py-16 md:py-20 bg-gradient-to-br from-primary/5 via-white to-primary/10 border-y border-primary/20">
      <div class="container mx-auto px-4">
        <div class="max-w-5xl mx-auto">
          <div class="grid md:grid-cols-2 gap-10 items-center mb-10">
            <div>
              <div class="text-primary font-bold text-sm uppercase tracking-wider mb-3">Pattern-Interrupt · Weltpremiere analytica 2026</div>
              <h2 class="text-3xl md:text-4xl font-heading font-bold mb-4 text-slate-900">Planexus zeigt Wien, was ein Laborcontainer 2026 wirklich kann</h2>
              <p class="text-lg text-gray-700 leading-relaxed mb-4">Ein gewöhnlicher Laborcontainer hat 2.400 mm Innenhöhe. Aufrecht arbeiten unter einem Abzug ist mühsam.</p>
              <p class="text-lg text-slate-900 font-bold leading-relaxed mb-4">Der LABtoGO von Planexus hat 2.750 mm Innenhöhe. 9,5 m Außenlänge. 3 m Außenbreite. Vollverglaste Front, die echtes Tageslicht in jedes Life-Science-, Klinik-, Forschungs- oder Pharma-Labor bringt.</p>
              <p class="text-lg text-gray-700 leading-relaxed"><strong>Ein gewöhnlicher Laborcontainer passt komplett in einen LABtoGO hinein.</strong> Wir konfigurieren ihn für Wien nach ÖNORM B 1998-1 Erdbebenzone Z2/Z3, OIB-Richtlinie 6 Energie strenger als die deutsche GEG, EU-Binnenmarktkonform ohne Zollverzollung ab Werk Albstadt über A8 + A1 Salzburg-Walserberg und österreichischer LKW-Maut über GO-Box.</p>
            </div>
            <div class="grid grid-cols-2 gap-4">
              <div class="bg-slate-900 text-white rounded-2xl p-6 text-center"><div class="text-4xl font-bold text-primary mb-1">2.750</div><div class="text-xs text-gray-400 uppercase tracking-wider">mm Innenhöhe</div><div class="text-xs text-gray-500 mt-1">Standard: 2.400 mm</div></div>
              <div class="bg-slate-900 text-white rounded-2xl p-6 text-center"><div class="text-4xl font-bold text-primary mb-1">9.500</div><div class="text-xs text-gray-400 uppercase tracking-wider">mm Außenlänge</div><div class="text-xs text-gray-500 mt-1">3.000 mm Breite</div></div>
              <div class="bg-slate-900 text-white rounded-2xl p-6 text-center"><div class="text-4xl font-bold text-primary mb-1">ÖNORM Z2/Z3</div><div class="text-xs text-gray-400 uppercase tracking-wider">Erdbeben agR 0,4–0,6</div><div class="text-xs text-gray-500 mt-1">je Bezirk</div></div>
              <div class="bg-slate-900 text-white rounded-2xl p-6 text-center"><div class="text-4xl font-bold text-primary mb-1">580 km</div><div class="text-xs text-gray-400 uppercase tracking-wider">Werk → Wien</div><div class="text-xs text-gray-500 mt-1">~6,5 h via Walserberg</div></div>
            </div>
          </div>
          <div class="text-center"><a href="/en/lab-containers/labtogo" class="inline-flex items-center gap-2 text-primary font-bold hover:underline">LABtoGO Plattform und alle Konfigurationen ansehen<svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg></a></div>
        </div>
      </div>
    </section>

    <!-- PROBLEM-AGITATION -->
    <section class="py-16 md:py-20">
      <div class="container mx-auto px-4">
        <div class="max-w-5xl mx-auto">
          <h2 class="text-3xl md:text-4xl font-heading font-bold mb-10 text-slate-900">Planexus löst die drei Wiener Engpässe, an denen Life-Science- und Klinik-Container regelmässig scheitern</h2>
          <div class="grid md:grid-cols-3 gap-6">
            <div class="bg-slate-50 border-l-4 border-primary rounded-xl p-6">
              <div class="text-slate-900 font-bold text-lg mb-2">Life-Science-Cluster falsch unterschätzt</div>
              <p class="text-gray-700 text-sm leading-relaxed">Der Life-Science-Campus an der Dr.-Bohr-Gasse vereint mehrere molekularbiologische Forschungsinstitute und über 2.500 Wissenschaftler aus mehr als 90 Nationen – einer der EU-Top-Life-Science-Hubs. Container, die hier landen, müssen sofort BSL-2/3-konform und Cluster-vernetzbar sein. Standard-Container ohne ÖNORM-Statik und OIB-Energienachweis stoppt MA 37 in 24 Stunden.</p>
              <p class="text-sm text-slate-900 font-semibold mt-3 pt-3 border-t border-gray-200">Planexus-Antwort: ÖNORM- und OIB-konform ab Werk, Cluster-anschlussfähig.</p>
            </div>
            <div class="bg-slate-50 border-l-4 border-primary rounded-xl p-6">
              <div class="text-slate-900 font-bold text-lg mb-2">BASG-Heilmittelpfad nicht genutzt</div>
              <p class="text-gray-700 text-sm leading-relaxed">Das BASG (Bundesamt für Sicherheit im Gesundheitswesen) sitzt an der Traisengasse 5, 1200 Wien – das österreichische Pendant zu BfArM und Swissmedic, organisatorisch unter dem Dach der AGES. Für jedes GMP-Reinraumcontainer-Projekt mit Heilmittel-Bezug ist BASG die Inspektionsbehörde. Wer Standard-Spediteure aus Linz oder Graz beauftragt, lässt diesen Vorteil komplett liegen und verliert Wochen.</p>
              <p class="text-sm text-slate-900 font-semibold mt-3 pt-3 border-t border-gray-200">Planexus-Antwort: BASG-Inspektionsbereitschaft ab Werk dokumentiert.</p>
            </div>
            <div class="bg-slate-50 border-l-4 border-primary rounded-xl p-6">
              <div class="text-slate-900 font-bold text-lg mb-2">EU-Binnenmarkt-Vorteil verschenkt</div>
              <p class="text-gray-700 text-sm leading-relaxed">Deutschland und Österreich sind beide EU-Mitgliedstaaten. Es gibt keine Zollverzollung, keine MwSt-Vorfinanzierung – innergemeinschaftliche Lieferung mit ATU-Nummer ist Standard. Anbieter aus der Schweiz müssen 8,1 % MwSt vorlegen und durch Thayngen verzollen. Anbieter ausserhalb der EU verlieren Wochen an Zollverfahren. Wir liefern direkt durch.</p>
              <p class="text-sm text-slate-900 font-semibold mt-3 pt-3 border-t border-gray-200">Planexus-Antwort: EU-Binnenmarkt-Lieferung mit ATU-Reverse-Charge, Salzburg-Walserberg ohne Stopp.</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- STRATEGISCHE FUSION -->
    <section class="py-16 md:py-20 bg-slate-50">
      <div class="container mx-auto px-4">
        <div class="max-w-4xl mx-auto">
          <h2 class="text-3xl md:text-4xl font-heading font-bold mb-8 text-slate-900">Laborcontainer für Wien: Was Life-Science, Kliniken, Forschung und Behörden vom Engineering verlangen</h2>
          <div class="prose prose-lg max-w-none text-gray-700 space-y-6">
            <p><strong>Wien ist der grösste Life-Science-Cluster Österreichs und einer der EU-Top-Standorte.</strong> Hier liegt der Life-Science-Campus an der Dr.-Bohr-Gasse 7, 1030 Wien – mit mehreren molekularbiologischen Forschungsinstituten für Molekulare Pathologie, Molekulare Biotechnologie, Pflanzenbiologie und Strukturbiologie sowie über 2.500 Wissenschaftlern aus mehr als 90 Nationen – einer der EU-Top-Life-Science-Hubs. Hier liegt die grosse Universitätsklinik am Währinger Gürtel 18-20, 1090 Wien – rund 9.000 Mitarbeitende, 2.165 Betten, das grösste Spital Österreichs. Im Umland von Klosterneuburg, rund 25 km nordwestlich Wiens, liegt ein Elite-Forschungsinstitut mit rund 80 Professuren. In Wien-Liesing (1120 Wien) liegt einer der grössten Pharma-Standorte des Landes. Dazu kommen die Behörden AGES (Agentur für Gesundheit und Ernährungssicherheit) an der Spargelfeldstrasse 191, 1220 Wien, und BASG (Bundesamt für Sicherheit im Gesundheitswesen) an der Traisengasse 5, 1200 Wien, ein Forschungszentrum für Molekulare Medizin an der Lazarettgasse 14, 1090 Wien (nahe der Universitätsklinik), sowie die technischen und veterinärmedizinischen Hochschulen der Stadt.</p>
