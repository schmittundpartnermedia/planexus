---
import Layout from '../../../layouts/Layout.astro';

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": "Laborausstattung",
  "description": "Komplette Laborausstattung mit Labormöbeln, Abzügen und Sicherheitseinrichtungen",
  "provider": { "@type": "Organization", "name": "Planexus GmbH", "image": "https://planexus.de/android-chrome-512x512.png" },
  "url": "https://planexus.de/en/services/equipment"
};
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Start", "item": "https://planexus.de/en" },
    { "@type": "ListItem", "position": 2, "name": "Leistungen", "item": "https://planexus.de/en/services" },
    { "@type": "ListItem", "position": 3, "name": "Laborausstattung", "item": "https://planexus.de/en/services/equipment" }
  ]
};
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    { "@type": "Question", "name": "Welche Normen gelten für die Laborausstattung im Container?", "acceptedAnswer": { "@type": "Answer", "text": "Die Ausstattung orientiert sich an DIN EN 14175 für Laborabzüge, EN 14470-1/-2 für Sicherheitsschränke, DIN EN 12469 für Sicherheitswerkbänke, DIN EN 15154 für Notduschen, ISO 17025 für Prüflabor-Anforderungen, EU-GMP Annex 1 für sterile Arbeitsbereiche und EN 60079 für ATEX-Zonen. Jedes Ausstattungselement wird mit Konformitätserklärung und Einbauort im Container dokumentiert." } },
    { "@type": "Question", "name": "Werden Abzüge ab Werk vormontiert und geprüft?", "acceptedAnswer": { "@type": "Answer", "text": "Ja. Laborabzüge nach DIN EN 14175 werden im Werk Albstadt vormontiert, an die Container-Lüftung angeschlossen und mit Sichtprüfung, Dichtheitsprüfung und Face-Velocity-Messung (typisch 0,5 m/s ±20 %) abgenommen. Bei GMP-Projekten erfolgt zusätzlich eine IQ-Dokumentation mit Seriennummern, Filterwechseldatum und Abluftführungsnachweis." } },
    { "@type": "Question", "name": "Können Sicherheitsschränke nach EN 14470 im Container installiert werden?", "acceptedAnswer": { "@type": "Answer", "text": "Ja. Wir installieren EN-14470-1-Schränke für brennbare Flüssigkeiten (90-Minuten-Feuerwiderstand) und EN-14470-2-Schränke für Druckgasflaschen direkt im Container. Die Belüftung der Schränke wird an die Container-Lüftung oder separate Abluftführung angeschlossen. Für ATEX-Zonen nach EN 60079 kommen zugelassene Ex-Schutz-Schränke zum Einsatz." } },
    { "@type": "Question", "name": "Wie wird die Ausstattung an ISO 17025 angepasst?", "acceptedAnswer": { "@type": "Answer", "text": "ISO-17025-Prüflabore benötigen kalibrierbare Umgebungsbedingungen, rückverfolgbare Messmittel und dokumentierte Arbeitsplätze. Wir planen temperaturstabile Arbeitszonen (±2 K), vibrationsgedämpfte Tische für Wägearbeiten, kalibrierte Medienanschlüsse und ausreichend Arbeitsfläche pro Prüfverfahren. Die Ausstattungsliste wird als Teil der Akkreditierungsunterlagen geliefert." } },
    { "@type": "Question", "name": "Ist die Ausstattung für GMP-Container Annex-1-konform?", "acceptedAnswer": { "@type": "Answer", "text": "GMP-Ausstattung umfasst Edelstahlarbeitsflächen, abwaschbare Oberflächen ohne Poren, Laminar-Flow-Benches oder RABS, Materialschleusen und dokumentierte Reinigungsvalidierung. Alle Oberflächen und Möbel entsprechen Annex-1-Anforderungen an Partikelabgabe und Reinigbarkeit. Die Ausstattung wird in die IQ/OQ/PQ-Dokumentation integriert." } },
    { "@type": "Question", "name": "Kann Bestandsausstattung in den Container übernommen werden?", "acceptedAnswer": { "@type": "Answer", "text": "Ja, sofern Geräte transportfähig sind und in die Container-Grundrissplanung passen. Wir prüfen Anschlusswerte (400 V, Druckluft, Abwasser), Schwingungsanforderungen und Gefahrstoffzonen. Bestands-Abzüge werden selten übernommen – neue DIN-EN-14175-Abzüge mit validierter Face-Velocity sind wirtschaftlicher. Für ISO-17025-Prüflabore dokumentieren wir die Übernahme im IQ-Protokoll inklusive erneuter Kalibrierung am neuen Standort." } }
  ]
};
---

<Layout title="Laborcontainer Ausstattung – Möbel, Sicherheit, Technik" description="Laborcontainer Ausstattung: Labormöbel, Abzüge DIN EN 14175, Sicherheitswerkbänke aus dem Wesemann-Verbund. Normgerecht ab Werk. Jetzt Ausstattung planen." canonical="/en/services/equipment" schema={serviceSchema} ogImage="/attached_assets/Kopf_green-scaled_1768306688943.jpg">
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} slot="head" />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} slot="head" />

  <div class="pt-20 min-h-screen bg-white">
    <section class="relative py-24 bg-slate-900 text-white overflow-hidden">
      <div class="absolute inset-0 bg-[url('/images/backgrounds/lab-ausstattung.webp')] bg-cover bg-center opacity-20"></div>
      <div class="absolute inset-0 bg-gradient-to-r from-slate-900 via-slate-900/95 to-slate-900/80"></div>
      <div class="container mx-auto px-4 relative z-10">
        <div class="max-w-4xl">
          <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-primary text-slate-900 font-medium text-sm mb-6">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 18h8"/><path d="M3 22h18"/><path d="M14 22a7 7 0 1 0 0-14h-1"/><path d="M9 14h2"/><path d="M9 12a2 2 0 0 1-2-2V6h6v4a2 2 0 0 1-2 2Z"/><path d="M12 6V3a1 1 0 0 0-1-1H9a1 1 0 0 0-1 1v3"/></svg>
            <span>Leistungen</span>
          </div>
          <h1 class="text-3xl md:text-5xl font-heading font-bold mb-6 leading-tight">Laborcontainer Ausstattung – Möbel, Technik, Sicherheit</h1>
          <p class="text-lg md:text-xl text-gray-300 leading-relaxed max-w-3xl mb-4">Labormöbel, Abzugssysteme nach DIN EN 14175, Sicherheitswerkbänke und vollständige Geräteintegration – ab Werk im Container vormontiert.</p>
          <p class="text-base text-gray-400 leading-relaxed max-w-3xl mb-8">Aus dem <strong class="text-white">Wesemann-Holding-Verbund</strong> – einer der drei führenden Labormöbelhersteller Europas. Keine Standard-Werkstattausstattung, keine Büromöbel – ausschließlich Laborinventar für BSL-, GMP- und ATEX-Container.</p>
          <div class="flex flex-col sm:flex-row gap-4">
            <a href="/en/contact" class="bg-primary text-slate-900 font-bold px-8 py-4 rounded-lg hover:bg-primary/90 transition-colors inline-flex items-center gap-2">Ausstattung anfragen <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg></a>
            <a href="tel:+4974357519700" class="border border-white/20 text-white font-medium px-8 py-4 rounded-lg hover:bg-white/10 transition-colors inline-flex items-center gap-2"><svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg> Direkt anrufen</a>
          </div>
        </div>
      </div>
    </section>

    <div class="bg-slate-50 border-b border-gray-100 py-4">
      <div class="container mx-auto px-4">
        <div class="flex items-center gap-2 text-sm text-gray-500">
          <a href="/" class="hover:text-primary">Start</a>
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
          <a href="/en/services" class="hover:text-primary">Leistungen</a>
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
          <span class="text-primary font-medium">Laborausstattung</span>
        </div>
      </div>
    </div>

    <section class="py-20">
      <div class="container mx-auto px-4">
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-16">
          <div class="lg:col-span-2 space-y-12">
            <div>
              <h2 class="text-3xl font-heading font-bold mb-6 text-slate-900">Ausstattung nach ISO 17025 und GMP-Standard im Laborcontainer</h2>
              <div class="prose prose-lg text-gray-600 max-w-none space-y-6">
                <p>Die Laborausstattung im Container folgt dem Prinzip der Werksvormontage: Labormöbel, Abzüge, Sicherheitseinrichtungen und Medienarmaturen werden im Werk Albstadt installiert, geprüft und dokumentiert. Vor Ort erfolgt nur der Medienanschluss an die örtliche Infrastruktur.</p>
                <p>Als Teil der Wesemann Holding GmbH beziehen wir Labormöbel direkt vom Hersteller – ohne Zwischenhandel, mit kurzen Lieferzeiten und Sonderanfertigungsmöglichkeit. Jedes Möbelstück wird im Container-Layout positioniert, an Medienleitungen angeschlossen und in der Ausstattungsliste mit Artikelnummer und Position dokumentiert.</p>
                <p>Die Ausstattungsplanung beginnt parallel zur Containerplanung: Geräteliste, Arbeitsplatzdimensionen, Abzugstypen (DIN EN 14175), Sicherheitsschränke (EN 14470), Sicherheitswerkbänke (DIN EN 12469) und Medienanschlüsse werden im CAD-Modell platziert. So sind Kollisionen zwischen Möbeln, Leitungen und HVAC-Komponenten bereits in der Planungsphase ausgeschlossen.</p>
              </div>
            </div>

            <div>
              <h3 class="text-2xl font-heading font-bold mb-6 text-slate-900">Unsere Ausstattungsbereiche</h3>
              <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <a href="https://www.wesemann.com/" target="_blank" rel="noopener noreferrer" class="bg-slate-900 p-6 rounded-xl border border-slate-800 hover:shadow-lg transition-shadow group">
                  <div class="w-12 h-12 bg-primary rounded-lg flex items-center justify-center text-slate-900 mb-4"><svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><ellipse cx="12" cy="5" rx="9" ry="3"/><path d="M3 5V19A9 3 0 0 0 21 19V5"/><path d="M3 12A9 3 0 0 0 21 12"/></svg></div>
                  <h4 class="font-bold text-lg mb-2 text-white">Labormöbel</h4>
                  <p class="text-gray-300 text-sm mb-4">Arbeitstische, Unterschränke, Oberschränke und Regalsysteme nach Laborstandard.</p>
                  <p class="text-primary text-sm font-medium group-hover:underline">Powered by Wesemann Laboreinrichtungen →</p>
                </a>
                <div class="bg-slate-50 p-6 rounded-xl border border-gray-100 hover:shadow-lg transition-shadow">
                  <div class="w-12 h-12 bg-primary/10 rounded-lg flex items-center justify-center text-primary mb-4"><svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17.7 7.7a2.5 2.5 0 1 1 1.8 4.3H2"/><path d="M9.6 4.6A2 2 0 1 1 11 8H2"/><path d="M12.6 19.4A2 2 0 1 0 14 16H2"/></svg></div>
                  <h4 class="font-bold text-lg mb-2 text-slate-900">Abzugssysteme</h4>
                  <p class="text-gray-600 text-sm">Laborabzüge, Tischarbeitsplätze mit Absaugung und Umluftgeräte.</p>
                </div>
                <div class="bg-slate-50 p-6 rounded-xl border border-gray-100 hover:shadow-lg transition-shadow">
                  <div class="w-12 h-12 bg-primary/10 rounded-lg flex items-center justify-center text-primary mb-4"><svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"/></svg></div>
                  <h4 class="font-bold text-lg mb-2 text-slate-900">Sicherheitsausstattung</h4>
                  <p class="text-gray-600 text-sm">Notduschen, Augenspülungen, Feuerlöscher und Erste-Hilfe-Einrichtungen.</p>
                </div>
                <div class="bg-slate-50 p-6 rounded-xl border border-gray-100 hover:shadow-lg transition-shadow">
                  <div class="w-12 h-12 bg-primary/10 rounded-lg flex items-center justify-center text-primary mb-4"><svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m12 14 4-4"/><path d="M3.34 19a10 10 0 1 1 17.32 0"/></svg></div>
                  <h4 class="font-bold text-lg mb-2 text-slate-900">Medienversorgung</h4>
                  <p class="text-gray-600 text-sm">Gasarmaturen, Wasserinstallationen und Druckluftanschlüsse.</p>
                </div>
              </div>
            </div>

            <div>
              <h3 class="text-2xl font-heading font-bold mb-6 text-slate-900">Labormöbel im Detail</h3>
              <div class="prose prose-lg text-gray-600 max-w-none space-y-6">
                <p>Die Wahl der richtigen Labormöbel ist entscheidend für ergonomisches Arbeiten und effiziente Abläufe. Wir bieten eine breite Auswahl an hochwertigen Möbeln, die speziell für den Einsatz im Labor konzipiert sind.</p>
                <h4 class="text-xl font-bold text-slate-900 mt-8">Arbeitstische und Arbeitsplatten</h4>
                <p>Unsere Labortische sind robust, chemikalienbeständig und ergonomisch gestaltet. Die Arbeitsplatten sind in verschiedenen Materialien erhältlich – von klassischem Laborstein über Edelstahl bis hin zu speziellen Kunststoffen für besondere Anforderungen. Standardbreiten von 600 mm bis 900 mm und Höhen von 750 mm bis 900 mm ermöglichen sowohl Sitz- als auch Steharbeitsplätze.</p>
                <h4 class="text-xl font-bold text-slate-900 mt-8">Schranksysteme</h4>
                <p>Unterschränke, Oberschränke und Hochschränke bieten optimalen Stauraum für Laborgeräte, Chemikalien und Verbrauchsmaterialien. Für die sichere Aufbewahrung von Gefahrstoffen bieten wir zugelassene Sicherheitsschränke nach EN 14470-1 (für brennbare Flüssigkeiten) und EN 14470-2 (für Druckgasflaschen).</p>
                <h4 class="text-xl font-bold text-slate-900 mt-8">Spülen und Becken</h4>
                <p>Laborspülen aus PP, Keramik oder Edelstahl mit entsprechenden Armaturen und Siphons. Spezielle Ausführungen für säurebeständige Anwendungen oder die Mikrobiologie sind selbstverständlich möglich.</p>
              </div>
            </div>

            <div>
              <h3 class="text-2xl font-heading font-bold mb-6 text-slate-900">Abzüge und Absaugsysteme</h3>
              <div class="prose prose-lg text-gray-600 max-w-none space-y-6">
                <p>Laborabzüge sind das Herzstück vieler Laborarbeiten. Sie schützen den Anwender vor gefährlichen Dämpfen, Gasen und Stäuben und sind in vielen Bereichen gesetzlich vorgeschrieben. Wir bieten eine umfassende Auswahl an Abzugssystemen für verschiedene Anwendungen.</p>
                <h4 class="text-xl font-bold text-slate-900 mt-8">Standard-Laborabzüge</h4>
                <p>Unsere Standard-Laborabzüge erfüllen die Anforderungen der EN 14175 und bieten zuverlässigen Schutz bei chemischen Arbeiten. Verschiedene Breiten von 1200 mm bis 1800 mm und unterschiedliche Ausstattungsvarianten ermöglichen eine optimale Anpassung an Ihre Bedürfnisse.</p>
                <h4 class="text-xl font-bold text-slate-900 mt-8">Spezialabzüge</h4>
                <p>Für besondere Anwendungen bieten wir Spezialabzüge: Säure-Basen-Abzüge mit resistenten Oberflächen, Wägeabzüge für präzise Arbeiten ohne störende Luftströmungen, Zytostatika-Abzüge für die sichere Handhabung von Chemotherapeutika oder Radioisotopen-Abzüge mit spezieller Abschirmung.</p>
                <h4 class="text-xl font-bold text-slate-900 mt-8">Umluftgeräte</h4>
                <p>Wenn eine Abluftführung ins Freie nicht möglich ist, bieten Umluftgeräte eine Alternative. Sie reinigen die Luft durch Aktivkohlefilter und führen sie in den Raum zurück. Ideal für mobile Anwendungen oder temporäre Aufstellungen.</p>
              </div>
            </div>

            <div>
              <h3 class="text-2xl font-heading font-bold mb-6 text-slate-900">Sicherheitsausstattung</h3>
              <div class="prose prose-lg text-gray-600 max-w-none space-y-6">
                <p>Sicherheit hat im Labor oberste Priorität. Unsere Laborcontainer sind mit allen erforderlichen Sicherheitseinrichtungen ausgestattet, die den geltenden Vorschriften entsprechen und den Schutz Ihrer Mitarbeiter gewährleisten.</p>
                <ul class="list-none space-y-3">
                  <li class="flex items-start gap-3"><svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-primary shrink-0 mt-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><path d="m9 11 3 3L22 4"/></svg><span>Notduschen nach DIN EN 15154 für den Ernstfall</span></li>
                  <li class="flex items-start gap-3"><svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-primary shrink-0 mt-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><path d="m9 11 3 3L22 4"/></svg><span>Augenspüleinrichtungen an jedem Arbeitsplatz mit Gefahrstoffumgang</span></li>
                  <li class="flex items-start gap-3"><svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-primary shrink-0 mt-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><path d="m9 11 3 3L22 4"/></svg><span>Feuerlöscher entsprechend der Brandklassen im Labor</span></li>
                  <li class="flex items-start gap-3"><svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-primary shrink-0 mt-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><path d="m9 11 3 3L22 4"/></svg><span>Erste-Hilfe-Ausstattung nach BGI/GUV-I 509</span></li>
                  <li class="flex items-start gap-3"><svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-primary shrink-0 mt-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><path d="m9 11 3 3L22 4"/></svg><span>Notausgänge mit Panikbeschlägen und Fluchtwegkennzeichnung</span></li>
                  <li class="flex items-start gap-3"><svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-primary shrink-0 mt-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><path d="m9 11 3 3L22 4"/></svg><span>Gaswarnanlagen für die Detektion gefährlicher Atmosphären</span></li>
                  <li class="flex items-start gap-3"><svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-primary shrink-0 mt-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><path d="m9 11 3 3L22 4"/></svg><span>Not-Aus-Schalter für schnelles Abschalten aller Medien</span></li>
                </ul>
              </div>
            </div>

            <div>
              <h3 class="text-2xl font-heading font-bold mb-6 text-slate-900">Medienversorgung und Armaturen</h3>
              <div class="prose prose-lg text-gray-600 max-w-none space-y-6">
                <p>Die zuverlässige Versorgung mit Medien wie Gasen, Wasser und Druckluft ist für den Laborbetrieb unerlässlich. Wir installieren alle erforderlichen Systeme fachgerecht und nach den geltenden Normen.</p>
                <p><strong>Gasarmaturen:</strong> Für die Versorgung mit technischen Gasen (Stickstoff, Argon, Helium) oder Laborgasen (Propan/Butan) installieren wir entsprechende Entnahmestellen mit Absperrhähnen und Schnellkupplungen. Die farbliche Kennzeichnung erfolgt nach DIN EN 13792.</p>
                <p><strong>Wasserinstallationen:</strong> Laborwasser, VE-Wasser oder Reinstwasser – wir installieren die passenden Armaturen und Aufbereitungssysteme. Spezielle Laborarmaturen mit schwenkbarem Auslauf und Fußbedienung ermöglichen hygienisches Arbeiten.</p>
                <p><strong>Druckluftversorgung:</strong> Für Anwendungen, die ölfreie Druckluft benötigen, installieren wir entsprechende Anschlüsse mit Druckminderern und Wartungseinheiten.</p>
              </div>
            </div>

            <div>
              <h3 class="text-2xl font-heading font-bold mb-6 text-slate-900">Geräteintegration</h3>
              <div class="prose prose-lg text-gray-600 max-w-none space-y-6">
                <p>Viele Laborgeräte haben spezielle Anforderungen an Stromversorgung, Kühlung oder Abluftführung. Wir planen die Integration Ihrer Geräte von Anfang an mit und stellen sicher, dass alle Anschlüsse vorhanden sind.</p>
                <p>Ob Spektrometer, Chromatographen, Inkubatoren oder Autoklaven – wir berücksichtigen die spezifischen Anforderungen jedes Geräts und sorgen für eine optimale Aufstellung. Schwingungsdämpfung für empfindliche Messgeräte, USV-Anbindung für kritische Anlagen oder spezielle Abluftführungen für wärmeerzeugende Geräte werden in der Ausführungsplanung festgelegt.</p>
              </div>
            </div>

            <div>
              <h2 class="text-2xl font-heading font-bold mb-6 text-slate-900">Branchenspezifische Ausstattungskonfigurationen</h2>
              <div class="prose prose-lg text-gray-600 max-w-none space-y-6">
                <p>
                  Die Ausstattung wird nach Einsatzzweck konfiguriert. Für <a href="/en/industries/pharma-biotech" class="text-primary font-medium hover:underline">Laborcontainer Pharma &amp; Biotech</a> liefern wir Annex-1-konforme Arbeitsflächen, Laminar-Flow-Einheiten und GMP-Dokumentation. <a href="/en/industries/industry-materials-testing" class="text-primary font-medium hover:underline">Werkstoffprüf-Labore</a> erhalten vibrationsgedämpfte Prüfplätze, Härteprüf-Ausstattung und ISO-17025-konforme Messplatzdokumentation. <a href="/en/industries/oil-gas" class="text-primary font-medium hover:underline">Raffinerie- und Tanklager-Labore</a> bekommen AwSV-Auffang, Ex-Beleuchtung und H₂S-/LEL-Detektion bodennah.
                </p>
                <p>
                  BSL-3-Container erhalten Sicherheitswerkbänke Klasse II nach DIN EN 12469, Autoklaven, Personalschleusen und Notduschen nach DIN EN 15154. ATEX-Ausstattung nach EN 60079 umfasst Ex-geschützte Steckdosen, Erdungskonzepte und Gaswarnanlagen. Alle Komponenten werden ab Werk vormontiert und in der Übergabedokumentation mit Seriennummern und Prüfnachweisen erfasst.
                </p>
                <p>
                  Die Werksvormontage umfasst Funktionsprüfung jedes Ausstattungselements: Abzug-Face-Velocity nach DIN EN 14175 (0,5 m/s ±20 %), Sicherheitsschrank-Belüftung nach EN 14470, Medienarmaturen-Drucktest und elektrische Durchgangsprüfung. Ergebnisse fließen in die IQ-Dokumentation für GMP- und ISO-17025-Projekte.
                </p>
                <p>
                  GMP-Ausstattung nach Annex 1 umfasst Edelstahl-Arbeitsflächen (1.4301/1.4404), abwaschbare Wandverkleidungen, spaltarme Verbindungen und dokumentierte Reinigungsvalidierung. Jede Oberfläche wird auf Partikelabgabe und Chemikalienbeständigkeit geprüft, bevor sie im Container verbaut wird.
                </p>
                <p>
                  Medienversorgung wird nach DIN EN 13792 farblich gekennzeichnet: Rot für Brandgefahr (Propan/Butan), Blau für Oxidationsmittel (Sauerstoff), Grau für Inertgas (Stickstoff, Argon). Druckluftanschlüsse erhalten Wartungseinheiten mit Filter, Druckminderer und Kondensatabscheider nach ISO 8573-1 Klasse 1.4.1 für ölfreie Laborluft.
                </p>
                <p>
                  Sicherheitsschränke nach EN 14470-1 werden mit 90-Minuten-Feuerwiderstand und automatischer Türschließung geliefert. EN-14470-2-Schränke für Druckgasflaschen erhalten Belüftungsanschluss und Erdung. Beide Typen werden im Container fest verankert und in der Gefährdungsbeurteilung nach GefStoffV dokumentiert.
                </p>
              </div>
            </div>
          </div>

