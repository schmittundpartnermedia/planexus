---
import Layout from '../../../layouts/Layout.astro';

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://planexus.de/en" },
    { "@type": "ListItem", "position": 2, "name": "Services", "item": "https://planexus.de/en/services" }
  ]
};
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    { "@type": "Question", "name": "What services does Planexus provide for lab containers?", "acceptedAnswer": { "@type": "Answer", "text": "Planexus delivers six core services from a single source: specialist engineering design (CAD, MEP, ISO 14644 cleanrooms), modular construction and manufacturing (steel frame, BSL-3 engineering), logistics and installation (transport, siting, commissioning across DACH), laboratory equipment (ISO 17025, GMP, DIN EN 14175), consulting and permits (LBO, BImSchG, BioStoffV) and Smart Lab integration (IoT, GMP data capture, Annex 11)." } },
    { "@type": "Question", "name": "Can I book individual services or only the complete package?", "acceptedAnswer": { "@type": "Answer", "text": "Both are possible. You can commission individual services such as design, consulting or logistics separately. For turnkey lab containers we recommend the complete package, because all interfaces — design, manufacturing, equipment, permits and transport — are coordinated in-house. That shortens overall project time and eliminates trade clashes." } },
    { "@type": "Question", "name": "How long does a lab-container project take from enquiry to handover?", "acceptedAnswer": { "@type": "Answer", "text": "Standard lab containers (BSL-2, analytical): 8–12 weeks. GMP cleanroom or BSL-3 containers: 18–24 weeks including qualification (IQ/OQ/PQ). Series projects such as LABtoGO: 6–8 weeks. The 12-stage project process covers enquiry, needs analysis, design, permits, manufacturing in Albstadt, transport, siting, installation, testing and handover." } },
    { "@type": "Question", "name": "Which sectors does Planexus supply lab containers to?", "acceptedAnswer": { "@type": "Answer", "text": "Pharma and biotech (GMP Annex 1, ISO 14644), research and universities, public health and emergency preparedness (BSL-2/3), industry and materials testing (ISO 17025), energy transition H2 and battery (ATEX EN 60079), oil, gas and refining (ATEX, AwSV, fuel QC), education and further sectors. Each sector receives a standards-specific configuration — from cleanroom through BSL-3 to ATEX." } },
    { "@type": "Question", "name": "Where is the lab container manufactured and who delivers it?", "acceptedAnswer": { "@type": "Answer", "text": "Final assembly and fit-out take place at the Planexus works in Albstadt (Baden-Württemberg). Transport by low-loader throughout DACH, internationally by rail or sea freight. Siting by mobile crane, utilities connection and turnkey handover by our own installation teams. Via the A81, locations such as Stuttgart are reachable in 1.5 hours." } }
  ]
};
---

<Layout
  title="Lab container services – modular construction, cleanroom & design"
  description="Lab container services: design, modular construction, logistics, equipment, consulting and Smart Lab – full-service delivery from Albstadt. Request a project now."
  canonical="/en/services"
  ogImage="/attached_assets/Kopf_green-scaled_1768306688943.jpg"
>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} slot="head" />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} slot="head" />
  <div class="pt-20 min-h-screen bg-white">
    <section class="relative py-24 bg-slate-900 text-white overflow-hidden">
      <div class="absolute inset-0 bg-[url('/images/backgrounds/lab-leistungen.webp')] bg-cover bg-center opacity-10"></div>
      <div class="absolute inset-0 bg-gradient-to-b from-slate-900 via-slate-900/95 to-slate-900"></div>
      
      <div class="container mx-auto px-4 relative z-10">
