      <div class="container mx-auto px-4">
        <div class="grid grid-cols-2 md:grid-cols-4 gap-8 text-center">
          <div class="p-4">
            <div class="text-3xl md:text-4xl font-heading font-bold text-primary mb-1">10+</div>
            <p class="text-gray-600 text-sm font-medium">Years of management experience</p>
          </div>
          <div class="p-4">
            <div class="text-3xl md:text-4xl font-heading font-bold text-primary mb-1">50+</div>
