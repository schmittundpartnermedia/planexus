---
import Layout from '../../../layouts/Layout.astro';

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": "Logistics & installation",
  "description": "Worldwide transport and professional installation of lab containers with turnkey handover",
  "provider": { "@type": "Organization", "name": "Planexus GmbH", "image": "https://planexus.de/android-chrome-512x512.png" },
  "url": "https://planexus.de/en/services/logistics"
};
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://planexus.de/en" },
    { "@type": "ListItem", "position": 2, "name": "Services", "item": "https://planexus.de/en/services" },
    { "@type": "ListItem", "position": 3, "name": "Logistics & installation", "item": "https://planexus.de/en/services/logistics" }
  ]
};
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    { "@type": "Question", "name": "How is a lab container transported in DACH?", "acceptedAnswer": { "@type": "Answer", "text": "Standard containers (up to 2.55 m width, up to 30 t) are transported by low-loader from the Albstadt works to the site. Overwidth modules (>2.55 m) require abnormal-load permits with police escort. Transport planning covers access assessment, bridge-load evidence, crane standing area and time window. In Austria and Switzerland we coordinate analogous permits under the respective road-traffic law." } },
    { "@type": "Question", "name": "What foundation does a lab container need?", "acceptedAnswer": { "@type": "Answer", "text": "Depending on ground conditions and duration of use: pad foundations of concrete (C25/30) at container corners and load-bearing walls for permanent siting, strip foundations for higher loads, a foundation slab for multi-module complexes, or screw piles for temporary siting. The structural stability certificate to DIN EN 1990 is prepared before siting. Utility connections (400 V power, water, drainage, compressed air) are defined in the foundation plan." } },
    { "@type": "Question", "name": "How long do siting and commissioning on site take?", "acceptedAnswer": { "@type": "Answer", "text": "A standard 20-foot container is sited in 1 day (crane work, alignment, bolting); connection and commissioning take 2–3 days. Multi-module BSL-3 or GMP plants require 3–5 days of assembly plus 5–7 days for utilities connection, ventilation commissioning, leak testing and SAT. User induction takes place on the last day before turnkey handover." } },
    { "@type": "Question", "name": "Which permits are required for transport?", "acceptedAnswer": { "@type": "Answer", "text": "For standard transports within Germany the haulier’s HGV permit is sufficient. Abnormal loads (>3.5 m width or >40 t) require a special-transport permit from the road-traffic authority, possibly police escort and night running. For BSL-3 containers with biological agents additional transport rules under BioStoffV and ADR/RID apply. We obtain all transport permits and coordinate with the haulier and crane contractor." } },
    { "@type": "Question", "name": "Can Planexus also handle international deliveries?", "acceptedAnswer": { "@type": "Answer", "text": "Yes. International deliveries are by low-loader (EU), rail or sea freight (overseas). We handle customs formalities, export documents (EUR.1, export declaration), import permits at destination and coordination with local installation partners. Our technicians can accompany siting and commissioning worldwide. Containers meet ISO standards for freight containers and are designed for sea and rail transport." } },
    { "@type": "Question", "name": "What lead time applies from the Albstadt works for DACH sites?", "acceptedAnswer": { "@type": "Answer", "text": "From completion at the Albstadt works: Baden-Württemberg and Bavaria 1–2 days, northern Germany and NRW 2–3 days, Switzerland and Austria 2–4 days including customs declaration. Abnormal loads with overwidth extend delivery by 3–5 days because of permit procedures. We reserve crane slots and haulage capacity at contract award so that the installation date remains binding." } }
  ]
};
---

<Layout
  title="Lab container logistics – delivery, siting, connection"
  description="Lab container logistics: abnormal load, crane, siting and connection in DACH. BSL-2/3, GMP and ATEX turnkey on a foundation slab. Plan logistics now."
  canonical="/en/services/logistics"
  schema={serviceSchema}
  ogImage="/attached_assets/Kopf_green-scaled_1768306688943.jpg"
>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} slot="head" />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} slot="head" />

  <div class="pt-20 min-h-screen bg-white">
    <section class="relative py-24 bg-slate-900 text-white overflow-hidden">
      <div class="absolute inset-0 bg-[url('/images/backgrounds/lab-logistik.webp')] bg-cover bg-center opacity-20"></div>
      <div class="absolute inset-0 bg-gradient-to-r from-slate-900 via-slate-900/95 to-slate-900/80"></div>
      <div class="container mx-auto px-4 relative z-10">
        <div class="max-w-4xl">
          <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-primary text-slate-900 font-medium text-sm mb-6">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 18V6a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2v11a1 1 0 0 0 1 1h2"/><path d="M15 18H9"/><path d="M19 18h2a1 1 0 0 0 1-1v-3.65a1 1 0 0 0-.22-.624l-3.48-4.35A1 1 0 0 0 17.52 8H14"/><circle cx="17" cy="18" r="2"/><circle cx="7" cy="18" r="2"/></svg>
            <span>Services</span>
          </div>
          <h1 class="text-3xl md:text-5xl font-heading font-bold mb-6 leading-tight">Lab container logistics – transport, siting, connection</h1>
          <p class="text-lg md:text-xl text-gray-300 leading-relaxed max-w-3xl mb-4">Abnormal load, crane, placement on a foundation slab and commissioning — turnkey throughout DACH and worldwide.</p>
          <p class="text-base text-gray-400 leading-relaxed max-w-3xl mb-8">Specialised in <strong class="text-white">BSL-2, BSL-3, GMP and ATEX lab containers</strong> from the Albstadt works. No general haulage, no furniture logistics — exclusively modular laboratory construction with the permits, crane sizes and safety acceptances that requires.</p>
          <div class="flex flex-col sm:flex-row gap-4">
            <a href="/en/contact" class="bg-primary text-slate-900 font-bold px-8 py-4 rounded-lg hover:bg-primary/90 transition-colors inline-flex items-center gap-2">Plan logistics <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg></a>
            <a href="tel:+4974357519700" class="border border-white/20 text-white font-medium px-8 py-4 rounded-lg hover:bg-white/10 transition-colors inline-flex items-center gap-2"><svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg> Call now</a>
          </div>
        </div>
      </div>
    </section>

    <div class="bg-slate-50 border-b border-gray-100 py-4">
      <div class="container mx-auto px-4">
        <div class="flex items-center gap-2 text-sm text-gray-500">
          <a href="/en" class="hover:text-primary">Home</a>
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
          <a href="/en/services" class="hover:text-primary">Services</a>
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
          <span class="text-primary font-medium">Logistics & installation</span>
        </div>
      </div>
    </div>

    <section class="py-20">
      <div class="container mx-auto px-4">
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-16">
          <div class="lg:col-span-2 space-y-12">
            <div>
              <h2 class="text-3xl font-heading font-bold mb-6 text-slate-900">Transport and siting of lab containers in DACH</h2>
              <div class="prose prose-lg text-gray-600 max-w-none space-y-6">
                <p>Lab-container logistics comprises four phases: site analysis (access, foundation, utility connections), transport planning (vehicle selection, permits, route), siting (crane, alignment, bolting) and commissioning (utilities connection, system testing, SAT, induction). Each phase is documented with a checklist and protocol.</p>
                <p>From the Albstadt works we reach sites in Stuttgart (1.5 h), Munich (2.5 h), Frankfurt (2.5 h) and Zurich (2 h) via the A81 on the same day — without overnight logistics. For abnormal loads (>2.55 m width) we organise special permits and police escort. Transport planning starts in parallel with manufacturing, not only after works acceptance.</p>
                <p>Turnkey handover covers: structural stability certificate, electrical testing to VDE 0100-600, ventilation commissioning with volume-flow measurement, utilities-connection pressure test, leak testing (BSL-3/GMP), SAT protocol and user induction. All protocols are issued as part of the handover documentation.</p>
              </div>
            </div>

            <div>
              <h3 class="text-2xl font-heading font-bold mb-6 text-slate-900">Our logistics services at a glance</h3>
              <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div class="bg-slate-50 p-6 rounded-xl border border-gray-100 hover:shadow-lg transition-shadow">
                  <div class="w-12 h-12 bg-primary/10 rounded-lg flex items-center justify-center text-primary mb-4"><svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg></div>
                  <h4 class="font-bold text-lg mb-2 text-slate-900">Site analysis</h4>
                  <p class="text-gray-600 text-sm">Assessment of access, siting area and connection options on site.</p>
                </div>
                <div class="bg-slate-50 p-6 rounded-xl border border-gray-100 hover:shadow-lg transition-shadow">
                  <div class="w-12 h-12 bg-primary/10 rounded-lg flex items-center justify-center text-primary mb-4"><svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m7.5 4.27 9 5.15"/><path d="M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z"/><path d="m3.3 7 8.7 5 8.7-5"/><path d="M12 22V12"/></svg></div>
                  <h4 class="font-bold text-lg mb-2 text-slate-900">Transport planning</h4>
                  <p class="text-gray-600 text-sm">Selection of the optimum transport route and coordination of all parties involved.</p>
                </div>
                <div class="bg-slate-50 p-6 rounded-xl border border-gray-100 hover:shadow-lg transition-shadow">
                  <div class="w-12 h-12 bg-primary/10 rounded-lg flex items-center justify-center text-primary mb-4"><svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"/><path d="M2 12h20"/></svg></div>
                  <h4 class="font-bold text-lg mb-2 text-slate-900">Worldwide delivery</h4>
                  <p class="text-gray-600 text-sm">Transport by lorry, rail or ship — including remote sites.</p>
                </div>
                <div class="bg-slate-50 p-6 rounded-xl border border-gray-100 hover:shadow-lg transition-shadow">
                  <div class="w-12 h-12 bg-primary/10 rounded-lg flex items-center justify-center text-primary mb-4"><svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76Z"/></svg></div>
                  <h4 class="font-bold text-lg mb-2 text-slate-900">Complete installation</h4>
                  <p class="text-gray-600 text-sm">Siting, alignment and connection of all technical systems.</p>
                </div>
              </div>
            </div>

            <div>
              <h3 class="text-2xl font-heading font-bold mb-6 text-slate-900">The transport process in detail</h3>
              <div class="prose prose-lg text-gray-600 max-w-none space-y-6">
                <h4 class="text-xl font-bold text-slate-900 mt-8">Preparation and planning</h4>
                <p>Every transport begins with careful planning. We analyse the destination, check access routes and identify possible obstacles. For abnormal loads or overwidth movements we obtain the required permits and coordinate police escorts where necessary.</p>
                <p>At the same time we prepare the siting location. We produce foundation plans, clarify utility connections (power, water, drainage, gases if required) and coordinate with local utilities. So that on delivery everything is ready for rapid commissioning.</p>
                <h4 class="text-xl font-bold text-slate-900 mt-8">Transport and loading</h4>
                <p>Loading is carried out with specialist cranes that lift the container safely onto the transport vehicle. Our containers are optimised for transport and have standardised lifting eyes and forklift pockets. During transport the container is secured against shifting and damage.</p>
                <p>For road transport we use low-loaders or container chassis, depending on the size and weight of the container. For standard containers (up to 2.55 m width) regular HGV transport is possible; for wider units we organise abnormal loads with the corresponding permits.</p>
                <h4 class="text-xl font-bold text-slate-900 mt-8">Siting on site</h4>
                <p>On arrival the container is unloaded with a mobile crane and positioned on the prepared foundation. Our installation teams align the container exactly and secure it against movement. For multi-module plants the individual modules are connected and sealed.</p>
              </div>
            </div>

            <div>
              <h3 class="text-2xl font-heading font-bold mb-6 text-slate-900">Connection and commissioning</h3>
              <div class="prose prose-lg text-gray-600 max-w-none space-y-6">
                <p>After siting, connection to the local infrastructure follows. Our electricians and installers connect the container to the power supply, connect water and drainage lines and establish the connection to any gas supplies.</p>
                <p>We then commission all technical systems. We check the ventilation plant, test the electrical systems and inspect the utilities supply. All tests are documented and issued to the customer as part of the handover documentation.</p>
                <h4 class="text-xl font-bold text-slate-900 mt-8">User induction</h4>
                <p>Before we hand over the laboratory, we induct your staff in the operation of all systems. We explain the ventilation controls, show the safety equipment and answer all questions. You can then put your new laboratory to productive use immediately.</p>
              </div>
            </div>

            <div>
              <h3 class="text-2xl font-heading font-bold mb-6 text-slate-900">Particular siting situations</h3>
              <div class="prose prose-lg text-gray-600 max-w-none space-y-6">
                <p>Siting a lab container is not always straightforward. Tight access, limited space or difficult ground conditions present particular demands. Our specialists have, however, already mastered a wide range of situations:</p>
                <ul class="list-none space-y-3">
                  <li class="flex items-start gap-3"><svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-primary shrink-0 mt-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><path d="m9 11 3 3L22 4"/></svg><span>Siting in courtyards with limited crane access</span></li>
                  <li class="flex items-start gap-3"><svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-primary shrink-0 mt-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><path d="m9 11 3 3L22 4"/></svg><span>Positioning on roofs of existing buildings</span></li>
                  <li class="flex items-start gap-3"><svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-primary shrink-0 mt-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><path d="m9 11 3 3L22 4"/></svg><span>Installation in cleanrooms or under confined space conditions</span></li>
                  <li class="flex items-start gap-3"><svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-primary shrink-0 mt-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><path d="m9 11 3 3L22 4"/></svg><span>Siting in remote areas without a paved access road</span></li>
                  <li class="flex items-start gap-3"><svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-primary shrink-0 mt-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><path d="m9 11 3 3L22 4"/></svg><span>Installation during ongoing operation in existing plants</span></li>
                  <li class="flex items-start gap-3"><svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-primary shrink-0 mt-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><path d="m9 11 3 3L22 4"/></svg><span>Temporary siting with later relocation</span></li>
                </ul>
                <p>Speak to us if you have a particular siting situation. Together we will find a solution that works.</p>
              </div>
            </div>

            <div>
              <h3 class="text-2xl font-heading font-bold mb-6 text-slate-900">Foundations and substructures</h3>
              <div class="prose prose-lg text-gray-600 max-w-none space-y-6">
                <p>A solid foundation is the basis for a stable and durable lab container. Depending on ground conditions and usage requirements we recommend various foundation solutions:</p>
                <p><strong>Pad foundations:</strong> The most economical solution on load-bearing ground. Concrete pads at the container corners and under load-bearing walls are sufficient for secure siting.</p>
                <p><strong>Strip foundations:</strong> For higher loads or less load-bearing ground, continuous concrete strips provide additional stability.</p>
                <p><strong>Foundation slab:</strong> The most substantial solution, ideal for permanent installations or where a continuous undercroft for plant is required.</p>
                <p><strong>Screw piles:</strong> A fast and reversible alternative, particularly suitable for temporary siting or where concrete works are not desired.</p>
              </div>
            </div>

            <div>
              <h3 class="text-2xl font-heading font-bold mb-6 text-slate-900">International logistics</h3>
              <div class="prose prose-lg text-gray-600 max-w-none space-y-6">
                <p>Our lab containers are in use worldwide — from the Arctic to tropical regions, from research stations in the desert to mobile laboratories on ships. For international deliveries we organise complete transport including all required documents.</p>
                <p>We handle customs formalities, prepare the necessary transport documents and coordinate with local partners at destination. Our containers are optimised for international transport and meet all requirements of the ISO standards for freight containers.</p>
                <p>On request our technicians accompany the container to destination and take over siting and commissioning on site.</p>
              </div>
            </div>

            <div>
              <h2 class="text-2xl font-heading font-bold mb-6 text-slate-900">Logistics by sector and containment level</h2>
              <div class="prose prose-lg text-gray-600 max-w-none space-y-6">
                <p>
                  BSL-3 and GMP containers require special transport and siting protocols. For <a href="/en/industries/pharma-biotech" class="text-primary font-medium hover:underline">pharma and biotech lab containers</a> we document cleanroom integrity during transport and SAT on site. <a href="/en/industries/energy-transition-h2-battery" class="text-primary font-medium hover:underline">H2 and battery test laboratories</a> need ATEX-conformant transport preparation to EN 60079 and a separate ignition-source check before commissioning.
                </p>
                <p>
                  Commissioning covers ventilation testing to DIN 1946-7, differential-pressure measurement for BSL-3 (typically −25/−50 Pa), electrical testing to VDE and utilities-connection pressure test. All tests are recorded and provided as part of the handover documentation for ISO 17025 or GMP audits.
                </p>
              </div>
            </div>
          </div>

          <div class="lg:col-span-1">
            <div class="sticky top-24 space-y-6">
              <div class="bg-primary text-slate-900 p-8 rounded-2xl">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-10 h-10 mb-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 14c.2-1 .7-1.7 1.5-2.5 1-.9 1.5-2.2 1.5-3.5A6 6 0 0 0 6 8c0 1 .2 2.2 1.5 3.5.7.7 1.3 1.5 1.5 2.5"/><path d="M9 18h6"/><path d="M10 22h4"/></svg>
                <h3 class="text-xl font-bold mb-3">Logistics from a single source</h3>
                <p class="text-slate-700 mb-6 text-sm">We take over complete transport and installation. Everything from a single source for a smooth process.</p>
                <a href="/en/contact" class="block w-full bg-white text-primary font-bold py-3 rounded-lg text-center hover:bg-slate-100 transition-colors">Enquire about logistics</a>
              </div>
              <div class="bg-slate-50 p-8 rounded-2xl border border-gray-100">
                <h3 class="text-lg font-bold mb-6 text-slate-900">Our strengths</h3>
                <ul class="space-y-4">
                  <li class="flex items-center gap-3 text-gray-700"><svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-primary shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><path d="m9 11 3 3L22 4"/></svg><span>Worldwide delivery</span></li>
                  <li class="flex items-center gap-3 text-gray-700"><svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-primary shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><path d="m9 11 3 3L22 4"/></svg><span>Turnkey handover</span></li>
                  <li class="flex items-center gap-3 text-gray-700"><svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-primary shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><path d="m9 11 3 3L22 4"/></svg><span>Experienced installation teams</span></li>
                  <li class="flex items-center gap-3 text-gray-700"><svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-primary shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><path d="m9 11 3 3L22 4"/></svg><span>All permits included</span></li>
                  <li class="flex items-center gap-3 text-gray-700"><svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-primary shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><path d="m9 11 3 3L22 4"/></svg><span>On-time delivery</span></li>
