const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "What does a lab container in Munich cost?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "The investment depends on biosafety level, cleanroom class, foundation type and site location. An analytics container in the Martinsried biotech cluster sits in a different order of magnitude from a BSL-3 container for a research centre in Neuherberg or a vibration-isolated beam-diagnostics container for large-scale research in Garching. We calculate project by project — including pile foundations on the Munich gravel plain, föhn-stable HVAC control and VC-D vibration isolation for large-scale research. Send us your site data and we will respond within 24 hours with an indicative range."
      }
    },
    {
      "@type": "Question",
      "name": "Who is responsible for permitting a lab container in Munich?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Inside the city boundary the Munich Local Building Commission (Lokalbaukommission München, LBK) is the central building-control authority — uniform for all 25 city districts, unlike Berlin. Outside (Garching, Martinsried, Planegg, Unterschleißheim, Ismaning, Penzberg, Ottobrunn) the relevant rural district offices (Landratsämter) and municipalities are competent. The Bavarian Building Code (Bayerische Bauordnung, BayBO) always applies. We submit review-ready building documents either to the LBK or to the competent Landratsamt — including the structural proof for the Munich gravel plain and the föhn load case in the HVAC concept."
      }
    },
    {
      "@type": "Question",
      "name": "How long does delivery of a lab container from Albstadt to Munich take?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "The distance is around 280 km — by heavy-goods transport directly via the A8 to Munich, then the A99 Munich orbital to Garching (A9 north), Martinsried (A96), Großhadern (A95), Penzberg (A95) or Ottobrunn (A8 south). Pure driving time is about 3.5 hours; with the required permits and escort vehicles it is typically one transport day. From order to operational handover in Munich takes 8 to 14 weeks — one of the fastest deliveries in the DACH region, because our Albstadt works is geographically much closer to Munich than to Berlin or Hamburg."
      }
    },
    {
      "@type": "Question",
      "name": "How does a lab container cope with Munich’s föhn conditions?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Föhn at the Alpine fringe brings sudden pressure drops of 10 to 20 hPa and temperature jumps of up to +15 °C within a few hours. Standard HVAC control briefly loses the pressure cascade — a classification risk for GMP cleanrooms and BSL-2/-3 containers. For Munich sites we configure föhn load cases in the HVAC design: extended control range, pressure-cascade stabilisation via frequency inverters, and a buffer alarm on sudden outdoor-pressure changes. Cleanroom class and the BSL pressure cascade therefore remain stable even during a föhn passage."
      }
    },
    {
      "@type": "Question",
      "name": "Will a standard container withstand the Munich gravel plain and the water table?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "The Munich gravel plain consists of Würm-period gravel and shingle of soil class 4 to 5 to DIN 18196 — highly bearing, but drilling-intensive. The water table sits 3 to 15 m below ground depending on the district, and tends to be higher near the Isar and in Garching. Standard foundations remain largely settlement-stable here, but a proper raft foundation with uplift protection is still mandatory — otherwise groundwater lifts one side during snowmelt. We calculate a raft or pile foundation to DIN 4017/4020 for your specific site."
      }
    },
    {
      "@type": "Question",
      "name": "Can Planexus install in Garching, Großhadern or the Martinsried biotech cluster?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes, that is technically possible. Siting on a research campus in Garching — including the research reactor and neutron source — would require coordination with the relevant building administration, and where applicable the Bavarian State Ministry of Science and the radiation-protection authority. For vibration-sensitive installations we can supply VC-D isolation to VDI 2038. For siting at university hospitals in Großhadern or on the Isar, the Bavarian State Building Office Munich is competent. In the Martinsried-Planegg biotech cluster with more than 50 biotech companies, siting would be coordinated with the municipality of Planegg and Bavarian building control."
      }
    },
    {
      "@type": "Question",
      "name": "What requirements apply to BSL-3 containers in Bavaria?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "BSL-3 in Bavaria requires a permit under the German Biological Agents Ordinance (BioStoffV) — federal law — plus a notification to LGL Bayern, the Bavarian State Office for Health and Food Safety, Biological Safety unit. For genetic-engineering facilities S1/S2/S3 an additional notification to LGL under the German Genetic Engineering Act (GenTG) is required. Technically the ordinance requires a negative-pressure cascade of at least −50 Pa, HEPA H14 on the extract-air path, autoclaved airlocks and redundant ventilation — on Munich sites with föhn-stable design in addition. We supply the risk assessment, safety concept and complete application documents for LGL and the Local Building Commission. Containers are tested to TRBA 100 and handed over with IQ/OQ/PQ."
      }
    }
  ]
};
