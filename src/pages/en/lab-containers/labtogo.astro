---
import Layout from '../../../layouts/Layout.astro';
import Picture from '../../../components/Picture.astro';
---

<Layout
  title="LABtoGO – mobile lab container with 2,750 mm room height"
  description="LABtoGO: the turnkey plug-and-play lab container with 2,750 mm room height and fully glazed front. 3D model, interior walkthrough by video and datasheet for download. Discover it now."
  canonical="/en/lab-containers/labtogo"
  ogImage="/images/labtogo-logo.png"
>

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://planexus.de/en" },
      { "@type": "ListItem", "position": 2, "name": "Lab containers", "item": "https://planexus.de/en/lab-containers" },
      { "@type": "ListItem", "position": 3, "name": "LABtoGO", "item": "https://planexus.de/en/lab-containers/labtogo" }
    ]
  })} />
  <section class="relative w-full bg-[#13161c] min-h-[90vh] md:min-h-screen flex items-center overflow-hidden">
    <div class="absolute inset-0 z-0">
      <div id="hero-media-img" class="absolute inset-0 flex items-center justify-center">
        <Picture src="/images/labtogo-industrie.png" alt="LABtoGO from Planexus in industrial use – mobile lab container on a petrochemical site at dusk, fully glazed front, RAL 7016 anthracite" class="w-full h-full object-cover" loading="eager" fetchpriority="high" width={1536} height={1024} />
      </div>
      <div id="hero-media-vid" class="absolute inset-0 hidden">
        <video id="hero-video" class="w-full h-full object-cover" muted playsinline preload="auto" loop style="opacity:0;">
          <source src="/videos/laborcontainer-innenansicht.mp4" type="video/mp4" />
        </video>
        <div id="hero-vid-overlay" class="absolute inset-0 bg-black/40"></div>
      </div>
    </div>

    <div class="absolute inset-0 bg-gradient-to-t from-[#13161c] via-[#13161c]/50 to-[#13161c]/80 z-[1]"></div>

    <div class="relative z-10 container mx-auto px-4 max-w-6xl pt-28 pb-20">
      <div class="flex flex-col items-center text-center">
        <Picture src="/images/labtogo-logo.png" alt="LABtoGO logo — the LABtoGO from Planexus" class="h-16 md:h-24 w-auto mb-6 drop-shadow-[0_2px_20px_rgba(0,0,0,0.8)]" loading="eager" width={2362} height={409} />
        <p class="text-sm md:text-base text-white/90 tracking-[3px] uppercase mb-8 font-semibold drop-shadow-[0_2px_8px_rgba(0,0,0,0.9)]">The LABtoGO · 100% plug and play</p>

        <div class="flex flex-col sm:flex-row gap-4 mt-4">
          <a href="/en/contact" class="inline-flex items-center gap-3 bg-[#bbd700] hover:bg-[#a8c200] text-slate-900 font-bold px-8 py-4 rounded-lg text-sm uppercase tracking-wider transition-colors shadow-lg">
            Enquire now
          </a>
          <button id="cta-video" class="inline-flex items-center gap-3 bg-black/50 hover:bg-black/70 backdrop-blur-md text-white font-semibold px-8 py-4 rounded-lg text-sm uppercase tracking-wider transition-all border border-white/30 hover:border-white/50 cursor-pointer shadow-lg">
            <div class="w-0 h-0 border-t-[6px] border-t-transparent border-b-[6px] border-b-transparent border-l-[10px] border-l-[#bbd700] shrink-0"></div>
            Experience the interior
          </button>
        </div>

        <a
          href="/downloads/labtogo-laborcontainer-broschuere.pdf"
          download="LABtoGO-Broschuere-Planexus.pdf"
          class="group inline-flex items-center gap-4 mt-8 bg-gradient-to-r from-[#bbd700]/15 to-[#bbd700]/5 hover:from-[#bbd700]/25 hover:to-[#bbd700]/10 backdrop-blur-md border border-[#bbd700]/40 hover:border-[#bbd700] rounded-xl pl-4 pr-6 py-3 transition-all shadow-lg"
          data-testid="link-download-broschuere"
        >
          <div class="flex items-center justify-center w-11 h-11 rounded-lg bg-[#bbd700] text-slate-900 shrink-0 shadow-md group-hover:scale-105 transition-transform">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
              <polyline points="14 2 14 8 20 8"/>
              <line x1="12" y1="18" x2="12" y2="12"/>
              <polyline points="9 15 12 18 15 15"/>
            </svg>
          </div>
          <div class="text-left">
            <div class="text-[10px] tracking-[2px] uppercase text-[#bbd700] font-bold leading-tight">PDF brochure · 8.3 MB</div>
            <div class="text-sm md:text-base font-semibold text-white leading-tight mt-0.5">LABtoGO complete · datasheet for download</div>
          </div>
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-white/50 group-hover:text-[#bbd700] group-hover:translate-x-1 transition-all shrink-0 hidden sm:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
        </a>
      </div>

      <div id="specs-bar" class="hidden md:flex items-center justify-center gap-6 mt-16 flex-wrap bg-black/50 backdrop-blur-md rounded-full px-8 py-3 mx-auto w-fit border border-white/10">
        <div class="flex items-center gap-2 text-[11px] tracking-[2px] uppercase text-white/70">
          <div class="w-1.5 h-1.5 rounded-full bg-[#bbd700] shrink-0"></div>
          <span>External length <strong class="text-white font-semibold">9.500 mm</strong></span>
        </div>
        <div class="flex items-center gap-2 text-[11px] tracking-[2px] uppercase text-white/70">
          <div class="w-1.5 h-1.5 rounded-full bg-[#bbd700] shrink-0"></div>
          <span>External width <strong class="text-white font-semibold">3.000 mm</strong></span>
        </div>
        <div class="flex items-center gap-2 text-[11px] tracking-[2px] uppercase text-white/70">
          <div class="w-1.5 h-1.5 rounded-full bg-[#bbd700] shrink-0"></div>
          <span>External height <strong class="text-white font-semibold">3.400 mm</strong></span>
        </div>
        <div class="flex items-center gap-2 text-[11px] tracking-[2px] uppercase text-white/70">
          <div class="w-1.5 h-1.5 rounded-full bg-[#bbd700] shrink-0"></div>
          <span>Room height <strong class="text-white font-semibold">2.750 mm</strong></span>
        </div>
        <div class="flex items-center gap-2 text-[11px] tracking-[2px] uppercase text-white/70">
          <div class="w-1.5 h-1.5 rounded-full bg-[#bbd700] shrink-0"></div>
          <span>Paint finish <strong class="text-white font-semibold">RAL 7016</strong></span>
        </div>
      </div>

      <a href="https://www.eubusinessnews.com/winners/planexus-gmbh/" target="_blank" rel="noopener noreferrer" class="hidden md:flex items-center justify-center gap-4 mt-5 bg-black/50 backdrop-blur-md rounded-full px-8 py-3 mx-auto w-fit border border-[#bbd700]/25 hover:border-[#bbd700]/50 transition-all group">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-[#bbd700] shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9H4.5a2.5 2.5 0 0 1 0-5H6"/><path d="M18 9h1.5a2.5 2.5 0 0 0 0-5H18"/><path d="M4 22h16"/><path d="M10 14.66V17c0 .55-.47.98-.97 1.21C7.85 18.75 7 20.24 7 22"/><path d="M14 14.66V17c0 .55.47.98.97 1.21C16.15 18.75 17 20.24 17 22"/><path d="M18 2H6v7a6 6 0 0 0 12 0V2Z"/></svg>
        <span class="text-[11px] tracking-[2px] uppercase text-[#bbd700] font-bold">Award Winner 2026</span>
        <span class="text-white/30">|</span>
        <span class="text-[11px] tracking-[2px] uppercase text-white/70">Awarded as <strong class="text-white font-semibold">Leading provider of innovative laboratory spaces</strong></span>
        <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 text-white/40 group-hover:text-[#bbd700] shrink-0 transition-colors" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
      </a>

      <a href="https://www.eubusinessnews.com/winners/planexus-gmbh/" target="_blank" rel="noopener noreferrer" class="flex md:hidden items-center justify-center gap-3 mt-5 bg-black/50 backdrop-blur-md rounded-xl px-5 py-3 mx-auto w-fit border border-[#bbd700]/25">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-[#bbd700] shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9H4.5a2.5 2.5 0 0 1 0-5H6"/><path d="M18 9h1.5a2.5 2.5 0 0 0 0-5H18"/><path d="M4 22h16"/><path d="M10 14.66V17c0 .55-.47.98-.97 1.21C7.85 18.75 7 20.24 7 22"/><path d="M14 14.66V17c0 .55.47.98.97 1.21C16.15 18.75 17 20.24 17 22"/><path d="M18 2H6v7a6 6 0 0 0 12 0V2Z"/></svg>
        <div class="text-center">
          <p class="text-[10px] tracking-[2px] uppercase text-[#bbd700] font-bold">Award Winner 2026</p>
          <p class="text-[10px] tracking-[1px] uppercase text-white/60 mt-0.5">Leading provider of innovative laboratory spaces</p>
        </div>
      </a>
    </div>

    <div id="video-player" class="fixed inset-0 z-[50] bg-black/95 backdrop-blur-sm flex flex-col items-center justify-center transition-opacity duration-500 pointer-events-none" style="opacity:0;">
      <div id="vid-wrap" class="w-[min(90vw,1080px)] bg-black border border-[rgba(187,215,0,0.35)] rounded-lg overflow-hidden" style="aspect-ratio:16/9;cursor:grab;">
        <div class="relative w-full h-full">
          <video id="lab-video" class="w-full h-full object-cover" muted playsinline preload="auto" style="opacity:0;">
            <source src="/videos/laborcontainer-innenansicht.mp4" type="video/mp4" />
          </video>
          <div id="vid-poster" class="absolute inset-0 flex flex-col items-center justify-center gap-4 bg-gradient-to-br from-[#0a160b] via-[#162814] to-[#0a160b]">
            <button id="play-big" class="w-16 h-16 rounded-full border-2 border-[rgba(187,215,0,0.38)] flex items-center justify-center cursor-pointer hover:border-[#bbd700] transition-all" style="animation:pulse-glow 2s ease-in-out infinite;">
              <div class="w-0 h-0 border-t-[12px] border-t-transparent border-b-[12px] border-b-transparent border-l-[20px] border-l-[#bbd700] ml-1"></div>
            </button>
            <p class="text-white font-bold text-lg tracking-[3px] uppercase">LABtoGO interior view</p>
            <p class="text-[#7a8fa8] text-xs tracking-[2px] uppercase">Click to start</p>
          </div>
          <div id="vid-hint" class="absolute bottom-4 left-0 right-0 text-center hidden">
            <div class="inline-flex items-center gap-3 bg-black/70 backdrop-blur-sm border border-[rgba(187,215,0,0.2)] rounded-full px-5 py-2">
              <svg class="w-4 h-4 text-[#bbd700] shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 15l-2 5L9 9l11 4-5 2zm0 0l5 5M7.188 2.239l.777 2.897M5.136 7.965l-2.898-.777M13.95 4.05l-2.122 2.122m-5.657 5.656l-2.12 2.122"></path></svg>
              <span class="text-[10px] tracking-[2px] uppercase text-[#bbd700]">Drag mouse: control the walkthrough</span>
              <span class="text-[10px] text-white/30">|</span>
              <span class="text-[10px] tracking-[2px] uppercase text-[#7a8fa8]">Slider: choose position</span>
            </div>
          </div>
        </div>
      </div>

      <div class="w-[min(90vw,1080px)] mt-3">
        <div id="scrub-bar" class="cursor-pointer">
          <div class="relative h-1 bg-[rgba(122,143,168,0.2)] rounded-full overflow-hidden">
            <div id="scrub-progress" class="absolute inset-y-0 left-0 bg-[#bbd700] rounded-full" style="width:0%;"></div>
          </div>
        </div>
        <div class="flex items-center justify-between mt-2">
          <div class="flex items-center gap-3">
            <button id="play-pause" class="text-[10px] tracking-[2px] uppercase text-[#7a8fa8] hover:text-white transition-colors cursor-pointer">&#9654; Play</button>
            <span id="time-display" class="text-[10px] tracking-[2px] text-[rgba(122,143,168,0.45)]">0:00 / 0:00</span>
          </div>
          <div class="text-[11px] tracking-[3px] uppercase text-[#7a8fa8] hidden md:block">
            <strong class="text-white">Planexus</strong> — LABtoGO lab container
          </div>
        </div>
      </div>

      <div class="w-[min(90vw,1080px)] flex items-center justify-end mt-4">
        <button id="close-btn" class="text-[10px] tracking-[3px] uppercase text-[#7a8fa8] bg-transparent border border-[rgba(122,143,168,0.2)] px-5 py-2 cursor-pointer hover:text-white hover:border-[#bbd700] transition-all flex gap-2 items-center rounded">
          &#10005; Close
        </button>
      </div>
    </div>

    <style>
      @keyframes pulse-glow { 0%, 100% { box-shadow: 0 0 0 0 rgba(187,215,0,0.28); } 50% { box-shadow: 0 0 0 12px rgba(187,215,0,0); } }
    </style>
  </section>

  <section class="bg-white py-20 md:py-28">
    <div class="container mx-auto px-4 max-w-5xl">
      <div class="text-center mb-16">
        <p class="text-[#bbd700] font-semibold text-sm tracking-widest uppercase mb-4">The LABtoGO</p>
        <h1 class="text-3xl md:text-5xl font-bold text-slate-900 mb-6 leading-tight">
          A conventional lab container fits<br class="hidden md:block" /> <span class="text-[#bbd700]">entirely inside the LABtoGO.</span>
        </h1>
        <p class="text-lg text-slate-600 max-w-3xl mx-auto leading-relaxed">
          Conventional lab containers are based on standard container dimensions — small, cramped, full of compromises. 
          The LABtoGO from <a href="/en/about" class="text-[#7a9900] hover:underline">Planexus</a> is so large that a conventional lab container would fit entirely inside it. 
          The result: genuine laboratory depth, genuine room height, genuine working — with professional <a href="/en/services/equipment" class="text-[#7a9900] hover:underline">laboratory equipment</a> of the highest standard.
        </p>
      </div>

      <div class="relative bg-slate-50 rounded-2xl p-8 md:p-12 mb-16">
        <h2 class="text-xl font-bold text-slate-900 mb-8 text-center">Size comparison: standard vs LABtoGO</h2>
        <div class="grid md:grid-cols-2 gap-8 items-end">
          <div class="bg-white rounded-xl p-8 border border-slate-200 relative">
            <div class="absolute top-4 right-4 bg-slate-200 text-slate-600 text-xs font-bold px-3 py-1 rounded-full uppercase tracking-wider">Standard</div>
            <div class="flex items-end justify-center mb-6" style="height:160px;">
              <svg viewBox="0 0 200 100" class="w-full max-w-[280px]" style="height:auto;max-height:143px;" xmlns="http://www.w3.org/2000/svg">
                <rect x="2" y="10" width="126" height="88" rx="1" fill="#e2e8f0" stroke="#94a3b8" stroke-width="2"/>
                <rect x="6" y="14" width="8" height="80" rx="0.5" fill="#cbd5e1"/>
                <rect x="116" y="14" width="8" height="80" rx="0.5" fill="#cbd5e1"/>
                <line x1="18" y1="14" x2="18" y2="94" stroke="#cbd5e1" stroke-width="0.5"/>
                <line x1="30" y1="14" x2="30" y2="94" stroke="#cbd5e1" stroke-width="0.5"/>
                <line x1="42" y1="14" x2="42" y2="94" stroke="#cbd5e1" stroke-width="0.5"/>
                <line x1="54" y1="14" x2="54" y2="94" stroke="#cbd5e1" stroke-width="0.5"/>
                <line x1="66" y1="14" x2="66" y2="94" stroke="#cbd5e1" stroke-width="0.5"/>
                <line x1="78" y1="14" x2="78" y2="94" stroke="#cbd5e1" stroke-width="0.5"/>
                <line x1="90" y1="14" x2="90" y2="94" stroke="#cbd5e1" stroke-width="0.5"/>
                <line x1="102" y1="14" x2="102" y2="94" stroke="#cbd5e1" stroke-width="0.5"/>
                <rect x="2" y="6" width="126" height="6" rx="1" fill="#94a3b8"/>
                <rect x="2" y="96" width="126" height="4" rx="1" fill="#94a3b8"/>
                <line x1="0" y1="100" x2="130" y2="100" stroke="#94a3b8" stroke-width="0.5"/>
                <text x="65" y="58" text-anchor="middle" fill="#64748b" font-size="7" font-family="sans-serif">6.050 × 3.050</text>
              </svg>
            </div>
            <h3 class="font-bold text-slate-900 text-lg mb-3">Conventional lab container</h3>
            <div class="space-y-2 text-sm text-slate-600">
              <div class="flex justify-between border-b border-slate-100 pb-1">
                <span>External length</span><span class="font-semibold text-slate-800">6.050 mm</span>
              </div>
              <div class="flex justify-between border-b border-slate-100 pb-1">
                <span>External width</span><span class="font-semibold text-slate-800">3.000 mm</span>
              </div>
              <div class="flex justify-between border-b border-slate-100 pb-1">
                <span>External height</span><span class="font-semibold text-slate-800">3.050 mm</span>
              </div>
              <div class="flex justify-between">
                <span>Internal room height</span><span class="font-semibold text-slate-800">~ 2.400 mm</span>
              </div>
            </div>
          </div>

          <div class="bg-white rounded-xl p-8 border-2 border-[#bbd700] relative shadow-lg">
            <div class="absolute top-4 right-4 bg-[#bbd700] text-slate-900 text-xs font-bold px-3 py-1 rounded-full uppercase tracking-wider">LABtoGO</div>
            <div class="flex items-end justify-center mb-6" style="height:160px;">
              <svg viewBox="0 0 200 100" class="w-full max-w-[340px]" style="height:auto;max-height:160px;" xmlns="http://www.w3.org/2000/svg">
                <rect x="2" y="2" width="196" height="96" rx="1" fill="#f0f5d4" stroke="#bbd700" stroke-width="2"/>
                <rect x="5" y="5" width="8" height="89" rx="0.5" fill="#d4e157"/>
                <rect x="185" y="5" width="8" height="89" rx="0.5" fill="#d4e157"/>
                <line x1="17" y1="5" x2="17" y2="94" stroke="#d4e157" stroke-width="0.5"/>
                <line x1="29" y1="5" x2="29" y2="94" stroke="#d4e157" stroke-width="0.5"/>
                <line x1="41" y1="5" x2="41" y2="94" stroke="#d4e157" stroke-width="0.5"/>
                <line x1="53" y1="5" x2="53" y2="94" stroke="#d4e157" stroke-width="0.5"/>
                <line x1="65" y1="5" x2="65" y2="94" stroke="#d4e157" stroke-width="0.5"/>
                <line x1="77" y1="5" x2="77" y2="94" stroke="#d4e157" stroke-width="0.5"/>
                <line x1="89" y1="5" x2="89" y2="94" stroke="#d4e157" stroke-width="0.5"/>
                <line x1="101" y1="5" x2="101" y2="94" stroke="#d4e157" stroke-width="0.5"/>
                <line x1="113" y1="5" x2="113" y2="94" stroke="#d4e157" stroke-width="0.5"/>
                <line x1="125" y1="5" x2="125" y2="94" stroke="#d4e157" stroke-width="0.5"/>
                <line x1="137" y1="5" x2="137" y2="94" stroke="#d4e157" stroke-width="0.5"/>
                <line x1="149" y1="5" x2="149" y2="94" stroke="#d4e157" stroke-width="0.5"/>
                <line x1="161" y1="5" x2="161" y2="94" stroke="#d4e157" stroke-width="0.5"/>
                <line x1="173" y1="5" x2="173" y2="94" stroke="#d4e157" stroke-width="0.5"/>
                <rect x="2" y="0" width="196" height="4" rx="1" fill="#9aad00"/>
                <rect x="2" y="96" width="196" height="4" rx="1" fill="#9aad00"/>
                <rect x="130" y="28" width="26" height="66" rx="0.5" fill="rgba(187,215,0,0.15)" stroke="#bbd700" stroke-width="1" stroke-dasharray="2,1"/>
                <rect x="158" y="15" width="24" height="50" rx="0.5" fill="rgba(187,215,0,0.1)" stroke="#bbd700" stroke-width="0.5"/>
                <rect class="standard-ghost" x="20" y="12" width="124" height="82" rx="1" fill="none" stroke="#94a3b8" stroke-width="1.5" stroke-dasharray="4,3" opacity="0.6"/>
                <text x="82" y="56" text-anchor="middle" fill="#94a3b8" font-size="5.5" font-family="sans-serif" opacity="0.7">Standard</text>
                <text x="82" y="63" text-anchor="middle" fill="#94a3b8" font-size="4.5" font-family="sans-serif" opacity="0.6">fits in here</text>
                <text x="100" y="46" text-anchor="middle" fill="#7a9900" font-size="7" font-family="sans-serif" font-weight="bold">9.500 × 3.400</text>
              </svg>
            </div>
            <h3 class="font-bold text-slate-900 text-lg mb-3">LABtoGO – mobile lab containers</h3>
            <div class="space-y-2 text-sm text-slate-600">
              <div class="flex justify-between border-b border-slate-100 pb-1">
                <span>External length</span><span class="font-bold text-[#7a9900]">9.500 mm</span>
              </div>
              <div class="flex justify-between border-b border-slate-100 pb-1">
                <span>External width</span><span class="font-bold text-[#7a9900]">3.000 mm</span>
              </div>
              <div class="flex justify-between border-b border-slate-100 pb-1">
                <span>External height</span><span class="font-bold text-[#7a9900]">3.400 mm</span>
              </div>
              <div class="flex justify-between border-b border-slate-100 pb-1">
                <span>Laboratory depth</span><span class="font-bold text-[#7a9900]">&gt; 6.200 mm</span>
              </div>
              <div class="flex justify-between">
                <span>Internal room height</span><span class="font-bold text-[#7a9900]">2.750 mm</span>
              </div>
            </div>
          </div>
        </div>
        <p class="text-center text-sm text-slate-500 mt-6 italic">The dashed outline shows: a conventional lab container fits entirely inside the LABtoGO.</p>
      </div>
    </div>
  </section>

  <section class="bg-slate-900 py-20 md:py-28 text-white">
