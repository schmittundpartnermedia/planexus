  <script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const ctaVideo = document.getElementById('cta-video');
    const videoPlayer = document.getElementById('video-player');
    const video = document.getElementById('lab-video');
    const closeBtn = document.getElementById('close-btn');
    const playBig = document.getElementById('play-big');
    const playPause = document.getElementById('play-pause');
    const scrubBar = document.getElementById('scrub-bar');
    const scrubProgress = document.getElementById('scrub-progress');
    const timeDisplay = document.getElementById('time-display');
    const vidPoster = document.getElementById('vid-poster');
    if (!ctaVideo || !videoPlayer) return;

    let isPlaying = false;
    let videoDrag = false;
    let videoReady = false;

    ctaVideo.addEventListener('click', () => {
      videoPlayer.style.opacity = '1';
      videoPlayer.style.pointerEvents = 'all';
      document.body.style.overflow = 'hidden';
    });

    closeBtn.addEventListener('click', () => {
      videoPlayer.style.opacity = '0';
      videoPlayer.style.pointerEvents = 'none';
      document.body.style.overflow = '';
      video.pause();
      video.currentTime = 0;
      video.style.opacity = '0';
      vidPoster.style.display = '';
      if (vidHint) vidHint.classList.add('hidden');
      isPlaying = false;
      videoReady = false;
      playPause.innerHTML = '&#9654; Play';
    });

    const vidWrap = document.getElementById('vid-wrap');
    const vidHint = document.getElementById('vid-hint');
    let vidDrag = false;
    let vidPrevX = 0;
    let wasPlaying = false;

    function startVideo() {
      video.style.opacity = '1';
      vidPoster.style.display = 'none';
      videoReady = true;
      video.currentTime = 0;
      isPlaying = false;
      playPause.innerHTML = '&#9654; Play';
      vidHint.classList.remove('hidden');
    }

    playBig.addEventListener('click', startVideo);
    playPause.addEventListener('click', () => {
      if (!videoReady) { startVideo(); return; }
      if (isPlaying) { video.pause(); isPlaying = false; playPause.innerHTML = '&#9654; Play'; }
      else { video.play(); isPlaying = true; playPause.innerHTML = '&#9208; Pause'; vidHint.classList.add('hidden'); }
    });

    vidWrap.addEventListener('mousedown', e => {
      if (!videoReady) return;
      vidDrag = true;
      vidPrevX = e.clientX;
      wasPlaying = isPlaying;
      if (isPlaying) { video.pause(); isPlaying = false; playPause.innerHTML = '&#9654; Play'; }
      vidWrap.style.cursor = 'grabbing';
      e.preventDefault();
    });
    window.addEventListener('mousemove', e => {
      if (!vidDrag) return;
      const dx = e.clientX - vidPrevX;
      vidPrevX = e.clientX;
      if (video.duration) video.currentTime = Math.max(0, Math.min(video.duration, video.currentTime + dx * 0.05));
    });
    window.addEventListener('mouseup', () => {
      if (!vidDrag) return;
      vidDrag = false;
      vidWrap.style.cursor = 'grab';
    });

    vidWrap.addEventListener('touchstart', e => {
      if (!videoReady) return;
      vidDrag = true;
      vidPrevX = e.touches[0].clientX;
      wasPlaying = isPlaying;
      if (isPlaying) { video.pause(); isPlaying = false; playPause.innerHTML = '&#9654; Play'; }
    }, { passive: true });
    window.addEventListener('touchmove', e => {
      if (!vidDrag) return;
      const dx = e.touches[0].clientX - vidPrevX;
      vidPrevX = e.touches[0].clientX;
      if (video.duration) video.currentTime = Math.max(0, Math.min(video.duration, video.currentTime + dx * 0.05));
    }, { passive: true });
    window.addEventListener('touchend', () => { vidDrag = false; }, { passive: true });

    function formatTime(s) {
      const m = Math.floor(s / 60);
      const sec = Math.floor(s % 60);
      return m + ':' + (sec < 10 ? '0' : '') + sec;
    }

    function updateScrub() {
      if (video.duration) {
        scrubProgress.style.width = (video.currentTime / video.duration * 100) + '%';
        timeDisplay.textContent = formatTime(video.currentTime) + ' / ' + formatTime(video.duration);
      }
      requestAnimationFrame(updateScrub);
    }
    updateScrub();

    function scrubTo(e) {
      const rect = scrubBar.getBoundingClientRect();
      const pct = Math.max(0, Math.min(1, (e.clientX - rect.left) / rect.width));
      if (video.duration) video.currentTime = pct * video.duration;
    }

    scrubBar.addEventListener('mousedown', e => { videoDrag = true; scrubTo(e); if (isPlaying) video.pause(); });
    window.addEventListener('mousemove', e => { if (videoDrag) scrubTo(e); });
    window.addEventListener('mouseup', () => { if (videoDrag && isPlaying) video.play(); videoDrag = false; });

    scrubBar.addEventListener('touchstart', e => { videoDrag = true; scrubTo(e.touches[0]); if (isPlaying) video.pause(); }, { passive: true });
    window.addEventListener('touchmove', e => { if (videoDrag) scrubTo(e.touches[0]); }, { passive: true });
    window.addEventListener('touchend', () => { if (videoDrag && isPlaying) video.play(); videoDrag = false; }, { passive: true });

    document.addEventListener('keydown', e => {
      if (e.key === 'Escape' && videoPlayer.style.opacity === '1') closeBtn.click();
    });
  });
  </script>

