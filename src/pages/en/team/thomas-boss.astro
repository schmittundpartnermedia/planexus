---
import Layout from '../../../layouts/Layout.astro';

const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  "name": "Thomas Boss",
  "url": "https://planexus.de/en/team/thomas-boss",
  "image": "https://planexus.de/en/team/thomas-boss.jpg",
  "jobTitle": "Shareholder & Technical Director",
  "inLanguage": "en",
  "worksFor": {
    "@type": "Organization",
    "name": "Planexus GmbH",
    "url": "https://planexus.de",
    "parentOrganization": { "@type": "Organization", "name": "Wesemann Holding GmbH" }
  },
  "knowsAbout": [
    "Laboratory containers", "Modular laboratory construction", "Technical project management",
    "Plant engineering", "Laboratory ventilation", "Laboratory equipment",
    "Project control", "Fire protection", "IT and software development",
    "Photovoltaics monitoring"
  ],
  "knowsLanguage": ["de", "en"],
  "sameAs": [
    "https://www.linkedin.com/in/thomas-boss-690091352",
    "https://www.facebook.com/thomas.boss.9"
  ],
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "Am Steinbach 8",
    "postalCode": "72459",
    "addressLocality": "Albstadt-Laufen",
    "addressRegion": "Baden-Württemberg",
    "addressCountry": "DE"
  }
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://planexus.de/en" },
    { "@type": "ListItem", "position": 2, "name": "Team", "item": "https://planexus.de/en/team" },
    { "@type": "ListItem", "position": 3, "name": "Thomas Boss", "item": "https://planexus.de/en/team/thomas-boss" }
  ]
};
---

<Layout
  title="Thomas Boss – Technical Director, Planexus GmbH"
  description="Thomas Boss, shareholder and Technical Director of Planexus GmbH. Engineering, project control and laboratory construction for BSL, GMP and ATEX containers across DACH."
  canonical="/en/team/thomas-boss"
  ogImage="/team/thomas-boss.jpg"
>
  <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

  <div class="pt-20 min-h-screen bg-white">
    <section class="relative py-20 bg-slate-900 text-white overflow-hidden">
      <div class="absolute inset-0 bg-gradient-to-br from-slate-900 via-slate-900 to-slate-800"></div>
      <div class="container mx-auto px-4 relative z-10">
        <nav class="text-sm text-gray-400 mb-6" aria-label="Breadcrumb">
          <a href="/en" class="hover:text-primary">Home</a>
          <span class="mx-2">/</span>
          <a href="/en/team" class="hover:text-primary">Team</a>
          <span class="mx-2">/</span>
          <span class="text-gray-200">Thomas Boss</span>
        </nav>
        <div class="grid md:grid-cols-3 gap-10 items-start max-w-5xl">
          <div class="md:col-span-1">
            <div class="aspect-square rounded-2xl overflow-hidden border-2 border-primary/40 bg-gradient-to-br from-primary/30 to-primary/5">
              <img
                src="/team/thomas-boss.jpg"
                alt="Thomas Boss, shareholder and Technical Director of Planexus GmbH"
                width="400"
                height="400"
                loading="eager"
                class="w-full h-full object-cover object-top"
              />
            </div>
          </div>
          <div class="md:col-span-2">
            <div class="text-xs uppercase tracking-wider text-[#bbd700] font-bold mb-2">Engineering &amp; project management</div>
            <h1 class="text-4xl md:text-5xl font-heading font-bold mb-4">Thomas Boss</h1>
            <p class="text-xl text-gray-300 mb-6">Shareholder &amp; Technical Director of Planexus GmbH, Albstadt</p>
            <div class="flex flex-wrap gap-2 mb-6">
              <span class="px-3 py-1 rounded-full bg-primary/20 text-[#bbd700] text-sm">Technical project management</span>
              <span class="px-3 py-1 rounded-full bg-primary/20 text-[#bbd700] text-sm">Laboratory construction &amp; containers</span>
              <span class="px-3 py-1 rounded-full bg-primary/20 text-[#bbd700] text-sm">Plant engineering &amp; HVAC</span>
              <span class="px-3 py-1 rounded-full bg-primary/20 text-[#bbd700] text-sm">IT &amp; software development</span>
              <span class="px-3 py-1 rounded-full bg-primary/20 text-[#bbd700] text-sm">Fire protection &amp; safety</span>
            </div>
            <p class="text-gray-300 leading-relaxed">
              The engineering lead of Planexus GmbH. Focus: design, plant engineering and
              turnkey delivery of laboratory containers for pharma, biotech, research,
              hospitals and crisis teams in Germany, Switzerland and Austria.
            </p>
          </div>
        </div>
      </div>
    </section>

    <section class="py-16 bg-white">
      <div class="container mx-auto px-4">
        <div class="max-w-3xl mx-auto">
          <h2 class="text-3xl font-heading font-bold text-slate-900 mb-6">About</h2>
          <div class="prose prose-lg max-w-none text-gray-700 leading-relaxed space-y-4">
            <p>
              Thomas Boss is a shareholder and Technical Director of <strong>Planexus GmbH</strong>,
              based in Albstadt (Baden-Württemberg). Planexus belongs to the <strong>Wesemann Group</strong>
              and is responsible for modular laboratory containers and turnkey mobile
              laboratory infrastructure for pharma, biotech, research, hospitals and public-health applications.
            </p>
            <p>
              His technical focus is the engineering delivery of demanding
              container projects: <strong>plant engineering, ventilation and media supply</strong>,
              laboratory equipment, and project control from design through to turnkey
              handover. He combines craft and engineering experience, IT expertise and
              long-standing laboratory-construction know-how into a whole-project view of every scheme.
            </p>
          </div>

          <h2 class="text-3xl font-heading font-bold text-slate-900 mb-6 mt-12">Career</h2>
          <div class="prose prose-lg max-w-none text-gray-700 leading-relaxed space-y-4">
            <p>
              Thomas Boss was born in Hechingen in 1971. After school he
              completed an apprenticeship as an <strong>industrial mechanic</strong> and then
              worked in that trade for several years. During that time he acquired a solid
              technical foundation, a strong understanding of industrial processes and
              practical experience with complex technical systems.
            </p>
            <p>
              Later in his career he moved to the professional fire service
              and trained as a <strong>fire officer (Brandmeister)</strong>. That role
              particularly shaped his sense of responsibility, decision-making under pressure and
              his ability to act in a structured, solution-oriented way.
            </p>
            <p>
              After several years with the fire service, Thomas Boss became self-employed in IT.
              Over a period of around <strong>20 years</strong> he advised well-known
              companies on technical and software questions and developed
              complete software solutions independently. Together with a colleague he created,
              among other things, <strong>monitoring software for large-scale PV plants</strong>, enabling
              complex photovoltaic installations to be controlled and analysed efficiently.
            </p>
            <p>
              After two decades of entrepreneurial work he moved into the laboratory sector and
              took on the role of Technical Director at <strong>Mc Labor</strong>.
              There he was responsible for numerous laboratory-construction projects with laboratory containers and led
              demanding schemes from planning through to delivery — a role in which he
              fully combined his experience from engineering, IT, project control and laboratory construction
              for the first time.
            </p>
            <p>
              Together with <strong>Sven Biewald</strong>, Thomas Boss founded
              <strong>Planexus GmbH</strong>, which today belongs to the Wesemann Group. At Planexus
              he designs and builds next-generation laboratory containers — with the aim of developing modern,
              flexible and future-oriented laboratory solutions for a wide range of requirements.
            </p>
          </div>

          <h2 class="text-3xl font-heading font-bold text-slate-900 mb-6 mt-12">Responsibility &amp; role</h2>
          <ul class="space-y-3 text-gray-700">
            <li class="flex gap-3"><span class="text-[#7a9900] font-bold mt-1">→</span><span><strong>Technical project management</strong> — design, construction and turnkey delivery of laboratory containers from idea to handover.</span></li>
            <li class="flex gap-3"><span class="text-[#7a9900] font-bold mt-1">→</span><span><strong>Plant &amp; building services</strong> — ventilation, climate control, media supply and safety-critical systems for BSL, GMP and ATEX configurations.</span></li>
            <li class="flex gap-3"><span class="text-[#7a9900] font-bold mt-1">→</span><span><strong>Quality &amp; safety</strong> — standards-compliant, robust execution with an eye for practical operational safety in day-to-day laboratory use.</span></li>
            <li class="flex gap-3"><span class="text-[#7a9900] font-bold mt-1">→</span><span><strong>Works interface, Albstadt</strong> — coordination of manufacture, suppliers and installation throughout project delivery across DACH.</span></li>
          </ul>

          <div class="mt-12 p-6 rounded-xl bg-slate-900 text-white">
            <h2 class="text-2xl font-heading font-bold mb-3">Enquire directly</h2>
            <p class="text-gray-300 mb-4">
              A specific container project? A technical question on plant engineering, equipment or
              delivery? Enquiries via the contact form go directly to Planexus’s
              technical leadership.
            </p>
            <a
              href="/en/contact"
              class="inline-block px-6 py-3 bg-[#bbd700] text-slate-900 font-bold rounded-lg hover:bg-[#a3bd00] transition-colors"
              data-testid="link-kontakt"
            >Get in touch</a>
          </div>
        </div>
      </div>
    </section>
  </div>
</Layout>
