import CityCrossLinks from '../../components/CityCrossLinks.astro';
import ContactForm from '../../components/ContactForm.tsx';
import Picture from '../../components/Picture.astro';

const hamburgPLZ = [
  "20095","20097","20099","20144","20146","20148","20149","20251","20253","20255",
  "20257","20259","20354","20355","20357","20359","20457","20459","20535","20537",
  "20539","21029","21073","21075","21077","21079","21107","21109","21129","22041",
  "22043","22047","22081","22083","22085","22087","22089","22299","22303","22305",
  "22335","22339","22359","22399","22459","22525","22527","22529","22547","22549",
