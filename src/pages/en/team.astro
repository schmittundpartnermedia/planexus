---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Team – laboratory container specialists" description="The Planexus team: Sven Biewald and Thomas Boss — specialists in laboratory containers and modular construction with more than 10 years of experience." canonical="/en/team" ogImage="/attached_assets/Kopf_green-scaled_1768306688943.jpg">
  <div class="pt-20 min-h-screen bg-white">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://planexus.de/en" },
        { "@type": "ListItem", "position": 2, "name": "Team", "item": "https://planexus.de/en/team" }
      ]
    })} />
    <section class="relative py-24 bg-slate-900 text-white overflow-hidden">
      <div class="absolute inset-0 bg-[url('/images/backgrounds/team-bg.webp')] bg-cover bg-center opacity-10"></div>
      <div class="absolute inset-0 bg-gradient-to-b from-slate-900 via-slate-900/95 to-slate-900"></div>
      <div class="container mx-auto px-4 text-center relative z-10">
        <h1 class="text-4xl md:text-6xl font-heading font-bold mb-6">The Planexus team</h1>
        <p class="text-xl text-gray-300 max-w-2xl mx-auto">
          Experience meets innovation. We are your specialists in laboratory construction.
        </p>
      </div>
    </section>

    <section class="py-20">
      <div class="container mx-auto px-4">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-12 max-w-5xl mx-auto">
          <div class="bg-white border border-gray-100 p-8 rounded-2xl relative overflow-hidden group shadow-lg shadow-gray-100 hover:shadow-xl transition-shadow">
            <div class="absolute top-0 right-0 w-32 h-32 bg-primary/10 rounded-bl-full -mr-8 -mt-8 transition-transform group-hover:scale-150 duration-700"></div>
            <img src="/team/sven-biewald.jpg" alt="Sven Biewald — shareholder and visionary at Planexus GmbH" class="w-24 h-24 rounded-full object-cover object-top mb-6 shadow-md" loading="lazy" width="1459" height="1540" />
            <h3 class="text-3xl font-heading font-bold mb-2 text-slate-900">
              <a href="/en/team/sven-biewald" class="hover:text-[#7a9900] transition-colors" data-testid="link-sven-biewald-profil">Sven Biewald</a>
            </h3>
            <p class="text-primary font-bold mb-6 uppercase tracking-wider text-sm">Shareholder / Visionary</p>
            <p class="text-gray-600 leading-relaxed mb-6">
              The pioneer of the modern <a href="/en/services/modular-construction" class="text-[#7a9900] hover:underline">laboratory container</a>. With more than a decade of experience and a relentless drive for innovation, he advances the vision of <a href="/en/about" class="text-[#7a9900] hover:underline">Planexus</a>.
            </p>
            <a href="/en/team/sven-biewald" class="inline-flex items-center gap-2 text-sm font-bold text-[#7a9900] hover:text-slate-900 mb-6" data-testid="link-sven-biewald-bio">
              View profile &amp; publications
              <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
            </a>
            <div class="flex gap-4">
              <a href="https://www.linkedin.com/in/sven-biewald-893a85a3/" target="_blank" rel="noopener noreferrer" class="p-2 bg-gray-100 rounded-lg hover:bg-primary hover:text-slate-900 transition-colors text-slate-600">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect width="4" height="12" x="2" y="9"/><circle cx="4" cy="4" r="2"/></svg>
              </a>
              <a href="https://www.facebook.com/sven.biewald.90" target="_blank" rel="noopener noreferrer" class="p-2 bg-gray-100 rounded-lg hover:bg-primary hover:text-slate-900 transition-colors text-slate-600">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>
              </a>
            </div>
          </div>

          <div class="bg-white border border-gray-100 p-8 rounded-2xl relative overflow-hidden group shadow-lg shadow-gray-100 hover:shadow-xl transition-shadow">
            <div class="absolute top-0 right-0 w-32 h-32 bg-primary/10 rounded-bl-full -mr-8 -mt-8 transition-transform group-hover:scale-150 duration-700"></div>
            <img src="/team/thomas-boss.jpg" alt="Thomas Boss — shareholder and Technical Director at Planexus GmbH" class="w-24 h-24 rounded-full object-cover object-top mb-6 shadow-md" loading="lazy" width="929" height="1155" />
            <h3 class="text-3xl font-heading font-bold mb-2 text-slate-900">
              <a href="/en/team/thomas-boss" class="hover:text-[#7a9900] transition-colors" data-testid="link-thomas-boss-profil">Thomas Boss</a>
            </h3>
            <p class="text-primary font-bold mb-6 uppercase tracking-wider text-sm">Shareholder / Engineering</p>
            <p class="text-gray-600 leading-relaxed mb-6">
              The engineering mind behind the scenes. His expertise in <a href="/en/services/planning" class="text-[#7a9900] hover:underline">specialist design</a> and <a href="/en/services/equipment" class="text-[#7a9900] hover:underline">laboratory equipment</a> ensures that visionary ideas become functional, robust reality.
            </p>
            <a href="/en/team/thomas-boss" class="inline-flex items-center gap-2 text-sm font-bold text-[#7a9900] hover:text-slate-900 mb-6" data-testid="link-thomas-boss-bio">
              View profile
              <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
            </a>
            <div class="flex gap-4">
              <a href="https://www.linkedin.com/in/thomas-boss-690091352" target="_blank" rel="noopener noreferrer" class="p-2 bg-gray-100 rounded-lg hover:bg-primary hover:text-slate-900 transition-colors text-slate-600">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect width="4" height="12" x="2" y="9"/><circle cx="4" cy="4" r="2"/></svg>
              </a>
              <a href="https://www.facebook.com/thomas.boss.9" target="_blank" rel="noopener noreferrer" class="p-2 bg-gray-100 rounded-lg hover:bg-primary hover:text-slate-900 transition-colors text-slate-600">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="py-20 bg-slate-50 border-t border-gray-100">
      <div class="container mx-auto px-4">
        <h2 class="text-3xl font-heading font-bold text-center mb-16 text-slate-900">What our clients say</h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          <div class="bg-white p-8 rounded-xl border border-gray-100 shadow-sm relative hover:shadow-md transition-shadow">
            <div class="absolute top-6 right-6 text-primary/20">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-10 h-10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 21c3 0 7-1 7-8V5c0-1.25-.756-2.017-2-2H4c-1.25 0-2 .75-2 1.972V11c0 1.25.75 2 2 2 1 0 1 0 1 1v1c0 1-1 2-2 2s-1 .008-1 1.031V20c0 1 0 1 1 1z"/><path d="M15 21c3 0 7-1 7-8V5c0-1.25-.757-2.017-2-2h-4c-1.25 0-2 .75-2 1.972V11c0 1.25.75 2 2 2h.75c0 2.25.25 4-2.75 4v3c0 1 0 1 1 1z"/></svg>
            </div>
            <p class="text-gray-600 mb-6 italic relative z-10 leading-relaxed">"The collaboration on the planning of our new laboratory was outstanding. From the first concept through to final implementation, all of our requirements were taken into account."</p>
            <div class="mt-auto">
              <h4 class="font-bold text-slate-900">Dr Martina Weber</h4>
              <p class="text-sm text-primary font-medium">Laboratory manager</p>
            </div>
          </div>

          <div class="bg-white p-8 rounded-xl border border-gray-100 shadow-sm relative hover:shadow-md transition-shadow">
            <div class="absolute top-6 right-6 text-primary/20">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-10 h-10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 21c3 0 7-1 7-8V5c0-1.25-.756-2.017-2-2H4c-1.25 0-2 .75-2 1.972V11c0 1.25.75 2 2 2 1 0 1 0 1 1v1c0 1-1 2-2 2s-1 .008-1 1.031V20c0 1 0 1 1 1z"/><path d="M15 21c3 0 7-1 7-8V5c0-1.25-.757-2.017-2-2h-4c-1.25 0-2 .75-2 1.972V11c0 1.25.75 2 2 2h.75c0 2.25.25 4-2.75 4v3c0 1 0 1 1 1z"/></svg>
            </div>
            <p class="text-gray-600 mb-6 italic relative z-10 leading-relaxed">"Planexus developed an innovative technical concept for our research centre that is both efficient and future-proof."</p>
            <div class="mt-auto">
              <h4 class="font-bold text-slate-900">Prof. Dr Thomas Keller</h4>
              <p class="text-sm text-primary font-medium">Head of research</p>
            </div>
          </div>

          <div class="bg-white p-8 rounded-xl border border-gray-100 shadow-sm relative hover:shadow-md transition-shadow">
            <div class="absolute top-6 right-6 text-primary/20">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-10 h-10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 21c3 0 7-1 7-8V5c0-1.25-.756-2.017-2-2H4c-1.25 0-2 .75-2 1.972V11c0 1.25.75 2 2 2 1 0 1 0 1 1v1c0 1-1 2-2 2s-1 .008-1 1.031V20c0 1 0 1 1 1z"/><path d="M15 21c3 0 7-1 7-8V5c0-1.25-.757-2.017-2-2h-4c-1.25 0-2 .75-2 1.972V11c0 1.25.75 2 2 2h.75c0 2.25.25 4-2.75 4v3c0 1 0 1 1 1z"/></svg>
            </div>
            <p class="text-gray-600 mb-6 italic relative z-10 leading-relaxed">"Thanks to Planexus’s competent commercial support, we were able to position our technical products in the market with precision."</p>
            <div class="mt-auto">
              <h4 class="font-bold text-slate-900">Susanne Lehmann</h4>
              <p class="text-sm text-primary font-medium">Head of sales</p>
            </div>
          </div>
        </div>
      </div>
    </section>
    <section class="py-16 bg-white">
      <div class="container mx-auto px-4 text-center">
        <h2 class="text-2xl font-heading font-bold text-slate-900 mb-4">Start your project with us</h2>
        <p class="text-gray-600 max-w-2xl mx-auto mb-8">From the first <a href="/en/services/consulting" class="text-[#7a9900] hover:underline">consultation</a> through to turnkey handover — we accompany your <a href="/en/services" class="text-[#7a9900] hover:underline">laboratory-container project</a> in person.</p>
        <a href="/en/contact" class="inline-flex items-center gap-2 bg-[#bbd700] hover:bg-[#a8c200] text-slate-900 font-bold px-8 py-4 rounded-lg transition-colors">
          Get in touch
        </a>
      </div>
    </section>
  </div>
</Layout>
