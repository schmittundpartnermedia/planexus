---
import Layout from '../../layouts/Layout.astro';
import ContactForm from '../../components/ContactForm.tsx';
import AuthorBio from '../../components/AuthorBio.astro';
import CityCrossLinks from '../../components/CityCrossLinks.astro';

const title = "Lab containers Graz – GMP, cleanroom, ATEX";
const description = "Rent lab containers in Graz: BSL-3, ATEX, OIB/ÖNORM Z3 for industry, research and hospitals. EU delivery via the A9 Pyhrn Motorway in 14 weeks. Request a complimentary consultation.";
const canonical = "/en/lab-containers-graz";

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "serviceType": "Lab containers and modular laboratory construction Graz",
  "provider": {
    "@type": "Organization",
    "name": "Planexus GmbH",
    "image": "https://planexus.de/android-chrome-512x512.png",
    "url": "https://planexus.de",
    "telephone": "+49 7435 7519 700",
    "email": "info@planexus.de",
    "address": { "@type": "PostalAddress", "streetAddress": "Am Steinbach 8", "addressLocality": "Albstadt-Laufen", "addressRegion": "Baden-Württemberg", "postalCode": "72459", "addressCountry": "DE" },
    "parentOrganization": { "@type": "Organization", "name": "Wesemann Holding GmbH" }
  },
  "areaServed": [
    { "@type": "City", "name": "Graz" },
    { "@type": "AdministrativeArea", "name": "Styria" },
    { "@type": "Country", "name": "Austria" }
  ],
  "description": "Container laboratories, mobile laboratories and modular laboratory buildings for industry, research, universities and hospitals — from the Albstadt works, EU single-market compliant, to Graz via the A8 + A1 + A9 Pyhrn Motorway.",
  "offers": { "@type": "AggregateOffer", "priceCurrency": "EUR", "availability": "https://schema.org/InStock" }
};

const localBusinessSchema = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "name": "Planexus GmbH – Lab containers Graz",
      "image": "https://planexus.de/images/labtogo-industrie.webp",
  "url": "https://planexus.de/en/lab-containers-graz",
  "telephone": "+49 7435 7519 700",
  "email": "info@planexus.de",
  "address": { "@type": "PostalAddress", "streetAddress": "Am Steinbach 8", "addressLocality": "Albstadt-Laufen", "addressRegion": "Baden-Württemberg", "postalCode": "72459", "addressCountry": "DE" },
  "areaServed": { "@type": "City", "name": "Graz", "containedInPlace": { "@type": "Country", "name": "Austria" } },
  "priceRange": "EUR",
  "openingHoursSpecification": [{ "@type": "OpeningHoursSpecification", "dayOfWeek": ["Monday","Tuesday","Wednesday","Thursday","Friday"], "opens": "08:00", "closes": "17:00" }]
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://planexus.de/en" },
    { "@type": "ListItem", "position": 2, "name": "Locations", "item": "https://planexus.de/en/lab-containers" },
    { "@type": "ListItem", "position": 3, "name": "Lab containers Graz", "item": "https://planexus.de/en/lab-containers-graz" }
  ]
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "How long does it take to deliver a lab container from the Albstadt works to Graz?",
      "acceptedAnswer": { "@type": "Answer", "text": "The heavy-haulage route from the Albstadt works to Graz runs north-east on the A81 to Stuttgart, then east on the A8 via Munich → Salzburg, Walserberg border crossing (DE/AT EU single market, no stop since Schengen), then east on the A1 via Linz → Voralpenkreuz interchange and south-east on the A9 Pyhrn Motorway via the Bosruck and Gleinalm tunnels to Graz. Driving time is around 7 hours over approximately 660 kilometres — a full transport day with a mandatory rest break. The A9 Pyhrn is subject to toll (in addition to the GO-Box distance toll, extra tunnel tolls for the Bosruck and Gleinalm tunnels). Standard delivery points: the industrial and research sites in Liebenau, the university hospital at Auenbruggerplatz, and the university and research sites on Rechbauerstrasse, Inffeldgasse and Leonhardstrasse. From order to operational handover in Graz takes 10 to 14 weeks." }
    },
    {
      "@type": "Question",
      "name": "Which permits do I need for a lab container in Graz?",
      "acceptedAnswer": { "@type": "Answer", "text": "In Graz the Steiermärkisches Baugesetz (Stmk. BauG, Styrian Building Act, Provincial Law Gazette 59/1995 as amended) applies as Styrian state law, supplemented by OIB Guidelines 1 to 6 of the Austrian Institute of Construction Engineering. The competent authority is the Magistratsabteilung Baurechtsamt (Municipal Building Authority) at Europaplatz 20, 8011 Graz, together with the Baudirektion (Building Directorate). Containers are treated as buildings under § 19 Stmk. BauG; a building notification or building permit is required in most cases. Temporary siting of under six months on industrial plots (e.g. in Liebenau) may, depending on the site, be possible under a simplified notification procedure. We review your site in advance and file procedure-ready building documents directly at Europaplatz — including ÖNORM structural design with seismic zone Z3, OIB energy evidence and a fire-protection concept to OIB Guideline 2." }
    },
    {
      "@type": "Question",
      "name": "Which seismic requirements apply to lab containers in Graz under ÖNORM B 1998-1?",
      "acceptedAnswer": { "@type": "Answer", "text": "Under ÖNORM B 1998-1 (Eurocode 8 seismic), Graz lies in seismic zone Z3 with a horizontal design ground acceleration agR of around 0.8 to 1.0 m/s² — the highest zone among Austria’s provincial capitals and higher than Vienna (Z2/Z3) or Linz (Z1/Z2). Styria sits on the seismically active eastern Alpine fringe. Structurally that means: importance category II for industrial, research and hospital sites is mandatory; an anchoring concept and a capacity-designed overall system to ÖNORM B 1998-1 are not optional. We supply Graz with structural design to ÖNORM B 1998-1 with the Z3 factor and ÖNORM B 1991-1-3 snow load (Graz Zone 3, sk 1.5–2.0 kN/m² depending on altitude) and energetically to OIB Guideline 6 with U ≤ 0.20 W/m²K and heat recovery ≥ 75% — procedure-ready for the Baurechtsamt at Europaplatz." }
    },
    {
      "@type": "Question",
      "name": "What is the Graz mobility-engineering cluster and which containers does it need?",
      "acceptedAnswer": { "@type": "Answer", "text": "Graz is Austria’s undisputed centre for powertrain and vehicle engineering. Around the industrial sites in Graz-Liebenau, powertrain development focuses on internal-combustion engines, fuel cells, battery testing and e-mobility, together with contract manufacturing in the premium automotive segment. These sites need H2/battery test containers to ATEX Zone 2/22 (EX-II 3G/3D), climate rooms for engine test benches, and materials and corrosion laboratories. We build ATEX-compliant test containers with explosion-protected electrics to EN 60079, dual filtration and H2 sensing with automatic emergency shutdown — procedure-ready for the industrial sites in Liebenau." }
    },
    {
      "@type": "Question",
      "name": "Which applications are particularly in demand in Graz?",
      "acceptedAnswer": { "@type": "Answer", "text": "Graz is a dual mobility and life-science cluster. Typical uses for lab containers arise around the mobility-engineering cluster in Graz-Liebenau (ATEX-compliant powertrain/H2/battery test containers as well as materials and climate-chamber containers); the medical and natural-science research network of Graz’s universities (shared research platform, BSL-2 research containers); the Graz university hospital with several university clinics (study containers during hospital refurbishments); non-university research (materials, sensing and robotics containers); industrial biotechnology (biotech pilot containers); and the technical and natural-science universities with strengths in mechanical engineering, electrical engineering and mechatronics." }
    },
    {
      "@type": "Question",
      "name": "How does delivery to Austria work? EU single market, A9 Pyhrn, GO-Box?",
      "acceptedAnswer": { "@type": "Answer", "text": "Germany and Austria are both EU member states and part of the single market — there is no customs clearance. We deliver from the Albstadt works as an intra-Community supply with an Austrian VAT identification number (ATU number) — tax-free in Germany, reverse charge in Austria. The price advantage versus Swiss locations is up to 8.1% (Swiss VAT falls away entirely). For heavy haulage the Austrian HGV toll (GO-Box, ASFINAG) is obligatory on all motorways and expressways. On the A9 Pyhrn Motorway extra tunnel tolls apply for the Bosruck and Gleinalm tunnels — both mandatory for heavy goods vehicles over 3.5 t. Standard route via Salzburg-Walserberg (Schengen, no stop), Linz, Voralpenkreuz, A9 Pyhrn to Graz. From the Albstadt works to Graz: ~660 km, ~7 h driving time + mandatory rest break." }
    },
    {
      "@type": "Question",
      "name": "Can you supply BSL-3 and ATEX containers for industry, research and hospitals?",
      "acceptedAnswer": { "@type": "Answer", "text": "Yes. We build three container lines in parallel for Graz. First: BSL-3 containers for clinical research (university hospital, medical universities, research network) — HEPA H14 dual filtration, autoclaved airlock, negative pressure with a three-stage cascade, emergency power. Notification under the Genetic Engineering Act (GTG) to BMSGPK Vienna Stubenring, opinion of the scientific commission. Second: ATEX containers for H2 and battery testing (EX-II 2G T3 or T4 to EN 60079) with explosion-protected electrics, H2 sensing with automatic emergency shutdown, bursting discs and an inert-gas system. Third: GMP cleanroom containers for industrial biotech piloting with BASG inspection readiness — ISO Class 8/7. Structural design of all three lines to ÖNORM B 1998-1 (Z3) and ÖNORM B 1991, energy to OIB Guideline 6, fire protection to OIB Guideline 2, procedure-ready for the Baurechtsamt at Europaplatz." }
    }
  ]
};
---

<Layout title={title} description={description} canonical={canonical}>
  <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(localBusinessSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <div class="bg-white">

    <!-- HERO -->
    <section class="relative bg-slate-900 text-white overflow-hidden">
      <div class="relative z-10 container mx-auto px-4 py-20 md:py-28">
        <div class="max-w-4xl">
          <nav class="flex items-center gap-2 text-sm text-gray-400 mb-8" aria-label="Breadcrumb">
            <a href="/en" class="hover:text-primary transition-colors">Home</a>
            <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m9 18 6-6-6-6"/></svg>
            <span>Locations</span>
            <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m9 18 6-6-6-6"/></svg>
            <span class="text-primary">Graz</span>
          </nav>

          <div class="text-primary font-medium text-sm uppercase tracking-wider mb-4">Your specialist for lab containers · Mobility-engineering capital + research network</div>

          <h1 class="text-4xl md:text-5xl lg:text-6xl font-heading font-bold mb-6 leading-tight">
            Lab containers Graz – laboratories for industry, research and hospitals
          </h1>

          <p class="text-xl text-gray-300 leading-relaxed mb-4">
            <strong class="text-white">Our managing directors bring more than ten years of experience in lab-container construction.</strong> Modular, OIB-compliant, ÖNORM structural to seismic zone Z3. We deliver research, hospital and powertrain-test environments for industry, research, universities and hospitals — from the Albstadt works directly to Graz, EU single-market compliant without customs clearance via the A8 + A1 + A9 Pyhrn Motorway.
          </p>
          <p class="text-base text-gray-400 mb-8">While others are still planning, you are already researching and testing.</p>

          <div class="flex flex-col sm:flex-row gap-4 mb-8">
            <a href="#anfrage" data-testid="button-cta-hero" class="bg-primary text-slate-900 font-bold px-8 py-4 rounded-lg hover:bg-primary/90 transition-colors inline-flex items-center justify-center gap-2 shadow-[0_0_20px_rgba(132,189,0,0.3)]">Complimentary Graz site audit<svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg></a>
            <a href="tel:+4974357519700" class="border border-white/20 text-white font-medium px-8 py-4 rounded-lg hover:bg-white/10 transition-colors inline-flex items-center justify-center gap-2"><svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>+49 7435 7519 700</a>
          </div>

          <div class="flex flex-wrap items-center gap-x-6 gap-y-2 text-sm text-gray-400">
            <div class="flex items-center gap-2"><svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6 9 17l-5-5"/></svg>Specialist in modular laboratory construction</div>
            <div class="flex items-center gap-2"><svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6 9 17l-5-5"/></svg>Award 2026 EU Business News</div>
            <div class="flex items-center gap-2"><svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6 9 17l-5-5"/></svg>EU single market: no customs</div>
            <div class="flex items-center gap-2"><svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6 9 17l-5-5"/></svg>Wesemann Group · 60+ years of laboratory construction</div>
          </div>
        </div>
      </div>
    </section>

    <AuthorBio city="Graz"  locale="en" />

    <!-- LABtoGO -->
    <section class="py-16 md:py-20 bg-gradient-to-br from-primary/5 via-white to-primary/10 border-y border-primary/20">
      <div class="container mx-auto px-4">
        <div class="max-w-5xl mx-auto">
          <div class="grid md:grid-cols-2 gap-10 items-center mb-10">
            <div>
              <div class="text-primary font-bold text-sm uppercase tracking-wider mb-3">Pattern interrupt · World premiere at analytica 2026</div>
              <h2 class="text-3xl md:text-4xl font-heading font-bold mb-4 text-slate-900">Planexus shows Graz what a lab container can really do in 2026</h2>
              <p class="text-lg text-gray-700 leading-relaxed mb-4">An ordinary lab container has 2,400 mm internal height. Working upright at a fume cupboard or under ATEX ventilation is a struggle.</p>
              <p class="text-lg text-slate-900 font-bold leading-relaxed mb-4">The Planexus LABtoGO has 2,750 mm internal height. 9.5 m external length. 3 m external width. A fully glazed front that brings genuine daylight into every industrial, research or hospital laboratory.</p>
              <p class="text-lg text-gray-700 leading-relaxed"><strong>An ordinary lab container fits entirely inside a LABtoGO.</strong> We configure it for Graz to ÖNORM B 1998-1 seismic zone Z3 (the highest zone among Austrian capitals), OIB Guideline 6 energy stricter than the German GEG, EU single-market compliant without customs clearance from the Albstadt works via the A8 + A1 + A9 Pyhrn Motorway (Bosruck and Gleinalm tunnels).</p>
            </div>
            <div class="grid grid-cols-2 gap-4">
              <div class="bg-slate-900 text-white rounded-2xl p-6 text-center"><div class="text-4xl font-bold text-primary mb-1">2,750</div><div class="text-xs text-gray-400 uppercase tracking-wider">mm internal height</div><div class="text-xs text-gray-500 mt-1">Standard: 2,400 mm</div></div>
              <div class="bg-slate-900 text-white rounded-2xl p-6 text-center"><div class="text-4xl font-bold text-primary mb-1">9,500</div><div class="text-xs text-gray-400 uppercase tracking-wider">mm external length</div><div class="text-xs text-gray-500 mt-1">3,000 mm width</div></div>
              <div class="bg-slate-900 text-white rounded-2xl p-6 text-center"><div class="text-4xl font-bold text-primary mb-1">ÖNORM Z3</div><div class="text-xs text-gray-400 uppercase tracking-wider">Seismic agR ~0.8–1.0</div><div class="text-xs text-gray-500 mt-1">highest AT capital</div></div>
              <div class="bg-slate-900 text-white rounded-2xl p-6 text-center"><div class="text-4xl font-bold text-primary mb-1">660 km</div><div class="text-xs text-gray-400 uppercase tracking-wider">Works → Graz</div><div class="text-xs text-gray-500 mt-1">~7 h via A9 Pyhrn</div></div>
            </div>
          </div>
          <div class="text-center"><a href="/en/lab-containers/labtogo" class="inline-flex items-center gap-2 text-primary font-bold hover:underline">View the LABtoGO platform and all configurations<svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg></a></div>
        </div>
      </div>
    </section>

    <!-- PROBLEM-AGITATION -->
    <section class="py-16 md:py-20">
      <div class="container mx-auto px-4">
        <div class="max-w-5xl mx-auto">
          <h2 class="text-3xl md:text-4xl font-heading font-bold mb-10 text-slate-900">Planexus solves the three Graz bottlenecks at which powertrain and hospital containers regularly fail</h2>
          <div class="grid md:grid-cols-3 gap-6">
            <div class="bg-slate-50 border-l-4 border-primary rounded-xl p-6">
              <div class="text-slate-900 font-bold text-lg mb-2">Seismic zone Z3 underestimated</div>
              <p class="text-gray-700 text-sm leading-relaxed">Under ÖNORM B 1998-1, Graz lies in seismic zone Z3 with agR ~0.8–1.0 m/s² — the highest zone among Austria’s provincial capitals. Containers without a capacity-designed anchoring concept and importance category II (for industrial, research and hospital sites) are stopped by the Baurechtsamt at Europaplatz at building-notification stage — and retrospective structural corrections cost weeks.</p>
              <p class="text-sm text-slate-900 font-semibold mt-3 pt-3 border-t border-gray-200">Planexus answer: Z3 structural design from the works, importance category II as standard.</p>
            </div>
            <div class="bg-slate-50 border-l-4 border-primary rounded-xl p-6">
              <div class="text-slate-900 font-bold text-lg mb-2">ATEX/H2 test path underspecified</div>
              <p class="text-gray-700 text-sm leading-relaxed">Graz powertrain development focuses on fuel cells, H2 testing and battery testing. Containers for these applications need ATEX Zone 2/22 (EX-II 3G/3D), explosion-protected electrics to EN 60079, H2 sensing with automatic emergency shutdown and an inert-gas system. Standard containers do not have this — and field retrofits cannot be certified.</p>
              <p class="text-sm text-slate-900 font-semibold mt-3 pt-3 border-t border-gray-200">Planexus answer: ATEX EN 60079 from the works, H2 sensing pre-installed.</p>
            </div>
            <div class="bg-slate-50 border-l-4 border-primary rounded-xl p-6">
              <div class="text-slate-900 font-bold text-lg mb-2">A9 Pyhrn logistics poorly planned</div>
              <p class="text-gray-700 text-sm leading-relaxed">The A9 Pyhrn Motorway is the only sensible heavy-haulage route from Salzburg to Graz and includes the Bosruck and Gleinalm tunnels as extra-toll sections (in addition to the GO-Box distance toll). Heavy transports over 18 t require a tunnel permit. Anyone who overlooks this loses a day — and in high summer Bosruck Tunnel congestion is the norm.</p>
              <p class="text-sm text-slate-900 font-semibold mt-3 pt-3 border-t border-gray-200">Planexus answer: A9 Pyhrn tunnel permit and toll planned in from the works.</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- STRATEGISCHE FUSION -->
    <section class="py-16 md:py-20 bg-slate-50">
      <div class="container mx-auto px-4">
        <div class="max-w-4xl mx-auto">
          <h2 class="text-3xl md:text-4xl font-heading font-bold mb-8 text-slate-900">Lab containers for Graz: what industry, research and hospitals demand of the engineering</h2>
          <div class="prose prose-lg max-w-none text-gray-700 space-y-6">
            <p><strong>Graz is Austria’s second-largest city and a dual cluster of mobility engineering and life sciences.</strong> In Graz-Liebenau, powertrain development focuses on internal-combustion engines, fuel cells, battery testing and e-mobility, together with contract manufacturing in the premium automotive segment. Added to this are a medical and natural-science research network spanning several Graz universities, a large university hospital with several university clinics, non-university research and industrial biotechnology. Completing the picture are the Silicon Alps microelectronics and sensing cluster and Green Tech Valley.</p>
            <p><strong>We know this market in detail.</strong> We know that the Baurechtsamt at Europaplatz 20, 8011 Graz, decides under the Styrian Building Act (Stmk. BauG, Provincial Law Gazette 59/1995 as amended) and OIB Guidelines 1–6. We know that ÖNORM B 1998-1 (EC8 seismic) defines zone Z3 for Graz with agR ~0.8–1.0 m/s² — the highest zone among Austria’s provincial capitals, because Styria sits on the seismically active eastern Alpine fringe. Importance category II for industrial, research and hospital sites is not optional. We know that containers for H2 and battery testing must be ATEX-compliant to EN 60079, with explosion-protected electrics, H2 sensing with automatic emergency shutdown, bursting discs and an inert-gas system. We know the logistics: Albstadt works → Graz means A81 → A8 Walserberg → A1 Linz → Voralpenkreuz → A9 Pyhrn Motorway (Bosruck and Gleinalm tunnels with extra toll), 660 kilometres, 7 hours of heavy-haulage driving time plus a mandatory rest break. These details are not in our quotation — they are the engineering and logistics foundation of every container that leaves our Albstadt works.</p>
            <p><strong>Made in Albstadt, EU single-market compliant without customs, turnkey in Graz.</strong> Final assembly and interior fit-out are carried out with Wesemann furniture in our own works — factory visits can be arranged from either side. Intra-Community supply with ATU reverse charge from the works; A9 Pyhrn tunnel permit and toll planned in from the factory. Standard delivery points: the industrial sites in Liebenau, the university hospital at Auenbruggerplatz, and the university and research sites on Inffeldgasse and Leonhardstrasse.</p>
            <p>Whether you need a <strong>mobile laboratory in Graz</strong> for a time-limited hospital refurbishment, a <strong>modular lab container in Graz</strong> for research expansion, or an <strong>ATEX container laboratory in Graz</strong> with H2 sensing and EN 60079 electrics for the industrial sites in Liebenau — we deliver all three answers from the same platform: the LABtoGO from our Albstadt works, with ÖNORM Z3 structural design, OIB energy evidence, GTG notification and ATEX certification documented from the factory.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- 6 ENGINEERING -->
    <section class="py-16 md:py-20">
      <div class="container mx-auto px-4">
        <div class="max-w-6xl mx-auto">
          <h2 class="text-3xl md:text-4xl font-heading font-bold mb-3 text-slate-900">Six engineering disciplines for Austria’s mobility capital</h2>
          <p class="text-gray-600 text-lg mb-10 max-w-3xl">Planexus builds lab containers for Graz that are aligned in every discipline with Styrian realities and mobility-engineering requirements — not generic, but standard- and site-specific.</p>
          <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-5">
            <div class="bg-slate-50 rounded-xl p-6 border border-gray-100"><div class="text-primary text-xs font-bold uppercase tracking-wider mb-2">ÖNORM B 1998-1 EC8</div><h3 class="font-bold text-slate-900 mb-2">Z3 + importance cat. II</h3><p class="text-sm text-gray-600">Graz Z3 with agR ~0.8–1.0 m/s² — the highest AT capital zone. Structural design with a capacity-designed anchoring concept to ÖNORM B 1991, importance category II for industrial, research and hospital sites.</p></div>
            <div class="bg-slate-50 rounded-xl p-6 border border-gray-100"><div class="text-primary text-xs font-bold uppercase tracking-wider mb-2">ATEX EN 60079</div><h3 class="font-bold text-slate-900 mb-2">EX-II 2G/3G + H2 sensing</h3><p class="text-sm text-gray-600">For the industrial sites in Liebenau: ATEX containers with explosion-protected electrics to EN 60079, H2 sensing with automatic emergency shutdown, bursting discs, inert-gas system.</p></div>
            <div class="bg-slate-50 rounded-xl p-6 border border-gray-100"><div class="text-primary text-xs font-bold uppercase tracking-wider mb-2">EU single market + A9 Pyhrn</div><h3 class="font-bold text-slate-900 mb-2">ATU reverse + tunnel toll</h3><p class="text-sm text-gray-600">Intra-Community supply with ATU number from the Albstadt works — tax-free in DE, reverse charge in AT. A9 Pyhrn extra toll for the Bosruck/Gleinalm tunnels and tunnel permit planned in from the works.</p></div>
            <div class="bg-slate-50 rounded-xl p-6 border border-gray-100"><div class="text-primary text-xs font-bold uppercase tracking-wider mb-2">Research network</div><h3 class="font-bold text-slate-900 mb-2">Three-university connectable</h3><p class="text-sm text-gray-600">Research containers need connection to Graz university infrastructure (shared data networks, shared research platforms). Tailored configuration from the works.</p></div>
