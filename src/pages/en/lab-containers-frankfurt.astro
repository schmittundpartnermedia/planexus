const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://planexus.de/en" },
    { "@type": "ListItem", "position": 2, "name": "Lab containers", "item": "https://planexus.de/en/lab-containers" },
    { "@type": "ListItem", "position": 3, "name": "Lab containers Frankfurt", "item": "https://planexus.de/en/lab-containers-frankfurt" }
  ]
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "How long does delivery of a lab container to Frankfurt from the Albstadt works take?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "The heavy-goods route Albstadt works → Frankfurt runs north on the A81 via Stuttgart, west on the A8 to Karlsruhe and north on the A5 into the Rhine-Main region. Pure driving time is around 3.5 hours over about 320 kilometres; with a permit-required heavy transport it is typically one transport day. Standard delivery points are the Frankfurt-Süd (A5/A648) junction for Niederrad and Westend, the Frankfurt interchange (A5/A3) for Industriepark Höchst and Frankfurt-Nordwestkreuz (A5/A66) for the Riedberg campus. From order to operational handover in Frankfurt takes 8 to 14 weeks."
      }
    },
    {
      "@type": "Question",
      "name": "What permits do I need for a lab container in Frankfurt am Main?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "The Hessian Building Code (Hessische Bauordnung, HBO 2018, last amended 2024) is decisive. Section 63 HBO governs procedure-exempt works; exact classification depends on size, site and use. For GMP, BSL-3 and larger installations the building notification to Frankfurt am Main building control, Kurt-Schumacher-Straße 10, 60311 Frankfurt, applies. For genetic-engineering facilities S1/S2/S3 an additional notification under the Genetic Engineering Act to the Darmstadt Regional Council (Regierungspräsidium Darmstadt) as the competent state authority is required. BSL-3 requires a permit under BioStoffV. For siting in Industriepark Höchst the site operator’s internal permit paths apply in addition. We check the classification of your Frankfurt site in advance and submit procedure-ready building documents."
      }
    },
    {
      "@type": "Question",
      "name": "Which corrosivity category and climate apply to Frankfurt under DIN EN ISO 12944-2?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "With around 700 mm annual precipitation, Frankfurt am Main is Germany’s driest major city. Mean annual temperature sits at about 11 °C and is rising. DIN EN ISO 12944-2 assigns Frankfurt city districts to corrosivity category C3 (urban atmosphere, moderate SO₂ load); near Industriepark Höchst and along harbour facilities C4 may apply locally. More important than corrosion in Frankfurt, however, is the summer urban heat island: the number of tropical days above 30 °C is rising continuously according to DWD evaluations. Planexus supplies HVAC packages with redundant cooling capacity and solar-control glazing for Frankfurt sites from the factory."
      }
    },
    {
      "@type": "Question",
      "name": "How high must a lab container stand against flooding on the Frankfurt Main?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "The governing gauge is Frankfurt-Osthafen on the Main with gauge zero +88.757 m NN. The highest measured flood level since 1990 was January 2003 at 4.49 m. The historical mark from 1882 sits at about 7.80 m. Navigation on the Main is suspended from about 4.0 m on the Frankfurt-Osthafen gauge. For siting in the flood-risk area (Osthafen, Westhafen, Niederrad Main bank, Sachsenhausen bank) the City of Frankfurt requires elevation above the local flood-protection line and, where applicable, mobile flood-protection walls. We supply structurally checked pile foundations or steel-frame elevation with height adjustment."
      }
    },
    {
      "@type": "Question",
      "name": "Can you supply containers for Industriepark Höchst?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. Industriepark Höchst (65926 Frankfurt am Main) is, at around 460 hectares and more than 22,000 employees, Europe’s largest integrated chemicals and pharmaceutical industrial park. Numerous pharma and chemicals companies with several thousand employees are based there. We supply GMP cleanrooms to EU Annex 1 with ISO 14644 class 5–7, ATEX-zoned solvent containers to Zone 1/21 and BSL-2 containers for pilot production. For siting in the industrial park, coordination with the site operator would be required — they are competent for on-site services, the works railway and permit paths."
      }
    },
    {
      "@type": "Question",
      "name": "Which container specification fits university medicine in Niederrad or university research on Riedberg?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "The university hospital in Frankfurt-Niederrad operates numerous clinics and institutes with several thousand staff. Typical specifications here are BSL-2 study containers during hospital refurbishments, interim laboratories with fire protection compliant with the Hessian Hospital Building Ordinance (KhBauVO Hessen), and mobile diagnostic containers. Frankfurt University is distributed across the Westend, Riedberg (natural sciences, pharmacy, biochemistry) and Niederrad (hospital) campuses. On the Riedberg campus several basic-research institutes also work — here we supply BSL-2 third-party-funded containers and cleanroom modules to the conditions of research funding."
      }
    },
    {
      "@type": "Question",
      "name": "Which funding and which pharma corridor apply in the Rhine-Main region?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "The Rhine-Main region is Germany’s strongest pharma cluster by value added. Within a 60 km radius, large pharma and chemicals sites concentrate at Industriepark Höchst, in Darmstadt, Mainz and Ingelheim, plus several pharmaceutical research institutions. Funding programmes run via LOEWE (Hesse’s state funding programme) and federal programmes such as ZIM and KMU-innovativ. Hire models run off-balance-sheet — we advise on the accounting classification."
      }
    }
  ]
};
---

<Layout title={title} description={description} canonical={canonical}>
  <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(localBusinessSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <div class="bg-white">

    <!-- HERO -->
    <section class="relative bg-slate-900 text-white overflow-hidden">
      <div class="relative z-10 container mx-auto px-4 py-20 md:py-28">
        <div class="max-w-4xl">
          <nav class="flex items-center gap-2 text-sm text-gray-400 mb-8" aria-label="Breadcrumb">
            <a href="/en" class="hover:text-primary transition-colors">Home</a>
            <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m9 18 6-6-6-6"/></svg>
            <span>Lab containers</span>
            <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m9 18 6-6-6-6"/></svg>
            <span class="text-primary">Frankfurt</span>
          </nav>

          <div class="text-primary font-medium text-sm uppercase tracking-wider mb-4">Your specialist for lab containers · Rhine-Main pharma cluster</div>

          <h1 class="text-4xl md:text-5xl lg:text-6xl font-heading font-bold mb-6 leading-tight">
            Lab containers Frankfurt – GMP laboratories for Höchst and Rhine-Main
          </h1>

          <p class="text-xl text-gray-300 leading-relaxed mb-4">
            <strong class="text-white">Our managing directors bring more than ten years of experience in lab-container construction.</strong> Modular, HBO-compliant, pharma-capable. We deliver flexible research environments for pharma and chemicals at Industriepark Höchst, university medicine, universities and research institutes in the Rhine-Main region — from the Albstadt works straight to Frankfurt, via the A81 / A8 / A5.
          </p>
          <p class="text-base text-gray-400 mb-8">
            While others are still planning, you are already researching.
          </p>

          <div class="flex flex-col sm:flex-row gap-4 mb-8">
            <a href="#anfrage" data-testid="button-cta-hero" class="bg-primary text-slate-900 font-bold px-8 py-4 rounded-lg hover:bg-primary/90 transition-colors inline-flex items-center justify-center gap-2 shadow-[0_0_20px_rgba(132,189,0,0.3)]">
              Complimentary site audit Frankfurt
              <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
            </a>
            <a href="tel:+4974357519700" class="border border-white/20 text-white font-medium px-8 py-4 rounded-lg hover:bg-white/10 transition-colors inline-flex items-center justify-center gap-2">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
              +49 7435 7519 700
            </a>
          </div>

          <div class="flex flex-wrap items-center gap-x-6 gap-y-2 text-sm text-gray-400">
            <div class="flex items-center gap-2"><svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6 9 17l-5-5"/></svg>Specialist in modular laboratory construction</div>
            <div class="flex items-center gap-2"><svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6 9 17l-5-5"/></svg>Award 2026 EU Business News</div>
            <div class="flex items-center gap-2"><svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6 9 17l-5-5"/></svg>HBO Section 63 building notification included</div>
            <div class="flex items-center gap-2"><svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6 9 17l-5-5"/></svg>Wesemann Group · 60+ years of laboratory construction</div>
          </div>
        </div>
      </div>
    </section>

    <AuthorBio city="Frankfurt"  locale="en" />

    <!-- PATTERN-INTERRUPT: LABtoGO -->
    <section class="py-16 md:py-20 bg-gradient-to-br from-primary/5 via-white to-primary/10 border-y border-primary/20">
      <div class="container mx-auto px-4">
        <div class="max-w-5xl mx-auto">
          <div class="grid md:grid-cols-2 gap-10 items-center mb-10">
            <div>
              <div class="text-primary font-bold text-sm uppercase tracking-wider mb-3">Pattern interrupt · World premiere at analytica 2026</div>
              <h2 class="text-3xl md:text-4xl font-heading font-bold mb-4 text-slate-900">Planexus shows Frankfurt what a lab container in 2026 can really do</h2>
              <p class="text-lg text-gray-700 leading-relaxed mb-4">A conventional lab container has 2,400 mm internal height. You can stand up inside — but working upright at a fume cupboard is barely possible.</p>
              <p class="text-lg text-slate-900 font-bold leading-relaxed mb-4">Planexus LABtoGO has 2,750 mm internal height. 9.5 m external length. 3 m external width. A fully glazed front that brings real daylight into every Frankfurt pharma, hospital or research laboratory.</p>
              <p class="text-lg text-gray-700 leading-relaxed"><strong>A conventional lab container fits entirely inside a LABtoGO.</strong> We do not call it LABtoGO without reason — it is the platform on which we configure BSL-2, BSL-3, GMP cleanroom to EU Annex 1, ATEX zoning for solvents and HVAC packages for the inner-city heat island for Frankfurt.</p>
            </div>
            <div class="grid grid-cols-2 gap-4">
              <div class="bg-slate-900 text-white rounded-2xl p-6 text-center"><div class="text-4xl font-bold text-primary mb-1">2.750</div><div class="text-xs text-gray-400 uppercase tracking-wider">mm internal height</div><div class="text-xs text-gray-500 mt-1">Standard: 2,400 mm</div></div>
              <div class="bg-slate-900 text-white rounded-2xl p-6 text-center"><div class="text-4xl font-bold text-primary mb-1">9.500</div><div class="text-xs text-gray-400 uppercase tracking-wider">mm external length</div><div class="text-xs text-gray-500 mt-1">3,000 mm width</div></div>
              <div class="bg-slate-900 text-white rounded-2xl p-6 text-center"><div class="text-4xl font-bold text-primary mb-1">100%</div><div class="text-xs text-gray-400 uppercase tracking-wider">fully glazed</div><div class="text-xs text-gray-500 mt-1">daylight laboratory</div></div>
              <div class="bg-slate-900 text-white rounded-2xl p-6 text-center"><div class="text-4xl font-bold text-primary mb-1">U 0.20</div><div class="text-xs text-gray-400 uppercase tracking-wider">W/m²K Sandwich</div><div class="text-xs text-gray-500 mt-1">80–120 mm insulation</div></div>
            </div>
          </div>
          <div class="text-center">
            <a href="/en/lab-containers/labtogo" class="inline-flex items-center gap-2 text-primary font-bold hover:underline">View the LABtoGO platform and all configurations
              <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- PROBLEM-AGITATION -->
    <section class="py-16 md:py-20">
      <div class="container mx-auto px-4">
        <div class="max-w-5xl mx-auto">
          <h2 class="text-3xl md:text-4xl font-heading font-bold mb-10 text-slate-900">Planexus solves the three Frankfurt bottlenecks at which laboratory projects regularly fail</h2>
          <div class="grid md:grid-cols-3 gap-6">
            <div class="bg-slate-50 border-l-4 border-primary rounded-xl p-6">
              <div class="text-slate-900 font-bold text-lg mb-2">The inner-city heat island destroys standard HVAC in summer</div>
              <p class="text-gray-700 text-sm leading-relaxed">Frankfurt is Germany’s driest major city with only 700 mm of precipitation per year and a rising number of tropical days above 30 °C. Standard climate splits for office containers cannot handle the load peaks for ISO 14644 cleanroom classes or PCR diagnostics — equipment fails, validations break, studies are lost.</p>
              <p class="text-sm text-slate-900 font-semibold mt-3 pt-3 border-t border-gray-200">Planexus response: HVAC package with redundant cooling capacity, solar-control glazing and external shading configured at the factory.</p>
            </div>
            <div class="bg-slate-50 border-l-4 border-primary rounded-xl p-6">
              <div class="text-slate-900 font-bold text-lg mb-2">Industriepark Höchst – internal site permit alongside HBO</div>
              <p class="text-gray-700 text-sm leading-relaxed">Siting in Industriepark Höchst (460 ha, 22,000 employees, 90+ companies) runs a dual permit path: HBO building notification to Frankfurt building control AND internal release by the site operator for works-railway connection, services connection and fire protection. Anyone who serves only one path waits two months.</p>
              <p class="text-sm text-slate-900 font-semibold mt-3 pt-3 border-t border-gray-200">Planexus response: Dual application track in parallel, interface to the site operator from day 1.</p>
            </div>
            <div class="bg-slate-50 border-l-4 border-primary rounded-xl p-6">
              <div class="text-slate-900 font-bold text-lg mb-2">Rhine-Main pharma demands GMP, ATEX and BSL from one platform</div>
              <p class="text-gray-700 text-sm leading-relaxed">Pharma and chemicals sites at Industriepark Höchst, in Darmstadt (30 km), Mainz (40 km) and Ingelheim demand a supply spectrum from a single source: GMP cleanroom to EU Annex 1, ATEX zoning 1/21 for solvents, BSL-2/-3 to BioStoffV and IQ/OQ/PQ documentation. Coordinating three manufacturers means four weeks of delay per handover.</p>
              <p class="text-sm text-slate-900 font-semibold mt-3 pt-3 border-t border-gray-200">Planexus response: One LABtoGO platform, all four configurations, one contact.</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- STRATEGISCHE FUSION INTRO -->
    <section class="py-16 md:py-20 bg-slate-50">
      <div class="container mx-auto px-4">
        <div class="max-w-4xl mx-auto">
          <h2 class="text-3xl md:text-4xl font-heading font-bold mb-8 text-slate-900">Lab containers for Frankfurt: what the Rhine-Main pharma cluster, the heat island and Industriepark Höchst demand of the engineering</h2>
          <div class="prose prose-lg max-w-none text-gray-700 space-y-6">
            <p><strong>Frankfurt is Germany’s strongest pharma cluster by value added.</strong> Across 248 square kilometres and 16 local districts, the banking city competes with Industriepark Höchst (460 hectares, more than 22,000 employees, 90+ companies), a university hospital in Niederrad with numerous clinics and institutes, a research-intensive university with the Westend, Riedberg and Niederrad campuses and around 45,000 students, and several basic-research institutes on the Riedberg campus for land, permits and engineering capacity. Within a 60-kilometre radius sit large pharma and chemicals sites in Darmstadt, Mainz and Ingelheim. Anyone ordering a container laboratory here is not buying a standard product — they are buying site intelligence for the German-speaking pharma corridor with the highest research and production density.</p>
            <p><strong>We know this market in detail.</strong> We know that Frankfurt am Main building control at Kurt-Schumacher-Straße 10 decides under HBO 2018 and that Section 63 defines procedure-exempt works. We know that the Frankfurt-Osthafen gauge with zero +88.757 m NN has been observed for decades and that the January 2003 flood at 4.49 m marked the high since 1990. We know that with 700 mm annual precipitation Frankfurt is Germany’s driest major city and under DIN EN ISO 12944-2 falls into corrosivity category C3 — but with the highest heat-island load of any German top location. We know that siting in Industriepark Höchst only works via the dual permit of HBO building control plus release by the site operator. These details are not in our quotation — they are the engineering foundation of every container that leaves our Albstadt works.</p>
            <p><strong>Made in Albstadt, turnkey in Frankfurt.</strong> Final assembly and interior fit-out are carried out with Wesemann furniture at our own works — a factory visit can be planned from either side. North on the A81 via Stuttgart, west on the A8 to Karlsruhe and north on the A5 into the Rhine-Main region, the heavy-goods distance is around 320 kilometres; the Frankfurt-Süd (A5/A648), Frankfurt interchange (A5/A3) and Frankfurt-Nordwestkreuz (A5/A66) junctions are standard delivery points for Niederrad, Westend, Industriepark Höchst and the Riedberg campus.</p>
            <p>Whether you need a <strong>mobile laboratory Frankfurt</strong> for a time-limited refurbishment phase at a university hospital, a <strong>modular lab container Frankfurt</strong> for a permanent pharma expansion at Industriepark Höchst, or a <strong>container laboratory Frankfurt</strong> with BSL-3 containment for university-medical research — we deliver all three answers from the same platform: the LABtoGO from our Albstadt works.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- ANWENDUNGSBEREICHE FRANKFURT -->
    <section class="py-16 md:py-20 bg-slate-900 text-white">
      <div class="container mx-auto px-4">
        <div class="max-w-6xl mx-auto">
          <div class="text-center max-w-3xl mx-auto mb-12">
            <div class="text-primary font-bold text-sm uppercase tracking-wider mb-3">Frankfurt applications</div>
            <h2 class="text-3xl md:text-4xl font-heading font-bold mb-4">Eight applications for lab containers in Frankfurt</h2>
            <p class="text-gray-400 text-lg">Each area with a concrete Frankfurt site and industry reference.</p>
          </div>
          <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
            <div class="bg-slate-800/60 rounded-xl p-5 border border-slate-700 hover:border-primary/40 transition-colors"><div class="text-primary text-xs font-bold uppercase tracking-wider mb-2">01</div><div class="font-bold mb-1">Pharma pilot production</div><p class="text-xs text-gray-400">Industriepark Höchst (65926), GMP cleanroom EU Annex 1, ATEX zoning 1/21 for API synthesis</p></div>
            <div class="bg-slate-800/60 rounded-xl p-5 border border-slate-700 hover:border-primary/40 transition-colors"><div class="text-primary text-xs font-bold uppercase tracking-wider mb-2">02</div><div class="font-bold mb-1">University medicine</div><p class="text-xs text-gray-400">University hospital in Niederrad, numerous clinics and institutes, BSL-2 study containers during refurbishment</p></div>
            <div class="bg-slate-800/60 rounded-xl p-5 border border-slate-700 hover:border-primary/40 transition-colors"><div class="text-primary text-xs font-bold uppercase tracking-wider mb-2">03</div><div class="font-bold mb-1">Basic research Riedberg</div><p class="text-xs text-gray-400">Basic-research institutes on Riedberg, third-party-funded containers, S2 GenTG notification to RP Darmstadt</p></div>
            <div class="bg-slate-800/60 rounded-xl p-5 border border-slate-700 hover:border-primary/40 transition-colors"><div class="text-primary text-xs font-bold uppercase tracking-wider mb-2">04</div><div class="font-bold mb-1">University research Riedberg</div><p class="text-xs text-gray-400">Natural sciences, pharmacy, biochemistry – BSL-2 third-party funding, cleanroom to research-funding conditions</p></div>
