              <ul class="space-y-1 text-sm">
                <li><a href="/en/lab-containers-zurich" class="text-[#7a9900] hover:underline">Zurich</a></li>
                <li><a href="/en/lab-containers-basel" class="text-[#7a9900] hover:underline">Basel</a></li>
