---
import Layout from '../../../layouts/Layout.astro';
import ContactForm from '../../../components/ContactForm.tsx';
import AuthorBio from '../../../components/AuthorBio.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';

const title = "Lab containers for 7 industries – overview";
const description = "Lab containers for 7 industries: pharma/biotech (GMP, Annex 1), research (DFG), industry (ISO 17025), education, public health (IfSG), H₂ & batteries (ATEX), oil & gas (refining).";
const canonical = "/en/industries";

const collectionSchema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": "Industry solutions for lab containers",
  "description": "Overview of all seven Planexus industry solutions for lab containers in Germany, Austria and Switzerland (DACH)",
  "url": "https://planexus.de/en/industries",
  "publisher": { "@type": "Organization", "name": "Planexus GmbH", "url": "https://planexus.de" }
};
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://planexus.de/en" },
    { "@type": "ListItem", "position": 2, "name": "Industries", "item": "https://planexus.de/en/industries" }
  ]
};

const branchen = [
  {
    slug: 'pharma-biotech',
    name: 'Pharma & biotech',
    tagline: 'GMP, Annex 1, BSL-3 – inspection-ready from the factory',
    desc: 'Cleanroom containers, ISO Classes 5–8 (GMP Grades A to D), BSL-2/3 in line with TRBA 100/120, Annex 1-compliant pressure cascades with HEPA H14 dual filtration, complete IQ/OQ/PQ documentation. Inspection-ready for BfArM, Swissmedic and BASG.',
    color: 'from-blue-500/10 to-indigo-500/5',
    badge: 'Annex 1 · ISO 14644 · ICH Q9/Q10',
  },
  {
    slug: 'research-universities',
    name: 'Research & universities',
    tagline: 'DFG-fundable, GenTSV S1/S2, grant-ready in 18 weeks',
    desc: 'Research containers for universities and research institutes. BSL-1/2 plus S1/S2 under the German Genetic Engineering Safety Ordinance (GenTSV), hazardous-substance storage to DIN EN 14470, hire agreements matched to DFG, BMBF and EU project terms. Interim space during refurbishment included.',
    color: 'from-emerald-500/10 to-teal-500/5',
    badge: 'GenTSV · DGUV V3 · DFG rules of use',
  },
  {
    slug: 'industry-materials-testing',
    name: 'Industry & materials testing',
    tagline: 'ISO 17025, ATEX, vibration-isolated – with no plant downtime',
    desc: 'Works QC containers for steel, automotive, chemicals, construction and mechanical engineering. DAkkS-accreditation-ready to ISO/IEC 17025, ATEX/IECEx Zone 1/2, climate classes 1–5 to VDI/VDE 2627, vibration isolation for microbalances and SEM.',
    color: 'from-amber-500/10 to-orange-500/5',
    badge: 'ISO 17025 · ATEX · VDI 2627',
  },
  {
    slug: 'education',
    name: 'Education & vocational schools',
    tagline: 'RiSU-compliant, GEG refurbishment interim space, BTA/CTA/MTA-capable',
    desc: 'School laboratories to the KMK RiSU 2019 guidance and DGUV Information 202-058. Interim laboratories during GEG or fire-protection refurbishment in 8–12 weeks. BTA, CTA and MTA training containers with a full practical equipment set. Option to take over after the refurbishment.',
    color: 'from-purple-500/10 to-violet-500/5',
    badge: 'RiSU-KMK · DGUV 202-058 · DIN EN 14175',
  },
  {
    slug: 'public-health-emergency-preparedness',
    name: 'Public health & emergency preparedness',
    tagline: 'BBK, CBRN – operational in 72 hours',
    desc: 'Mobile diagnostics containers for pandemics and major incidents. BSL-2/3 for PCR and viral diagnostics under the German Infection Protection Act (IfSG) and RiliBÄK, CBRN modules for NBC incidents, ZSKG stockpiling under framework agreements, helicopter lifting frames for CH-53, CH-47 and NH-90.',
    color: 'from-red-500/10 to-rose-500/5',
    badge: 'IfSG · RiliBÄK · ZSKG · BBK',
  },
  {
    slug: 'energy-transition-h2-battery',
    name: 'Energy transition, H₂ & batteries',
    tagline: 'ATEX Zone 1/2, thermal-runaway resistant, IPCEI-fundable',
    desc: 'H₂ test containers to ATEX 2014/34/EU and EN 60079, battery-abuse testing with thermal-runaway protection to ISO 6469 and UN-ECE R100/R136, dry rooms at −40 °C dew point for cell manufacturing, eligible for IPCEI Hy2 and EuBatIn funding.',
    color: 'from-cyan-500/10 to-sky-500/5',
    badge: 'ATEX · EN 60079 · IPCEI',
  },
  {
    slug: 'oil-gas',
    name: 'Oil, gas & refining',
    tagline: 'ATEX Zone 1/2, fuel QC, turnaround at the existing plant',
    desc: 'Lab containers for refineries, tank farms, pipelines and LNG. ATEX at the site fence, DIN EN 228/590 and ASTM, H₂S/VOC protection, AwSV bunding, ISO 17025-capable fuel QC. Hire laboratories for turnaround without hall conversion.',
    color: 'from-stone-500/10 to-amber-700/5',
    badge: 'ATEX · AwSV · DIN EN 228/590',
  },
];
---
<Layout title={title} description={description} canonical={canonical} schema={collectionSchema}>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

  <div class="bg-white">
    <section class="bg-gradient-to-br from-slate-900 via-slate-800 to-slate-900 text-white pt-20 pb-16 md:pb-20">
      <div class="container mx-auto px-4">
        <div class="max-w-4xl">
          <div class="text-primary font-medium text-sm uppercase tracking-wider mb-4">Industry solutions, DACH</div>
          <h1 class="text-4xl md:text-5xl lg:text-6xl font-heading font-bold mb-6 leading-tight">
            Lab containers for every industry – engineering, standards, authority pack
          </h1>
          <p class="text-xl text-gray-300 leading-relaxed mb-4">Pharma knows Annex 1, research knows DFG, industry knows ISO 17025, education knows RiSU, public health knows IfSG, the energy transition knows ATEX, and refining knows AwSV and turnaround. Each sector has its own duties – we supply the correct container configuration for each, with the matching documentation.</p>
          <p class="text-base text-gray-400">Seven industries, one factory. From Albstadt for Germany, Switzerland and Austria.</p>
        </div>
      </div>
    </section>

    <Breadcrumbs bar items={[{ name: 'Home', href: '/en' }, { name: 'Industries' }]} />

    <section class="py-16 md:py-20">
      <div class="container mx-auto px-4">
        <div class="max-w-6xl mx-auto">
          <div class="grid md:grid-cols-2 gap-6">
            {branchen.map(b => (
              <a href={`/en/industries/${b.slug}`} class={`block bg-gradient-to-br ${b.color} border border-gray-200 rounded-2xl p-7 hover:shadow-xl hover:border-primary/40 transition-all group`}>
                <div class="text-xs uppercase tracking-wider text-[#7a9900] font-bold mb-2">{b.badge}</div>
                <h2 class="text-2xl md:text-3xl font-heading font-bold text-slate-900 mb-2 group-hover:text-[#7a9900]">{b.name}</h2>
                <p class="text-sm text-slate-700 font-semibold mb-3">{b.tagline}</p>
                <p class="text-gray-700 text-sm leading-relaxed mb-4">{b.desc}</p>
                <div class="inline-flex items-center gap-2 text-[#7a9900] font-bold text-sm">View industry page
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
                </div>
              </a>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section class="py-16 md:py-20 bg-slate-50">
      <div class="container mx-auto px-4">
        <div class="max-w-5xl mx-auto">
          <h2 class="text-3xl md:text-4xl font-heading font-bold mb-6 text-slate-900 text-center">Why Planexus for every industry</h2>
          <p class="text-lg text-gray-700 leading-relaxed mb-10 text-center">A generalist builds a little of everything. A specialist builds each industry correctly. Our factory in Albstadt manufactures lab containers exclusively – not office containers or sanitary modules on the side. Our managing directors bring more than ten years of lab-container construction experience. That is what makes the difference at inspection.</p>
          <div class="grid md:grid-cols-3 gap-6">
            <div class="bg-white rounded-xl p-6 border border-gray-100">
              <div class="text-3xl font-bold text-primary mb-1">10+</div>
              <div class="font-bold text-slate-900 mb-2">Years of leadership experience</div>
              <p class="text-sm text-gray-700">Focus exclusively on laboratory and cleanroom containers – no generalist dilution.</p>
            </div>
            <div class="bg-white rounded-xl p-6 border border-gray-100">
              <div class="text-3xl font-bold text-primary mb-1">DACH</div>
              <div class="font-bold text-slate-900 mb-2">DE / CH / AT in one hand</div>
              <p class="text-sm text-gray-700">We know LBO/MBO, SIA, OIB and ÖNORM, and we deliver including customs clearance where required.</p>
            </div>
            <div class="bg-white rounded-xl p-6 border border-gray-100">
              <div class="text-3xl font-bold text-primary mb-1">100 %</div>
              <div class="font-bold text-slate-900 mb-2">Documentation standard</div>
              <p class="text-sm text-gray-700">Industry-standard documentation pack from the factory – no rework at the installation site.</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <AuthorBio  locale="en" />

    <section class="py-16 md:py-20 bg-white">
      <div class="container mx-auto px-4">
        <div class="max-w-3xl mx-auto">
          <div class="text-center mb-10">
            <h2 class="text-3xl md:text-4xl font-heading font-bold mb-4 text-slate-900">A container concept for your industry</h2>
            <p class="text-gray-700 text-lg">Outline your industry, application and the classification you need. We reply within one working day with a sector-specific concept proposal.</p>
          </div>
          <ContactForm client:visible locale="en" />
        </div>
      </div>
    </section>
  </div>
</Layout>
