---
import Layout from '../../../layouts/Layout.astro';
import ContactForm from '../../../components/ContactForm.tsx';
import Picture from '../../../components/Picture.astro';
import AuthorBio from '../../../components/AuthorBio.astro';
import BranchenCrossLinks from '../../../components/BranchenCrossLinks.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';

const title = "Lab containers for education – school laboratories, vocational schools, RiSU";
const description = "Lab containers for education: RiSU-compliant school and vocational laboratories, BTA/CTA practicals, GefStoffV-safe. Interim laboratory during refurbishment. Request a quotation.";
const canonical = "/en/industries/education";
const ogImage = "/attached_assets/generated_images/high-tech_lab_interior.png";

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "serviceType": "Lab containers for education, schools and vocational colleges",
  "provider": { "@type": "Organization", "name": "Planexus GmbH", "image": "https://planexus.de/android-chrome-512x512.png", "url": "https://planexus.de", "telephone": "+49 7435 7519 700", "email": "info@planexus.de", "address": { "@type": "PostalAddress", "streetAddress": "Am Steinbach 8", "addressLocality": "Albstadt-Laufen", "addressRegion": "Baden-Württemberg", "postalCode": "72459", "addressCountry": "DE" }, "parentOrganization": { "@type": "Organization", "name": "Wesemann Holding GmbH" } },
  "areaServed": [{ "@type": "Country", "name": "Germany" }, { "@type": "Country", "name": "Switzerland" }, { "@type": "Country", "name": "Austria" }],
  "audience": { "@type": "BusinessAudience", "audienceType": "School authorities, vocational schools, universities of applied sciences, BTA/CTA/MTA schools, STEM-promoting schools, school-building authorities" },
  "description": "GefStoffV-compliant school laboratory containers to the KMK RiSU recommendation, interim laboratories during GEG/fire-protection refurbishment, BTA/CTA/MTA training laboratories, STEM teaching laboratories with DGUV V3 and emergency infrastructure."
};
const breadcrumbSchema = { "@context": "https://schema.org", "@type": "BreadcrumbList", "itemListElement": [
  { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://planexus.de/en" },
  { "@type": "ListItem", "position": 2, "name": "Industries", "item": "https://planexus.de/en/industries" },
  { "@type": "ListItem", "position": 3, "name": "Education", "item": "https://planexus.de/en/industries/education" }
]};
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    { "@type": "Question", "name": "What is RiSU and why is it mandatory for school containers?", "acceptedAnswer": { "@type": "Answer", "text": "RiSU – the Guideline on Safety in Teaching – is a recommendation of the Standing Conference of the Ministers of Education and Cultural Affairs (KMK) in the 2019 edition, which is treated as the school-law benchmark in virtually all German Länder. It covers, among other things: hazardous substances in schools (substance lists with prohibition, restriction and permission lists), safety equipment (emergency shower, eyewash, first aid), ventilation (minimum air-change rate), fume cupboards to DIN EN 14175, fire and explosion protection, personal protective equipment. School containers must be RiSU-compliant, otherwise the school authority will refuse commissioning. We supply school containers as standard RiSU-compliant with a documentation pack – including substance-list conformity, ventilation evidence to RiSU §3.6, emergency infrastructure to DGUV Information 213-850 and a fire-protection report to LBO + RiSU §3.13. The Swiss counterpart is EKAS Guideline 6512; in Austria it is BGBl. II 368/1998 as amended." } },
    { "@type": "Question", "name": "We are refurbishing our school building under the GEG – will chemistry teaching come to a halt?", "acceptedAnswer": { "@type": "Answer", "text": "No, not if you plan in time. A GEG refurbishment (Buildings Energy Act, status 2024) typically involves 12–24 months of construction – façade insulation, window replacement, heating modernisation. Asbestos or fire-protection works often come on top. Chemistry, biology and physics teaching must not stop in the meantime, otherwise the curriculum suffers and final-year cohorts cannot complete practicals. Solution: an interim container laboratory in the school yard. We supply 2–4 classroom modules with fume cupboards, emergency shower, safety cabinet, teacher preparation and pupil cloakroom in 8–12 weeks. Hire term 12–36 months, dismantling included, building application as a “temporary structure” under the LBO – that accelerates authority approval dramatically." } },
    { "@type": "Question", "name": "What requirements apply to BTA/CTA/MTA training laboratories?", "acceptedAnswer": { "@type": "Answer", "text": "Vocational colleges for biological, chemical and medical-technical assistants (BTA/CTA/MTA) need practical laboratories that realistically reflect later professional work – that is, a Class II microbiological safety cabinet to DIN EN 12469 for microbiology practicals, chemical fume cupboards to DIN EN 14175 for synthesis, analytical instruments (photometer, titrator, microscope, centrifuge) for quantitative practicals, GMP-compliant sampling stations for clinical routine. The training and examination ordinances (BTA-PrüfO, CTA-PrüfO of the respective Land, the MTA Reform Act of 24 February 2021 for Germany) require practical hours in a suitable environment – DAkkS or the school supervisory authority (Schulamt, Bezirksregierung) checks suitability. We build BTA/CTA/MTA containers that pass this inspection." } },
    { "@type": "Question", "name": "What does insurance look like for school containers?", "acceptedAnswer": { "@type": "Answer", "text": "School containers are treated for insurance like school buildings. The school authority’s contents insurance typically also covers containers provided they are registered in the property insurance as hired goods – that is done with a one-line notification to the insurer. The container shell (the container itself) is insured under our hire contract: all-risks cover for the container and permanently installed plant, liability for property and personal injury arising from container operation. The school authority brings the pupil and teacher contents insurance. For sports equipment, microscopes and valuables in the container school the normal school contents policy applies. Clarification is needed at most for use of the container space by clubs outside school hours – the hire agreement addresses this explicitly." } },
    { "@type": "Question", "name": "What minimum size should a school teaching laboratory in a container have?", "acceptedAnswer": { "@type": "Answer", "text": "Recommendation of RiSU §3.5 and DGUV Information 202-058 (Safe School – Science Teaching): at least 2.5 m² net area per pupil workstation, plus teacher demonstration bench, plus circulation, plus a preparation room. A class of 24 pupils therefore needs a net 60 m² teaching laboratory + 15–20 m² preparation room + 5–10 m² store for chemicals and equipment. That fits in 3–4 coupled container modules of 25–30 m² each. We supply modular school containers in exactly this size range. For demonstration-only laboratories (no pupil practicals) smaller modules suffice. For vocational schools with machine practicals (BTA/CTA reactor piloting) we plan larger." } },
    { "@type": "Question", "name": "Can we keep using the school containers after the refurbishment ends?", "acceptedAnswer": { "@type": "Answer", "text": "Yes, that is a frequent application. After successful container operation, school authorities often opt for a permanent take-over – as an extension laboratory beside the refurbished stock, or as an “outstation” for STEM electives and differentiation courses. We offer three models: (1) hire extension of 24/36/60 months, (2) hire purchase with offset of hire already paid, (3) purchase at residual value after a book valuation. Variant 2 is often treated as an operating lease for municipal school authorities and therefore relieves the capital budget. Extending the building permit from “temporary” to “permanent” runs under LBO §§ 65/66, usually in a shortened procedure because the container is already in place and running without complaint." } },
    { "@type": "Question", "name": "How are school containers protected against vandalism and burglary?", "acceptedAnswer": { "@type": "Answer", "text": "Standard school containers have burglar-resistant RC2 doors to DIN EN 1627, barred windows RC2 or with burglar-resistant laminated glazing P4A, motion detectors and a link to the school alarm system or security firm. Municipal property insurance typically requires at least RC2 for school rooms with valuables (microscopes, notebooks). For sites with elevated vandalism risk (high-need schools, open areas with overnight presence) we supply RC3 doors, coated laminated glass P5A, exterior lights with motion detectors and video surveillance with GDPR-compliant recording. About €2,000–4,000 extra per container – economical, because a single break-in exceeds the extra cost by a factor of 5–10." } }
  ]
};
const articleSchema = {"@context": "https://schema.org", "@type": "Article", "headline": "Lab containers for education & schools – RiSU, GUV-SR 2003", "description": "School and education lab containers for chemistry, biology and physics. RiSU-compliant, DGUV 202-058, BTA/CTA practicals, STEM modules for 12–36 months.", "image": "https://planexus.de/opengraph.jpg", "datePublished": "2026-05-02", "dateModified": "2026-05-02", "author": {"@type": "Person", "name": "Sven Biewald", "jobTitle": "Managing Director, Planexus GmbH", "url": "https://planexus.de/en/team"}, "publisher": {"@type": "Organization", "name": "Planexus GmbH", "logo": {"@type": "ImageObject", "url": "https://planexus.de/android-chrome-512x512.png"}}, "mainEntityOfPage": {"@type": "WebPage", "@id": "https://planexus.de/en/industries/education"}, "about": "School and education lab containers", "inLanguage": "en"};
---
<Layout title={title} description={description} canonical={canonical} ogImage={ogImage} schema={serviceSchema}>
