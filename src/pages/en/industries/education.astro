        <Picture src="/attached_assets/generated_images/high-tech_lab_interior.png" alt="School laboratory containers for education – RiSU-compliant for vocational schools and grammar schools" class="w-full h-full object-cover opacity-25" loading="eager" fetchpriority="high" width={1024} height={1024} />
        <div class="absolute inset-0 bg-gradient-to-r from-slate-900 via-slate-900/95 to-slate-900/70"></div>
      </div>
