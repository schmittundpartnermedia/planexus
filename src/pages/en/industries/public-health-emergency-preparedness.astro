---
import Layout from '../../../layouts/Layout.astro';
import ContactForm from '../../../components/ContactForm.tsx';
import Picture from '../../../components/Picture.astro';
import AuthorBio from '../../../components/AuthorBio.astro';
import BranchenCrossLinks from '../../../components/BranchenCrossLinks.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';

const title = "Lab containers for public health – BSL-3, emergency preparedness";
const description = "Lab containers for public health: BSL-3, CBRN reconnaissance, pandemic diagnostics, BBK-capable. Operational nationwide in 72 h. Request a complimentary consultation.";
const canonical = "/en/industries/public-health-emergency-preparedness";
const ogImage = "/attached_assets/generated_images/high-tech_lab_interior.png";

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "serviceType": "Lab containers for public health and emergency preparedness",
  "provider": { "@type": "Organization", "name": "Planexus GmbH", "image": "https://planexus.de/android-chrome-512x512.png", "url": "https://planexus.de", "telephone": "+49 7435 7519 700", "email": "info@planexus.de", "address": { "@type": "PostalAddress", "streetAddress": "Am Steinbach 8", "addressLocality": "Albstadt-Laufen", "addressRegion": "Baden-Württemberg", "postalCode": "72459", "addressCountry": "DE" }, "parentOrganization": { "@type": "Organization", "name": "Wesemann Holding GmbH" } },
  "areaServed": [{ "@type": "Country", "name": "Germany" }, { "@type": "Country", "name": "Switzerland" }, { "@type": "Country", "name": "Austria" }],
  "audience": { "@type": "BusinessAudience", "audienceType": "FOPH (BAG), AGES, public health offices, BBK, ZSKG, THW, Bundeswehr medical service, civil protection, Federal Police, district administrations" },
  "description": "Pandemic- and CBRN-capable, BSL-3 diagnostics in a container, IfSG-compliant, BBK situation centres, ZSKG stockpiling, mobile diagnostics outstations of the public health service, rapidly relocatable by lorry or helicopter lifting frame."
};
const breadcrumbSchema = { "@context": "https://schema.org", "@type": "BreadcrumbList", "itemListElement": [
  { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://planexus.de/en" },
  { "@type": "ListItem", "position": 2, "name": "Industries", "item": "https://planexus.de/en/industries" },
  { "@type": "ListItem", "position": 3, "name": "Public health & emergency preparedness", "item": "https://planexus.de/en/industries/public-health-emergency-preparedness" }
]};
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    { "@type": "Question", "name": "What is a CBRN container and who needs it?", "acceptedAnswer": { "@type": "Answer", "text": "CBRN stands for chemical, biological, radiological and nuclear. A CBRN container is a relocatable laboratory or decontamination module for incidents involving potentially hazardous substances. Clients: Bundeswehr medical service (rapid medical deployment forces, SMEK), THW (CBRN components of specialist units), BBK (Federal Office of Civil Protection and Disaster Assistance for situation centres), Land authorities (police specialist units, fire brigades with NBC reconnaissance), the public health service for field deployments during outbreaks, international aid organisations for crisis regions. We build CBRN containers with positive- and negative-pressure options, HEPA/activated-carbon filtration, airlocks, decontamination shower, dose-rate measuring stations and autonomous emergency power for 24–72 hours." } },
    { "@type": "Question", "name": "How quickly is a diagnostics container operational in a pandemic?", "acceptedAnswer": { "@type": "Answer", "text": "The decisive factor is the degree of stockpiling. At our Albstadt factory we hold a defined number of pandemic-capable BSL-2/BSL-3 diagnostics container modules that can be relocated nationwide within 48–72 hours of a request via special transport. This stockpiling is secured by framework agreements with authorities (BBK, Land health authorities). In an acute deployment: 4 hours on-site assembly and connection to an external generator, a further 8–12 hours of function testing and instrument calibration, then full diagnostic operation. With container stockpiling the competent public health office can add PCR capacity of 1,000–3,000 tests/day in under 96 hours – that is a game-changer in a pandemic." } },
    { "@type": "Question", "name": "What does IfSG say about container diagnostics?", "acceptedAnswer": { "@type": "Answer", "text": "The German Infection Protection Act (IfSG, last amended 2023) regulates, among other things, reporting duties for notifiable infectious diseases (§§ 6, 7), investigations by public health offices (§ 25) and official orders for diagnostics (§§ 29–31). The diagnostics themselves must follow good laboratory medical practice – that requires a suitable laboratory environment to RiliBÄK (Guideline of the German Medical Association on quality assurance of laboratory medical investigations) and, for virological diagnostics, typically BSL-2 with a Class II microbiological safety cabinet. Container laboratories meet RiliBÄK + BSL-2 as standard. For risk group 3 pathogens (for example SARS-CoV-2, MERS-CoV, BTV) BSL-3 is required – we supply that too. Connection to the electronic reporting system DEMIS for notification data is possible via standard interfaces." } },
    { "@type": "Question", "name": "How does ZSKG stockpiling of container modules work?", "acceptedAnswer": { "@type": "Answer", "text": "The Civil Protection and Disaster Assistance Act (ZSKG) regulates the division of tasks between Federation and Länder in major incidents. The Federation (BBK, THW) stockpiles nationally relocatable assets; the Länder add regional components. For container laboratories that means: a framework agreement with BBK or a Land civil-protection body for a defined number of stockpiled modules at a certified manufacturer (Planexus meets the ZSKG requirements). We hold the modules ready under climate-controlled conditions, carry out annual maintenance (DGUV V3, instrument calibration, filter change), and can transport them to a site named by the client within 24–72 hours. The modules remain the client’s property; stockpiling logistics sit with us." } },
    { "@type": "Question", "name": "What mobility do pandemic and CBRN containers have?", "acceptedAnswer": { "@type": "Answer", "text": "20-foot containers (6.06 m × 2.44 m × 2.59 m) are directly sealift-, airlift- and lorry-capable. A standard articulated lorry moves a 20-foot module nationwide in 24–48 hours. 40-foot containers (12.19 m × 2.44 m × 2.59 m) need heavy-goods lorries and possibly a special permit in inner cities. For helicopter relocation (for example inaccessible terrain, islands) we supply containers with ISO-certified lifting frames for CH-53 (Bundeswehr), CH-47 Chinook (Federal Police) or NH-90 SAR. Rail container wagons are also possible (DB Cargo standard). Installation is on a prepared surface (gravel bed with point bearings or an existing asphalt/concrete plateau) – we supply the siting specification as an annex." } },
    { "@type": "Question", "name": "What equipment belongs in a mobile diagnostics container?", "acceptedAnswer": { "@type": "Answer", "text": "Standard pandemic module (focus PCR diagnostics): sampling airlock with hand-disinfectant dispenser, sample-receipt bench with RFID sample identification, processing with a Class II microbiological safety cabinet to DIN EN 12469, automatic nucleic-acid extractor (connection preparation for common models), PCR cycler (connection preparation), reporting workstation with link to the DEMIS reporting system, autoclave for waste inactivation, hazardous-substance cabinet, emergency shower, eyewash, fridge and freezer for reagents, 30 min UPS with subsequent changeover to an external generator. Optional: BSL-3 engineering with negative-pressure cascade for risk group 3 pathogens (SARS-CoV family, smallpox, viral haemorrhagic fevers)." } },
    { "@type": "Question", "name": "Are the containers GDPR-compliant for patient data?", "acceptedAnswer": { "@type": "Answer", "text": "Yes. The GDPR and the Federal Data Protection Act (BDSG) apply to any processing of personal patient data – independently of the building. We supply containers with the data-protection-relevant measures: physical access restriction with key management or electronic access control, a separate server cabinet with media encryption to BSI standard, privacy screens at reporting workstations, closed file and sample destruction to DIN 66399 protection class 3, unbroken audit-trail recording. The DPIA (data-protection impact assessment) is prepared by the client as controller – we supply the technical data sheets as input documentation." } }
  ]
};
const articleSchema = {"@context": "https://schema.org", "@type": "Article", "headline": "Lab containers for public health & emergency preparedness – BSL-3, CBRN", "description": "Mobile public-health lab containers for health authorities and civil protection. CBRN protection, mobile BSL-3, pandemic diagnostics, flood drinking-water analytics.", "image": "https://planexus.de/opengraph.jpg", "datePublished": "2026-05-02", "dateModified": "2026-05-02", "author": {"@type": "Person", "name": "Sven Biewald", "jobTitle": "Managing Director, Planexus GmbH", "url": "https://planexus.de/en/team"}, "publisher": {"@type": "Organization", "name": "Planexus GmbH", "logo": {"@type": "ImageObject", "url": "https://planexus.de/android-chrome-512x512.png"}}, "mainEntityOfPage": {"@type": "WebPage", "@id": "https://planexus.de/en/industries/public-health-emergency-preparedness"}, "about": "Public-health and crisis-response lab containers", "inLanguage": "en"};
---
<Layout title={title} description={description} canonical={canonical} ogImage={ogImage} schema={serviceSchema}>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
  <div class="bg-white">
    <section class="relative bg-slate-900 text-white overflow-hidden pt-20">
      <div class="absolute inset-0 z-0">
        <Picture src="/attached_assets/generated_images/high-tech_lab_interior.png" alt="Mobile diagnostics container for public health emergency preparedness – BSL-3 BBK CBRN" class="w-full h-full object-cover opacity-25" loading="eager" fetchpriority="high" width={1024} height={1024} />
        <div class="absolute inset-0 bg-gradient-to-r from-slate-900 via-slate-900/95 to-slate-900/70"></div>
      </div>
      <div class="relative z-10 container mx-auto px-4 py-16 md:py-24">
        <div class="max-w-4xl">
          <div class="text-primary font-medium text-sm uppercase tracking-wider mb-4">Industry · BBK · ZSKG · THW · Bundeswehr · Public health offices · Civil protection</div>
          <h1 class="text-4xl md:text-5xl lg:text-6xl font-heading font-bold mb-6 leading-tight">Lab containers for public health – BSL-3, emergency preparedness, diagnostics</h1>
          <p class="text-xl text-gray-300 leading-relaxed mb-4"><strong class="text-white">BSL-2/BSL-3 pandemic diagnostics under IfSG and RiliBÄK, CBRN modules for NBC incidents, ZSKG stockpiling with annual maintenance, helicopter lifting frames for CH-53/CH-47/NH-90, DEMIS connection.</strong> When the situation escalates, speed is everything.</p>
          <p class="text-base text-gray-400 mb-8">Stockpiled at the Albstadt factory, operational within three days at the installation site.</p>
          <div class="flex flex-col sm:flex-row gap-4 mb-8">
            <a href="#anfrage" class="bg-primary text-slate-900 font-bold px-8 py-4 rounded-lg hover:bg-primary/90 transition-colors inline-flex items-center justify-center gap-2 shadow-[0_0_20px_rgba(132,189,0,0.3)]">Request an emergency-preparedness concept</a>
            <a href="tel:+4974357519700" class="border border-white/20 text-white font-medium px-8 py-4 rounded-lg hover:bg-white/10 transition-colors inline-flex items-center justify-center gap-2">+49 7435 7519 700</a>
          </div>
          <div class="flex flex-wrap items-center gap-x-6 gap-y-2 text-sm text-gray-400">
            <div>✓ IfSG- and RiliBÄK-compliant diagnostics</div>
            <div>✓ BSL-3 for risk group 3</div>
            <div>✓ CBRN modules with airlock + decon</div>
            <div>✓ ZSKG stockpiling + framework agreement</div>
          </div>
        </div>
      </div>
    </section>

    <AuthorBio  locale="en" />

    <section class="py-16 md:py-20 bg-gradient-to-br from-primary/5 via-white to-primary/10 border-y border-primary/20">
      <div class="container mx-auto px-4">
        <div class="max-w-5xl mx-auto">
          <div class="text-center mb-10">
            <div class="text-primary font-bold text-sm uppercase tracking-wider mb-3">When the situation escalates</div>
            <h2 class="text-3xl md:text-4xl font-heading font-bold mb-4 text-slate-900">Why public-health authorities and civil protection rely on stockpiled containers</h2>
            <p class="text-lg text-gray-700 leading-relaxed max-w-3xl mx-auto">SARS-CoV-2 showed that PCR capacity decides the course of a pandemic. CBRN incidents, flooding, earthquakes or power failure require diagnostics on site, not in the central clinic 200 km away. Stockpiled containers close that gap within hours.</p>
          </div>
          <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-4">
            <div class="bg-slate-900 text-white rounded-2xl p-6 text-center"><div class="text-4xl font-bold text-primary mb-1">72 h</div><div class="text-xs text-gray-400 uppercase tracking-wider">from call to diagnostics</div><div class="text-xs text-gray-500 mt-1">via stockpiling contract</div></div>
            <div class="bg-slate-900 text-white rounded-2xl p-6 text-center"><div class="text-4xl font-bold text-primary mb-1">3,000</div><div class="text-xs text-gray-400 uppercase tracking-wider">PCR tests/day per module</div><div class="text-xs text-gray-500 mt-1">depending on cycler type</div></div>
            <div class="bg-slate-900 text-white rounded-2xl p-6 text-center"><div class="text-4xl font-bold text-primary mb-1">CH-53</div><div class="text-xs text-gray-400 uppercase tracking-wider">Helicopter-capable</div><div class="text-xs text-gray-500 mt-1">ISO lifting frame optional</div></div>
            <div class="bg-slate-900 text-white rounded-2xl p-6 text-center"><div class="text-4xl font-bold text-primary mb-1">72 h</div><div class="text-xs text-gray-400 uppercase tracking-wider">Autonomous emergency operation</div><div class="text-xs text-gray-500 mt-1">Diesel generator + UPS</div></div>
          </div>
        </div>
      </div>
    </section>

    <section class="py-16 md:py-20 bg-slate-50">
      <div class="container mx-auto px-4">
        <div class="max-w-5xl mx-auto">
          <h2 class="text-3xl md:text-4xl font-heading font-bold mb-8 text-slate-900">Legal bases and authority frameworks</h2>
          <div class="overflow-x-auto">
            <table class="w-full text-sm border-collapse bg-white rounded-xl overflow-hidden shadow-sm">
              <thead class="bg-slate-900 text-white"><tr><th class="text-left p-4 font-bold">Act / standard</th><th class="text-left p-4 font-bold">Application</th><th class="text-left p-4 font-bold">Delivery</th></tr></thead>
              <tbody class="divide-y divide-gray-100">
                <tr><td class="p-4 font-semibold text-slate-900">IfSG</td><td class="p-4 text-gray-700">Infection protection, reporting duties</td><td class="p-4 text-gray-700">DEMIS connection prepared</td></tr>
                <tr><td class="p-4 font-semibold text-slate-900">RiliBÄK</td><td class="p-4 text-gray-700">Quality assurance in laboratory medicine</td><td class="p-4 text-gray-700">Compliant laboratory environment, QM-ready</td></tr>
                <tr><td class="p-4 font-semibold text-slate-900">ZSKG</td><td class="p-4 text-gray-700">Stockpiling, Federation–Land assistance</td><td class="p-4 text-gray-700">Framework agreement, annual maintenance</td></tr>
                <tr><td class="p-4 font-semibold text-slate-900">BBK concepts</td><td class="p-4 text-gray-700">Major incidents, mass-casualty events (MANV)</td><td class="p-4 text-gray-700">Situation-centre modules, MANV triage</td></tr>
                <tr><td class="p-4 font-semibold text-slate-900">TRBA 100 / 120 / 250</td><td class="p-4 text-gray-700">Containment levels 2/3, healthcare</td><td class="p-4 text-gray-700">Airlock, Class II cabinet, autoclave</td></tr>
                <tr><td class="p-4 font-semibold text-slate-900">DGUV V3</td><td class="p-4 text-gray-700">Electrical installations, mobile deployment</td><td class="p-4 text-gray-700">DGUV-compliant, annual inspection</td></tr>
                <tr><td class="p-4 font-semibold text-slate-900">GDPR + BDSG</td><td class="p-4 text-gray-700">Patient data</td><td class="p-4 text-gray-700">Encrypted server cabinet, audit trail</td></tr>
                <tr><td class="p-4 font-semibold text-slate-900">DIN 66399 protection class 3</td><td class="p-4 text-gray-700">File and media destruction</td><td class="p-4 text-gray-700">On-site shredder, unbroken documentation</td></tr>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </section>

    <section class="py-16 md:py-20">
      <div class="container mx-auto px-4">
        <div class="max-w-6xl mx-auto">
          <h2 class="text-3xl md:text-4xl font-heading font-bold mb-10 text-slate-900 text-center">Eight typical public-health and crisis containers</h2>
          <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-5">
            {[
              { title: 'Pandemic PCR module', desc: '1,000–3,000 tests/day, BSL-2 sample processing, automatic extractor, PCR cycler, DEMIS.' },
              { title: 'BSL-3 diagnostics', desc: 'Risk group 3 (SARS-CoV, smallpox, haemorrhagic fevers), negative-pressure cascade, HEPA H14.' },
              { title: 'CBRN reconnaissance', desc: 'Sampling + on-site analysis for NBC substances, dose-rate measurement, argon detector, airlock.' },
              { title: 'Mobile vaccination site', desc: 'History, information, vaccination, observation, emergency care – high throughput in a pandemic.' },
              { title: 'BBK situation centre', desc: 'Staff room with common operating picture wall, redundant communications BOS radio + satellite, 100 kVA emergency generator.' },
              { title: 'MANV triage', desc: 'Mass-casualty incident, triage airlock SK1–SK4, oxygen connection, ECG preparation.' },
              { title: 'Decontamination module', desc: 'Personnel and material decon to DIN 14555-9, wastewater holding tank, PPE airlock.' },
              { title: 'Mobile animal-disease laboratory', desc: 'BTV, avian influenza, ASF diagnostics on site, to veterinary-authority standard.' }
            ].map(item => (
              <div class="bg-slate-50 rounded-xl p-5 border-l-2 border-primary">
                <div class="font-bold text-slate-900 mb-2">{item.title}</div>
                <p class="text-sm text-gray-700 leading-relaxed">{item.desc}</p>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section class="py-16 md:py-20 bg-slate-900 text-white">
      <div class="container mx-auto px-4">
        <div class="max-w-5xl mx-auto">
          <h2 class="text-3xl md:text-4xl font-heading font-bold mb-10">Six engineering details for crisis containers</h2>
          <div class="grid md:grid-cols-2 gap-6">
            <div class="bg-slate-800 rounded-xl p-6"><div class="text-primary font-bold text-sm uppercase tracking-wider mb-2">1. Mobility</div><h3 class="text-xl font-bold mb-3">ISO 20 ft / 40 ft containers, sealift-capable</h3><p class="text-gray-300 text-sm">Standardised corner fittings to ISO 1161 for spreaders, lifting frames, twist-locks, rail container wagons, articulated lorries, helicopter underslung loads.</p></div>
            <div class="bg-slate-800 rounded-xl p-6"><div class="text-primary font-bold text-sm uppercase tracking-wider mb-2">2. Energy autonomy</div><h3 class="text-xl font-bold mb-3">UPS + 100 kVA diesel generator</h3><p class="text-gray-300 text-sm">30 min UPS without interruption, diesel emergency generator with 24–72 hour tank reserve, solar-hybrid option for long field deployments, V2G connection.</p></div>
            <div class="bg-slate-800 rounded-xl p-6"><div class="text-primary font-bold text-sm uppercase tracking-wider mb-2">3. BSL-3 pressure cascade</div><h3 class="text-xl font-bold mb-3">−25 / −50 Pa negative pressure</h3><p class="text-gray-300 text-sm">Airlock +5 Pa to the exterior, BSL-3 room −25 Pa to the airlock, autoclaved material/personnel airlock, HEPA H14 dual filtration with bag-in-bag-out.</p></div>
            <div class="bg-slate-800 rounded-xl p-6"><div class="text-primary font-bold text-sm uppercase tracking-wider mb-2">4. Communications</div><h3 class="text-xl font-bold mb-3">BOS radio + satellite + 5G</h3><p class="text-gray-300 text-sm">Digital BOS Tetra radio, satellite modem (Iridium/Inmarsat) for off-grid sites, 5G modem for regular situations, emergency telephone with landline backup.</p></div>
            <div class="bg-slate-800 rounded-xl p-6"><div class="text-primary font-bold text-sm uppercase tracking-wider mb-2">5. Data integrity</div><h3 class="text-xl font-bold mb-3">GDPR + BSI standard</h3><p class="text-gray-300 text-sm">Encrypted media, separate server cabinet, unbroken audit-trail recording, automatic backup to a secondary server, two-factor authentication.</p></div>
            <div class="bg-slate-800 rounded-xl p-6"><div class="text-primary font-bold text-sm uppercase tracking-wider mb-2">6. Logistics & supply</div><h3 class="text-xl font-bold mb-3">Sample flow optimised for high throughput</h3><p class="text-gray-300 text-sm">RFID sample identification, barcode scanners, automatic handover from sampling → processing → analytics → report, closed sample flow without cross-contamination.</p></div>
          </div>
        </div>
      </div>
    </section>

    <section class="py-16 md:py-20 bg-white">
      <div class="container mx-auto px-4">
        <div class="max-w-5xl mx-auto">
          <h2 class="text-3xl md:text-4xl font-heading font-bold mb-6 text-slate-900">Permits for BSL-3 containers: what you need to consider</h2>
          <p class="text-gray-700 leading-relaxed mb-4">BSL-3 containers for risk group 3 pathogens (SARS-CoV-2, MERS-CoV, viral haemorrhagic fevers, smallpox virus) require authorisation in Germany under BioStoffV § 15 in conjunction with TRBA 250. The competent body is the Land authority (public health office, Regierungspräsidium) with a technical opinion from the ZKBS secretariat at BVL Berlin. The application comprises: risk assessment to TRBA 250, technical description of the pressure cascade (airlock +5 Pa, BSL-3 room −25 Pa, −50 Pa to the exterior), HEPA H14 dual filtration in supply and extract with bag-in-bag-out, autoclaved material and personnel airlocks, emergency-power backup for ventilation of at least 60 minutes, annual filter integrity testing to ISO 14644-3.</p>
          <p class="text-gray-700 leading-relaxed mb-4">Processing time: 12–20 weeks in Germany, 16–24 weeks in Switzerland (ESV/FOPH), 10–16 weeks in Austria (GTG/BBG). Permit-procedure cost: €5,000–15,000 external advice plus authority fees €500–2,500. In Switzerland the FOPH (BAG) additionally requires an assessment under ESV Art. 22; in Austria BMSGPK checks under GTG § 6. Operation without a valid permit is unlawful – fines of up to €50,000 under IfSG § 73 are documented. The permit must be in place before sample receipt.</p>
          <p class="text-gray-700 leading-relaxed mb-8">Planexus supplies BSL-3 containers with complete authority documentation: ZKBS notification template, technical drawings of the pressure cascade, HEPA filter records, autoclave validation to EN 285, commissioning protocol and a training concept for staff to TRBA 250 annex. For pure BSL-2 pandemic diagnostics (PCR, risk group 2) notification under TRBA 100 is sufficient – processing 4–8 weeks. Authorities require an on-site acceptance by the public health office before release.</p>

          <h2 class="text-3xl md:text-4xl font-heading font-bold mb-6 text-slate-900">ZSKG stockpiling: contract structure, maintenance and relocation times</h2>
          <p class="text-gray-700 leading-relaxed mb-4">Under ZSKG § 10 the Federation (BBK) and the Länder stockpile relocatable assets for major incidents. For container laboratories the BBK situation-centre concept recommends stockpiling of at least one BSL-2 diagnostics module per 500,000 inhabitants. Framework-agreement structure: fixed price per module/year (stockpiling + maintenance), call-off within 72 hours, transport by Planexus or an appointed haulier, installation site named by the client. Annual maintenance duties: DGUV V3 electrical installations, instrument calibration (thermocycler, extractor), HEPA filter pre-check, function test of the 100 kVA emergency generator, activated-carbon filter change every 12 months.</p>
          <p class="text-gray-700 leading-relaxed mb-4">Relocation times from Albstadt: northern Germany (Hamburg, Berlin) 24–36 hours by lorry, southern Germany (Munich, Stuttgart) 12–18 hours, western Germany (Frankfurt, Düsseldorf) 8–12 hours, Switzerland (Basel, Zurich, Bern) 6–10 hours, Austria (Vienna, Graz, Linz) 8–14 hours. Special transport with police escort for overwidth (40 ft modules) adds 24–48 hours. CH-53 helicopter relocation: assembly at destination 4 hours, function testing 8–12 hours, full diagnostic operation 12–16 hours after landing.</p>
          <p class="text-gray-700 leading-relaxed mb-8">For public health offices and outstations of the public health service we recommend a site survey before the stockpiling contract: 63 A power connection, water connection, drainage, installation area at least 7 × 3 m per 20 ft module, access for an articulated lorry with turning space. Planexus documents this checklist as an annex to the framework agreement. Stockpiling costs typically sit at €8,000–15,000 per module per year including annual maintenance, DGUV V3 and filter service – well below the cost of a permanently hired interim laboratory in an urban location. PCR capacity of 1,000 tests/day needs a 20 ft module; 3,000 tests/day a 40 ft module or two coupled 20 ft units. Call-off is in writing by e-mail or BOS radio.</p>
          <p class="text-gray-700 leading-relaxed mb-8">For flood situations we supply drinking-water analytics modules to the Drinking Water Ordinance (TrinkwV) and UBA EmV: colony count, heavy metals, pesticides, cyanobacterial toxin. Installation time 48 hours, sampling airlocks under IfSG, result transmission to public health offices via the DEMIS interface. Modules are equipped with mobile sampling kits and a −20 °C cold chain and are prepared and ready for field deployments to the BBK situation-centre concept.</p>
        </div>
      </div>
    </section>

    <section class="py-16 md:py-20 bg-slate-50 border-t border-gray-100">
      <div class="container mx-auto px-4">
        <div class="max-w-5xl mx-auto">
          <h2 class="text-3xl md:text-4xl font-heading font-bold mb-8 text-slate-900">Planexus services for public health & emergency preparedness</h2>
          <div class="grid md:grid-cols-3 gap-6">
            <a href="/en/services/planning" class="bg-white rounded-xl p-6 border border-gray-100 hover:shadow-lg transition-shadow">
              <h3 class="font-bold text-slate-900 mb-2">Technical laboratory planning</h3>
              <p class="text-sm text-gray-700 leading-relaxed">BSL-2/3 engineering, pressure cascade, sample-flow optimisation for 1,000–3,000 PCR tests/day, DEMIS reporting interfaces.</p>
