---
import Layout from '../../layouts/Layout.astro';
import ContactForm from '../../components/ContactForm.tsx';
import AuthorBio from '../../components/AuthorBio.astro';
import CityCrossLinks from '../../components/CityCrossLinks.astro';

const title = "Lab containers Linz – cleanroom, GMP, industry";
const description = "Rent lab containers in Linz: BSL-3, ATEX, OIB/ÖNORM Z2 for steel, chemicals, university and hospital sites. EU single market, A1 direct from Albstadt. Request a quotation now.";
const canonical = "/en/lab-containers-linz";

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "serviceType": "Lab containers and modular laboratory construction Linz",
  "provider": {
    "@type": "Organization",
    "name": "Planexus GmbH",
    "image": "https://planexus.de/android-chrome-512x512.png",
    "url": "https://planexus.de",
    "telephone": "+49 7435 7519 700",
    "email": "info@planexus.de",
    "address": { "@type": "PostalAddress", "streetAddress": "Am Steinbach 8", "addressLocality": "Albstadt-Laufen", "addressRegion": "Baden-Württemberg", "postalCode": "72459", "addressCountry": "DE" },
    "parentOrganization": { "@type": "Organization", "name": "Wesemann Holding GmbH" }
  },
  "areaServed": [
    { "@type": "City", "name": "Linz" },
    { "@type": "AdministrativeArea", "name": "Upper Austria" },
    { "@type": "Country", "name": "Austria" }
  ],
  "description": "Container laboratories, mobile laboratories and modular laboratory buildings for the steel and chemical industry, Chemiepark Linz, universities, hospitals and the Upper Austria mechatronics cluster — from the Albstadt works, EU single-market compliant, to Linz via the A8 + A1 direct without tunnel extra toll.",
  "offers": { "@type": "AggregateOffer", "priceCurrency": "EUR", "availability": "https://schema.org/InStock" }
};

const localBusinessSchema = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "name": "Planexus GmbH – Lab containers Linz",
      "image": "https://planexus.de/images/labtogo-industrie.webp",
  "url": "https://planexus.de/en/lab-containers-linz",
  "telephone": "+49 7435 7519 700",
  "email": "info@planexus.de",
  "address": { "@type": "PostalAddress", "streetAddress": "Am Steinbach 8", "addressLocality": "Albstadt-Laufen", "addressRegion": "Baden-Württemberg", "postalCode": "72459", "addressCountry": "DE" },
  "areaServed": { "@type": "City", "name": "Linz", "containedInPlace": { "@type": "Country", "name": "Austria" } },
  "priceRange": "EUR",
  "openingHoursSpecification": [{ "@type": "OpeningHoursSpecification", "dayOfWeek": ["Monday","Tuesday","Wednesday","Thursday","Friday"], "opens": "08:00", "closes": "17:00" }]
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://planexus.de/en" },
    { "@type": "ListItem", "position": 2, "name": "Locations", "item": "https://planexus.de/en/lab-containers" },
    { "@type": "ListItem", "position": 3, "name": "Lab containers Linz", "item": "https://planexus.de/en/lab-containers-linz" }
  ]
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "How long does it take to deliver a lab container from the Albstadt works to Linz?",
      "acceptedAnswer": { "@type": "Answer", "text": "The heavy-haulage route from the Albstadt works to Linz runs north-east on the A81 to Stuttgart, then east on the A8 via Munich → Salzburg, Walserberg border crossing (DE/AT EU single market, no stop since Schengen), then east on the A1 directly to Linz — without the detour via the A9 Pyhrn and without extra-toll special tunnels. Driving time is around 5.5 hours over approximately 470 kilometres — the most direct route into Austria after Salzburg, markedly faster and cheaper on tolls than Graz or Vienna. Standard delivery points: the industrial works site in Linz-Pichling, the chemical and industrial sites on St. Peter-Str. and in Chemiepark Linz (Bauernstr.), the university sites at Altenberger Str. 69 in Auhof, and the hospital sites on Krankenhausstr. at Bulgariplatz. From order to operational handover in Linz takes 10 to 14 weeks." }
    },
    {
      "@type": "Question",
      "name": "Which permits do I need for a lab container in Linz?",
      "acceptedAnswer": { "@type": "Answer", "text": "In Linz the Oberösterreichische Bauordnung 1994 (OÖ BauO, Upper Austrian Building Code, Provincial Law Gazette 66/1994 as amended) and the OÖ Bautechnikgesetz (OÖ BauTG, Upper Austrian Building Technology Act, Provincial Law Gazette 67/1994 as amended) apply as Upper Austrian state law, supplemented by OIB Guidelines 1 to 6 of the Austrian Institute of Construction Engineering. The competent authority is Magistrat Linz Baurechtsamt (Linz Municipal Building Authority) at Hauptplatz 1-5, 4041 Linz. Containers are treated as buildings under § 24 OÖ BauO; a building notification or building permit is required in most cases. On industrial plots in Chemiepark Linz or at the industrial works site, works-management approval is additionally required. Temporary siting of under six months on industrial plots may, depending on the site, be possible under a simplified notification procedure. We review your site in advance and file procedure-ready building documents directly at Hauptplatz — including ÖNORM structural design with seismic zone Z2, OIB energy evidence and a fire-protection concept to OIB Guideline 2." }
    },
    {
      "@type": "Question",
      "name": "Which seismic requirements apply to lab containers in Linz under ÖNORM B 1998-1?",
      "acceptedAnswer": { "@type": "Answer", "text": "Under ÖNORM B 1998-1 (Eurocode 8 seismic), Linz lies in seismic zone Z2 with a horizontal design ground acceleration agR of around 0.4 to 0.8 m/s² — more moderate than Graz (Z3) or Vienna (Z2/Z3), but still structurally relevant. The Danube plain of Upper Austria is seismically quieter than Styria, but that does not allow simplification — every container for heavy industry, hospitals or universities needs a verified anchoring concept. Structurally that means: importance category II for industrial, chemical, university and hospital sites is mandatory; a capacity-designed overall system to ÖNORM B 1998-1 is not optional. We supply Linz with structural design to ÖNORM B 1998-1 with the Z2 factor and ÖNORM B 1991-1-3 snow load (Linz Zone 2–3, sk 1.4–2.0 kN/m² depending on altitude) and energetically to OIB Guideline 6 with U ≤ 0.20 W/m²K and heat recovery ≥ 75% — procedure-ready for the Baurechtsamt at Hauptplatz." }
    },
    {
      "@type": "Question",
      "name": "What is the Linz steel and chemicals cluster and which containers does it need?",
      "acceptedAnswer": { "@type": "Answer", "text": "Linz is Central Europe’s largest steel and chemicals cluster. Special-steel, rail and railway-system production with its own R&D site at the works is concentrated here, together with European polyolefin production focused on polypropylene and polyethylene. These industrial sites are integrated into Chemiepark Linz, which also comprises further speciality-chemicals locations. The cluster needs materials-testing containers to ÖNORM EN ISO 17025, corrosion laboratories, polymer-characterisation containers, high-temperature measurement containers and — for chemical piloting — ATEX containers to EN 60079 EX-II 2G/3G for flammable gases and vapours. We build all of this from the Albstadt works, procedure-ready for the industrial works site and Chemiepark Linz." }
    },
    {
      "@type": "Question",
      "name": "Which applications are particularly in demand in Linz?",
      "acceptedAnswer": { "@type": "Answer", "text": "Linz is a dual steel-chemicals and life-science cluster. Typical uses for lab containers arise around heavy industry (materials-testing, corrosion and high-temperature measurement containers to ÖNORM EN ISO 17025), the chemical industry (polymer-characterisation and ATEX pilot containers EN 60079), Chemiepark Linz (GMP and cleanroom containers ISO 14644 Class 7/8), the universities in Auhof (BSL-2 research and teaching containers for medicine, mechatronics and materials science), the university hospital on Krankenhausstr. (BSL-2 study containers during hospital refurbishment), and the Upper Austria mechatronics, plastics, automotive and cleantech clusters (each with piloting and test containers)." }
    },
    {
      "@type": "Question",
      "name": "How does delivery to Austria work? EU single market, A1 direct, GO-Box?",
      "acceptedAnswer": { "@type": "Answer", "text": "Germany and Austria are both EU member states and part of the single market — there is no customs clearance. We deliver from the Albstadt works as an intra-Community supply with an Austrian VAT identification number (ATU number) — tax-free in Germany, reverse charge in Austria. The price advantage versus Swiss locations is up to 8.1% (Swiss VAT falls away entirely). For heavy haulage the Austrian HGV toll (GO-Box, ASFINAG) is obligatory on all motorways and expressways. To Linz we take the A1 directly from Salzburg-Walserberg to Linz — without the detour via the A9 Pyhrn, without Bosruck or Gleinalm tunnel extra toll. That makes Linz the cheapest Austrian provincial-capital approach on tolls after Salzburg. Standard route: ~470 km, ~5.5 h heavy-haulage driving time. Junctions: Linz-Asten and Linz-Süd for the industrial works site and Chemiepark, Linz-Auhof for university and chemical sites, Linz-Mitte for the university hospital." }
    },
    {
      "@type": "Question",
      "name": "Can you supply ATEX, GMP and BSL containers for industry, chemicals, hospitals and universities?",
      "acceptedAnswer": { "@type": "Answer", "text": "Yes. We build four container lines in parallel for Linz. First: materials-testing containers for heavy industry to ÖNORM EN ISO 17025 with pressure testing, vibration, corrosion testing and high-temperature spectroscopy. Second: ATEX containers for chemical piloting in Chemiepark Linz (EX-II 2G T3/T4 to EN 60079) with explosion-protected electrics, gas sensing with automatic emergency shutdown, bursting discs and an inert-gas system. Third: GMP cleanroom containers for industrial biotech and speciality-chemicals piloting with BASG inspection readiness — ISO Class 8/7. Fourth: BSL-2/3 containers for clinical research (university hospital, medical faculty) — HEPA H14 dual filtration, autoclaved airlock, negative pressure with a three-stage cascade, emergency power. Notification under the Genetic Engineering Act (GTG) to BMSGPK Vienna Stubenring, opinion of the scientific commission. Structural design of all four lines to ÖNORM B 1998-1 (Z2) and ÖNORM B 1991, energy to OIB Guideline 6, fire protection to OIB Guideline 2, procedure-ready for the Baurechtsamt at Hauptplatz." }
    }
  ]
};
---

<Layout title={title} description={description} canonical={canonical}>
  <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(localBusinessSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <div class="bg-white">

    <!-- HERO -->
    <section class="relative bg-slate-900 text-white overflow-hidden">
      <div class="relative z-10 container mx-auto px-4 py-20 md:py-28">
        <div class="max-w-4xl">
          <nav class="flex items-center gap-2 text-sm text-gray-400 mb-8" aria-label="Breadcrumb">
            <a href="/en" class="hover:text-primary transition-colors">Home</a>
            <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m9 18 6-6-6-6"/></svg>
            <span>Locations</span>
            <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m9 18 6-6-6-6"/></svg>
            <span class="text-primary">Linz</span>
          </nav>

          <div class="text-primary font-medium text-sm uppercase tracking-wider mb-4">Your specialist for lab containers · Steel and chemicals capital + universities + hospitals</div>

          <h1 class="text-4xl md:text-5xl lg:text-6xl font-heading font-bold mb-6 leading-tight">
            Lab containers Linz – steel and chemical laboratories for the industrial region
          </h1>

          <p class="text-xl text-gray-300 leading-relaxed mb-4">
            <strong class="text-white">Our managing directors bring more than ten years of experience in lab-container construction.</strong> Modular, OIB-compliant, ÖNORM structural to seismic zone Z2. We deliver materials, polymer, hospital and research containers for the steel and chemical industry, Chemiepark Linz, universities, hospitals and the Upper Austria mechatronics cluster — from the Albstadt works directly to Linz, EU single-market compliant without customs clearance via the A8 + A1 direct without tunnel extra toll.
          </p>
          <p class="text-base text-gray-400 mb-8">While others are still planning, you are already testing and piloting.</p>

          <div class="flex flex-col sm:flex-row gap-4 mb-8">
            <a href="#anfrage" data-testid="button-cta-hero" class="bg-primary text-slate-900 font-bold px-8 py-4 rounded-lg hover:bg-primary/90 transition-colors inline-flex items-center justify-center gap-2 shadow-[0_0_20px_rgba(132,189,0,0.3)]">Complimentary Linz site audit<svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg></a>
            <a href="tel:+4974357519700" class="border border-white/20 text-white font-medium px-8 py-4 rounded-lg hover:bg-white/10 transition-colors inline-flex items-center justify-center gap-2"><svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>+49 7435 7519 700</a>
          </div>

          <div class="flex flex-wrap items-center gap-x-6 gap-y-2 text-sm text-gray-400">
            <div class="flex items-center gap-2"><svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6 9 17l-5-5"/></svg>Specialist in modular laboratory construction</div>
            <div class="flex items-center gap-2"><svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6 9 17l-5-5"/></svg>Award 2026 EU Business News</div>
            <div class="flex items-center gap-2"><svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6 9 17l-5-5"/></svg>EU single market: no customs, A1 direct</div>
            <div class="flex items-center gap-2"><svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6 9 17l-5-5"/></svg>Wesemann Group · 60+ years of laboratory construction</div>
          </div>
        </div>
      </div>
    </section>

    <AuthorBio city="Linz"  locale="en" />

    <!-- LABtoGO -->
    <section class="py-16 md:py-20 bg-gradient-to-br from-primary/5 via-white to-primary/10 border-y border-primary/20">
      <div class="container mx-auto px-4">
        <div class="max-w-5xl mx-auto">
          <div class="grid md:grid-cols-2 gap-10 items-center mb-10">
            <div>
              <div class="text-primary font-bold text-sm uppercase tracking-wider mb-3">Pattern interrupt · World premiere at analytica 2026</div>
              <h2 class="text-3xl md:text-4xl font-heading font-bold mb-4 text-slate-900">Planexus shows Linz what a lab container can really do in 2026</h2>
              <p class="text-lg text-gray-700 leading-relaxed mb-4">An ordinary lab container has 2,400 mm internal height. Working upright at a fume cupboard or under ATEX ventilation is a struggle.</p>
              <p class="text-lg text-slate-900 font-bold leading-relaxed mb-4">The Planexus LABtoGO has 2,750 mm internal height. 9.5 m external length. 3 m external width. A fully glazed front that brings genuine daylight into every industrial, chemical, university, hospital or Chemiepark research laboratory.</p>
              <p class="text-lg text-gray-700 leading-relaxed"><strong>An ordinary lab container fits entirely inside a LABtoGO.</strong> We configure it for Linz to ÖNORM B 1998-1 seismic zone Z2, OIB Guideline 6 energy stricter than the German GEG, EU single-market compliant without customs clearance from the Albstadt works via the A8 + A1 directly to Linz — without the detour via the A9 Pyhrn, without Bosruck or Gleinalm tunnel extra toll.</p>
            </div>
            <div class="grid grid-cols-2 gap-4">
              <div class="bg-slate-900 text-white rounded-2xl p-6 text-center"><div class="text-4xl font-bold text-primary mb-1">2,750</div><div class="text-xs text-gray-400 uppercase tracking-wider">mm internal height</div><div class="text-xs text-gray-500 mt-1">Standard: 2,400 mm</div></div>
              <div class="bg-slate-900 text-white rounded-2xl p-6 text-center"><div class="text-4xl font-bold text-primary mb-1">9,500</div><div class="text-xs text-gray-400 uppercase tracking-wider">mm external length</div><div class="text-xs text-gray-500 mt-1">3,000 mm width</div></div>
              <div class="bg-slate-900 text-white rounded-2xl p-6 text-center"><div class="text-4xl font-bold text-primary mb-1">ÖNORM Z2</div><div class="text-xs text-gray-400 uppercase tracking-wider">Seismic agR ~0.4–0.8</div><div class="text-xs text-gray-500 mt-1">moderate AT zone</div></div>
              <div class="bg-slate-900 text-white rounded-2xl p-6 text-center"><div class="text-4xl font-bold text-primary mb-1">470 km</div><div class="text-xs text-gray-400 uppercase tracking-wider">Works → Linz</div><div class="text-xs text-gray-500 mt-1">~5.5 h via A1 direct</div></div>
            </div>
          </div>
          <div class="text-center"><a href="/en/lab-containers/labtogo" class="inline-flex items-center gap-2 text-primary font-bold hover:underline">View the LABtoGO platform and all configurations<svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg></a></div>
        </div>
      </div>
    </section>

    <!-- PROBLEM-AGITATION -->
    <section class="py-16 md:py-20">
      <div class="container mx-auto px-4">
        <div class="max-w-5xl mx-auto">
          <h2 class="text-3xl md:text-4xl font-heading font-bold mb-10 text-slate-900">Planexus solves the three Linz bottlenecks at which steel, chemical and hospital containers regularly fail</h2>
          <div class="grid md:grid-cols-3 gap-6">
            <div class="bg-slate-50 border-l-4 border-primary rounded-xl p-6">
              <div class="text-slate-900 font-bold text-lg mb-2">Works dual permit underestimated</div>
              <p class="text-gray-700 text-sm leading-relaxed">Containers on the industrial works site, in Chemiepark Linz or at chemical sites need two permit paths in parallel: building notification at Magistrat Linz Hauptplatz AND internal works-management approval. Anyone who serves only one path is turned away by works security at the gate.</p>
              <p class="text-sm text-slate-900 font-semibold mt-3 pt-3 border-t border-gray-200">Planexus answer: both paths prepared in parallel from the works.</p>
            </div>
            <div class="bg-slate-50 border-l-4 border-primary rounded-xl p-6">
              <div class="text-slate-900 font-bold text-lg mb-2">Chemical ATEX path underspecified</div>
              <p class="text-gray-700 text-sm leading-relaxed">Chemical piloting in the Chemiepark requires ATEX containers EX-II 2G T3/T4 to EN 60079 with explosion-protected electrics, gas sensing with automatic emergency shutdown, bursting discs and an inert-gas system. Standard containers without accredited ATEX certification are not connected to the works network.</p>
              <p class="text-sm text-slate-900 font-semibold mt-3 pt-3 border-t border-gray-200">Planexus answer: ATEX EN 60079 from the works, accredited documentation.</p>
            </div>
            <div class="bg-slate-50 border-l-4 border-primary rounded-xl p-6">
              <div class="text-slate-900 font-bold text-lg mb-2">Hospital courtyard logistics</div>
              <p class="text-gray-700 text-sm leading-relaxed">The large Linz university hospital is densely occupied with 24/7 operation. Container installation on Krankenhausstr. requires a night or weekend mobile-crane slot and heavy-haulage access via the Bulgariplatz connection. Anyone who does not agree this in advance with the hospital building directorate loses a full day.</p>
              <p class="text-sm text-slate-900 font-semibold mt-3 pt-3 border-t border-gray-200">Planexus answer: hospital slot co-ordination before works dispatch.</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- STRATEGISCHE FUSION -->
    <section class="py-16 md:py-20 bg-slate-50">
      <div class="container mx-auto px-4">
        <div class="max-w-4xl mx-auto">
          <h2 class="text-3xl md:text-4xl font-heading font-bold mb-8 text-slate-900">Lab containers for Linz: what industry, chemicals, universities and hospitals demand of the engineering</h2>
          <div class="prose prose-lg max-w-none text-gray-700 space-y-6">
            <p><strong>Linz is the capital of Upper Austria and Central Europe’s largest steel and chemicals cluster.</strong> Special-steel, rail and railway-system production with its own R&D site directly at the works is concentrated here, together with European polyolefin production (polypropylene, polyethylene). Added to this is Chemiepark Linz with further speciality-chemicals sites. In Auhof lie the universities with strengths in medicine, mechatronics and materials science, complemented by centres for open innovation and cyber-physical systems. On Krankenhausstrasse sits the large Linz university hospital, one of Austria’s largest. Completing the picture are the Upper Austria mechatronics, plastics, automotive and cleantech clusters.</p>
            <p><strong>We know this market in detail.</strong> We know that Magistrat Linz Baurechtsamt at Hauptplatz 1-5, 4041 Linz, decides under the Upper Austrian Building Code 1994 (OÖ BauO, Provincial Law Gazette 66/1994 as amended) and the Upper Austrian Building Technology Act (OÖ BauTG) as well as OIB Guidelines 1–6. We know that ÖNORM B 1998-1 (EC8 seismic) defines zone Z2 for Linz with agR ~0.4–0.8 m/s² — more moderate than Graz or Vienna, but not to be neglected structurally. Importance category II for industrial, chemical, university and hospital sites is not optional. We know that containers on the industrial works site, in Chemiepark Linz or at chemical sites need internal works-management approval in addition to the building notification. We know that chemical-pilot containers must be ATEX-compliant to EN 60079 EX-II 2G/3G with explosion-protected electrics, gas sensing with automatic emergency shutdown, bursting discs and an inert-gas system. We know the logistics: Albstadt works → Linz means A81 → A8 Walserberg → A1 direct — 470 kilometres, 5.5 hours of heavy-haulage driving time. After Salzburg, Linz is the cheapest Austrian provincial-capital approach on tolls. These details are not in our quotation — they are the engineering and logistics foundation of every container that leaves our Albstadt works.</p>
            <p><strong>Made in Albstadt, EU single-market compliant without customs, turnkey in Linz.</strong> Final assembly and interior fit-out are carried out with Wesemann furniture in our own works — factory visits can be arranged from either side. Intra-Community supply with ATU reverse charge from the works. Standard delivery points: the industrial works site Pichling (via Linz-Asten/Linz-Süd), the chemical sites on St. Peter-Strasse, Chemiepark Linz (Bauernstrasse), the universities on Altenberger Strasse in Auhof (via Linz-Auhof), and the university hospital on Krankenhausstrasse at Bulgariplatz (via Linz-Mitte).</p>
            <p>Whether you need a <strong>mobile laboratory in Linz</strong> for a time-limited hospital refurbishment, a <strong>modular lab container in Linz</strong> for research expansion at the medical faculty, or an <strong>ATEX container laboratory in Linz</strong> with EN 60079 electrics for chemical piloting in the Chemiepark — we deliver all three answers from the same platform: the LABtoGO from our Albstadt works, with ÖNORM Z2 structural design, OIB energy evidence, GTG notification and ATEX certification documented from the factory.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- 6 ENGINEERING -->
    <section class="py-16 md:py-20">
      <div class="container mx-auto px-4">
        <div class="max-w-6xl mx-auto">
          <h2 class="text-3xl md:text-4xl font-heading font-bold mb-3 text-slate-900">Six engineering disciplines for Central Europe’s steel and chemicals capital</h2>
          <p class="text-gray-600 text-lg mb-10 max-w-3xl">Planexus builds lab containers for Linz that are aligned in every discipline with Upper Austrian realities and steel, chemical and hospital requirements — not generic, but standard- and site-specific.</p>
          <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-5">
            <div class="bg-slate-50 rounded-xl p-6 border border-gray-100"><div class="text-primary text-xs font-bold uppercase tracking-wider mb-2">ÖNORM B 1998-1 EC8</div><h3 class="font-bold text-slate-900 mb-2">Z2 + importance cat. II</h3><p class="text-sm text-gray-600">Linz Z2 with agR ~0.4–0.8 m/s² — more moderate than Graz or Vienna. Structural design with a capacity-designed anchoring concept to ÖNORM B 1991, importance category II for industrial, chemical, university and hospital sites.</p></div>
            <div class="bg-slate-50 rounded-xl p-6 border border-gray-100"><div class="text-primary text-xs font-bold uppercase tracking-wider mb-2">ATEX EN 60079</div><h3 class="font-bold text-slate-900 mb-2">EX-II 2G/3G + inert gas</h3><p class="text-sm text-gray-600">For chemical piloting in the Chemiepark: ATEX containers with explosion-protected electrics to EN 60079, gas sensing with automatic emergency shutdown, bursting discs, inert-gas system — accredited testing.</p></div>
