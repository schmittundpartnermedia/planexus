---
import Layout from '../../layouts/Layout.astro';
import { t } from '../../i18n/ui';

Astro.response.status = 404;
const copy = t('en');

const topLinks = [
  { href: '/en', label: 'Home' },
  { href: '/en/lab-containers', label: 'Lab containers' },
  { href: '/en/services', label: 'Services' },
  { href: '/en/industries', label: 'Industries' },
  { href: '/en/projects', label: 'Projects' },
  { href: '/en/magazine', label: 'Magazine' },
  { href: '/en/team', label: 'Team' },
  { href: '/en/about', label: 'About us' },
  { href: '/en/contact', label: 'Contact' },
  { href: '/en/lab-containers-berlin', label: 'Lab containers Berlin' },
  { href: '/en/lab-containers-munich', label: 'Lab containers Munich' },
  { href: '/en/lab-containers-hamburg', label: 'Lab containers Hamburg' },
];
---

<Layout
  title="Page not found"
  description="The requested page could not be found. Here are the most important pages of Planexus."
  robots="noindex, nofollow"
  canonical="/en/404"
>
  <div class="pt-20 min-h-screen bg-white flex items-center justify-center">
    <div class="container mx-auto px-4 py-16">
      <div class="max-w-2xl mx-auto text-center">
        <div class="text-8xl font-heading font-bold text-primary mb-4">404</div>
        <h1 class="text-3xl md:text-4xl font-heading font-bold text-slate-900 mb-4">
          {copy.notFound.title}
        </h1>
        <p class="text-gray-600 text-lg mb-8">
          {copy.notFound.description}
        </p>
        <a
          href="/en"
          class="inline-flex items-center gap-2 bg-primary text-slate-900 font-bold px-8 py-4 rounded-lg hover:bg-primary/90 transition-colors shadow-md shadow-primary/20"
          data-testid="link-home"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
          {copy.notFound.homeCta}
        </a>

        <div class="mt-12 pt-10 border-t border-gray-200">
          <h2 class="text-sm font-bold uppercase tracking-wider text-gray-500 mb-6">
            {copy.notFound.popular}
          </h2>
          <div class="grid grid-cols-2 sm:grid-cols-3 gap-3 text-left">
            {topLinks.map((link) => (
              <a
                href={link.href}
                class="flex items-center gap-2 px-4 py-3 rounded-lg border border-gray-200 text-slate-700 hover:border-primary hover:text-slate-900 hover:bg-primary/5 transition-colors text-sm font-medium"
                data-testid={`link-404-${link.href === '/en' ? 'home' : link.href.replace(/\//g, '')}`}
              >
                <span class="text-primary">→</span>
                {link.label}
              </a>
            ))}
          </div>
        </div>
      </div>
    </div>
  </div>
</Layout>
