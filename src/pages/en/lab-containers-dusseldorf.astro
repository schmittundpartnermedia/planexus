const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://planexus.de/en" },
    { "@type": "ListItem", "position": 2, "name": "Lab containers", "item": "https://planexus.de/en/lab-containers" },
    { "@type": "ListItem", "position": 3, "name": "Lab containers Düsseldorf", "item": "https://planexus.de/en/lab-containers-dusseldorf" }
  ]
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "How long does delivery of a lab container to Düsseldorf from the Albstadt works take?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "The heavy-goods route Albstadt works → Düsseldorf runs north on the A81, north on the A8/A5 via Karlsruhe, then the A3 from the Frankfurt interchange towards Cologne and the A57 or A46 into the Düsseldorf city area. Pure driving time is around 5.5 hours; with a permit-required heavy transport it is typically one transport day. Standard delivery points are the Düsseldorf-Hafen (A52), Düsseldorf-Wersten (A46) and Düsseldorf-Mörsenbroich (A52) junctions for Bilk, Holthausen, Hilden and Düsseldorf harbour. From order to operational handover in Düsseldorf takes 8 to 14 weeks."
      }
    },
    {
      "@type": "Question",
      "name": "What permits do I need for a lab container in Düsseldorf?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "The Building Code for the State of North Rhine-Westphalia (Bauordnung für das Land Nordrhein-Westfalen, BauO NRW 2018, synopsis 2024) is decisive. Under Section 62 BauO NRW, containers up to 75 m³ gross volume are procedure-exempt under certain conditions. For larger installations, BSL-3 or GMP pharma, the building notification to the Düsseldorf building-control office (Bauaufsichtsamt), Brinckmannstraße 5, applies. For genetic-engineering facilities S1/S2/S3 an additional notification under the Genetic Engineering Act to the Düsseldorf District Government (Bezirksregierung Düsseldorf) as the competent state authority is required. BSL-3 requires a permit under BioStoffV. We check the classification of your Düsseldorf site in advance and submit procedure-ready building documents."
      }
    },
    {
      "@type": "Question",
      "name": "Which corrosivity category applies to Düsseldorf under DIN EN ISO 12944-2?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Düsseldorf lies in the Rhenish lowlands with about 800 mm annual precipitation, around 75% mean humidity and a westerly exposure — but without salt aerosol from the sea. DIN EN ISO 12944-2 assigns the city area predominantly to corrosivity category C3 (moderate corrosivity, urban atmosphere with moderate SO₂ load); immediately near the harbour and at chemical-industry sites C4 may apply locally. Planexus supplies C3 protection as standard, and optional C4 with duplex coating for harbour and industrial sites."
      }
    },
    {
      "@type": "Question",
      "name": "How high must a lab container stand against flooding on the Düsseldorf Rhine?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "The Düsseldorf gauge sits at river kilometre 744.2, gauge zero +24.529 m NHN. The observation series goes back to 1816 — Germany’s longest gauge record. The highest flood since observations began was 1995 at 10.69 m on the gauge. Flood mark II sits at 8.80 m; navigation is suspended from 7.10 m. For siting in the Rhine floodplain (Hammer Deich, harbour, Niederkasseler Lände, Lörick) the Düsseldorf building-control office requires elevation above the local flood-protection line — we supply structurally checked pile foundations or steel-frame elevation with height adjustment to your Düsseldorf site."
      }
    },
    {
      "@type": "Question",
      "name": "Can you supply BSL-3 lab containers for a university hospital?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. A university hospital in Bilk typically operates large hospital areas with a central laboratory, microbiological diagnostics and university research institutes. We supply BSL-2 and BSL-3 containers to BioStoffV and TRBA 100 with a negative-pressure cascade of −50 Pa, HEPA H14 on supply and extract air, autoclaved airlock, decontamination shower and Class II biosafety cabinet. For siting on the hospital campus we prepare fire-protection concepts under the NRW Hospital Building Ordinance (KhBauVO NRW) and coordinate with the relevant hospital building office."
      }
    },
    {
      "@type": "Question",
      "name": "Which container specification fits consumer-goods chemistry in Holthausen or molecular diagnostics in Hilden?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "The consumer-goods and adhesives industry in Holthausen operates large factory sites with innovation centres for adhesive technology and personal care. Typical specifications here are GMP-compliant cleanrooms to EU Annex 1, ISO 14644 class 7 and ATEX-zoned solvent laboratories. Molecular diagnostics at the Hilden site works with BSL-2 diagnostic laboratories and cleanroom production of molecular reagents. We supply both specifications from the same LABtoGO platform."
      }
    },
    {
      "@type": "Question",
      "name": "Which funding programmes exist in NRW for laboratory infrastructure in the life-science sector?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "With more than 500 life-science companies, North Rhine-Westphalia is Germany’s most research-intensive federal state. Relevant clusters and networks include several statewide biotechnology and life-science clusters in the Rhineland. Research and pilot plants are eligible for funding via programmes such as progres.nrw, NRW innovation funding, or federal programmes such as ZIM and KMU-innovativ. Hired containers can run off-balance-sheet via operating leases — we advise on the accounting classification."
      }
    }
  ]
};
---

<Layout
