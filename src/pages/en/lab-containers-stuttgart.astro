---
import Layout from '../../layouts/Layout.astro';
import AuthorBio from '../../components/AuthorBio.astro';
import CityCrossLinks from '../../components/CityCrossLinks.astro';
import ContactForm from '../../components/ContactForm.tsx';
import Picture from '../../components/Picture.astro';

const stuttgartPLZ = [
  "70173","70174","70176","70178","70180","70182","70184","70186","70188","70190",
  "70191","70192","70193","70195","70197","70199","70327","70329","70372","70374",
  "70376","70378","70435","70437","70439","70469","70499","70563","70565","70567",
  "70569","70597","70599","70619","70629","70771","70794","71229","71254","71263",
  "71272","71277","71282","71287","71292","71299","71384"
];

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": "Lab containers Stuttgart – LABtoGO, BSL-2/3, GMP cleanroom and ATEX",
  "description": "Turnkey lab containers for Stuttgart and the Middle Neckar region. LABtoGO with 2,750 mm internal height, BSL-2/3, GMP cleanroom and ATEX configurations. Delivery in 1.5 hours via the A81 from the Albstadt works – only 80 km away. Awarded at the German CEO Excellence Awards 2026.",
  "provider": {
    "@type": "Organization",
    "name": "Planexus GmbH",
    "image": "https://planexus.de/android-chrome-512x512.png",
    "url": "https://planexus.de",
    "parentOrganization": { "@type": "Organization", "name": "Wesemann Holding GmbH" }
  },
  "serviceType": [
    "Lab containers Stuttgart",
    "Container laboratory Stuttgart",
    "Mobile laboratory Stuttgart",
    "BSL-2 container laboratory",
    "BSL-3 container laboratory",
    "GMP cleanroom laboratory",
    "ATEX container",
    "Modular laboratory construction",
    "Technical laboratory planning",
    "Laboratory equipment",
    "Smart Lab integration"
  ],
  "areaServed": [
    { "@type": "City", "name": "Stuttgart", "containedInPlace": { "@type": "State", "name": "Baden-Württemberg" } },
    { "@type": "State", "name": "Baden-Württemberg" },
    { "@type": "AdministrativeArea", "name": "Stuttgart region" },
    ...stuttgartPLZ.map(plz => ({ "@type": "PostalCodeSpecification", "postalCode": plz, "addressCountry": "DE" }))
  ],
  "url": "https://planexus.de/en/lab-containers-stuttgart"
};

const localBusinessSchema = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "@id": "https://planexus.de/en/lab-containers-stuttgart#business",
  "name": "Planexus GmbH – Lab containers Stuttgart",
  "description": "Specialist planner for container laboratories. Your specialist for lab containers and modular laboratory solutions in Stuttgart and Baden-Württemberg. LABtoGO, BSL-2/3, GMP cleanroom, ATEX. Albstadt works – 80 km from the Stuttgart interchange.",
  "url": "https://planexus.de/en/lab-containers-stuttgart",
  "telephone": "+49 7435 7519 700",
  "email": "info@planexus.de",
  "image": "https://planexus.de/images/labtogo-industrie.webp",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "Am Steinbach 8",
    "addressLocality": "Albstadt-Laufen",
    "postalCode": "72459",
    "addressRegion": "Baden-Württemberg",
    "addressCountry": "DE"
  },
  "areaServed": {
    "@type": "City",
    "name": "Stuttgart",
    "containedInPlace": [
      { "@type": "AdministrativeArea", "name": "Stuttgart-Mitte" },
      { "@type": "AdministrativeArea", "name": "Stuttgart-Vaihingen" },
      { "@type": "AdministrativeArea", "name": "Stuttgart-Feuerbach" },
      { "@type": "AdministrativeArea", "name": "Stuttgart-Zuffenhausen" },
      { "@type": "AdministrativeArea", "name": "Stuttgart-Untertürkheim" },
      { "@type": "AdministrativeArea", "name": "Stuttgart-Möhringen" },
      { "@type": "AdministrativeArea", "name": "Stuttgart-Bad Cannstatt" },
      { "@type": "AdministrativeArea", "name": "Stuttgart-Hohenheim" },
      { "@type": "AdministrativeArea", "name": "Filderebene" },
      { "@type": "AdministrativeArea", "name": "Ditzingen" }
    ]
  },
  "parentOrganization": { "@type": "Organization", "name": "Wesemann Holding GmbH" },
  "foundingDate": "2025"
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://planexus.de/en" },
    { "@type": "ListItem", "position": 2, "name": "Lab containers", "item": "https://planexus.de/en/lab-containers" },
    { "@type": "ListItem", "position": 3, "name": "Lab containers Stuttgart", "item": "https://planexus.de/en/lab-containers-stuttgart" }
  ]
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "How quickly does Planexus deliver a lab container to Stuttgart?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "From the Albstadt works it is only 80 km via the A81 to the Stuttgart interchange — heavy-goods driving time under 1.5 hours. Standard containers under 4 m width and 18 t we deliver same-day. Manufacture of a configured LABtoGO or a BSL-2 variant typically takes 8 to 14 weeks from order. That makes us structurally four to six weeks faster than northern German or Hessian suppliers."
      }
    },
    {
      "@type": "Question",
      "name": "What does a Planexus lab container for Stuttgart cost?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "We do not quote standard prices. Every Stuttgart project is assessed individually, because biosafety level (S2/S3, ATEX, GMP), cleanroom class, special equipment, duration and site conditions determine the calculation. A BSL-3 container for Stuttgart’s university landscape has an entirely different investment structure from an analytical materials container for the Filder plain. Contact us for a complimentary, no-obligation project-specific assessment — we typically supply a written indication within 24 hours."
      }
    },
    {
      "@type": "Question",
      "name": "What permits do I need for a container laboratory in Stuttgart?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "The Building Code of Baden-Württemberg (Landesbauordnung Baden-Württemberg, LBO BW) is decisive. Unlike Hamburg or Berlin, Stuttgart has no decentralised borough-office system — the City of Stuttgart Building Law Office (Baurechtsamt) is centrally competent. Under Section 50 LBO BW smaller containers may be procedure-exempt; larger installations require a notification procedure (Kenntnisgabeverfahren) or a building permit. For genetic-engineering facilities an additional notification to the Stuttgart Regional Council (Regierungspräsidium Stuttgart) under GenTG is required. We prepare all building documents so they are procedure-ready."
      }
    },
    {
      "@type": "Question",
      "name": "Does Planexus also build BSL-3 for Stuttgart research institutions?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. For BSL-3 containers we supply a negative-pressure cascade from −50 Pa, HEPA H14 on the extract-air path, autoclaved airlocks, redundant HVAC and complete IQ/OQ/PQ documentation to BioStoffV and TRBA 100. For siting on the Vaihingen university campus or at hospital sites in the Middle Neckar region, coordination with the university building office, the State of Baden-Württemberg (Vermögen und Bau BW Stuttgart) and the Stuttgart Regional Council would be required."
      }
    },
    {
      "@type": "Question",
      "name": "What distinguishes LABtoGO from a conventional lab container?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "LABtoGO is 9,500 mm long, 3,000 mm wide and has 2,750 mm clear internal height — 350 mm more than a conventional container standard of 2,400 mm. The fully glazed front brings real daylight into the laboratory. The sandwich-panel shell achieves U-values around 0.20 W/m²K. In short: a conventional lab container fits entirely inside a LABtoGO. We do not call it LABtoGO without reason — it is the platform on which we configure BSL-2, GMP, ATEX and cleanroom."
      }
    },
    {
      "@type": "Question",
      "name": "Does Planexus also supply ATEX containers for Stuttgart powertrain and materials research?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. Lithium-ion research in Untertürkheim, powertrain and materials analytics in Zuffenhausen and industrial testing in Feuerbach require ATEX-compliant Zone 1 or Zone 2 containers. We build explosion-protected ventilation, EX lighting to IECEx, conductive floor coverings against electrostatic charge, and redundant gas sensing with emergency shutdown. Documentation to ATEX Directive 2014/34/EU and the German Industrial Safety Ordinance (BetrSichV) is standard in the scope of supply."
      }
    },
    {
      "@type": "Question",
      "name": "Hire or buy — what makes sense for a Stuttgart project?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Rule of thumb: for project durations under 24 months — for example interim laboratories during hospital refurbishments, time-limited third-party-funded projects on the Vaihingen campus or transitional solutions during urban major-construction phases — hire pays. For a permanent expansion at industrial sites in Feuerbach or on university campuses in Vaihingen or Hohenheim, purchase usually prevails, often with a hire-purchase option. We compare both models for your Stuttgart project, including balance-sheet impact and residual value."
      }
    },
    {
      "@type": "Question",
      "name": "What does the Wesemann Group provide in addition to the container?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Planexus is part of Wesemann Holding GmbH, a group with more than 60 years of experience in laboratory fit-out. For Stuttgart customers that means: containers, laboratory furniture and cleanroom technology from a single source — no interfaces, no gaps in responsibility. Fume cupboards to DIN EN 14175, acid-resistant worktops, safety cabinets to DIN EN 14470-1, cleanroom components — all from within the group. One contact from planning through to commissioning."
      }
    }
  ]
};
---

<Layout
  title="Lab containers Stuttgart – cleanroom, GMP and BSL-3"
  description="Rent lab containers in Stuttgart: BSL-2/3, GMP, ATEX, 2.75 m LABtoGO. Only 80 km from the Albstadt works – delivery in 1.5 h. Turnkey. Request a quotation."
  canonical="/en/lab-containers-stuttgart"
  schema={serviceSchema}
  ogImage="/attached_assets/Laborcontainer_001_1769688326918.jpg"
>
  <script type="application/ld+json" set:html={JSON.stringify(localBusinessSchema)} slot="head" />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} slot="head" />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} slot="head" />

  <div class="pt-20 min-h-screen bg-white">

    <!-- STICKY SIDE-CTA (desktop only) -->
    <aside class="hidden xl:block fixed right-6 top-1/2 -translate-y-1/2 z-40 w-60">
      <div class="bg-white rounded-2xl shadow-2xl border border-gray-200 overflow-hidden">
        <div class="bg-slate-900 px-5 py-3">
          <div class="text-primary text-xs font-bold uppercase tracking-wider">Stuttgart location</div>
        </div>
        <div class="p-5 space-y-3 text-sm">
          <p class="text-gray-700 leading-snug">Albstadt works – 80 km from the Stuttgart interchange. Complimentary site audit for your container laboratory.</p>
          <a href="#anfrage" class="block bg-primary text-slate-900 font-bold text-center py-3 rounded-lg hover:bg-primary/90 transition-colors text-sm">Start an enquiry</a>
          <a href="tel:+4974357519700" class="block text-center text-xs text-slate-600 hover:text-primary transition-colors">+49 7435 7519 700</a>
        </div>
      </div>
    </aside>

    <!-- HERO -->
    <section class="relative py-24 md:py-32 bg-slate-900 text-white overflow-hidden">
      <div class="absolute inset-0">
        <Picture src="/attached_assets/Laborcontainer_001_1769688326918.jpg" alt="Lab containers Stuttgart – Planexus LABtoGO with 2.75 m internal height for research and industry in Vaihingen, Feuerbach and Untertürkheim" class="w-full h-full object-cover opacity-20" loading="eager" fetchpriority="high" width={1980} height={1980} />
      </div>
      <div class="absolute inset-0 bg-gradient-to-r from-slate-900 via-slate-900/95 to-slate-900/70"></div>

      <div class="container mx-auto px-4 relative z-10">
        <div class="max-w-3xl">
          <nav class="flex items-center gap-2 text-sm text-gray-400 mb-8" aria-label="Breadcrumb">
            <a href="/en" class="hover:text-primary transition-colors">Home</a>
            <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m9 18 6-6-6-6"/></svg>
            <span>Lab containers</span>
            <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m9 18 6-6-6-6"/></svg>
            <span class="text-primary">Stuttgart</span>
          </nav>

          <div class="text-primary font-medium text-sm uppercase tracking-wider mb-4">Your specialist for lab containers · Middle Neckar region</div>

          <h1 class="text-4xl md:text-5xl lg:text-6xl font-heading font-bold mb-6 leading-tight">
            Lab containers Stuttgart – GMP and BSL-2 laboratories for the Middle Neckar
          </h1>

          <p class="text-xl text-gray-300 leading-relaxed mb-4">
            <strong class="text-white">Our managing directors bring more than ten years of experience in lab-container construction.</strong> Intelligent, sustainable and modular. We deliver flexible research environments for the future — from the Albstadt works straight to Stuttgart, only 80 km via the A81.
          </p>
