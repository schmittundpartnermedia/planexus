---
import Layout from '../../layouts/Layout.astro';
import { LiquidDistortion } from '../../components/LiquidDistortion';

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "inLanguage": "en",
  "mainEntity": [
    { "@type": "Question", "name": "What does a lab container cost?", "acceptedAnswer": { "@type": "Answer", "text": "The price depends on biosafety level, cleanroom class, equipment and location. A straightforward BSL-2 analytical laboratory starts at around €80,000; GMP cleanroom containers typically range from €250,000–500,000, with BSL-3 projects above that. A firm quotation is only possible after a requirements analysis — blanket prices are not meaningful for laboratory containers." } },
    { "@type": "Question", "name": "How long does delivery of a lab container take?", "acceptedAnswer": { "@type": "Answer", "text": "Standard laboratory containers (BSL-2, analytical): 8–12 weeks of factory production plus 2–5 working days for on-site installation. GMP cleanroom or BSL-3: 16–24 weeks including qualification. Series projects such as LABtoGO are often available more quickly." } },
    { "@type": "Question", "name": "Does a lab container require a building permit?", "acceptedAnswer": { "@type": "Answer", "text": "In most cases yes — depending on duration of siting, federal state and type of use. Containers with a gross volume exceeding 75 m³ require a building permit in Germany. Planexus supplies the building-law documentation and supports the approvals process across DACH." } },
    { "@type": "Question", "name": "Can you rent a lab container, or only buy?", "acceptedAnswer": { "@type": "Answer", "text": "Both. Hire is suitable for time-limited projects (12–24 months), for example during hospital refurbishments or study phases. Purchase is more economical for permanent capacity expansion. Hire-purchase is available as an intermediate option." } },
    { "@type": "Question", "name": "Which biosafety levels and cleanroom classes are available?", "acceptedAnswer": { "@type": "Answer", "text": "Planexus delivers BSL-2, BSL-3, GMP cleanrooms (ISO 5–8 to ISO 14644-1), ATEX containers for H₂ and battery testing, and standard analytical laboratories. All configurations are factory-built in Albstadt and delivered turnkey." } },
    { "@type": "Question", "name": "Where does Planexus deliver lab containers?", "acceptedAnswer": { "@type": "Answer", "text": "Across Germany and into Switzerland and Austria. Manufacture is at the Albstadt works (Baden-Württemberg), with transport by low-loader. Location-specific information for 12 DACH metropolitan regions is available under /en/locations." } }
  ]
};
---

<Layout
  title="Planexus – lab containers and modular laboratory construction from Albstadt"
  description="Planexus plans and delivers turnkey lab containers across DACH. Part of Wesemann Holding, manufactured in Albstadt. LABtoGO, hire and purchase — request a consultation."
  canonical="/en"
>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} slot="head" />
  <div class="min-h-screen bg-background text-foreground">
    <!-- Hero Section -->
    <section class="relative min-h-screen flex items-center justify-center overflow-hidden bg-slate-950 text-white">
      <!-- Mobile: Static Image -->
      <div class="lg:hidden absolute inset-0 z-0">
        <img
          src="/attached_assets/Kopf_green-scaled_1768306688943.jpg"
          alt="Modern laboratory container, exterior view"
          class="w-full h-full object-cover"
          loading="eager"
          width="2560"
          height="1280"
        />
      </div>

      <!-- Desktop: Liquid Distortion Effect -->
      <div class="hidden lg:block absolute inset-0 z-[5] w-full h-full">
        <LiquidDistortion
          client:visible
          imageSrc="/attached_assets/Kopf_green-scaled_1768306688943.jpg"
          className="w-full h-full"
        />
      </div>

      <div class="container mx-auto px-4 relative z-[10] pointer-events-none">
        <div class="max-w-3xl pt-16 md:pt-0">
          <img
            src="/attached_assets/Planexus_Home-e1738171155684_1767361842201.png"
            alt="Planexus GmbH"
            class="hidden md:block w-[520px] h-auto mb-8"
            width="4500"
            height="951"
          />
          <h1 class="text-3xl md:text-5xl font-heading font-bold text-white mb-6 leading-tight">
            Lab containers and modular laboratory construction from Albstadt
          </h1>
          <p class="text-lg md:text-xl text-gray-300 mb-6 leading-relaxed max-w-2xl font-light">
            Turnkey container laboratories for pharma, research and industry — planned and built at the Albstadt works, part of Wesemann Holding.
          </p>
          <p class="text-2xl md:text-3xl font-heading font-bold text-white/90 mb-8 leading-tight">
            Think. <span class="text-primary">Plan.</span> Connect.
          </p>
          <div class="flex flex-col sm:flex-row gap-4 pointer-events-auto">
            <a href="/en/lab-containers" class="bg-primary text-slate-900 font-bold px-8 py-4 rounded-lg hover:bg-primary/90 transition-colors flex items-center justify-center gap-2 group shadow-[0_0_20px_rgba(132,189,0,0.4)]">
              View lab containers
              <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 group-hover:translate-x-1 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
            </a>
            <a href="/en/contact" class="border border-white/20 text-white font-medium px-8 py-4 rounded-lg hover:bg-white/10 transition-colors backdrop-blur-sm flex items-center justify-center">
              Request a consultation
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- Award Banner -->
    <section class="py-8 bg-gradient-to-r from-slate-900 via-slate-800 to-slate-900">
      <div class="container mx-auto px-4">
        <div class="max-w-7xl mx-auto bg-white rounded-2xl overflow-hidden shadow-2xl border border-gray-100">
          <div class="grid grid-cols-1 md:grid-cols-5 items-center">
            <div class="md:col-span-2 p-8 md:p-12 flex flex-col items-center justify-center bg-gradient-to-br from-slate-50 to-white">
              <div class="relative">
                <div class="w-40 h-40 md:w-48 md:h-48 rounded-full bg-gradient-to-br from-[#bbd700]/20 via-[#bbd700]/10 to-transparent flex items-center justify-center border-2 border-[#bbd700]/30">
                  <div class="text-center">
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-14 h-14 md:w-16 md:h-16 text-[#bbd700] mx-auto mb-2" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9H4.5a2.5 2.5 0 0 1 0-5H6"/><path d="M18 9h1.5a2.5 2.5 0 0 0 0-5H18"/><path d="M4 22h16"/><path d="M10 14.66V17c0 .55-.47.98-.97 1.21C7.85 18.75 7 20.24 7 22"/><path d="M14 14.66V17c0 .55.47.98.97 1.21C16.15 18.75 17 20.24 17 22"/><path d="M18 2H6v7a6 6 0 0 0 12 0V2Z"/></svg>
                    <p class="text-[#7a9900] font-bold text-xs uppercase tracking-wider">Award 2026</p>
                  </div>
                </div>
              </div>
            </div>
            <div class="md:col-span-3 p-8 md:p-12 flex flex-col items-start justify-center">
              <span class="bg-[#bbd700]/10 text-[#7a9900] text-xs font-bold px-3 py-1 rounded-full uppercase tracking-wider mb-4">Award</span>
              <h3 class="text-2xl md:text-3xl font-heading font-bold text-slate-900 mb-3 leading-tight">
                Leading provider of innovative laboratory spaces 2026
              </h3>
              <p class="text-gray-500 text-sm font-medium mb-2">EU Business News — German CEO Excellence Awards 2026</p>
              <p class="text-gray-600 text-base mb-6 leading-relaxed">
                First presented at analytica 2026, now recognised internationally. Planexus was honoured at the German CEO Excellence Awards as the leading provider of innovative laboratory spaces 2026.
              </p>
              <div class="flex flex-wrap gap-3">
                <a href="/en/lab-containers/labtogo" class="inline-flex items-center gap-2 bg-[#bbd700] text-slate-900 font-bold px-8 py-3.5 rounded-lg hover:bg-[#a8c200] transition-colors text-sm group">
                  Discover LABtoGO
