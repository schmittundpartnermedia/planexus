---
import Layout from '../../layouts/Layout.astro';
import ContactForm from '../../components/ContactForm.tsx';
import AuthorBio from '../../components/AuthorBio.astro';
import CityCrossLinks from '../../components/CityCrossLinks.astro';

const title = "Lab containers Bern – cleanroom, GMP, BSL-3";
const description = "Rent lab containers in Bern: BSL-3, SIA 261, GMP cleanroom for pharma, research and hospitals. Customs-cleared from the Albstadt works in 8–14 weeks. Complimentary consultation.";
const canonical = "/en/lab-containers-bern";

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "serviceType": "Lab containers and modular laboratory construction Bern",
  "provider": {
    "@type": "Organization",
    "name": "Planexus GmbH",
    "image": "https://planexus.de/android-chrome-512x512.png",
    "url": "https://planexus.de",
    "telephone": "+49 7435 7519 700",
    "email": "info@planexus.de",
    "address": { "@type": "PostalAddress", "streetAddress": "Am Steinbach 8", "addressLocality": "Albstadt-Laufen", "addressRegion": "Baden-Württemberg", "postalCode": "72459", "addressCountry": "DE" },
    "parentOrganization": { "@type": "Organization", "name": "Wesemann Holding GmbH" }
  },
  "areaServed": [
    { "@type": "City", "name": "Bern" },
    { "@type": "AdministrativeArea", "name": "Canton of Bern" },
    { "@type": "Country", "name": "Switzerland" }
  ],
  "description": "Container laboratories, mobile laboratories and modular laboratory buildings for pharma, biotech, universities, hospitals and public-health authorities such as the Federal Office of Public Health (FOPH/BAG) and Swissmedic — customs-cleared from the Albstadt works to Bern via Schaffhausen or Basel.",
  "offers": { "@type": "AggregateOffer", "priceCurrency": "CHF", "availability": "https://schema.org/InStock" }
};

const localBusinessSchema = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "name": "Planexus GmbH – Lab containers Bern",
      "image": "https://planexus.de/images/labtogo-industrie.webp",
  "url": "https://planexus.de/en/lab-containers-bern",
  "telephone": "+49 7435 7519 700",
  "email": "info@planexus.de",
  "address": { "@type": "PostalAddress", "streetAddress": "Am Steinbach 8", "addressLocality": "Albstadt-Laufen", "addressRegion": "Baden-Württemberg", "postalCode": "72459", "addressCountry": "DE" },
  "areaServed": { "@type": "City", "name": "Bern", "containedInPlace": { "@type": "Country", "name": "Switzerland" } },
  "priceRange": "CHF",
  "openingHoursSpecification": [{ "@type": "OpeningHoursSpecification", "dayOfWeek": ["Monday","Tuesday","Wednesday","Thursday","Friday"], "opens": "08:00", "closes": "17:00" }]
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://planexus.de/en" },
    { "@type": "ListItem", "position": 2, "name": "Locations", "item": "https://planexus.de/en/lab-containers" },
    { "@type": "ListItem", "position": 3, "name": "Lab containers Bern", "item": "https://planexus.de/en/lab-containers-bern" }
  ]
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "How long does it take to deliver a lab container from the Albstadt works to Bern?",
      "acceptedAnswer": { "@type": "Answer", "text": "The heavy-haulage route from the Albstadt works to Bern runs south on the A81 via Singen, clearance at the Schaffhausen-Thayngen customs office, then on the Swiss side west on the A4 → A1 via Zurich → Solothurn → Bern. Driving time is around 3.5 hours over approximately 220 kilometres; with Schaffhausen clearance typically one transport day. Alternatively, clearance at the Weil am Rhein customs office and A2 → A1 (~250 km) — we choose according to the day’s load at the customs offices. Standard delivery points: Freiburgstrasse for hospital and research sites, Liebefeld for the FOPH, Länggasse for university sites, Wankdorf for federal offices and industrial quarters. From order to operational handover in Bern takes 8 to 14 weeks." }
    },
    {
      "@type": "Question",
      "name": "Which permits do I need for a lab container in the Canton of Bern?",
      "acceptedAnswer": { "@type": "Answer", "text": "In the Canton of Bern the Baugesetz Bern (BauG, Building Act of the Canton of Bern) and the Bauverordnung (BauV, Building Ordinance) apply. At city level the Bauordnung der Stadt Bern (BO Stadt Bern, City of Bern Building Code) applies. For the city the competent authority is the Building Inspectorate at Bundesgasse 38, 3011 Bern. Containers are treated as buildings and installations; a building permit is required in most cases. Temporary siting of under three months may, depending on the site, be possible under a notification procedure. Bern’s great advantage: both the Federal Office of Public Health (FOPH/BAG) and Swissmedic are based in Bern — for BSL-3 containers and GMP pilot plants the authority path is considerably shorter than from Zurich or Basel. We review your site in advance and submit procedure-ready building documents." }
    },
    {
      "@type": "Question",
      "name": "What does proximity to the FOPH and Swissmedic mean for GMP and BSL-3 containers in Bern?",
      "acceptedAnswer": { "@type": "Answer", "text": "Every genetically modified containment in Switzerland requires notification under the Einschliessungsverordnung (ESV, Containment Ordinance) to FOEN and FOPH — the FOPH is at Schwarzenburgstrasse 157, 3003 Bern (Liebefeld). For every GMP cleanroom-container project with a therapeutic-products dimension, Swissmedic at Hallerstrasse 7, 3012 Bern, is the competent inspection authority. If your site is in Bern, both authorities are reachable by public transport in 15 to 30 minutes — on-site inspections can be scheduled at short notice, and written queries are generally answered in 5 to 10 working days. From Zurich or Basel those are always travel days — from Bern a tram ride. We use this proximity and file our application documents directly with the right case officers." }
    },
    {
      "@type": "Question",
      "name": "Which seismic and energy requirements apply to lab containers in Bern under SIA 261 / SIA 380/1?",
      "acceptedAnswer": { "@type": "Answer", "text": "Under SIA 261, Bern lies in seismic zone Z1a with a horizontal design ground acceleration of agd = 0.6 m/s² — like Zurich, considerably lower than Basel (Z2, agd 1.0 m/s²). Structurally the requirement is therefore moderate; however, containers for safety-relevant hospital and research sites must be classified in Bauwerksklasse II, because safety-critical functions are housed here. SIA 380/1 (thermal energy in buildings) requires similarly strict U-values as in Zurich — the German GEG is not sufficient. We supply Bern with structural design to SIA 261 with the Z1a factor and an SIA 263 anchoring concept, and energetically to SIA 380/1 with U ≤ 0.17 W/m²K and heat recovery ≥ 75% — procedure-ready for the Building Inspectorate at Bundesgasse 38." }
    },
    {
      "@type": "Question",
      "name": "How does Schaffhausen-Thayngen customs clearance work for containers to Bern?",
      "acceptedAnswer": { "@type": "Answer", "text": "We clear goods under the T1 transit procedure, with processing at the Thayngen (German side) and Schaffhausen-Thayngen (Swiss side) customs offices. Permanent import attracts Swiss VAT of 8.1 per cent (as at 2026). Temporary import (for example a rental container for a clinical study, a time-limited teaching cleanroom at a university, or a pilot container in translational research) can be cleared under temporary admission with an ATA Carnet — no VAT, with a security deposit. Thayngen is the most direct route from Albstadt to Bern (~220 km, ~3.5 h)." }
    },
    {
      "@type": "Question",
      "name": "Which applications are particularly in demand in Bern?",
      "acceptedAnswer": { "@type": "Answer", "text": "Bern is Switzerland’s public-health and translational-medicine centre. Typical uses for lab containers arise around university hospitals — BSL-2 study containers during hospital refurbishments and pandemic preparedness; translational research institutions — research containers at the interface of hospital, university, industry and start-ups; universities and biomedical research departments — BSL-2 research containers and SNSF third-party-funded projects; the Federal Office of Public Health FOPH (Schwarzenburgstrasse 157, 3003 Bern-Liebefeld) and the Federal Food Safety and Veterinary Office FSVO (Schwarzenburgstrasse 155) — public-health containers and pandemic preparedness; Swissmedic (Hallerstrasse 7, 3012 Bern) — internal teaching and inspection containers; and food and agricultural research institutions — food-safety and veterinary containers." }
    },
    {
      "@type": "Question",
      "name": "Can you supply BSL-3 containers for hospitals and translational research?",
      "acceptedAnswer": { "@type": "Answer", "text": "Yes. We build BSL-3 containers for clinical research, infectious-disease diagnostics and translational pharmaceutical piloting at the Albstadt works — HEPA H14 dual filtration, autoclaved airlock, negative pressure with a three-stage cascade, emergency power and data loggers. Notification under the Containment Ordinance (ESV) to FOEN and FOPH — generally accelerated in Bern because of FOPH proximity. Structural design to SIA 261 Z1a + 263, energy to SIA 380/1, fire protection to VKF. For study containers at a hospital site, co-ordination with the relevant building directorate would be required; for translational research, with the competent specialist department. IQ/OQ/PQ Swissmedic-ready — the short authority distance in Bern can be an advantage." }
    }
  ]
};
---

<Layout title={title} description={description} canonical={canonical}>
  <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(localBusinessSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <div class="bg-white">

    <!-- HERO -->
    <section class="relative bg-slate-900 text-white overflow-hidden">
      <div class="relative z-10 container mx-auto px-4 py-20 md:py-28">
        <div class="max-w-4xl">
          <nav class="flex items-center gap-2 text-sm text-gray-400 mb-8" aria-label="Breadcrumb">
            <a href="/en" class="hover:text-primary transition-colors">Home</a>
            <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m9 18 6-6-6-6"/></svg>
            <span>Locations</span>
            <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m9 18 6-6-6-6"/></svg>
            <span class="text-primary">Bern</span>
          </nav>

          <div class="text-primary font-medium text-sm uppercase tracking-wider mb-4">Your specialist for lab containers · Federal capital with FOPH + Swissmedic on site</div>

          <h1 class="text-4xl md:text-5xl lg:text-6xl font-heading font-bold mb-6 leading-tight">
            Lab containers Bern – BSL-3 with direct FOPH and Swissmedic access
          </h1>

          <p class="text-xl text-gray-300 leading-relaxed mb-4">
            <strong class="text-white">Our managing directors bring more than ten years of experience in lab-container construction.</strong> Modular, SIA 261-compliant, T1 customs-cleared. We deliver flexible research, hospital and public-health environments for pharma, biotech, universities, hospitals and the Federal Office of Public Health (FOPH/BAG) and Swissmedic — from the Albstadt works directly to Bern, via the A81 and Schaffhausen-Thayngen clearance in only 220 km.
          </p>
          <p class="text-base text-gray-400 mb-8">While others are still planning, you are already researching.</p>

          <div class="flex flex-col sm:flex-row gap-4 mb-8">
            <a href="#anfrage" data-testid="button-cta-hero" class="bg-primary text-slate-900 font-bold px-8 py-4 rounded-lg hover:bg-primary/90 transition-colors inline-flex items-center justify-center gap-2 shadow-[0_0_20px_rgba(132,189,0,0.3)]">Complimentary Bern site audit<svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg></a>
            <a href="tel:+4974357519700" class="border border-white/20 text-white font-medium px-8 py-4 rounded-lg hover:bg-white/10 transition-colors inline-flex items-center justify-center gap-2"><svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>+49 7435 7519 700</a>
          </div>

          <div class="flex flex-wrap items-center gap-x-6 gap-y-2 text-sm text-gray-400">
            <div class="flex items-center gap-2"><svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6 9 17l-5-5"/></svg>Specialist in modular laboratory construction</div>
            <div class="flex items-center gap-2"><svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6 9 17l-5-5"/></svg>Award 2026 EU Business News</div>
            <div class="flex items-center gap-2"><svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6 9 17l-5-5"/></svg>Schaffhausen customs clearance included</div>
            <div class="flex items-center gap-2"><svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6 9 17l-5-5"/></svg>Wesemann Group · 60+ years of laboratory construction</div>
          </div>
        </div>
      </div>
    </section>

    <AuthorBio city="Bern"  locale="en" />

    <!-- LABtoGO -->
    <section class="py-16 md:py-20 bg-gradient-to-br from-primary/5 via-white to-primary/10 border-y border-primary/20">
      <div class="container mx-auto px-4">
        <div class="max-w-5xl mx-auto">
          <div class="grid md:grid-cols-2 gap-10 items-center mb-10">
            <div>
              <div class="text-primary font-bold text-sm uppercase tracking-wider mb-3">Pattern interrupt · World premiere at analytica 2026</div>
              <h2 class="text-3xl md:text-4xl font-heading font-bold mb-4 text-slate-900">Planexus shows Bern what a lab container can really do in 2026</h2>
              <p class="text-lg text-gray-700 leading-relaxed mb-4">An ordinary lab container has 2,400 mm internal height. Working upright at a fume cupboard is a struggle.</p>
              <p class="text-lg text-slate-900 font-bold leading-relaxed mb-4">The Planexus LABtoGO has 2,750 mm internal height. 9.5 m external length. 3 m external width. A fully glazed front that brings genuine daylight into every Bern research, hospital and public-health laboratory.</p>
              <p class="text-lg text-gray-700 leading-relaxed"><strong>An ordinary lab container fits entirely inside a LABtoGO.</strong> We configure it for Bern to SIA 261 seismic zone Z1a, SIA 380/1 energy stricter than the German GEG, T1 customs clearance from the Albstadt works via Schaffhausen-Thayngen, and a T13/T15 Swiss electrical connection to NIN 2020.</p>
            </div>
            <div class="grid grid-cols-2 gap-4">
              <div class="bg-slate-900 text-white rounded-2xl p-6 text-center"><div class="text-4xl font-bold text-primary mb-1">2,750</div><div class="text-xs text-gray-400 uppercase tracking-wider">mm internal height</div><div class="text-xs text-gray-500 mt-1">Standard: 2,400 mm</div></div>
              <div class="bg-slate-900 text-white rounded-2xl p-6 text-center"><div class="text-4xl font-bold text-primary mb-1">9,500</div><div class="text-xs text-gray-400 uppercase tracking-wider">mm external length</div><div class="text-xs text-gray-500 mt-1">3,000 mm width</div></div>
              <div class="bg-slate-900 text-white rounded-2xl p-6 text-center"><div class="text-4xl font-bold text-primary mb-1">SIA Z1a</div><div class="text-xs text-gray-400 uppercase tracking-wider">Seismic agd 0.6 m/s²</div><div class="text-xs text-gray-500 mt-1">as Zurich</div></div>
              <div class="bg-slate-900 text-white rounded-2xl p-6 text-center"><div class="text-4xl font-bold text-primary mb-1">220 km</div><div class="text-xs text-gray-400 uppercase tracking-wider">Works → Bern</div><div class="text-xs text-gray-500 mt-1">3.5 h via Thayngen</div></div>
            </div>
          </div>
          <div class="text-center"><a href="/en/lab-containers/labtogo" class="inline-flex items-center gap-2 text-primary font-bold hover:underline">View the LABtoGO platform and all configurations<svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg></a></div>
        </div>
      </div>
    </section>

    <!-- PROBLEM-AGITATION -->
    <section class="py-16 md:py-20">
      <div class="container mx-auto px-4">
        <div class="max-w-5xl mx-auto">
          <h2 class="text-3xl md:text-4xl font-heading font-bold mb-10 text-slate-900">Planexus solves the three Bern bottlenecks at which public-health and hospital containers regularly fail</h2>
          <div class="grid md:grid-cols-3 gap-6">
            <div class="bg-slate-50 border-l-4 border-primary rounded-xl p-6">
              <div class="text-slate-900 font-bold text-lg mb-2">FOPH and Swissmedic proximity used wrongly</div>
              <p class="text-gray-700 text-sm leading-relaxed">Both Swiss federal health authorities — FOPH (Schwarzenburgstrasse 157, Liebefeld) and Swissmedic (Hallerstrasse 7) — sit in Bern. That is a considerable advantage for ESV notifications, GMP inspections and therapeutic-product authorisations. Anyone commissioning standard freight operators from Zurich or Basel leaves this advantage unused and turns days into weeks.</p>
              <p class="text-sm text-slate-900 font-semibold mt-3 pt-3 border-t border-gray-200">Planexus answer: Application documents filed directly with FOPH/Swissmedic, on-site appointments in Bern.</p>
            </div>
            <div class="bg-slate-50 border-l-4 border-primary rounded-xl p-6">
              <div class="text-slate-900 font-bold text-lg mb-2">Freiburgstrasse — hospital + translation together</div>
              <p class="text-gray-700 text-sm leading-relaxed">Hospital and research buildings sit directly next to each other on Freiburgstrasse — unique in Switzerland. Containers that land here must be hospital-capable (hospital hygiene, BSL-2/3) and translationally capable (pharma pilot, IP protection, ISO 14644) at the same time. Standard containers can do one or the other — never both.</p>
              <p class="text-sm text-slate-900 font-semibold mt-3 pt-3 border-t border-gray-200">Planexus answer: Hybrid hospital + translational containers from the Albstadt works.</p>
            </div>
            <div class="bg-slate-50 border-l-4 border-primary rounded-xl p-6">
              <div class="text-slate-900 font-bold text-lg mb-2">SIA + Schaffhausen customs — Swiss standards from day one</div>
              <p class="text-gray-700 text-sm leading-relaxed">Swiss building inspectorates do not accept DIN structural calculations on their own. SIA 261 Z1a, SIA 263 anchoring, SIA 380/1 energy — and Schaffhausen-Thayngen clearance with T1 or ATA Carnet (Swiss VAT 8.1% or without VAT). Freight operators who treat Swiss customs as a flat rate are often thousands of CHF out.</p>
              <p class="text-sm text-slate-900 font-semibold mt-3 pt-3 border-t border-gray-200">Planexus answer: SIA structural + SIA energy + transparent Schaffhausen clearance from the works.</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- STRATEGISCHE FUSION -->
    <section class="py-16 md:py-20 bg-slate-50">
      <div class="container mx-auto px-4">
        <div class="max-w-4xl mx-auto">
          <h2 class="text-3xl md:text-4xl font-heading font-bold mb-8 text-slate-900">Lab containers for Bern: what FOPH, Swissmedic, hospitals and research demand of the engineering</h2>
          <div class="prose prose-lg max-w-none text-gray-700 space-y-6">
            <p><strong>Bern is the federal capital of Switzerland — and the country’s public-health, therapeutic-products and translational-medicine centre.</strong> Here sits the Federal Office of Public Health FOPH (Schwarzenburgstrasse 157, 3003 Bern, in the Liebefeld district), the Swiss counterpart to the German federal authorities for medicinal products, infection control and vaccines in personal union. Here sits Swissmedic (Hallerstrasse 7, 3012 Bern), the Swiss therapeutic-products regulator. Here sits the Federal Food Safety and Veterinary Office FSVO (Schwarzenburgstrasse 155). And here university hospitals, translational research, universities, biomedical research departments and food and agricultural research institutions concentrate in a very small area.</p>
            <p><strong>We know this market in detail.</strong> We know that the City of Bern Building Inspectorate at Bundesgasse 38, 3011 Bern, decides under the cantonal Building Act (BauG) and Building Ordinance (BauV). We know that SIA 261 defines seismic zone Z1a for Bern with agd = 0.6 m/s² — moderate, but Bauwerksklasse II for safety-relevant hospital and research sites is mandatory. We know that containers for clinical research at university hospitals must practically always be hospital-capable (hospital hygiene standards) and study-capable (IRB-compliant data integrity) at the same time. We know Bern’s decisive advantage: FOPH and Swissmedic case officers are reachable by tram in 15 minutes — on-site inspections for ESV (BSL-3) and GMP (therapeutic products) can be scheduled at short notice, and written queries are answered in 5 to 10 working days. From Zurich or Basel those are travel days — from Bern tram rides. These details are not in our quotation — they are the engineering and authority foundation of every container that leaves our Albstadt works.</p>
            <p><strong>Made in Albstadt, customs-cleared at Schaffhausen-Thayngen, turnkey in Bern.</strong> Final assembly and interior fit-out are carried out with Wesemann furniture in our own works — factory visits can be arranged from either side. South on the A81 via Singen, clearance at the Thayngen customs office, then on the Swiss side west on the A4 → A1 via Zurich → Solothurn → Bern, the heavy-haulage distance is around 220 kilometres (~3.5 h). Standard delivery points: Freiburgstrasse for hospital and research sites, Liebefeld for the FOPH, Länggasse for universities, Murtenstrasse for biomedical research, Wankdorf for federal offices and industry.</p>
            <p>Whether you need a <strong>mobile laboratory in Bern</strong> for a time-limited hospital refurbishment, a <strong>modular lab container in Bern</strong> for translational research, or a <strong>container laboratory in Bern</strong> with BSL-3 containment and Swissmedic-ready GMP for Bern pharmaceutical spin-offs — we deliver all three answers from the same platform: the LABtoGO from our Albstadt works, with Swiss customs, SIA structural, SIA energy and FOPH/Swissmedic authority path documented from the factory.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- ANWENDUNGSBEREICHE -->
    <section class="py-16 md:py-20 bg-slate-900 text-white">
      <div class="container mx-auto px-4">
        <div class="max-w-6xl mx-auto">
          <div class="text-center max-w-3xl mx-auto mb-12">
            <div class="text-primary font-bold text-sm uppercase tracking-wider mb-3">Applications Bern</div>
            <h2 class="text-3xl md:text-4xl font-heading font-bold mb-4">Application areas for lab containers in Bern</h2>
            <p class="text-gray-400 text-lg">Each area with a concrete Bern site and authority reference.</p>
          </div>
          <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
            <div class="bg-slate-800/60 rounded-xl p-5 border border-slate-700 hover:border-primary/40 transition-colors"><div class="text-primary text-xs font-bold uppercase tracking-wider mb-2">01</div><div class="font-bold mb-1">FOPH Liebefeld</div><p class="text-xs text-gray-400">Schwarzenburgstrasse 157, public-health containers and pandemic preparedness with direct FOPH proximity</p></div>
            <div class="bg-slate-800/60 rounded-xl p-5 border border-slate-700 hover:border-primary/40 transition-colors"><div class="text-primary text-xs font-bold uppercase tracking-wider mb-2">02</div><div class="font-bold mb-1">Swissmedic</div><p class="text-xs text-gray-400">Hallerstrasse 7, GMP and therapeutic-product inspection readiness, IQ/OQ/PQ audit-ready</p></div>
            <div class="bg-slate-800/60 rounded-xl p-5 border border-slate-700 hover:border-primary/40 transition-colors"><div class="text-primary text-xs font-bold uppercase tracking-wider mb-2">03</div><div class="font-bold mb-1">Pharma spin-offs</div><p class="text-xs text-gray-400">Bern biotech start-ups, pilot and GMP containers from translational incubation</p></div>
          </div>
          <div class="text-center mt-10"><p class="text-gray-400 mb-4">Your application is not listed? We also develop individual modules far from the standard.</p><a href="#anfrage" class="inline-flex items-center gap-2 bg-primary text-slate-900 font-bold px-6 py-3 rounded-lg hover:bg-primary/90 transition-colors">Enquire about a special solution for Bern <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg></a></div>
        </div>
      </div>
    </section>

    <!-- 6 ENGINEERING -->
    <section class="py-16 md:py-20">
