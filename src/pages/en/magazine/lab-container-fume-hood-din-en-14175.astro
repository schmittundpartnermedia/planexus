const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": "Fume cupboards in the container – containment, extract performance and DIN EN 14175",
  "description": "Fume cupboards to DIN EN 14175 (Parts 1–7): containment and SF₆ type testing, face velocity and the 0.7 m/s vs. sash 0.5 m distinction, cupboard types, VAV energy saving, extract discharge over roof to DIN 1946-7, annual on-site testing to TRGS 526 and DGUV 213-850 – with verified standards.",
  "author": { "@type": "Person", "name": "Thomas Boss", "url": "https://planexus.de/en/team/thomas-boss", "jobTitle": "Partner & Technical Director", "worksFor": { "@type": "Organization", "name": "Planexus GmbH" } },
