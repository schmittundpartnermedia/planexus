const pageUrl = "https://planexus.de/en/magazine/s1-s2-lab-requirements-germany";
const headline = "S2 lab requirements in Germany: what is mandatory and what you can skip";
const description = "S2 lab requirements under GenTSV and BioStoffV: a design checklist, ventilation, registration within 45 days and what an S2 lab does not need.";

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  "inLanguage": "en-GB",
  "headline": headline,
  "description": description,
  "author": { "@type": "Person", "name": "Thomas Boss", "url": "https://planexus.de/en/team/thomas-boss", "jobTitle": "Shareholder & Technical Director", "worksFor": { "@type": "Organization", "name": "Planexus GmbH", "url": "https://planexus.de/" } },
  "datePublished": "2026-10-22",
  "dateModified": "2026-10-22",
