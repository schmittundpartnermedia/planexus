    <section class="py-16 border-t border-gray-100">
      <div class="container mx-auto px-4">
        <div class="max-w-4xl mx-auto">
          <h2 class="text-2xl font-heading font-bold text-slate-900 mb-8">Frequently asked questions about S1 and S2 laboratories</h2>
          <div class="space-y-4">
