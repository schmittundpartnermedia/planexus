const faqs = [
  {
    q: "What is the difference between an S1 and an S2 laboratory?",
    a: "S1 work carries no risk to people or the environment, S2 work a low risk. S2 adds liquid-tight surfaces down to the wall-floor junction, a hand-wash basin with disinfectant dispenser by the door, an eye wash, a safety cabinet wherever aerosols may form, an autoclave in the same building and the biohazard symbol on the door."
  },
  {
    q: "Does an S2 laboratory need a permit?",
    a: "No, a registration is enough. For a genetic engineering facility at safety level 2 you submit a written registration (Anmeldung) to the state authority (Section 8 GenTG). Work may start 45 days after receipt, or earlier with the authority's consent (Section 12 GenTG). A permit is only required from level 3. The building itself may still need planning permission."
  },
  {
    q: "Does an S2 laboratory need negative pressure?",
    a: "No. Annex II of the Biological Agents Ordinance lists permanent negative pressure as not required for protection level 2, and the GenTSV does not require it for safety level 2 either. What is mandatory is that aerosols are contained, for example by a microbiological safety cabinet, and that contaminated process exhaust air does not enter the room unfiltered."
  },
  {
    q: "Does an S2 laboratory need an airlock?",
    a: "No. The Biological Agents Ordinance only provides for an airlock with interlocking doors from protection level 3. For level 2 it recommends separating the lab from other areas. A small anteroom for changing is still practical, because protective clothing has to be kept apart from street clothing."
  },
  {
    q: "What ventilation does an S2 laboratory need?",
    a: "There is no air change rate specific to S2. As soon as hazardous substances are used, TRGS 526 applies with a reference value of 25 cubic metres of air per hour per square metre of lab floor, a little over eight air changes per hour at a 3-metre ceiling. Because windows stay closed during work, an S2 lab needs mechanical ventilation in practice."
  },
  {
    q: "Does the autoclave have to be inside the S2 laboratory?",
    a: "Not inside the lab room itself. For safety level 2 the GenTSV requires an autoclave with sufficient capacity within the genetic engineering facility or in the same building. For a stand-alone lab container, clarify early with the authority whether the autoclave belongs in the container or whether a unit in a neighbouring building is accepted."
  },
  {
    q: "May pregnant employees work in an S2 laboratory?",
    a: "There is no blanket ban. Under Section 11(2) of the German Maternity Protection Act, a pregnant woman must not have contact with biological agents of risk groups 2 to 4 that would pose an unjustifiable risk to her or her child. Rubella virus and Toxoplasma are named explicitly, and with sufficient immunity that risk is deemed excluded. The risk assessment for the specific work decides."
  },
  {
    q: "Can a lab container be operated as an S2 laboratory?",
    a: "Yes. GenTSV and the Biological Agents Ordinance regulate surfaces, equipment, ventilation, signage and organisation, not the construction method. A lab container can meet every structural point and be registered as an S2 facility. Planexus typically manufactures S1 and S2 lab containers in 8 to 14 weeks, and the 45-day registration period runs in parallel."
  }
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "inLanguage": "en-GB",
  "mainEntity": faqs.map((f) => ({
    "@type": "Question",
    "name": f.q,
    "acceptedAnswer": { "@type": "Answer", "text": f.a }
