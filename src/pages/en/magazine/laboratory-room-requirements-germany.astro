import RelatedArticles from '../../../components/RelatedArticles.astro';
import LeadMagnetLastenheft from '../../../components/LeadMagnetLastenheft.astro';
import Picture from '../../../components/Picture.astro';

const pageUrl = "https://planexus.de/en/magazine/laboratory-room-requirements-germany";
const headline = "Laboratory room requirements in Germany: what every lab must provide";
const description = "Laboratory room requirements under TRGS 526 and DGUV 213-850: doors, escape routes, ventilation, emergency showers, gas shut-off and room sizes.";

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  "inLanguage": "en-GB",
  "headline": headline,
  "description": description,
  "author": { "@type": "Person", "name": "Thomas Boss", "url": "https://planexus.de/en/team/thomas-boss", "jobTitle": "Shareholder & Technical Director", "worksFor": { "@type": "Organization", "name": "Planexus GmbH", "url": "https://planexus.de/" } },
  "datePublished": "2026-11-13",
  "dateModified": "2026-11-13",
  "image": "https://planexus.de/images/blog-laborraeume-anforderungen.jpg",
  "publisher": { "@type": "Organization", "name": "Planexus GmbH", "logo": { "@type": "ImageObject", "url": "https://planexus.de/images/planexus-logo.png" } },
  "mainEntityOfPage": { "@type": "WebPage", "@id": pageUrl },
  "about": [
    { "@type": "Thing", "name": "Laboratory" },
    { "@type": "Thing", "name": "TRGS 526 Laboratories" },
    { "@type": "Thing", "name": "DGUV Information 213-850 Safe Working in Laboratories" }
