  ]
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://planexus.de/en" },
    { "@type": "ListItem", "position": 2, "name": "Magazine", "item": "https://planexus.de/en/magazine" },
    { "@type": "ListItem", "position": 3, "name": "Laboratory room requirements", "item": pageUrl }
  ]
};

const faqs = [
  {
    q: "Which regulations apply to laboratory rooms in Germany?",
    a: "Laboratories that work with hazardous substances fall under TRGS 526 “Laboratories” (February 2008 edition). Its text is reproduced word for word in DGUV Information 213-850 “Safe Working in Laboratories”, together with explanatory notes. The Workplaces Ordinance and its technical rules also apply, such as ASR A1.2 for room dimensions and ASR A2.3 for escape routes, plus TRGS 510 for storing hazardous substances."
  },
  {
    q: "Is an emergency shower mandatory in a laboratory?",
    a: "Yes. Under TRGS 526 No. 6.6.1, laboratories must have body showers installed at the exit, supplied with water of drinking quality where possible and delivering at least 30 litres per minute. Eye showers are also mandatory under No. 6.6.2, reachable without delay from every workstation and delivering at least 6 litres per minute per outlet. Both are checked at least monthly."
  },
  {
    q: "How often do laboratory emergency showers have to be tested?",
    a: "At least once a month. TRGS 526 No. 7.2 requires body and eye showers to be checked for proper function at least monthly by a person appointed by the employer. In practice that means activating the shower, letting the water run, checking flow and spray pattern and recording the result."
  },
  {
    q: "What air change rate does a laboratory need?",
    a: "TRGS 526 sets 25 cubic metres of air per hour per square metre of usable floor area. At a 3-metre ceiling that is roughly eight air changes per hour. A lower rate is only allowed if the risk assessment shows it is permanently sufficient. Work with flammable or volatile substances is then limited to the smallest scale, and the door must carry the sign “Caution: reduced air change!”."
  },
  {
    q: "Which way must laboratory doors open?",
    a: "In the direction of escape, out of the lab. TRGS 526 No. 6.2.3 also requires a vision panel and does not permit sliding doors for laboratories. Lab doors are to be kept closed. ASR A2.3 names laboratories explicitly as an example where doors must open in the direction of escape."
  },
  {
    q: "Does a laboratory need a second exit?",
    a: "TRGS 526 requires exits “in sufficient number”, depending on the room, the substances and the work. DGUV Information 213-850 recommends a second means of escape for every lab room and a maximum escape route of 25 metres. ASR A2.3 allows up to 35 metres in rooms with normal fire risk and 25 metres with increased fire risk and no automatic extinguishing system."
  },
  {
    q: "How high must a laboratory room be?",
    a: "ASR A1.2 sets the clear height by floor area: at least 2.50 metres up to 50 square metres, 2.75 metres above 50 square metres and 3.00 metres above 100 square metres. These values may be reduced by 0.25 metres if there are no health concerns, but never below 2.50 metres."
  },
  {
    q: "Do these requirements apply to a lab container too?",
    a: "Yes. TRGS 526 and workplace law regulate doors, escape routes, ventilation, emergency showers and fit-out, not the construction method. A lab container must meet the same points as a lab in a conventional building. In a container it pays to fix the exit, emergency shower, water supply and exhaust air in the very first layout, because these points determine how the modules are arranged."
  }
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "inLanguage": "en-GB",
  "mainEntity": faqs.map((f) => ({
    "@type": "Question",
    "name": f.q,
    "acceptedAnswer": { "@type": "Answer", "text": f.a }
  }))
};

const linkClass = "text-[#5c7300] font-medium hover:underline";
const td = "p-3 border border-gray-200";
const chevron = `<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#bbd700" stroke-width="2" aria-hidden="true"><polyline points="9 18 15 12 9 6"/></svg>`;
const furtherLinks = [
  { href: "/en/magazine/s1-s2-lab-requirements-germany", label: "S1 and S2 lab requirements" },
  { href: "/en/magazine/lab-container-fume-hood-din-en-14175", label: "Fume hoods and DIN EN 14175" },
  { href: "/en/magazine/lab-container-fire-protection", label: "Fire protection in lab containers" },
  { href: "/en/magazine/lab-container-hvac-ventilation-standards", label: "Climate control and ventilation" },
