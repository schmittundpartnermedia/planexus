                      <td class="p-3 text-gray-600">BbgBO</td>
                      <td class="p-3 text-gray-600">3 months</td>
                      <td class="p-3 text-gray-600">Notification procedure for special buildings</td>
                    </tr>
                    <tr class="bg-white">
