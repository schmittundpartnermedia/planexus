                      <td class="p-3 font-medium">Hesse</td>
                      <td class="p-3 text-gray-600">HBO</td>
                      <td class="p-3 text-gray-600">3 months</td>
                      <td class="p-3 text-gray-600">Rhine-Main pharma cluster: authority experience available</td>
                    </tr>
                    <tr class="bg-slate-50">
                      <td class="p-3 font-medium">Mecklenburg-Western Pomerania</td>
                      <td class="p-3 text-gray-600">LBauO M-V</td>
                      <td class="p-3 text-gray-600">3 months</td>
                      <td class="p-3 text-gray-600">Simplified procedure for building classes 1–3</td>
                    </tr>
                    <tr class="bg-white">
                      <td class="p-3 font-medium">Lower Saxony</td>
                      <td class="p-3 text-gray-600">NBauO</td>
                      <td class="p-3 text-gray-600">3 months</td>
                      <td class="p-3 text-gray-600">Building-permit exemption where compliant with the B-Plan</td>
                    </tr>
                    <tr class="bg-slate-50">
                      <td class="p-3 font-medium">North Rhine-Westphalia</td>
                      <td class="p-3 text-gray-600">BauO NRW</td>
                      <td class="p-3 text-gray-600">3 months</td>
                      <td class="p-3 text-gray-600">Rhineland chemicals cluster: strict immission-control conditions</td>
                    </tr>
                    <tr class="bg-white">
                      <td class="p-3 font-medium">Rhineland-Palatinate</td>
                      <td class="p-3 text-gray-600">LBauO RP</td>
                      <td class="p-3 text-gray-600">3 months</td>
                      <td class="p-3 text-gray-600">Life-science location Mainz: experience with BSL permits</td>
                    </tr>
                    <tr class="bg-slate-50">
                      <td class="p-3 font-medium">Saarland</td>
                      <td class="p-3 text-gray-600">LBO SL</td>
