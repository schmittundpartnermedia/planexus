                    </tr>
                    <tr class="bg-slate-50">
                      <td class="p-3 font-medium">Bavaria</td>
                      <td class="p-3 text-gray-600">BayBO</td>
                      <td class="p-3 text-gray-600">3 months</td>
                      <td class="p-3 text-gray-600">Hazardous-substance stores from 200 kg subject to permit</td>
                    </tr>
                    <tr class="bg-white">
                      <td class="p-3 font-medium">Berlin</td>
                      <td class="p-3 text-gray-600">BauO Bln</td>
                      <td class="p-3 text-gray-600">3 months</td>
                      <td class="p-3 text-gray-600">Change of use always subject to permit</td>
                    </tr>
