                      <td class="border border-gray-200 px-4 py-3">Design situations, partial factors, limit states</td>
                    </tr>
                    <tr class="bg-slate-50">
                      <td class="border border-gray-200 px-4 py-3 font-medium">Actions in general</td>
                      <td class="border border-gray-200 px-4 py-3">DIN EN 1991-1-1 (Eurocode 1)</td>
                      <td class="border border-gray-200 px-4 py-3">Self-weight, imposed loads in buildings</td>
                    </tr>
