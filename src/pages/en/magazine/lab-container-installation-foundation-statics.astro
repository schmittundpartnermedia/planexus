                      <td class="border border-gray-200 px-4 py-3">Five snow-load zones DE (1, 1a, 2, 2a, 3), height correction</td>
                    </tr>
                    <tr class="bg-slate-50">
                      <td class="border border-gray-200 px-4 py-3 font-medium">Wind load</td>
                      <td class="border border-gray-200 px-4 py-3">DIN EN 1991-1-4 + National Annex DE</td>
                      <td class="border border-gray-200 px-4 py-3">Four wind zones DE (1 to 4), terrain categories I to IV</td>
                    </tr>
                    <tr>
                      <td class="border border-gray-200 px-4 py-3 font-medium">Geotechnical design</td>
                      <td class="border border-gray-200 px-4 py-3">DIN EN 1997-1 (Eurocode 7)</td>
                      <td class="border border-gray-200 px-4 py-3">Bearing, settlement, sliding, piles</td>
                    </tr>
                    <tr class="bg-slate-50">
                      <td class="border border-gray-200 px-4 py-3 font-medium">Geotechnics, DE annex</td>
                      <td class="border border-gray-200 px-4 py-3">DIN 1054:2021-04</td>
                      <td class="border border-gray-200 px-4 py-3">Supplementary rules to EC 7, geotechnical categories GK 1–3</td>
                    </tr>
                    <tr>
                      <td class="border border-gray-200 px-4 py-3 font-medium">Ground investigation</td>
                      <td class="border border-gray-200 px-4 py-3">DIN EN ISO 14688-1/-2, DIN EN ISO 22475-1</td>
