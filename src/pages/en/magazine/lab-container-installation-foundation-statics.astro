                      <td class="border border-gray-200 px-4 py-3">DIN 18533-1 to -3</td>
                      <td class="border border-gray-200 px-4 py-3">Waterproofing of ground-contacting elements (ground slab, strip foundation)</td>
                    </tr>
                    <tr class="bg-slate-50">
                      <td class="border border-gray-200 px-4 py-3 font-medium">Operating cranes</td>
                      <td class="border border-gray-200 px-4 py-3">DGUV Regulation 52 + DGUV Rule 100-500 Ch. 2.8</td>
                      <td class="border border-gray-200 px-4 py-3">Installation, testing, qualified operator, standing area</td>
                    </tr>
                    <tr>
                      <td class="border border-gray-200 px-4 py-3 font-medium">Abnormal-load transport</td>
                      <td class="border border-gray-200 px-4 py-3">§29 para. 3 StVZO + RGST 1992</td>
                      <td class="border border-gray-200 px-4 py-3">Large and heavy transport (GST), escort BF3/police</td>
                    </tr>
                    <tr class="bg-slate-50">
                      <td class="border border-gray-200 px-4 py-3 font-medium">Authorisation to submit building documents</td>
                      <td class="border border-gray-200 px-4 py-3">State building code (LBO/MBO §65 ff.)</td>
                      <td class="border border-gray-200 px-4 py-3">Who signs the stability proof (varies by federal state)</td>
                    </tr>
                    <tr>
                      <td class="border border-gray-200 px-4 py-3 font-medium">Soil protection / contaminated land</td>
                      <td class="border border-gray-200 px-4 py-3">BBodSchG + BBodSchV</td>
