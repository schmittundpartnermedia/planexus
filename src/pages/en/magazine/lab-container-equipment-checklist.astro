                      <th class="px-4 py-3 text-left font-bold">40 foot (~28 m²)</th>
                    </tr>
                  </thead>
                  <tbody class="divide-y divide-gray-200">
                    <tr class="bg-white"><td class="px-4 py-3 font-medium">Workplaces</td><td class="px-4 py-3">1</td><td class="px-4 py-3">2–3</td><td class="px-4 py-3">4–6</td></tr>
