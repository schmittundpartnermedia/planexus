---
import Layout from '../../../layouts/Layout.astro';
import Picture from '../../../components/Picture.astro';
import RelatedArticles from '../../../components/RelatedArticles.astro';
---

<Layout
  type="article"
  title="analytica 2026 – LABtoGO premiere"
  description="analytica 2026 review: Planexus presents the LABtoGO live in Munich. Walk-in LABtoGO and award as a leading provider."
  canonical="/en/magazine/analytica-2026-review-labtogo-premiere"
  ogImage="/images/analytica-2026/hero.jpg"
>
  <div class="pt-20 min-h-screen bg-white">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Article",
      "headline": "analytica 2026 review – Planexus presents the LABtoGO",
      "description": "Review of analytica 2026: Planexus unveils the LABtoGO for the first time. Walk-in LABtoGO, overwhelming response and award as a leading provider of innovative laboratory spaces.",
      "author": { "@type": "Person", "name": "Sven Biewald", "url": "https://planexus.de/en/team/sven-biewald", "jobTitle": "Managing Director", "worksFor": { "@type": "Organization", "name": "Planexus GmbH" } },
      "datePublished": "2026-04-02",
      "dateModified": "2026-04-02",
      "image": "https://planexus.de/images/analytica-2026/hero.jpg",
      "publisher": { "@type": "Organization", "name": "Planexus GmbH", "logo": { "@type": "ImageObject", "url": "https://planexus.de/images/planexus-logo.png" } }
    })} />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://planexus.de/en" },
        { "@type": "ListItem", "position": 2, "name": "Magazine", "item": "https://planexus.de/en/magazine" },
        { "@type": "ListItem", "position": 3, "name": "analytica 2026 review", "item": "https://planexus.de/en/magazine/analytica-2026-review-labtogo-premiere" }
      ]
    })} />

    <article class="max-w-4xl mx-auto px-4 py-16">
      <nav class="flex items-center gap-2 text-sm text-slate-500 mb-8">
        <a href="/en" class="hover:text-primary transition-colors">Home</a>
        <span>›</span>
        <a href="/en/magazine" class="hover:text-primary transition-colors">Magazine</a>
        <span>›</span>
        <span class="text-slate-900">analytica 2026 review</span>
      </nav>

      <header class="mb-12">
        <div class="flex items-center gap-4 mb-6">
          <span class="bg-[#bbd700]/10 text-[#7a9900] text-xs font-bold px-3 py-1 rounded-full uppercase tracking-wider">Trade fairs &amp; events</span>
          <span class="text-slate-400 text-sm">2 April 2026</span>
        </div>
        <h1 class="text-3xl md:text-5xl font-bold text-slate-900 mb-6 leading-tight">
          analytica 2026 — Planexus presents the <span class="text-[#bbd700]">LABtoGO</span>
        </h1>
        <p class="text-xl text-slate-600 leading-relaxed">
          Four days in Munich, a walk-in laboratory container and plenty to talk about: a review of analytica 2026.
        </p>
      </header>

      <figure class="mb-12 rounded-2xl overflow-hidden">
        <Picture
          src="/images/analytica-2026/hero.jpg"
          alt="Planexus and Wesemann exhibition stand at analytica 2026 in Munich — Hall B2, Stand 322"
          class="w-full h-auto"
          loading="eager"
          fetchpriority="high"
                          width={1600}
                  height={900}
                />
        <figcaption class="text-sm text-slate-500 mt-3 text-center">Planexus &amp; Wesemann exhibition stand — analytica 2026, Hall B2, Stand 322</figcaption>
      </figure>

      <div class="prose prose-lg prose-slate max-w-none">

        <h2 class="text-2xl font-bold text-slate-900 mt-12 mb-4">The premiere</h2>
        <p class="text-slate-700 leading-relaxed mb-6">
          From 24 to 27 March 2026 Planexus exhibited for the first time with its own stand at <strong>analytica in Munich</strong> — the world’s leading trade fair for laboratory technology, analysis and biotechnology. In the luggage: the <a href="/en/lab-containers/labtogo" class="text-[#7a9900] font-semibold hover:underline">LABtoGO</a>, our fully prefabricated <a href="/en/services/modular-construction" class="text-[#7a9900] font-semibold hover:underline">LABtoGO</a>, shown live to a broad professional audience for the first time.
        </p>

        <h2 class="text-2xl font-bold text-slate-900 mt-12 mb-4">Walk-in, hands-on, convincing</h2>
        <p class="text-slate-700 leading-relaxed mb-6">
          What made our exhibition appearance special: the LABtoGO did not stand on the stand as a model or a rendering, but as a <strong>complete, walk-in laboratory container</strong> — fully fitted with <a href="/en/partners" class="text-[#7a9900] font-semibold hover:underline">Wesemann laboratory furniture</a>, a Protect fume cupboard, ESD flooring, integrated <a href="/en/services/equipment" class="text-[#7a9900] font-semibold hover:underline">HVAC</a> and <a href="/en/services/smart-lab" class="text-[#7a9900] font-semibold hover:underline">Smart Lab technology</a>. Visitors could see for themselves what 9.50 metres of laboratory container mean in practice: real work surfaces, real room height, a real laboratory.
        </p>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 my-10">
          <div class="rounded-xl overflow-hidden">
            <Picture src="/images/analytica-2026/stand-uebersicht.jpg" alt="LABtoGO laboratory container at analytica 2026 — overall view of the exhibition stand with visitors" class="w-full h-full object-cover" loading="lazy" width={1600} height={900} />
          </div>
          <div class="rounded-xl overflow-hidden">
            <Picture src="/images/analytica-2026/fachgespraeche.jpg" alt="Technical discussions at the Planexus stand at analytica 2026 — visitors finding out about the LABtoGO" class="w-full h-full object-cover" loading="lazy" width={1600} height={903} />
          </div>
        </div>

        <h2 class="text-2xl font-bold text-slate-900 mt-12 mb-4">The response</h2>
        <p class="text-slate-700 leading-relaxed mb-6">
          The reactions overwhelmed us. Over four exhibition days we held hundreds of technical conversations — with researchers, laboratory managers, facility managers, architects and decision-makers from pharma, biotech, chemicals and the public sector. Interest in the “plug &amp; play laboratory” concept was enormous: many visitors knew mobile laboratories only as cramped stopgaps. That a container laboratory can also be fully specified, spacious and high-quality was a genuine surprise for many.
        </p>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-4 my-10">
          <div class="rounded-xl overflow-hidden">
            <Picture src="/images/analytica-2026/innenansicht.jpg" alt="LABtoGO interior — work surfaces on both sides with a complete laboratory fit-out" class="w-full h-full object-cover" loading="lazy" width={1600} height={900} />
          </div>
          <div class="rounded-xl overflow-hidden">
            <Picture src="/images/analytica-2026/arbeitsflaeche.jpg" alt="Laboratory work surface in the LABtoGO with media supply, test tubes and laboratory instruments" class="w-full h-full object-cover" loading="lazy" width={1600} height={900} />
          </div>
          <div class="rounded-xl overflow-hidden">
            <Picture src="/images/analytica-2026/wandorganizer.jpg" alt="Better Basics laboratory organisation in the LABtoGO — wall organiser with laboratory utensils" class="w-full h-full object-cover" loading="lazy" width={1600} height={900} />
          </div>
        </div>

        <h2 class="text-2xl font-bold text-slate-900 mt-12 mb-4">Awarded at the fair</h2>
        <p class="text-slate-700 leading-relaxed mb-6">
          While analytica was still running, a special piece of news reached us: <strong>EU Business News</strong> has recognised Planexus in the <a href="https://www.eubusinessnews.com/winners/planexus-gmbh/" target="_blank" rel="noopener noreferrer" class="text-[#7a9900] font-semibold hover:underline">German CEO Excellence Awards</a> as <strong>“Leading Provider of Innovative Laboratory Spaces 2026”</strong>. Confirmation that strengthens us on our path.
        </p>

        <div class="bg-slate-50 rounded-2xl p-8 my-10 border border-slate-100">
          <div class="flex items-center gap-3 mb-3">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8 text-[#bbd700]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9H4.5a2.5 2.5 0 0 1 0-5H6"/><path d="M18 9h1.5a2.5 2.5 0 0 0 0-5H18"/><path d="M4 22h16"/><path d="M10 14.66V17c0 .55-.47.98-.97 1.21C7.85 18.75 7 20.24 7 22"/><path d="M14 14.66V17c0 .55.47.98.97 1.21C16.15 18.75 17 20.24 17 22"/><path d="M18 2H6v7a6 6 0 0 0 12 0V2Z"/></svg>
            <div>
              <p class="font-bold text-slate-900">Leading Provider of Innovative Laboratory Spaces 2026</p>
              <p class="text-sm text-slate-500">German CEO Excellence Awards — EU Business News</p>
            </div>
          </div>
        </div>

        <h2 class="text-2xl font-bold text-slate-900 mt-12 mb-4">Together with Wesemann</h2>
        <p class="text-slate-700 leading-relaxed mb-6">
          Our exhibition appearance would not have been possible in this form without <strong>Wesemann laboratory furniture</strong>. As part of the <a href="/en/about" class="text-[#7a9900] font-semibold hover:underline">Wesemann Holding</a> we combine container-construction expertise with more than 60 years of experience in laboratory furniture — a combination that makes the LABtoGO unique.
        </p>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 my-10">
          <div class="rounded-xl overflow-hidden">
            <Picture src="/images/analytica-2026/rueckseite.jpg" alt="LABtoGO rear at analytica 2026 — RAL 7016 anthracite with integrated air-conditioning unit" class="w-full h-full object-cover" loading="lazy" width={675} height={1200} />
          </div>
          <div class="rounded-xl overflow-hidden">
            <Picture src="/images/analytica-2026/infowand.jpg" alt="LABtoGO information wall at analytica 2026 — modular containers and innovative laboratory solutions" class="w-full h-full object-cover" loading="lazy" width={1600} height={899} />
          </div>
        </div>

        <h2 class="text-2xl font-bold text-slate-900 mt-12 mb-4">What happens next?</h2>
        <p class="text-slate-700 leading-relaxed mb-6">
          analytica 2026 was the starting gun. The LABtoGO is available with immediate effect — for viewings, <a href="/en/services/consulting" class="text-[#7a9900] font-semibold hover:underline">consultations</a> and first projects. If you were at the fair and would like to continue the conversation, or if you missed the LABtoGO and want to see it live: we look forward to your enquiry.
        </p>

      </div>

      <div class="mt-16 pt-12 border-t border-slate-100">
        <h2 class="text-2xl font-bold text-slate-900 mb-8">Frequently asked questions about analytica 2026</h2>
        <div class="space-y-4">
          <details class="bg-slate-50 rounded-xl border border-gray-100 overflow-hidden group">
            <summary class="flex items-center justify-between p-6 cursor-pointer font-bold text-slate-900 hover:text-primary transition-colors">
              What is the LABtoGO?
              <svg class="w-5 h-5 shrink-0 text-primary transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
            </summary>
            <div class="px-6 pb-6 text-gray-600 leading-relaxed">The <a href="/en/lab-containers/labtogo" class="text-[#7a9900] hover:underline">LABtoGO</a> is a standardised plug &amp; play laboratory container from Planexus. At 9,500 x 3,000 x 3,400 mm external dimensions it offers significantly more space than conventional laboratory containers and is 100% prefabricated in the works.</div>
          </details>
          <details class="bg-slate-50 rounded-xl border border-gray-100 overflow-hidden group">
            <summary class="flex items-center justify-between p-6 cursor-pointer font-bold text-slate-900 hover:text-primary transition-colors">
              When did analytica 2026 take place?
              <svg class="w-5 h-5 shrink-0 text-primary transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
            </summary>
            <div class="px-6 pb-6 text-gray-600 leading-relaxed">analytica 2026 took place from 24 to 27 March 2026 at the Munich exhibition centre. Planexus exhibited in Hall B2, Stand 322, with the walk-in LABtoGO.</div>
          </details>
          <details class="bg-slate-50 rounded-xl border border-gray-100 overflow-hidden group">
            <summary class="flex items-center justify-between p-6 cursor-pointer font-bold text-slate-900 hover:text-primary transition-colors">
              Which award did Planexus receive?
              <svg class="w-5 h-5 shrink-0 text-primary transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
            </summary>
            <div class="px-6 pb-6 text-gray-600 leading-relaxed">Planexus was recognised by EU Business News in the German CEO Excellence Awards as “Leading Provider of Innovative Laboratory Spaces 2026”. More about <a href="/en/about" class="text-[#7a9900] hover:underline">Planexus</a>.</div>
          </details>
          <details class="bg-slate-50 rounded-xl border border-gray-100 overflow-hidden group">
            <summary class="flex items-center justify-between p-6 cursor-pointer font-bold text-slate-900 hover:text-primary transition-colors">
              Can I view the LABtoGO?
              <svg class="w-5 h-5 shrink-0 text-primary transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
            </summary>
            <div class="px-6 pb-6 text-gray-600 leading-relaxed">Yes, the LABtoGO is available for viewings with immediate effect. <a href="/en/contact" class="text-[#7a9900] hover:underline">Contact us</a> for an appointment at our site in Albstadt.</div>
          </details>
          <details class="bg-slate-50 rounded-xl border border-gray-100 overflow-hidden group">
            <summary class="flex items-center justify-between p-6 cursor-pointer font-bold text-slate-900 hover:text-primary transition-colors">
              Who is Wesemann and what role does the company play?
              <svg class="w-5 h-5 shrink-0 text-primary transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
            </summary>
            <div class="px-6 pb-6 text-gray-600 leading-relaxed">Planexus is part of <a href="/en/about" class="text-[#7a9900] hover:underline">Wesemann Holding GmbH</a>. Wesemann laboratory furniture brings more than 60 years of experience in laboratory furniture — this combination of container-construction expertise and laboratory fit-out know-how makes the LABtoGO unique.</div>
          </details>
          <details class="bg-slate-50 rounded-xl border border-gray-100 overflow-hidden group">
            <summary class="flex items-center justify-between p-6 cursor-pointer font-bold text-slate-900 hover:text-primary transition-colors">
              Which laboratory types is the LABtoGO suitable for?
              <svg class="w-5 h-5 shrink-0 text-primary transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
            </summary>
            <div class="px-6 pb-6 text-gray-600 leading-relaxed">The LABtoGO is suitable for instrument laboratories, chemistry laboratories, <a href="/en/magazine/bsl-2-bsl-3-container-lab" class="text-[#7a9900] hover:underline">BSL-2 laboratories</a>, quality control and more. The modular <a href="/en/services/equipment" class="text-[#7a9900] hover:underline">laboratory fit-out</a> is tailored individually to the intended use.</div>
          </details>
        </div>
      </div>

      <div class="flex flex-col sm:flex-row gap-4 mt-12 pt-8 border-t border-slate-100">
        <a href="/en/lab-containers/labtogo" class="inline-flex items-center justify-center gap-2 bg-[#bbd700] hover:bg-[#a8c200] text-slate-900 font-bold px-8 py-4 rounded-lg text-sm transition-colors">
          Discover LABtoGO
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
        </a>
        <a href="/en/contact" class="inline-flex items-center justify-center gap-2 border-2 border-slate-200 text-slate-700 font-bold px-8 py-4 rounded-lg text-sm hover:border-[#bbd700] transition-colors">
          Get in touch
        </a>
      </div>

      <div class="mt-12 pt-8 border-t border-slate-100">
        <h3 class="font-bold text-slate-900 mb-4">Further articles</h3>
        <ul class="space-y-2 text-sm">
          <li><a href="/en/magazine/innovation-modular-construction-mobile-lab" class="text-primary hover:underline">Innovation in modular construction: the future of the mobile laboratory</a></li>
          <li><a href="/en/magazine/lab-container-project-process" class="text-primary hover:underline">Laboratory container project process from idea to handover</a></li>
        </ul>
        <p class="text-sm text-slate-400 mt-8">Author: Sven Biewald · Published on 2 April 2026</p>
      </div>
    </article>

    <RelatedArticles slug="analytica-2026-rueckblick-labtogo-premiere" locale="en" />
  </div>
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      { "@type": "Question", "name": "What is the LABtoGO?", "acceptedAnswer": { "@type": "Answer", "text": "The LABtoGO is a standardised plug & play laboratory container from Planexus. At 9,500 x 3,000 x 3,400 mm external dimensions it offers significantly more space than conventional laboratory containers and is 100% prefabricated in the works." }},
      { "@type": "Question", "name": "When did analytica 2026 take place?", "acceptedAnswer": { "@type": "Answer", "text": "analytica 2026 took place from 24 to 27 March 2026 at the Munich exhibition centre. Planexus exhibited in Hall B2, Stand 322, with the walk-in LABtoGO." }},
      { "@type": "Question", "name": "Which award did Planexus receive?", "acceptedAnswer": { "@type": "Answer", "text": "Planexus was recognised by EU Business News in the German CEO Excellence Awards as Leading Provider of Innovative Laboratory Spaces 2026." }},
      { "@type": "Question", "name": "Can I view the LABtoGO?", "acceptedAnswer": { "@type": "Answer", "text": "Yes, the LABtoGO is available for viewings with immediate effect. Contact Planexus for an appointment at the Albstadt site." }},
      { "@type": "Question", "name": "Who is Wesemann and what role does the company play?", "acceptedAnswer": { "@type": "Answer", "text": "Planexus is part of Wesemann Holding GmbH. Wesemann laboratory furniture brings more than 60 years of experience in laboratory furniture — this combination of container-construction expertise and laboratory fit-out know-how makes the LABtoGO unique." }},
      { "@type": "Question", "name": "Which laboratory types is the LABtoGO suitable for?", "acceptedAnswer": { "@type": "Answer", "text": "The LABtoGO is suitable for instrument laboratories, chemistry laboratories, BSL-2 laboratories, quality control and more. The modular laboratory fit-out is tailored individually to the intended use." }}
    ]
  })} />
</Layout>
