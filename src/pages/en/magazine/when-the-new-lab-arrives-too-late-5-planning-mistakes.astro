const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    { "@type": "Question", "name": "How much contingency should I allow for permitting a lab container?", "acceptedAnswer": { "@type": "Answer", "text": "Allow at least six to eight weeks of contingency for each permitting step. For a BSL-2 laboratory, the opinion of the Central Committee on Biological Safety (ZKBS) alone takes eight to sixteen weeks, and the building permit six to twelve weeks. These periods do not always run in parallel." } },
    { "@type": "Question", "name": "What is the difference between a BSL-2 and a BSL-3 lab container?", "acceptedAnswer": { "@type": "Answer", "text": "BSL-2 applies to Risk Group 2 organisms and requires, among other things, a negative pressure of at least 20 pascals, a Class II microbiological safety cabinet and autoclavable waste routes. BSL-3 for Risk Group 3 requires multi-stage airlocks, interlocked double doors, HEPA filtration and autoclavable pass-throughs." } },
    { "@type": "Question", "name": "Can a lab container later be upgraded to a higher containment level?", "acceptedAnswer": { "@type": "Answer", "text": "In a modularly planned lab container, the upgrade path is designed in from the outset: ventilation ducts are sized for later filtration, wall surfaces are coated for autoclave-compatible cleaning, and airlock doors are specified to the required openings. Conversion to BSL-2 standard is then possible within around four weeks – at roughly one third of the effort of a conventional solution." } },
