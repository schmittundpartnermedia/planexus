                  </label>
                  <label class="flex items-start gap-3 cursor-pointer">
                    <input type="checkbox" class="mt-1 w-4 h-4 text-primary border-gray-300 rounded" />
                    <span class="text-sm text-gray-700">Equipment list with heat dissipation (watts) prepared?</span>
                  </label>
