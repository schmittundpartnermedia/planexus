const pageUrl = "https://planexus.de/en/magazine/fume-cupboard-testing";
const headline = "Fume cupboard testing: obligations, intervals and procedure";
const description = "Fume cupboard testing in Germany: at least annually by a competent person (TRGS 526). Procedure, measurements, EN 14175-4 and the required test record.";

const faqs = [
  {
    q: "How often must a fume cupboard be tested?",
    a: "At least once a year by a competent person (TRGS 526 no. 7.3). Users also check its function every working day, for example the indicator. A self-monitoring continuous monitoring device must be tested at intervals of no more than three years."
  },
  {
    q: "Who may test a fume cupboard?",
    a: "A person qualified to carry out inspections: someone with the necessary knowledge through vocational training, professional experience and recent professional activity (section 2(6) of the German Industrial Safety Regulation, BetrSichV). The BG RCI checklist names a course with the fume cupboard manufacturer or comparable professional experience as the prerequisite."
  },
  {
    q: "What does the fume cupboard test cover?",
    a: "A visual inspection, the sash mechanics, the airflow values (face velocity and/or exhaust volume flow) and the monitoring unit with alarms for under-function, over-function and power failure (DGUV Information 213-857, no. 2.3.3). Variable air volume cupboards also need their control loop checked."
  },
  {
    q: "Can the annual measurement be dropped?",
    a: "Only the test of the airflow function, and only with self-monitoring function control that signals a drop below the minimum volume flow visually and audibly (TRGS 526 no. 7.3). A monitoring unit to DIN 12924:1991 does not count as self-monitoring. Visual inspection and mechanics remain annual."
  },
  {
    q: "What must the test record contain?",
    a: "Under section 14(7) BetrSichV at least the type of test, its scope, the result and the name and signature of the competent person. The record must be kept at least until the next test; electronic records are permitted."
  },
  {
    q: "Is a tracer-gas test part of the annual test?",
    a: "Not for type-tested fume cupboards. According to the published table of contents of EN 14175-4, the routine test in chapter 6 does not list containment. The standard describes an on-site containment test at commissioning and for fume cupboards without a type test."
  },
  {
    q: "What happens if the fume cupboard fails the test?",
    a: "Significant defects must be remedied without delay, for example a worn sash cable. If that is not possible, the fume cupboard must be taken out of service (DGUV Information 213-857, no. 2.3.3)."
  },
  {
    q: "Does the testing obligation also apply to bench-mounted fume cupboards?",
    a: "Yes. The bench-mounted cupboard is one design alongside low-level and walk-in cupboards, and TRGS 526 no. 7.3 applies to all of them. Fume cupboards with recirculation or filter technology are also tested annually, the filters as specified by the manufacturer."
  }
];

