---
import Layout from '../../../layouts/Layout.astro';
import Picture from '../../../components/Picture.astro';

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": "Rent vs buy a lab container: a decision guide for research leads",
  "description": "Rent or buy? A decision aid with an economic comparison, break-even rule of thumb and practical checklist for lab containers — honest and without empty promises.",
  "author": { "@type": "Person", "name": "Sven Biewald", "url": "https://planexus.de/en/team/sven-biewald", "jobTitle": "Managing Director", "worksFor": { "@type": "Organization", "name": "Planexus GmbH" } },
  "datePublished": "2026-02-10",
  "dateModified": "2026-06-25",
  "image": "https://planexus.de/images/blog-laborcontainer-mieten-oder-kaufen.jpg",
  "publisher": { "@type": "Organization", "name": "Planexus GmbH", "logo": { "@type": "ImageObject", "url": "https://planexus.de/images/planexus-logo.png" } },
  "mainEntityOfPage": { "@type": "WebPage", "@id": "https://planexus.de/en/magazine/lab-containers-rent-or-buy" }
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://planexus.de/en" },
    { "@type": "ListItem", "position": 2, "name": "Magazine", "item": "https://planexus.de/en/magazine" },
    { "@type": "ListItem", "position": 3, "name": "Rent or buy a lab container", "item": "https://planexus.de/en/magazine/lab-containers-rent-or-buy" }
  ]
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    { "@type": "Question", "name": "How long does delivery of a rented lab container take?", "acceptedAnswer": { "@type": "Answer", "text": "Standard models are typically ready for use within two to three weeks. Complex quality-control or containment laboratories with specialist equipment need six to eight weeks of lead time. Allow around one additional week for acceptance and commissioning." } },
    { "@type": "Question", "name": "Which biosafety level do I need for microbiological research?", "acceptedAnswer": { "@type": "Answer", "text": "BSL-2 is sufficient for most bacterial and viral pathogens without airborne transmission. BSL-3 is required for pathogens with a high infection risk via aerosols. Binding classifications are issued by the Central Committee on Biological Safety (ZKBS)." } },
    { "@type": "Question", "name": "Can I later resell a purchased lab container?", "acceptedAnswer": { "@type": "Answer", "text": "Yes. After around five years the resale value is typically about 40 to 50 per cent of the new value. Highly specialised equipment reduces demand — standard configurations are considerably easier to sell than custom solutions." } },
    { "@type": "Question", "name": "What happens if there are technical problems in a rented container?", "acceptedAnswer": { "@type": "Answer", "text": "Reputable suppliers guarantee response times of 24 to 48 hours. For critical systems such as climate control or fume cupboards there are often service-level agreements with a four-hour response time. Check these clauses carefully before signing the contract." } },
    { "@type": "Question", "name": "What requirements apply to the installation site of a lab container?", "acceptedAnswer": { "@type": "Answer", "text": "You need load-bearing ground (at least around 200 kg/m²), power and water connections and wastewater disposal. Distances to buildings must meet fire-protection requirements — usually at least five metres. Existing buildings may be subject to special rules." } }
  ]
};
import RelatedArticles from '../../../components/RelatedArticles.astro';
---

<Layout
  type="article"
  title="Rent vs buy a lab container? Comparison"
  description="Rent or buy a lab container? A decision aid with an economic comparison, break-even rule of thumb and practical checklist for research leads."
  canonical="/en/magazine/lab-containers-rent-or-buy"
  ogImage="https://planexus.de/images/blog-laborcontainer-mieten-oder-kaufen.jpg"
>
  <div class="pt-20 min-h-screen bg-white">
    <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

    <section class="relative py-20 bg-slate-900 text-white overflow-hidden">
      <div class="absolute inset-0 bg-[url('/images/blog-laborcontainer-mieten-oder-kaufen.jpg')] bg-cover bg-center opacity-30"></div>
      <div class="absolute inset-0 bg-gradient-to-t from-slate-900 via-slate-900/90 to-slate-900/70"></div>
      <div class="container mx-auto px-4 relative z-10">
        <div class="max-w-4xl mx-auto">
          <div class="flex items-center gap-4 mb-6">
            <span class="bg-primary/20 text-primary px-4 py-1.5 rounded-full text-sm font-medium flex items-center gap-2">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m16 16 3-8 3 8c-.87.65-1.92 1-3 1s-2.13-.35-3-1Z"/><path d="m2 16 3-8 3 8c-.87.65-1.92 1-3 1s-2.13-.35-3-1Z"/><path d="M7 21h10"/><path d="M12 3v18"/><path d="M3 7h2c2 0 5-1 7-2 2 1 5 2 7 2h2"/></svg>
              Guide
            </span>
            <span class="text-gray-400 text-sm flex items-center gap-2">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
              9 min read
            </span>
          </div>
          <h1 class="text-3xl md:text-5xl font-heading font-bold mb-6 leading-tight">
            Rent vs buy a lab container — a guide for research leads
          </h1>
          <p class="text-xl text-gray-300 mb-8 leading-relaxed">
            Rent or buy? The answer depends on budget, project duration and long-term goals. Choose wrongly and you tie up capital unnecessarily or lose flexibility. This guide shows which factors really count — with a clear rule of thumb, a decision matrix and a practical checklist.
          </p>
          <div class="flex items-center gap-6 text-sm text-gray-400">
            <span class="flex items-center gap-2">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="4" rx="2" ry="2"/><line x1="16" x2="16" y1="2" y2="6"/><line x1="8" x2="8" y1="2" y2="6"/><line x1="3" x2="21" y1="10" y2="10"/></svg>
              10 February 2026
            </span>
            <span class="flex items-center gap-2">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
              Sven Biewald, Managing Director Planexus
            </span>
          </div>
        </div>
      </div>
    </section>

    <div class="bg-slate-50 border-b border-gray-100 py-4">
      <div class="container mx-auto px-4">
        <div class="flex items-center gap-2 text-sm text-gray-500">
          <a href="/en" class="hover:text-primary">Home</a>
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg>
          <a href="/en/magazine" class="hover:text-primary">Magazine</a>
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg>
          <span class="text-primary font-medium">Rent or buy a lab container</span>
        </div>
      </div>
    </div>

    <article class="py-16">
      <div class="container mx-auto px-4">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-12">
          <div class="lg:col-span-8">
            <div class="prose prose-lg max-w-none">

              <p class="text-xl text-gray-700 leading-relaxed mb-8">
                Research leads face a central question: rent a lab container or buy one outright? Both routes have their place — but the right choice is not a matter of taste; it is a calculation. It hangs on project duration, capital commitment, flexibility and utilisation. This article makes the decision tangible, without fobbing you off with promises.
              </p>

              <p class="text-gray-600 leading-relaxed mb-6">
                At Planexus we accompany research institutions through exactly this weighing-up. Our experience: the best choice is not always the obvious one. A mobile laboratory must fit your research rhythm — not the other way round.
              </p>

              <div class="not-prose bg-slate-50 border border-gray-200 rounded-2xl p-6 my-8">
                <p class="text-sm font-bold text-slate-900 mb-4">Already decided? Go straight to the relevant pages:</p>
                <div class="grid sm:grid-cols-2 gap-4">
                  <a href="/en/rent-lab-containers" class="flex items-center justify-between gap-3 bg-white border border-gray-200 rounded-xl px-5 py-4 hover:border-primary hover:shadow-md transition-all group">
                    <span class="font-bold text-slate-900 group-hover:text-primary transition-colors">Rent a lab container</span>
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-primary shrink-0"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
                  </a>
                  <a href="/en/buy-lab-containers" class="flex items-center justify-between gap-3 bg-white border border-gray-200 rounded-xl px-5 py-4 hover:border-primary hover:shadow-md transition-all group">
                    <span class="font-bold text-slate-900 group-hover:text-primary transition-colors">Buy a lab container</span>
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-primary shrink-0"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
                  </a>
                </div>
              </div>

              <figure class="my-10">
                <Picture
                  src="/images/blog-laborcontainer-mieten-oder-kaufen.jpg"
                  alt="Modern Planexus lab container — rent or buy decision guide for research leads"
                  width={1280}
                  height={720}
                  loading="eager"
                  fetchpriority="high"
                  class="w-full rounded-2xl shadow-lg"
                />
                <figcaption class="text-sm text-gray-500 mt-3 text-center italic">
                  Lab containers as flexible research infrastructure: whether renting or buying is more economical depends on your duration of use.
                </figcaption>
              </figure>

              <h2 class="text-2xl font-heading font-bold text-slate-900 mt-12 mb-6">Cost comparison: what do you actually pay?</h2>

              <p class="text-gray-600 leading-relaxed mb-6">
                Purchasing a new lab container sits — depending on specification and biosafety level — in a quite different order of magnitude from the monthly rental. BSL-2 and especially BSL-3 laboratories sit well above simple analytical laboratories, because ventilation, filtration and pressure control drive the effort. We deliberately name specific figures only in an individual quotation, because every configuration is costed independently.
              </p>

              <p class="text-gray-600 leading-relaxed mb-6">
                For the fundamental decision you do not need unit prices anyway, but a simple rule of thumb: <strong>purchase price divided by the monthly rent gives the break-even duration of use in months.</strong> If your planned project duration is below that, renting is more economical; if it is above, that speaks for purchase. In practice this break-even usually sits at around four years. Also include the running items: maintenance of typically two to four per cent of the acquisition value per year, plus insurance.
              </p>

              <p class="text-gray-600 leading-relaxed mb-6">
                Hidden costs of purchase include site rent, permits and possibly necessary adaptations after three to five years. When renting, these items are generally borne by the supplier of the modular laboratory solution — a factor that often disappears in a pure comparison of purchase price and rent.
              </p>

              <h2 class="text-2xl font-heading font-bold text-slate-900 mt-12 mb-6">Decision matrix: when does which option make sense?</h2>

              <p class="text-gray-600 leading-relaxed mb-6">
                The following overview summarises the seven criteria that in practice decide the outcome. The more points in a column apply to your situation, the clearer the direction.
              </p>

              <div class="overflow-x-auto my-8">
                <table class="w-full text-sm border-collapse border border-gray-200">
                  <thead class="bg-slate-100">
                    <tr>
                      <th class="border border-gray-200 px-4 py-3 text-left font-bold text-slate-900">Criterion</th>
                      <th class="border border-gray-200 px-4 py-3 text-left font-bold text-slate-900">Speaks for renting</th>
                      <th class="border border-gray-200 px-4 py-3 text-left font-bold text-slate-900">Speaks for buying</th>
                    </tr>
                  </thead>
                  <tbody class="text-gray-700">
                    <tr>
                      <td class="border border-gray-200 px-4 py-3 font-medium">Project duration</td>
                      <td class="border border-gray-200 px-4 py-3">Under 3 years</td>
                      <td class="border border-gray-200 px-4 py-3">Over 5 years</td>
                    </tr>
                    <tr class="bg-slate-50">
                      <td class="border border-gray-200 px-4 py-3 font-medium">Capital commitment</td>
                      <td class="border border-gray-200 px-4 py-3">Capital should flow into core research</td>
                      <td class="border border-gray-200 px-4 py-3">Acquisition is financeable long term</td>
                    </tr>
                    <tr>
                      <td class="border border-gray-200 px-4 py-3 font-medium">Site moves</td>
                      <td class="border border-gray-200 px-4 py-3">More than one relocation in 5 years</td>
                      <td class="border border-gray-200 px-4 py-3">Fixed, permanent site</td>
                    </tr>
                    <tr class="bg-slate-50">
                      <td class="border border-gray-200 px-4 py-3 font-medium">Utilisation</td>
                      <td class="border border-gray-200 px-4 py-3">Under 70% use</td>
                      <td class="border border-gray-200 px-4 py-3">Permanently high utilisation</td>
                    </tr>
                    <tr>
                      <td class="border border-gray-200 px-4 py-3 font-medium">Technology change</td>
                      <td class="border border-gray-200 px-4 py-3">Rapid change in the field</td>
                      <td class="border border-gray-200 px-4 py-3">Stable, consistent requirements</td>
                    </tr>
                    <tr class="bg-slate-50">
                      <td class="border border-gray-200 px-4 py-3 font-medium">Adaptations</td>
                      <td class="border border-gray-200 px-4 py-3">Existing stock is sufficient, few special wishes</td>
                      <td class="border border-gray-200 px-4 py-3">Specialist equipment needed from the start</td>
                    </tr>
                    <tr>
                      <td class="border border-gray-200 px-4 py-3 font-medium">Accounting</td>
                      <td class="border border-gray-200 px-4 py-3">Operating resource, predictable expense</td>
                      <td class="border border-gray-200 px-4 py-3">Fixed asset with depreciation</td>
                    </tr>
                  </tbody>
                </table>
              </div>

              <h2 class="text-2xl font-heading font-bold text-slate-900 mt-12 mb-6">Flexibility in day-to-day research</h2>

              <p class="text-gray-600 leading-relaxed mb-6">
                Mobile laboratories offer a decisive advantage: they adapt to changing requirements. A rented lab container can be swapped after six months for a larger model or moved to another site. That adaptability is considerably more involved with purchased units.
              </p>

              <p class="text-gray-600 leading-relaxed mb-6">
                Temporary projects benefit from rental models in particular. Clinical studies, seasonal research programmes or transitional periods during a refurbishment require no capital commitment. Container laboratories can be set up and made operational within a few weeks.
              </p>

              <p class="text-gray-600 leading-relaxed mb-6">
                Those who plan long term and have consistent requirements find stability in purchase. The mobile research facility belongs to you, conversions follow your specifications — no consultation with landlords, no restrictions on modifications.
              </p>

              <h2 class="text-2xl font-heading font-bold text-slate-900 mt-12 mb-6">Technical requirements and equipment</h2>

              <p class="text-gray-600 leading-relaxed mb-6">
                Lab containers differ massively in complexity. An analytical laboratory for routine testing needs different technology from a containment laboratory with BSL-2 or BSL-3 certification. Climate control alone accounts for 30 to 40 per cent of total costs at high biosafety levels.
              </p>

              <p class="text-gray-700 leading-relaxed mb-4 font-medium">Typical standard equipment in rental containers:</p>
              <ul class="space-y-2 text-gray-600 mb-6">
                <li class="flex gap-2"><span class="text-primary font-bold">→</span> <span><strong>Air conditioning:</strong> temperature stability ±2 °C, humidity control</span></li>
                <li class="flex gap-2"><span class="text-primary font-bold">→</span> <span><strong>Extract system:</strong> negative pressure at BSL-2, HEPA filters at BSL-3</span></li>
                <li class="flex gap-2"><span class="text-primary font-bold">→</span> <span><strong>Work surfaces:</strong> chemically resistant, electrostatically dissipative</span></li>
                <li class="flex gap-2"><span class="text-primary font-bold">→</span> <span><strong>Electrics:</strong> 400 V connection, emergency lighting, residual-current devices</span></li>
              </ul>

              <p class="text-gray-600 leading-relaxed mb-6">
                When buying you can plan specialist requirements from the outset. Cleanroom laboratories of class ISO 7 or 8, additional safety airlocks or reinforced floor loads for heavy analytical instruments can be realised directly. When renting you work with the existing stock or pay surcharges for special equipment.
              </p>

              <h2 class="text-2xl font-heading font-bold text-slate-900 mt-12 mb-6">Permits and legal aspects</h2>

              <p class="text-gray-600 leading-relaxed mb-6">
                Fitting out a lab container requires building permits — even for temporary installation. Complexity rises with the biosafety level: BSL-2 laboratories need an official notification; BSL-3 laboratories go through involved approval procedures with inspections.
              </p>

              <p class="text-gray-600 leading-relaxed mb-6">
                Rental suppliers often take on the preliminary clarification with the authorities. They know the regional requirements and supply the necessary evidence. With ownership solutions this responsibility sits with you — including follow-up effort for conditions or remedial work.
              </p>

              <p class="text-gray-600 leading-relaxed mb-6">
                For insurance purposes, rented laboratory modules count as operating resources, owned ones as fixed assets. That affects accounting and depreciation. Speak to your tax adviser in advance about the variant that is optimal for your situation.
              </p>

              <h2 class="text-2xl font-heading font-bold text-slate-900 mt-12 mb-6">When which option pays off</h2>

              <p class="text-gray-600 leading-relaxed mb-6">
                A mobile testing laboratory pays for itself on purchase from a duration of use of four to six years. Renting makes sense for project durations under three years or when you would rather put capital into core research than into infrastructure.
              </p>

              <p class="text-gray-700 leading-relaxed mb-4 font-medium">Practical checklist for your decision:</p>
              <ul class="space-y-2 text-gray-600 mb-6">
                <li class="flex gap-2"><span class="text-primary font-bold">→</span> <span><strong>Project duration:</strong> under 3 years speaks for renting, over 5 years for purchase</span></li>
                <li class="flex gap-2"><span class="text-primary font-bold">→</span> <span><strong>Capital commitment:</strong> Can you tie up the acquisition amount long term?</span></li>
                <li class="flex gap-2"><span class="text-primary font-bold">→</span> <span><strong>Site moves:</strong> more than one relocation in 5 years speaks for renting</span></li>
                <li class="flex gap-2"><span class="text-primary font-bold">→</span> <span><strong>Utilisation:</strong> under 70% use makes ownership uneconomic</span></li>
                <li class="flex gap-2"><span class="text-primary font-bold">→</span> <span><strong>Technology change:</strong> rapid change in your field favours renting</span></li>
              </ul>

              <p class="text-gray-600 leading-relaxed mb-6">
                Also consider opportunity costs. Capital tied up in a purchase could otherwise earn a return of about five to eight per cent. Add these forgone returns mentally to the acquisition costs.
              </p>

              <h2 class="text-2xl font-heading font-bold text-slate-900 mt-12 mb-6">Container construction: what quality depends on</h2>

              <p class="text-gray-600 leading-relaxed mb-6">
                The service life of a lab container hangs on the modular construction. High-quality units last 15 to 20 years; cheaper variants show signs of fatigue after around eight years. Look for a galvanised steel frame — not merely painted constructions.
              </p>

              <p class="text-gray-600 leading-relaxed mb-6">
                Insulation decides operating costs. 100 mm of mineral wool is the minimum; 120 mm is standard for demanding applications. Poorly insulated containers consume up to 40 per cent more energy for climate control — that adds up over the duration of use to noticeable extra cost.
              </p>

              <p class="text-gray-600 leading-relaxed mb-6">
                Planexus designs mobile laboratory facilities with a focus on longevity. Our container equipment takes wear at the critical points into account: door hinges, seals and penetrations are the typical weak spots, which we specify more robustly.
              </p>

              <div class="not-prose bg-primary/10 border border-primary/30 rounded-2xl p-6 my-10">
                <p class="font-bold text-slate-900 mb-2">Decision made?</p>
                <p class="text-gray-700 text-sm mb-4">On our commercial pages you will find rental duration, delivery time, equipment and the process through to handover — and you can request your quotation directly.</p>
                <div class="flex flex-wrap gap-3">
                  <a href="/en/rent-lab-containers" class="inline-flex items-center gap-2 bg-primary text-slate-900 font-bold px-6 py-3 rounded-lg hover:bg-primary/90 transition-colors text-sm">
                    Rent a lab container
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
                  </a>
                  <a href="/en/buy-lab-containers" class="inline-flex items-center gap-2 bg-white text-slate-900 font-bold px-6 py-3 rounded-lg border border-gray-200 hover:border-primary transition-colors text-sm">
                    Buy a lab container
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
                  </a>
                </div>
              </div>

              <div class="bg-slate-900 text-white rounded-2xl p-8 my-12 text-center">
                <h3 class="text-2xl font-bold mb-4 text-primary">Rent or buy — we will work through the figures</h3>
                <p class="text-gray-300 mb-6 max-w-2xl mx-auto">The decision between renting and buying determines your financial room for manoeuvre for years. Together we determine the economically optimal path — transparently and aligned with your research goals. An initial assessment of your project within 48 hours.</p>
                <a href="/en/contact" class="inline-flex items-center gap-2 bg-primary text-slate-900 font-bold px-8 py-4 rounded-lg hover:bg-primary/90 transition-colors">Request a no-obligation initial consultation
                  <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
                </a>
              </div>

            </div>
          </div>

          <aside class="lg:col-span-4">
            <div class="sticky top-28 space-y-8">
              <div class="bg-slate-50 p-6 rounded-2xl border border-gray-100">
                <h4 class="font-bold text-slate-900 mb-4">At a glance</h4>
                <ul class="space-y-3 text-sm text-gray-700">
                  <li class="flex gap-2"><span class="text-primary font-bold">→</span> Rule of thumb: purchase price ÷ monthly rent = break-even in months</li>
                  <li class="flex gap-2"><span class="text-primary font-bold">→</span> Break-even in practice usually around 4 years</li>
                  <li class="flex gap-2"><span class="text-primary font-bold">→</span> Under 3 years’ duration → rent</li>
                  <li class="flex gap-2"><span class="text-primary font-bold">→</span> Over 5 years + stable requirements → buy</li>
                  <li class="flex gap-2"><span class="text-primary font-bold">→</span> Utilisation under 70% → ownership uneconomic</li>
                  <li class="flex gap-2"><span class="text-primary font-bold">→</span> Frequent site moves → rent</li>
                  <li class="flex gap-2"><span class="text-primary font-bold">→</span> Delivery time, standard model: 2–3 weeks</li>
                </ul>
              </div>

              <div class="bg-white border border-gray-100 p-6 rounded-2xl">
                <h4 class="font-bold text-slate-900 mb-4">Further reading</h4>
                <ul class="space-y-3">
                  <li><a href="/en/magazine/lab-container-costs-prices-2026" class="flex items-center gap-2 text-gray-700 hover:text-primary transition-colors text-sm"><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#bbd700" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg>Lab container costs &amp; prices 2026</a></li>
