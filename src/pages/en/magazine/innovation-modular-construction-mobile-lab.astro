---
import Layout from '../../../layouts/Layout.astro';
import RelatedArticles from '../../../components/RelatedArticles.astro';
---

<Layout
  type="article"
  title="Innovation in modular construction: the mobile laboratory"
  description="How modular construction methods increase flexibility in research, and why container laboratories are a genuine alternative to solid construction."
  canonical="/en/magazine/innovation-modular-construction-mobile-lab"
  ogImage="/images/backgrounds/magazin-innovation-modulbau.webp"
>
  <div class="pt-20 min-h-screen bg-white">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Article",
      "headline": "Innovation in modular construction: the future of the mobile laboratory",
      "description": "How modular construction methods increase flexibility in research, and why container laboratories are a genuine alternative to solid construction.",
      "author": { "@type": "Person", "name": "Sven Biewald", "url": "https://planexus.de/en/team/sven-biewald", "jobTitle": "Managing Director", "worksFor": { "@type": "Organization", "name": "Planexus GmbH" } },
      "datePublished": "2026-01-12",
      "dateModified": "2026-01-12",
      "image": "/images/backgrounds/magazin-innovation-modulbau.webp",
      "publisher": { "@type": "Organization", "name": "Planexus GmbH", "logo": { "@type": "ImageObject", "url": "https://planexus.de/images/planexus-logo.png" } }
    })} />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://planexus.de/en" },
        { "@type": "ListItem", "position": 2, "name": "Magazine", "item": "https://planexus.de/en/magazine" },
        { "@type": "ListItem", "position": 3, "name": "Innovation in modular construction", "item": "https://planexus.de/en/magazine/innovation-modular-construction-mobile-lab" }
      ]
    })} />

    <section class="relative py-20 bg-slate-900 text-white overflow-hidden">
      <div class="absolute inset-0 bg-[url('/images/backgrounds/magazin-innovation-modulbau.webp')] bg-cover bg-center opacity-20"></div>
      <div class="absolute inset-0 bg-gradient-to-t from-slate-900 via-slate-900/90 to-slate-900/70"></div>
      <div class="container mx-auto px-4 relative z-10">
        <div class="max-w-4xl mx-auto">
          <div class="flex items-center gap-4 mb-6">
            <span class="bg-primary/20 text-primary px-4 py-1.5 rounded-full text-sm font-medium flex items-center gap-2">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2H2v10l9.29 9.29c.94.94 2.48.94 3.42 0l6.58-6.58c.94-.94.94-2.48 0-3.42L12 2Z"/><path d="M7 7h.01"/></svg>
              Technology
            </span>
            <span class="text-gray-400 text-sm flex items-center gap-2">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
              12 min read
            </span>
          </div>
          <h1 class="text-3xl md:text-5xl font-heading font-bold mb-6 leading-tight">
            Innovation in modular construction: the future of the mobile laboratory
          </h1>
          <p class="text-xl text-gray-300 mb-8 leading-relaxed">
            How modular construction methods increase flexibility in research, and why container laboratories are a genuine alternative to solid construction.
          </p>
          <div class="flex items-center gap-6 text-sm text-gray-400">
            <span class="flex items-center gap-2">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="4" rx="2" ry="2"/><line x1="16" x2="16" y1="2" y2="6"/><line x1="8" x2="8" y1="2" y2="6"/><line x1="3" x2="21" y1="10" y2="10"/></svg>
              12 January 2026
            </span>
            <span class="flex items-center gap-2">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
              Sven Biewald
            </span>
          </div>
        </div>
      </div>
    </section>

    <div class="bg-slate-50 border-b border-gray-100 py-4">
      <div class="container mx-auto px-4">
        <div class="flex items-center gap-2 text-sm text-gray-500">
          <a href="/en" class="hover:text-primary">Home</a>
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
          <a href="/en/magazine" class="hover:text-primary">Magazine</a>
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
          <span class="text-primary font-medium">Innovation in modular construction</span>
        </div>
      </div>
    </div>

    <article class="py-16">
      <div class="container mx-auto px-4">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-12">
          <div class="lg:col-span-8">
            <div class="prose prose-lg max-w-none">

              <p class="text-xl text-gray-700 leading-relaxed mb-8">
                The world of laboratory research faces a fundamental shift. While traditional laboratory buildings often take years to plan and deliver, modular laboratory construction is revolutionising the way research facilities come into being. In this comprehensive article we examine the innovations in modular construction and show why more and more companies and institutions are turning to mobile laboratory solutions.
              </p>

              <h2 class="text-2xl font-heading font-bold text-slate-900 mt-12 mb-6">
                The paradigm shift in laboratory construction
              </h2>
              <p class="text-gray-600 leading-relaxed mb-6">
                Traditional laboratory planning and construction is a lengthy, cost-intensive process. From the first needs analysis to key handover, three to five years are not uncommon. In a time when scientific requirements change quickly and flexibility becomes the decisive competitive factor, that timescale is often no longer acceptable.
              </p>
              <p class="text-gray-600 leading-relaxed mb-6">
                This is where modular laboratory construction comes in. By prefabricating laboratory modules in controlled production environments, realisation times can be reduced by up to 60 per cent. A fully equipped container laboratory can be planned, manufactured and commissioned within 12 to 16 weeks — a period in which, on conventional projects, the building permit is often still outstanding.
              </p>

              <div class="bg-primary/5 border-l-4 border-primary p-6 rounded-r-xl my-8">
                <div class="flex items-start gap-4">
                  <div class="w-10 h-10 bg-primary/10 rounded-lg flex items-center justify-center shrink-0">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#bbd700" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 14c.2-1 .7-1.7 1.5-2.5 1-.9 1.5-2.2 1.5-3.5A6 6 0 0 0 6 8c0 1 .2 2.2 1.5 3.5.7.7 1.3 1.5 1.5 2.5"/><path d="M9 18h6"/><path d="M10 22h4"/></svg>
                  </div>
                  <div>
                    <h4 class="font-bold text-slate-900 mb-2">Expert tip: early planning pays off</h4>
                    <p class="text-gray-600 text-sm">
                      Begin <a href="/en/services/planning" class="text-primary font-medium hover:underline">technical planning</a> as early as the concept phase. The sooner requirements are defined, the better the container module can be matched to your specific needs — without extra cost from later changes.
                    </p>
                  </div>
                </div>
              </div>

              <h2 class="text-2xl font-heading font-bold text-slate-900 mt-12 mb-6">
                Technological innovations in the container module
              </h2>
              <p class="text-gray-600 leading-relaxed mb-6">
                Modern lab containers have nothing in common with the simple container solutions of the past. Today’s generation of container modules unites advanced materials science, precise manufacturing techniques and intelligent building technology into a unit that in many respects is superior to conventional laboratory buildings.
              </p>

              <div class="grid grid-cols-1 md:grid-cols-2 gap-4 my-8 not-prose">
                <div class="bg-slate-50 p-5 rounded-xl border border-gray-100">
                  <div class="w-10 h-10 bg-primary/10 rounded-lg flex items-center justify-center text-primary mb-3">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z"/><path d="m3.3 7 8.7 5 8.7-5"/><path d="M12 22V12"/></svg>
                  </div>
                  <h4 class="font-bold text-slate-900 mb-1">Modular architecture</h4>
                  <p class="text-gray-600 text-sm">Flexible expansion through standardised interfaces</p>
                </div>
                <div class="bg-slate-50 p-5 rounded-xl border border-gray-100">
                  <div class="w-10 h-10 bg-primary/10 rounded-lg flex items-center justify-center text-primary mb-3">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
                  </div>
                  <h4 class="font-bold text-slate-900 mb-1">Smart integration</h4>
                  <p class="text-gray-600 text-sm">IoT-capable systems for real-time monitoring</p>
                </div>
                <div class="bg-slate-50 p-5 rounded-xl border border-gray-100">
                  <div class="w-10 h-10 bg-primary/10 rounded-lg flex items-center justify-center text-primary mb-3">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="16" height="20" x="4" y="2" rx="2" ry="2"/><path d="M9 22v-4h6v4"/><path d="M8 6h.01"/><path d="M16 6h.01"/><path d="M12 6h.01"/><path d="M12 10h.01"/><path d="M12 14h.01"/><path d="M16 10h.01"/><path d="M16 14h.01"/><path d="M8 10h.01"/><path d="M8 14h.01"/></svg>
                  </div>
                  <h4 class="font-bold text-slate-900 mb-1">Robust construction</h4>
                  <p class="text-gray-600 text-sm">Steel frame for decades of use</p>
                </div>
                <div class="bg-slate-50 p-5 rounded-xl border border-gray-100">
                  <div class="w-10 h-10 bg-primary/10 rounded-lg flex items-center justify-center text-primary mb-3">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="22 7 13.5 15.5 8.5 10.5 2 17"/><polyline points="16 7 22 7 22 13"/></svg>
                  </div>
                  <h4 class="font-bold text-slate-900 mb-1">Value stability</h4>
                  <p class="text-gray-600 text-sm">High resale value and reuse potential</p>
                </div>
              </div>

              <h3 class="text-xl font-heading font-bold text-slate-900 mt-10 mb-4">
                High-performance insulation and climate technology
              </h3>
              <p class="text-gray-600 leading-relaxed mb-6">
                The thermal envelope of modern lab containers achieves U-values of under 0.20 W/m²K — figures that even exceed ambitious Passivhaus standards. Sandwich panels with a rigid polyurethane foam core or mineral-wool filling offer not only excellent insulation values but also meet the highest fire-protection requirements.
              </p>
              <p class="text-gray-600 leading-relaxed mb-6">
                Integrated climate technology ensures constant temperatures and humidity — essential for precise laboratory work. Modern ventilation plant with heat recovery minimises energy consumption, while highly efficient filters ensure the required air purity. Where needed, cleanroom conditions to ISO classification can also be realised.
              </p>

              <h3 class="text-xl font-heading font-bold text-slate-900 mt-10 mb-4">
                Precision manufacture under controlled conditions
              </h3>
              <p class="text-gray-600 leading-relaxed mb-6">
                A decisive advantage of modular construction lies in manufacture under controlled workshop conditions. Unlike on the construction site, where weather and changing teams can impair quality, production of lab containers takes place in specialised manufacturing halls.
              </p>
              <p class="text-gray-600 leading-relaxed mb-6">
                This controlled environment enables quality assurance that is barely achievable in conventional construction. Every work step is documented, every joint inspected, every system tested. The result is modules that on delivery are already fully tested and accepted — a substantial time advantage at commissioning.
              </p>

              <div class="bg-amber-50 border-l-4 border-amber-500 p-6 rounded-r-xl my-8">
                <div class="flex items-start gap-4">
                  <div class="w-10 h-10 bg-amber-100 rounded-lg flex items-center justify-center shrink-0">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#d97706" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"/><path d="M12 9v4"/><path d="M12 17h.01"/></svg>
                  </div>
                  <div>
                    <h4 class="font-bold text-slate-900 mb-2">Important: do not forget site preparation</h4>
                    <p class="text-gray-600 text-sm">
                      While the container module is being built in the factory, site preparation should take place in parallel. Our <a href="/en/services/logistics" class="text-primary font-medium hover:underline">logistics and installation experts</a> support you in planning foundations and utility connections.
                    </p>
                  </div>
                </div>
              </div>

              <h2 class="text-2xl font-heading font-bold text-slate-900 mt-12 mb-6">
                Flexibility as a strategic advantage
              </h2>
              <p class="text-gray-600 leading-relaxed mb-6">
                The greatest strength of modular laboratory construction lies in its inherent flexibility. A lab container is not a permanent structure, but a mobile asset that can grow and change with the organisation. This flexibility manifests itself in several dimensions:
              </p>

              <div class="bg-slate-50 p-6 rounded-xl my-8 not-prose">
                <h4 class="font-bold text-slate-900 mb-4">Dimensions of flexibility at a glance:</h4>
                <ul class="space-y-3">
                  <li class="flex items-start gap-3">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#bbd700" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="shrink-0 mt-0.5"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
                    <span class="text-gray-700">Spatial flexibility: site moves within days rather than months</span>
                  </li>
                  <li class="flex items-start gap-3">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#bbd700" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="shrink-0 mt-0.5"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
                    <span class="text-gray-700">Capacity flexibility: simple expansion with additional modules</span>
                  </li>
                  <li class="flex items-start gap-3">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#bbd700" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="shrink-0 mt-0.5"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
                    <span class="text-gray-700">Functional flexibility: conversion for new fields of application</span>
                  </li>
                  <li class="flex items-start gap-3">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#bbd700" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="shrink-0 mt-0.5"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
                    <span class="text-gray-700">Financial flexibility: leasing options instead of high initial investment</span>
                  </li>
                  <li class="flex items-start gap-3">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#bbd700" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="shrink-0 mt-0.5"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
                    <span class="text-gray-700">Temporal flexibility: rapid response to market change</span>
                  </li>
                </ul>
              </div>

              <h3 class="text-xl font-heading font-bold text-slate-900 mt-10 mb-4">
                Application scenarios for mobile laboratories
              </h3>
              <p class="text-gray-600 leading-relaxed mb-6">
                The uses for lab containers are varied. In the pharmaceutical industry they serve as a temporary expansion of existing capacity or as dedicated facilities for clinical studies. Environmental laboratories use mobile units for on-site analyses at field locations. Industrial companies value the ability to position quality-control laboratories directly on the production line.
              </p>
              <p class="text-gray-600 leading-relaxed mb-6">
                Particularly interesting is use in research collaborations: when several partners work together at different sites, a mobile laboratory can bridge the distances. The laboratory comes to the samples — not the other way round. This reduces transport risks and shortens the time from sampling to result considerably.
              </p>

              <h2 class="text-2xl font-heading font-bold text-slate-900 mt-12 mb-6">
                Economic assessment: TCO compared
              </h2>
              <p class="text-gray-600 leading-relaxed mb-6">
                The economic evaluation of lab containers must go beyond pure acquisition costs. A comprehensive total-cost-of-ownership analysis (TCO) considers all costs over the entire life cycle — and here modular solutions often show surprising advantages.
              </p>
              <p class="text-gray-600 leading-relaxed mb-6">
                Investment costs for a lab container typically sit 20 to 40 per cent below those of a comparable conventional laboratory. Added to this are reduced planning costs through standardised processes and shorter construction times. Faster commissioning also means an earlier start to productivity — a factor often underestimated in the ROI calculation.
              </p>

              <div class="bg-primary/5 border-l-4 border-primary p-6 rounded-r-xl my-8">
                <div class="flex items-start gap-4">
                  <div class="w-10 h-10 bg-primary/10 rounded-lg flex items-center justify-center shrink-0">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#bbd700" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 14c.2-1 .7-1.7 1.5-2.5 1-.9 1.5-2.2 1.5-3.5A6 6 0 0 0 6 8c0 1 .2 2.2 1.5 3.5.7.7 1.3 1.5 1.5 2.5"/><path d="M9 18h6"/><path d="M10 22h4"/></svg>
                  </div>
                  <div>
                    <h4 class="font-bold text-slate-900 mb-2">Expert tip: examine leasing options</h4>
                    <p class="text-gray-600 text-sm">
                      For temporary projects or with a limited investment budget, leasing models can be an attractive alternative. Speak to us in <a href="/en/services/consulting" class="text-primary font-medium hover:underline">consulting</a> about the various financing options.
                    </p>
                  </div>
                </div>
              </div>

              <h2 class="text-2xl font-heading font-bold text-slate-900 mt-12 mb-6">
                Safety and compliance in the mobile laboratory
              </h2>
              <p class="text-gray-600 leading-relaxed mb-6">
                A common prejudice against container laboratories concerns compliance with safety standards. In fact, modern lab containers can meet all common safety and quality requirements — from simple S1 laboratories through to BSL-3 facilities for work with hazardous biological agents.
              </p>
              <p class="text-gray-600 leading-relaxed mb-6">
                The keys to safety lie in careful planning and high-quality execution. Pressure-tight cabin constructions enable the maintenance of negative-pressure zones. Specialist HEPA filter plant ensures safe extract treatment. Decontamination airlocks and pass-through autoclaves complete the safety concept.
              </p>

              <h3 class="text-xl font-heading font-bold text-slate-900 mt-10 mb-4">
                Standards and certifications
              </h3>
              <p class="text-gray-600 leading-relaxed mb-6">
                Planexus lab containers are planned and manufactured to all relevant standards. This includes, among others, DIN EN 12128 for laboratories, the Workplace Ordinance, the Hazardous Substances Ordinance and sector-specific requirements such as GMP for the pharmaceutical industry or the Genetic Engineering Safety Ordinance.
              </p>
              <p class="text-gray-600 leading-relaxed mb-6">
                Our <a href="/en/services/consulting" class="text-primary font-medium hover:underline">consulting experts</a> support you in navigating the various regulatory requirements and ensure that your lab container obtains all necessary permits.
              </p>

              <h2 class="text-2xl font-heading font-bold text-slate-900 mt-12 mb-6">
                Sustainability and environmental aspects
              </h2>
              <p class="text-gray-600 leading-relaxed mb-6">
                Modular laboratory construction is not only economically attractive, but also environmentally advantageous. Prefabrication in the factory reduces transport trips to the site, minimises material waste and enables optimal waste disposal and recovery.
              </p>
              <p class="text-gray-600 leading-relaxed mb-6">
                The high energy efficiency of modern lab containers lowers operating energy demand — and thus both costs and CO2 emissions. At the end of the service life the modules can be dismantled and reused elsewhere, or the materials sent for recycling. A large proportion of the materials used — particularly the steel — can be fully recovered.
              </p>

              <h2 class="text-2xl font-heading font-bold text-slate-900 mt-12 mb-6">
                The future of the mobile laboratory
              </h2>
              <p class="text-gray-600 leading-relaxed mb-6">
                Development in modular laboratory construction continues steadily. Current trends point towards even stronger integration of digital technologies. <a href="/en/services/smart-lab" class="text-primary font-medium hover:underline">Smart Lab systems</a> with IoT sensors, cloud-based data analysis and automated workflows are becoming the standard.
              </p>
              <p class="text-gray-600 leading-relaxed mb-6">
                Manufacturing technologies are also developing further. 3D printing and robot-assisted production increasingly enable individualised solutions at consistently high efficiency. The boundaries between standard modules and tailored solutions are blurring — to the benefit of users, who profit from both worlds.
              </p>

              <div class="bg-slate-900 text-white p-8 rounded-2xl my-12 not-prose">
                <h3 class="text-xl font-bold mb-4">Conclusion: modular construction as a future strategy</h3>
                <p class="text-gray-300 leading-relaxed mb-6">
                  Modular laboratory construction has developed from a niche solution into a serious alternative for almost all laboratory applications. The combination of speed, flexibility, quality and economy makes container laboratories the first choice for future-oriented organisations and institutions.
                </p>
                <a href="/en/contact" class="inline-flex items-center gap-2 bg-primary text-slate-900 font-bold px-6 py-3 rounded-lg hover:bg-primary/90 transition-colors">
                  Book a consultation
                  <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
                </a>
              </div>

            </div>
          </div>

          <div class="lg:col-span-4">
            <div class="sticky top-24 space-y-6">
              <div class="bg-slate-50 p-6 rounded-2xl border border-gray-100">
                <h4 class="font-bold text-slate-900 mb-4">About the author</h4>
                <div class="flex items-center gap-4">
                  <div class="w-16 h-16 bg-primary/20 rounded-full flex items-center justify-center text-primary font-bold text-xl">
                    SB
                  </div>
                  <div>
                    <p class="font-bold text-slate-900">Sven Biewald</p>
                    <p class="text-gray-600 text-sm">Managing Director, Planexus GmbH</p>
                  </div>
                </div>
              </div>

              <div class="bg-white p-6 rounded-2xl border border-gray-100">
                <h4 class="font-bold text-slate-900 mb-4">Share article</h4>
