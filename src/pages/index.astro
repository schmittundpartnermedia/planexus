---
import Layout from '../layouts/Layout.astro';
import { LiquidDistortion } from '../components/LiquidDistortion';

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    { "@type": "Question", "name": "Was kostet ein Laborcontainer?", "acceptedAnswer": { "@type": "Answer", "text": "Der Preis hängt von Sicherheitsstufe, Reinraumklasse, Ausstattung und Standort ab. Ein einfaches BSL-2-Analytiklabor startet ab etwa 80.000 €, GMP-Reinraum-Container liegen bei 250.000–500.000 €, BSL-3-Projekte darüber. Konkrete Kalkulation erst nach Bedarfsanalyse – Pauschalpreise sind bei Laborcontainern nicht sinnvoll." } },
    { "@type": "Question", "name": "Wie lange dauert die Lieferung eines Laborcontainers?", "acceptedAnswer": { "@type": "Answer", "text": "Standard-Laborcontainer (BSL-2, analytisch): 8–12 Wochen Werksfertigung plus 2–5 Werktage Aufstellung vor Ort. GMP-Reinraum oder BSL-3: 16–24 Wochen inklusive Qualifizierung. Serienprojekte wie LABtoGO sind oft schneller verfügbar." } },
    { "@type": "Question", "name": "Braucht ein Laborcontainer eine Baugenehmigung?", "acceptedAnswer": { "@type": "Answer", "text": "In den meisten Fällen ja – abhängig von Aufstellungsdauer, Bundesland und Nutzungsart. Container über 75 m³ Brutto-Rauminhalt sind in Deutschland baugenehmigungspflichtig. Planexus liefert baurechtliche Unterlagen und begleitet den Genehmigungsprozess in DACH." } },
    { "@type": "Question", "name": "Kann man einen Laborcontainer mieten oder nur kaufen?", "acceptedAnswer": { "@type": "Answer", "text": "Beides. Miete eignet sich für befristete Projekte (12–24 Monate), z. B. während Klinik-Sanierungen oder Studienphasen. Kauf ist wirtschaftlicher bei dauerhafter Kapazitätserweiterung. Mietkauf ist als Zwischenlösung möglich." } },
    { "@type": "Question", "name": "Welche Sicherheitsstufen und Reinraumklassen sind möglich?", "acceptedAnswer": { "@type": "Answer", "text": "Planexus realisiert BSL-2, BSL-3, GMP-Reinraum (ISO 5–8 nach ISO 14644-1), ATEX-Container für H₂- und Batterietests sowie analytische Standardlabore. Alle Konfigurationen werden werksseitig in Albstadt gefertigt und schlüsselfertig geliefert." } },
    { "@type": "Question", "name": "Wohin liefert Planexus Laborcontainer?", "acceptedAnswer": { "@type": "Answer", "text": "Deutschlandweit und in die Schweiz sowie Österreich. Fertigung im Werk Albstadt (Baden-Württemberg), Transport per Tieflader. Standortspezifische Informationen zu 12 DACH-Metropolregionen finden Sie unter /standorte." } }
  ]
};
---

<Layout
  title="Planexus – Laborcontainer und modularer Laborbau aus Albstadt"
  description="Planexus plant und liefert schlüsselfertige Laborcontainer in DACH. Teil der Wesemann Holding, Fertigung in Albstadt. LABtoGO, Miete und Kauf – Beratung anfordern."
  canonical="/"
>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} slot="head" />
  <div class="min-h-screen bg-background text-foreground">
    <!-- Hero Section -->
    <section class="relative min-h-screen flex items-center justify-center overflow-hidden bg-slate-950 text-white">
      <!-- Mobile: Static Image -->
      <div class="lg:hidden absolute inset-0 z-0">
        <img
          src="/attached_assets/Kopf_green-scaled_1768306688943.jpg"
          alt="Moderner Laborcontainer Außenansicht"
          class="w-full h-full object-cover"
          loading="eager"
          width="2560"
          height="1280"
        />
      </div>

      <!-- Desktop: Liquid Distortion Effect -->
      <div class="hidden lg:block absolute inset-0 z-[5] w-full h-full">
        <LiquidDistortion
          client:visible
          imageSrc="/attached_assets/Kopf_green-scaled_1768306688943.jpg"
          className="w-full h-full"
        />
      </div>

      <div class="container mx-auto px-4 relative z-[10] pointer-events-none">
        <div class="max-w-3xl pt-16 md:pt-0">
          <img
            src="/attached_assets/Planexus_Home-e1738171155684_1767361842201.png"
            alt="Planexus GmbH"
            class="hidden md:block w-[520px] h-auto mb-8"
            width="4500"
            height="951"
          />
          <h1 class="text-3xl md:text-5xl font-heading font-bold text-white mb-6 leading-tight">
            Laborcontainer und modularer Laborbau aus Albstadt
          </h1>
          <p class="text-lg md:text-xl text-gray-300 mb-6 leading-relaxed max-w-2xl font-light">
            Schlüsselfertige Containerlabore für Pharma, Forschung und Industrie – geplant und gefertigt im Werk Albstadt, Teil der Wesemann Holding.
          </p>
          <p class="text-2xl md:text-3xl font-heading font-bold text-white/90 mb-8 leading-tight">
            Denken. <span class="text-primary">Planen.</span> Verbinden.
          </p>
          <div class="flex flex-col sm:flex-row gap-4 pointer-events-auto">
            <a href="/laborcontainer" class="bg-primary text-slate-900 font-bold px-8 py-4 rounded-lg hover:bg-primary/90 transition-colors flex items-center justify-center gap-2 group shadow-[0_0_20px_rgba(132,189,0,0.4)]">
              Laborcontainer ansehen
              <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 group-hover:translate-x-1 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
            </a>
            <a href="/kontakt" class="border border-white/20 text-white font-medium px-8 py-4 rounded-lg hover:bg-white/10 transition-colors backdrop-blur-sm flex items-center justify-center">
              Beratung anfragen
            </a>
          </div>
          <p class="mt-6 text-sm text-white/70 pointer-events-auto">
            <a href="/laborcontainer-mieten" class="underline hover:text-primary">Mieten</a>
            <span class="mx-2">·</span>
            <a href="/laborcontainer-kaufen" class="underline hover:text-primary">Kaufen</a>
            <span class="mx-2">·</span>
            <a href="/laborcontainer/labtogo" class="underline hover:text-primary">LABtoGO</a>
          </p>
        </div>
      </div>
    </section>

    <!-- Award Banner -->
    <section class="py-8 bg-gradient-to-r from-slate-900 via-slate-800 to-slate-900">
      <div class="container mx-auto px-4">
        <div class="max-w-7xl mx-auto bg-white rounded-2xl overflow-hidden shadow-2xl border border-gray-100">
          <div class="grid grid-cols-1 md:grid-cols-5 items-center">
            <div class="md:col-span-2 p-8 md:p-12 flex flex-col items-center justify-center bg-gradient-to-br from-slate-50 to-white">
              <div class="relative">
                <div class="w-40 h-40 md:w-48 md:h-48 rounded-full bg-gradient-to-br from-[#bbd700]/20 via-[#bbd700]/10 to-transparent flex items-center justify-center border-2 border-[#bbd700]/30">
                  <div class="text-center">
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-14 h-14 md:w-16 md:h-16 text-[#bbd700] mx-auto mb-2" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9H4.5a2.5 2.5 0 0 1 0-5H6"/><path d="M18 9h1.5a2.5 2.5 0 0 0 0-5H18"/><path d="M4 22h16"/><path d="M10 14.66V17c0 .55-.47.98-.97 1.21C7.85 18.75 7 20.24 7 22"/><path d="M14 14.66V17c0 .55.47.98.97 1.21C16.15 18.75 17 20.24 17 22"/><path d="M18 2H6v7a6 6 0 0 0 12 0V2Z"/></svg>
                    <p class="text-[#7a9900] font-bold text-xs uppercase tracking-wider">Award 2026</p>
                  </div>
                </div>
              </div>
            </div>
            <div class="md:col-span-3 p-8 md:p-12 flex flex-col items-start justify-center">
              <span class="bg-[#bbd700]/10 text-[#7a9900] text-xs font-bold px-3 py-1 rounded-full uppercase tracking-wider mb-4">Auszeichnung</span>
              <h3 class="text-2xl md:text-3xl font-heading font-bold text-slate-900 mb-3 leading-tight">
                Führender Anbieter innovativer Laborräume 2026
              </h3>
              <p class="text-gray-500 text-sm font-medium mb-2">EU Business News — German CEO Excellence Awards 2026</p>
              <p class="text-gray-600 text-base mb-6 leading-relaxed">
                Erst auf der analytica 2026 präsentiert, jetzt international ausgezeichnet. Planexus wurde bei den German CEO Excellence Awards als führender Anbieter innovativer Laborräume 2026 prämiert.
              </p>
              <div class="flex flex-wrap gap-3">
                <a href="/laborcontainer/labtogo" class="inline-flex items-center gap-2 bg-[#bbd700] text-slate-900 font-bold px-8 py-3.5 rounded-lg hover:bg-[#a8c200] transition-colors text-sm group">
                  LABtoGO entdecken
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 group-hover:translate-x-1 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
                </a>
                <a href="https://www.eubusinessnews.com/winners/planexus-gmbh/" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 border-2 border-slate-200 text-slate-700 font-bold px-6 py-3.5 rounded-lg hover:border-[#bbd700] hover:text-slate-900 transition-colors text-sm group">
                  Zur Auszeichnung
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 group-hover:translate-x-0.5 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
                </a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Stats Section -->
    <section class="py-20 bg-white border-b border-gray-100">
      <div class="container mx-auto px-4">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8 text-center divide-y md:divide-y-0 md:divide-x divide-gray-100">
          <div class="p-4">
            <div class="text-5xl font-heading font-bold text-primary mb-2">10+</div>
            <p class="text-gray-600 font-medium">Jahre Erfahrung der Geschäftsführung</p>
          </div>
          <div class="p-4">
            <div class="text-5xl font-heading font-bold text-primary mb-2">50+</div>
            <p class="text-gray-600 font-medium">Realisierte Labor-Projekte</p>
          </div>
          <div class="p-4">
            <div class="text-5xl font-heading font-bold text-primary mb-2">100%</div>
            <p class="text-gray-600 font-medium">Kundenzufriedenheit</p>
          </div>
        </div>
      </div>
    </section>

    <!-- About Teaser -->
    <section class="py-24 relative overflow-hidden bg-dot-pattern">
      <div class="container mx-auto px-4">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
          <div>
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-primary text-slate-900 font-medium text-sm mb-6">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z"/><path d="m3.3 7 8.7 5 8.7-5"/><path d="M12 22V12"/></svg>
              <span>Modular & Flexibel</span>
            </div>
            <h2 class="text-4xl font-heading font-bold mb-6 text-slate-900">
              Vom Visionär zum <span class="text-primary">Branchenpionier</span>
            </h2>
            <div class="space-y-6 text-gray-600 text-lg leading-relaxed">
              <p>
                Als Fachplaner für <strong>Containerlabore</strong> setzen wir neue Standards. Was 2016 als Vision begann, ist heute Stand der Technik im mobilen Laborbau.
              </p>
              <p>
                <strong>Planexus</strong> steht für intelligente Modulbauweise. Wir verbinden technisches Know-how mit Innovationskraft, um Labore zu schaffen, die exakt auf Ihre Analyseprozesse abgestimmt sind – schnell verfügbar, kosteneffizient und nachhaltig.
              </p>
            </div>
            <a href="/ueber-uns" class="inline-flex items-center gap-2 text-primary font-bold mt-8 hover:gap-3 transition-all border-b-2 border-primary/20 hover:border-primary pb-1">
              Mehr über Planexus erfahren
              <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
            </a>
          </div>
          <div class="relative">
            <div class="aspect-square rounded-2xl overflow-hidden shadow-2xl shadow-gray-200 border border-gray-100 relative group bg-white">
              <div class="absolute top-0 right-0 w-2/3 h-2/3 bg-primary/5 rounded-bl-[100px] -z-0"></div>
              <div class="absolute inset-0 flex items-center justify-center p-8">
                <div class="grid grid-cols-2 gap-6 w-full h-full">
                  <div class="bg-slate-50 rounded-xl p-6 flex flex-col justify-center items-center text-center hover:bg-white hover:shadow-lg transition-all border border-gray-100">
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-10 h-10 text-primary mb-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 18h8"/><path d="M3 22h18"/><path d="M14 22a7 7 0 1 0 0-14h-1"/><path d="M9 14h2"/><path d="M9 12a2 2 0 0 1-2-2V6h6v4a2 2 0 0 1-2 2Z"/><path d="M12 6V3a1 1 0 0 0-1-1H9a1 1 0 0 0-1 1v3"/></svg>
                    <span class="font-bold text-slate-800">Analytik</span>
                  </div>
                  <div class="bg-slate-50 rounded-xl p-6 flex flex-col justify-center items-center text-center hover:bg-white hover:shadow-lg transition-all border border-gray-100">
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-10 h-10 text-primary mb-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 2v7.527a2 2 0 0 1-.211.896L4.72 20.55a1 1 0 0 0 .9 1.45h12.76a1 1 0 0 0 .9-1.45l-5.069-10.127A2 2 0 0 1 14 9.527V2"/><path d="M8.5 2h7"/><path d="M7 16h10"/></svg>
                    <span class="font-bold text-slate-800">Forschung</span>
                  </div>
                  <div class="bg-slate-50 rounded-xl p-6 flex flex-col justify-center items-center text-center hover:bg-white hover:shadow-lg transition-all border border-gray-100">
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-10 h-10 text-primary mb-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 20A7 7 0 0 1 9.8 6.9C15.5 4.9 17 3.5 17 3.5s1.5 2.5-.8 6.5C20.7 11.5 21 14 21 14s-1.5-.5-2.5-.5c-.5 2-2 3.5-2 3.5s-.5-1-1-2.5c-1.5 1-4.5 2.5-4.5 5.5"/><path d="M2 21c0-3 1.85-5.36 5.08-6C9.5 14.52 12 13 13 12"/></svg>
                    <span class="font-bold text-slate-800">Nachhaltig</span>
                  </div>
                  <div class="bg-primary rounded-xl p-6 flex flex-col justify-center items-center text-center text-slate-900 shadow-lg shadow-primary/30">
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-10 h-10 text-slate-900 mb-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z"/><path d="m3.3 7 8.7 5 8.7-5"/><path d="M12 22V12"/></svg>
                    <span class="font-bold">Modular</span>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Services Teaser -->
    <section class="py-24 bg-slate-50 border-y border-gray-100">
      <div class="container mx-auto px-4">
        <div class="text-center max-w-2xl mx-auto mb-16">
          <h2 class="text-3xl md:text-4xl font-heading font-bold mb-4 text-slate-900">Unsere Leistungen</h2>
          <p class="text-gray-600 text-lg">
            Ganzheitliche Lösungen für den Laborbau – von der ersten Skizze bis zur schlüsselfertigen Übergabe Ihres Laborcontainers.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          <!-- Technische Fachplanung -->
          <div class="bg-white border border-gray-100 p-6 rounded-xl hover:shadow-xl hover:shadow-gray-200/50 transition-all group relative overflow-hidden">
            <div class="absolute top-0 left-0 w-1 h-full bg-primary opacity-0 group-hover:opacity-100 transition-opacity"></div>
            <div class="w-14 h-14 bg-primary/10 rounded-lg flex items-center justify-center mb-4 text-primary group-hover:bg-primary group-hover:text-slate-900 transition-colors">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="7" height="9" x="3" y="3" rx="1"/><rect width="7" height="5" x="14" y="3" rx="1"/><rect width="7" height="9" x="14" y="12" rx="1"/><rect width="7" height="5" x="3" y="16" rx="1"/></svg>
            </div>
            <h3 class="text-lg font-bold mb-2 text-slate-900">Technische Fachplanung</h3>
            <p class="text-gray-600 text-sm mb-4">Detaillierte Planung mit 3D-Visualisierung und TGA-Konzepten.</p>
            <a href="/leistungen/planung" class="text-primary font-bold text-sm flex items-center gap-2 group-hover:translate-x-1 transition-transform">
              Mehr erfahren <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
            </a>
          </div>

          <!-- Modulbau & Fertigung -->
          <div class="bg-white border border-gray-100 p-6 rounded-xl hover:shadow-xl hover:shadow-gray-200/50 transition-all group relative overflow-hidden">
            <div class="absolute top-0 left-0 w-1 h-full bg-primary opacity-0 group-hover:opacity-100 transition-opacity"></div>
            <div class="w-14 h-14 bg-primary/10 rounded-lg flex items-center justify-center mb-4 text-primary group-hover:bg-primary group-hover:text-slate-900 transition-colors">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m12.83 2.18a2 2 0 0 0-1.66 0L2.6 6.08a1 1 0 0 0 0 1.83l8.58 3.91a2 2 0 0 0 1.66 0l8.58-3.9a1 1 0 0 0 0-1.83Z"/><path d="m22 17.65-9.17 4.16a2 2 0 0 1-1.66 0L2 17.65"/><path d="m22 12.65-9.17 4.16a2 2 0 0 1-1.66 0L2 12.65"/></svg>
            </div>
            <h3 class="text-lg font-bold mb-2 text-slate-900">Modulbau & Fertigung</h3>
            <p class="text-gray-600 text-sm mb-4">Hochwertige Laborcontainer 'Made in Germany'.</p>
            <a href="/leistungen/modulbau" class="text-primary font-bold text-sm flex items-center gap-2 group-hover:translate-x-1 transition-transform">
              Mehr erfahren <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
            </a>
          </div>

          <!-- Logistik & Montage -->
          <div class="bg-white border border-gray-100 p-6 rounded-xl hover:shadow-xl hover:shadow-gray-200/50 transition-all group relative overflow-hidden">
            <div class="absolute top-0 left-0 w-1 h-full bg-primary opacity-0 group-hover:opacity-100 transition-opacity"></div>
            <div class="w-14 h-14 bg-primary/10 rounded-lg flex items-center justify-center mb-4 text-primary group-hover:bg-primary group-hover:text-slate-900 transition-colors">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z"/><path d="m3.3 7 8.7 5 8.7-5"/><path d="M12 22V12"/></svg>
            </div>
            <h3 class="text-lg font-bold mb-2 text-slate-900">Logistik & Montage</h3>
            <p class="text-gray-600 text-sm mb-4">Weltweiter Transport und schlüsselfertige Übergabe.</p>
            <a href="/leistungen/logistik" class="text-primary font-bold text-sm flex items-center gap-2 group-hover:translate-x-1 transition-transform">
              Mehr erfahren <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
            </a>
          </div>

          <!-- Laborausstattung -->
          <div class="bg-white border border-gray-100 p-6 rounded-xl hover:shadow-xl hover:shadow-gray-200/50 transition-all group relative overflow-hidden">
            <div class="absolute top-0 left-0 w-1 h-full bg-primary opacity-0 group-hover:opacity-100 transition-opacity"></div>
            <div class="w-14 h-14 bg-primary/10 rounded-lg flex items-center justify-center mb-4 text-primary group-hover:bg-primary group-hover:text-slate-900 transition-colors">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 18h8"/><path d="M3 22h18"/><path d="M14 22a7 7 0 1 0 0-14h-1"/><path d="M9 14h2"/><path d="M9 12a2 2 0 0 1-2-2V6h6v4a2 2 0 0 1-2 2Z"/><path d="M12 6V3a1 1 0 0 0-1-1H9a1 1 0 0 0-1 1v3"/></svg>
            </div>
