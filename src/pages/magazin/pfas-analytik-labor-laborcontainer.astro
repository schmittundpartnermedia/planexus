const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    { "@type": "Question", "name": "Welche PFAS-Grenzwerte gelten im Trinkwasser in Deutschland?", "acceptedAnswer": { "@type": "Answer", "text": "Seit dem 12. Januar 2026 gilt für die Summe von 20 PFAS (Summe PFAS-20) ein Grenzwert von 0,0001 mg/l, also 0,1 µg/l oder 100 ng/l. Ab dem 12. Januar 2028 kommt für die Summe von PFOA, PFNA, PFHxS und PFOS (Summe PFAS-4) ein Grenzwert von 0,00002 mg/l hinzu, also 20 ng/l. Beide Werte stehen in Anlage 2 der Trinkwasserverordnung." } },
    { "@type": "Question", "name": "Welche Bestimmungsgrenze muss ein Labor für PFAS im Trinkwasser erreichen?", "acceptedAnswer": { "@type": "Answer", "text": "Nach Anlage 7 der Trinkwasserverordnung muss die Bestimmungsgrenze höchstens 30 Prozent des Grenzwerts betragen. Für die Summenparameter wird das auf die Einzelstoffe umgelegt: Jeder Einzelstoff muss bis 0,0000015 mg/l, also 1,5 ng/l, bestimmbar sein. Die zulässige Messunsicherheit liegt bei 50 Prozent." } },
    { "@type": "Question", "name": "Welche Normen beschreiben die PFAS-Analytik in Wasser?", "acceptedAnswer": { "@type": "Answer", "text": "In Deutschland sind vor allem DIN 38407-42 für Trink-, Grund- und Oberflächenwasser sowie behandeltes Abwasser und DIN EN 17892 speziell für Trinkwasser maßgeblich. Beide arbeiten mit Flüssigkeitschromatographie und Tandem-Massenspektrometrie (LC-MS/MS)." } },
    { "@type": "Question", "name": "Kann ein Laborcontainer ein akkreditiertes PFAS-Labor aufnehmen?", "acceptedAnswer": { "@type": "Answer", "text": "Ja, wenn Raumklima, Stromversorgung, Gasversorgung, Abluft und Materialauswahl auf die LC-MS/MS-Spurenanalytik ausgelegt sind. Die Akkreditierung erteilt der Container nicht: Ein neuer Messraum oder Standort muss vom Labor mit der Akkreditierungsstelle abgestimmt und im Qualitätsmanagement abgebildet werden." } },
    { "@type": "Question", "name": "Warum sind Blindwerte bei der PFAS-Analytik so kritisch?", "acceptedAnswer": { "@type": "Answer", "text": "Gemessen wird im Bereich weniger Nanogramm pro Liter. PFAS kommen aber auch in Laborgeräten und Verbrauchsmaterialien vor, etwa in PTFE-Schläuchen oder PTFE-beschichteten Verschlüssen. Die erreichbare Bestimmungsgrenze hängt deshalb direkt davon ab, wie niedrig ein Labor seine Blindwerte halten kann." } },
