                    </tr>
                    <tr class="bg-slate-50">
                      <td class="border border-gray-200 px-4 py-3 font-medium">Auswertung</td>
                      <td class="border border-gray-200 px-4 py-3">Datenauswertung, Freigabe, Berichte</td>
                      <td class="border border-gray-200 px-4 py-3">Bildschirmarbeitsplätze, Netzwerk, Datensicherung</td>
                    </tr>
                  </tbody>
                </table>
