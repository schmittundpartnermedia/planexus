                      <td class="p-4 text-gray-700">Primärverpackung, nicht-sterile Herstellung</td>
                    </tr>
                    <tr class="border-b border-gray-100 bg-slate-50">
                      <td class="p-4 text-gray-700">Klasse C (ISO 7), 30 m²</td>
                      <td class="p-4 text-center text-gray-700">120.000 – 200.000 €</td>
                      <td class="p-4 text-gray-700">Lösungsansatz, Probenvorbereitung</td>
                    </tr>
                    <tr class="border-b border-gray-100">
                      <td class="p-4 text-gray-700">Klasse B (ISO 5), 30 m²</td>
                      <td class="p-4 text-center text-gray-700">200.000 – 350.000 €</td>
                      <td class="p-4 text-gray-700">Hintergrund für aseptische Prozesse</td>
                    </tr>
                    <tr>
