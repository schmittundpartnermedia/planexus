---
import Layout from '../../layouts/Layout.astro';
import RelatedArticles from '../../components/RelatedArticles.astro';

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": "S1- und S2-Labor: Anforderungen nach GenTSV und BioStoffV",
  "description": "S2-Labor Anforderungen im Überblick: bauliche Checkliste nach GenTSV und BioStoffV, Lüftung, Autoklav, Anmeldung und was S2 nicht verlangt.",
  "author": { "@type": "Person", "name": "Thomas Boss", "url": "https://planexus.de/team/thomas-boss", "jobTitle": "Gesellschafter & Technischer Leiter", "worksFor": { "@type": "Organization", "name": "Planexus GmbH" } },
  "datePublished": "2026-10-22",
  "dateModified": "2026-10-22",
  "image": "https://planexus.de/images/backgrounds/magazin-bsl-labor.webp",
  "publisher": { "@type": "Organization", "name": "Planexus GmbH", "logo": { "@type": "ImageObject", "url": "https://planexus.de/images/planexus-logo.png" } },
  "mainEntityOfPage": { "@type": "WebPage", "@id": "https://planexus.de/magazin/s1-s2-labor-anforderungen" },
  "about": [
    { "@type": "Thing", "name": "Gentechnik-Sicherheitsverordnung (GenTSV)" },
    { "@type": "Thing", "name": "Biostoffverordnung (BioStoffV)" },
    { "@type": "Thing", "name": "S2-Labor" }
  ]
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Start", "item": "https://planexus.de/" },
    { "@type": "ListItem", "position": 2, "name": "Magazin", "item": "https://planexus.de/magazin" },
    { "@type": "ListItem", "position": 3, "name": "S1- und S2-Labor: Anforderungen nach GenTSV und BioStoffV", "item": "https://planexus.de/magazin/s1-s2-labor-anforderungen" }
  ]
};

const faqs = [
  {
    q: "Was ist der Unterschied zwischen einem S1- und einem S2-Labor?",
    a: "Im S1-Labor finden Arbeiten statt, bei denen nach dem Stand der Wissenschaft kein Risiko für Mensch und Umwelt zu erwarten ist. Im S2-Labor wird mit einem geringen Risiko gearbeitet. Baulich kommen bei S2 vor allem flüssigkeitsdichte Arbeitsflächen und Böden, ein Waschbecken mit Desinfektionsmittelspender nahe der Tür, eine Augenspüleinrichtung, eine mikrobiologische Sicherheitswerkbank bei Aerosolgefahr, ein Autoklav in der Anlage oder im selben Gebäude und die Kennzeichnung mit dem Symbol für Biogefährdung hinzu."
  },
  {
    q: "Ist ein S2-Labor genehmigungspflichtig?",
    a: "Nach dem Gentechnikgesetz nicht zwingend. Für eine gentechnische Anlage der Sicherheitsstufe 2 und die erstmaligen Arbeiten darin reicht eine schriftliche Anmeldung bei der zuständigen Landesbehörde (§ 8 GenTG). Mit den Arbeiten darf 45 Tage nach Eingang der Anmeldung begonnen werden, früher nur mit Zustimmung der Behörde (§ 12 GenTG). Eine Genehmigung ist erst für Sicherheitsstufe 3 und 4 vorgeschrieben. Unabhängig davon kann für den Laborbau selbst eine Baugenehmigung nötig sein."
  },
  {
    q: "Braucht ein S2-Labor Unterdruck?",
    a: "Nein, nicht nach den Vorschriften. Anhang II der Biostoffverordnung führt den ständigen Unterdruck für Schutzstufe 2 als nicht erforderlich. Auch die GenTSV verlangt für Sicherheitsstufe 2 keinen Unterdruck. Pflicht ist, dass kontaminierte Prozessabluft nicht ungefiltert in den Arbeitsbereich gelangt und Aerosole zurückgehalten werden, etwa durch eine mikrobiologische Sicherheitswerkbank."
  },
  {
    q: "Braucht ein S2-Labor eine Schleuse?",
    a: "Nein. Eine Schleuse mit gegeneinander verriegelten Türen ist nach Anhang II der Biostoffverordnung erst ab Schutzstufe 3 vorgesehen. Für Schutzstufe 2 wird empfohlen, den Laborbereich von anderen Bereichen abzugrenzen. Ein Vorraum zum Umkleiden kann trotzdem sinnvoll sein, weil Schutzkleidung getrennt von Straßenkleidung aufbewahrt werden muss."
  },
  {
    q: "Welche Lüftung braucht ein S2-Labor?",
    a: "Eine eigene Luftwechselrate für S2 schreiben weder GenTSV noch BioStoffV vor. Wird im Labor mit Gefahrstoffen gearbeitet, gilt die TRGS 526: Als Richtwert nennt sie 25 Kubikmeter Zuluft pro Stunde und Quadratmeter Laborfläche, was bei 3 Metern Raumhöhe gut acht Luftwechseln pro Stunde entspricht. Eine Reduzierung ist nur auf Basis der Gefährdungsbeurteilung möglich. Weil Fenster während der Arbeiten geschlossen bleiben müssen, braucht ein S2-Labor in der Praxis eine technische Lüftung."
  },
  {
    q: "Muss der Autoklav im S2-Labor stehen?",
    a: "Nicht zwingend im Laborraum. Die GenTSV verlangt für Sicherheitsstufe 2 einen Autoklav oder eine gleichwertige Inaktivierungseinrichtung mit ausreichender Kapazität in der gentechnischen Anlage oder im selben Gebäude. Steht das S2-Labor als eigenständiger Laborcontainer, sollte früh mit der Behörde geklärt werden, ob ein Autoklav im Container nötig ist oder ein Gerät im Nachbargebäude anerkannt wird."
  },
  {
    q: "Dürfen Schwangere im S2-Labor arbeiten?",
    a: "Das entscheidet die Gefährdungsbeurteilung im Einzelfall. Nach § 11 Abs. 2 Mutterschutzgesetz darf eine schwangere Frau keinen Tätigkeiten mit Biostoffen der Risikogruppen 2 bis 4 ausgesetzt sein, wenn dies für sie oder ihr Kind eine unverantwortbare Gefährdung darstellt. Ausdrücklich genannt sind Rötelnvirus und Toxoplasma. Liegt ein ausreichender Immunschutz vor, gilt die Gefährdung insoweit als ausgeschlossen."
  },
  {
    q: "Kann ein Laborcontainer als S2-Labor betrieben werden?",
    a: "Ja. Die Anforderungen an ein S2-Labor betreffen Oberflächen, Ausstattung, Lüftung, Kennzeichnung und Organisation, nicht die Bauweise. Ein Laborcontainer kann alle baulichen und technischen Punkte erfüllen. Die Anmeldung bei der Behörde und die Gefährdungsbeurteilung bleiben Aufgabe des Betreibers. Planexus fertigt S1- und S2-Laborcontainer typischerweise in 8 bis 14 Wochen."
  }
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map((f) => ({
    "@type": "Question",
    "name": f.q,
    "acceptedAnswer": { "@type": "Answer", "text": f.a }
  }))
};

const linkClass = "text-[#5c7300] font-medium hover:underline";
---

<Layout
  type="article"
  title="S2-Labor Anforderungen: Checkliste GenTSV & BioStoffV"
  description="S2-Labor Anforderungen im Überblick: bauliche Checkliste nach GenTSV und BioStoffV, Lüftung, Autoklav, Anmeldung und was S2 nicht verlangt."
  canonical="/magazin/s1-s2-labor-anforderungen"
  ogImage="/images/backgrounds/magazin-bsl-labor.webp"
>
  <div class="pt-20 min-h-screen bg-white">
    <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

    <section class="relative py-20 bg-slate-900 text-white overflow-hidden">
      <div class="absolute inset-0 bg-[url('/images/backgrounds/magazin-bsl-labor.webp')] bg-cover bg-center opacity-30"></div>
      <div class="absolute inset-0 bg-gradient-to-t from-slate-900 via-slate-900/90 to-slate-900/70"></div>
      <div class="container mx-auto px-4 relative z-10">
        <div class="max-w-4xl mx-auto">
          <div class="flex flex-wrap items-center gap-4 mb-6">
            <span class="bg-primary/20 text-primary px-4 py-1.5 rounded-full text-sm font-medium flex items-center gap-2">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
              Sicherheit
            </span>
            <span class="text-gray-400 text-sm flex items-center gap-2">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
              16 Min. Lesezeit
            </span>
          </div>
          <h1 class="text-3xl md:text-5xl font-heading font-bold mb-6 leading-tight">
            S1- und S2-Labor: Anforderungen nach GenTSV und BioStoffV
          </h1>
          <p class="text-xl text-gray-300 mb-8 leading-relaxed">
            Welche baulichen und technischen Anforderungen ein S1- und ein S2-Labor erfüllen muss, was die Vorschriften ausdrücklich nicht verlangen und wann die Behörde ins Spiel kommt. Mit Checkliste und den Paragrafen zum Nachlesen.
          </p>
          <div class="flex flex-wrap items-center gap-6 text-sm text-gray-400">
            <span class="flex items-center gap-2">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="18" height="18" x="3" y="4" rx="2" ry="2"/><line x1="16" x2="16" y1="2" y2="6"/><line x1="8" x2="8" y1="2" y2="6"/><line x1="3" x2="21" y1="10" y2="10"/></svg>
              22. Oktober 2026
            </span>
            <span class="flex items-center gap-2">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
              Thomas Boss, Technischer Leiter Planexus
            </span>
          </div>
        </div>
      </div>
    </section>

    <nav aria-label="Brotkrümelnavigation" class="bg-slate-50 border-b border-gray-100 py-4">
      <div class="container mx-auto px-4">
        <div class="flex items-center gap-2 text-sm text-gray-500">
          <a href="/" class="hover:text-primary">Start</a>
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><polyline points="9 18 15 12 9 6"/></svg>
          <a href="/magazin" class="hover:text-primary">Magazin</a>
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><polyline points="9 18 15 12 9 6"/></svg>
          <span class="text-[#5c7300] font-medium">S1/S2-Labor</span>
        </div>
      </div>
    </nav>

    <article class="py-16">
      <div class="container mx-auto px-4">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-12">
          <div class="lg:col-span-8 min-w-0">
            <div class="prose prose-lg max-w-none">

              <p class="text-xl text-gray-700 leading-relaxed mb-8">
                Wer ein Labor für Mikrobiologie, Zellkultur oder Molekularbiologie plant, stößt schnell auf zwei Kürzel: <strong class="text-slate-900 font-semibold">S1</strong> und <strong class="text-slate-900 font-semibold">S2</strong>. Sie entscheiden darüber, wie Böden, Arbeitsflächen, Waschbecken, Lüftung und Abfallwege aussehen müssen und ob die Behörde vor Arbeitsbeginn 45 Tage Zeit zur Prüfung hat. Die Vorgaben stehen allerdings nicht an einer Stelle, sondern verteilt auf das Gentechnikgesetz, die Gentechnik-Sicherheitsverordnung, die Biostoffverordnung und mehrere Technische Regeln.
              </p>

              <p class="text-gray-600 leading-relaxed mb-6">
                Dieser Beitrag fasst die <strong class="text-slate-900 font-semibold">S2-Labor Anforderungen</strong> und die Anforderungen an ein S1-Labor so zusammen, dass Laborleitungen, Projektleitungen und Bauverantwortliche daraus eine Planung ableiten können. Jede Anforderung ist mit der Fundstelle belegt. Am Ende steht eine Checkliste. Sie ersetzt nicht die Gefährdungsbeurteilung und nicht das Gespräch mit der zuständigen Behörde, sie zeigt aber, welche Fragen vor dem ersten Strich im Grundriss geklärt sein sollten.
              </p>

              <div class="bg-slate-50 border border-gray-100 rounded-2xl p-6 my-8 not-prose">
                <p class="font-bold text-slate-900 mb-3">Inhalt</p>
                <ol class="space-y-2 text-sm text-gray-700 list-decimal list-inside">
                  <li><a href="#zwei-regelwerke" class={linkClass}>Zwei Regelwerke, ein Kürzel</a></li>
                  <li><a href="#s1-labor" class={linkClass}>Anforderungen an ein S1-Labor</a></li>
                  <li><a href="#s2-labor" class={linkClass}>S2-Labor: bauliche und technische Anforderungen</a></li>
                  <li><a href="#nicht-verlangt" class={linkClass}>Was ein S2-Labor nicht braucht</a></li>
                  <li><a href="#lueftung" class={linkClass}>Lüftung im S2-Labor</a></li>
                  <li><a href="#anmeldung" class={linkClass}>Anzeige, Anmeldung, Genehmigung</a></li>
                  <li><a href="#organisation" class={linkClass}>Personal, Mutterschutz und Betrieb</a></li>
                  <li><a href="#dach" class={linkClass}>Schweiz und Österreich</a></li>
                  <li><a href="#container" class={linkClass}>S2-Labor im Laborcontainer</a></li>
                  <li><a href="#checkliste" class={linkClass}>Checkliste</a></li>
                </ol>
              </div>

              <h2 id="zwei-regelwerke" class="text-2xl font-heading font-bold text-slate-900 mt-12 mb-6">Zwei Regelwerke, ein Kürzel: GenTSV und BioStoffV</h2>

              <p class="text-gray-600 leading-relaxed mb-6">
                Im Laboralltag heißt ein Raum schnell „das S2-Labor“. Rechtlich steckt dahinter je nach Arbeit eines von zwei Regelwerken, die nebeneinander gelten:
              </p>

              <ul class="space-y-3 text-gray-600 mb-6">
                <li><strong class="text-slate-900">Gentechnikrecht:</strong> Das Gentechnikgesetz (GenTG) und die Gentechnik-Sicherheitsverordnung (GenTSV) gelten für Arbeiten mit gentechnisch veränderten Organismen, etwa für die Klonierung in Bakterien oder die Arbeit mit transfizierten Zelllinien. Sie teilen die Arbeiten in die <strong class="text-slate-900">Sicherheitsstufen 1 bis 4</strong> ein. Das sind die „S“-Stufen im engeren Sinn.</li>
                <li><strong class="text-slate-900">Arbeitsschutzrecht:</strong> Die Biostoffverordnung (BioStoffV) gilt für Tätigkeiten mit biologischen Arbeitsstoffen, also mit Bakterien, Viren, Pilzen oder Zellkulturen, die Menschen gefährden können. Sie ordnet die Biostoffe in <strong class="text-slate-900">Risikogruppen 1 bis 4</strong> ein und leitet daraus die <strong class="text-slate-900">Schutzstufen 1 bis 4</strong> für Laboratorien ab. Konkretisiert wird sie durch die TRBA 100, die im November 2025 neu herausgegeben wurde.</li>
              </ul>

              <p class="text-gray-600 leading-relaxed mb-6">
                Viele Labore fallen unter beide Regelwerke, zum Beispiel wenn gentechnisch veränderte Bakterien der Risikogruppe 2 bearbeitet werden. Dann gelten die Anforderungen beider Vorschriften zusammen. Für die Planung heißt das: Die strengere Anforderung setzt sich durch. Die folgende Tabelle zeigt die Zuordnung.
              </p>

              <div class="overflow-x-auto my-8 not-prose">
                <table class="w-full text-sm border-collapse border border-gray-200 min-w-[560px]">
                  <thead class="bg-slate-100">
                    <tr>
                      <th class="text-left p-3 border border-gray-200 text-slate-900">Stufe</th>
                      <th class="text-left p-3 border border-gray-200 text-slate-900">Gentechnik (§ 7 GenTG)</th>
                      <th class="text-left p-3 border border-gray-200 text-slate-900">Biostoffe (BioStoffV)</th>
                      <th class="text-left p-3 border border-gray-200 text-slate-900">Typische Beispiele</th>
                    </tr>
                  </thead>
                  <tbody class="text-gray-700">
                    <tr><td class="p-3 border border-gray-200 font-semibold">1</td><td class="p-3 border border-gray-200">kein Risiko für Mensch und Umwelt zu erwarten</td><td class="p-3 border border-gray-200">Risikogruppe 1: Krankheit beim Menschen unwahrscheinlich</td><td class="p-3 border border-gray-200">Klonierung in Laborstämmen von E. coli K12</td></tr>
                    <tr><td class="p-3 border border-gray-200 font-semibold">2</td><td class="p-3 border border-gray-200">geringes Risiko</td><td class="p-3 border border-gray-200">Risikogruppe 2: kann Krankheit hervorrufen, Verbreitung in der Bevölkerung unwahrscheinlich, Behandlung meist möglich</td><td class="p-3 border border-gray-200">Staphylococcus aureus, Arbeiten mit Lentiviren-Vektoren</td></tr>
                    <tr><td class="p-3 border border-gray-200 font-semibold">3</td><td class="p-3 border border-gray-200">mäßiges Risiko</td><td class="p-3 border border-gray-200">Risikogruppe 3: schwere Krankheit, Verbreitung möglich</td><td class="p-3 border border-gray-200">Mycobacterium tuberculosis</td></tr>
                    <tr><td class="p-3 border border-gray-200 font-semibold">4</td><td class="p-3 border border-gray-200">hohes Risiko</td><td class="p-3 border border-gray-200">Risikogruppe 4: schwere Krankheit, große Verbreitungsgefahr</td><td class="p-3 border border-gray-200">Ebolavirus</td></tr>
                  </tbody>
                </table>
              </div>

              <p class="text-gray-600 leading-relaxed mb-6">
                Bestehen Zweifel an der richtigen Stufe, ordnet das Gentechnikgesetz die Arbeit der höheren Stufe zu (§ 7 Abs. 1a GenTG). Die Einstufung einzelner Organismen veröffentlicht die Zentrale Kommission für die Biologische Sicherheit (ZKBS) in Stellungnahmen und Listen. Für die Biostoffe stehen die Einstufungen in den Technischen Regeln TRBA 460 bis 468. Die Beispiele in der Tabelle sind typische Fälle zur Orientierung, die verbindliche Einstufung folgt aus der Risikobewertung für die konkrete Arbeit.
              </p>

              <p class="text-gray-600 leading-relaxed mb-6">
                Dieser Beitrag behandelt die Stufen 1 und 2, weil sie den größten Teil der Forschungs-, Diagnostik- und Industrielabore ausmachen. Was ab Stufe 3 dazukommt, etwa Schleuse, Unterdruckkaskade und HEPA-Filter, beschreibt unser Beitrag <a href="/magazin/bsl-2-bsl-3-container-labor" class={linkClass}>BSL-2 und BSL-3 im Container</a>.
              </p>

              <h2 id="s1-labor" class="text-2xl font-heading font-bold text-slate-900 mt-12 mb-6">Anforderungen an ein S1-Labor</h2>

              <p class="text-gray-600 leading-relaxed mb-6">
                Die Sicherheitsmaßnahmen für Laborbereiche stehen in Anlage 2 der GenTSV, Teil A. Für Sicherheitsstufe 1 sind sie überschaubar. Das ist gewollt: S1-Arbeiten gelten nach dem Stand der Wissenschaft als risikofrei. Trotzdem muss ein S1-Labor klar als Gentechnik-Arbeitsbereich erkennbar sein und eine Grundhygiene ermöglichen.
              </p>

              <ul class="space-y-3 text-gray-600 mb-6">
                <li><strong class="text-slate-900">Kennzeichnung:</strong> Der Raum ist als Gentechnik-Arbeitsbereich der Sicherheitsstufe 1 gekennzeichnet.</li>
                <li><strong class="text-slate-900">Oberflächen:</strong> Arbeitsflächen sind leicht zu reinigen und beständig gegen die verwendeten Stoffe sowie gegen Reinigungs- und Desinfektionsmittel.</li>
                <li><strong class="text-slate-900">Waschbecken:</strong> Ein Waschbecken mit Spendern für Handwaschmittel und Einmalhandtücher, bei Bedarf auch für Desinfektionsmittel.</li>
                <li><strong class="text-slate-900">Türen:</strong> Sie sollen in Fluchtrichtung aufschlagen und ein Sichtfenster haben.</li>
                <li><strong class="text-slate-900">Autoklav:</strong> Ein Autoklav oder eine gleichwertige Einrichtung muss auf dem Betriebsgelände vorhanden sein.</li>
                <li><strong class="text-slate-900">Fenster:</strong> Sie sollen während der Arbeiten geschlossen sein.</li>
                <li><strong class="text-slate-900">Aerosole:</strong> Ihre Bildung ist so weit wie möglich zu vermeiden.</li>
                <li><strong class="text-slate-900">Schutzkleidung:</strong> Laborkittel, bei Bedarf Handschuhe und Schutzbrille. Die Schutzkleidung wird getrennt von der Straßenkleidung aufbewahrt.</li>
              </ul>

              <p class="text-gray-600 leading-relaxed mb-6">
                Für die Planung bedeutet das: Ein gut ausgestattetes Standardlabor mit glatten, chemikalienbeständigen Oberflächen erfüllt die baulichen Anforderungen an S1 meist schon. Der Autoklav darf an anderer Stelle auf dem Gelände stehen. Wer heute mit S1 plant und absehbar S2-Arbeiten aufnehmen will, sollte die S2-Anforderungen aber gleich mit einplanen. Ein nachträglicher Austausch von Bodenbelag und Arbeitsflächen ist deutlich aufwendiger als die richtige Wahl beim Bau.
              </p>

              <h2 id="s2-labor" class="text-2xl font-heading font-bold text-slate-900 mt-12 mb-6">S2-Labor: bauliche und technische Anforderungen</h2>

              <p class="text-gray-600 leading-relaxed mb-6">
                Bei Sicherheitsstufe 2 kommen deutlich mehr bauliche Anforderungen dazu. Die Tabelle stellt die Vorgaben aus Anlage 2 Teil A Abschnitt II der GenTSV und die Maßnahmen der Schutzstufe 2 aus Anhang II der BioStoffV nebeneinander. „Verbindlich“ und „empfohlen“ sind die Begriffe der Biostoffverordnung. Empfohlene Maßnahmen sind nach § 10 BioStoffV zu ergreifen, wenn sie die Gefährdung der Beschäftigten verringern können.
              </p>

              <div class="overflow-x-auto my-8 not-prose">
                <table class="w-full text-sm border-collapse border border-gray-200 min-w-[620px]">
                  <thead class="bg-slate-100">
                    <tr>
                      <th class="text-left p-3 border border-gray-200 text-slate-900">Anforderung</th>
                      <th class="text-left p-3 border border-gray-200 text-slate-900">GenTSV, Sicherheitsstufe 2</th>
                      <th class="text-left p-3 border border-gray-200 text-slate-900">BioStoffV, Schutzstufe 2</th>
                    </tr>
                  </thead>
                  <tbody class="text-gray-700">
                    <tr><td class="p-3 border border-gray-200 font-semibold">Kennzeichnung</td><td class="p-3 border border-gray-200">Gentechnik-Arbeitsbereich Stufe 2 und Warnzeichen „Biogefährdung“</td><td class="p-3 border border-gray-200">Schutzstufe und Symbol für Biogefährdung an der Zugangstür</td></tr>
                    <tr><td class="p-3 border border-gray-200 font-semibold">Türen und Einsicht</td><td class="p-3 border border-gray-200">sollen in Fluchtrichtung aufschlagen und ein Sichtfenster haben</td><td class="p-3 border border-gray-200">Sichtfenster oder vergleichbare Einsicht: verbindlich</td></tr>
                    <tr><td class="p-3 border border-gray-200 font-semibold">Oberflächen</td><td class="p-3 border border-gray-200">leicht zu reinigen und beständig; Arbeitsflächen, angrenzende Wände, Boden und Wand-Boden-Anschluss flüssigkeitsdicht</td><td class="p-3 border border-gray-200">wasserundurchlässig, leicht zu reinigen, beständig gegen Chemikalien und Desinfektionsmittel: verbindlich</td></tr>
                    <tr><td class="p-3 border border-gray-200 font-semibold">Waschbecken</td><td class="p-3 border border-gray-200">nahe der Tür, mit Spendern für Desinfektionsmittel, Handwaschmittel und Einmalhandtücher; Armaturen möglichst berührungsfrei</td><td class="p-3 border border-gray-200">Dekontaminations- und Wascheinrichtungen für Beschäftigte: verbindlich</td></tr>
                    <tr><td class="p-3 border border-gray-200 font-semibold">Augenspülung</td><td class="p-3 border border-gray-200">Einrichtung zum Spülen der Augen muss vorhanden sein</td><td class="p-3 border border-gray-200">über die Gefährdungsbeurteilung</td></tr>
                    <tr><td class="p-3 border border-gray-200 font-semibold">Abläufe</td><td class="p-3 border border-gray-200">keine Bodenabläufe; Ausgussbecken in Arbeitsflächen mit Aufkantung</td><td class="p-3 border border-gray-200">keine eigene Vorgabe</td></tr>
                    <tr><td class="p-3 border border-gray-200 font-semibold">Aerosole</td><td class="p-3 border border-gray-200">dürfen nicht in den Arbeitsbereich gelangen, z. B. durch Sicherheitswerkbank oder aerosoldichte Geräte</td><td class="p-3 border border-gray-200">mikrobiologische Sicherheitswerkbank bei Aerosolbildung: verbindlich</td></tr>
                    <tr><td class="p-3 border border-gray-200 font-semibold">Prozessabluft</td><td class="p-3 border border-gray-200">vor der Abgabe filtern oder thermisch behandeln</td><td class="p-3 border border-gray-200">nicht in den Arbeitsbereich abgeben: verbindlich</td></tr>
                    <tr><td class="p-3 border border-gray-200 font-semibold">Autoklav</td><td class="p-3 border border-gray-200">mit ausreichender Kapazität in der Anlage oder im selben Gebäude</td><td class="p-3 border border-gray-200">eigener Autoklav: empfohlen; wirksame Inaktivierung festgelegt: verbindlich</td></tr>
                    <tr><td class="p-3 border border-gray-200 font-semibold">Fenster</td><td class="p-3 border border-gray-200">müssen während der Arbeiten geschlossen sein</td><td class="p-3 border border-gray-200">dürfen sich öffnen lassen, sind während der Tätigkeit aber geschlossen</td></tr>
                    <tr><td class="p-3 border border-gray-200 font-semibold">Zugang</td><td class="p-3 border border-gray-200">nur Beteiligte und von der Projektleitung ermächtigte Personen</td><td class="p-3 border border-gray-200">auf benannte Beschäftigte beschränkt, mit Zugangskontrolle bei gelisteten humanpathogenen Erregern</td></tr>
                    <tr><td class="p-3 border border-gray-200 font-semibold">Abgrenzung</td><td class="p-3 border border-gray-200">keine eigene Vorgabe</td><td class="p-3 border border-gray-200">Abgrenzung von anderen Bereichen: empfohlen</td></tr>
                    <tr><td class="p-3 border border-gray-200 font-semibold">Abfall</td><td class="p-3 border border-gray-200">in dicht geschlossenen, gekennzeichneten Behältern sammeln und transportieren</td><td class="p-3 border border-gray-200">Inaktivierung vor der Entsorgung, sofern keine sachgerechte Entsorgung durch Fachfirma</td></tr>
                    <tr><td class="p-3 border border-gray-200 font-semibold">Notstrom</td><td class="p-3 border border-gray-200">keine eigene Vorgabe</td><td class="p-3 border border-gray-200">für sicherheitsrelevante Einrichtungen: empfohlen</td></tr>
                  </tbody>
                </table>
              </div>

              <p class="text-gray-600 leading-relaxed mb-6">
                Drei Punkte aus der Tabelle werden in der Planung besonders oft unterschätzt.
              </p>

              <h3 class="text-xl font-heading font-bold text-slate-900 mt-8 mb-4">Flüssigkeitsdichte Flächen bis in die Ecke</h3>

              <p class="text-gray-600 leading-relaxed mb-6">
                Die GenTSV verlangt bei Stufe 2 nicht nur dichte Arbeitsflächen, sondern ausdrücklich auch flüssigkeitsdichte angrenzende Wände, Böden und Wand-Boden-Anschlüsse. In der Praxis heißt das: ein fugenloser Bodenbelag, der an der Wand als Hohlkehle hochgezogen wird, verschweißte Nähte und abgedichtete Durchführungen für Leitungen. Arbeitsplatten aus Keramik, Kunstharz oder Edelstahl mit dichten Wandanschlüssen. Die Materialien müssen dem Desinfektionsmittel standhalten, das später tatsächlich verwendet wird. Das sollte vor der Bemusterung feststehen, nicht danach.
              </p>

              <h3 class="text-xl font-heading font-bold text-slate-900 mt-8 mb-4">Das Waschbecken gehört an die Tür</h3>

              <p class="text-gray-600 leading-relaxed mb-6">
                Das Waschbecken soll nahe der Tür liegen, damit Hände beim Verlassen des Labors gewaschen und desinfiziert werden, bevor die Klinke berührt wird. Armaturen sollen möglichst ohne Handkontakt bedienbar sein, etwa mit Ellenbogenhebel oder Sensor. Dazu gehört die Augenspüleinrichtung. Bodenabläufe sind im S2-Bereich nicht vorgesehen. Ausgussbecken in den Arbeitsflächen brauchen eine Aufkantung, damit verschüttete Flüssigkeit nicht unkontrolliert abläuft. Das hat Folgen für die Entwässerung und damit für den Grundriss.
              </p>

              <h3 class="text-xl font-heading font-bold text-slate-900 mt-8 mb-4">Die Sicherheitswerkbank bestimmt den Raum</h3>

              <p class="text-gray-600 leading-relaxed mb-6">
                Sobald bei S2-Arbeiten Aerosole entstehen können, etwa beim Pipettieren, Vortexen, Öffnen von Kulturgefäßen oder Zentrifugieren, ist eine mikrobiologische Sicherheitswerkbank Pflicht. Üblich ist die Klasse II nach DIN EN 12469. Ihre Leistung hängt vom Aufstellort ab: Türen, Laufwege und Zuluftauslässe in der Nähe der Arbeitsöffnung stören den Luftvorhang. Die Werkbank gehört deshalb in eine ruhige Ecke, nicht neben die Tür. Ob die Werkbank-Abluft in den Raum zurückgeführt oder nach außen abgeführt wird, ist eine Frage der Lüftungsplanung. Bei Arbeiten mit Gefahrstoffen im selben Labor kommt ein Abzug hinzu. Die Anforderungen an Abzüge erläutert unser Beitrag zu <a href="/magazin/laborcontainer-laborabzug-din-en-14175" class={linkClass}>Laborabzügen nach DIN EN 14175</a>.
              </p>

              <h2 id="nicht-verlangt" class="text-2xl font-heading font-bold text-slate-900 mt-12 mb-6">Was ein S2-Labor nicht braucht</h2>

              <p class="text-gray-600 leading-relaxed mb-6">
                Bei S2 wird häufig mehr geplant als vorgeschrieben ist. Das kostet Fläche und Bauzeit und macht den späteren Betrieb aufwendiger. Anhang II der Biostoffverordnung führt für Schutzstufe 2 folgende Maßnahmen ausdrücklich als <strong class="text-slate-900">nicht erforderlich</strong>:
              </p>

              <ul class="space-y-3 text-gray-600 mb-6">
                <li><strong class="text-slate-900">Schleuse</strong> mit gegeneinander verriegelten Türen</li>
                <li><strong class="text-slate-900">Ständiger Unterdruck</strong> im Laborbereich</li>
                <li><strong class="text-slate-900">HEPA-Filter</strong> oder vergleichbare Filter für Zu- und Abluft des Raums</li>
                <li><strong class="text-slate-900">Abdichtbarkeit</strong> des Raums für eine Begasung</li>
                <li><strong class="text-slate-900">Duschen</strong> vor dem Verlassen des Bereichs</li>
                <li><strong class="text-slate-900">Fenster, die sich nicht öffnen lassen</strong> (sie müssen während der Arbeit aber geschlossen sein)</li>
              </ul>

              <p class="text-gray-600 leading-relaxed mb-6">
                Auch die GenTSV sieht diese Maßnahmen für Sicherheitsstufe 2 nicht vor. Sie gehören zu Stufe 3. Das heißt nicht, dass sie bei S2 nie sinnvoll sind. Die Gefährdungsbeurteilung kann für einzelne Tätigkeiten mehr verlangen, und manche Betreiber planen bewusst eine Stufe höher, um später flexibler zu sein. Diese Entscheidung sollte aber bewusst und begründet fallen. Ein „S2 plus“ mit Unterdruck und Schleuse ist rechtlich kein S3-Labor. Für echte S3-Arbeiten braucht es Erlaubnis und Genehmigung mit eigenen Anforderungen.
              </p>

              <p class="text-gray-600 leading-relaxed mb-6">
                Empfohlen, aber nicht verbindlich sind bei Schutzstufe 2 eine Abgrenzung von anderen Bereichen im Gebäude, eigene Ausrüstung für den Bereich, ein eigener Autoklav, eine Notrufmöglichkeit bei Alleinarbeit, eine Notstromversorgung für sicherheitsrelevante Einrichtungen und eine Kontrolle von Schädlingen. Hier lohnt sich die Abwägung im Einzelfall. Eine Notstromversorgung für Sicherheitswerkbank und Kühlgeräte schützt zum Beispiel auch wertvolle Proben.
              </p>

              <h2 id="lueftung" class="text-2xl font-heading font-bold text-slate-900 mt-12 mb-6">S2-Labor Anforderungen an die Lüftung</h2>

              <p class="text-gray-600 leading-relaxed mb-6">
                Zur Lüftung gibt es viele Fragen und wenige direkte Vorgaben. Weder die GenTSV noch die BioStoffV schreiben für Stufe 2 eine bestimmte Luftwechselrate vor. Verbindlich ist nur, dass kontaminierte Prozessabluft, etwa aus Geräten oder Fermentern, vor der Abgabe gefiltert oder thermisch behandelt wird und nicht in den Arbeitsbereich gelangt.
              </p>

              <p class="text-gray-600 leading-relaxed mb-6">
                Die eigentliche Vorgabe für die Raumlüftung kommt meist aus dem Gefahrstoffrecht. Fast jedes biologische Labor arbeitet auch mit Gefahrstoffen, etwa mit Ethanol, Formaldehyd, Phenol oder Desinfektionsmitteln. Dann gilt die TRGS 526 „Laboratorien“. Sie verlangt ausreichende, jederzeit wirksame technische Lüftungseinrichtungen und nennt als Richtwert <strong class="text-slate-900">25 Kubikmeter Luft pro Stunde und Quadratmeter Nutzfläche</strong>. Bei 3 Metern Raumhöhe entspricht das gut acht Luftwechseln pro Stunde. Eine Reduzierung ist möglich, wenn die Gefährdungsbeurteilung zeigt, dass ein geringerer Luftwechsel dauerhaft ausreicht. Arbeiten mit größeren Mengen leicht flüchtiger oder entzündbarer Stoffe sind dann aber eingeschränkt, und der Eingang muss einen Hinweis auf den reduzierten Luftwechsel tragen.
              </p>

              <p class="text-gray-600 leading-relaxed mb-6">
                Dazu kommt eine praktische Folge der S2-Regeln: Fenster müssen während der Arbeit geschlossen sein. Ohne technische Lüftung lässt sich ein S2-Labor deshalb weder ausreichend mit Frischluft versorgen noch im Sommer kühlen. Sicherheitswerkbänke, Inkubatoren, Zentrifugen und Kühlgeräte erzeugen erhebliche Wärme. In der Lüftungsplanung sollten deshalb Gefahrstoffe, Wärmelast, Abzüge und Sicherheitswerkbänke gemeinsam betrachtet werden. Wie wir Luftwechsel, Kühllast und Normen in einem Container zusammenbringen, beschreibt der Beitrag zur <a href="/magazin/laborcontainer-klimatisierung-lueftung-normen" class={linkClass}>Klimatisierung und Lüftung im Laborcontainer</a>.
              </p>

              <p class="text-gray-600 leading-relaxed mb-6">
                Ein leichter Unterdruck gegenüber Flur oder Nachbarräumen ist bei S2 nicht vorgeschrieben, wird aber oft geplant, damit Gerüche und Aerosole im Labor bleiben. Wichtig ist dann, dass die Luftströmung die Sicherheitswerkbank nicht stört. Ein Unterdruck, der beim Öffnen der Tür einen starken Luftzug erzeugt, schadet mehr als er nützt.
              </p>

              <h2 id="anmeldung" class="text-2xl font-heading font-bold text-slate-900 mt-12 mb-6">Anzeige, Anmeldung, Genehmigung: Wann die Behörde ins Spiel kommt</h2>

              <p class="text-gray-600 leading-relaxed mb-6">
                Gentechnische Arbeiten dürfen nur in gentechnischen Anlagen stattfinden (§ 8 Abs. 1 GenTG). Welches Verfahren für die Anlage gilt, hängt von der Sicherheitsstufe ab. Bei Biostoffen regelt die BioStoffV zusätzlich eigene Anzeige- und Erlaubnispflichten.
              </p>

              <div class="overflow-x-auto my-8 not-prose">
                <table class="w-full text-sm border-collapse border border-gray-200 min-w-[560px]">
                  <thead class="bg-slate-100">
                    <tr>
                      <th class="text-left p-3 border border-gray-200 text-slate-900">Fall</th>
                      <th class="text-left p-3 border border-gray-200 text-slate-900">Verfahren</th>
                      <th class="text-left p-3 border border-gray-200 text-slate-900">Beginn der Arbeiten</th>
                    </tr>
                  </thead>
                  <tbody class="text-gray-700">
                    <tr><td class="p-3 border border-gray-200 font-semibold">Gentechnische Anlage S1, erstmalige Arbeiten</td><td class="p-3 border border-gray-200">schriftliche Anzeige (§ 8 Abs. 2 GenTG)</td><td class="p-3 border border-gray-200">sofort nach Eingang der Anzeige (§ 12 Abs. 5a GenTG)</td></tr>
                    <tr><td class="p-3 border border-gray-200 font-semibold">Gentechnische Anlage S2, erstmalige Arbeiten</td><td class="p-3 border border-gray-200">schriftliche Anmeldung (§ 8 Abs. 2 GenTG), alternativ Genehmigung auf Antrag</td><td class="p-3 border border-gray-200">45 Tage nach Eingang, früher mit Zustimmung der Behörde (§ 12 Abs. 5 GenTG)</td></tr>
                    <tr><td class="p-3 border border-gray-200 font-semibold">Weitere S2-Arbeiten in angemeldeter Anlage</td><td class="p-3 border border-gray-200">Anzeige (§ 9 GenTG)</td><td class="p-3 border border-gray-200">sofort nach Eingang der Anzeige</td></tr>
                    <tr><td class="p-3 border border-gray-200 font-semibold">Gentechnische Anlage S3 oder S4</td><td class="p-3 border border-gray-200">Anlagengenehmigung (§ 8 Abs. 1 GenTG)</td><td class="p-3 border border-gray-200">nach Erteilung der Genehmigung</td></tr>
                    <tr><td class="p-3 border border-gray-200 font-semibold">Erstmalige gezielte Tätigkeit mit Biostoffen der Risikogruppe 2</td><td class="p-3 border border-gray-200">Anzeige an die Arbeitsschutzbehörde (§ 16 BioStoffV)</td><td class="p-3 border border-gray-200">Anzeige spätestens 30 Tage vor Aufnahme</td></tr>
                    <tr><td class="p-3 border border-gray-200 font-semibold">Tätigkeiten der Schutzstufe 3 oder 4</td><td class="p-3 border border-gray-200">Erlaubnis (§ 15 BioStoffV)</td><td class="p-3 border border-gray-200">nach Erteilung der Erlaubnis</td></tr>
                  </tbody>
                </table>
              </div>

              <p class="text-gray-600 leading-relaxed mb-6">
                Die 45 Tage bei S2 sind keine feste Bearbeitungszeit. Die Frist ruht, solange die Behörde auf nachgeforderte Unterlagen wartet oder die Stellungnahme der ZKBS einholt. Das geschieht, wenn die geplante Arbeit nicht mit einer bereits eingestuften Arbeit vergleichbar ist (§ 12 Abs. 4 GenTG). Läuft die Frist ohne Rückmeldung ab, gilt das als Zustimmung. Vollständige Unterlagen beim ersten Einreichen sind deshalb der wichtigste Hebel für den Zeitplan.
              </p>

              <p class="text-gray-600 leading-relaxed mb-6">
                Zur Anmeldung gehören nach § 12 Abs. 2 in Verbindung mit § 10 GenTG unter anderem die Beschreibung der Anlage mit Lageplan und Grundriss, die Risikobewertung, die geplanten Arbeiten, die Sicherheitsmaßnahmen sowie Angaben zu Projektleitung, Beauftragtem für die Biologische Sicherheit und Abfallentsorgung. Die Länder stellen dafür eigene Formblätter bereit. Zuständig ist je nach Bundesland zum Beispiel das Regierungspräsidium, die Bezirksregierung oder ein Landesamt.
              </p>

              <p class="text-gray-600 leading-relaxed mb-6">
                Getrennt davon steht das Baurecht. Ein neuer Laborbau, ein Umbau mit Nutzungsänderung oder ein aufgestellter Laborcontainer kann eine Baugenehmigung brauchen. Das gentechnische Verfahren ersetzt sie nicht. Welche Fragen dabei auftauchen, beschreibt unser Praxisleitfaden zur <a href="/magazin/laborcontainer-genehmigung-baurecht-vorschriften" class={linkClass}>Genehmigung von Laborcontainern</a>. Beide Verfahren lassen sich parallel vorbereiten, wenn Grundriss und Ausstattung früh feststehen.
              </p>

              <h2 id="organisation" class="text-2xl font-heading font-bold text-slate-900 mt-12 mb-6">Personal, Mutterschutz und Betrieb</h2>

              <p class="text-gray-600 leading-relaxed mb-6">
                Ein S2-Labor ist nicht nur eine Frage der Bauteile. Wer gentechnische Arbeiten durchführt, muss eine Projektleitung sowie Beauftragte oder einen Ausschuss für die Biologische Sicherheit bestellen (§ 6 Abs. 4 GenTG). Zum Betrieb gehören außerdem eine Betriebsanweisung, Unterweisungen der Beschäftigten, ein Hygieneplan und die Aufzeichnungen über die gentechnischen Arbeiten. Die TRBA 100 in der Fassung von November 2025 hat die Regeln zu Unterweisungen und zum Einsatz von Fremdfirmen erweitert. Das betrifft auch Handwerker und Servicetechniker, die im S2-Bereich arbeiten.
              </p>

              <p class="text-gray-600 leading-relaxed mb-6">
                Eine häufig gesuchte Frage betrifft Schwangere im S2-Labor. Nach § 11 Abs. 2 Mutterschutzgesetz darf der Arbeitgeber eine schwangere Frau keine Tätigkeiten ausüben lassen, bei denen sie mit Biostoffen der Risikogruppen 2, 3 oder 4 in einem Maß in Kontakt kommen kann, das für sie oder ihr Kind eine unverantwortbare Gefährdung darstellt. Ausdrücklich genannt sind Rötelnvirus und Toxoplasma. Bei ausreichendem Immunschutz gilt die Gefährdung insoweit als ausgeschlossen. Ein generelles Arbeitsverbot im S2-Labor folgt daraus nicht. Entscheidend ist die Gefährdungsbeurteilung für die konkreten Tätigkeiten, die der Arbeitgeber anpassen muss, sobald er von der Schwangerschaft erfährt.
              </p>

              <h2 id="dach" class="text-2xl font-heading font-bold text-slate-900 mt-12 mb-6">Schweiz und Österreich</h2>

              <p class="text-gray-600 leading-relaxed mb-6">
                In der <strong class="text-slate-900">Schweiz</strong> regelt die Einschliessungsverordnung (ESV) den Umgang mit Organismen in geschlossenen Systemen. Sie teilt Tätigkeiten in die Klassen 1 bis 4 ein. Tätigkeiten der Klassen 1 und 2 sind meldepflichtig, Klassen 3 und 4 bewilligungspflichtig. Die Meldung geht an die Kontaktstelle Biotechnologie des Bundes, eingereicht über das Portal ECOGEN. Nach Eingang der Meldung darf mit Arbeiten der Klasse 1 und 2 begonnen werden. Den Arbeitsschutz regelt zusätzlich die Verordnung über den Schutz der Arbeitnehmerinnen und Arbeitnehmer vor Gefährdung durch Mikroorganismen (SAMV).
              </p>

              <p class="text-gray-600 leading-relaxed mb-6">
                In <strong class="text-slate-900">Österreich</strong> regelt das Gentechnikgesetz (GTG) Arbeiten mit gentechnisch veränderten Organismen in geschlossenen Systemen, ebenfalls mit Sicherheitsstufen sowie Melde- und Genehmigungspflichten. Den Arbeitnehmerschutz bei biologischen Arbeitsstoffen regelt die Verordnung biologische Arbeitsstoffe (VbA). Verfahren und Fristen weichen vom deutschen Recht ab und sollten mit der zuständigen Behörde geklärt werden. Für Standorte in <a href="/laborcontainer-zuerich" class={linkClass}>Zürich</a>, <a href="/laborcontainer-basel" class={linkClass}>Basel</a> oder <a href="/laborcontainer-wien" class={linkClass}>Wien</a> fassen unsere Standortseiten die regionalen Besonderheiten zusammen.
              </p>

              <h2 id="container" class="text-2xl font-heading font-bold text-slate-900 mt-12 mb-6">S2-Labor im Laborcontainer umsetzen</h2>

              <figure class="my-10 not-prose">
                <img
                  src="/images/backgrounds/magazin-bsl-labor.webp"
                  alt="Labor mit glatten, leicht zu reinigenden Arbeitsflächen, Geräten auf den Laborzeilen und einer Tür mit Sichtfenster, wie sie für ein S2-Labor gefordert ist"
                  width="2070"
                  height="1380"
                  loading="lazy"
                  decoding="async"
                  class="w-full h-auto rounded-2xl shadow-lg"
                />
                <figcaption class="text-sm text-gray-500 mt-3 text-center italic">
                  Symbolbild: Durchgehende Arbeitsflächen, geschlossene Laborzeilen und eine Tür mit Sichtfenster. Bei S2 kommen flüssigkeitsdichte Wand-Boden-Anschlüsse und die Kennzeichnung hinzu.
                </figcaption>
              </figure>

              <p class="text-gray-600 leading-relaxed mb-6">
                Die Vorschriften für S1- und S2-Labore beschreiben Oberflächen, Ausstattung, Lüftung, Kennzeichnung und Organisation. Die Bauweise schreiben sie nicht vor. Ein <a href="/laborcontainer" class={linkClass}>Laborcontainer</a> kann deshalb als S1- oder S2-Labor angemeldet und betrieben werden. Gerade bei S2 hat die Vorfertigung im Werk Vorteile: Bodenbelag mit Hohlkehle, dichte Durchführungen und Arbeitsflächen werden unter Werkstattbedingungen eingebaut und vor der Auslieferung geprüft.
              </p>

              <p class="text-gray-600 leading-relaxed mb-6">
                Für die Planung eines S2-Containers haben sich diese Punkte bewährt:
              </p>

              <ul class="space-y-3 text-gray-600 mb-6">
                <li><strong class="text-slate-900">Zonierung:</strong> Ein kleiner Vorraum zum Umkleiden trennt Straßen- und Schutzkleidung und grenzt den S2-Bereich ab. Vorgeschrieben ist er nicht, er erleichtert aber Hygiene und Zugangskontrolle.</li>
                <li><strong class="text-slate-900">Autoklav klären:</strong> Die GenTSV verlangt den Autoklav in der Anlage oder im selben Gebäude. Steht der Container für sich, stellt sich die Frage, ob ein Autoklav im Container nötig ist. Diese Frage gehört an den Anfang, weil ein Autoklav Platz, Strom, Wasser und Abwärme braucht.</li>
                <li><strong class="text-slate-900">Sicherheitswerkbank zuerst platzieren:</strong> Erst den ruhigen Platz für die Werkbank festlegen, dann Tür, Zuluft und Laufwege planen.</li>
                <li><strong class="text-slate-900">Entwässerung ohne Bodenablauf:</strong> Waschbecken und Ausgussbecken an der Wand bündeln, Abwasserwege und gegebenenfalls Inaktivierung von Laborabwasser früh mit dem Aufstellort abstimmen.</li>
                <li><strong class="text-slate-900">Lüftung und Kühlung gemeinsam auslegen:</strong> Wärmelast der Geräte, Luftwechsel nach TRGS 526 und Werkbank-Abluft in einem Konzept.</li>
                <li><strong class="text-slate-900">Kennzeichnung und Zugang:</strong> Schilder für Gentechnik-Arbeitsbereich und Biogefährdung, abschließbare Tür, bei Bedarf elektronische Zutrittskontrolle.</li>
                <li><strong class="text-slate-900">Dokumentation für die Anmeldung:</strong> Grundriss, Lageplan, Ausstattungsliste und Materialangaben so aufbereiten, dass sie direkt in die Unterlagen nach § 10 GenTG übernommen werden können.</li>
              </ul>

              <p class="text-gray-600 leading-relaxed mb-6">
                Planexus baut S1- und S2-Laborcontainer im Werk Albstadt. Ein individuell geplanter Container wird typischerweise in 8 bis 14 Wochen gefertigt. Die 45 Tage der S2-Anmeldung lassen sich parallel zur Fertigung nutzen, wenn die Unterlagen früh stehen. Wie ein Projekt von der ersten Anfrage bis zur Übergabe abläuft, zeigt der Beitrag zum <a href="/magazin/laborcontainer-projektablauf-von-idee-bis-uebergabe" class={linkClass}>Projektablauf</a>. Für die Ausstattung im Detail gibt es unsere <a href="/magazin/laborcontainer-ausstattung-checkliste" class={linkClass}>Ausstattungs-Checkliste</a>.
              </p>

              <p class="text-gray-600 leading-relaxed mb-6">
                Bleibt die Frage, ob der Container gemietet oder gekauft wird. Für eine Übergangszeit, etwa während einer Sanierung oder bis ein Neubau fertig ist, eignet sich ein <a href="/laborcontainer-mieten" class={linkClass}>Laborcontainer zur Miete</a>. Unser Beitrag zum <a href="/magazin/uebergangslabor-sanierung-mietcontainer" class={linkClass}>Übergangslabor bei Sanierung</a> zeigt, wie das in der Praxis aussieht. Für eine dauerhafte Erweiterung lohnt sich der <a href="/laborcontainer-kaufen" class={linkClass}>Kauf</a>. Wer eine kompakte, sofort einsetzbare Lösung sucht, findet mit dem <a href="/laborcontainer/labtogo" class={linkClass}>LABtoGO</a> einen Laborcontainer, dessen Laborraum S2-fähig ausgelegt ist.
              </p>

              <p class="text-gray-600 leading-relaxed mb-6">
                Der Bedarf ist da. Der Münchner Biotech-Clusterverband BioM berichtet, dass die Nachfrage nach Laborflächen im Großraum München das Angebot übersteigt, und ein Anbieter vollausgestatteter Labore nennt dort besonders S2-Labore als knapp. Für Forschungsgruppen und Biotech-Unternehmen an Standorten wie <a href="/laborcontainer-muenchen" class={linkClass}>München</a> oder <a href="/laborcontainer-berlin" class={linkClass}>Berlin</a> kann ein S2-Container die Zeit überbrücken, bis passende Flächen frei werden. Welche Lösungen wir für Forschung und Industrie anbieten, zeigen die Branchenseiten <a href="/branchen/pharma-biotech" class={linkClass}>Pharma und Biotech</a> sowie <a href="/branchen/forschung-hochschule" class={linkClass}>Forschung und Hochschule</a>.
              </p>

              <div id="checkliste" class="bg-slate-50 border border-gray-100 rounded-2xl p-8 my-8 not-prose">
                <h3 class="text-xl font-heading font-bold text-slate-900 mb-4">Checkliste: S2-Labor planen</h3>
                <ul class="space-y-3 text-gray-700">
                  <li class="flex gap-3"><span class="text-[#5c7300] font-bold">→</span> <span>Tätigkeiten beschreiben und einstufen: Sicherheitsstufe nach GenTG, Schutzstufe nach BioStoffV, oder beides</span></li>
                  <li class="flex gap-3"><span class="text-[#5c7300] font-bold">→</span> <span>Projektleitung und Beauftragten für die Biologische Sicherheit benennen</span></li>
                  <li class="flex gap-3"><span class="text-[#5c7300] font-bold">→</span> <span>Arbeitsflächen, angrenzende Wände, Boden und Wand-Boden-Anschluss flüssigkeitsdicht und desinfektionsmittelbeständig</span></li>
                  <li class="flex gap-3"><span class="text-[#5c7300] font-bold">→</span> <span>Waschbecken nahe der Tür mit Spendern, Armatur möglichst berührungsfrei, Augenspüleinrichtung</span></li>
                  <li class="flex gap-3"><span class="text-[#5c7300] font-bold">→</span> <span>Keine Bodenabläufe, Ausgussbecken mit Aufkantung</span></li>
                  <li class="flex gap-3"><span class="text-[#5c7300] font-bold">→</span> <span>Tür mit Sichtfenster, in Fluchtrichtung aufschlagend, gekennzeichnet mit Stufe und Biogefährdung</span></li>
                  <li class="flex gap-3"><span class="text-[#5c7300] font-bold">→</span> <span>Mikrobiologische Sicherheitswerkbank Klasse II an einem ruhigen Platz</span></li>
                  <li class="flex gap-3"><span class="text-[#5c7300] font-bold">→</span> <span>Autoklav in der Anlage oder im selben Gebäude, Inaktivierungsverfahren festlegen</span></li>
                  <li class="flex gap-3"><span class="text-[#5c7300] font-bold">→</span> <span>Technische Lüftung nach TRGS 526, Kühllast der Geräte berücksichtigen</span></li>
                  <li class="flex gap-3"><span class="text-[#5c7300] font-bold">→</span> <span>Zugang auf benannte Personen beschränken, Umkleidebereich für Schutzkleidung</span></li>
                  <li class="flex gap-3"><span class="text-[#5c7300] font-bold">→</span> <span>Anmeldung nach § 8 GenTG und Anzeige nach § 16 BioStoffV rechtzeitig einreichen</span></li>
                  <li class="flex gap-3"><span class="text-[#5c7300] font-bold">→</span> <span>Baurechtliche Genehmigung parallel klären</span></li>
                </ul>
              </div>

              <h2 id="fazit" class="text-2xl font-heading font-bold text-slate-900 mt-12 mb-6">Fazit</h2>

              <p class="text-gray-600 leading-relaxed mb-6">
                Die Anforderungen an ein S1-Labor sind überschaubar und werden von einem gut ausgestatteten Standardlabor meist erfüllt. Ein S2-Labor verlangt mehr: flüssigkeitsdichte Flächen bis zum Wand-Boden-Anschluss, ein Waschbecken an der Tür, eine Augenspülung, eine Sicherheitswerkbank bei Aerosolgefahr, einen Autoklav in der Anlage oder im selben Gebäude, keine Bodenabläufe und eine klare Kennzeichnung. Schleuse, Unterdruck und HEPA-Filter gehören dagegen nicht zu den Pflichten der Stufe 2.
              </p>

              <p class="text-gray-600 leading-relaxed mb-6">
                Rechtlich braucht eine S2-Anlage in Deutschland keine Genehmigung, sondern eine Anmeldung mit 45 Tagen Wartezeit. Wer die Unterlagen vollständig einreicht und die Planung früh mit der Behörde abstimmt, verliert hier keine Zeit. Ob als Umbau, Neubau oder <a href="/leistungen/modulbau" class={linkClass}>modularer Laborbau</a>: Die Anforderungen bleiben dieselben. Entscheidend ist, sie vor dem ersten Grundriss zu kennen.
              </p>

              <div class="bg-slate-900 text-white rounded-2xl p-8 my-12 text-center not-prose">
                <h3 class="text-2xl font-bold mb-4 text-primary">S2-Labor planen</h3>
                <p class="text-gray-300 mb-6 max-w-2xl mx-auto">Sie planen ein S1- oder S2-Labor und wollen wissen, wie es als Laborcontainer aussehen kann? Planexus klärt mit Ihnen Raumprogramm, Ausstattung und Lüftung und liefert die Unterlagen, die Sie für die Anmeldung brauchen.</p>
                <a href="/kontakt" class="inline-flex items-center gap-2 bg-primary text-slate-900 font-bold px-8 py-4 rounded-lg hover:bg-primary/90 transition-colors">Kostenlose Erstberatung anfragen
                  <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
                </a>
              </div>

              <p class="text-xs text-gray-400 leading-relaxed">
                Quellen: Gentechnikgesetz §§ 6, 7, 8, 9, 10, 12 (gesetze-im-internet.de); Gentechnik-Sicherheitsverordnung Anlage 2 Teil A, Fassung vom 12.08.2019 (BGBl. I S. 1235); Biostoffverordnung §§ 10, 15, 16 und Anhang II (gesetze-im-internet.de); TRBA 100, Ausgabe November 2025 (GMBl. vom 10.11.2025, geändert 19.11.2025); TRGS 526 „Laboratorien“; Mutterschutzgesetz § 11; Bundesamt für Gesundheit (BAG) zu Meldungen und Bewilligungen nach der Einschliessungsverordnung; BioM, „Verfügbare Laborflächen in München“. Dieser Beitrag ersetzt keine Rechtsberatung und keine Gefährdungsbeurteilung. Stand: 22. Oktober 2026.
              </p>

            </div>
          </div>

