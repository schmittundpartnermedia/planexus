                      <td class="p-4 text-gray-600">2–3 Wochen</td>
                    </tr>
                    <tr class="border-b border-gray-100 bg-slate-50">
                      <td class="p-4 font-medium text-slate-900">Fachplanung</td>
                      <td class="p-4 text-gray-600">3–4 Wochen</td>
                      <td class="p-4 text-gray-600">4–6 Wochen</td>
                    </tr>
                    <tr class="border-b border-gray-100">
