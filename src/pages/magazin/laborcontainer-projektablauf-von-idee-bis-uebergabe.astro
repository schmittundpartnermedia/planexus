                      <td class="p-4 text-gray-600">4–8 Wochen</td>
                    </tr>
                    <tr class="border-b border-gray-100 bg-slate-50">
                      <td class="p-4 font-medium text-slate-900">Fertigung</td>
                      <td class="p-4 text-gray-600">8–10 Wochen</td>
                      <td class="p-4 text-gray-600">12–16 Wochen</td>
                    </tr>
                    <tr>
                      <td class="p-4 font-medium text-slate-900 rounded-bl-lg">Montage & Übergabe</td>
                      <td class="p-4 text-gray-600">3–5 Tage</td>
                      <td class="p-4 text-gray-600 rounded-br-lg">1–2 Wochen</td>
                    </tr>
                  </tbody>
                  <tfoot>
                    <tr class="bg-primary/10">
                      <td class="p-4 font-bold text-slate-900 rounded-bl-lg">Gesamt</td>
                      <td class="p-4 font-bold text-slate-900">ca. 14–20 Wochen</td>
                      <td class="p-4 font-bold text-slate-900 rounded-br-lg">ca. 22–35 Wochen</td>
                    </tr>
                  </tfoot>
                </table>
