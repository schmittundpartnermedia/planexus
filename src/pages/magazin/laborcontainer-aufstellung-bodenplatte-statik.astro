                    </tr>
                    <tr class="bg-slate-50">
                      <td class="border border-gray-200 px-4 py-3 font-medium">Einwirkungen allgemein</td>
                      <td class="border border-gray-200 px-4 py-3">DIN EN 1991-1-1 (Eurocode 1)</td>
                      <td class="border border-gray-200 px-4 py-3">Eigengewicht, Nutzlasten im Hochbau</td>
                    </tr>
                    <tr>
                      <td class="border border-gray-200 px-4 py-3 font-medium">Schneelast</td>
                      <td class="border border-gray-200 px-4 py-3">DIN EN 1991-1-3 + Nationaler Anhang DE</td>
                      <td class="border border-gray-200 px-4 py-3">Fünf Schneelastzonen DE (1, 1a, 2, 2a, 3), Höhenkorrektur</td>
