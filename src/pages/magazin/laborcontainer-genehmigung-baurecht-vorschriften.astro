                    <div class="text-2xl font-bold text-[#7a9900] mb-1">2</div>
                    <div class="text-xs font-medium text-slate-900">Bauvoranfrage</div>
                    <div class="text-xs text-gray-600 mt-1">Optional, aber klug</div>
                  </div>
                  <div class="text-center p-3 bg-white rounded-lg border border-gray-100">
                    <div class="text-2xl font-bold text-[#7a9900] mb-1">3</div>
                    <div class="text-xs font-medium text-slate-900">Unterlagen</div>
                    <div class="text-xs text-gray-600 mt-1">Vollständig einreichen</div>
                  </div>
