---
import Layout from '../../layouts/Layout.astro';
import ContactForm from '../../components/ContactForm.tsx';
import AuthorBio from '../../components/AuthorBio.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';

const title = "Laborcontainer für 6 Branchen – Übersicht";
const description = "Laborcontainer für 6 Branchen: Pharma/Biotech (GMP, Annex 1), Forschung (DFG), Industrie (ISO 17025), Bildung, Public Health (RKI), H₂ & Batterie (ATEX).";
const canonical = "/branchen";

const collectionSchema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": "Branchen-Lösungen für Laborcontainer",
  "description": "Übersicht aller sechs Branchen-Lösungen von Planexus für Laborcontainer in DACH",
  "url": "https://www.planexus.de/branchen",
  "publisher": { "@type": "Organization", "name": "Planexus GmbH", "url": "https://www.planexus.de" }
};
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Start", "item": "https://www.planexus.de/" },
    { "@type": "ListItem", "position": 2, "name": "Branchen", "item": "https://www.planexus.de/branchen" }
  ]
};

const branchen = [
  {
    slug: 'pharma-biotech',
    name: 'Pharma & Biotech',
    tagline: 'GMP, Annex 1, BSL-3 – inspektionsbereit ab Werk',
    desc: 'Reinraum-Container Klasse 5–8 (GMP A bis D), BSL-2/3 nach TRBA 100/120, Annex-1-konforme Druckkaskaden mit HEPA-H14-Doppelfilterung, vollständige IQ/OQ/PQ-Dokumentation. BfArM-, Swissmedic- und BASG-inspektionsbereit.',
    color: 'from-blue-500/10 to-indigo-500/5',
    badge: 'Annex 1 · ISO 14644 · ICH Q9/Q10',
  },
  {
    slug: 'forschung-hochschule',
    name: 'Forschung & Hochschule',
    tagline: 'DFG-förderfähig, GenTSV S1/S2, drittmittelreif in 18 Wochen',
    desc: 'Forschungs-Container für Universitäten, Helmholtz, Max-Planck, Fraunhofer, Leibniz. BSL-1/2 + S1/S2 nach GenTSV, GefStoffV-Lager nach DIN EN 14470, Mietverträge passgenau zur DFG/BMBF/EU-Projektlaufzeit. Sanierungs-Übergangsfläche inklusive.',
    color: 'from-emerald-500/10 to-teal-500/5',
    badge: 'GenTSV · DGUV V3 · DFG-Verwendungsrichtlinien',
  },
  {
    slug: 'industrie-werkstoffpruefung',
    name: 'Industrie & Werkstoffprüfung',
    tagline: 'ISO 17025, ATEX, schwingungsisoliert – ohne Werks-Stillstand',
    desc: 'Werks-QC-Container für Stahl, Automotive, Chemie, Bauindustrie, Maschinenbau. DAkkS-akkreditierungsfähig nach ISO/IEC 17025, ATEX/IECEx Zone 1/2, Klima-Klasse 1–5 nach VDI/VDE 2627, Schwingungsisolation für Mikrowaagen und REM.',
    color: 'from-amber-500/10 to-orange-500/5',
    badge: 'ISO 17025 · ATEX · VDI 2627',
  },
  {
    slug: 'bildung',
    name: 'Bildung & Berufsschulen',
    tagline: 'RiSU-konform, GEG-Sanierungs-Übergangsfläche, BTA/CTA/MTA-tauglich',
    desc: 'Schullabore nach RiSU-KMK 2019 und DGUV-Information 202-058. Übergangslabore während GEG-/Brandschutz-Sanierung in 8-12 Wochen. BTA-/CTA-/MTA-Ausbildungs-Container mit komplettem Übungs-Geräte-Spektrum. Übernahme-Option nach Sanierungs-Ende.',
    color: 'from-purple-500/10 to-violet-500/5',
    badge: 'RiSU-KMK · DGUV 202-058 · DIN EN 14175',
  },
  {
    slug: 'public-health-krisenvorsorge',
    name: 'Public Health & Krisenvorsorge',
    tagline: 'RKI, BBK, CBRN – einsatzbereit in 72 Stunden',
    desc: 'Mobile Diagnostik-Container für Pandemie und Großschadenslagen. BSL-2/3 für PCR und virale Diagnostik nach IfSG und RiliBÄK, CBRN-Module für ABC-Lagen, ZSKG-Bevorratung mit Rahmenverträgen, Hubschrauber-Heberahmen für CH-53/CH-47/NH-90.',
    color: 'from-red-500/10 to-rose-500/5',
    badge: 'IfSG · RiliBÄK · ZSKG · BBK',
  },
  {
    slug: 'energiewende-h2-batterie',
    name: 'Energiewende H₂ & Batterie',
    tagline: 'ATEX Zone 1/2, Thermal-Runaway-fest, IPCEI-förderfähig',
    desc: 'H₂-Test-Container nach ATEX 2014/34/EU + EN 60079, Battery-Abuse mit Thermal-Runaway-Schutz nach ISO 6469 und UN-ECE R100/R136, Trockenraum -40 °C Taupunkt für Cell-Manufacturing, IPCEI Hy2 + EuBatIn förderfähig. Für KIT, ZSW Ulm, Fraunhofer ISE, AVL Graz.',
    color: 'from-cyan-500/10 to-sky-500/5',
    badge: 'ATEX · EN 60079 · IPCEI',
  },
];
---
<Layout title={title} description={description} canonical={canonical} schema={collectionSchema}>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

  <div class="bg-white">
    <section class="bg-gradient-to-br from-slate-900 via-slate-800 to-slate-900 text-white pt-20 pb-16 md:pb-20">
      <div class="container mx-auto px-4">
        <div class="max-w-4xl">
          <div class="text-primary font-medium text-sm uppercase tracking-wider mb-4">Branchen-Lösungen DACH</div>
          <h1 class="text-4xl md:text-5xl lg:text-6xl font-heading font-bold mb-6 leading-tight">Laborcontainer für jede Branche – passgenaues Engineering, korrekte Norm, fertiges Behörden-Paket</h1>
          <p class="text-xl text-gray-300 leading-relaxed mb-4">Pharma kennt Annex 1, Forschung kennt DFG, Industrie kennt ISO 17025, Bildung kennt RiSU, Public Health kennt IfSG, Energiewende kennt ATEX. Jede Branche hat eigene Pflichten – wir liefern für jede die korrekte Container-Konfiguration mit der zugehörigen Dokumentation.</p>
          <p class="text-base text-gray-400">Sechs Branchen, ein Werk. Ab Albstadt für Deutschland, Schweiz und Österreich.</p>
        </div>
      </div>
    </section>

    <Breadcrumbs bar items={[{ name: 'Start', href: '/' }, { name: 'Branchen' }]} />

    <section class="py-16 md:py-20">
      <div class="container mx-auto px-4">
        <div class="max-w-6xl mx-auto">
          <div class="grid md:grid-cols-2 gap-6">
            {branchen.map(b => (
              <a href={`/branchen/${b.slug}`} class={`block bg-gradient-to-br ${b.color} border border-gray-200 rounded-2xl p-7 hover:shadow-xl hover:border-primary/40 transition-all group`}>
                <div class="text-xs uppercase tracking-wider text-[#7a9900] font-bold mb-2">{b.badge}</div>
                <h2 class="text-2xl md:text-3xl font-heading font-bold text-slate-900 mb-2 group-hover:text-[#7a9900]">{b.name}</h2>
                <p class="text-sm text-slate-700 font-semibold mb-3">{b.tagline}</p>
                <p class="text-gray-700 text-sm leading-relaxed mb-4">{b.desc}</p>
                <div class="inline-flex items-center gap-2 text-[#7a9900] font-bold text-sm">Branchen-Seite ansehen
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
                </div>
              </a>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section class="py-16 md:py-20 bg-slate-50">
      <div class="container mx-auto px-4">
        <div class="max-w-5xl mx-auto">
          <h2 class="text-3xl md:text-4xl font-heading font-bold mb-6 text-slate-900 text-center">Warum Planexus für jede Branche</h2>
          <p class="text-lg text-gray-700 leading-relaxed mb-10 text-center">Ein Generalist baut für alle Branchen ein bisschen. Ein Spezialist baut für jede Branche genau richtig. Wir betreiben seit über zehn Jahren ein Werk in Albstadt, das ausschließlich Laborcontainer fertigt – nicht nebenher Bürocontainer oder Sanitärmodule. Das macht den Unterschied bei Inspektionen.</p>
          <div class="grid md:grid-cols-3 gap-6">
            <div class="bg-white rounded-xl p-6 border border-gray-100">
              <div class="text-3xl font-bold text-primary mb-1">10+</div>
              <div class="font-bold text-slate-900 mb-2">Jahre Spezialisierung</div>
              <p class="text-sm text-gray-700">Ausschließlich Labor- und Reinraum-Container, keine Generalist-Verzettlung.</p>
            </div>
            <div class="bg-white rounded-xl p-6 border border-gray-100">
              <div class="text-3xl font-bold text-primary mb-1">DACH</div>
              <div class="font-bold text-slate-900 mb-2">DE / CH / AT in einer Hand</div>
              <p class="text-sm text-gray-700">Wir kennen LBO/MBO + SIA + OIB + ÖNORM und liefern jeweils inkl. Verzollung wo nötig.</p>
            </div>
            <div class="bg-white rounded-xl p-6 border border-gray-100">
              <div class="text-3xl font-bold text-primary mb-1">100 %</div>
              <div class="font-bold text-slate-900 mb-2">Dokumentations-Standard</div>
              <p class="text-sm text-gray-700">Branchen-Norm-konformes Doku-Paket ab Werk – keine Nacharbeit am Aufstellort.</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <AuthorBio />

    <section class="py-16 md:py-20 bg-white">
      <div class="container mx-auto px-4">
        <div class="max-w-3xl mx-auto">
          <div class="text-center mb-10">
            <h2 class="text-3xl md:text-4xl font-heading font-bold mb-4 text-slate-900">Container-Konzept für Ihre Branche</h2>
            <p class="text-gray-700 text-lg">Skizzieren Sie Branche, Anwendung und gewünschte Norm-Klassifizierung. Wir antworten innerhalb eines Werktags mit branchenspezifischem Konzept-Vorschlag.</p>
          </div>
          <ContactForm client:load />
        </div>
      </div>
    </section>
  </div>
</Layout>
