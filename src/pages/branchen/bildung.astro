---
import Layout from '../../layouts/Layout.astro';
import ContactForm from '../../components/ContactForm.tsx';
import Picture from '../../components/Picture.astro';
import AuthorBio from '../../components/AuthorBio.astro';
import BranchenCrossLinks from '../../components/BranchenCrossLinks.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';

const title = "Laborcontainer Bildung – Schule, BTA/CTA, MINT";
const description = "Laborcontainer für Schulen, Berufsschulen, BTA/CTA-Ausbildung, Fachhochschulen: GefStoffV-konform, RiSU-Empfehlung umgesetzt, Übergangslabor während GEG-Sanierung.";
const canonical = "/branchen/bildung";
const ogImage = "/attached_assets/generated_images/high-tech_lab_interior.png";

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "serviceType": "Laborcontainer für Bildung, Schule und Berufsschule",
  "provider": { "@type": "Organization", "name": "Planexus GmbH", "image": "https://planexus.de/android-chrome-512x512.png", "url": "https://planexus.de", "telephone": "+49 7435 7519 700", "email": "info@planexus.de", "address": { "@type": "PostalAddress", "streetAddress": "Am Steinbach 8", "addressLocality": "Albstadt", "postalCode": "72459", "addressCountry": "DE" }, "parentOrganization": { "@type": "Organization", "name": "Wesemann Holding GmbH" } },
  "areaServed": [{ "@type": "Country", "name": "Germany" }, { "@type": "Country", "name": "Switzerland" }, { "@type": "Country", "name": "Austria" }],
  "audience": { "@type": "BusinessAudience", "audienceType": "Schulträger, Berufsschulen, Fachhochschulen, BTA-/CTA-/MTA-Schulen, MINT-Förderschulen, Schulbaubehörden" },
  "description": "GefStoffV-konforme Schul-Laborcontainer nach RiSU-Empfehlung der KMK, Übergangslabore während GEG-/Brandschutz-Sanierung, BTA/CTA/MTA-Ausbildungslabore, MINT-Lehrlabor mit DGUV V3 und Notfall-Infrastruktur."
};
const breadcrumbSchema = { "@context": "https://schema.org", "@type": "BreadcrumbList", "itemListElement": [
  { "@type": "ListItem", "position": 1, "name": "Start", "item": "https://planexus.de/" },
  { "@type": "ListItem", "position": 2, "name": "Branchen", "item": "https://planexus.de/branchen" },
  { "@type": "ListItem", "position": 3, "name": "Bildung", "item": "https://planexus.de/branchen/bildung" }
]};
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    { "@type": "Question", "name": "Was ist die RiSU und warum ist sie für Schul-Container Pflicht?", "acceptedAnswer": { "@type": "Answer", "text": "Die RiSU – Richtlinie zur Sicherheit im Unterricht – ist eine Empfehlung der Kultusministerkonferenz (KMK) in der Fassung 2019, die in praktisch allen Bundesländern als Schulrechts-Maßstab gilt. Sie regelt unter anderem: Gefahrstoffe in Schulen (Stoffliste mit Verbots-, Beschränkungs- und Erlaubnislisten), Sicherheitseinrichtungen (Notdusche, Augenspüler, Erste-Hilfe), Lüftung (Mindest-Luftwechsel), Abzüge nach DIN EN 14175, Brand- und Explosionsschutz, persönliche Schutzausrüstung. Schul-Container müssen RiSU-konform sein, sonst lehnt das Schulamt die Inbetriebnahme ab. Wir liefern Schul-Container standardmäßig RiSU-konform mit Doku-Paket – inkl. Stoffliste-Konformität, Lüftungsnachweis nach RiSU §3.6, Notfall-Infrastruktur nach DGUV-Information 213-850 und Brandschutznachweis nach LBO + RiSU §3.13. Die Schweizer Pendant-Norm ist die EKAS-Richtlinie 6512, in Österreich die BGBl. II 368/1998 i.d.g.F." } },
    { "@type": "Question", "name": "Wir sanieren unser Schulgebäude nach GEG – kommt unser Chemie-Unterricht zum Erliegen?", "acceptedAnswer": { "@type": "Answer", "text": "Nein, nicht wenn Sie rechtzeitig planen. Eine GEG-Sanierung (Gebäudeenergiegesetz, Stand 2024) zieht typischerweise 12-24 Monate Bauzeit nach sich – Fassaden-Dämmung, Fenster-Tausch, Heizungs-Modernisierung. Asbest- oder Brandschutz-Sanierungen kommen zusätzlich vor. Der Chemie-, Bio- und Physik-Unterricht darf währenddessen nicht stillstehen, sonst leidet das Curriculum und Abschlussjahrgänge können Praktika nicht ablegen. Lösung: Container-Übergangslabor auf dem Schulhof. Wir liefern 2-4 Klassenraum-Module mit Abzügen, Notdusche, Sicherheitsschrank, Lehrer-Vorbereitung und Schüler-Garderobe in 8-12 Wochen. Mietzeit 12-36 Monate, Rückbau inkl. Bauantrag als „temporäre bauliche Anlage“ nach LBO – das beschleunigt die Behördenfreigabe drastisch." } },
    { "@type": "Question", "name": "Welche Anforderungen gelten für BTA-/CTA-/MTA-Ausbildungslabore?", "acceptedAnswer": { "@type": "Answer", "text": "Berufsfachschulen für Biologisch-, Chemisch- und Medizinisch-technische Assistenten (BTA/CTA/MTA) brauchen Übungslabore, die den späteren Berufsalltag realistisch abbilden – also Sicherheitswerkbank Klasse II nach DIN EN 12469 für mikrobiologische Übungen, chemische Abzüge nach DIN EN 14175 für Synthese, Analytik-Geräte (Photometer, Titrator, Mikroskop, Zentrifuge) für quantitative Übungen, GMP-konforme Probennahme-Stationen für klinische Routine. Die Ausbildungs- und Prüfungsverordnungen (BTA-PrüfO, CTA-PrüfO der jeweiligen Bundesländer, MTA-Reform-Gesetz vom 24.02.2021 für DE) verlangen Übungsstunden in geeigneter Umgebung – die DAkkS- oder Aufsichtsbehörde der Schule (Schulamt, Bezirksregierung) prüft die Eignung. Wir bauen BTA-/CTA-/MTA-Container, die diese Prüfung sicher bestehen." } },
    { "@type": "Question", "name": "Wie sieht die Versicherung für Schul-Container aus?", "acceptedAnswer": { "@type": "Answer", "text": "Schul-Container sind versicherungstechnisch wie Schul-Gebäude zu behandeln. Die Schul-Inhaltsversicherung des Schulträgers deckt typischerweise auch Container ab, sofern sie in der Sachversicherung als Mietsache angemeldet werden – das ist beim Versicherer mit einer einzeiligen Anzeige erledigt. Die Container-Hülle (also der Container selbst) ist über unseren Mietkontrakt versichert: Allgefahren-Deckung Container und fest installierte Technik, Haftpflicht für Sach- und Personenschäden aus dem Container-Betrieb. Der Schulträger bringt die Schüler- und Lehrer-Inhaltsversicherung mit. Für Sportgeräte, Mikroskope, Wertgegenstände in der Container-Schule gilt die normale Schul-Inhalts-Police. Klärungsbedarf gibt es höchstens bei Zwischennutzung der Container-Fläche durch Vereine außerhalb der Schulzeit – das regelt der Mietvertrag explizit." } },
    { "@type": "Question", "name": "Welche Mindestgröße sollte ein Schul-Lehrlabor im Container haben?", "acceptedAnswer": { "@type": "Answer", "text": "Empfehlung der RiSU §3.5 und der DGUV-Information 202-058 (Sichere Schule – Naturwissenschaftlicher Unterricht): pro Schüler-Arbeitsplatz mindestens 2,5 m² Nettofläche, plus Lehrer-Demonstrationstisch, plus Verkehrsflächen, plus Vorbereitungsraum. Eine Klasse à 24 Schüler braucht damit netto 60 m² Lehrlabor + 15-20 m² Vorbereitungsraum + 5-10 m² Sammlungsraum für Chemikalien und Geräte. Das passt in 3-4 zusammengeschaltete Container-Module à 25-30 m². Wir liefern modulare Schul-Container in genau dieser Größenordnung. Für reine Demo-Labore (kein Schüler-Praktikum) reichen kleinere Module. Für Berufsschulen mit Maschinen-Übungen (BTA/CTA-Reaktor-Pilotierung) wird größer geplant." } },
    { "@type": "Question", "name": "Können wir die Schul-Container nach Ende der Sanierung weiternutzen?", "acceptedAnswer": { "@type": "Answer", "text": "Ja, das ist ein häufiger Anwendungsfall. Schulträger entscheiden sich nach erfolgreichem Container-Betrieb oft für eine dauerhafte Übernahme – als Erweiterungs-Labor neben dem sanierten Bestand, oder als „Außenstelle“ für MINT-Wahlfächer und Differenzierungs-Kurse. Wir bieten dafür drei Modelle: (1) Mietverlängerung um 24/36/60 Monate, (2) Mietkauf mit Verrechnung der bisherigen Mietzahlungen, (3) Ankauf zum Restwert nach Buchgutachten. Variante 2 wird steuerlich bei kommunalen Schulträgern oft als operatives Leasing behandelt und entlastet damit den Investitionshaushalt. Die Bauantrag-Verlängerung von „temporär“ auf „dauerhaft“ läuft über die LBO §65/66, in der Regel mit verkürztem Verfahren weil der Container ja schon steht und ohne Beanstandung läuft." } },
    { "@type": "Question", "name": "Wie sind Schul-Container gegen Vandalismus und Einbruch geschützt?", "acceptedAnswer": { "@type": "Answer", "text": "Standard-Schulcontainer haben einbruchhemmende Türen RC2 nach DIN EN 1627, vergitterte Fenster RC2 oder mit einbruchhemmender Verbund-Verglasung P4A, Bewegungsmelder und Aufschaltung an die Schul-Alarmanlage oder Wachfirma. Die kommunale Sachversicherung verlangt typischerweise mindestens RC2 für Schul-Räume mit Wertgegenständen (Mikroskope, Notebooks). Für Standorte mit erhöhtem Vandalismus-Risiko (Brennpunkt-Schulen, freie Flächen mit Nachtaufenthalt) liefern wir RC3-Türen, beschichtete Verbund-Glaser P5A, Außenleuchten mit Bewegungsmelder und Video-Überwachung mit DSGVO-konformer Aufzeichnung. Pro Container etwa 2.000-4.000 Euro Mehraufpreis – wirtschaftlich, weil ein einziger Einbruch die Mehrkosten um Faktor 5-10 übersteigt." } }
  ]
};
const articleSchema = {"@context": "https://schema.org", "@type": "Article", "headline": "Laborcontainer Bildung & Schulen – RiSU, GUV-SR 2003", "description": "Schul- und Bildungs-Laborcontainer für Chemie, Biologie, Physik. RiSU-konform, DGUV 202-058, BTA/CTA-Praktikum, MINT-Module für 12-36 Monate.", "image": "https://planexus.de/opengraph.jpg", "datePublished": "2026-05-02", "dateModified": "2026-05-02", "author": {"@type": "Person", "name": "Sven Biewald", "jobTitle": "Geschäftsführer Planexus GmbH", "url": "https://planexus.de/team"}, "publisher": {"@type": "Organization", "name": "Planexus GmbH", "logo": {"@type": "ImageObject", "url": "https://planexus.de/android-chrome-512x512.png"}}, "mainEntityOfPage": {"@type": "WebPage", "@id": "https://planexus.de/branchen/bildung"}, "about": "Schul- und Bildungs-Laborcontainer", "inLanguage": "de-DE"};
---
<Layout title={title} description={description} canonical={canonical} ogImage={ogImage} schema={serviceSchema}>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
  <div class="bg-white">
    <section class="relative bg-slate-900 text-white overflow-hidden pt-20">
      <div class="absolute inset-0 z-0">
        <Picture src="/attached_assets/generated_images/high-tech_lab_interior.png" alt="Schullabor-Container Bildung – RiSU-konform für Berufsschule und Gymnasium" class="w-full h-full object-cover opacity-25" loading="eager" fetchpriority="high" />
        <div class="absolute inset-0 bg-gradient-to-r from-slate-900 via-slate-900/95 to-slate-900/70"></div>
      </div>
      <div class="relative z-10 container mx-auto px-4 py-16 md:py-24">
        <div class="max-w-4xl">
          <div class="text-primary font-medium text-sm uppercase tracking-wider mb-4">Branche · Schule · Berufsschule · Fachhochschule · MINT-Bildung · BTA/CTA/MTA</div>
          <h1 class="text-4xl md:text-5xl lg:text-6xl font-heading font-bold mb-6 leading-tight">Schullabor- & Bildungs-Container – RiSU-konform, GEG-Sanierungs-Übergangsfläche, BTA/CTA/MTA-tauglich</h1>
          <p class="text-xl text-gray-300 leading-relaxed mb-4"><strong class="text-white">Lehrlabore nach RiSU-KMK 2019, Schüler-Arbeitsplätze nach DGUV-Information 202-058, Sicherheitsschrank DIN EN 14470, chemischer Abzug DIN EN 14175, Notdusche und Augenspüler nach DIN EN 15154.</strong> Während GEG-, Brandschutz- oder Asbest-Sanierung bleibt der Chemie-, Bio- und Physik-Unterricht im Plan.</p>
          <p class="text-base text-gray-400 mb-8">Sanierung 12-24 Monate. Container-Übergangslabor in 8-12 Wochen.</p>
          <div class="flex flex-col sm:flex-row gap-4 mb-8">
            <a href="#anfrage" class="bg-primary text-slate-900 font-bold px-8 py-4 rounded-lg hover:bg-primary/90 transition-colors inline-flex items-center justify-center gap-2 shadow-[0_0_20px_rgba(132,189,0,0.3)]">Schul-Container-Konzept anfragen</a>
            <a href="tel:+4974357519700" class="border border-white/20 text-white font-medium px-8 py-4 rounded-lg hover:bg-white/10 transition-colors inline-flex items-center justify-center gap-2">+49 7435 7519 700</a>
          </div>
          <div class="flex flex-wrap items-center gap-x-6 gap-y-2 text-sm text-gray-400">
            <div>✓ RiSU-KMK 2019 vollumfänglich</div>
            <div>✓ DGUV 202-058 für Schüler-Arbeitsplätze</div>
            <div>✓ Mietzeit 12-60 Monate</div>
            <div>✓ Übernahme-Option nach Sanierung</div>
          </div>
        </div>
      </div>
    </section>

    <Breadcrumbs bar items={[{ name: 'Start', href: '/' }, { name: 'Branchen', href: '/branchen' }, { name: 'Bildung' }]} />

    <AuthorBio />

    <section class="py-16 md:py-20 bg-gradient-to-br from-primary/5 via-white to-primary/10 border-y border-primary/20">
      <div class="container mx-auto px-4">
        <div class="max-w-5xl mx-auto">
          <div class="text-center mb-10">
            <div class="text-primary font-bold text-sm uppercase tracking-wider mb-3">Sanierungsstau Schule – Lösung Container</div>
            <h2 class="text-3xl md:text-4xl font-heading font-bold mb-4 text-slate-900">Warum Schulträger und Berufsschulen modulare Container statt provisorische Klassenzimmer wählen</h2>
            <p class="text-lg text-gray-700 leading-relaxed max-w-3xl mx-auto">Der KfW-Schulsanierungs-Stau in DACH liegt im dreistelligen Milliarden-Bereich. Während saniert wird, fehlen Lehrlabore. Improvisierte Naturwissenschafts-Räume in Bürocontainern bestehen die RiSU-Prüfung nicht. Echte Schullabor-Container schon.</p>
          </div>
          <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-4">
            <div class="bg-slate-900 text-white rounded-2xl p-6 text-center"><div class="text-4xl font-bold text-primary mb-1">8 W.</div><div class="text-xs text-gray-400 uppercase tracking-wider">Übergangslabor steht</div><div class="text-xs text-gray-500 mt-1">vs. 12-24 Monate Sanierung</div></div>
            <div class="bg-slate-900 text-white rounded-2xl p-6 text-center"><div class="text-4xl font-bold text-primary mb-1">2,5 m²</div><div class="text-xs text-gray-400 uppercase tracking-wider">pro Schüler-Arbeitsplatz</div><div class="text-xs text-gray-500 mt-1">DGUV 202-058 Standard</div></div>
            <div class="bg-slate-900 text-white rounded-2xl p-6 text-center"><div class="text-4xl font-bold text-primary mb-1">RiSU</div><div class="text-xs text-gray-400 uppercase tracking-wider">KMK 2019-konform</div><div class="text-xs text-gray-500 mt-1">Stoffliste, Lüftung, Schutz</div></div>
            <div class="bg-slate-900 text-white rounded-2xl p-6 text-center"><div class="text-4xl font-bold text-primary mb-1">RC2</div><div class="text-xs text-gray-400 uppercase tracking-wider">Einbruchschutz Standard</div><div class="text-xs text-gray-500 mt-1">DIN EN 1627, optional RC3</div></div>
          </div>
        </div>
      </div>
    </section>

    <section class="py-16 md:py-20 bg-slate-50">
      <div class="container mx-auto px-4">
        <div class="max-w-5xl mx-auto">
          <h2 class="text-3xl md:text-4xl font-heading font-bold mb-8 text-slate-900">Normen und Schul-Regelwerke für Bildungs-Container</h2>
          <div class="overflow-x-auto">
            <table class="w-full text-sm border-collapse bg-white rounded-xl overflow-hidden shadow-sm">
              <thead class="bg-slate-900 text-white"><tr><th class="text-left p-4 font-bold">Norm</th><th class="text-left p-4 font-bold">Anwendung</th><th class="text-left p-4 font-bold">Lieferung</th></tr></thead>
              <tbody class="divide-y divide-gray-100">
                <tr><td class="p-4 font-semibold text-slate-900">RiSU-KMK 2019</td><td class="p-4 text-gray-700">Sicherheit im naturwiss. Unterricht</td><td class="p-4 text-gray-700">Stoffliste, Lüftung, Notfall-Doku</td></tr>
                <tr><td class="p-4 font-semibold text-slate-900">DGUV-Info 202-058</td><td class="p-4 text-gray-700">Naturwiss. Unterricht – Schüler-Arbeitsplatz</td><td class="p-4 text-gray-700">Mind. 2,5 m²/Schüler, Demo-Tisch, Verkehr</td></tr>
                <tr><td class="p-4 font-semibold text-slate-900">DGUV-Info 213-850</td><td class="p-4 text-gray-700">Sicheres Arbeiten in Laboratorien</td><td class="p-4 text-gray-700">Notdusche DIN EN 15154, Augenspüler, Erste Hilfe</td></tr>
                <tr><td class="p-4 font-semibold text-slate-900">GefStoffV / TRGS 526</td><td class="p-4 text-gray-700">Schul-Chemikalien-Lagerung</td><td class="p-4 text-gray-700">Sicherheitsschrank DIN EN 14470 F90</td></tr>
                <tr><td class="p-4 font-semibold text-slate-900">DIN EN 14175</td><td class="p-4 text-gray-700">Schul-Abzüge</td><td class="p-4 text-gray-700">Eintritt 0,5 m/s validiert, VAV-fähig</td></tr>
                <tr><td class="p-4 font-semibold text-slate-900">DIN 1946-7</td><td class="p-4 text-gray-700">Lüftung für Lehr-Laboratorien</td><td class="p-4 text-gray-700">Min. 8-fach Luftwechsel mit F7+F9-Filter</td></tr>
                <tr><td class="p-4 font-semibold text-slate-900">DIN EN 1627 RC2</td><td class="p-4 text-gray-700">Einbruchhemmung Schultür/Fenster</td><td class="p-4 text-gray-700">Standard, optional RC3 für Brennpunkt-Standorte</td></tr>
                <tr><td class="p-4 font-semibold text-slate-900">MTA-Reform-G 2021 / BTA-PrüfO / CTA-PrüfO</td><td class="p-4 text-gray-700">Berufsausbildung BTA/CTA/MTA</td><td class="p-4 text-gray-700">Geräte-Ausstattung curriculum-konform</td></tr>
                <tr><td class="p-4 font-semibold text-slate-900">EKAS-RL 6512 (CH) / BGBl. II 368/1998 (AT)</td><td class="p-4 text-gray-700">Schweiz/Österreich-Pendants RiSU</td><td class="p-4 text-gray-700">Container-Doku-Paket landesspezifisch</td></tr>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </section>

    <section class="py-16 md:py-20">
      <div class="container mx-auto px-4">
        <div class="max-w-6xl mx-auto">
          <h2 class="text-3xl md:text-4xl font-heading font-bold mb-10 text-slate-900 text-center">Acht typische Schul- und Bildungs-Container</h2>
          <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-5">
            {[
              { title: 'Chemie-Lehrlabor Sek I/II', desc: '24 Schüler, Doppel-Demo, 4 Abzüge, Notdusche, Sicherheitsschrank, Vorbereitungsraum.' },
              { title: 'Bio-Lehrlabor', desc: 'Mikroskopie-Plätze, Sicherheitswerkbank Klasse II für Mikrobiologie, BSL-1, Pflanzen-Klimaschrank.' },
              { title: 'Physik-Lehrlabor', desc: 'Optik-Bank, Elektrik-Stationen, Mechanik-Set, abgedunkelte Mess-Nische, Hochspannung mit Sicherheitsschaltung.' },
              { title: 'BTA-Übungslabor', desc: 'Mikrobiologie + Klinische Chemie + Hämatologie nach BTA-PrüfO, GMP-Probennahme.' },
              { title: 'CTA-Übungslabor', desc: 'Synthese, Analytik HPLC/GC, Polymerchemie, Pilotierung – nach CTA-PrüfO.' },
              { title: 'MTA-Lehr-Modul', desc: 'Klinische Routine, Hämatologie, Immunhämatologie, Histologie nach MTA-Reform-G 2021.' },
              { title: 'MINT-Differenzierung', desc: 'Wahlpflicht- und Forscher-AGs, Coding-/Robotik-Bereich, Maker-Space mit 3D-Druck.' },
              { title: 'Übergangslabor Sanierung', desc: 'Kompletter Naturwiss.-Bereich für 12-36 Monate während GEG-/Brandschutz-Sanierung.' }
            ].map(item => (
              <div class="bg-slate-50 rounded-xl p-5 border-l-2 border-primary">
                <div class="font-bold text-slate-900 mb-2">{item.title}</div>
                <p class="text-sm text-gray-700 leading-relaxed">{item.desc}</p>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section class="py-16 md:py-20 bg-slate-900 text-white">
      <div class="container mx-auto px-4">
        <div class="max-w-5xl mx-auto">
          <h2 class="text-3xl md:text-4xl font-heading font-bold mb-10">Sechs Engineering-Details für Schul-Container</h2>
          <div class="grid md:grid-cols-2 gap-6">
            <div class="bg-slate-800 rounded-xl p-6"><div class="text-primary font-bold text-sm uppercase tracking-wider mb-2">1. Schüler-Sicherheit</div><h3 class="text-xl font-bold mb-3">Notdusche, Augenspüler, Brandmeldung</h3><p class="text-gray-300 text-sm">Notdusche mit beheizter Leitung (Frostschutz <0 °C), Augenspüler in jeder Raumecke, Brandmeldung Kategorie 1 mit Aufschaltung Hausmeister/Feuerwehr, Erste-Hilfe-Schrank nach DIN 13169.</p></div>
            <div class="bg-slate-800 rounded-xl p-6"><div class="text-primary font-bold text-sm uppercase tracking-wider mb-2">2. Lüftungs-Abzug</div><h3 class="text-xl font-bold mb-3">DIN EN 14175 Schul-Variante</h3><p class="text-gray-300 text-sm">Eintrittsgeschwindigkeit 0,5 m/s validiert, mechanische Frontschieber-Sperre bei zu hohem Spalt, Schulabzug mit Demo-Sichtfenster, energiesparende VAV-Steuerung.</p></div>
            <div class="bg-slate-800 rounded-xl p-6"><div class="text-primary font-bold text-sm uppercase tracking-wider mb-2">3. Chemikalien-Schrank</div><h3 class="text-xl font-bold mb-3">DIN EN 14470 F90 Pflicht</h3><p class="text-gray-300 text-sm">Sicherheitsschrank für Lösungsmittel und Säuren, Auffangwanne, Belüftung Abluft ins Freie, Klassen-Schlüsselsystem mit Lehrer-Kontrolle, Kataster-Eintrag.</p></div>
            <div class="bg-slate-800 rounded-xl p-6"><div class="text-primary font-bold text-sm uppercase tracking-wider mb-2">4. Möbel & Ergonomie</div><h3 class="text-xl font-bold mb-3">Schüler-Möbel nach DIN EN 14434</h3><p class="text-gray-300 text-sm">Sitzhöhe 38-46 cm verstellbar (für Klassenstufe 5-13), Tischhöhe 64-76 cm, Demo-Tisch des Lehrers mit Wasser/Strom/Gas-Anschluss, abriebbeständige Oberflächen.</p></div>
            <div class="bg-slate-800 rounded-xl p-6"><div class="text-primary font-bold text-sm uppercase tracking-wider mb-2">5. Einbruchschutz</div><h3 class="text-xl font-bold mb-3">RC2 nach DIN EN 1627 Standard</h3><p class="text-gray-300 text-sm">Einbruchhemmende Tür mit Mehrfach-Verriegelung, vergitterte Fenster oder Verbund-Glas P4A, Bewegungsmelder mit Aufschaltung Schul-Alarm, optional RC3.</p></div>
            <div class="bg-slate-800 rounded-xl p-6"><div class="text-primary font-bold text-sm uppercase tracking-wider mb-2">6. Barrierefreiheit</div><h3 class="text-xl font-bold mb-3">DIN 18040-1 für Schulen</h3><p class="text-gray-300 text-sm">Rollstuhl-Zugang über Rampe oder Lift, barrierefreier Demo-Tisch (höhenverstellbar), Tür-Mindestbreite 90 cm, kontrastreiche Beschilderung, taktile Hinweise.</p></div>
