---
import Layout from '../../layouts/Layout.astro';
import ContactForm from '../../components/ContactForm.tsx';
import Picture from '../../components/Picture.astro';
import AuthorBio from '../../components/AuthorBio.astro';
import BranchenCrossLinks from '../../components/BranchenCrossLinks.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';

const title = "Laborcontainer Pharma & Biotech – GMP, Reinraum, ISO";
const description = "Laborcontainer Pharma & Biotech: GMP Annex 1, ISO 14644 Klasse 7/8, BSL-2/3, IQ/OQ/PQ-Validierung. BfArM/Swissmedic-konform ab Werk. Jetzt Angebot anfordern.";
const canonical = "/branchen/pharma-biotech";
const ogImage = "/attached_assets/generated_images/high-tech_lab_interior.png";

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "serviceType": "Laborcontainer und Modulbau für Pharma und Biotech",
  "provider": {
    "@type": "Organization",
    "name": "Planexus GmbH",
    "image": "https://planexus.de/android-chrome-512x512.png",
    "url": "https://planexus.de",
    "telephone": "+49 7435 7519 700",
    "email": "info@planexus.de",
    "address": { "@type": "PostalAddress", "streetAddress": "Am Steinbach 8", "addressLocality": "Albstadt-Laufen", "addressRegion": "Baden-Württemberg", "postalCode": "72459", "addressCountry": "DE" },
    "parentOrganization": { "@type": "Organization", "name": "Wesemann Holding GmbH" }
  },
  "areaServed": [
    { "@type": "Country", "name": "Germany" },
    { "@type": "Country", "name": "Switzerland" },
    { "@type": "Country", "name": "Austria" }
  ],
  "audience": {
    "@type": "BusinessAudience",
    "audienceType": "Pharmazeutische Industrie, Biotech-Unternehmen, CDMO, GMP-Hersteller, klinische Forschung"
  },
