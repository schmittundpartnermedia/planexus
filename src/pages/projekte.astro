---
import Layout from '../layouts/Layout.astro';
import ProjekteGallery from '../components/ProjekteGallery';
---

<Layout
  title="Projekte | Laborcontainer Referenzen"
  description="Entdecken Sie unsere erfolgreich realisierten Laborcontainer-Projekte. Von mobilen Forschungslaboren bis zu kompletten BSL-Anlagen."
  canonical="/projekte"
  ogImage="/attached_assets/Kopf_green-scaled_1768306688943.jpg"
>
  <div class="pt-20 min-h-screen bg-background">
    <section class="relative py-24 bg-slate-900 text-white overflow-hidden">
      <div class="absolute inset-0 bg-[radial-gradient(circle_at_30%_50%,rgba(187,215,0,0.15),transparent_50%)]"></div>
      <div class="absolute inset-0 bg-gradient-to-b from-slate-900 via-slate-900/95 to-slate-900"></div>
      <div class="container mx-auto px-4 relative z-10">
        <div class="max-w-4xl mx-auto text-center">
          <h1 class="text-4xl md:text-6xl font-heading font-bold mb-6">
            Unsere Projekte
          </h1>
          <p class="text-xl text-gray-300 leading-relaxed mb-4">
            Von mobilen Forschungslaboren bis zu kompletten BSL-Anlagen – entdecken Sie unsere erfolgreich realisierten Laborcontainer-Projekte für namhafte Kunden.
          </p>
          <p class="text-sm text-gray-400">
            Eine Auswahl unserer Referenzen
          </p>
        </div>
      </div>
    </section>

    <ProjekteGallery client:load />

    <section class="py-16 bg-slate-50">
      <div class="container mx-auto px-4">
        <div class="max-w-3xl mx-auto text-center">
          <h2 class="text-2xl font-heading font-bold text-slate-900 mb-4">Ihr Laborcontainer-Projekt starten</h2>
          <p class="text-gray-600 mb-6 leading-relaxed">
            Jedes Projekt beginnt mit einer <a href="/leistungen/beratung" class="font-semibold text-slate-900 hover:text-primary transition-colors">persönlichen Beratung</a>. Unser <a href="/team" class="font-semibold text-slate-900 hover:text-primary transition-colors">Experten-Team</a> begleitet Sie durch alle Phasen – von der <a href="/leistungen/planung" class="font-semibold text-slate-900 hover:text-primary transition-colors">Fachplanung</a> über den <a href="/leistungen/modulbau" class="font-semibold text-slate-900 hover:text-primary transition-colors">Modulbau</a> bis zur <a href="/leistungen/logistik" class="font-semibold text-slate-900 hover:text-primary transition-colors">Logistik und Montage</a>. In unserem <a href="/magazin" class="font-semibold text-slate-900 hover:text-primary transition-colors">Magazin</a> erfahren Sie mehr über den <a href="/magazin/laborcontainer-projektablauf-von-idee-bis-uebergabe" class="font-semibold text-slate-900 hover:text-primary transition-colors">typischen Projektablauf</a>.
          </p>
          <a href="/kontakt" class="inline-flex items-center gap-2 bg-primary text-slate-900 font-bold px-8 py-4 rounded-lg hover:bg-primary/90 transition-colors shadow-md shadow-primary/20">
            Projekt anfragen
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
          </a>
        </div>
      </div>
    </section>
  </div>
</Layout>
