---
import Layout from '../layouts/Layout.astro';
import ContactForm from '../components/ContactForm.tsx';

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": "Laborcontainer Basel",
  "description": "Schlüsselfertige Laborcontainer für Basel und die Nordwestschweiz. BSL-2/BSL-3, Reinraum, Analytik – Planung, Bau und Lieferung aus einer Hand. In 12 Wochen betriebsbereit.",
  "provider": {
    "@type": "Organization",
    "name": "Planexus GmbH",
    "url": "https://www.planexus.de",
    "parentOrganization": {
      "@type": "Organization",
      "name": "Wesemann Holding GmbH"
    }
  },
  "serviceType": ["Laborcontainer", "Mobile Labore", "BSL-2 Labor", "BSL-3 Labor", "Reinraumlabor", "Containerlabor"],
  "areaServed": [
    { "@type": "City", "name": "Basel" },
    { "@type": "AdministrativeArea", "name": "Kanton Basel-Stadt" },
    { "@type": "AdministrativeArea", "name": "Kanton Basel-Landschaft" }
  ],
  "url": "https://www.planexus.de/laborcontainer-basel"
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Start", "item": "https://www.planexus.de/" },
    { "@type": "ListItem", "position": 2, "name": "Standorte", "item": "https://www.planexus.de/#standorte" },
    { "@type": "ListItem", "position": 3, "name": "Laborcontainer Basel", "item": "https://www.planexus.de/laborcontainer-basel" }
  ]
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Was kostet ein Laborcontainer in Basel?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Die Kosten richten sich nach Grösse, Ausstattung und Sicherheitsstufe. Transport von Deutschland in die Schweiz und Zollabwicklung sind inklusive kalkuliert. Nach einem ersten Gespräch nennen wir Ihnen eine realistische Einschätzung."
      }
    },
    {
      "@type": "Question",
      "name": "Wie schnell kann ein Laborcontainer nach Basel geliefert werden?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "8–12 Wochen von der Planung bis zur schlüsselfertigen Übergabe. Der Transport von Albstadt über die A5 und den Grenzübergang Basel/Weil am Rhein dauert nur 2,5 Stunden – Basel ist unser nächstgelegener Schweizer Standort. Zollabwicklung inklusive."
      }
    },
    {
      "@type": "Question",
      "name": "Brauche ich im Kanton Basel-Stadt eine Baubewilligung für einen Laborcontainer?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "In der Regel ja. Bauten über 10 m² Grundfläche sind bewilligungspflichtig (BPV §26). Je nach Aussenwirkung kommt das vereinfachte oder ordentliche Verfahren infrage. Das Online-Baubegehren (OBG) beschleunigt den Prozess. Wir übernehmen die Abstimmung mit dem Bau- und Gastgewerbeinspektorat."
      }
    },
    {
      "@type": "Question",
      "name": "Kann ich einen Laborcontainer in Basel auch mieten?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Ja. Miete, Kauf oder Mietkauf – wir bieten flexible Modelle. Besonders sinnvoll als Interimslabor während Campus-Erweiterungen bei Roche, Novartis oder Lonza – oder für befristete Forschungsprojekte und Startup-Labore."
      }
    },
    {
      "@type": "Question",
      "name": "Erfüllen Ihre Container die Anforderungen der Basler Pharma-Campusse?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Ja. Wir kennen die strengen Zugangs-, Sicherheits- und GMP-Anforderungen grosser Pharma-Areale. Unsere Container werden inklusive aller erforderlichen Dokumentation (IQ/OQ/PQ, Qualifizierung) geliefert. Auch Reinräume nach GMP-Klassen A bis D sind realisierbar."
      }
    }
  ]
};

const localBusinessSchema = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "name": "Planexus GmbH – Laborcontainer Basel",
  "description": "Schlüsselfertige Laborcontainer für Basel und die Nordwestschweiz",
  "url": "https://www.planexus.de",
  "telephone": "+49 7435 7519 700",
  "email": "info@planexus.de",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "Am Steinbach 8",
    "addressLocality": "Albstadt",
    "postalCode": "72459",
    "addressCountry": "DE"
  },
  "areaServed": [
    { "@type": "City", "name": "Basel" },
    { "@type": "AdministrativeArea", "name": "Kanton Basel-Stadt" }
  ]
};
---

<Layout
  title="Laborcontainer Basel – schlüsselfertig in 12 Wochen | Planexus"
  description="Laborcontainer für Basel: BSL-2/BSL-3, Reinraum und Analytik für Pharma und Life Sciences. Schlüsselfertig geliefert in 8–12 Wochen. Jetzt anfragen."
  canonical="/laborcontainer-basel"
  schema={serviceSchema}
  ogImage="/attached_assets/Laborcontainer_003_1769688326919.jpg"
>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} slot="head" />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} slot="head" />
  <script type="application/ld+json" set:html={JSON.stringify(localBusinessSchema)} slot="head" />

  <div class="pt-20 min-h-screen bg-white">

    <section class="relative py-24 md:py-32 bg-slate-900 text-white overflow-hidden">
      <div class="absolute inset-0">
        <img src="/attached_assets/Laborcontainer_003_1769688326919.jpg" alt="Laborcontainer von Planexus – schlüsselfertig für Basel" class="w-full h-full object-cover opacity-20" loading="eager" />
      </div>
      <div class="absolute inset-0 bg-gradient-to-r from-slate-900 via-slate-900/95 to-slate-900/70"></div>

      <div class="container mx-auto px-4 relative z-10">
        <div class="max-w-3xl">
          <nav class="flex items-center gap-2 text-sm text-gray-400 mb-8">
            <a href="/" class="hover:text-primary transition-colors">Start</a>
            <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m9 18 6-6-6-6"/></svg>
            <span>Standorte</span>
            <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m9 18 6-6-6-6"/></svg>
            <span class="text-primary">Basel</span>
          </nav>

          <h1 class="text-4xl md:text-5xl lg:text-6xl font-heading font-bold mb-6 leading-tight">
            Laborcontainer für Basel – <span class="text-primary">175 km ab Werk, schneller als jeder Neubau</span>
          </h1>
          <p class="text-xl text-gray-300 leading-relaxed mb-8">
            Europas dichtester Life-Sciences-Cluster – über 800 Unternehmen, 33.000 Fachkräfte und Weltkonzerne wie Roche, Novartis und Lonza. Wir planen, bauen und liefern schlüsselfertige Containerlabore für die Basel Area.
          </p>

          <div class="flex flex-col sm:flex-row gap-4 mb-8">
            <a href="#anfrage" class="bg-primary text-slate-900 font-bold px-8 py-4 rounded-lg hover:bg-primary/90 transition-colors inline-flex items-center justify-center gap-2 shadow-[0_0_20px_rgba(132,189,0,0.3)]">
              Kostenlos anfragen
              <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
            </a>
            <a href="tel:+4974357519700" class="border border-white/20 text-white font-medium px-8 py-4 rounded-lg hover:bg-white/10 transition-colors inline-flex items-center justify-center gap-2">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
              +49 7435 7519 700
            </a>
          </div>

          <div class="flex flex-wrap items-center gap-6 text-sm text-gray-400">
            <div class="flex items-center gap-2">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10"/><path d="m9 12 2 2 4-4"/></svg>
              Teil der Wesemann Holding
            </div>
            <div class="flex items-center gap-2">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10"/><path d="m9 12 2 2 4-4"/></svg>
              Zollabwicklung inklusive
            </div>
            <div class="flex items-center gap-2">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10"/><path d="m9 12 2 2 4-4"/></svg>
              GMP-konform nach Swissmedic
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="py-16 md:py-20">
      <div class="container mx-auto px-4">
        <div class="max-w-4xl mx-auto">
          <h2 class="text-3xl md:text-4xl font-heading font-bold mb-8 text-slate-900">
            Laborraum in Basel? Knapper als irgendwo sonst.
          </h2>
          <div class="grid md:grid-cols-3 gap-6 mb-10">
            <div class="bg-red-50 border border-red-100 rounded-xl p-6">
              <div class="text-red-600 font-bold text-lg mb-2">Campusse sind voll</div>
              <p class="text-gray-600 text-sm">Roche baut seit Jahren am Campus Süd, Novartis transformiert das gesamte Areal. Laborraum ist Mangelware – trotz Milliarden-Investitionen.</p>
            </div>
            <div class="bg-red-50 border border-red-100 rounded-xl p-6">
              <div class="text-red-600 font-bold text-lg mb-2">Startups brauchen sofort</div>
              <p class="text-gray-600 text-sm">BaseLaunch, DayOne und der Switzerland Innovation Park bringen Dutzende Startups hervor. Jedes braucht Labor – aber keines hat 3 Jahre Zeit für einen Neubau.</p>
            </div>
            <div class="bg-red-50 border border-red-100 rounded-xl p-6">
              <div class="text-red-600 font-bold text-lg mb-2">Klinische Studien laufen</div>
              <p class="text-gray-600 text-sm">Neue Medikamente, neue Anforderungen – temporäre Labore für Analytik, QC und Batchfreigabe sind permanent gefragt.</p>
            </div>
          </div>

          <div class="bg-slate-900 text-white rounded-2xl p-8 md:p-10">
            <div class="flex items-start gap-4">
              <div class="w-12 h-12 bg-primary rounded-lg flex items-center justify-center shrink-0">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-slate-900" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10"/><path d="m9 12 2 2 4-4"/></svg>
              </div>
              <div>
                <div class="text-xl font-bold mb-2">Die Lösung: Schlüsselfertige Containerlabore</div>
                <p class="text-gray-300">Planexus plant, baut und liefert normkonforme Laborcontainer – massgeschneidert für Ihren Standort in Basel. Von der ersten Skizze bis zur Übergabe in 8 bis 12 Wochen. Nur 175 km ab Werk, Zollabwicklung inklusive.</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="py-16 md:py-20 bg-slate-50 border-y border-gray-100">
      <div class="container mx-auto px-4">
        <div class="text-center max-w-2xl mx-auto mb-12">
          <h2 class="text-3xl md:text-4xl font-heading font-bold mb-4 text-slate-900">Warum Planexus für Basel?</h2>
          <p class="text-gray-600 text-lg">Alles aus einer Hand – vom Engineering bis zur Qualifizierung nach Swissmedic-Standards.</p>
        </div>

        <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6 max-w-6xl mx-auto">
          <div class="bg-white rounded-xl p-6 border border-gray-100 hover:shadow-lg transition-shadow text-center">
            <div class="w-14 h-14 bg-primary/10 rounded-full flex items-center justify-center mx-auto mb-4">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-7 h-7 text-[#7a9900]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
            </div>
            <div class="font-bold text-slate-900 text-lg mb-2">8–12 Wochen</div>
            <p class="text-gray-600 text-sm">Von Auftragserteilung bis schlüsselfertige Übergabe – statt 2–3 Jahre Neubau.</p>
          </div>

          <div class="bg-white rounded-xl p-6 border border-gray-100 hover:shadow-lg transition-shadow text-center">
            <div class="w-14 h-14 bg-primary/10 rounded-full flex items-center justify-center mx-auto mb-4">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-7 h-7 text-[#7a9900]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
            </div>
            <div class="font-bold text-slate-900 text-lg mb-2">175 km Entfernung</div>
            <p class="text-gray-600 text-sm">Basel ist unser nächstgelegener Schweizer Standort. 2,5 Stunden ab Werk – über die A5 und den Grenzübergang Weil am Rhein.</p>
          </div>

          <div class="bg-white rounded-xl p-6 border border-gray-100 hover:shadow-lg transition-shadow text-center">
            <div class="w-14 h-14 bg-primary/10 rounded-full flex items-center justify-center mx-auto mb-4">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-7 h-7 text-[#7a9900]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10"/><path d="m9 12 2 2 4-4"/></svg>
            </div>
            <div class="font-bold text-slate-900 text-lg mb-2">GMP-konform</div>
            <p class="text-gray-600 text-sm">Reinräume nach Swissmedic-Standards, IQ/OQ/PQ-Dokumentation – bereit für Pharma-Campusse.</p>
          </div>

          <div class="bg-white rounded-xl p-6 border border-gray-100 hover:shadow-lg transition-shadow text-center">
            <div class="w-14 h-14 bg-primary/10 rounded-full flex items-center justify-center mx-auto mb-4">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-7 h-7 text-[#7a9900]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
            </div>
            <div class="font-bold text-slate-900 text-lg mb-2">Kauf, Miete, Leasing</div>
            <p class="text-gray-600 text-sm">Flexibel finanziert – ob Interimslösung für 6 Monate oder dauerhafte Laborerweiterung.</p>
          </div>
        </div>

        <div class="text-center mt-10">
          <a href="#anfrage" class="inline-flex items-center gap-2 bg-primary text-slate-900 font-bold px-8 py-4 rounded-lg hover:bg-primary/90 transition-colors shadow-[0_0_20px_rgba(132,189,0,0.3)]">
            Jetzt unverbindlich beraten lassen
            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
          </a>
        </div>
      </div>
    </section>

    <section class="py-16 md:py-20">
      <div class="container mx-auto px-4">
        <div class="max-w-5xl mx-auto">
          <h2 class="text-3xl md:text-4xl font-heading font-bold mb-4 text-slate-900">
            Laborcontainer-Typen für Basel
          </h2>
          <p class="text-gray-600 text-lg mb-10">
            Jeder Container wird individuell geplant und in unserem Werk gefertigt – kein Standard von der Stange.
          </p>

          <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
            <a href="/leistungen/ausstattung" class="group bg-white border border-gray-100 rounded-xl p-6 hover:shadow-xl hover:border-primary/30 transition-all">
              <div class="w-12 h-12 bg-primary/10 rounded-lg flex items-center justify-center mb-4 group-hover:bg-primary transition-colors">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-[#7a9900] group-hover:text-slate-900 transition-colors" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 18h8"/><path d="M3 22h18"/><path d="M14 22a7 7 0 1 0 0-14h-1"/><path d="M9 14h2"/><path d="M9 12a2 2 0 0 1-2-2V6h6v4a2 2 0 0 1-2 2Z"/><path d="M12 6V3a1 1 0 0 0-1-1H9a1 1 0 0 0-1 1v3"/></svg>
              </div>
              <h3 class="font-bold text-slate-900 mb-2">Analytiklabor</h3>
              <p class="text-gray-600 text-sm">HPLC, GC, Spektroskopie – mit Abzügen, Medienversorgung und klimatisierten Geräteräumen.</p>
            </a>

            <a href="/magazin/bsl-2-bsl-3-container-labor" class="group bg-white border border-gray-100 rounded-xl p-6 hover:shadow-xl hover:border-primary/30 transition-all">
              <div class="w-12 h-12 bg-primary/10 rounded-lg flex items-center justify-center mb-4 group-hover:bg-primary transition-colors">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-[#7a9900] group-hover:text-slate-900 transition-colors" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10"/><path d="m9 12 2 2 4-4"/></svg>
              </div>
              <h3 class="font-bold text-slate-900 mb-2">BSL-2 / BSL-3 Sicherheitslabor</h3>
              <p class="text-gray-600 text-sm">Unterdrucksysteme, HEPA-Filtration, Schleusen – für Virologie und Infektionsbiologie am Biozentrum und FMI.</p>
            </a>

            <a href="/magazin/gmp-reinraum-container-pharma-produktion" class="group bg-white border border-gray-100 rounded-xl p-6 hover:shadow-xl hover:border-primary/30 transition-all">
              <div class="w-12 h-12 bg-primary/10 rounded-lg flex items-center justify-center mb-4 group-hover:bg-primary transition-colors">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-[#7a9900] group-hover:text-slate-900 transition-colors" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="18" height="18" x="3" y="3" rx="2"/><path d="M3 9h18"/><path d="M9 21V9"/></svg>
              </div>
              <h3 class="font-bold text-slate-900 mb-2">GMP-Reinraumlabor</h3>
              <p class="text-gray-600 text-sm">Reinraumklassen nach ISO 14644, GMP A–D nach Swissmedic. Für Pharma-Produktion und Qualitätskontrolle.</p>
            </a>

            <a href="/leistungen/ausstattung" class="group bg-white border border-gray-100 rounded-xl p-6 hover:shadow-xl hover:border-primary/30 transition-all">
              <div class="w-12 h-12 bg-primary/10 rounded-lg flex items-center justify-center mb-4 group-hover:bg-primary transition-colors">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-[#7a9900] group-hover:text-slate-900 transition-colors" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 11a3 3 0 1 0 6 0a3 3 0 0 0-6 0"/><path d="M12.5 2a9.5 9.5 0 0 0-7.14 15.73L12 22l6.64-4.27A9.5 9.5 0 0 0 12.5 2Z"/></svg>
              </div>
              <h3 class="font-bold text-slate-900 mb-2">QC-Labor</h3>
              <p class="text-gray-600 text-sm">Qualitätskontrolle für Batchfreigabe – Wareneingangs-, Prozess- und Freigabeprüfung bei Roche, Novartis oder Lonza.</p>
            </a>

            <a href="/leistungen/ausstattung" class="group bg-white border border-gray-100 rounded-xl p-6 hover:shadow-xl hover:border-primary/30 transition-all">
              <div class="w-12 h-12 bg-primary/10 rounded-lg flex items-center justify-center mb-4 group-hover:bg-primary transition-colors">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-[#7a9900] group-hover:text-slate-900 transition-colors" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 3v18h18"/><path d="m19 9-5 5-4-4-3 3"/></svg>
              </div>
              <h3 class="font-bold text-slate-900 mb-2">Wägelabor</h3>
              <p class="text-gray-600 text-sm">Vibrationsarme Wägetische, kontrollierte Temperatur und Luftfeuchtigkeit für Präzisionswägungen.</p>
            </a>

            <a href="/leistungen" class="group bg-white border border-gray-100 rounded-xl p-6 hover:shadow-xl hover:border-primary/30 transition-all">
              <div class="w-12 h-12 bg-primary/10 rounded-lg flex items-center justify-center mb-4 group-hover:bg-primary transition-colors">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-[#7a9900] group-hover:text-slate-900 transition-colors" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="7" height="9" x="3" y="3" rx="1"/><rect width="7" height="5" x="14" y="3" rx="1"/><rect width="7" height="9" x="14" y="12" rx="1"/><rect width="7" height="5" x="3" y="16" rx="1"/></svg>
              </div>
              <h3 class="font-bold text-slate-900 mb-2">Containeranlage / Mehrstöckig</h3>
              <p class="text-gray-600 text-sm">Mehrere Container zu einer Laboranlage verbunden – skalierbar nach Bedarf, auch auf beengten Pharma-Campussen.</p>
            </a>
          </div>
        </div>
      </div>
    </section>

    <section class="py-16 md:py-20 bg-slate-50 border-y border-gray-100">
      <div class="container mx-auto px-4">
        <div class="max-w-4xl mx-auto">
          <h2 class="text-3xl md:text-4xl font-heading font-bold mb-8 text-slate-900">
            Lieferung nach Basel – direkt ab Werk
          </h2>

          <div class="grid md:grid-cols-3 gap-6 mb-10">
            <div class="bg-white rounded-xl p-6 border border-gray-100 text-center">
              <div class="text-3xl font-heading font-bold text-[#7a9900] mb-1">~175 km</div>
              <p class="text-gray-600 text-sm">Albstadt → Basel</p>
            </div>
            <div class="bg-white rounded-xl p-6 border border-gray-100 text-center">
              <div class="text-3xl font-heading font-bold text-[#7a9900] mb-1">2,5 Std.</div>
              <p class="text-gray-600 text-sm">Transport über A5, Grenzübergang Weil am Rhein</p>
            </div>
            <div class="bg-white rounded-xl p-6 border border-gray-100 text-center">
              <div class="text-3xl font-heading font-bold text-[#7a9900] mb-1">8–12 Wo.</div>
              <p class="text-gray-600 text-sm">Bis zur schlüsselfertigen Übergabe</p>
            </div>
          </div>

          <div class="bg-white rounded-xl p-8 border border-gray-100 space-y-6">
            <div>
              <h3 class="font-bold text-slate-900 mb-2">Wo in Basel aufstellen?</h3>
              <p class="text-gray-600">Unsere Laborcontainer stehen auf Pharma-Campussen, Universitätsgeländen, Innovationsparks und Industriearealen. Aufstellung per Kran – auch auf engen Flächen. Medienanschlüsse (Strom, Wasser, Abwasser, Daten) werden vor Ort hergestellt.</p>
            </div>
            <div>
              <h3 class="font-bold text-slate-900 mb-2">Baubewilligung im Kanton Basel-Stadt</h3>
              <p class="text-gray-600">Bauten über 10 m² Grundfläche sind bewilligungspflichtig (BPV §26). Das Online-Baubegehren (OBG) beschleunigt den Prozess. Wir stimmen die Baubewilligung mit dem Bau- und Gastgewerbeinspektorat ab – und kennen die Schweizer SIA-Normen.</p>
            </div>
            <div>
              <h3 class="font-bold text-slate-900 mb-2">Life-Sciences-Cluster Basel Area</h3>
              <p class="text-gray-600">Über 800 Life-Sciences-Unternehmen, 33.000 Fachkräfte, Roche (Hauptsitz seit 1896), Novartis, Lonza, Johnson & Johnson, Moderna. Dazu Biozentrum, Friedrich Miescher Institute (FMI) und ETH D-BSSE. Der Bedarf an flexibler Laborinfrastruktur ist hier so hoch wie nirgendwo sonst in Europa.</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="py-16 md:py-20">
      <div class="container mx-auto px-4">
        <div class="max-w-4xl mx-auto">
          <h2 class="text-3xl md:text-4xl font-heading font-bold mb-4 text-slate-900">
            So entsteht Ihr Containerlabor in Basel
          </h2>
          <p class="text-gray-600 text-lg mb-12">Von der Idee bis zum betriebsbereiten Labor – in 5 klaren Schritten.</p>

          <div class="space-y-0">
            <div class="flex gap-6">
              <div class="flex flex-col items-center">
                <div class="w-10 h-10 bg-primary text-slate-900 font-bold rounded-full flex items-center justify-center text-lg shrink-0">1</div>
                <div class="w-0.5 bg-gray-200 flex-grow mt-2"></div>
              </div>
              <div class="pb-10">
                <h3 class="font-bold text-slate-900 text-lg mb-1">Erstberatung & Anforderungsanalyse</h3>
                <p class="text-gray-600">Wir klären gemeinsam: Welcher Labortyp? Welche Ausstattung? Welcher Standort in Basel? Welche Schweizer Normen gelten?</p>
              </div>
            </div>

            <div class="flex gap-6">
              <div class="flex flex-col items-center">
                <div class="w-10 h-10 bg-primary text-slate-900 font-bold rounded-full flex items-center justify-center text-lg shrink-0">2</div>
                <div class="w-0.5 bg-gray-200 flex-grow mt-2"></div>
              </div>
              <div class="pb-10">
                <h3 class="font-bold text-slate-900 text-lg mb-1">Planung & Engineering</h3>
                <p class="text-gray-600">CAD-Entwurf, TGA-Planung, Raumlayout – abgestimmt auf SIA-Normen und Ihre Prozesse. Sie geben das Konzept frei, bevor die Fertigung startet.</p>
              </div>
            </div>

            <div class="flex gap-6">
              <div class="flex flex-col items-center">
                <div class="w-10 h-10 bg-primary text-slate-900 font-bold rounded-full flex items-center justify-center text-lg shrink-0">3</div>
                <div class="w-0.5 bg-gray-200 flex-grow mt-2"></div>
              </div>
              <div class="pb-10">
                <h3 class="font-bold text-slate-900 text-lg mb-1">Fertigung im Werk</h3>
                <p class="text-gray-600">Produktion in unserem Werk in Albstadt – wetterunabhängig, qualitätsgeprüft. Factory Acceptance Test (FAT) inklusive.</p>
              </div>
            </div>

            <div class="flex gap-6">
              <div class="flex flex-col items-center">
                <div class="w-10 h-10 bg-primary text-slate-900 font-bold rounded-full flex items-center justify-center text-lg shrink-0">4</div>
                <div class="w-0.5 bg-gray-200 flex-grow mt-2"></div>
              </div>
              <div class="pb-10">
                <h3 class="font-bold text-slate-900 text-lg mb-1">Transport & Aufstellung</h3>
                <p class="text-gray-600">Per Tieflader über die A5 und den Grenzübergang Basel/Weil am Rhein. Zollabwicklung inklusive. Aufstellung per Kran, Anschluss an Medienversorgung.</p>
              </div>
            </div>

            <div class="flex gap-6">
              <div class="flex flex-col items-center">
                <div class="w-10 h-10 bg-primary text-slate-900 font-bold rounded-full flex items-center justify-center text-lg shrink-0">5</div>
              </div>
              <div class="pb-2">
                <h3 class="font-bold text-slate-900 text-lg mb-1">Qualifizierung & Übergabe</h3>
                <p class="text-gray-600">IQ/OQ/PQ-Dokumentation nach Swissmedic-Standards, Einweisung Ihres Teams, Übergabe eines betriebsbereiten Labors. Fertig.</p>
              </div>
            </div>
          </div>

          <div class="text-center mt-10">
            <a href="#anfrage" class="inline-flex items-center gap-2 bg-primary text-slate-900 font-bold px-8 py-4 rounded-lg hover:bg-primary/90 transition-colors shadow-[0_0_20px_rgba(132,189,0,0.3)]">
              Starten Sie bei Schritt 1 – kostenlose Erstberatung
              <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
            </a>
          </div>
        </div>
      </div>
