---
import Layout from '../layouts/Layout.astro';

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": "Laborcontainer Basel",
  "description": "Mobile Containerlabore für die Pharma-Welthauptstadt Basel. Roche, Novartis, 800+ Life-Science-Unternehmen – GMP-Container und Analytiklabore ab 175 km Entfernung.",
  "provider": {
    "@type": "Organization",
    "name": "Planexus GmbH",
    "url": "https://www.planexus.de"
  },
  "areaServed": [
    { "@type": "City", "name": "Basel" },
    { "@type": "AdministrativeArea", "name": "Kanton Basel-Stadt" }
  ],
  "serviceType": ["Laborcontainer", "GMP-Labor", "Pharma-Container", "Analytiklabor", "BSL-2 Container"],
  "url": "https://www.planexus.de/laborcontainer-basel"
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Start", "item": "https://www.planexus.de/" },
    { "@type": "ListItem", "position": 2, "name": "Laborcontainer Basel", "item": "https://www.planexus.de/laborcontainer-basel" }
  ]
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Warum ist Basel der wichtigste Pharma-Standort für Laborcontainer?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Basel beherbergt die globalen Hauptsitze von Roche (~15.000 Beschäftigte Schweiz) und Novartis (~10.400 Beschäftigte Schweiz) sowie über 800 weitere Life-Science-Unternehmen. Die Dichte an pharmazeutischer Forschung und Produktion erzeugt permanenten Bedarf an zusätzlicher Laborkapazität – Containerlabore liefern diese schnell und ohne Umbauten."
      }
    },
    {
      "@type": "Question",
      "name": "Wie funktioniert die Lieferung ins Dreiländereck?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Unser Werk in Albstadt liegt nur 175 km von Basel entfernt – rund 2 Stunden Fahrzeit. Die Lieferung erfolgt über deutsche Autobahnen bis zur Schweizer Grenze. Wir übernehmen die komplette Zollabwicklung DE→CH inklusive Ausfuhranmeldung, T1-Versandverfahren und Einfuhrverzollung."
      }
    },
    {
      "@type": "Question",
      "name": "Erfüllen die Container GMP-Anforderungen für Big Pharma?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Ja. Unsere GMP-Container erfüllen die Anforderungen nach EU-GMP-Leitfaden und sind kompatibel mit Swissmedic-Standards: kontrollierte Reinraumklassen (ISO 7/ISO 8), HEPA-Filtration, pharmataugliche Oberflächen, lückenlose Dokumentation und vollständige IQ/OQ/PQ-Qualifizierung."
      }
    },
    {
      "@type": "Question",
      "name": "Brauche ich in Basel-Stadt eine Baubewilligung?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Im Kanton Basel-Stadt ist grundsätzlich eine Baubewilligung für Container erforderlich. Für temporäre Anlagen gibt es unter bestimmten Voraussetzungen vereinfachte Verfahren. Wir bereiten die Gesuchsunterlagen vor und koordinieren die Abstimmung mit dem Bauinspektorat."
      }
    },
    {
      "@type": "Question",
      "name": "Können Containerlabore auch in Basel-Landschaft aufgestellt werden?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Ja. Viele Pharma-Standorte – darunter Roche Kaiseraugst – liegen im Kanton Basel-Landschaft. Dort gilt das kantonale Raumplanungs- und Baugesetz (RBG BL). Wir kennen die Unterschiede zwischen beiden Kantonen und klären die Bewilligungslage standortspezifisch."
      }
    },
    {
      "@type": "Question",
      "name": "Was kostet ein Pharma-Container für Basel?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Die Kosten hängen von Reinraumklasse, Ausstattung und Qualifizierungsumfang ab. Durch die kurze Distanz (175 km) sind Transportkosten vergleichbar mit innerdeutschen Lieferungen. Zollabwicklung und Schweizer MWST (8,1%) kalkulieren wir transparent ins Angebot ein."
      }
    }
  ]
};

const localBusinessSchema = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "name": "Planexus GmbH – Laborcontainer Basel",
  "description": "GMP-Container und Pharma-Labore für Basel, das Dreiländereck und die gesamte Basel Area. Roche, Novartis, 800+ Life-Science-Unternehmen.",
  "url": "https://www.planexus.de",
  "telephone": "+49 7435 7519 700",
  "email": "info@planexus.de",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "Am Steinbach 8",
    "addressLocality": "Albstadt",
    "postalCode": "72459",
    "addressCountry": "DE"
  },
  "areaServed": [
    { "@type": "City", "name": "Basel" },
    { "@type": "Country", "name": "Schweiz" }
  ]
};
---

<Layout
  title="Laborcontainer Basel – Roche, Novartis & Pharma-Welthauptstadt | Planexus GmbH"
  description="Containerlabore für Basels Pharma-Cluster: Roche, Novartis, 800+ Life-Science-Firmen. GMP-Reinraum, Analytik, BSL-2 – nur 175 km ab Werk, Zollabwicklung inklusive."
  canonical="/laborcontainer-basel"
  schema={serviceSchema}
  ogImage="/attached_assets/Kopf_green-scaled_1768306688943.jpg"
>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} slot="head" />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} slot="head" />
  <script type="application/ld+json" set:html={JSON.stringify(localBusinessSchema)} slot="head" />

  <div class="pt-20 min-h-screen bg-white">

    <!-- Hero: Pharma-Welthauptstadt -->
    <section class="relative py-32 bg-slate-900 text-white overflow-hidden">
      <div class="absolute inset-0 bg-[radial-gradient(circle_at_70%_30%,rgba(187,215,0,0.08),transparent_55%)]"></div>
      <div class="absolute bottom-0 left-0 w-[500px] h-[400px] bg-primary/4 rounded-full blur-[140px]"></div>

      <div class="container mx-auto px-4 relative z-10">
        <div class="max-w-4xl">
          <div class="flex items-center gap-3 mb-8">
            <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-white/10 text-primary text-sm font-medium backdrop-blur-sm border border-white/10">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
              Basel & Dreiländereck
            </div>
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-red-500/20 text-red-400 text-xs font-bold border border-red-500/20">
              <span class="w-2 h-2 bg-red-400 rounded-full"></span>
              Schweiz
            </div>
          </div>

          <h1 class="text-4xl md:text-5xl lg:text-6xl font-heading font-bold mb-6 leading-tight">
            Zwei Weltkonzerne, 800 Firmen – <span class="text-primary">eine Pharma-Hauptstadt</span>
          </h1>
          <p class="text-xl text-gray-300 mb-4 leading-relaxed font-light max-w-3xl">
            Roche und Novartis haben hier ihren globalen Hauptsitz. Über 800 Life-Science-Unternehmen arbeiten in der Basel Area. Die Dichte an pharmazeutischer Forschung und Produktion ist weltweit einzigartig – und der Bedarf an flexibler Laborinfrastruktur entsprechend hoch.
          </p>
          <p class="text-lg text-gray-400 mb-10 max-w-2xl">
            Unser Werk liegt 175 km entfernt. Näher an der Pharma-Welthauptstadt geht kaum – inklusive Zollabwicklung.
          </p>

          <div class="flex flex-col sm:flex-row gap-4 mb-16">
            <a href="/kontakt" class="bg-primary text-slate-900 font-bold px-8 py-4 rounded-lg hover:bg-primary/90 transition-colors flex items-center justify-center gap-2 group shadow-[0_0_20px_rgba(187,215,0,0.3)]">
              Pharma-Projekt anfragen
              <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 group-hover:translate-x-1 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
            </a>
            <a href="tel:+4974357519700" class="border border-white/20 text-white font-medium px-8 py-4 rounded-lg hover:bg-white/10 transition-colors backdrop-blur-sm flex items-center justify-center gap-2">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
              +49 7435 7519 700
            </a>
          </div>

          <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
            <div class="bg-white/5 border border-white/10 rounded-xl p-4 text-center">
              <div class="text-2xl font-heading font-bold text-primary">800+</div>
              <p class="text-gray-400 text-xs mt-1">Life-Science-Unternehmen</p>
            </div>
            <div class="bg-white/5 border border-white/10 rounded-xl p-4 text-center">
              <div class="text-2xl font-heading font-bold text-primary">~15.000</div>
              <p class="text-gray-400 text-xs mt-1">Roche-Beschäftigte CH</p>
            </div>
            <div class="bg-white/5 border border-white/10 rounded-xl p-4 text-center">
              <div class="text-2xl font-heading font-bold text-primary">~10.400</div>
              <p class="text-gray-400 text-xs mt-1">Novartis-Beschäftigte CH</p>
            </div>
            <div class="bg-white/5 border border-white/10 rounded-xl p-4 text-center">
              <div class="text-2xl font-heading font-bold text-primary">175 km</div>
              <p class="text-gray-400 text-xs mt-1">Albstadt → Basel</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Breadcrumb -->
    <nav class="bg-gray-50 border-b border-gray-100 py-3">
      <div class="container mx-auto px-4">
        <ol class="flex items-center gap-2 text-sm text-gray-500">
          <li><a href="/" class="hover:text-primary transition-colors">Start</a></li>
          <li><svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg></li>
          <li class="text-primary font-medium">Laborcontainer Basel</li>
        </ol>
      </div>
    </nav>

    <!-- Section 1: Roche & Novartis Deep Dive -->
    <section class="py-20 bg-white">
      <div class="container mx-auto px-4">
        <div class="max-w-5xl mx-auto">
          <h2 class="text-3xl md:text-4xl font-heading font-bold mb-6 text-slate-900">
            Roche und Novartis: Zwei Konzerne, die ganze Stadtviertel füllen
          </h2>
          <p class="text-gray-600 text-lg mb-12 leading-relaxed max-w-3xl">
            Basel ist die einzige Stadt der Welt, in der zwei der zehn grössten Pharma-Konzerne ihren globalen Hauptsitz haben. Roche und Novartis investieren Milliarden in ihre Basler Standorte – und der Analytik-Bedarf wächst mit jedem neuen Forschungsprojekt, jeder Produktionserweiterung.
          </p>

          <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
            <div class="bg-white rounded-2xl border-2 border-gray-100 overflow-hidden hover:border-primary/30 transition-colors">
              <div class="bg-gradient-to-r from-slate-900 to-slate-800 p-8">
                <h3 class="text-2xl font-heading font-bold text-white mb-1">Roche</h3>
                <p class="text-primary text-sm">Globaler Hauptsitz Basel & Kaiseraugst</p>
              </div>
              <div class="p-8">
                <div class="space-y-3 text-sm mb-6">
                  <div class="flex justify-between"><span class="text-gray-500">Beschäftigte Schweiz</span><span class="font-bold text-slate-900">~15.000</span></div>
                  <div class="flex justify-between"><span class="text-gray-500">Investitionen Basel/Kaiseraugst</span><span class="font-bold text-slate-900">~4 Mrd. CHF</span></div>
                  <div class="flex justify-between"><span class="text-gray-500">Schwerpunkte</span><span class="font-bold text-slate-900">Pharma & Diagnostics</span></div>
                </div>
                <p class="text-gray-600 text-sm leading-relaxed mb-4">
                  Roche ist weltweit führend in der Onkologie und Diagnostik. Der Basler Campus beherbergt Forschung, Entwicklung und Konzernleitung. Das Standort Kaiseraugst (Basel-Landschaft) ergänzt mit Produktion und Logistik. Die Dimension der Investitionen zeigt: Basel bleibt Roches Gravitationszentrum – und der Analytik-Bedarf ist enorm.
                </p>
                <div class="bg-slate-50 rounded-lg p-3">
                  <p class="text-gray-500 text-xs">Quelle: Roche Holding AG, Geschäftsbericht & Standortinformation</p>
                </div>
              </div>
            </div>

            <div class="bg-white rounded-2xl border-2 border-gray-100 overflow-hidden hover:border-primary/30 transition-colors">
              <div class="bg-gradient-to-r from-slate-900 to-slate-800 p-8">
                <h3 class="text-2xl font-heading font-bold text-white mb-1">Novartis</h3>
                <p class="text-primary text-sm">Novartis Campus, St. Johann</p>
              </div>
              <div class="p-8">
                <div class="space-y-3 text-sm mb-6">
                  <div class="flex justify-between"><span class="text-gray-500">Beschäftigte Schweiz</span><span class="font-bold text-slate-900">~10.400</span></div>
                  <div class="flex justify-between"><span class="text-gray-500">Campus-Areal</span><span class="font-bold text-slate-900">~20 Hektar</span></div>
                  <div class="flex justify-between"><span class="text-gray-500">Entstanden aus</span><span class="font-bold text-slate-900">Sandoz + Ciba-Geigy (1996)</span></div>
                </div>
                <p class="text-gray-600 text-sm leading-relaxed mb-4">
                  Der Novartis Campus im St.-Johann-Quartier ist einer der bekanntesten Pharma-Forschungsstandorte weltweit. Auf rund 20 Hektar arbeiten Tausende Forschende an neuen Wirkstoffen. Der Campus ist ein architektonisches Wahrzeichen – aber Forschungsfläche ist endlich. Containerlabore ergänzen, wo Neubauten Jahre dauern würden.
                </p>
                <div class="bg-slate-50 rounded-lg p-3">
                  <p class="text-gray-500 text-xs">Quelle: Novartis International AG, Standortinformation</p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Section 2: 800+ Life-Science-Unternehmen -->
    <section class="py-20 bg-slate-900 text-white">
      <div class="container mx-auto px-4">
        <div class="max-w-5xl mx-auto">
          <h2 class="text-3xl md:text-4xl font-heading font-bold mb-6">
            Basel Area: 800+ Life-Science-Unternehmen auf engstem Raum
          </h2>
          <p class="text-gray-400 text-lg mb-12 leading-relaxed max-w-3xl">
            Neben Roche und Novartis ist Basel Sitz einer aussergewöhnlich dichten Life-Science-Landschaft. Die Basel Area Business & Innovation vermarktet die Region als globalen Pharma-Hub – mit Recht.
          </p>

          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
            <div class="bg-white/5 border border-white/10 rounded-xl p-6 text-center">
              <div class="text-3xl font-heading font-bold text-primary mb-2">800+</div>
              <p class="text-gray-300 text-sm">Life-Science-Unternehmen</p>
              <p class="text-gray-500 text-xs mt-1">in der Basel Area</p>
            </div>
            <div class="bg-white/5 border border-white/10 rounded-xl p-6 text-center">
              <div class="text-3xl font-heading font-bold text-primary mb-2">400+</div>
              <p class="text-gray-300 text-sm">Biotech-Unternehmen</p>
              <p class="text-gray-500 text-xs mt-1">davon reine Biotechnologie</p>
            </div>
            <div class="bg-white/5 border border-white/10 rounded-xl p-6 text-center">
              <div class="text-3xl font-heading font-bold text-primary mb-2">100+</div>
              <p class="text-gray-300 text-sm">Spin-offs</p>
              <p class="text-gray-500 text-xs mt-1">aus Forschung und Industrie</p>
            </div>
            <div class="bg-white/5 border border-white/10 rounded-xl p-6 text-center">
              <div class="text-3xl font-heading font-bold text-primary mb-2">3</div>
              <p class="text-gray-300 text-sm">Länder</p>
              <p class="text-gray-500 text-xs mt-1">im Dreiländereck CH/FR/DE</p>
            </div>
          </div>

          <div class="mt-12 grid grid-cols-1 md:grid-cols-3 gap-6">
            <div class="bg-white/5 border border-white/10 rounded-xl p-6">
              <h3 class="text-primary font-bold mb-3">Pharma & Wirkstoffe</h3>
              <p class="text-gray-300 text-sm leading-relaxed">
                Von der Wirkstoffforschung bis zur Chargenfreigabe: Basels Pharma-Unternehmen benötigen QC-Labore für jede Phase. Containerlabore ergänzen bei Produktionshochläufen, Validierungsprojekten und Übergangsphasen.
              </p>
            </div>
            <div class="bg-white/5 border border-white/10 rounded-xl p-6">
              <h3 class="text-primary font-bold mb-3">Diagnostik & Medtech</h3>
              <p class="text-gray-300 text-sm leading-relaxed">
                Basel ist Heimat von Roche Diagnostics – dem Weltmarktführer. Prüflabore für Diagnostik-Instrumente, Reagenzien und In-vitro-Diagnostika erfordern kontrollierte Umgebungen auf kleinstem Raum.
              </p>
            </div>
            <div class="bg-white/5 border border-white/10 rounded-xl p-6">
              <h3 class="text-primary font-bold mb-3">Contract Research (CRO)</h3>
              <p class="text-gray-300 text-sm leading-relaxed">
                Zahlreiche Auftragsforschungs-Unternehmen in Basel führen klinische und präklinische Studien durch. Die Schwankung der Auftragsvolumina macht flexible Laborkapazität zur Überlebensfrage.
              </p>
            </div>
          </div>

          <p class="text-gray-500 text-xs mt-8">Quelle: Basel Area Business & Innovation</p>
        </div>
      </div>
    </section>

    <!-- Section 3: Dreiländereck-Logistik -->
    <section class="py-20 bg-white">
      <div class="container mx-auto px-4">
        <div class="max-w-5xl mx-auto">
          <span class="text-primary text-sm font-bold uppercase tracking-wider">Grenzüberschreitend</span>
          <h2 class="text-3xl font-heading font-bold mt-3 mb-6 text-slate-900">
            Dreiländereck: Logistik-Vorteil im Herzen Europas
          </h2>
          <p class="text-gray-600 text-lg mb-12 leading-relaxed max-w-3xl">
            Basel liegt am Dreiländereck Schweiz–Frankreich–Deutschland. Der EuroAirport ist binational (CH/FR), der Rheinhafen verbindet Basel mit Rotterdam, und die Autobahn nach Albstadt führt über deutsches Terrain. Diese Lage macht Basel logistisch einzigartig.
          </p>

          <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
            <div class="bg-slate-50 rounded-2xl p-8 border border-gray-100 relative overflow-hidden">
              <div class="absolute top-0 right-0 w-16 h-16 bg-red-500/10 rounded-bl-2xl flex items-center justify-center">
                <span class="text-lg font-bold text-red-500">CH</span>
              </div>
              <h3 class="text-xl font-heading font-bold text-slate-900 mb-4">Schweiz – Basel-Stadt & BL</h3>
              <p class="text-gray-600 text-sm leading-relaxed">
                Roche Hauptsitz, Novartis Campus, Universität Basel. Im Kanton Basel-Landschaft: Roche Kaiseraugst (Produktion & Logistik), zahlreiche Zulieferer und Biotech-Firmen. Containerlabore bedienen beide Kantone.
              </p>
            </div>

            <div class="bg-slate-50 rounded-2xl p-8 border border-gray-100 relative overflow-hidden">
              <div class="absolute top-0 right-0 w-16 h-16 bg-blue-500/10 rounded-bl-2xl flex items-center justify-center">
                <span class="text-lg font-bold text-blue-500">FR</span>
              </div>
              <h3 class="text-xl font-heading font-bold text-slate-900 mb-4">Frankreich – Elsass</h3>
              <p class="text-gray-600 text-sm leading-relaxed">
                Saint-Louis, Huningue und das Elsass beherbergen Pharma-Produktionsstandorte und den EuroAirport. Novartis und andere Konzerne haben Standorte auf der französischen Seite. Lieferungen aus Deutschland passieren teilweise französisches Gebiet.
              </p>
            </div>

            <div class="bg-slate-50 rounded-2xl p-8 border border-gray-100 relative overflow-hidden">
              <div class="absolute top-0 right-0 w-16 h-16 bg-yellow-500/10 rounded-bl-2xl flex items-center justify-center">
                <span class="text-lg font-bold text-yellow-600">DE</span>
              </div>
              <h3 class="text-xl font-heading font-bold text-slate-900 mb-4">Deutschland – Südbaden</h3>
              <p class="text-gray-600 text-sm leading-relaxed">
                Lörrach, Weil am Rhein und Grenzach-Wyhlen (Roche Diagnostik). Die Route Albstadt → Basel führt über deutsche Autobahnen – bis wenige Kilometer vor dem Ziel. Keine Transit-Zollproblematik.
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Section 4: GMP für Big Pharma -->
    <section class="py-20 bg-slate-50 border-t border-gray-100">
      <div class="container mx-auto px-4">
        <div class="max-w-5xl mx-auto">
          <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-start">
            <div>
              <span class="text-primary text-sm font-bold uppercase tracking-wider">Pharma-Standard</span>
              <h2 class="text-3xl font-heading font-bold mt-3 mb-6 text-slate-900">
                GMP-Container für Big-Pharma-Anforderungen
              </h2>
              <p class="text-gray-600 text-lg leading-relaxed mb-6">
                Die Qualitätsanforderungen von Roche, Novartis und anderen Basler Pharma-Unternehmen sind unter den höchsten weltweit. Ein Containerlabor muss hier nicht nur regulatorische Mindeststandards erfüllen – es muss konzerninternen Audit-Anforderungen standhalten.
              </p>
              <p class="text-gray-600 leading-relaxed mb-6">
                Wir kennen diese Anforderungen. Unsere GMP-Container sind so konzipiert, dass sie sowohl Swissmedic als auch EU-GMP erfüllen. Die Qualifizierung (IQ/OQ/PQ) begleiten wir aktiv – inklusive Dokumentation nach Schweizer Standards.
              </p>

              <div class="space-y-3">
                <div class="flex items-start gap-3">
                  <div class="w-6 h-6 bg-primary/10 rounded-full flex items-center justify-center shrink-0 mt-0.5">
