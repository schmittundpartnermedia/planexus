---
import Layout from '../layouts/Layout.astro';
import ContactForm from '../components/ContactForm.tsx';
import AuthorBio from '../components/AuthorBio.astro';
import CityCrossLinks from '../components/CityCrossLinks.astro';

const title = "Laborcontainer Basel | BSL-3, GMP, Pharma-Cluster | Planexus";
const description = "Laborcontainer Basel: LABtoGO, 2,75 m Innenhöhe, BSL-3, SIA 261 Erdbebenzone Z2, GMP. Werk Albstadt via A81 + Grenze Weil in 8–14 Wochen.";
const canonical = "/laborcontainer-basel";

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "serviceType": "Laborcontainer und modularer Laborbau Basel",
  "provider": {
    "@type": "Organization",
    "name": "Planexus GmbH",
    "image": "https://planexus.de/android-chrome-512x512.png",
    "url": "https://planexus.de",
    "telephone": "+49 7435 7519 700",
    "email": "info@planexus.de",
    "address": { "@type": "PostalAddress", "streetAddress": "Emil-Mayer-Straße 1", "addressLocality": "Albstadt", "postalCode": "72461", "addressCountry": "DE" },
    "parentOrganization": { "@type": "Organization", "name": "Wesemann Holding GmbH" }
  },
  "areaServed": [
    { "@type": "City", "name": "Basel" },
    { "@type": "AdministrativeArea", "name": "Kanton Basel-Stadt" },
    { "@type": "AdministrativeArea", "name": "Kanton Basel-Landschaft" },
    { "@type": "Country", "name": "Schweiz" }
  ],
  "description": "Containerlabore, mobile Labore und modulare Laborgebäude für Standorte und Einrichtungen wie Roche, Novartis, Lonza, Universität Basel, Universitätsspital USB, Friedrich-Miescher-Institut FMI und das ETH-Department D-BSSE – ab Werk Albstadt verzollt nach Basel über Weil am Rhein.",
  "offers": { "@type": "AggregateOffer", "priceCurrency": "CHF", "availability": "https://schema.org/InStock" }
};

const localBusinessSchema = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "name": "Planexus GmbH – Laborcontainer Basel",
      "image": "https://planexus.de/images/labtogo-industrie.webp",
  "url": "https://planexus.de/laborcontainer-basel",
  "telephone": "+49 7435 7519 700",
  "email": "info@planexus.de",
  "address": { "@type": "PostalAddress", "streetAddress": "Emil-Mayer-Straße 1", "addressLocality": "Albstadt", "postalCode": "72461", "addressCountry": "DE" },
  "areaServed": { "@type": "City", "name": "Basel", "containedInPlace": { "@type": "Country", "name": "Schweiz" } },
  "priceRange": "CHF",
  "openingHoursSpecification": [{ "@type": "OpeningHoursSpecification", "dayOfWeek": ["Monday","Tuesday","Wednesday","Thursday","Friday"], "opens": "08:00", "closes": "17:00" }]
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Start", "item": "https://planexus.de/" },
    { "@type": "ListItem", "position": 2, "name": "Standorte", "item": "https://planexus.de/laborcontainer" },
    { "@type": "ListItem", "position": 3, "name": "Laborcontainer Basel", "item": "https://planexus.de/laborcontainer-basel" }
  ]
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Wie lange dauert die Lieferung eines Laborcontainers nach Basel vom Werk Albstadt?",
      "acceptedAnswer": { "@type": "Answer", "text": "Die Schwerlastroute Werk Albstadt → Basel führt über die A81 südwärts via Singen/Stockach, dann A98 westwärts entlang der DE-CH-Grenze, und über den Grenzübergang Weil am Rhein/Basel-Hiltalingerstrasse direkt in den Raum Basel. Reine Fahrzeit beträgt rund 2 Stunden bei circa 130 Kilometern Distanz – die kürzeste Schwerlast-Route von einem deutschen Werk zu jedem CH-Standort. Die Verzollung erfolgt am Zollamt Weil am Rhein über T1-Versandverfahren mit ATA-Carnet bei temporärer Einfuhr. Standardanlieferpunkte: Basel-Nord für Hafenstandort, Klybeck-Areal und Novartis Campus St. Johann, Basel-Süd für Roche Wettstein und Universitätsspital, Basel-Ost (A2/A3-Verzweigung) für Lonza Münchensteinerstrasse und FMI/D-BSSE in Rosental. Vom Auftrag bis zur betriebsbereiten Übergabe in Basel vergehen 8 bis 14 Wochen." }
    },
    {
      "@type": "Question",
      "name": "Welche Bewilligungen brauche ich für einen Laborcontainer im Kanton Basel-Stadt oder Basel-Landschaft?",
      "acceptedAnswer": { "@type": "Answer", "text": "In Basel-Stadt gilt das Bau- und Planungsgesetz (BPG) Basel-Stadt sowie die Bau- und Planungsverordnung (BPV). Zuständig ist das Bauinspektorat Basel-Stadt an der Rittergasse 4, 4051 Basel. In Basel-Landschaft greift das Raumplanungs- und Baugesetz (RBG) BL mit dem Bauinspektorat Liestal. Container gelten als Bauten und Anlagen, eine Baubewilligung ist in den meisten Fällen nötig. Bei temporärer Aufstellung unter 3 Monaten ist je nach Standort eine vereinfachte Anzeige möglich. Für GMP-, BSL-2- und BSL-3-Container greifen zusätzlich die Einschliessungsverordnung (ESV) bei BAFU/BAG und das Heilmittelgesetz mit Swissmedic-Zuständigkeit – wichtig vor allem für Roche-, Novartis- und Lonza-Umfeld. Wir prüfen die Eingruppierung Ihres Standorts vorab und legen verfahrenstaugliche Bauunterlagen für beide Halbkantone vor." }
    },
    {
      "@type": "Question",
      "name": "Welche Erdbeben-Anforderungen gelten für Laborcontainer in Basel nach SIA 261?",
      "acceptedAnswer": { "@type": "Answer", "text": "Basel liegt nach SIA 261 in Erdbebenzone Z2 mit einer horizontalen Bemessungs-Bodenbeschleunigung von agd = 1,0 m/s² – das ist rund 67 Prozent höher als Zürich (Z1a, agd 0,6 m/s²). Hintergrund ist das Basler Erdbeben von 1356, das stärkste historisch dokumentierte Erdbeben nördlich der Alpen mit geschätzter Magnitude 6,6. Für Z2 wird die Verankerung von Containerlaboren statisch deutlich aufwendiger – Bauwerksklasse II (BWK II) ist für Roche-, Novartis-, Lonza- und USB-Standorte quasi Standard, weil hier sicherheitsrelevante Funktionen abgebildet werden. Planexus liefert für Basel statisch nach SIA 261 mit Z2-Faktor und SIA 263-Verankerungskonzept ab Werk Albstadt – nicht nur DIN, sondern verfahrenstauglich für das Bauinspektorat Basel-Stadt." }
    },
    {
      "@type": "Question",
      "name": "Wie funktioniert die Verzollung Weil am Rhein für Container nach Basel?",
      "acceptedAnswer": { "@type": "Answer", "text": "Der Grenzübergang Weil am Rhein/Basel ist der direkteste CH-Übergang vom Werk Albstadt – ohne Umweg. Wir verzollen über T1-Versandverfahren mit Abfertigung am Zollamt Weil am Rhein (DE) und Basel/Hiltalingerstrasse (CH). Bei dauerhafter Einfuhr fällt die Schweizer Mehrwertsteuer von 8,1 Prozent an (Stand 2026). Bei temporärer Einfuhr (z. B. Mietcontainer für klinische Studien am USB oder Pilotcontainer für Roche/Novartis) ist eine Verzollung im Verfahren der vorübergehenden Verwendung mit ATA-Carnet möglich – ohne MwSt, mit Sicherheitsleistung. Trinationaler Sonderfall Basel: Für Standorte im französischen Saint-Louis (Lifesciences-Korridor zur EuroAirport-Region) gilt EU-Binnenmarkt – wir verzollen dann nicht. Wir koordinieren komplett." }
    },
    {
      "@type": "Question",
      "name": "Können Sie Container mit dem Schiff zum Hafen Basel liefern?",
      "acceptedAnswer": { "@type": "Answer", "text": "Ja. Basel ist der einzige CH-Stadt-Standort mit eigenem Binnenhafen (Schweizerische Rheinhäfen, Hafen Kleinhüningen und Auhafen Birsfelden). Für Übergrosse oder mehrere parallele Module ist eine Anlieferung per Containerschiff aus Rotterdam/Antwerpen möglich – aus dem Werk Albstadt würden wir die Module per LKW zum Rhein-Hafen Mannheim oder Karlsruhe bringen, dann Binnenschiff bis Basel. Das ist meistens nur bei sehr grossen Aufträgen (≥ 10 Module) wirtschaftlich, bei einzelnen Containern ist die direkte Schwerlast-Route via Weil am Rhein günstiger und schneller. Wir kalkulieren beide Varianten transparent." }
    },
    {
      "@type": "Question",
      "name": "Was muss ich beim Klybeck-Areal als Brownfield beachten?",
      "acceptedAnswer": { "@type": "Answer", "text": "Das Klybeck-Areal in Basel-Nord (ehemals Novartis und BASF) ist ein klassisches pharmazeutisches Brownfield mit Altlasten aus über 100 Jahren chemischer Produktion. Aufstellungen dort verlangen vor dem Bau eine Voruntersuchung nach Altlasten-Verordnung (AltlV) und Technische Verordnung über Abfälle (TVA), koordiniert mit dem Amt für Umwelt und Energie Basel-Stadt. Wir liefern bauvorbereitende Empfehlungen (Bodenplatte mit Sperrschicht, Drainage-Konzept, ggf. Hebevorrichtung über bestehende Altlast) und arbeiten eng mit Schweizer Bodengutachtern zusammen. Klybeck wird zur neuen Life-Science-Adresse Basels (Klybeck-Areal-Entwicklung 2030+) – für die Übergangs-Nutzungen sind Pilot- und GMP-Container eine geeignete Lösung." }
    },
    {
      "@type": "Question",
      "name": "Welche Anwendungen sind in Basel besonders nachgefragt?",
      "acceptedAnswer": { "@type": "Answer", "text": "Basel ist die Pharma-Hauptstadt der Schweiz und einer der weltweit wichtigsten Life-Science-Standorte. Typische Einsatzfelder für Laborcontainer ergeben sich rund um Standorte wie Roche (Hauptsitz Grenzacherstrasse 124, 4070 Basel, rund 10.000 Mitarbeitende, Roche Tower) – GMP-Pilotcontainer und BSL-3-Forschungsmodule; Novartis (Campus St. Johann, Lichtstrasse 35, 4056 Basel, rund 8.000 Mitarbeitende) – Reinraum- und Containment-Container; Lonza (Münchensteinerstrasse 38, 4002 Basel) – CDMO-Pilotanlagen; die Universität Basel (Hauptgebäude Petersplatz 1, 4001 Basel, ~13.000 Studierende, 7 Fakultäten, vor allem Life Sciences am Biozentrum Spitalstrasse 41) – BSL-2-Drittmittelcontainer; das Universitätsspital Basel USB (Spitalstrasse 21, 4031 Basel, ~7.000 Mitarbeitende) – Studien-Container während Klinik-Sanierungen; sowie das Friedrich Miescher Institute FMI (Maulbeerstrasse 66, 4058 Basel, Roche-affiliiert) und das ETH-Department of Biosystems Science and Engineering D-BSSE (Mattenstrasse 26, 4058 Basel) – High-End-Forschungscontainer." }
    }
  ]
};
---

<Layout title={title} description={description} canonical={canonical}>
  <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(localBusinessSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <div class="bg-white">

    <!-- HERO -->
    <section class="relative bg-slate-900 text-white overflow-hidden">
      <div class="relative z-10 container mx-auto px-4 py-20 md:py-28">
        <div class="max-w-4xl">
          <nav class="flex items-center gap-2 text-sm text-gray-400 mb-8" aria-label="Breadcrumb">
            <a href="/" class="hover:text-primary transition-colors">Start</a>
            <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m9 18 6-6-6-6"/></svg>
            <span>Standorte</span>
            <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m9 18 6-6-6-6"/></svg>
            <span class="text-primary">Basel</span>
          </nav>

          <div class="text-primary font-medium text-sm uppercase tracking-wider mb-4">Ihr Spezialist für Laborcontainer · Pharma-Hauptstadt der Schweiz</div>

          <h1 class="text-4xl md:text-5xl lg:text-6xl font-heading font-bold mb-6 leading-tight">
            Laborcontainer Basel – erdbebensichere Pharma-Labore für Roche, Novartis und Lonza
          </h1>

          <p class="text-xl text-gray-300 leading-relaxed mb-4">
            <strong class="text-white">Ihr Fachplaner für Containerlabore mit mehr als 10 Jahren Erfahrung.</strong> Modular, SIA-261-Z2-konform, T1-verzollt. Wir realisieren flexible Forschungs- und GMP-Umgebungen für Standorte und Einrichtungen wie Roche (Grenzacherstrasse), Novartis (Campus St. Johann), Lonza (Münchensteinerstrasse), Universität Basel, USB, FMI und das ETH-Department D-BSSE – aus dem Werk Albstadt direkt nach Basel, über A81 und Grenze Weil am Rhein in nur 130 km.
          </p>
          <p class="text-base text-gray-400 mb-8">Während andere noch planen, forschen Sie bereits.</p>

          <div class="flex flex-col sm:flex-row gap-4 mb-8">
            <a href="#anfrage" data-testid="button-cta-hero" class="bg-primary text-slate-900 font-bold px-8 py-4 rounded-lg hover:bg-primary/90 transition-colors inline-flex items-center justify-center gap-2 shadow-[0_0_20px_rgba(132,189,0,0.3)]">Kostenfreies Standort-Audit Basel<svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg></a>
            <a href="tel:+4974357519700" class="border border-white/20 text-white font-medium px-8 py-4 rounded-lg hover:bg-white/10 transition-colors inline-flex items-center justify-center gap-2"><svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>+49 7435 7519 700</a>
          </div>

          <div class="flex flex-wrap items-center gap-x-6 gap-y-2 text-sm text-gray-400">
            <div class="flex items-center gap-2"><svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6 9 17l-5-5"/></svg>Pioniere im Modulbau seit 2016</div>
            <div class="flex items-center gap-2"><svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6 9 17l-5-5"/></svg>Award 2026 EU Business News</div>
            <div class="flex items-center gap-2"><svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6 9 17l-5-5"/></svg>Verzollung Weil am Rhein inkl.</div>
            <div class="flex items-center gap-2"><svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6 9 17l-5-5"/></svg>Wesemann-Gruppe · 60+ Jahre Laborbau</div>
          </div>
        </div>
      </div>
    </section>

    <AuthorBio city="Basel" />

    <!-- LABtoGO -->
    <section class="py-16 md:py-20 bg-gradient-to-br from-primary/5 via-white to-primary/10 border-y border-primary/20">
      <div class="container mx-auto px-4">
        <div class="max-w-5xl mx-auto">
          <div class="grid md:grid-cols-2 gap-10 items-center mb-10">
            <div>
              <div class="text-primary font-bold text-sm uppercase tracking-wider mb-3">Pattern-Interrupt · Weltpremiere analytica 2026</div>
              <h2 class="text-3xl md:text-4xl font-heading font-bold mb-4 text-slate-900">Planexus zeigt Basel, was ein Laborcontainer 2026 wirklich kann</h2>
              <p class="text-lg text-gray-700 leading-relaxed mb-4">Ein gewöhnlicher Laborcontainer hat 2.400 mm Innenhöhe. Aufrecht arbeiten unter einem Abzug ist mühsam.</p>
              <p class="text-lg text-slate-900 font-bold leading-relaxed mb-4">Der LABtoGO von Planexus hat 2.750 mm Innenhöhe. 9,5 m Außenlänge. 3 m Außenbreite. Vollverglaste Front, die echtes Tageslicht in jedes Basler Roche-, Novartis-, Lonza-, USB- oder FMI-Forschungslabor bringt.</p>
              <p class="text-lg text-gray-700 leading-relaxed"><strong>Ein gewöhnlicher Laborcontainer passt komplett in einen LABtoGO hinein.</strong> Wir konfigurieren ihn für Basel nach SIA 261 Erdbebenzone Z2 (deutlich höher als Zürich Z1a), SIA 380/1 Energie, Verzollung T1 ab Werk Albstadt über Weil am Rhein und T13/T15-Schweizer-Stromanschluss.</p>
            </div>
            <div class="grid grid-cols-2 gap-4">
              <div class="bg-slate-900 text-white rounded-2xl p-6 text-center"><div class="text-4xl font-bold text-primary mb-1">2.750</div><div class="text-xs text-gray-400 uppercase tracking-wider">mm Innenhöhe</div><div class="text-xs text-gray-500 mt-1">Standard: 2.400 mm</div></div>
              <div class="bg-slate-900 text-white rounded-2xl p-6 text-center"><div class="text-4xl font-bold text-primary mb-1">9.500</div><div class="text-xs text-gray-400 uppercase tracking-wider">mm Außenlänge</div><div class="text-xs text-gray-500 mt-1">3.000 mm Breite</div></div>
              <div class="bg-slate-900 text-white rounded-2xl p-6 text-center"><div class="text-4xl font-bold text-primary mb-1">SIA Z2</div><div class="text-xs text-gray-400 uppercase tracking-wider">Erdbeben agd 1,0 m/s²</div><div class="text-xs text-gray-500 mt-1">~67 % über Zürich</div></div>
              <div class="bg-slate-900 text-white rounded-2xl p-6 text-center"><div class="text-4xl font-bold text-primary mb-1">130 km</div><div class="text-xs text-gray-400 uppercase tracking-wider">Werk → Basel</div><div class="text-xs text-gray-500 mt-1">2 h via Weil</div></div>
            </div>
          </div>
          <div class="text-center"><a href="/laborcontainer/labtogo" class="inline-flex items-center gap-2 text-primary font-bold hover:underline">LABtoGO Plattform und alle Konfigurationen ansehen<svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg></a></div>
        </div>
      </div>
    </section>

    <!-- PROBLEM-AGITATION -->
    <section class="py-16 md:py-20">
      <div class="container mx-auto px-4">
        <div class="max-w-5xl mx-auto">
          <h2 class="text-3xl md:text-4xl font-heading font-bold mb-10 text-slate-900">Planexus löst die drei Basler Engpässe, an denen Pharma- und Forschungs-Container regelmässig scheitern</h2>
          <div class="grid md:grid-cols-3 gap-6">
            <div class="bg-slate-50 border-l-4 border-primary rounded-xl p-6">
              <div class="text-slate-900 font-bold text-lg mb-2">SIA 261 Z2 statt Z1a – Erdbebenstatik kritisch</div>
              <p class="text-gray-700 text-sm leading-relaxed">Basel liegt in SIA-261-Erdbebenzone Z2 (agd 1,0 m/s²) – rund 67 Prozent höher als Zürich (Z1a, agd 0,6 m/s²). Hintergrund ist das historische Basler Erdbeben von 1356, das stärkste nördlich der Alpen. Container, die nur für Z1a oder rein nach DIN dimensioniert sind, fallen im Bauinspektorat Basel-Stadt durch. BWK-II-Einstufung ist für Roche-, Novartis-, Lonza- und USB-Standorte quasi Standard.</p>
              <p class="text-sm text-slate-900 font-semibold mt-3 pt-3 border-t border-gray-200">Planexus-Antwort: Statik nach SIA 261 Z2 mit BWK II ab Werk dokumentiert.</p>
            </div>
            <div class="bg-slate-50 border-l-4 border-primary rounded-xl p-6">
              <div class="text-slate-900 font-bold text-lg mb-2">Pharma-Triade Roche/Novartis/Lonza – GMP-Audit-tauglich ab Tag 1</div>
              <p class="text-gray-700 text-sm leading-relaxed">Die drei Basler Pharma-Riesen lassen sich keine Pilotcontainer ohne Swissmedic-taugliche IQ/OQ/PQ-Dokumentation, ISO 14644-Reinraum und Annex-1-Compliance abnehmen. Wer einen Standardcontainer „mit GMP-Option" anbietet, scheitert in der ersten Audit-Runde. Auch ESV-Antrag bei BAFU/BAG für gentechnische Anlagen ist Pflicht und wird oft vergessen.</p>
              <p class="text-sm text-slate-900 font-semibold mt-3 pt-3 border-t border-gray-200">Planexus-Antwort: GMP-Reinraumcontainer ab Werk Audit-ready, ESV-Antrag inklusive.</p>
            </div>
            <div class="bg-slate-50 border-l-4 border-primary rounded-xl p-6">
              <div class="text-slate-900 font-bold text-lg mb-2">Trinationale Verzollung CH/DE/FR – komplexer als jeder andere CH-Standort</div>
              <p class="text-gray-700 text-sm leading-relaxed">Basel-Standorte können in BS, BL oder im französischen Saint-Louis liegen. Saint-Louis = EU-Binnenmarkt (keine Verzollung), BS/BL = Schweizer T1-Verzollung mit 8,1 % MwSt oder ATA-Carnet bei Miete. Standardspediteure rechnen das in einer Pauschale ab und liegen damit oft falsch – mehrere Tausend CHF Differenz möglich.</p>
              <p class="text-sm text-slate-900 font-semibold mt-3 pt-3 border-t border-gray-200">Planexus-Antwort: Standortabhängige Verzollung Weil am Rhein oder EU-Binnenmarkt-Anlieferung.</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- STRATEGISCHE FUSION -->
    <section class="py-16 md:py-20 bg-slate-50">
      <div class="container mx-auto px-4">
        <div class="max-w-4xl mx-auto">
          <h2 class="text-3xl md:text-4xl font-heading font-bold mb-8 text-slate-900">Laborcontainer für Basel: Was die Pharma-Triade, SIA Z2 und die Verzollung Weil am Rhein vom Engineering verlangen</h2>
          <div class="prose prose-lg max-w-none text-gray-700 space-y-6">
            <p><strong>Basel ist die Pharma-Hauptstadt der Schweiz und einer der weltweit wichtigsten Life-Science-Standorte.</strong> Auf 37 Quadratkilometern Stadtfläche konkurrieren Roche (Hauptsitz Grenzacherstrasse 124, 4070 Basel, rund 10.000 Mitarbeitende, der 178 m hohe Roche Tower von Herzog & de Meuron), Novartis (Campus St. Johann, Lichtstrasse 35, 4056 Basel, rund 8.000 Mitarbeitende, internationale Architektur-Ikone), Lonza (Münchensteinerstrasse 38, 4002 Basel, weltweit grösster CDMO mit Pharma-Auftragsfertigung), die Universität Basel (Hauptgebäude Petersplatz 1, 4001 Basel, ~13.000 Studierende in 7 Fakultäten), das Universitätsspital Basel USB (Spitalstrasse 21, 4031 Basel, ~7.000 Mitarbeitende), das Friedrich Miescher Institute FMI (Maulbeerstrasse 66, 4058 Basel, Roche-affiliiertes Grundlagenforschungs-Institut) und das ETH-Department of Biosystems Science and Engineering D-BSSE (Mattenstrasse 26, 4058 Basel) um Flächen, Bewilligungen und Engineering-Kapazität.</p>
            <p><strong>Planexus baut für diesen Markt seit 2016.</strong> Wir wissen, dass das Bauinspektorat Basel-Stadt an der Rittergasse 4, 4051 Basel, nach BPG und BPV entscheidet, dass das Bauinspektorat Liestal für Basel-Landschaft (RBG BL) zuständig ist. Wir wissen, dass SIA 261 für Basel Erdbebenzone Z2 mit agd = 1,0 m/s² definiert – rund 67 Prozent höher als Zürich – und dass das Basler Erdbeben von 1356 (Magnitude 6,6) die Schweizer Erdbebennormen massgeblich geprägt hat. Wir wissen, dass Container für Roche, Novartis, Lonza und USB praktisch immer in Bauwerksklasse II (BWK II) eingestuft werden und dass die ESV-Anzeige bei BAFU/BAG plus Swissmedic-Inspektionsbereitschaft ab Tag 1 Pflicht sind. Wir kennen die trinationale Sonderlage: Standorte in Saint-Louis (FR) liegen im EU-Binnenmarkt – ohne Verzollung – während Basel-Stadt und Basel-Land über T1-Versandverfahren mit Verzollung am Zollamt Weil am Rhein abgewickelt werden. Diese Details stehen nicht in unserem Angebot – sie sind das Engineering- und Logistik-Fundament jedes Containers, der unser Werk Albstadt verlässt.</p>
            <p><strong>Made in Albstadt, verzollt in Weil am Rhein, schlüsselfertig in Basel.</strong> Endmontage und Innenausbau erfolgen mit Wesemann-Möbeln im eigenen Werk – Werksbesichtigung beidseitig planbar. Über die A81 südwärts via Singen/Stockach, dann A98 westwärts entlang der DE-CH-Grenze und über den Grenzübergang Weil am Rhein/Basel-Hiltalingerstrasse direkt in den Raum Basel beträgt die Schwerlastdistanz rund 130 Kilometer – die kürzeste Schwerlast-Route von einem deutschen Werk zu jedem CH-Standort. Anschlussstellen Basel-Nord für Hafen Kleinhüningen, Klybeck-Areal und Novartis Campus St. Johann, Basel-Süd für Roche Wettstein und USB, Basel-Ost (A2/A3-Verzweigung) für Lonza Münchensteinerstrasse und FMI/D-BSSE in Rosental sind Standardanlieferpunkte.</p>
            <p>Ob Sie ein <strong>mobiles Labor Basel</strong> für eine befristete USB-Sanierungsphase brauchen, einen <strong>modularen Laborcontainer Basel</strong> für die dauerhafte Erweiterung am Klybeck-Areal oder ein <strong>Containerlabor Basel</strong> mit BSL-3-Containment und Swissmedic-tauglicher GMP für Roche-, Novartis- oder Lonza-Pilotanlagen – wir liefern alle drei Antworten aus derselben Plattform: dem LABtoGO unseres Werks Albstadt, mit Schweizer Verzollungs-, Z2-Statik- und Energie-Dokumentation ab Werk.</p>
