---
import Layout from '../layouts/Layout.astro';
import ContactForm from '../components/ContactForm.tsx';
import Picture from '../components/Picture.astro';
import AuthorBio from '../components/AuthorBio.astro';
import CityCrossLinks from '../components/CityCrossLinks.astro';

const title = "Laborcontainer Düsseldorf | BSL-3, BauO NRW | Planexus";
const description = "Laborcontainer Düsseldorf: LABtoGO 2.0, 2,75 m Innenhöhe, BSL-3, GMP, Rheinhochwasser-Statik. Werk Albstadt via A81/A3 in 8–14 Wochen.";
const canonical = "/laborcontainer-duesseldorf";
const ogImage = "https://planexus.de/assets/laborcontainer-modulbau.jpg";

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "serviceType": "Laborcontainer und modularer Laborbau Düsseldorf",
  "provider": {
    "@type": "Organization",
    "name": "Planexus GmbH",
    "url": "https://planexus.de",
    "telephone": "+49 7435 7519 700",
    "email": "info@planexus.de",
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "Emil-Mayer-Straße 1",
      "addressLocality": "Albstadt",
      "postalCode": "72461",
      "addressCountry": "DE"
    },
    "parentOrganization": {
      "@type": "Organization",
      "name": "Wesemann Holding GmbH"
    }
  },
  "areaServed": [
    { "@type": "City", "name": "Düsseldorf" },
    { "@type": "AdministrativeArea", "name": "Nordrhein-Westfalen" },
    { "@type": "AdministrativeArea", "name": "Rheinland" }
  ],
  "description": "Containerlabore, mobile Labore und modulare Laborgebäude für Pharma, Life Sciences, Universitätsklinik UKD, Henkel-R&D Holthausen, Qiagen Hilden und das Forschungszentrum Jülich – ab Werk Albstadt schlüsselfertig nach Düsseldorf.",
  "offers": {
    "@type": "AggregateOffer",
    "priceCurrency": "EUR",
    "availability": "https://schema.org/InStock"
  }
};

const localBusinessSchema = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "name": "Planexus GmbH – Laborcontainer Düsseldorf",
