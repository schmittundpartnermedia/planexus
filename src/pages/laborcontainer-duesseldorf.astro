---
import Layout from '../layouts/Layout.astro';

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": "Laborcontainer Düsseldorf",
  "description": "Mobile Analytik- und Gefahrstofflabore für den Chemie-Korridor Rheinland. CHEMPARK-Anbindung, Henkel-Ökosystem, UKD-Forschung – Containerlabore von Planexus.",
  "provider": {
    "@type": "Organization",
    "name": "Planexus GmbH",
    "url": "https://www.planexus.de"
  },
  "areaServed": [
    { "@type": "City", "name": "Düsseldorf" },
    { "@type": "State", "name": "Nordrhein-Westfalen" }
  ],
  "serviceType": ["Laborcontainer", "Gefahrstofflabor", "Analytiklabor", "Chemielabor", "BSL-2 Container"],
  "url": "https://www.planexus.de/laborcontainer-duesseldorf"
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Start", "item": "https://www.planexus.de/" },
    { "@type": "ListItem", "position": 2, "name": "Laborcontainer Düsseldorf", "item": "https://www.planexus.de/laborcontainer-duesseldorf" }
  ]
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Können Containerlabore für den CHEMPARK genutzt werden?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Ja. Die drei CHEMPARK-Standorte Leverkusen, Dormagen und Krefeld-Uerdingen beherbergen über 70 Unternehmen mit rund 51.000 Beschäftigten. Containerlabore eignen sich dort als temporäre Analytik-Erweiterung bei Produktionshochläufen, Anlagenrevisionen oder neuen Projektphasen – ohne in die bestehende Infrastruktur einzugreifen."
      }
    },
    {
      "@type": "Question",
      "name": "Welche Gefahrstoffanforderungen erfüllen die Container?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Unsere Gefahrstofflabor-Container erfüllen die Anforderungen der GefStoffV und TRGS 510. Das umfasst: EX-geschützte Elektrik (ATEX), Gaswarnanlage, Auffangwannen, säure-/laugenbeständige Oberflächen, Notduschen und zwangsbelüftete Abzüge. Die Ausstattung wird projektspezifisch nach dem Gefahrstoffverzeichnis des Kunden konfiguriert."
      }
    },
    {
      "@type": "Question",
      "name": "Brauche ich in NRW eine Baugenehmigung für Laborcontainer?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Die BauO NRW 2018 regelt in § 62 die verfahrensfreien Bauvorhaben. Unter bestimmten Voraussetzungen können temporäre Anlagen ohne Baugenehmigung aufgestellt werden. Bei Laboren mit Gefahrstoffen oder als Sonderbauten ist ein Bauantrag bei der zuständigen Bauaufsichtsbehörde erforderlich. Wir klären die Genehmigungslage im Vorfeld."
      }
    },
    {
      "@type": "Question",
      "name": "Wie weit ist es von Albstadt nach Düsseldorf?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Rund 480 km über die A81 und A5 – etwa 4,5 bis 5 Stunden Fahrzeit. Für Schwerlasttransporte planen wir einen Tag ein. Standortbegehungen organisieren wir effizient im Vorfeld, Werksabnahmen finden in Albstadt statt."
      }
    },
    {
      "@type": "Question",
      "name": "Gibt es Containerlabore für die MEDICA-Messe?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Ja. Einige Kunden nutzen Containerlabore als Demonstrationseinheiten rund um die MEDICA – die weltgrößte Medizinmesse mit über 5.000 Ausstellern und rund 80.000 Fachbesuchern. Wir unterstützen bei der Planung für temporäre Laboraufbauten im Messeumfeld."
      }
    },
    {
      "@type": "Question",
      "name": "Was kostet ein Chemielabor-Container für Düsseldorf?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Die Kosten hängen von der Gefahrstoffklasse, Ausstattung und Sicherheitsstufe ab. Ein einfaches Analytiklabor liegt in einer anderen Kategorie als ein vollausgestattetes Gefahrstofflabor mit EX-Schutz. Nach der Bedarfsanalyse erstellen wir eine projektspezifische Kalkulation."
      }
    }
  ]
};

const localBusinessSchema = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "name": "Planexus GmbH – Laborcontainer Düsseldorf",
  "description": "Analytik- und Gefahrstofflabore im Container für Düsseldorf, den CHEMPARK und das Rheinland. Chemielabore, BSL-Container und Pharma-Analytik.",
  "url": "https://www.planexus.de",
  "telephone": "+49 7435 7519 700",
  "email": "info@planexus.de",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "Am Steinbach 8",
    "addressLocality": "Albstadt",
    "postalCode": "72459",
    "addressCountry": "DE"
  },
  "areaServed": [
    { "@type": "City", "name": "Düsseldorf" },
    { "@type": "State", "name": "Nordrhein-Westfalen" }
  ]
};
---

<Layout
  title="Laborcontainer Düsseldorf – Chemie, CHEMPARK & Gefahrstofflabor | Planexus GmbH"
  description="Containerlabore für den Chemie-Korridor Rheinland: CHEMPARK Leverkusen/Dormagen, Henkel, UKD. Gefahrstofflabore, Analytik, BSL-2 – schlüsselfertig von Planexus."
  canonical="/laborcontainer-duesseldorf"
  schema={serviceSchema}
  ogImage="/attached_assets/Kopf_green-scaled_1768306688943.jpg"
>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} slot="head" />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} slot="head" />
  <script type="application/ld+json" set:html={JSON.stringify(localBusinessSchema)} slot="head" />

  <div class="pt-20 min-h-screen bg-white">

    <!-- Hero: Chemie-Korridor-Narrativ -->
    <section class="relative py-32 bg-slate-900 text-white overflow-hidden">
      <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top_left,rgba(187,215,0,0.1),transparent_60%)]"></div>
      <div class="absolute bottom-0 right-0 w-[600px] h-[400px] bg-primary/3 rounded-full blur-[120px]"></div>

      <div class="container mx-auto px-4 relative z-10">
        <div class="max-w-4xl">
          <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-white/10 text-primary text-sm font-medium mb-8 backdrop-blur-sm border border-white/10">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
            Düsseldorf & Rheinland
          </div>
          <h1 class="text-4xl md:text-5xl lg:text-6xl font-heading font-bold mb-6 leading-tight">
            Europas Chemie-Achse braucht <span class="text-primary">flexible Analytik</span>
          </h1>
          <p class="text-xl text-gray-300 mb-4 leading-relaxed font-light max-w-3xl">
            Drei CHEMPARK-Standorte, über 70 Chemieunternehmen und 51.000 Beschäftigte – der Rhein-Korridor zwischen Düsseldorf, Leverkusen und Dormagen ist Europas dichtester Chemie-Cluster. Laborkapazität ist hier keine Option, sondern Betriebsvoraussetzung.
          </p>
          <p class="text-lg text-gray-400 mb-10 max-w-2xl">
            Wenn Anlagenrevisionen, Produktionshochläufe oder neue Projekte den Bedarf sprunghaft erhöhen, liefern wir das Labor – im Container.
          </p>

          <div class="flex flex-col sm:flex-row gap-4 mb-16">
            <a href="/kontakt" class="bg-primary text-slate-900 font-bold px-8 py-4 rounded-lg hover:bg-primary/90 transition-colors flex items-center justify-center gap-2 group shadow-[0_0_20px_rgba(187,215,0,0.3)]">
              Chemie-Projekt anfragen
              <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 group-hover:translate-x-1 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
            </a>
            <a href="tel:+4974357519700" class="border border-white/20 text-white font-medium px-8 py-4 rounded-lg hover:bg-white/10 transition-colors backdrop-blur-sm flex items-center justify-center gap-2">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
              +49 7435 7519 700
            </a>
          </div>

          <div class="grid grid-cols-3 gap-4">
            <div class="bg-white/5 border border-white/10 rounded-xl p-5 text-center">
              <div class="text-2xl font-heading font-bold text-primary">70+</div>
              <p class="text-gray-400 text-sm mt-1">Unternehmen im CHEMPARK</p>
            </div>
            <div class="bg-white/5 border border-white/10 rounded-xl p-5 text-center">
              <div class="text-2xl font-heading font-bold text-primary">51.000</div>
              <p class="text-gray-400 text-sm mt-1">Beschäftigte an drei Standorten</p>
            </div>
            <div class="bg-white/5 border border-white/10 rounded-xl p-5 text-center">
              <div class="text-2xl font-heading font-bold text-primary">~100</div>
              <p class="text-gray-400 text-sm mt-1">Life-Science-Unternehmen in der Region</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Breadcrumb -->
    <nav class="bg-gray-50 border-b border-gray-100 py-3">
      <div class="container mx-auto px-4">
        <ol class="flex items-center gap-2 text-sm text-gray-500">
          <li><a href="/" class="hover:text-primary transition-colors">Start</a></li>
          <li><svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg></li>
          <li class="text-primary font-medium">Laborcontainer Düsseldorf</li>
        </ol>
      </div>
    </nav>

    <!-- Section 1: Die Rhein-Achse — CHEMPARK Deep Dive -->
    <section class="py-20 bg-white">
      <div class="container mx-auto px-4">
        <div class="max-w-5xl mx-auto">
          <h2 class="text-3xl md:text-4xl font-heading font-bold mb-6 text-slate-900">
            CHEMPARK Leverkusen – Dormagen – Uerdingen: Drei Standorte, ein Analytik-Bedarf
          </h2>
          <p class="text-gray-600 text-lg mb-12 leading-relaxed max-w-3xl">
            Die drei CHEMPARK-Standorte entlang des Rheins bilden das Rückgrat der nordrhein-westfälischen Chemieindustrie. Was als Bayer-Werke begann, ist heute ein offener Industriepark mit über 70 eigenständigen Unternehmen. Qualitätskontrolle, Umweltanalytik und Prozessüberwachung laufen hier rund um die Uhr.
          </p>

          <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
            <div class="bg-white rounded-2xl border-2 border-gray-100 overflow-hidden hover:border-primary/30 transition-colors">
              <div class="bg-slate-900 p-6">
                <h3 class="text-lg font-heading font-bold text-white">CHEMPARK Leverkusen</h3>
                <p class="text-primary text-sm mt-1">Ursprung & Zentrale</p>
              </div>
              <div class="p-6">
                <p class="text-gray-600 text-sm leading-relaxed mb-4">
                  Stammsitz der ehemaligen Bayer-Werke und heute Hauptstandort des CHEMPARK. Covestro hat hier seinen globalen Hauptsitz. Großchemische Produktion, Forschung und Entwicklung auf engstem Raum – der Analytik-Bedarf ist enorm und die Fläche begrenzt.
                </p>
                <div class="bg-slate-50 rounded-lg p-3">
                  <p class="text-gray-500 text-xs">Covestro-Zentrale, Currenta (CHEMPARK-Betreiber), Bayer CropScience</p>
                </div>
              </div>
            </div>

            <div class="bg-white rounded-2xl border-2 border-gray-100 overflow-hidden hover:border-primary/30 transition-colors">
              <div class="bg-slate-900 p-6">
                <h3 class="text-lg font-heading font-bold text-white">CHEMPARK Dormagen</h3>
                <p class="text-primary text-sm mt-1">Produktion & Logistik</p>
              </div>
              <div class="p-6">
                <p class="text-gray-600 text-sm leading-relaxed mb-4">
                  Schwerpunkt: großvolumige Chemieproduktion mit direktem Rhein-Zugang. LANXESS betreibt hier mehrere Produktionsanlagen. Analytische Prozesskontrolle bei Schichtbetrieb erfordert permanente Laborverfügbarkeit – Containerlabore überbrücken Kapazitätsengpässe.
                </p>
                <div class="bg-slate-50 rounded-lg p-3">
                  <p class="text-gray-500 text-xs">LANXESS, Ineos, ARLANXEO – Rhein-Logistik für Rohstoffe</p>
                </div>
              </div>
            </div>

            <div class="bg-white rounded-2xl border-2 border-gray-100 overflow-hidden hover:border-primary/30 transition-colors">
              <div class="bg-slate-900 p-6">
                <h3 class="text-lg font-heading font-bold text-white">CHEMPARK Krefeld-Uerdingen</h3>
                <p class="text-primary text-sm mt-1">Spezialchemie</p>
              </div>
              <div class="p-6">
                <p class="text-gray-600 text-sm leading-relaxed mb-4">
                  Spezialchemikalien und Hightech-Polymere. Covestro produziert hier Polycarbonat und Polyurethane. Die Qualitätskontrolle für Spezialprodukte stellt besondere Anforderungen an Laborausstattung und Reinheit – ideal für spezialisierte Containeranalytik.
                </p>
                <div class="bg-slate-50 rounded-lg p-3">
                  <p class="text-gray-500 text-xs">Covestro Polycarbonat, LANXESS Spezialchemie</p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Section 2: Gefahrstofflabor — Kernanforderung Rheinland -->
    <section class="py-20 bg-slate-900 text-white">
      <div class="container mx-auto px-4">
        <div class="max-w-5xl mx-auto">
          <h2 class="text-3xl md:text-4xl font-heading font-bold mb-6">
            Gefahrstofflabor im Container: Sicher, normkonform und sofort verfügbar
          </h2>
          <p class="text-gray-400 text-lg mb-12 leading-relaxed max-w-3xl">
            Im Chemie-Korridor Rheinland ist der Umgang mit Gefahrstoffen Alltag. Ein Containerlabor für diese Anforderungen muss mehr leisten als vier Wände und ein Abzug – es braucht eine durchdachte Sicherheitsarchitektur nach GefStoffV und TRGS 510.
          </p>

          <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            <div class="bg-white/5 border border-white/10 rounded-xl p-6">
              <div class="w-12 h-12 bg-primary/15 rounded-xl flex items-center justify-center mb-4">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10"/></svg>
              </div>
              <h3 class="font-bold text-lg mb-3 text-primary">EX-Schutz & ATEX</h3>
              <p class="text-gray-300 text-sm leading-relaxed">
                Explosionsgeschützte Elektrik, Beleuchtung und Schaltgeräte nach ATEX-Richtlinie 2014/34/EU. Zoneneinteilung nach Gefährdungsbeurteilung, EX-geschützte Steckdosen und Schalter, funkenfreie Oberflächen.
              </p>
            </div>

            <div class="bg-white/5 border border-white/10 rounded-xl p-6">
              <div class="w-12 h-12 bg-primary/15 rounded-xl flex items-center justify-center mb-4">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M8 2v4"/><path d="M16 2v4"/><path d="M12 14v4"/><path d="M12 14a4 4 0 0 0 0-8"/><path d="M12 14a4 4 0 0 1 0-8"/></svg>
              </div>
              <h3 class="font-bold text-lg mb-3 text-primary">Gaswarnanlage</h3>
              <p class="text-gray-300 text-sm leading-relaxed">
                Stationäre Gaswarnsensoren für brennbare Gase, toxische Dämpfe und Sauerstoffmangel. Automatische Lüftungssteuerung bei Grenzwertüberschreitung, akustische und optische Alarmierung, Aufzeichnung für Audit-Trails.
              </p>
            </div>

            <div class="bg-white/5 border border-white/10 rounded-xl p-6">
              <div class="w-12 h-12 bg-primary/15 rounded-xl flex items-center justify-center mb-4">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 18h8"/><path d="M3 22h18"/><path d="M14 22a7 7 0 1 0 0-14h-1"/><path d="M9 14h2"/><path d="M9 12a2 2 0 0 1-2-2V6h6v4a2 2 0 0 1-2 2Z"/><path d="M12 6V3a1 1 0 0 0-1-1H9a1 1 0 0 0-1 1v3"/></svg>
              </div>
              <h3 class="font-bold text-lg mb-3 text-primary">Laborabzüge & Absaugung</h3>
              <p class="text-gray-300 text-sm leading-relaxed">
                Zwangsbelüftete Abzüge nach DIN EN 14175 mit Frontschieber und Strömungsüberwachung. Aktivkohlefilter oder Wäscher je nach Stoffklasse. Anbindung an bestehende Abluftanlagen auf dem Werksgelände möglich.
              </p>
            </div>

            <div class="bg-white/5 border border-white/10 rounded-xl p-6">
              <div class="w-12 h-12 bg-primary/15 rounded-xl flex items-center justify-center mb-4">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 14a1 1 0 0 1-.78-1.63l9.9-10.2a.5.5 0 0 1 .86.46l-1.92 6.02A1 1 0 0 0 13 10h7a1 1 0 0 1 .78 1.63l-9.9 10.2a.5.5 0 0 1-.86-.46l1.92-6.02A1 1 0 0 0 11 14z"/></svg>
              </div>
              <h3 class="font-bold text-lg mb-3 text-primary">Auffangwannen & Leckageschutz</h3>
              <p class="text-gray-300 text-sm leading-relaxed">
                Integrierte Auffangwannen nach AwSV (Verordnung über Anlagen zum Umgang mit wassergefährdenden Stoffen). Säure- und laugenbeständige Bodenbeschichtung, Hohlkehlausbildung, Leckagesensoren mit Alarm.
              </p>
            </div>

            <div class="bg-white/5 border border-white/10 rounded-xl p-6">
              <div class="w-12 h-12 bg-primary/15 rounded-xl flex items-center justify-center mb-4">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m2 4 3 12h14l3-12"/><path d="M6 16a2 2 0 1 0 4 0"/><path d="M14 16a2 2 0 1 0 4 0"/></svg>
              </div>
              <h3 class="font-bold text-lg mb-3 text-primary">Notduschen & Augenduschen</h3>
              <p class="text-gray-300 text-sm leading-relaxed">
                Körpernotdusche und Augenspülstation nach DIN EN 15154 direkt im oder am Container. Frostschutz-Ausführung für Außenaufstellung, Temperierung des Spülwassers nach Betriebsanweisung.
              </p>
            </div>

            <div class="bg-white/5 border border-white/10 rounded-xl p-6">
              <div class="w-12 h-12 bg-primary/15 rounded-xl flex items-center justify-center mb-4">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10"/><path d="m9 12 2 2 4-4"/></svg>
              </div>
              <h3 class="font-bold text-lg mb-3 text-primary">Chemikalienbeständige Oberflächen</h3>
              <p class="text-gray-300 text-sm leading-relaxed">
                Arbeitsflächen aus HPL, Keramik oder Edelstahl V4A. Wand- und Bodenbeschichtungen beständig gegen Säuren, Laugen und organische Lösungsmittel. Alle Materialien dokumentiert mit Beständigkeitslisten.
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Section 3: Henkel, UKD & BioRiver-Ökosystem -->
    <section class="py-20 bg-white">
      <div class="container mx-auto px-4">
        <div class="max-w-5xl mx-auto">
          <span class="text-primary text-sm font-bold uppercase tracking-wider">Über den CHEMPARK hinaus</span>
          <h2 class="text-3xl font-heading font-bold mt-3 mb-6 text-slate-900">
            Henkel, Uniklinikum und BioRiver – Düsseldorfs Forschungslandschaft
          </h2>
          <p class="text-gray-600 text-lg mb-12 leading-relaxed max-w-3xl">
            Düsseldorf ist mehr als Chemie. Die Landeshauptstadt beherbergt einen Weltkonzern mit hauseigenem Forschungscampus, ein forschungsstarkes Universitätsklinikum und ein wachsendes Life-Science-Netzwerk.
          </p>

          <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
            <div class="bg-gradient-to-br from-slate-50 to-white rounded-2xl p-8 border border-gray-100">
              <h3 class="text-xl font-heading font-bold text-slate-900 mb-4">Henkel – seit 1878 in Düsseldorf</h3>
              <div class="space-y-3 text-sm mb-4">
                <div class="flex justify-between"><span class="text-gray-500">Standort</span><span class="font-bold text-slate-900">Düsseldorf-Holthausen</span></div>
                <div class="flex justify-between"><span class="text-gray-500">Werksgelände</span><span class="font-bold text-slate-900">1,4 km²</span></div>
                <div class="flex justify-between"><span class="text-gray-500">Anteil am Stadtteil</span><span class="font-bold text-slate-900">~25 %</span></div>
              </div>
              <p class="text-gray-600 text-sm leading-relaxed">
