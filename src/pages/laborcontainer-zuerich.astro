---
import Layout from '../layouts/Layout.astro';

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": "Laborcontainer Zürich",
  "description": "Laborcontainer für Zürich und die Schweiz: Planung, Fertigung und schlüsselfertige Übergabe. BSL-2/BSL-3 Container, mobile Forschungslabore und Reinraumlösungen für Biotech, MedTech und Forschung.",
  "provider": {
    "@type": "Organization",
    "name": "Planexus GmbH",
    "url": "https://www.planexus.de"
  },
  "areaServed": [
    { "@type": "City", "name": "Zürich" },
    { "@type": "AdministrativeArea", "name": "Kanton Zürich" }
  ],
  "url": "https://www.planexus.de/laborcontainer-zuerich"
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Start", "item": "https://www.planexus.de/" },
    { "@type": "ListItem", "position": 2, "name": "Laborcontainer Zürich", "item": "https://www.planexus.de/laborcontainer-zuerich" }
  ]
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Was kostet ein Laborcontainer in Zürich?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Die Kosten hängen von Grösse, Ausstattung und Sicherheitsstufe ab. Dazu kommen Transportkosten und Zollabwicklung DE→CH. Wir nennen Ihnen eine realistische Grössenordnung inklusive aller Nebenkosten."
      }
    },
    {
      "@type": "Question",
      "name": "Brauche ich im Kanton Zürich eine Baubewilligung für einen Laborcontainer?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "In der Regel ja. Die kantonale Bauverfahrensverordnung (BVV) sieht für Bauten über 6 m² Bodenfläche eine Bewilligung vor. Je nach Standort kommen Meldeverfahren, Anzeigeverfahren (30 Tage) oder das ordentliche Verfahren infrage. Wir klären das vorab mit dem zuständigen Bauamt."
      }
    },
    {
      "@type": "Question",
      "name": "Wie funktioniert die Lieferung eines Laborcontainers in die Schweiz?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Wir fertigen in unserem Werk in Albstadt (Deutschland) und liefern per Tieflader über die A81 und den Grenzübergang Thayngen/Schaffhausen. Die Zollabwicklung übernehmen wir komplett – inklusive aller erforderlichen Dokumente. Für vorsteuerabzugsberechtigte Unternehmen ist die Schweizer MWST vollständig rückforderbar."
      }
    },
    {
      "@type": "Question",
      "name": "Kann ich einen Laborcontainer in Zürich auch mieten?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Ja. Miete, Kauf oder Mietkauf – wir bieten flexible Modelle. Besonders für befristete Forschungsprojekte, Startup-Labore im Technopark Schlieren oder Interimslösungen während Umbauarbeiten sinnvoll."
      }
    },
    {
      "@type": "Question",
      "name": "Erfüllen Ihre Laborcontainer Schweizer Normen?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Ja. Wir planen nach SIA-Normen (insbesondere SIA 382/1 für Lüftung, SIA 180 für Wärmeschutz), berücksichtigen SUVA-Richtlinien und EKAS 1871 für Arbeitssicherheit. Auf Wunsch auch nach Swissmedic-Standards für pharmazeutische Anwendungen."
      }
    },
    {
      "@type": "Question",
      "name": "Eignet sich ein Containerlabor für Biotech-Startups in Zürich?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Ja, ideal sogar. Ein Containerlabor ist in 8–12 Wochen einsatzbereit, flexibel erweiterbar und deutlich günstiger als ein Laborraum im Zürcher Immobilienmarkt. Viele Startups und ETH-Spin-offs nutzen Container als Erstlabor oder zur schnellen Skalierung."
      }
    }
  ]
};

const localBusinessSchema = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "name": "Planexus GmbH",
  "description": "Laborcontainer für Zürich und die Schweiz",
  "url": "https://www.planexus.de",
  "telephone": "+49 7435 7519 700",
  "email": "info@planexus.de",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "Am Steinbach 8",
    "addressLocality": "Albstadt",
    "postalCode": "72459",
    "addressCountry": "DE"
  },
  "areaServed": [
    { "@type": "City", "name": "Zürich" },
    { "@type": "AdministrativeArea", "name": "Kanton Zürich" }
  ]
};
---

<Layout
  title="Laborcontainer Zürich – Planung & Bau"
  description="Laborcontainer für Zürich und die Schweiz: Mobile Labore für Biotech, MedTech und Forschung. BSL-2/BSL-3, schlüsselfertig. Jetzt beraten lassen."
  canonical="/laborcontainer-zuerich"
  schema={serviceSchema}
  ogImage="/attached_assets/Kopf_green-scaled_1768306688943.jpg"
>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} slot="head" />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} slot="head" />
  <script type="application/ld+json" set:html={JSON.stringify(localBusinessSchema)} slot="head" />

  <div class="pt-20 min-h-screen bg-white">

    <section class="relative py-28 bg-slate-900 text-white overflow-hidden">
      <div class="absolute inset-0 bg-[url('https://images.unsplash.com/photo-1515488764276-beab7607c1e6?q=80&w=2070')] bg-cover bg-center opacity-15"></div>
      <div class="absolute inset-0 bg-gradient-to-r from-slate-900 via-slate-900/95 to-slate-900/80"></div>

      <div class="container mx-auto px-4 relative z-10">
        <div class="max-w-4xl">
          <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-primary text-slate-900 font-medium text-sm mb-6">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
            <span>Zürich & Greater Zurich Area</span>
          </div>
          <h1 class="text-4xl md:text-6xl font-heading font-bold mb-6 leading-tight">
            Laborcontainer für <span class="text-primary">Zürich</span>
          </h1>
          <p class="text-xl text-gray-300 leading-relaxed max-w-3xl mb-8">
            Europas führender Standort für Biotech, MedTech und Diagnostik – mit der ETH Zürich als Innovationsmotor. Wir planen, bauen und liefern schlüsselfertige Containerlabore für den Grossraum Zürich und die gesamte Deutschschweiz.
          </p>
          <div class="flex flex-col sm:flex-row gap-4">
            <a href="/kontakt" class="bg-primary text-slate-900 font-bold px-8 py-4 rounded-lg hover:bg-primary/90 transition-colors inline-flex items-center gap-2 shadow-[0_0_20px_rgba(132,189,0,0.3)]">
              Projekt besprechen <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
            </a>
            <a href="tel:+4974357519700" class="border border-white/20 text-white font-medium px-8 py-4 rounded-lg hover:bg-white/10 transition-colors inline-flex items-center gap-2">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg> +49 7435 7519 700
            </a>
          </div>
        </div>
      </div>
    </section>

    <div class="bg-slate-50 border-b border-gray-100 py-4">
      <div class="container mx-auto px-4">
        <div class="flex items-center gap-2 text-sm text-gray-500">
          <a href="/" class="hover:text-primary">Start</a>
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
          <span class="text-primary font-medium">Laborcontainer Zürich</span>
        </div>
      </div>
    </div>

    <section class="py-20">
      <div class="container mx-auto px-4">
        <div class="max-w-4xl mx-auto">
          <h2 class="text-3xl font-heading font-bold mb-8 text-slate-900">
            Laborcontainer für Biotech, MedTech und Forschung in Zürich
          </h2>
          <div class="prose prose-lg text-gray-600 max-w-none space-y-6">
            <p>
              Zürich ist das wirtschaftliche Zentrum der Schweiz und einer der führenden Life-Sciences-Standorte Europas. Die ETH Zürich – eine der besten technischen Hochschulen weltweit (Rang 7 im QS-Ranking) – und die Universität Zürich bilden das akademische Fundament. Der Bio-Technopark Schlieren, der Balgrist Campus und das Universitätsspital Zürich treiben die Translation von Forschung in die Praxis voran. Unternehmen wie Roche (Schlieren), Biogen, Amgen und zahlreiche Biotech-Startups schaffen permanenten Bedarf an flexibler Laborinfrastruktur.
            </p>
            <p>
              Doch Laborraum in Zürich ist knapp und teuer. Die hohen Immobilienpreise, die dichte Bebauung und lange Bewilligungsverfahren machen konventionelle Laborbauten zum Geduldspiel. Forschungsprojekte, klinische Studien und Produktentwicklungen warten nicht.
            </p>
            <p>
              Genau hier setzen <strong>Laborcontainer</strong> an. Planexus plant und baut voll ausgestattete, normkonforme Containerlabore – massgeschneidert für Ihren Standort in Zürich. Von der ersten Skizze bis zur schlüsselfertigen Übergabe alles aus einer Hand. <a href="/leistungen" class="text-primary font-medium hover:underline">Unsere Leistungen im Überblick →</a>
            </p>
          </div>
        </div>
      </div>
    </section>

    <section class="py-20 bg-slate-50 border-y border-gray-100">
      <div class="container mx-auto px-4">
        <div class="max-w-4xl mx-auto">
          <h2 class="text-3xl font-heading font-bold mb-4 text-slate-900">
            Wo Laborcontainer in Zürich gebraucht werden
          </h2>
          <p class="text-gray-600 text-lg mb-12">
            Die Greater Zurich Area vereint Spitzenforschung, globale Pharmakonzerne und eine dynamische Startup-Szene – ideale Voraussetzungen für flexible Laborlösungen.
          </p>

          <div class="space-y-8">
            <div class="bg-white p-8 rounded-2xl border border-gray-100 hover:shadow-lg transition-shadow">
              <div class="flex items-start gap-5">
                <div class="w-14 h-14 bg-primary/10 rounded-lg flex items-center justify-center text-primary shrink-0">
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-7 h-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z"/><path d="m3.3 7 8.7 5 8.7-5"/><path d="M12 22V12"/></svg>
                </div>
                <div>
                  <h3 class="text-xl font-bold mb-3 text-slate-900">Biotech und Startup-Labore im Technopark Schlieren</h3>
                  <p class="text-gray-600 leading-relaxed">
                    Der Bio-Technopark Schlieren ist das Herzstück der Zürcher Life-Sciences-Szene. Junge Biotech-Unternehmen und ETH-Spin-offs brauchen sofort einsatzfähige Labore – ohne jahrelange Bauplanung. Ein Containerlabor steht auf dem Gelände, betriebsbereit in Wochen statt Jahren. <a href="/leistungen/beratung" class="text-primary font-medium hover:underline">Mehr zur Beratung →</a>
                  </p>
                </div>
              </div>
            </div>

            <div class="bg-white p-8 rounded-2xl border border-gray-100 hover:shadow-lg transition-shadow">
              <div class="flex items-start gap-5">
                <div class="w-14 h-14 bg-primary/10 rounded-lg flex items-center justify-center text-primary shrink-0">
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-7 h-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10"/><path d="m9 12 2 2 4-4"/></svg>
                </div>
                <div>
                  <h3 class="text-xl font-bold mb-3 text-slate-900">Klinische Forschung am Universitätsspital Zürich</h3>
                  <p class="text-gray-600 leading-relaxed">
                    USZ und UZH treiben klinische Studien in Onkologie, Immunologie und Neurowissenschaften voran. Wenn zusätzliche Laborkapazität unter <a href="/magazin/bsl-2-bsl-3-container-labor" class="text-primary font-medium hover:underline">BSL-2-Bedingungen</a> benötigt wird, liefert ein Containerlabor die Lösung – direkt auf dem Spital-Campus, ohne Eingriff in die bestehende Infrastruktur.
                  </p>
                </div>
              </div>
            </div>

            <div class="bg-white p-8 rounded-2xl border border-gray-100 hover:shadow-lg transition-shadow">
              <div class="flex items-start gap-5">
                <div class="w-14 h-14 bg-primary/10 rounded-lg flex items-center justify-center text-primary shrink-0">
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-7 h-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 18h8"/><path d="M3 22h18"/><path d="M14 22a7 7 0 1 0 0-14h-1"/><path d="M9 14h2"/><path d="M9 12a2 2 0 0 1-2-2V6h6v4a2 2 0 0 1-2 2Z"/><path d="M12 6V3a1 1 0 0 0-1-1H9a1 1 0 0 0-1 1v3"/></svg>
                </div>
                <div>
                  <h3 class="text-xl font-bold mb-3 text-slate-900">MedTech und Diagnostik im Grossraum Zürich</h3>
                  <p class="text-gray-600 leading-relaxed">
                    Roche Diagnostics (Rotkreuz), Siemens Healthineers, Balgrist Campus – die Region ist ein Hotspot für Medizintechnik und In-vitro-Diagnostik. QC-Labore direkt auf dem Firmengelände ermöglichen schnelle Qualitätskontrollen ohne Probentransport. <a href="/leistungen/ausstattung" class="text-primary font-medium hover:underline">Mehr zur Laborausstattung →</a>
                  </p>
                </div>
              </div>
            </div>

            <div class="bg-white p-8 rounded-2xl border border-gray-100 hover:shadow-lg transition-shadow">
              <div class="flex items-start gap-5">
                <div class="w-14 h-14 bg-primary/10 rounded-lg flex items-center justify-center text-primary shrink-0">
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-7 h-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                </div>
                <div>
                  <h3 class="text-xl font-bold mb-3 text-slate-900">Materialforschung und Analytik an der ETH</h3>
                  <p class="text-gray-600 leading-relaxed">
                    ETH Zürich, Empa Dübendorf, Paul Scherrer Institut (PSI, ~100 km) – hochspezialisierte Forschung, die flexible Laborkapazität direkt vor Ort benötigt. Ein Containerlabor ergänzt bestehende Infrastruktur ohne Bauzeit und Bewilligungsverfahren. <a href="/leistungen/smart-lab" class="text-primary font-medium hover:underline">Mehr zu Smart Lab →</a>
                  </p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="py-20">
      <div class="container mx-auto px-4">
        <div class="text-center max-w-2xl mx-auto mb-16">
          <h2 class="text-3xl md:text-4xl font-heading font-bold mb-4 text-slate-900">Was wir für Zürich übernehmen</h2>
          <p class="text-gray-600 text-lg">
            Von der ersten Idee bis zum betriebsfertigen Labor – als Hersteller mit eigener Fertigung, nicht als Vermittler.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          <div class="bg-white border border-gray-100 p-6 rounded-xl hover:shadow-xl hover:shadow-gray-200/50 transition-all group relative overflow-hidden">
            <div class="absolute top-0 left-0 w-1 h-full bg-primary opacity-0 group-hover:opacity-100 transition-opacity"></div>
            <div class="w-14 h-14 bg-primary/10 rounded-lg flex items-center justify-center mb-4 text-primary group-hover:bg-primary group-hover:text-slate-900 transition-colors">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="7" height="9" x="3" y="3" rx="1"/><rect width="7" height="5" x="14" y="3" rx="1"/><rect width="7" height="9" x="14" y="12" rx="1"/><rect width="7" height="5" x="3" y="16" rx="1"/></svg>
            </div>
            <h3 class="text-lg font-bold mb-2 text-slate-900">Technische Fachplanung</h3>
            <p class="text-gray-600 text-sm mb-4">CAD-Entwürfe, 3D-Visualisierungen und TGA-Konzepte – abgestimmt auf die hohen Schweizer Normen (SIA) und die oft beengten Platzverhältnisse an Zürcher Standorten.</p>
            <a href="/leistungen/planung" class="text-primary font-bold text-sm flex items-center gap-2 group-hover:translate-x-1 transition-transform">
              Mehr erfahren <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
            </a>
          </div>

          <div class="bg-white border border-gray-100 p-6 rounded-xl hover:shadow-xl hover:shadow-gray-200/50 transition-all group relative overflow-hidden">
            <div class="absolute top-0 left-0 w-1 h-full bg-primary opacity-0 group-hover:opacity-100 transition-opacity"></div>
            <div class="w-14 h-14 bg-primary/10 rounded-lg flex items-center justify-center mb-4 text-primary group-hover:bg-primary group-hover:text-slate-900 transition-colors">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m12.83 2.18a2 2 0 0 0-1.66 0L2.6 6.08a1 1 0 0 0 0 1.83l8.58 3.91a2 2 0 0 0 1.66 0l8.58-3.9a1 1 0 0 0 0-1.83Z"/><path d="m22 17.65-9.17 4.16a2 2 0 0 1-1.66 0L2 17.65"/><path d="m22 12.65-9.17 4.16a2 2 0 0 1-1.66 0L2 12.65"/></svg>
            </div>
            <h3 class="text-lg font-bold mb-2 text-slate-900">Modulbau & Fertigung</h3>
            <p class="text-gray-600 text-sm mb-4">Massfertigung in unserem Werk in Albstadt (Deutschland). Der Transport in die Schweiz ist eingespielt – inklusive Zollabwicklung und Dokumentation.</p>
            <a href="/leistungen/modulbau" class="text-primary font-bold text-sm flex items-center gap-2 group-hover:translate-x-1 transition-transform">
              Mehr erfahren <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
            </a>
          </div>

          <div class="bg-white border border-gray-100 p-6 rounded-xl hover:shadow-xl hover:shadow-gray-200/50 transition-all group relative overflow-hidden">
            <div class="absolute top-0 left-0 w-1 h-full bg-primary opacity-0 group-hover:opacity-100 transition-opacity"></div>
            <div class="w-14 h-14 bg-primary/10 rounded-lg flex items-center justify-center mb-4 text-primary group-hover:bg-primary group-hover:text-slate-900 transition-colors">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M13 13h8"/><path d="M13 17h8"/><path d="M13 9h8"/><path d="M1 5h4l2 10h10l2-8H5"/></svg>
            </div>
            <h3 class="text-lg font-bold mb-2 text-slate-900">Logistik & Montage</h3>
            <p class="text-gray-600 text-sm mb-4">Transport per Tieflader über die A81 und die A1 nach Zürich. Aufstellung per Kran – auch auf Technopark-Geländen oder Spital-Campus.</p>
            <a href="/leistungen/logistik" class="text-primary font-bold text-sm flex items-center gap-2 group-hover:translate-x-1 transition-transform">
              Mehr erfahren <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
            </a>
          </div>

          <div class="bg-white border border-gray-100 p-6 rounded-xl hover:shadow-xl hover:shadow-gray-200/50 transition-all group relative overflow-hidden">
            <div class="absolute top-0 left-0 w-1 h-full bg-primary opacity-0 group-hover:opacity-100 transition-opacity"></div>
            <div class="w-14 h-14 bg-primary/10 rounded-lg flex items-center justify-center mb-4 text-primary group-hover:bg-primary group-hover:text-slate-900 transition-colors">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 18h8"/><path d="M3 22h18"/><path d="M14 22a7 7 0 1 0 0-14h-1"/><path d="M9 14h2"/><path d="M9 12a2 2 0 0 1-2-2V6h6v4a2 2 0 0 1-2 2Z"/><path d="M12 6V3a1 1 0 0 0-1-1H9a1 1 0 0 0-1 1v3"/></svg>
            </div>
            <h3 class="text-lg font-bold mb-2 text-slate-900">Laborausstattung</h3>
            <p class="text-gray-600 text-sm mb-4">Abzüge, Sicherheitswerkbänke, Labormöbel, Kühlsysteme, Lüftungstechnik – eingebaut und betriebsfertig. Auf Wunsch GMP-konform nach Swissmedic-Standards.</p>
