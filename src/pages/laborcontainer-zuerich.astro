---
import Layout from '../layouts/Layout.astro';

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": "Laborcontainer Zürich",
  "description": "Laborcontainer für Zürich und die Schweiz: Planung, Fertigung und schlüsselfertige Übergabe. BSL-2/BSL-3 Container, mobile Forschungslabore und Reinraumlösungen für Biotech, MedTech und Forschung.",
  "provider": {
    "@type": "Organization",
    "name": "Planexus GmbH",
    "url": "https://www.planexus.de"
  },
  "areaServed": [
    { "@type": "City", "name": "Zürich" },
    { "@type": "AdministrativeArea", "name": "Kanton Zürich" }
  ],
  "url": "https://www.planexus.de/laborcontainer-zuerich"
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Start", "item": "https://www.planexus.de/" },
    { "@type": "ListItem", "position": 2, "name": "Laborcontainer Zürich", "item": "https://www.planexus.de/laborcontainer-zuerich" }
  ]
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Was kostet ein Laborcontainer in Zürich?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Die Kosten hängen von Grösse, Ausstattung und Sicherheitsstufe ab. Dazu kommen Transportkosten und Zollabwicklung DE→CH. Wir nennen Ihnen eine realistische Grössenordnung inklusive aller Nebenkosten."
      }
    },
    {
      "@type": "Question",
      "name": "Brauche ich im Kanton Zürich eine Baubewilligung für einen Laborcontainer?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "In der Regel ja. Die kantonale Bauverfahrensverordnung (BVV) sieht für Bauten über 6 m² Bodenfläche eine Bewilligung vor. Je nach Standort kommen Meldeverfahren, Anzeigeverfahren (30 Tage) oder das ordentliche Verfahren infrage. Wir klären das vorab mit dem zuständigen Bauamt."
      }
    },
    {
      "@type": "Question",
      "name": "Wie funktioniert die Lieferung eines Laborcontainers in die Schweiz?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Wir fertigen in unserem Werk in Albstadt (Deutschland) und liefern per Tieflader über die A81 und den Grenzübergang Thayngen/Schaffhausen. Die Zollabwicklung übernehmen wir komplett – inklusive aller erforderlichen Dokumente. Für vorsteuerabzugsberechtigte Unternehmen ist die Schweizer MWST vollständig rückforderbar."
      }
    },
    {
      "@type": "Question",
      "name": "Kann ich einen Laborcontainer in Zürich auch mieten?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Ja. Miete, Kauf oder Mietkauf – wir bieten flexible Modelle. Besonders für befristete Forschungsprojekte, Startup-Labore im Technopark Schlieren oder Interimslösungen während Umbauarbeiten sinnvoll."
      }
    },
    {
      "@type": "Question",
      "name": "Erfüllen Ihre Laborcontainer Schweizer Normen?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Ja. Wir planen nach SIA-Normen (insbesondere SIA 382/1 für Lüftung, SIA 180 für Wärmeschutz), berücksichtigen SUVA-Richtlinien und EKAS 1871 für Arbeitssicherheit. Auf Wunsch auch nach Swissmedic-Standards für pharmazeutische Anwendungen."
      }
    },
    {
      "@type": "Question",
      "name": "Eignet sich ein Containerlabor für Biotech-Startups in Zürich?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Ja, ideal sogar. Ein Containerlabor ist in 8–12 Wochen einsatzbereit, flexibel erweiterbar und deutlich günstiger als ein Laborraum im Zürcher Immobilienmarkt. Viele Startups und ETH-Spin-offs nutzen Container als Erstlabor oder zur schnellen Skalierung."
      }
    }
  ]
};

const localBusinessSchema = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "name": "Planexus GmbH",
  "description": "Laborcontainer für Zürich und die Schweiz",
  "url": "https://www.planexus.de",
  "telephone": "+49 7435 7519 700",
  "email": "info@planexus.de",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "Am Steinbach 8",
    "addressLocality": "Albstadt",
    "postalCode": "72459",
    "addressCountry": "DE"
  },
  "areaServed": [
    { "@type": "City", "name": "Zürich" },
    { "@type": "AdministrativeArea", "name": "Kanton Zürich" }
  ]
};
