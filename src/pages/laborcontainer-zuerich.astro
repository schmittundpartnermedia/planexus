const description = "Laborcontainer Zürich: LABtoGO, 2,75 m Innenhöhe, BSL-3, SIA 261, Energie SIA 380/1. Werk Albstadt via A81 + Grenze Thayngen in 8–14 Wochen.";
const canonical = "/laborcontainer-zuerich";

