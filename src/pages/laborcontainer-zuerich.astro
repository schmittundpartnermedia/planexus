---
import Layout from '../layouts/Layout.astro';

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": "Laborcontainer Zürich",
  "description": "Mobile Containerlabore für den Biotech-Standort Zürich. ETH-Spin-off-Ökosystem, Bio-Technopark Schlieren, Swissmedic-Konformität – schlüsselfertig ab Werk Albstadt, 133 km entfernt.",
  "provider": {
    "@type": "Organization",
    "name": "Planexus GmbH",
    "url": "https://www.planexus.de"
  },
  "areaServed": [
    { "@type": "City", "name": "Zürich" },
    { "@type": "AdministrativeArea", "name": "Kanton Zürich" }
  ],
  "serviceType": ["Laborcontainer", "Medtech-Labor", "Biotech-Labor", "Reinraum-Container", "BSL-2 Container"],
  "url": "https://www.planexus.de/laborcontainer-zuerich"
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Start", "item": "https://www.planexus.de/" },
    { "@type": "ListItem", "position": 2, "name": "Laborcontainer Zürich", "item": "https://www.planexus.de/laborcontainer-zuerich" }
  ]
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Liefert Planexus Laborcontainer in die Schweiz?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Ja. Unser Werk in Albstadt liegt nur 133 km von Zürich entfernt – rund 2 Stunden Fahrzeit. Wir übernehmen die komplette Zollabwicklung für den Export DE→CH inklusive Verzollungsdokumentation, T1-Versandverfahren und Einfuhranmeldung."
      }
    },
    {
      "@type": "Question",
      "name": "Erfüllen die Container Swissmedic-Anforderungen?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Unsere Containerlabore können so ausgestattet werden, dass sie die Anforderungen der Swissmedic (basierend auf dem Heilmittelgesetz HMG und der AMBV) erfüllen. Das umfasst GMP-konforme Reinräume, lückenlose Dokumentation und Monitoring. Die Qualifizierung erfolgt nach Schweizer Standards."
      }
    },
    {
      "@type": "Question",
      "name": "Brauche ich im Kanton Zürich eine Baubewilligung?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Im Kanton Zürich regelt das Planungs- und Baugesetz (PBG) die Baubewilligungspflicht. Container gelten grundsätzlich als bewilligungspflichtige Bauten. Für temporäre Anlagen gibt es unter bestimmten Voraussetzungen vereinfachte Verfahren. Wir klären die Bewilligungslage vorab mit der zuständigen Baubehörde."
      }
    },
    {
      "@type": "Question",
      "name": "Gibt es Containerlabore für den Bio-Technopark Schlieren?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Ja. Der Bio-Technopark Schlieren mit seinen 100.000 m² Fläche, rund 60 Unternehmen und über 1.500 Beschäftigten hat permanenten Bedarf an flexibler Laborfläche. Containerlabore sind ideal für Startups und Spin-offs, die schnell Laborkapazität brauchen, ohne langfristige Mietverträge einzugehen."
      }
    },
    {
      "@type": "Question",
      "name": "Wie funktioniert die Zollabwicklung DE→CH?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Wir übernehmen die komplette Exportabwicklung: Ausfuhranmeldung in Deutschland, T1-Versandverfahren, Einfuhrverzollung in der Schweiz. Die Laborausstattung wird als Investitionsgut deklariert. Zollgebühren und MWST (8,1%) werden transparent kalkuliert. Auf Wunsch organisieren wir auch die temporäre Einfuhr (Carnet ATA) für Miet-Container."
      }
    },
    {
      "@type": "Question",
      "name": "Was kostet ein Laborcontainer für Zürich?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Die Kosten richten sich nach Ausstattung und Sicherheitsstufe. Durch die extrem kurze Distanz (133 km) sind die Transportkosten minimal – vergleichbar mit innerdeutschen Lieferungen. Die Zollabwicklung kalkulieren wir transparent in das Angebot ein."
      }
    }
  ]
};

const localBusinessSchema = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "name": "Planexus GmbH – Laborcontainer Zürich",
  "description": "Containerlabore für Zürich, den Bio-Technopark Schlieren und den Kanton Zürich. Biotech, Medtech, Reinraum – Swissmedic-konform.",
  "url": "https://www.planexus.de",
  "telephone": "+49 7435 7519 700",
  "email": "info@planexus.de",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "Am Steinbach 8",
    "addressLocality": "Albstadt",
    "postalCode": "72459",
    "addressCountry": "DE"
  },
  "areaServed": [
    { "@type": "City", "name": "Zürich" },
    { "@type": "Country", "name": "Schweiz" }
  ]
};
---

<Layout
  title="Laborcontainer Zürich – Biotech, ETH Spin-offs & Swissmedic | Planexus GmbH"
  description="Containerlabore für Zürichs Life-Science-Cluster: Bio-Technopark Schlieren, ETH-Spin-offs, Swissmedic-konform. Nur 133 km ab Werk – inkl. Zollabwicklung DE→CH."
  canonical="/laborcontainer-zuerich"
  schema={serviceSchema}
  ogImage="/attached_assets/Kopf_green-scaled_1768306688943.jpg"
>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} slot="head" />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} slot="head" />
  <script type="application/ld+json" set:html={JSON.stringify(localBusinessSchema)} slot="head" />

  <div class="pt-20 min-h-screen bg-white">

    <!-- Hero: Swiss Precision Lab -->
    <section class="relative py-32 bg-slate-900 text-white overflow-hidden">
      <div class="absolute inset-0 bg-[linear-gradient(160deg,rgba(187,215,0,0.08)_0%,transparent_40%)]"></div>
      <div class="absolute top-1/2 right-0 w-[500px] h-[500px] bg-primary/3 rounded-full blur-[150px] -translate-y-1/2"></div>

      <div class="container mx-auto px-4 relative z-10">
        <div class="max-w-4xl">
          <div class="flex items-center gap-3 mb-8">
            <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-white/10 text-primary text-sm font-medium backdrop-blur-sm border border-white/10">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
              Zürich & Kanton
            </div>
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-red-500/20 text-red-400 text-xs font-bold border border-red-500/20">
              <span class="w-2 h-2 bg-red-400 rounded-full"></span>
              Schweiz
            </div>
          </div>

          <h1 class="text-4xl md:text-5xl lg:text-6xl font-heading font-bold mb-6 leading-tight">
            Schweizer Präzision trifft <span class="text-primary">deutsche Labortechnik</span>
          </h1>
          <p class="text-xl text-gray-300 mb-4 leading-relaxed font-light max-w-3xl">
            Zürich ist die Innovationshauptstadt der Schweiz: ETH-Spin-offs, der Bio-Technopark Schlieren und eines der dichtesten Life-Science-Ökosysteme Europas. Wenn Forschung schneller wächst als Gebäude gebaut werden können, braucht es flexible Laborinfrastruktur.
          </p>
          <p class="text-lg text-gray-400 mb-10 max-w-2xl">
            Unser Werk in Albstadt liegt nur 133 km entfernt – näher als mancher Schweizer Anbieter. Zollabwicklung inklusive.
          </p>

          <div class="flex flex-col sm:flex-row gap-4 mb-16">
            <a href="/kontakt" class="bg-primary text-slate-900 font-bold px-8 py-4 rounded-lg hover:bg-primary/90 transition-colors flex items-center justify-center gap-2 group shadow-[0_0_20px_rgba(187,215,0,0.3)]">
              Projekt in Zürich besprechen
              <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 group-hover:translate-x-1 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
            </a>
            <a href="tel:+4974357519700" class="border border-white/20 text-white font-medium px-8 py-4 rounded-lg hover:bg-white/10 transition-colors backdrop-blur-sm flex items-center justify-center gap-2">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
              +49 7435 7519 700
            </a>
          </div>

          <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
            <div class="bg-white/5 border border-white/10 rounded-xl p-4 text-center">
              <div class="text-2xl font-heading font-bold text-primary">133 km</div>
              <p class="text-gray-400 text-xs mt-1">Albstadt → Zürich</p>
            </div>
            <div class="bg-white/5 border border-white/10 rounded-xl p-4 text-center">
              <div class="text-2xl font-heading font-bold text-primary">100.000 m²</div>
              <p class="text-gray-400 text-xs mt-1">Bio-Technopark Schlieren</p>
            </div>
            <div class="bg-white/5 border border-white/10 rounded-xl p-4 text-center">
              <div class="text-2xl font-heading font-bold text-primary">~60</div>
              <p class="text-gray-400 text-xs mt-1">Unternehmen im Technopark</p>
            </div>
            <div class="bg-white/5 border border-white/10 rounded-xl p-4 text-center">
              <div class="text-2xl font-heading font-bold text-primary">30+</div>
              <p class="text-gray-400 text-xs mt-1">ETH-Spin-offs pro Jahr</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Breadcrumb -->
    <nav class="bg-gray-50 border-b border-gray-100 py-3">
      <div class="container mx-auto px-4">
        <ol class="flex items-center gap-2 text-sm text-gray-500">
          <li><a href="/" class="hover:text-primary transition-colors">Start</a></li>
          <li><svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg></li>
          <li class="text-primary font-medium">Laborcontainer Zürich</li>
        </ol>
      </div>
    </nav>

    <!-- Section 1: ETH-Spin-off-Ökosystem -->
    <section class="py-20 bg-white">
      <div class="container mx-auto px-4">
        <div class="max-w-5xl mx-auto">
          <h2 class="text-3xl md:text-4xl font-heading font-bold mb-6 text-slate-900">
            ETH-Spin-offs und Bio-Technopark: Warum Zürich flexible Labore braucht
          </h2>
          <p class="text-gray-600 text-lg mb-12 leading-relaxed max-w-3xl">
            Die ETH Zürich bringt jährlich über 30 Spin-offs hervor – viele davon in Biotech, Medtech und Life Sciences. Diese jungen Unternehmen brauchen Laborkapazität, die mit ihrem Wachstum Schritt hält: schnell verfügbar, skalierbar und ohne langfristige Mietbindung.
          </p>

          <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
            <div class="bg-gradient-to-br from-slate-50 to-white rounded-2xl p-8 border border-gray-100">
              <div class="flex items-center gap-3 mb-4">
                <div class="w-10 h-10 bg-primary/10 rounded-lg flex items-center justify-center">
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-[#7a9900]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>
                </div>
                <h3 class="text-xl font-heading font-bold text-slate-900">ETH Zürich – Spin-off-Motor</h3>
              </div>
              <p class="text-gray-600 text-sm leading-relaxed mb-4">
                Die ETH ist eine der führenden technischen Hochschulen weltweit und ein Inkubator für Deeptech-Startups. 2024 wurden erneut über 30 Spin-offs gegründet – darunter zahlreiche in KI, Biotech und Medtech. Viele dieser Firmen starten in geteilten Laboren und brauchen schnell eigene Kapazität.
              </p>
              <p class="text-gray-600 text-sm leading-relaxed">
                Ein Containerlabor bietet den idealen Einstieg: keine Bauzeit, keine langfristige Mietbindung, sofort verfügbar. Und wenn das Startup wächst, skaliert das Labor mit – durch Zusatzmodule oder den Umzug in grössere Einheiten.
              </p>
            </div>

            <div class="bg-gradient-to-br from-slate-50 to-white rounded-2xl p-8 border border-gray-100">
              <div class="flex items-center gap-3 mb-4">
                <div class="w-10 h-10 bg-primary/10 rounded-lg flex items-center justify-center">
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-[#7a9900]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 18h8"/><path d="M3 22h18"/><path d="M14 22a7 7 0 1 0 0-14h-1"/><path d="M9 14h2"/><path d="M9 12a2 2 0 0 1-2-2V6h6v4a2 2 0 0 1-2 2Z"/><path d="M12 6V3a1 1 0 0 0-1-1H9a1 1 0 0 0-1 1v3"/></svg>
                </div>
                <h3 class="text-xl font-heading font-bold text-slate-900">Bio-Technopark Schlieren</h3>
              </div>
              <div class="space-y-2 text-sm mb-4">
                <div class="flex justify-between"><span class="text-gray-500">Gesamtfläche</span><span class="font-bold text-slate-900">100.000 m²</span></div>
                <div class="flex justify-between"><span class="text-gray-500">Unternehmen & Organisationen</span><span class="font-bold text-slate-900">~60</span></div>
                <div class="flex justify-between"><span class="text-gray-500">Forschungsgruppen</span><span class="font-bold text-slate-900">~80</span></div>
                <div class="flex justify-between"><span class="text-gray-500">Beschäftigte</span><span class="font-bold text-slate-900">>1.500</span></div>
                <div class="flex justify-between"><span class="text-gray-500">Gegründet</span><span class="font-bold text-slate-900">2003</span></div>
              </div>
              <p class="text-gray-600 text-sm leading-relaxed">
                Der Bio-Technopark in Schlieren ist das Life-Science-Zentrum des Grossraums Zürich. Auf 100.000 m² arbeiten rund 60 Unternehmen und 80 akademische Forschungsgruppen. Containerlabore ergänzen die vorhandene Infrastruktur – für Startups als Erstlabor, für etablierte Firmen als Kapazitätserweiterung.
              </p>
              <p class="text-xs text-gray-400 mt-3">Quelle: Bio-Technopark Zürich-Schlieren</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Section 2: Swissmedic & SIA-Normen -->
    <section class="py-20 bg-slate-900 text-white">
      <div class="container mx-auto px-4">
        <div class="max-w-5xl mx-auto">
          <h2 class="text-3xl md:text-4xl font-heading font-bold mb-6">
            Swissmedic-Konformität und SIA-Normen: Was die Schweiz verlangt
          </h2>
          <p class="text-gray-400 text-lg mb-12 leading-relaxed max-w-3xl">
            Die Schweiz hat eigene regulatorische Anforderungen – von der Swissmedic-Zulassung über SIA-Baunormen bis zur SUVA-Arbeitssicherheit. Unsere Containerlabore sind darauf ausgelegt, diese Standards zu erfüllen.
          </p>

          <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            <div class="bg-white/5 border border-white/10 rounded-xl p-6 hover:border-primary/30 transition-colors">
              <div class="w-12 h-12 bg-primary/15 rounded-xl flex items-center justify-center mb-4">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10"/><path d="m9 12 2 2 4-4"/></svg>
              </div>
              <h3 class="font-bold text-lg mb-3 text-primary">Swissmedic (HMG)</h3>
              <p class="text-gray-300 text-sm leading-relaxed">
                Die Schweizerische Arzneimittelbehörde Swissmedic reguliert Arzneimittel und Medizinprodukte auf Basis des Heilmittelgesetzes (HMG) und der AMBV. Unsere GMP-Container sind so ausgelegt, dass sie die Anforderungen für pharmazeutische Labore erfüllen können – inklusive Dokumentation nach Schweizer Standards.
              </p>
            </div>

            <div class="bg-white/5 border border-white/10 rounded-xl p-6 hover:border-primary/30 transition-colors">
              <div class="w-12 h-12 bg-primary/15 rounded-xl flex items-center justify-center mb-4">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76Z"/></svg>
              </div>
              <h3 class="font-bold text-lg mb-3 text-primary">SIA-Normen</h3>
              <p class="text-gray-300 text-sm leading-relaxed">
                Der Schweizerische Ingenieur- und Architektenverein (SIA) definiert die massgeblichen Baunormen. Unsere Container erfüllen die relevanten SIA-Anforderungen an Tragwerk, Brandschutz und Haustechnik. Die Nachweise liefern wir in der von Schweizer Behörden geforderten Form.
              </p>
            </div>

            <div class="bg-white/5 border border-white/10 rounded-xl p-6 hover:border-primary/30 transition-colors">
              <div class="w-12 h-12 bg-primary/15 rounded-xl flex items-center justify-center mb-4">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
              </div>
              <h3 class="font-bold text-lg mb-3 text-primary">SUVA-Arbeitssicherheit</h3>
              <p class="text-gray-300 text-sm leading-relaxed">
                Die Schweizerische Unfallversicherungsanstalt (SUVA) stellt spezifische Anforderungen an Arbeitssicherheit und Gesundheitsschutz am Arbeitsplatz. Unsere Labore berücksichtigen SUVA-Richtlinien zu Belüftung, Beleuchtung, Notausgängen und Gefahrstoffhandhabung.
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Section 3: Zollabwicklung DE→CH -->
    <section class="py-20 bg-white">
      <div class="container mx-auto px-4">
        <div class="max-w-5xl mx-auto">
          <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
            <div>
              <span class="text-primary text-sm font-bold uppercase tracking-wider">Grenzüberschreitend</span>
              <h2 class="text-3xl font-heading font-bold mt-3 mb-6 text-slate-900">
                Zollabwicklung DE→CH: Wir übernehmen alles
              </h2>
              <p class="text-gray-600 text-lg leading-relaxed mb-6">
                Die Lieferung in die Schweiz erfordert eine saubere Zollabwicklung. Als erfahrener Exporteur kennen wir die Anforderungen des Schweizer Zolls und übernehmen den gesamten Prozess – von der Ausfuhranmeldung in Deutschland bis zur Einfuhrverzollung in der Schweiz.
              </p>

              <div class="space-y-4">
                <div class="bg-slate-50 rounded-lg p-4 border border-gray-100">
                  <h4 class="font-bold text-slate-900 text-sm mb-1">1. Ausfuhranmeldung (DE)</h4>
                  <p class="text-gray-600 text-xs">Elektronische Ausfuhranmeldung beim deutschen Zoll über ATLAS. Warencodierung und Wertangabe.</p>
                </div>
                <div class="bg-slate-50 rounded-lg p-4 border border-gray-100">
                  <h4 class="font-bold text-slate-900 text-sm mb-1">2. T1-Versandverfahren</h4>
                  <p class="text-gray-600 text-xs">Unionsversandverfahren für den Transport durch die Schweizer Grenze. Sicherheitsleistung und Dokumentation.</p>
                </div>
                <div class="bg-slate-50 rounded-lg p-4 border border-gray-100">
                  <h4 class="font-bold text-slate-900 text-sm mb-1">3. Einfuhrverzollung (CH)</h4>
                  <p class="text-gray-600 text-xs">Anmeldung beim Schweizer Zoll. Laborcontainer als Investitionsgut. MWST (8,1%) und ggf. Zollgebühren.</p>
                </div>
                <div class="bg-slate-50 rounded-lg p-4 border border-gray-100">
                  <h4 class="font-bold text-slate-900 text-sm mb-1">4. Alternative: Temporäre Einfuhr</h4>
                  <p class="text-gray-600 text-xs">Für Miet-Container: Carnet ATA für zollfreie temporäre Einfuhr. Ideal bei Projektlaufzeiten unter 24 Monaten.</p>
                </div>
              </div>
            </div>

            <div class="bg-slate-900 rounded-2xl p-8 text-white">
              <h3 class="font-heading font-bold text-lg text-primary mb-6">Albstadt → Zürich</h3>
              <div class="space-y-5">
                <div>
                  <div class="flex justify-between text-sm mb-1"><span class="text-gray-400">Distanz</span><span class="text-white font-bold">~133 km</span></div>
                  <div class="h-2 bg-white/10 rounded-full"><div class="h-2 bg-primary rounded-full" style="width: 20%"></div></div>
                </div>
                <div>
                  <div class="flex justify-between text-sm mb-1"><span class="text-gray-400">Fahrzeit</span><span class="text-white font-bold">~2 Stunden</span></div>
                  <div class="h-2 bg-white/10 rounded-full"><div class="h-2 bg-primary rounded-full" style="width: 20%"></div></div>
                </div>
                <div>
                  <div class="flex justify-between text-sm mb-1"><span class="text-gray-400">Grenze</span><span class="text-white font-bold">Singen – Schaffhausen</span></div>
                </div>
                <div class="border-t border-white/10 pt-4">
                  <p class="text-gray-400 text-sm leading-relaxed">
