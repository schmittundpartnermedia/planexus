      <div class="absolute inset-0">
        <img src="/attached_assets/Laborcontainer_001_1769688326918.jpg" alt="Laborcontainer Stuttgart – Planexus LABtoGO 2.0 mit 2,75 m Innenhöhe für Forschung und Industrie in Vaihingen, Feuerbach und Untertürkheim" class="w-full h-full object-cover opacity-20" loading="eager" />
      </div>
      <div class="absolute inset-0 bg-gradient-to-r from-slate-900 via-slate-900/95 to-slate-900/70"></div>

      <div class="container mx-auto px-4 relative z-10">
        <div class="max-w-3xl">
          <nav class="flex items-center gap-2 text-sm text-gray-400 mb-8" aria-label="Breadcrumb">
            <a href="/" class="hover:text-primary transition-colors">Start</a>
