---
import Layout from '../layouts/Layout.astro';
import ContactForm from '../components/ContactForm.tsx';

const stuttgartPLZ = [
  "70173","70174","70176","70178","70180","70182","70184","70186","70188","70190",
  "70191","70192","70193","70195","70197","70199","70327","70329","70372","70374",
  "70376","70378","70435","70437","70439","70469","70499","70563","70565","70567",
  "70569","70597","70599","70619","70629","70771","70794","71229","71254","71263",
  "71272","71277","71282","71287","71292","71299","71384"
];

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": "Laborcontainer Stuttgart – BSL-3, GMP-Reinraum & Präzisionsanalytik",
  "description": "Schlüsselfertige Laborcontainer für Stuttgart und die Region Mittlerer Neckar, abgestimmt auf die Talkessel-Klimalage, die Landesbauordnung Baden-Württemberg sowie die typischen Anforderungen der Stuttgarter Automobilindustrie, der Werkstofflabore, der Klinikbetriebe und des Universitätscampus Vaihingen. Lieferung über A81 in unter 1,5 Stunden ab Werk Albstadt.",
  "provider": {
    "@type": "Organization",
    "name": "Planexus GmbH",
    "url": "https://www.planexus.de",
    "parentOrganization": { "@type": "Organization", "name": "Wesemann Holding GmbH" }
  },
  "serviceType": ["Laborcontainer", "BSL-2 Containerlabor", "BSL-3 Containerlabor", "GMP-Reinraumlabor", "Analytiklabor Container", "ATEX-Container", "Mobile Labore", "Modulbau Labor", "EX-Schutz Labor"],
  "areaServed": [
    { "@type": "City", "name": "Stuttgart", "containedInPlace": { "@type": "State", "name": "Baden-Württemberg" } },
    { "@type": "State", "name": "Baden-Württemberg" },
    { "@type": "AdministrativeArea", "name": "Region Stuttgart" },
    ...stuttgartPLZ.map(plz => ({ "@type": "PostalCodeSpecification", "postalCode": plz, "addressCountry": "DE" }))
  ],
  "url": "https://www.planexus.de/laborcontainer-stuttgart"
};

const localBusinessSchema = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "@id": "https://www.planexus.de/laborcontainer-stuttgart#business",
  "name": "Planexus GmbH – Laborcontainer Stuttgart",
  "description": "Hersteller schlüsselfertiger Laborcontainer für Stuttgart und Baden-Württemberg. Talkessel-tauglich, LBO-konform, GMP- und BSL-3-zertifizierbar. 80 km vom Werk Albstadt – same-day Lieferung möglich.",
  "url": "https://www.planexus.de/laborcontainer-stuttgart",
  "telephone": "+49 7435 7519 700",
  "email": "info@planexus.de",
  "image": "https://www.planexus.de/attached_assets/Laborcontainer_001_1769688326918.jpg",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "Am Steinbach 8",
    "addressLocality": "Albstadt",
    "postalCode": "72459",
    "addressRegion": "Baden-Württemberg",
    "addressCountry": "DE"
  },
  "areaServed": {
    "@type": "City",
    "name": "Stuttgart",
    "containedInPlace": [
      { "@type": "AdministrativeArea", "name": "Stuttgart-Mitte" },
      { "@type": "AdministrativeArea", "name": "Stuttgart-Vaihingen" },
      { "@type": "AdministrativeArea", "name": "Stuttgart-Feuerbach" },
      { "@type": "AdministrativeArea", "name": "Stuttgart-Zuffenhausen" },
      { "@type": "AdministrativeArea", "name": "Stuttgart-Untertürkheim" },
      { "@type": "AdministrativeArea", "name": "Stuttgart-Möhringen" },
      { "@type": "AdministrativeArea", "name": "Stuttgart-Bad Cannstatt" },
      { "@type": "AdministrativeArea", "name": "Stuttgart-Hohenheim" }
    ]
  },
  "parentOrganization": { "@type": "Organization", "name": "Wesemann Holding GmbH" }
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Start", "item": "https://www.planexus.de/" },
    { "@type": "ListItem", "position": 2, "name": "Standorte", "item": "https://www.planexus.de/#standorte" },
    { "@type": "ListItem", "position": 3, "name": "Laborcontainer Stuttgart", "item": "https://www.planexus.de/laborcontainer-stuttgart" }
  ]
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Was kostet ein Laborcontainer in Stuttgart?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Die Investition richtet sich nach Sicherheitsstufe, Reinraumklasse und Spezialausstattung. Ein Analytikcontainer für die der Universitätscampus Vaihingen liegt in einer anderen Größenordnung als ein BSL-3-Container für ein Klinikprojekt oder ein ATEX-Container für Lithium-Ion-Batterieforschung bei die Untertürkheimer Werks- und Werkstofflabore oder die Sportwagen-Industrie in Zuffenhausen. Wir kalkulieren projektspezifisch – inklusive F9-Feinstaub-Vorfilterung für die Stuttgarter Talkessellage und LBO-konformer Statik. Senden Sie uns Ihre Standortdaten, wir melden uns binnen 24 Stunden mit einer indikativen Spanne."
      }
    },
    {
      "@type": "Question",
      "name": "Welche Bauauflagen gelten für Laborcontainer in Stuttgart?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Maßgebend ist die Landesbauordnung Baden-Württemberg (LBO BW). Anders als in Hamburg oder Berlin hat Stuttgart kein dezentrales Bezirksamt-System – zuständig ist zentral das Baurechtsamt der Stadt Stuttgart in der Eberhardstraße 33. Nach §50 LBO BW sind kleinere Container nach Anlage zu §50 LBO BW unter Umständen verfahrensfrei, größere Anlagen erfordern ein Kenntnisgabeverfahren oder eine Baugenehmigung. Wir bereiten alle Bauvorlagen verfahrenstauglich auf und stimmen vorab mit dem Baurechtsamt ab."
      }
    },
    {
      "@type": "Question",
      "name": "Ist die Stuttgarter Umweltzone für den Containertransport relevant?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Die Stuttgarter Umweltzone umfasst nahezu das gesamte Stadtgebiet und verlangt grüne Feinstaub-Plakette. Unsere Schwerlast-Zugmaschinen erfüllen Euro 6 und sind mit grüner Plakette ausgestattet – die Anlieferung in Stuttgart-Mitte, Vaihingen, Feuerbach oder Bad Cannstatt ist uneingeschränkt möglich. Bei besonders sensiblen Standorten wie Klinikgeländen koordinieren wir die Anlieferung über das städtische Verkehrsmanagement."
      }
    },
    {
      "@type": "Question",
      "name": "Wie lange dauert die Lieferung von Albstadt nach Stuttgart?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Die Strecke vom Werk Albstadt nach Stuttgart-Mitte beträgt rund 80 km – komplett über die A81 nordwärts via Anschlussstelle Empfingen. Reine Fahrzeit ca. 1,5 Stunden mit Schwerlasttransport. Same-Day-Lieferung ist für Standardcontainer möglich – ein massiver Vorteil gegenüber Mitbewerbern aus Norddeutschland. Werkbesichtigungen vor Auslieferung sind für Stuttgarter Kunden in unter zwei Stunden Anreise machbar."
      }
    },
    {
      "@type": "Question",
      "name": "Können Sie BSL-3-Container für die die Stuttgarter Hochschullandschaft in Vaihingen aufstellen?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Ja. Aufstellungen auf dem Universitäts-Campus Vaihingen koordinieren wir über das Universitätsbauamt und das Land Baden-Württemberg (Vermögen und Bau BW Stuttgart). Für BSL-3 fordern wir und der Verordnungsgeber: Unterdruckkaskade min. -50 Pa, HEPA-H14-Filter im Abluftstrang, autoklavierte Schleusen nach BioStoffV und TRBA 100. Genehmigungs- und Anzeigepflichten laufen über das Regierungspräsidium Stuttgart (für gentechnische Anlagen nach GenTG) sowie die zuständige Arbeitsschutzbehörde (BioStoffV). Wir liefern komplett zertifiziert mit IQ/OQ/PQ-Dokumentation."
      }
    },
    {
      "@type": "Question",
      "name": "Wie schützt Ihr Containerlabor Messgeräte vor Stuttgarter Feinstaub-Belastung?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Die Stuttgarter Talkessellage erzeugt regelmäßig Inversionswetterlagen, in denen die PM10-Feinstaubwerte am Neckartor und in der Innenstadt 50 µg/m³ erreichen können. Wir bauen die HVAC-Frischluftansaugung mit zusätzlicher F9-Vorfilterung nach EN 779 ein – das schützt empfindliche Spektrometer, Mikroskope und Analysegeräte. Für GMP-Reinräume kombinieren wir F9 mit nachgeschalteter HEPA-H14, sodass die Reinraumklasse ISO 14644-1 Klasse 5 unabhängig von der Außenluftbelastung gehalten wird."
      }
    },
    {
      "@type": "Question",
      "name": "EX-Schutz für Automobilindustrie- und Sportwagen-Hersteller-Batterieforschung in Stuttgart – machbar?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Ja. Die Lithium-Ionen-Forschung bei die Untertürkheimer Werks- und Werkstofflabore, die Sportwagen-Industrie in Zuffenhausen und Industriebetrieben in Feuerbach erfordert ATEX-konforme Container der Zone-1- oder Zone-2-Klassifizierung. Wir bauen explosionsgeschützte Lüftung, EX-Beleuchtung nach IECEx, leitfähige Bodenbeläge gegen elektrostatische Aufladung sowie redundante Gas-Sensorik mit Notabschaltung. Dokumentation erfolgt nach ATEX-Richtlinie 2014/34/EU und BetrSichV. Ideal für Werks-Forschungslabore an Stuttgarts automotive Standorten."
      }
    },
    {
      "@type": "Question",
      "name": "Mieten oder kaufen für ein Stuttgart-21-Interimsprojekt?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Faustregel: Bei Projektlaufzeiten unter 24 Monaten – etwa Interimslabore während Bauphasen rund um städtische Großbauprojekte, befristete Forschungsprojekte am außeruniversitäre Forschung in Vaihingen oder Übergangslösungen während Klinikum-Sanierungen am Stuttgarter Klinikbetriebe – rechnet sich Miete. Bei dauerhafter Erweiterung am Industriestandorte in Feuerbach, Universitäts-Campus Vaihingen oder Hohenheim überwiegt der Kauf, oft mit Mietkauf-Option. Wir vergleichen für Ihr Stuttgarter Projekt beide Modelle inklusive Bilanzwirkung und Restwert."
      }
    }
  ]
};
---

<Layout
  title="Laborcontainer Stuttgart | BSL-3, GMP & ATEX in 12 Wochen"
  description="Laborcontainer für Stuttgart: BSL-3, GMP & ATEX-Reinraum für Automotive-Industrie, Werkstofflabore und Universitätscampus. 80 km Werk-Distanz via A81. Jetzt anfragen."
  canonical="/laborcontainer-stuttgart"
  schema={serviceSchema}
  ogImage="/attached_assets/Laborcontainer_001_1769688326918.jpg"
>
  <script type="application/ld+json" set:html={JSON.stringify(localBusinessSchema)} slot="head" />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} slot="head" />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} slot="head" />

  <div class="pt-20 min-h-screen bg-white">

    <!-- HERO -->
    <section class="relative py-24 md:py-32 bg-slate-900 text-white overflow-hidden">
      <div class="absolute inset-0">
        <img src="/attached_assets/Laborcontainer_001_1769688326918.jpg" alt="Laborcontainer Stuttgart Vaihingen – Planexus GmbH, BSL-3 und GMP-Reinraum-Container für Industriebetriebe in Feuerbach, Sportwagen-Hersteller und Universität" class="w-full h-full object-cover opacity-20" loading="eager" />
      </div>
      <div class="absolute inset-0 bg-gradient-to-r from-slate-900 via-slate-900/95 to-slate-900/70"></div>

      <div class="container mx-auto px-4 relative z-10">
        <div class="max-w-3xl">
          <nav class="flex items-center gap-2 text-sm text-gray-400 mb-8" aria-label="Breadcrumb">
            <a href="/" class="hover:text-primary transition-colors">Start</a>
            <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m9 18 6-6-6-6"/></svg>
            <span>Standorte</span>
            <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m9 18 6-6-6-6"/></svg>
            <span class="text-primary">Stuttgart</span>
          </nav>

          <h1 class="text-4xl md:text-5xl lg:text-6xl font-heading font-bold mb-6 leading-tight">
            Laborcontainer Stuttgart <span class="text-primary">|</span> BSL-3, GMP & ATEX für Industrie und Forschung am Mittleren Neckar
          </h1>
          <p class="text-xl text-gray-300 leading-relaxed mb-8">
            Schlüsselfertige Containerlabore für Stuttgarts Industrie- und Forschungslandschaft. Talkessel-tauglich mit F9-Feinstaub-Vorfilterung, LBO-Baden-Württemberg-konform, geliefert in unter 1,5 Stunden über die A81 ab Werk Albstadt – nur 80 km entfernt.
          </p>

          <div class="flex flex-col sm:flex-row gap-4 mb-8">
            <a href="#anfrage" class="bg-primary text-slate-900 font-bold px-8 py-4 rounded-lg hover:bg-primary/90 transition-colors inline-flex items-center justify-center gap-2 shadow-[0_0_20px_rgba(132,189,0,0.3)]">
              Stuttgarter Projekt anfragen
              <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
            </a>
            <a href="tel:+4974357519700" class="border border-white/20 text-white font-medium px-8 py-4 rounded-lg hover:bg-white/10 transition-colors inline-flex items-center justify-center gap-2">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
              +49 7435 7519 700
            </a>
          </div>

          <div class="flex flex-wrap items-center gap-6 text-sm text-gray-400">
            <div class="flex items-center gap-2">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10"/><path d="m9 12 2 2 4-4"/></svg>
              80 km Werk-Distanz – Same-Day-Lieferung
            </div>
            <div class="flex items-center gap-2">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10"/><path d="m9 12 2 2 4-4"/></svg>
              ATEX & EX-Schutz für Batterieforschung
            </div>
            <div class="flex items-center gap-2">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10"/><path d="m9 12 2 2 4-4"/></svg>
              §50 LBO BW + Umweltzone-zertifiziert
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- PROBLEM-AGITATION -->
    <section class="py-16 md:py-20">
      <div class="container mx-auto px-4">
        <div class="max-w-4xl mx-auto">
          <h2 class="text-3xl md:text-4xl font-heading font-bold mb-8 text-slate-900">
            Laborcontainer in Stuttgart: 3 Hürden, an denen Industrie- und Forschungsprojekte regelmäßig hängenbleiben
          </h2>
          <div class="grid md:grid-cols-3 gap-6 mb-10">
            <div class="bg-red-50 border border-red-100 rounded-xl p-6">
              <div class="text-red-600 font-bold text-lg mb-2">Talkessel-Feinstaub zerstört Messgeräte</div>
              <p class="text-gray-600 text-sm">Stuttgarts Talkessellage erzeugt regelmäßig Inversionswetterlagen mit Feinstaubwerten bis 50 µg/m³ am Neckartor. Spektrometer, Mikroskope und Analysegeräte verlieren ihre Präzision innerhalb von Monaten – wer ohne F9-Vorfilterung baut, baut für die Tonne.</p>
            </div>
            <div class="bg-red-50 border border-red-100 rounded-xl p-6">
              <div class="text-red-600 font-bold text-lg mb-2">Industrieflächen am Limit</div>
              <p class="text-gray-600 text-sm">Auf den Werksgeländen von die Untertürkheimer Werks- und Werkstofflabore, die Sportwagen-Industrie in Zuffenhausen und Industriebetrieben in Feuerbach zählt jeder Quadratmeter. Universitäre Erweiterung am Campus Vaihingen oder am außeruniversitäre Forschung in Vaihingen scheitert an knappen Bauflächen. Massivbau bindet Areale für Jahrzehnte.</p>
            </div>
            <div class="bg-red-50 border border-red-100 rounded-xl p-6">
              <div class="text-red-600 font-bold text-lg mb-2">städtische Großbauprojekte verschiebt alle Pläne</div>
              <p class="text-gray-600 text-sm">Bauphasen rund um städtische Großbauprojekte zwingen viele Forschungs- und Klinikprojekte zu Interimslösungen. Klassischer Massivbau dauert in Baden-Württemberg vom Bauantrag bis zum Schlüssel typischerweise 18 bis 30 Monate. Das ist Lichtjahre zu lang.</p>
            </div>
          </div>

          <div class="bg-slate-900 text-white rounded-2xl p-8 md:p-10">
            <div class="flex items-start gap-4">
              <div class="w-12 h-12 bg-primary rounded-lg flex items-center justify-center shrink-0">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-slate-900" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10"/><path d="m9 12 2 2 4-4"/></svg>
              </div>
              <div>
                <div class="text-xl font-bold mb-2">Die Antwort: Containerlabore, gebaut für Stuttgart</div>
                <p class="text-gray-300">Planexus liefert Laborcontainer, deren Engineering die Stuttgarter Talkessel-Realität einrechnet – F9-Feinstaub-Vorfilterung gegen Inversionswetterlagen, ATEX-Schutz für Automobilindustrie-/Sportwagen-Hersteller-Batterieforschung, ISO-14644-Reinräume nach Sensorik-Produktion-Standard, vibrationsentkoppelte Messlabore für die Stuttgarter Hochschullandschaft und außeruniversitäre Forschung in Vaihingen. Schlüsselfertig in 8 bis 12 Wochen, geliefert in unter 1,5 Stunden über die A81.</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- STRATEGISCHE FUSION INTRO -->
    <section class="py-16 md:py-20 bg-slate-50 border-y border-gray-100">
      <div class="container mx-auto px-4">
        <div class="max-w-4xl mx-auto">
          <h2 class="text-3xl md:text-4xl font-heading font-bold mb-6 text-slate-900">
            Warum ein Laborcontainer in Stuttgart anders gebaut werden muss als in Hamburg oder Berlin
          </h2>
          <div class="space-y-4 text-gray-700 text-lg leading-relaxed">
            <p>Die Region Stuttgart ist Deutschlands dichtester Cluster für Automotive, Präzisionsmechanik und Werkstoffforschung – mit <strong>Stuttgarter Automobilindustrie, Sportwagen-Hersteller, Industriebetriebe in Feuerbach, Filterindustrie und Lasertechnik-Industrie</strong> auf engstem Raum, ergänzt um die die Stuttgarter Hochschullandschaft in Vaihingen, das außeruniversitäre Forschung in Vaihingen, die die agrarwissenschaftliche Hochschule in Hohenheim und das Festkörperforschungsinstitute in Vaihingen. Wer hier Containerlabore plant, baut nicht für Pharma-Großkonzerne wie in Hamburg, sondern für Werkstoffanalytik, Sensorik-Reinräume und Batterieforschung der Elektromobilität.</p>
            <p>Aufgrund der Stuttgarter Talkessellage mit ihrer charakteristischen Inversionswetterlage und Feinstaubspitzen bis 50 µg/m³ dimensionieren wir die HVAC-Frischluftansaugung jedes Containers mit <strong>F9-Vorfilterung nach EN 779</strong>. Aufgrund der automotive-getriebenen Forschung an Lithium-Ionen-Batterien bei die Untertürkheimer Werks- und Werkstofflabore und die Sportwagen-Industrie in Zuffenhausen liefern wir <strong>ATEX-Container in Zone-1-Konfiguration</strong> mit explosionsgeschützter Lüftung. Aufgrund der Werks-Distanz von nur 80 km über die A81 ist <strong>Same-Day-Lieferung in das gesamte Stadtgebiet</strong> möglich – ein Logistikvorteil, den kein norddeutscher Wettbewerber bieten kann.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- 3x2 TECHNICAL DEPTH MATRIX -->
    <section class="py-16 md:py-20">
      <div class="container mx-auto px-4">
        <div class="max-w-6xl mx-auto">
          <h2 class="text-3xl md:text-4xl font-heading font-bold mb-4 text-slate-900">
            Laborcontainer Stuttgart: 6 Engineering-Disziplinen für die Region Mittlerer Neckar
          </h2>
          <p class="text-gray-600 text-lg mb-12">Jede Disziplin lösen wir mit einer konkreten technischen Antwort, abgestimmt auf einen real existierenden Stuttgarter Industrie- oder Forschungsstandort.</p>

          <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
            <div class="bg-white border border-gray-100 rounded-xl p-6 hover:shadow-xl hover:border-primary/30 transition-all">
              <div class="text-xs font-bold text-[#7a9900] uppercase tracking-wider mb-2">01 · Feinstaubschutz</div>
              <h3 class="font-bold text-slate-900 text-lg mb-2">F9-Vorfilterung nach EN 779</h3>
              <p class="text-gray-600 text-sm mb-3">Mehrstufige Filterkaskade in der Außenluftansaugung, Differenzdrucküberwachung, automatische Filterstandsmeldung.</p>
              <p class="text-xs text-gray-500"><strong class="text-slate-900">Stuttgart-Bezug:</strong> Talkessel-Inversion am Neckartor – PM10 bis 50 µg/m³ ohne Filterung zerstören Spektrometer.</p>
            </div>

            <div class="bg-white border border-gray-100 rounded-xl p-6 hover:shadow-xl hover:border-primary/30 transition-all">
              <div class="text-xs font-bold text-[#7a9900] uppercase tracking-wider mb-2">02 · EX-Schutz</div>
              <h3 class="font-bold text-slate-900 text-lg mb-2">ATEX Zone 1 nach 2014/34/EU</h3>
              <p class="text-gray-600 text-sm mb-3">Explosionsgeschützte Lüftung, EX-Beleuchtung IECEx, leitfähige Bodenbeläge, redundante Gas-Sensorik mit Notabschaltung.</p>
              <p class="text-xs text-gray-500"><strong class="text-slate-900">Stuttgart-Bezug:</strong> Lithium-Ionen-Forschung die Untertürkheimer Werks- und Werkstofflabore, die Sportwagen-Industrie in Zuffenhausen, Industriebetrieben in Feuerbach.</p>
