const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Start", "item": "https://www.planexus.de/" },
    { "@type": "ListItem", "position": 2, "name": "Standorte", "item": "https://www.planexus.de/#standorte" },
    { "@type": "ListItem", "position": 3, "name": "Laborcontainer Stuttgart", "item": "https://www.planexus.de/laborcontainer-stuttgart" }
  ]
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Wie schnell liefert Planexus einen Laborcontainer nach Stuttgart?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Vom Werk Albstadt sind es nur 80 km über die A81 bis ans Stuttgarter Kreuz – Schwerlast-Fahrzeit unter 1,5 Stunden. Standardcontainer unter 4 m Breite und 18 t Gewicht liefern wir Same-Day. Die Fertigung eines konfigurierten LABtoGO 2.0 oder einer BSL-2-Variante dauert typischerweise 8 bis 14 Wochen ab Auftrag. Damit sind wir gegenüber norddeutschen oder hessischen Anbietern strukturell vier bis sechs Wochen schneller."
      }
    },
    {
      "@type": "Question",
      "name": "Was kostet ein Laborcontainer von Planexus für Stuttgart?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Wir nennen keine Standardpreise. Jedes Stuttgarter Projekt wird individuell bewertet, da Sicherheitsstufe (S2/S3, ATEX, GMP), Reinraumklasse, Spezialausstattung, Laufzeit und Standortgegebenheiten die Kalkulation maßgeblich bestimmen. Ein BSL-3-Container für die Stuttgarter Hochschullandschaft hat eine völlig andere Investitionsstruktur als ein analytischer Werkstoff-Container für die Filderebene. Kontaktieren Sie uns für eine kostenlose, unverbindliche projektspezifische Bewertung – wir liefern eine schriftliche Indikation typischerweise binnen 24 Stunden."
      }
    },
    {
      "@type": "Question",
      "name": "Welche Genehmigungen brauche ich für ein Containerlabor in Stuttgart?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Maßgebend ist die Landesbauordnung Baden-Württemberg. Anders als in Hamburg oder Berlin hat Stuttgart kein dezentrales Bezirksamt-System – zuständig ist zentral das Baurechtsamt der Stadt Stuttgart. Nach §50 LBO BW sind kleinere Container unter Umständen verfahrensfrei, größere Anlagen erfordern ein Kenntnisgabeverfahren oder eine Baugenehmigung. Für gentechnische Anlagen ist zusätzlich eine Anzeige beim Regierungspräsidium Stuttgart nach GenTG erforderlich. Wir bereiten alle Bauvorlagen verfahrenstauglich auf."
      }
    },
    {
      "@type": "Question",
      "name": "Baut Planexus auch BSL-3 für Stuttgarter Forschungseinrichtungen?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Ja. Für BSL-3-Container liefern wir Unterdruckkaskade ab -50 Pa, HEPA-H14 im Abluftstrang, autoklavierte Schleusen, redundante HVAC und vollständige IQ/OQ/PQ-Dokumentation nach BioStoffV und TRBA 100. Aufstellungen am Universitäts-Campus Vaihingen oder an Klinikstandorten der Region Mittlerer Neckar koordinieren wir mit dem Universitätsbauamt, dem Land Baden-Württemberg (Vermögen und Bau BW Stuttgart) und dem Regierungspräsidium Stuttgart."
      }
    },
    {
      "@type": "Question",
      "name": "Was unterscheidet den LABtoGO 2.0 von einem normalen Laborcontainer?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Der LABtoGO 2.0 ist 9.500 mm lang, 3.000 mm breit und hat 2.750 mm lichte Innenhöhe – 350 mm mehr als ein konventioneller Containerstandard von 2.400 mm. Mit der vollverglasten Front kommt echtes Tageslicht in das Labor. Die Sandwichpanel-Hülle erreicht U-Werte um 0,20 W/m²K. In Kurzform: Ein gewöhnlicher Laborcontainer passt komplett in einen LABtoGO hinein. Wir nennen ihn nicht ohne Grund Laborcontainer 2.0 – er bildet die Plattform, auf der wir BSL-2, GMP, ATEX und Reinraum konfigurieren."
      }
    },
    {
      "@type": "Question",
      "name": "Liefert Planexus auch ATEX-Container für die Stuttgarter Antriebs- und Werkstoffforschung?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Ja. Lithium-Ionen-Forschung in Untertürkheim, Antriebs- und Werkstoffanalytik in Zuffenhausen und Industrieprüfungen in Feuerbach erfordern ATEX-konforme Container der Zone 1 oder Zone 2. Wir bauen explosionsgeschützte Lüftung, EX-Beleuchtung nach IECEx, leitfähige Bodenbeläge gegen elektrostatische Aufladung sowie redundante Gas-Sensorik mit Notabschaltung. Dokumentation nach ATEX-Richtlinie 2014/34/EU und BetrSichV ist Standard im Liefer­umfang."
      }
    },
    {
      "@type": "Question",
      "name": "Mieten oder kaufen für ein Stuttgarter Projekt?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Faustregel: Bei Projektlaufzeiten unter 24 Monaten – etwa Interimslabore während Klinik-Sanierungen, befristete Drittmittel-Projekte am Campus Vaihingen oder Übergangslösungen in Bauphasen rund um städtische Großbauprojekte – rechnet sich Miete. Bei dauerhafter Erweiterung in Industriestandorten Feuerbach, an Universitäts-Campussen Vaihingen oder Hohenheim überwiegt der Kauf, oft mit Mietkauf-Option. Wir vergleichen für Ihr Stuttgarter Projekt beide Modelle inklusive Bilanzwirkung und Restwert."
      }
    },
    {
      "@type": "Question",
      "name": "Was leistet die Wesemann-Gruppe zusätzlich zum Container?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Planexus ist Teil der Wesemann Holding GmbH, einem Konzernverbund mit über 60 Jahren Erfahrung in Laboreinrichtung. Das bedeutet für Stuttgarter Kunden: Container, Labormöbel und Reinraumtechnik aus einer Hand – ohne Schnittstellen, ohne Zuständigkeitslücken. Abzüge nach DIN EN 14175, säurefeste Arbeitsplatten, Sicherheitsschränke nach DIN EN 14470-1, Reinraum-Komponenten – alles aus dem eigenen Konzern. Ein Ansprechpartner von der Planung bis zur Inbetriebnahme."
      }
    }
  ]
};
---

<Layout
  title="Laborcontainer Stuttgart | 2,75 m Innenhöhe, BSL-2 & GMP | Planexus"
  description="Planexus baut Laborcontainer für Stuttgart – LABtoGO 2.0 mit 2,75 m Innenhöhe, BSL-2/3, GMP, ATEX. 80 km vom Werk Albstadt, Lieferung in 1,5 h. Kostenfreies Standort-Audit."
  canonical="/laborcontainer-stuttgart"
  schema={serviceSchema}
  ogImage="/attached_assets/Laborcontainer_001_1769688326918.jpg"
>
  <script type="application/ld+json" set:html={JSON.stringify(localBusinessSchema)} slot="head" />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} slot="head" />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} slot="head" />

  <div class="pt-20 min-h-screen bg-white">

    <!-- STICKY SIDE-CTA (desktop only) -->
