---
import Layout from '../layouts/Layout.astro';
import ContactForm from '../components/ContactForm.tsx';

const stuttgartPLZ = [
  "70173","70174","70176","70178","70180","70182","70184","70186","70188","70190",
  "70191","70192","70193","70195","70197","70199","70327","70329","70372","70374",
  "70376","70378","70435","70437","70439","70469","70499","70563","70565","70567",
  "70569","70597","70599","70619","70629","70771","70794","71229","71254","71263",
  "71272","71277","71282","71287","71292","71299","71384"
];

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": "Laborcontainer Stuttgart – LABtoGO 2.0, BSL-2/3, GMP-Reinraum & ATEX",
  "description": "Schlüsselfertige Laborcontainer für Stuttgart und die Region Mittlerer Neckar. LABtoGO 2.0 mit 2.750 mm Innenhöhe, BSL-2/3, GMP-Reinraum und ATEX-Konfigurationen. Lieferung in 1,5 Stunden über die A81 ab Werk Albstadt – nur 80 km entfernt. Pioniere im modularen Laborbau seit 2016, ausgezeichnet bei den German CEO Excellence Awards 2026.",
  "provider": {
    "@type": "Organization",
    "name": "Planexus GmbH",
    "url": "https://www.planexus.de",
    "parentOrganization": { "@type": "Organization", "name": "Wesemann Holding GmbH" }
  },
  "serviceType": [
    "Laborcontainer Stuttgart",
    "Containerlabor Stuttgart",
    "Mobiles Labor Stuttgart",
    "BSL-2 Containerlabor",
    "BSL-3 Containerlabor",
    "GMP-Reinraumlabor",
    "ATEX-Container",
    "Modulbau Labor",
    "Technische Fachplanung Labor",
    "Laborausstattung",
    "Smart Lab Integration"
  ],
  "areaServed": [
    { "@type": "City", "name": "Stuttgart", "containedInPlace": { "@type": "State", "name": "Baden-Württemberg" } },
    { "@type": "State", "name": "Baden-Württemberg" },
    { "@type": "AdministrativeArea", "name": "Region Stuttgart" },
