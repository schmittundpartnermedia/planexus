---
import Layout from '../layouts/Layout.astro';

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": "Laborcontainer Stuttgart",
  "description": "Laborcontainer für Stuttgart und Baden-Württemberg: Planung, Fertigung und schlüsselfertige Übergabe. BSL-2/BSL-3 Container, mobile Forschungslabore und Reinraumlösungen.",
  "provider": {
    "@type": "Organization",
    "name": "Planexus GmbH",
    "url": "https://www.planexus.de"
  },
  "areaServed": [
    { "@type": "City", "name": "Stuttgart" },
    { "@type": "State", "name": "Baden-Württemberg" }
  ],
  "url": "https://www.planexus.de/laborcontainer-stuttgart"
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Start", "item": "https://www.planexus.de/" },
    { "@type": "ListItem", "position": 2, "name": "Laborcontainer Stuttgart", "item": "https://www.planexus.de/laborcontainer-stuttgart" }
  ]
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Was kostet ein Laborcontainer in Stuttgart?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Das hängt stark von Größe, Ausstattung und Sicherheitsstufe ab. Ein einfaches Analyselabor liegt in einem anderen Bereich als ein BSL-2-Containerlabor mit Schleusensystem. Am besten sprechen wir kurz über Ihr Projekt – dann können wir eine realistische Größenordnung nennen."
      }
    },
    {
      "@type": "Question",
      "name": "Wie wird ein Laborcontainer nach Stuttgart geliefert?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Per Tieflader direkt auf Ihr Gelände. Die Aufstellung erfolgt per Kran. Wir kümmern uns um Transportgenehmigungen, Kranstellplatz und die gesamte Logistik."
      }
    },
    {
      "@type": "Question",
      "name": "Kann ein Laborcontainer dauerhaft genutzt werden?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Ja. Unsere Container sind keine provisorischen Lösungen, sondern vollwertige Laborräume. Viele unserer Container sind seit Jahren im Dauerbetrieb."
      }
    },
    {
      "@type": "Question",
      "name": "Brauche ich eine Baugenehmigung für einen Laborcontainer in Stuttgart?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "In vielen Fällen nicht. Laborcontainer gelten als temporäre bauliche Anlagen und fallen oft unter Verfahrensfreiheit. Das hängt vom Standort und der geplanten Nutzungsdauer ab – wir klären das gemeinsam mit Ihnen und den zuständigen Behörden."
      }
    },
    {
      "@type": "Question",
      "name": "Liefert Planexus nur nach Stuttgart oder auch in die Region?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Wir liefern in ganz Baden-Württemberg und bundesweit. Neben Stuttgart bedienen wir unter anderem Tübingen, Reutlingen, Heilbronn, Karlsruhe und die gesamte Region."
      }
    },
    {
      "@type": "Question",
      "name": "Was unterscheidet einen Laborcontainer von einem normalen Container?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Alles. Ein Laborcontainer ist von Grund auf für den Laborbetrieb konstruiert – mit kontrollierter Belüftung, Medienversorgung, normgerechten Oberflächen und auf Wunsch Sicherheitstechnik bis BSL-3."
      }
    }
  ]
};

const localBusinessSchema = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "name": "Planexus GmbH",
  "description": "Laborcontainer für Stuttgart und Baden-Württemberg",
  "url": "https://www.planexus.de",
  "telephone": "+49 7435 7519 700",
  "email": "info@planexus.de",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "Am Steinbach 8",
    "addressLocality": "Albstadt",
    "postalCode": "72459",
    "addressCountry": "DE"
  },
  "areaServed": [
    { "@type": "City", "name": "Stuttgart" },
    { "@type": "State", "name": "Baden-Württemberg" }
  ]
};
---

<Layout
  title="Containerlabore Stuttgart – Automotive & Engineering | Planexus GmbH"
  description="Laborcontainer für Stuttgart: Automotive-Analytik, Werkstoffprüfung, Uni-Forschung. BSL-2, Reinräume. Direkt aus dem Werk in Albstadt."
  canonical="/laborcontainer-stuttgart"
  schema={serviceSchema}
  ogImage="/attached_assets/Kopf_green-scaled_1768306688943.jpg"
>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} slot="head" />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} slot="head" />
  <script type="application/ld+json" set:html={JSON.stringify(localBusinessSchema)} slot="head" />

  <div class="pt-20 min-h-screen bg-white">

    <!-- Hero -->
    <section class="relative py-28 bg-slate-900 text-white overflow-hidden">
      <div class="absolute inset-0 bg-[url('https://images.unsplash.com/photo-1533929736562-6fcb87000283?q=80&w=2070')] bg-cover bg-center opacity-15"></div>
      <div class="absolute inset-0 bg-gradient-to-r from-slate-900 via-slate-900/95 to-slate-900/80"></div>

      <div class="container mx-auto px-4 relative z-10">
        <div class="max-w-4xl">
          <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-primary text-slate-900 font-medium text-sm mb-6">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
            <span>Stuttgart & Baden-Württemberg</span>
          </div>
          <h1 class="text-4xl md:text-6xl font-heading font-bold mb-6 leading-tight">
            Laborcontainer in <span class="text-primary">Stuttgart</span> und Baden-Württemberg
          </h1>
          <p class="text-xl text-gray-300 leading-relaxed max-w-3xl mb-8">
            Planung, Fertigung und Aufstellung aus einer Hand. Unser Werk in Albstadt liegt keine Stunde entfernt.
          </p>
          <div class="flex flex-col sm:flex-row gap-4">
            <a href="/kontakt" class="bg-primary text-slate-900 font-bold px-8 py-4 rounded-lg hover:bg-primary/90 transition-colors inline-flex items-center gap-2 shadow-[0_0_20px_rgba(132,189,0,0.3)]">
              Projekt besprechen <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
            </a>
            <a href="tel:+4974357519700" class="border border-white/20 text-white font-medium px-8 py-4 rounded-lg hover:bg-white/10 transition-colors inline-flex items-center gap-2">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg> +49 7435 7519 700
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- Breadcrumb -->
    <div class="bg-slate-50 border-b border-gray-100 py-4">
      <div class="container mx-auto px-4">
        <div class="flex items-center gap-2 text-sm text-gray-500">
          <a href="/" class="hover:text-primary">Start</a>
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
          <span class="text-primary font-medium">Laborcontainer Stuttgart</span>
        </div>
      </div>
    </div>

    <!-- Einleitung -->
    <section class="py-20">
      <div class="container mx-auto px-4">
        <div class="max-w-4xl mx-auto">
          <h2 class="text-3xl font-heading font-bold mb-8 text-slate-900">
            Warum Stuttgart auf Containerlabore setzt
          </h2>
          <div class="prose prose-lg text-gray-600 max-w-none space-y-6">
            <p>
              Stuttgart gehört zu den forschungsstärksten Regionen in ganz Europa. Zwischen Uni Stuttgart, Uni Hohenheim, dem Klinikum Stuttgart und den zahlreichen Fraunhofer-Instituten wird hier täglich auf höchstem Niveau geforscht, geprüft und entwickelt. Dazu kommen Unternehmen wie Mercedes-Benz, Porsche, Bosch und ein dichtes Netz aus Pharma- und Biotechfirmen in der gesamten Region.
            </p>
            <p>
              Was all diese Einrichtungen gemeinsam haben: Irgendwann brauchen sie mehr Laborkapazität. Und zwar nicht in drei Jahren, sondern jetzt. Ein Gebäude zu errichten dauert Monate, oft Jahre. Die Genehmigungen allein können sich endlos ziehen.
            </p>
            <p>
              Genau hier kommen wir ins Spiel. Planexus plant und baut <strong>Laborcontainer</strong> – vollwertige, normgerechte Labore im Containerformat. Unser Werk steht in Albstadt, rund 80 Kilometer südlich von Stuttgart. Von der ersten Skizze bis zur schlüsselfertigen Übergabe auf Ihrem Gelände übernehmen wir alles. <a href="/leistungen" class="text-primary font-medium hover:underline">Mehr über unsere Leistungen →</a>
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Einsatzbereiche -->
    <section class="py-20 bg-slate-50 border-y border-gray-100">
      <div class="container mx-auto px-4">
        <div class="max-w-4xl mx-auto">
          <h2 class="text-3xl font-heading font-bold mb-4 text-slate-900">
            Automobil, Werkstoffe, Forschung – Laborszenarien für Stuttgart
          </h2>
          <p class="text-gray-600 text-lg mb-12">
            Nicht jedes Labor muss ein festes Gebäude sein. Es gibt Situationen, in denen ein Containerlabor nicht nur die schnellere, sondern auch die bessere Lösung ist.
          </p>

          <div class="space-y-8">
            <div class="bg-white p-8 rounded-2xl border border-gray-100 hover:shadow-lg transition-shadow">
              <div class="flex items-start gap-5">
                <div class="w-14 h-14 bg-primary/10 rounded-lg flex items-center justify-center text-primary shrink-0">
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-7 h-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z"/><path d="m3.3 7 8.7 5 8.7-5"/><path d="M12 22V12"/></svg>
                </div>
                <div>
                  <h3 class="text-xl font-bold mb-3 text-slate-900">Sanierung oder Umbau am Standort</h3>
                  <p class="text-gray-600 leading-relaxed">
                    Ein Institut der Uni Stuttgart muss sein Laborgebäude sanieren. Die Forschungsgruppen können aber nicht einfach zwei Jahre pausieren. Ein Containerlabor steht auf dem Campus, ist in wenigen Wochen betriebsbereit und wird nach Abschluss der Bauarbeiten wieder abgebaut.
                  </p>
                </div>
              </div>
            </div>

            <div class="bg-white p-8 rounded-2xl border border-gray-100 hover:shadow-lg transition-shadow">
              <div class="flex items-start gap-5">
                <div class="w-14 h-14 bg-primary/10 rounded-lg flex items-center justify-center text-primary shrink-0">
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-7 h-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10"/><path d="m9 12 2 2 4-4"/></svg>
                </div>
                <div>
                  <h3 class="text-xl font-bold mb-3 text-slate-900">Kurzfristiger Bedarf in der Pharmaindustrie</h3>
                  <p class="text-gray-600 leading-relaxed">
                    Eine klinische Studie erfordert zusätzliche Laborkapazität unter BSL-2-Bedingungen. Der Massivbau würde 18 Monate dauern – die Studie startet in drei Monaten. Ein <a href="/leistungen/ausstattung" class="text-primary font-medium hover:underline">Containerlabor mit BSL-2-Ausstattung</a> ist in 8 bis 12 Wochen fertig.
                  </p>
                </div>
              </div>
            </div>

            <div class="bg-white p-8 rounded-2xl border border-gray-100 hover:shadow-lg transition-shadow">
              <div class="flex items-start gap-5">
                <div class="w-14 h-14 bg-primary/10 rounded-lg flex items-center justify-center text-primary shrink-0">
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-7 h-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 18h8"/><path d="M3 22h18"/><path d="M14 22a7 7 0 1 0 0-14h-1"/><path d="M9 14h2"/><path d="M9 12a2 2 0 0 1-2-2V6h6v4a2 2 0 0 1-2 2Z"/><path d="M12 6V3a1 1 0 0 0-1-1H9a1 1 0 0 0-1 1v3"/></svg>
                </div>
                <div>
                  <h3 class="text-xl font-bold mb-3 text-slate-900">Zusätzliches Prüflabor in der Industrie</h3>
                  <p class="text-gray-600 leading-relaxed">
                    Ein Automobilzulieferer im Raum Stuttgart braucht ein Materiallabor direkt auf dem Werksgelände. Im Gebäude ist kein Platz, ein Anbau ist zu aufwändig. Ein Laborcontainer steht auf der Freifläche – oft sogar ohne Baugenehmigung.
                  </p>
                </div>
              </div>
            </div>

            <div class="bg-white p-8 rounded-2xl border border-gray-100 hover:shadow-lg transition-shadow">
              <div class="flex items-start gap-5">
                <div class="w-14 h-14 bg-primary/10 rounded-lg flex items-center justify-center text-primary shrink-0">
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-7 h-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                </div>
                <div>
                  <h3 class="text-xl font-bold mb-3 text-slate-900">Forschungsprojekte mit begrenzter Laufzeit</h3>
                  <p class="text-gray-600 leading-relaxed">
                    Drittmittelprojekte laufen drei bis fünf Jahre. Danach ist die Laborkapazität nicht mehr nötig. Ein Container lässt sich versetzen, umnutzen oder zurückbauen. Das sind keine theoretischen Beispiele – so sieht der Alltag aus, wenn Labore schnell gebraucht werden. <a href="/projekte" class="text-primary font-medium hover:underline">Unsere bisherigen Projekte →</a>
                  </p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Leistungen für Stuttgart -->
        <section class="py-16">
      <div class="container mx-auto px-4">
        <div class="max-w-4xl mx-auto">
          <div class="bg-slate-50 border border-gray-100 rounded-2xl p-8">
            <h2 class="text-2xl font-heading font-bold mb-4 text-slate-900">Vom Entwurf zum fertigen Labor in Stuttgart</h2>
            <p class="text-gray-600 leading-relaxed mb-4">
              Stuttgart ist unser Heimatmarkt – nur 80 km von unserem Werk in unserem Werk. Das heißt: kurze Wege, schnelle Reaktionszeiten, persönliche Betreuung vor Ort. Fachplanung, Fertigung, Transport und Aufstellung aus einer Hand. Laborausstattung wird eingebaut und betriebsbereit übergeben.
            </p>
            <div class="flex flex-wrap gap-3">
              <a href="/leistungen/planung" class="text-primary font-medium hover:underline text-sm">Fachplanung →</a>
              <a href="/leistungen/modulbau" class="text-primary font-medium hover:underline text-sm">Modulbau →</a>
              <a href="/leistungen/logistik" class="text-primary font-medium hover:underline text-sm">Logistik →</a>
              <a href="/leistungen/ausstattung" class="text-primary font-medium hover:underline text-sm">Ausstattung →</a>
              <a href="/leistungen/beratung" class="text-primary font-medium hover:underline text-sm">Beratung →</a>
              <a href="/leistungen/smart-lab" class="text-primary font-medium hover:underline text-sm">Smart Lab →</a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="py-20 bg-slate-50 border-y border-gray-100">
      <div class="container mx-auto px-4">
        <div class="max-w-4xl mx-auto">
          <h2 class="text-3xl font-heading font-bold mb-8 text-slate-900">
            Engineering-Hochburg Stuttgart – Fraunhofer, DLR und Automobilindustrie
          </h2>
          <div class="prose prose-lg text-gray-600 max-w-none space-y-6">
            <p>
              Die Region Stuttgart zählt zu den forschungsstärksten Ballungsräumen Europas. Auf engstem Raum arbeiten Universitäten, Fraunhofer-Institute, Kliniken und Weltkonzerne an Zukunftstechnologien – von der Batteriezelle bis zur Genomsequenzierung. Der Bedarf an zusätzlicher Laborkapazität ist hier permanent hoch und wächst mit jeder neuen Projektförderung.
            </p>
            <h3 class="text-xl font-bold text-slate-900">Forschungsinstitute und Hochschulen</h3>
            <p>
              Die <strong>Universität Stuttgart</strong> betreibt mit dem Institut für Wasser- und Umweltsystemmodellierung (IWS) und dem Institut für Maschinelle Sprachverarbeitung (IMS) international sichtbare Forschungseinheiten mit eigenem Laborbedarf. Die <strong>Universität Hohenheim</strong> ist führend in Agrarwissenschaften und Lebensmittelforschung – beide Bereiche mit hohem Durchsatz an Probenanalytik. Das <strong>Klinikum Stuttgart</strong>, eines der größten kommunalen Krankenhäuser Deutschlands, benötigt regelmäßig zusätzliche Laborkapazität für Pathologie und klinische Diagnostik. Dazu kommen das <strong>Fraunhofer IPA</strong> (Produktionstechnik und Automatisierung) und das <strong>Fraunhofer IGB</strong> (Grenzflächen- und Bioverfahrenstechnik) – beide in Stuttgart ansässig und auf anwendungsnahe Laborforschung spezialisiert. Selbst das <strong>Naturkundemuseum Stuttgart</strong> unterhält Sammlungslabore für Paläontologie und Biodiversitätsforschung.
            </p>
            <h3 class="text-xl font-bold text-slate-900">Automotive und Industrie</h3>
            <p>
              <strong>Mercedes-Benz</strong> betreibt in Stuttgart-Untertürkheim und Sindelfingen umfangreiche Labore für Materialprüfung und Batterieforschung. <strong>Porsche</strong> unterhält Prüflabore am Entwicklungszentrum in Weissach. <strong>Bosch</strong> hat seine zentrale Forschung in Stuttgart-Feuerbach – mit hunderten Laborarbeitsplätzen für Sensorik, Halbleiter und Werkstoffanalyse. Im erweiterten Großraum sitzen <strong>Trumpf</strong> (Ditzingen, Lasertechnik), <strong>Festo</strong> (Esslingen, Automatisierung), <strong>Stihl</strong> (Waiblingen, Antriebstechnik) und <strong>Mahle</strong> (Stuttgart-Bad Cannstatt, Thermomanagement) – allesamt Unternehmen mit eigenem Laborbedarf für Qualitätssicherung und Entwicklung.
            </p>
            <h3 class="text-xl font-bold text-slate-900">Pharma und Biotech</h3>
            <p>
              <strong>CureVac</strong> in Tübingen (rund 40 km entfernt), <strong>Boehringer Ingelheim</strong> in Biberach (rund 100 km) und <strong>BioNTech Innovations</strong> in Stuttgart bilden ein wachsendes Pharma-Cluster in der Region. Das <strong>Robert-Bosch-Krankenhaus</strong> in Stuttgart führt klinische Studien durch und braucht dafür regelmäßig zusätzliche Laborkapazität unter kontrollierten Bedingungen. All diese Einrichtungen profitieren von Containerlaboren, die schnell verfügbar und normkonform ausgestattet sind. <a href="/magazin/laborcontainer-klimatisierung-lueftung-normen" class="text-primary font-medium hover:underline">Mehr zur Klimatisierung im Container →</a>
            </p>
          </div>
        </div>
      </div>
    </section>

        <section class="py-20 bg-slate-900 text-white">
      <div class="container mx-auto px-4">
        <div class="max-w-4xl mx-auto">
          <h2 class="text-3xl font-heading font-bold mb-4">Stuttgart in Zahlen – Engineering-Hauptstadt mit Laborbedarf</h2>
          <p class="text-gray-400 text-lg mb-12">Sechs Fakten zu Stuttgarts Industrie- und Forschungslandschaft.</p>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div class="flex items-start gap-4 p-6 rounded-xl border border-white/10 hover:border-primary/30 transition-colors">
              <div class="w-12 h-12 bg-primary/10 rounded-lg flex items-center justify-center text-primary shrink-0">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
              </div>
              <div>
                <h3 class="font-bold text-lg mb-1">80 km vom Planexus-Werk</h3>
                <p class="text-gray-400 text-sm">Stuttgart ist unser nächstgelegener Großstandort. Transport, Aufstellung und Service – alles innerhalb eines Tages vor Ort.</p>
              </div>
            </div>

            <div class="flex items-start gap-4 p-6 rounded-xl border border-white/10 hover:border-primary/30 transition-colors">
              <div class="w-12 h-12 bg-primary/10 rounded-lg flex items-center justify-center text-primary shrink-0">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 18h8"/><path d="M3 22h18"/><path d="M14 22a7 7 0 1 0 0-14h-1"/><path d="M9 14h2"/><path d="M9 12a2 2 0 0 1-2-2V6h6v4a2 2 0 0 1-2 2Z"/><path d="M12 6V3a1 1 0 0 0-1-1H9a1 1 0 0 0-1 1v3"/></svg>
              </div>
              <div>
                <h3 class="font-bold text-lg mb-1">Fraunhofer-Hochburg</h3>
                <p class="text-gray-400 text-sm">Sechs Fraunhofer-Institute in Stuttgart – IPA, IAO, IBP, IGB, ICT, ISI. Werkstoffprüfung, Produktionstechnik und Bauphysik erzeugen ständig Laborbedarf.</p>
              </div>
            </div>

