---
import Layout from '../layouts/Layout.astro';

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": "Laborcontainer Stuttgart",
  "description": "Mobile Prüf- und Analyselabore für Stuttgarts Automobil- und Ingenieurstandort. Werkstoffprüfung, Batterieforschung, Fraunhofer-/DLR-Projekte – 80 km ab Werk Albstadt.",
  "provider": {
    "@type": "Organization",
    "name": "Planexus GmbH",
    "url": "https://www.planexus.de"
  },
  "areaServed": [
    { "@type": "City", "name": "Stuttgart" },
    { "@type": "State", "name": "Baden-Württemberg" }
  ],
  "serviceType": ["Laborcontainer", "Prüflabor", "Werkstoffprüfung", "Batterielabor", "Analytiklabor"],
  "url": "https://www.planexus.de/laborcontainer-stuttgart"
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Start", "item": "https://www.planexus.de/" },
    { "@type": "ListItem", "position": 2, "name": "Laborcontainer Stuttgart", "item": "https://www.planexus.de/laborcontainer-stuttgart" }
  ]
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Welche Prüflabore lassen sich in einem Container realisieren?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Unsere Containerlabore decken ein breites Spektrum der Werkstoff- und Materialprüfung ab: Zugprüfungen, Härtetests, metallografische Analyse, Korrosionsprüfung, Klimawechseltests und zerstörungsfreie Prüfung (ZfP). Die Ausstattung richtet sich nach den Anforderungen der jeweiligen Prüfnorm – ob DIN, ISO oder kundenspezifisch."
      }
    },
    {
      "@type": "Question",
      "name": "Ist eine Baugenehmigung in Baden-Württemberg nötig?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Die Landesbauordnung Baden-Württemberg (LBO) regelt in § 50 die verfahrensfreien Vorhaben. Unter bestimmten Voraussetzungen können temporäre bauliche Anlagen ohne Baugenehmigung aufgestellt werden. Bei Laboren mit Gefahrstoffen oder als Sonderbauten ist ein Bauantrag beim Baurechtsamt der Stadt Stuttgart erforderlich. Wir klären die Genehmigungslage im Vorfeld."
      }
    },
    {
      "@type": "Question",
      "name": "Wie weit ist es von Albstadt nach Stuttgart?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Nur rund 80 km – etwa 1 Stunde und 10 Minuten über die B27 oder A81. Stuttgart ist damit der nächstgelegene Großstadt-Standort für Planexus. Standortbegehungen sind innerhalb eines Vormittags erledigt, Schwerlasttransporte am selben Tag vor Ort."
      }
    },
    {
      "@type": "Question",
      "name": "Eignen sich Containerlabore für Batterieforschung und E-Mobilität?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Ja. Für die Batterieforschung realisieren wir Container mit EX-Schutz-Ausstattung, Gaswarnanlage, spezieller Lüftung und Brandschutzvorkehrungen. Das ist besonders relevant für Prüfstände, bei denen Zellen unter Last getestet werden – ein Szenario, das in der Stuttgarter Automobilforschung zunehmend gefragt ist."
      }
    },
    {
      "@type": "Question",
      "name": "Können Container für Fraunhofer- oder DLR-Projekte eingesetzt werden?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Ja. Öffentlich geförderte Forschungsprojekte haben oft einen begrenzten Zeithorizont von 2–5 Jahren. Ein Containerlabor passt perfekt in dieses Schema: schnell verfügbar, projektbezogen finanzierbar und nach Projektende rückbaubar. Mehrere unserer Kunden aus dem Forschungsumfeld nutzen genau dieses Modell."
      }
    },
    {
      "@type": "Question",
      "name": "Was kostet ein Prüflabor-Container für Stuttgart?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Die Kosten richten sich nach Ausstattung und Prüfumfang. Ein einfaches Analytiklabor liegt in einer anderen Kategorie als ein klimatisierter Prüfstand mit Schwingungsdämpfung. Durch die extrem kurze Distanz ab Albstadt (~80 km) sind die Transportkosten minimal. Kontaktieren Sie uns für eine projektspezifische Kalkulation."
      }
    }
  ]
};

const localBusinessSchema = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "name": "Planexus GmbH – Laborcontainer Stuttgart",
  "description": "Prüf- und Analyselabore im Container für Stuttgart und Baden-Württemberg. Werkstoffprüfung, Batterieforschung, Automobilanalytik – 80 km ab Werk.",
  "url": "https://www.planexus.de",
  "telephone": "+49 7435 7519 700",
  "email": "info@planexus.de",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "Am Steinbach 8",
    "addressLocality": "Albstadt",
    "postalCode": "72459",
    "addressCountry": "DE"
  },
  "areaServed": [
    { "@type": "City", "name": "Stuttgart" },
    { "@type": "State", "name": "Baden-Württemberg" }
  ]
};
---

<Layout
  title="Laborcontainer Stuttgart – Prüflabor, Werkstoffprüfung & Automotive | Planexus GmbH"
  description="Containerlabore für Stuttgarts Engineering-Standort: Werkstoffprüfung, Batterieforschung, Fraunhofer-/DLR-Projekte. Nur 80 km ab Werk Albstadt – Ihr nächster Laborpartner."
  canonical="/laborcontainer-stuttgart"
  schema={serviceSchema}
  ogImage="/attached_assets/Kopf_green-scaled_1768306688943.jpg"
>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} slot="head" />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} slot="head" />
  <script type="application/ld+json" set:html={JSON.stringify(localBusinessSchema)} slot="head" />

  <div class="pt-20 min-h-screen bg-white">

    <!-- Hero: Engineering-Prüflabor -->
    <section class="relative py-32 bg-slate-900 text-white overflow-hidden">
      <div class="absolute inset-0">
        <div class="absolute inset-0 bg-[linear-gradient(135deg,rgba(187,215,0,0.08)_0%,transparent_50%,rgba(187,215,0,0.04)_100%)]"></div>
        <div class="absolute bottom-0 left-0 w-full h-px bg-gradient-to-r from-transparent via-primary/30 to-transparent"></div>
      </div>

      <div class="container mx-auto px-4 relative z-10">
        <div class="max-w-4xl">
          <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-white/10 text-primary text-sm font-medium mb-8 backdrop-blur-sm border border-white/10">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
            Stuttgart & Region
          </div>
          <h1 class="text-4xl md:text-5xl lg:text-6xl font-heading font-bold mb-6 leading-tight">
            Wo Ingenieure testen, braucht es <span class="text-primary">Prüflabore</span>
          </h1>
          <p class="text-xl text-gray-300 mb-4 leading-relaxed font-light max-w-3xl">
            Stuttgart ist Deutschlands Engineering-Herz: Fünf Fraunhofer-Institute, sieben DLR-Institute, zwei Automobilkonzerne und Tausende Zulieferer. Werkstoffprüfung, Bauteilanalyse und Qualitätskontrolle laufen hier rund um die Uhr – und der Bedarf an Laborfläche wächst schneller als gebaut werden kann.
          </p>
          <p class="text-lg text-gray-400 mb-10 max-w-2xl">
            Albstadt liegt 80 km entfernt. Kein anderer Laborcontainer-Hersteller in Deutschland ist näher an Stuttgart.
          </p>

          <div class="flex flex-col sm:flex-row gap-4 mb-16">
            <a href="/kontakt" class="bg-primary text-slate-900 font-bold px-8 py-4 rounded-lg hover:bg-primary/90 transition-colors flex items-center justify-center gap-2 group shadow-[0_0_20px_rgba(187,215,0,0.3)]">
              Prüflabor-Projekt anfragen
              <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 group-hover:translate-x-1 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
            </a>
            <a href="tel:+4974357519700" class="border border-white/20 text-white font-medium px-8 py-4 rounded-lg hover:bg-white/10 transition-colors backdrop-blur-sm flex items-center justify-center gap-2">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
              +49 7435 7519 700
            </a>
          </div>

          <div class="grid grid-cols-2 md:grid-cols-4 gap-6">
            <div class="bg-white/5 border border-white/10 rounded-xl p-5 text-center">
              <div class="text-2xl font-heading font-bold text-primary">~80 km</div>
              <p class="text-gray-400 text-sm mt-1">Albstadt → Stuttgart</p>
            </div>
            <div class="bg-white/5 border border-white/10 rounded-xl p-5 text-center">
              <div class="text-2xl font-heading font-bold text-primary">5</div>
              <p class="text-gray-400 text-sm mt-1">Fraunhofer-Institute in Stuttgart</p>
            </div>
            <div class="bg-white/5 border border-white/10 rounded-xl p-5 text-center">
              <div class="text-2xl font-heading font-bold text-primary">7</div>
              <p class="text-gray-400 text-sm mt-1">DLR-Institute am Standort</p>
            </div>
            <div class="bg-white/5 border border-white/10 rounded-xl p-5 text-center">
              <div class="text-2xl font-heading font-bold text-primary">310 Mio.</div>
              <p class="text-gray-400 text-sm mt-1">EUR – Bosch Renningen Invest</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Breadcrumb -->
    <nav class="bg-gray-50 border-b border-gray-100 py-3">
      <div class="container mx-auto px-4">
        <ol class="flex items-center gap-2 text-sm text-gray-500">
          <li><a href="/" class="hover:text-primary transition-colors">Start</a></li>
          <li><svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg></li>
          <li class="text-primary font-medium">Laborcontainer Stuttgart</li>
        </ol>
      </div>
    </nav>

    <!-- Section 1: Der Prüfzyklus — wo Container eingreifen -->
    <section class="py-20 bg-white">
      <div class="container mx-auto px-4">
        <div class="max-w-5xl mx-auto">
          <h2 class="text-3xl md:text-4xl font-heading font-bold mb-6 text-slate-900">
            Vom Prototyp zur Serienfreigabe – der Stuttgarter Prüfzyklus
          </h2>
          <p class="text-gray-600 text-lg mb-14 leading-relaxed max-w-3xl">
            In der Automobilindustrie folgt jedes Bauteil einem festgelegten Prüfzyklus: Werkstoffanalyse, Bauteiltest, Dauerlauf, Serienfreigabe. An jeder Station entstehen Kapazitätsengpässe – besonders bei Modellwechseln, Rückrufen oder der Umstellung auf E-Antriebe. Ein Containerlabor schließt diese Lücken.
          </p>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
            <div class="relative bg-gradient-to-br from-slate-50 to-white rounded-2xl p-8 border border-gray-100 group hover:border-primary/30 transition-all">
              <div class="absolute top-6 right-6 bg-primary text-slate-900 text-xs font-bold px-3 py-1 rounded-full">Phase 1</div>
              <div class="w-14 h-14 bg-slate-900 rounded-xl flex items-center justify-center mb-5">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-7 h-7 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12h6"/><path d="M22 12h-6"/><circle cx="12" cy="12" r="2"/><path d="M12 2v6"/><path d="M12 18v4"/></svg>
              </div>
              <h3 class="text-xl font-heading font-bold text-slate-900 mb-3">Werkstoffanalyse & Eingangsprüfung</h3>
              <p class="text-gray-600 text-sm leading-relaxed">
                Bevor ein Werkstoff in die Fertigung geht, wird er geprüft: Zugfestigkeit, Härte, Gefügestruktur, chemische Zusammensetzung. Die Materialprüfungsanstalt (MPA) der Universität Stuttgart – gegründet 1884, über 135 Jahre Erfahrung – setzt hier Maßstäbe. Wenn deren Kapazitäten nicht reichen, schafft ein Containerlabor mit Universalprüfmaschine und Metallografie-Arbeitsplatz sofortige Entlastung.
              </p>
            </div>

            <div class="relative bg-gradient-to-br from-slate-50 to-white rounded-2xl p-8 border border-gray-100 group hover:border-primary/30 transition-all">
              <div class="absolute top-6 right-6 bg-primary text-slate-900 text-xs font-bold px-3 py-1 rounded-full">Phase 2</div>
              <div class="w-14 h-14 bg-slate-900 rounded-xl flex items-center justify-center mb-5">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-7 h-7 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76Z"/></svg>
              </div>
              <h3 class="text-xl font-heading font-bold text-slate-900 mb-3">Bauteil- und Komponententest</h3>
              <p class="text-gray-600 text-sm leading-relaxed">
                Getriebeteile, Bremsscheiben, Fahrwerkskomponenten – jedes Bauteil wird unter realistischen Bedingungen getestet. Das FKFS (Forschungsinstitut für Kraftfahrwesen, gegr. 1930) an der Universität Stuttgart betreibt Prüfstände für Aerodynamik und Antrieb. Ein temporäres Containerlabor ergänzt bei Sonderprojekten oder Modellwechsel-Peaks die vorhandene Infrastruktur.
              </p>
            </div>

            <div class="relative bg-gradient-to-br from-slate-50 to-white rounded-2xl p-8 border border-gray-100 group hover:border-primary/30 transition-all">
              <div class="absolute top-6 right-6 bg-primary text-slate-900 text-xs font-bold px-3 py-1 rounded-full">Phase 3</div>
              <div class="w-14 h-14 bg-slate-900 rounded-xl flex items-center justify-center mb-5">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-7 h-7 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M13 2 3 14h9l-1 8 10-12h-9l1-8z"/></svg>
              </div>
              <h3 class="text-xl font-heading font-bold text-slate-900 mb-3">Batterie- und E-Mobilitäts-Prüfung</h3>
              <p class="text-gray-600 text-sm leading-relaxed">
                Die Transformation zur E-Mobilität erzeugt enormen Prüfbedarf: Zellchemie, Lade-/Entladezyklen, thermisches Management, Crash-Verhalten. Das ZSW (Zentrum für Sonnenenergie- und Wasserstoff-Forschung, gegr. 1988) in Stuttgart-Vaihingen forscht an Batterietechnologien. Unsere Container mit EX-Schutz, Gaswarnanlage und spezieller Lüftung sind für genau diese Anforderungen ausgelegt.
              </p>
            </div>

            <div class="relative bg-gradient-to-br from-slate-50 to-white rounded-2xl p-8 border border-gray-100 group hover:border-primary/30 transition-all">
              <div class="absolute top-6 right-6 bg-primary text-slate-900 text-xs font-bold px-3 py-1 rounded-full">Phase 4</div>
              <div class="w-14 h-14 bg-slate-900 rounded-xl flex items-center justify-center mb-5">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-7 h-7 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10"/><path d="m9 12 2 2 4-4"/></svg>
              </div>
              <h3 class="text-xl font-heading font-bold text-slate-900 mb-3">Serienbegleitende Qualitätskontrolle</h3>
              <p class="text-gray-600 text-sm leading-relaxed">
                In der laufenden Produktion wird stichprobenartig geprüft: Maßhaltigkeit, Oberflächenqualität, mechanische Kennwerte. Bei Lieferantenwechseln oder Materialumstellungen steigt der Prüfumfang sprunghaft an. Ein Containerlabor direkt am Werksgelände spart den Transport ins externe Prüflabor – und damit Tage.
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Section 2: Stuttgarts Forschungslandschaft — Deep Dive -->
    <section class="py-20 bg-slate-900 text-white">
      <div class="container mx-auto px-4">
        <div class="max-w-6xl mx-auto">
          <span class="text-primary text-sm font-bold uppercase tracking-wider">Forschungsdichte wie nirgends sonst</span>
          <h2 class="text-3xl md:text-4xl font-heading font-bold mt-3 mb-6">
            Stuttgart: Fünf Fraunhofer-Institute, sieben DLR-Standorte, ein Engineering-Ökosystem
          </h2>
          <p class="text-gray-400 text-lg mb-12 leading-relaxed max-w-3xl">
            Baden-Württemberg hat 13 Fraunhofer-Institute – fünf davon in Stuttgart. Dazu kommen sieben DLR-Institute, die Universität Stuttgart mit ihrer Materialprüfungsanstalt und Dutzende außeruniversitäre Forschungseinrichtungen. Das Ergebnis: ein Ökosystem, in dem Forschung und Industrie auf kürzestem Weg zusammenarbeiten.
          </p>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div class="bg-white/5 border border-white/10 rounded-xl p-6 hover:border-primary/30 transition-colors">
              <div class="flex items-center gap-3 mb-4">
                <div class="w-10 h-10 bg-primary/20 rounded-lg flex items-center justify-center text-primary font-bold text-sm">5×</div>
                <h3 class="font-heading font-bold text-lg">Fraunhofer-Institute Stuttgart</h3>
              </div>
              <p class="text-gray-400 text-sm leading-relaxed mb-4">
                Fünf Institute der angewandten Forschung – von Produktionstechnik (IPA) über Bauphysik (IBP) bis Arbeitswirtschaft (IAO). Zusammen Teil eines Netzwerks von 13 Fraunhofer-Instituten in Baden-Württemberg mit insgesamt rund 6.100 Mitarbeitenden.
              </p>
              <p class="text-gray-500 text-xs">Drittmittelprojekte mit 2–5 Jahren Laufzeit → ideale Containerlabor-Nutzungsdauer</p>
            </div>

            <div class="bg-white/5 border border-white/10 rounded-xl p-6 hover:border-primary/30 transition-colors">
              <div class="flex items-center gap-3 mb-4">
                <div class="w-10 h-10 bg-primary/20 rounded-lg flex items-center justify-center text-primary font-bold text-sm">7×</div>
                <h3 class="font-heading font-bold text-lg">DLR-Institute Stuttgart</h3>
              </div>
              <p class="text-gray-400 text-sm leading-relaxed mb-4">
                Das Deutsche Zentrum für Luft- und Raumfahrt betreibt am Standort Stuttgart sieben Institute – darunter das Institut für Fahrzeugkonzepte (FK, gegr. 2002), das an alternativen Antrieben und Leichtbaustrukturen forscht. Standort: Pfaffenwaldring, direkt am Campus Vaihingen.
              </p>
              <p class="text-gray-500 text-xs">Forschung an Wasserstoff, E-Antrieben und Leichtbau → wachsender Laborbedarf</p>
            </div>

            <div class="bg-white/5 border border-white/10 rounded-xl p-6 hover:border-primary/30 transition-colors">
              <div class="flex items-center gap-3 mb-4">
                <div class="w-10 h-10 bg-primary/20 rounded-lg flex items-center justify-center text-primary font-bold text-sm">MPA</div>
                <h3 class="font-heading font-bold text-lg">Materialprüfungsanstalt Stuttgart</h3>
              </div>
              <p class="text-gray-400 text-sm leading-relaxed mb-4">
                Gegründet 1884 von Carl von Bach, über 135 Jahre Erfahrung in der Werkstoffprüfung. Als Zentralinstitut der Universität Stuttgart führt die MPA Bauteilprüfungen, Schadensanalysen und Werkstoffcharakterisierungen durch – akkreditiert und weltweit anerkannt.
              </p>
              <p class="text-gray-500 text-xs">Kapazitätsengpässe bei Großprojekten → Containerlabor als Erweiterung</p>
            </div>

            <div class="bg-white/5 border border-white/10 rounded-xl p-6 hover:border-primary/30 transition-colors">
              <div class="flex items-center gap-3 mb-4">
                <div class="w-10 h-10 bg-primary/20 rounded-lg flex items-center justify-center text-primary font-bold text-sm">ZSW</div>
                <h3 class="font-heading font-bold text-lg">ZSW – Batterieforschung</h3>
              </div>
              <p class="text-gray-400 text-sm leading-relaxed mb-4">
                Das Zentrum für Sonnenenergie- und Wasserstoff-Forschung (gegr. 1988) hat Standorte in Stuttgart-Vaihingen und Ulm. Forschungsschwerpunkte: Photovoltaik, Batterietechnologie, Brennstoffzellen und Wasserstofftechnik. Ein zentraler Akteur in der Transformation zur E-Mobilität.
              </p>
              <p class="text-gray-500 text-xs">Batterieprüfung erfordert EX-Schutz und Spezialbelüftung → unsere Kernkompetenz</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Section 3: Automotive-Achse — Mercedes, Porsche, Bosch -->
    <section class="py-20 bg-white">
      <div class="container mx-auto px-4">
        <div class="max-w-5xl mx-auto">
          <h2 class="text-3xl font-heading font-bold mb-6 text-slate-900">
            Mercedes, Porsche, Bosch: Prüflabore für die Automobilhauptstadt
          </h2>
          <p class="text-gray-600 text-lg mb-12 leading-relaxed max-w-3xl">
            Stuttgart ist Sitz von Mercedes-Benz, Porsche und des Bosch-Forschungscampus. Die Automobilindustrie durchläuft die größte Transformation seit der Erfindung des Verbrennungsmotors – und der Prüfbedarf explodiert.
          </p>

          <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
            <div class="bg-white rounded-2xl border border-gray-200 overflow-hidden group hover:shadow-lg transition-shadow">
              <div class="bg-slate-900 p-6">
                <h3 class="text-xl font-heading font-bold text-white mb-1">Mercedes-Benz Untertürkheim</h3>
                <p class="text-primary text-sm font-medium">Konzernzentrale Stuttgart</p>
