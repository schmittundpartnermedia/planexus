---
import Layout from '../layouts/Layout.astro';

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": "Laborcontainer Bern",
  "description": "Mobile Containerlabore für die Medizin- und Bundesstadt Bern. Inselspital, sitem-insel Translationsmedizin, CSL Behring – klinische Forschungslabore ab 230 km Entfernung.",
  "provider": {
    "@type": "Organization",
    "name": "Planexus GmbH",
    "url": "https://www.planexus.de"
  },
  "areaServed": [
    { "@type": "City", "name": "Bern" },
    { "@type": "AdministrativeArea", "name": "Kanton Bern" }
  ],
  "serviceType": ["Laborcontainer", "BSL-2 Container", "Klinisches Labor", "Reinraum-Container", "Forschungslabor"],
  "url": "https://www.planexus.de/laborcontainer-bern"
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Start", "item": "https://www.planexus.de/" },
    { "@type": "ListItem", "position": 2, "name": "Laborcontainer Bern", "item": "https://www.planexus.de/laborcontainer-bern" }
  ]
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Können Containerlabore auf dem Insel-Campus aufgestellt werden?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Ja. Das Inselspital mit rund 11.000 Mitarbeitenden nutzt regelmässig temporäre Erweiterungen. Containerlabore eignen sich für klinische Studien, Übergangskapazität bei Gebäudesanierungen oder als BSL-2-Erweiterung. Die Aufstellung erfordert die Zustimmung der Insel Gruppe und eine Baubewilligung."
      }
    },
    {
      "@type": "Question",
      "name": "Was ist sitem-insel und welche Labore braucht es?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "sitem-insel ist eine 2014 als Public-Private-Partnership gegründete Non-Profit AG für Translationsmedizin am Insel-Campus. Das Institut überführt Forschungsergebnisse in klinische Anwendungen. Dafür benötigt es GMP-konforme Labore, Reinräume und BSL-2-Kapazitäten – Containerlabore sind ideal für projektbezogene Erweiterungen."
      }
    },
    {
      "@type": "Question",
      "name": "Brauche ich im Kanton Bern eine Baubewilligung?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Grundsätzlich ja. Das Baugesetz des Kantons Bern (BauG) regelt in Art. 1a die Bewilligungspflicht. Art. 1b definiert Ausnahmen für bestimmte Vorhaben. Bei Laboren mit besonderen Anforderungen (BSL, GMP, Gefahrstoffe) ist in der Regel eine Baubewilligung erforderlich. Wir klären die Lage vorab."
      }
    },
    {
      "@type": "Question",
      "name": "Wie weit ist es von Albstadt nach Bern?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Rund 230 km über die A81 und die Schweizer Autobahn – etwa 2,5 bis 3 Stunden Fahrzeit. Wir übernehmen die komplette Zollabwicklung DE→CH. Für Schwerlasttransporte planen wir einen Tag ein."
      }
    },
    {
      "@type": "Question",
      "name": "Gibt es Containerlabore für CSL Behring in Bern?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Ja. CSL Behring am Standort Bern-Wankdorf ist einer der weltweit führenden Hersteller von Plasmaprodukten. Qualitätskontrolle und Prozessvalidierung erfordern dedizierte Laborkapazitäten – Containerlabore ergänzen bei Kapazitätsspitzen und Validierungsprojekten."
      }
    },
    {
      "@type": "Question",
      "name": "Was kostet ein klinisches Containerlabor für Bern?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Die Kosten richten sich nach Ausstattung, Reinraumklasse und Sicherheitsstufe. Zollabwicklung und Schweizer MWST (8,1%) werden transparent ins Angebot integriert. Kontaktieren Sie uns für eine projektspezifische Kalkulation."
      }
    }
  ]
};

const localBusinessSchema = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "name": "Planexus GmbH – Laborcontainer Bern",
  "description": "Containerlabore für Bern: Inselspital, sitem-insel, CSL Behring. Klinische Forschungslabore, BSL-2, Reinraum – Swissmedic-konform.",
  "url": "https://www.planexus.de",
  "telephone": "+49 7435 7519 700",
  "email": "info@planexus.de",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "Am Steinbach 8",
    "addressLocality": "Albstadt",
    "postalCode": "72459",
    "addressCountry": "DE"
  },
  "areaServed": [
    { "@type": "City", "name": "Bern" },
    { "@type": "Country", "name": "Schweiz" }
  ]
};
---

<Layout
  title="Laborcontainer Bern – Inselspital, sitem-insel & klinische Forschung | Planexus GmbH"
  description="Containerlabore für Berns Medizin-Cluster: Inselspital (11.000 MA), sitem-insel Translationsmedizin, CSL Behring. BSL-2, GMP-Reinraum – 230 km ab Werk."
  canonical="/laborcontainer-bern"
  schema={serviceSchema}
  ogImage="/attached_assets/Kopf_green-scaled_1768306688943.jpg"
>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} slot="head" />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} slot="head" />
  <script type="application/ld+json" set:html={JSON.stringify(localBusinessSchema)} slot="head" />

  <div class="pt-20 min-h-screen bg-white">

    <!-- Hero: Medizin & Bundesstadt -->
    <section class="relative py-32 bg-slate-900 text-white overflow-hidden">
      <div class="absolute inset-0 bg-[linear-gradient(135deg,rgba(187,215,0,0.06)_0%,transparent_50%,rgba(187,215,0,0.03)_100%)]"></div>

      <div class="container mx-auto px-4 relative z-10">
        <div class="max-w-4xl">
          <div class="flex items-center gap-3 mb-8">
            <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-white/10 text-primary text-sm font-medium backdrop-blur-sm border border-white/10">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
              Bern & Kanton
            </div>
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-red-500/20 text-red-400 text-xs font-bold border border-red-500/20">
              <span class="w-2 h-2 bg-red-400 rounded-full"></span>
              Schweiz
            </div>
          </div>

          <h1 class="text-4xl md:text-5xl lg:text-6xl font-heading font-bold mb-6 leading-tight">
            Wo Forschung Patienten hilft – <span class="text-primary">Labore für die Klinik</span>
          </h1>
          <p class="text-xl text-gray-300 mb-4 leading-relaxed font-light max-w-3xl">
            Das Inselspital ist eines der grössten Universitätsspitäler der Schweiz: rund 11.000 Mitarbeitende, Spitzenmedizin und klinische Forschung unter einem Dach. Direkt nebenan: sitem-insel – das Schweizer Institut für Translationsmedizin, das Laborergebnisse in Therapien überführt.
          </p>
          <p class="text-lg text-gray-400 mb-10 max-w-2xl">
            Wenn der Insel-Campus wächst, aber Gebäude nicht mitkommen – liefern wir das Labor.
          </p>

          <div class="flex flex-col sm:flex-row gap-4 mb-16">
            <a href="/kontakt" class="bg-primary text-slate-900 font-bold px-8 py-4 rounded-lg hover:bg-primary/90 transition-colors flex items-center justify-center gap-2 group shadow-[0_0_20px_rgba(187,215,0,0.3)]">
              Klinisches Labor anfragen
              <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 group-hover:translate-x-1 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
            </a>
            <a href="tel:+4974357519700" class="border border-white/20 text-white font-medium px-8 py-4 rounded-lg hover:bg-white/10 transition-colors backdrop-blur-sm flex items-center justify-center gap-2">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
              +49 7435 7519 700
            </a>
          </div>

          <div class="grid grid-cols-3 gap-4">
            <div class="bg-white/5 border border-white/10 rounded-xl p-5 text-center">
              <div class="text-2xl font-heading font-bold text-primary">~11.000</div>
              <p class="text-gray-400 text-xs mt-1">Mitarbeitende Inselspital</p>
            </div>
            <div class="bg-white/5 border border-white/10 rounded-xl p-5 text-center">
              <div class="text-2xl font-heading font-bold text-primary">2014</div>
              <p class="text-gray-400 text-xs mt-1">Gründung sitem-insel PPP</p>
            </div>
            <div class="bg-white/5 border border-white/10 rounded-xl p-5 text-center">
              <div class="text-2xl font-heading font-bold text-primary">~230 km</div>
              <p class="text-gray-400 text-xs mt-1">Albstadt → Bern</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Breadcrumb -->
    <nav class="bg-gray-50 border-b border-gray-100 py-3">
      <div class="container mx-auto px-4">
        <ol class="flex items-center gap-2 text-sm text-gray-500">
          <li><a href="/" class="hover:text-primary transition-colors">Start</a></li>
          <li><svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg></li>
          <li class="text-primary font-medium">Laborcontainer Bern</li>
        </ol>
      </div>
    </nav>

    <!-- Section 1: Inselspital & sitem-insel -->
    <section class="py-20 bg-white">
      <div class="container mx-auto px-4">
        <div class="max-w-5xl mx-auto">
          <h2 class="text-3xl md:text-4xl font-heading font-bold mb-6 text-slate-900">
            Inselspital und sitem-insel: Klinische Forschung braucht Laborkapazität
          </h2>
          <p class="text-gray-600 text-lg mb-12 leading-relaxed max-w-3xl">
            Der Insel-Campus in Bern vereint eines der grössten Spitäler der Schweiz mit einem einzigartigen Translationsmedizin-Institut. Was hier erforscht wird, soll möglichst schnell bei Patientinnen und Patienten ankommen – dafür braucht es Labore, die genauso schnell verfügbar sind.
          </p>

          <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
            <div class="bg-gradient-to-br from-slate-50 to-white rounded-2xl p-8 border border-gray-100">
              <div class="flex items-center gap-3 mb-6">
                <div class="w-12 h-12 bg-slate-900 rounded-xl flex items-center justify-center">
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M8 2v4"/><path d="M16 2v4"/><path d="M12 14v4"/><path d="M12 14a4 4 0 0 0 0-8"/><path d="M12 14a4 4 0 0 1 0-8"/></svg>
                </div>
                <div>
                  <h3 class="text-xl font-heading font-bold text-slate-900">Inselspital – Insel Gruppe</h3>
                  <p class="text-gray-500 text-sm">Universitätsspital Bern</p>
                </div>
              </div>
              <div class="space-y-3 text-sm mb-4">
                <div class="flex justify-between"><span class="text-gray-500">Mitarbeitende</span><span class="font-bold text-slate-900">~11.000</span></div>
                <div class="flex justify-between"><span class="text-gray-500">Nationen</span><span class="font-bold text-slate-900">102</span></div>
                <div class="flex justify-between"><span class="text-gray-500">Status</span><span class="font-bold text-slate-900">Grösstes Spital der Schweiz</span></div>
              </div>
              <p class="text-gray-600 text-sm leading-relaxed">
                Das Inselspital ist die grösste medizinische Einrichtung der Schweiz – mit rund 11.000 Mitarbeitenden aus 102 Nationen. Klinische Forschung, Diagnostik und Spitzenmedizin laufen hier parallel. Bei Gebäudesanierungen, Kapazitätserweiterungen oder neuen Forschungsprojekten sind Containerlabore die schnellste Lösung.
              </p>
              <p class="text-xs text-gray-400 mt-3">Quelle: Insel Gruppe AG, Kennzahlen</p>
            </div>

            <div class="bg-gradient-to-br from-slate-50 to-white rounded-2xl p-8 border border-gray-100">
              <div class="flex items-center gap-3 mb-6">
                <div class="w-12 h-12 bg-slate-900 rounded-xl flex items-center justify-center">
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m12 3-1.912 5.813a2 2 0 0 1-1.275 1.275L3 12l5.813 1.912a2 2 0 0 1 1.275 1.275L12 21l1.912-5.813a2 2 0 0 1 1.275-1.275L21 12l-5.813-1.912a2 2 0 0 1-1.275-1.275L12 3Z"/></svg>
                </div>
                <div>
                  <h3 class="text-xl font-heading font-bold text-slate-900">sitem-insel</h3>
                  <p class="text-gray-500 text-sm">Translationsmedizin am Insel-Campus</p>
                </div>
              </div>
              <div class="space-y-3 text-sm mb-4">
                <div class="flex justify-between"><span class="text-gray-500">Gründung</span><span class="font-bold text-slate-900">2014 (PPP)</span></div>
                <div class="flex justify-between"><span class="text-gray-500">Rechtsform</span><span class="font-bold text-slate-900">Non-Profit AG</span></div>
                <div class="flex justify-between"><span class="text-gray-500">Mission</span><span class="font-bold text-slate-900">Forschung → Klinik</span></div>
              </div>
              <p class="text-gray-600 text-sm leading-relaxed">
                sitem-insel wurde 2014 als Public-Private-Partnership gegründet, um die Lücke zwischen Laborforschung und klinischer Anwendung zu schliessen. Das Institut bietet Infrastruktur und Expertise für die Translation von biomedizinischen Innovationen. GMP-konforme Labore und Reinräume sind zentrale Anforderungen – Containerlabore liefern genau das.
              </p>
              <p class="text-xs text-gray-400 mt-3">Quelle: sitem-insel AG, Bern</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Section 2: Klinische Labore im Container -->
    <section class="py-20 bg-slate-900 text-white">
      <div class="container mx-auto px-4">
        <div class="max-w-5xl mx-auto">
          <h2 class="text-3xl md:text-4xl font-heading font-bold mb-6">
            Klinische Forschungslabore im Container: Berns Anforderungsprofil
          </h2>
          <p class="text-gray-400 text-lg mb-12 leading-relaxed max-w-3xl">
            An einem Universitätsspital gelten besondere Anforderungen: Hygiene, Biosicherheit und Rückverfolgbarkeit müssen lückenlos dokumentiert sein. Unsere Containerlabore erfüllen diese Standards – von BSL-2 bis GMP-Reinraum.
          </p>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
            <div class="space-y-6">
              <div class="bg-white/5 border border-white/10 rounded-xl p-6">
                <h3 class="text-primary font-bold mb-3">BSL-2-Forschungslabor</h3>
                <p class="text-gray-300 text-sm leading-relaxed">
                  Für den Umgang mit biologischen Arbeitsstoffen der Risikogruppe 2: Unterdruck, HEPA-Abluftfiltration, Autoklav-Anbindung, Sicherheitswerkbank Klasse II. Ideal für klinische Forschung mit Patientenproben und infektiösem Material.
                </p>
              </div>
              <div class="bg-white/5 border border-white/10 rounded-xl p-6">
                <h3 class="text-primary font-bold mb-3">Translationsmedizin-Labor</h3>
                <p class="text-gray-300 text-sm leading-relaxed">
                  GMP-nahe Bedingungen für die Überführung von Forschungsergebnissen in klinische Anwendungen: Reinraum ISO 7/ISO 8, kontrollierte Umgebung, Monitoring und Dokumentation nach Swissmedic-Anforderungen.
                </p>
              </div>
              <div class="bg-white/5 border border-white/10 rounded-xl p-6">
                <h3 class="text-primary font-bold mb-3">Diagnostik-Erweiterung</h3>
                <p class="text-gray-300 text-sm leading-relaxed">
                  Temporäre Erweiterung der Labordiagnostik bei Kapazitätsengpässen oder Gebäudesanierungen. Anbindung an bestehende LIMS-Systeme, Probeneingang mit Barcode-Tracking, 24/7-Betriebstauglichkeit.
                </p>
              </div>
            </div>

            <div class="bg-white/5 border border-white/10 rounded-2xl p-8">
              <h3 class="font-heading font-bold text-lg text-primary mb-6">Warum Containerlabore am Spital?</h3>
              <div class="space-y-6">
                <div class="flex gap-4">
                  <div class="w-8 h-8 bg-primary/15 rounded-full flex items-center justify-center shrink-0 text-sm font-bold text-primary">1</div>
                  <div>
                    <h4 class="font-bold text-sm text-white mb-1">Gebäudesanierung</h4>
                    <p class="text-gray-400 text-xs">Laborbetrieb muss während Renovierungen weiterlaufen. Container auf dem Spitalgelände ermöglichen ununterbrochene Diagnostik.</p>
                  </div>
                </div>
                <div class="flex gap-4">
                  <div class="w-8 h-8 bg-primary/15 rounded-full flex items-center justify-center shrink-0 text-sm font-bold text-primary">2</div>
                  <div>
                    <h4 class="font-bold text-sm text-white mb-1">Klinische Studien</h4>
                    <p class="text-gray-400 text-xs">Studien erfordern dedizierte Laborkapazität – zeitlich begrenzt, aber qualitativ kompromisslos. Container sind ideal für Studienlaufzeiten.</p>
                  </div>
                </div>
                <div class="flex gap-4">
                  <div class="w-8 h-8 bg-primary/15 rounded-full flex items-center justify-center shrink-0 text-sm font-bold text-primary">3</div>
                  <div>
                    <h4 class="font-bold text-sm text-white mb-1">Pandemievorsorge</h4>
                    <p class="text-gray-400 text-xs">Schnell verfügbare BSL-2-Kapazität für den Ernstfall. Containerlabore als strategische Reserve der Gesundheitsinfrastruktur.</p>
                  </div>
                </div>
                <div class="flex gap-4">
                  <div class="w-8 h-8 bg-primary/15 rounded-full flex items-center justify-center shrink-0 text-sm font-bold text-primary">4</div>
                  <div>
                    <h4 class="font-bold text-sm text-white mb-1">Wachstum ohne Neubau</h4>
                    <p class="text-gray-400 text-xs">Ein Laborneubau dauert 3–5 Jahre. Ein Containerlabor steht in wenigen Wochen. Forschung wartet nicht auf Baufortschritt.</p>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Section 3: CSL Behring & Pharma-Landschaft -->
    <section class="py-20 bg-white">
      <div class="container mx-auto px-4">
        <div class="max-w-5xl mx-auto">
          <span class="text-primary text-sm font-bold uppercase tracking-wider">Über die Klinik hinaus</span>
          <h2 class="text-3xl font-heading font-bold mt-3 mb-6 text-slate-900">
            CSL Behring und Berns Pharma-Landschaft
          </h2>
          <p class="text-gray-600 text-lg mb-12 leading-relaxed max-w-3xl">
            Bern ist mehr als Bundesstadt und Universitätsspital. Am Standort Wankdorf betreibt CSL Behring eine bedeutende Plasma-Produktionsstätte. Die Qualitätskontrolle für Plasmaprodukte stellt höchste Anforderungen an Laborinfrastruktur.
          </p>

          <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
            <div class="bg-white rounded-xl border border-gray-200 p-6 hover:shadow-lg transition-shadow lg:col-span-2">
              <h3 class="text-xl font-heading font-bold text-slate-900 mb-4">CSL Behring – Standort Bern-Wankdorf</h3>
              <p class="text-gray-600 text-sm leading-relaxed mb-4">
                CSL Behring ist Teil der australischen CSL Group und einer der weltweit führenden Hersteller von Biopharmazeutika aus Humanplasma. Am Standort Bern-Wankdorf werden Plasmaprodukte entwickelt und hergestellt – darunter Gerinnungsfaktoren, Immunglobuline und Albumin.
              </p>
              <p class="text-gray-600 text-sm leading-relaxed mb-4">
                Die Qualitätskontrolle von Plasmaprodukten ist besonders aufwändig: Virusvalidierung, Reinheitsprüfung, Chargenfreigabe – alles unter GMP-Bedingungen. Containerlabore ergänzen bei Produktionsausbauten, Validierungsprojekten und temporären Kapazitätsengpässen.
              </p>
              <p class="text-xs text-gray-400">Quelle: CSL Behring AG, Bern</p>
            </div>

            <div class="space-y-4">
              <div class="bg-slate-50 rounded-xl p-5 border border-gray-100">
                <h4 class="font-bold text-slate-900 text-sm mb-2">Universität Bern</h4>
                <p class="text-gray-600 text-xs leading-relaxed">Medizinische Fakultät mit starker biomedizinischer Forschung. Forschungsgruppen benötigen BSL-2-Labore und Zellkultur-Kapazitäten.</p>
              </div>
              <div class="bg-slate-50 rounded-xl p-5 border border-gray-100">
                <h4 class="font-bold text-slate-900 text-sm mb-2">Bundesinstitute</h4>
                <p class="text-gray-600 text-xs leading-relaxed">Als Bundesstadt beherbergt Bern verschiedene eidgenössische Institutionen mit Forschungs- und Laborinfrastruktur. Containerlabore als temporäre Erweiterung.</p>
              </div>
              <div class="bg-slate-50 rounded-xl p-5 border border-gray-100">
                <h4 class="font-bold text-slate-900 text-sm mb-2">Veterinärmedizin</h4>
                <p class="text-gray-600 text-xs leading-relaxed">Die Vetsuisse-Fakultät in Bern ist ein weiterer Treiber für Laborkapazität – Tiermedizinische Diagnostik und Forschung in einem Gebäudebestand, der an seine Grenzen stösst.</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Section 4: Baubewilligung Kanton Bern -->
    <section class="py-20 bg-slate-50 border-t border-gray-100">
      <div class="container mx-auto px-4">
        <div class="max-w-4xl mx-auto">
          <h2 class="text-3xl font-heading font-bold mb-4 text-slate-900">
            Baubewilligung im Kanton Bern – BauG Art. 1a/1b
          </h2>
          <p class="text-gray-600 text-lg mb-10 leading-relaxed">
            Das Baugesetz des Kantons Bern regelt, welche Bauten bewilligungspflichtig sind und welche Ausnahmen gelten. Für Laborcontainer auf Spital- oder Industriegeländen klären wir die Rechtslage im Vorfeld.
          </p>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
            <div class="bg-white rounded-xl p-6 border border-gray-200">
              <div class="w-10 h-10 bg-slate-900 rounded-lg flex items-center justify-center text-primary mb-4 text-sm font-bold">§</div>
              <h3 class="font-bold text-lg mb-3 text-slate-900">Bewilligungspflicht (Art. 1a BauG)</h3>
              <p class="text-gray-600 text-sm leading-relaxed">
                Jede wesentliche Änderung einer Baute oder Anlage bedarf einer Baubewilligung. Laborcontainer gelten in der Regel als bewilligungspflichtige Bauten. Das Verfahren wird bei der Gemeinde eingeleitet.
              </p>
            </div>
            <div class="bg-white rounded-xl p-6 border border-gray-200">
              <div class="w-10 h-10 bg-slate-900 rounded-lg flex items-center justify-center text-primary mb-4 text-sm font-bold">⚖</div>
              <h3 class="font-bold text-lg mb-3 text-slate-900">Ausnahmen (Art. 1b BauG)</h3>
              <p class="text-gray-600 text-sm leading-relaxed">
                Art. 1b definiert Ausnahmen für bestimmte Vorhaben von geringer Bedeutung. Bei Laboren mit besonderen Sicherheitsanforderungen (BSL, GMP, Gefahrstoffe) greifen diese Ausnahmen in der Regel nicht. Wir prüfen die Anwendbarkeit im Einzelfall.
              </p>
            </div>
          </div>

          <div class="mt-8 bg-primary/5 border border-primary/20 rounded-xl p-6">
            <p class="text-slate-700 text-sm leading-relaxed">
              <strong class="text-slate-900">Unser Service für Bern:</strong> Vorprüfung der Bewilligungslage, Erstellung aller Gesuchsunterlagen, Koordination mit der Baubehörde und dem Inselspital oder CSL Behring als Standortbetreiber. Sie konzentrieren sich auf Ihre Forschung.
            </p>
          </div>
        </div>
      </div>
    </section>

