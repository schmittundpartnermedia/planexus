---
import Layout from '../layouts/Layout.astro';
import ContactForm from '../components/ContactForm.tsx';
import AuthorBio from '../components/AuthorBio.astro';
import CityCrossLinks from '../components/CityCrossLinks.astro';

const title = "Laborcontainer Bern | BSL-3, BAG + Swissmedic | Planexus";
const description = "Laborcontainer Bern: LABtoGO, 2,75 m Innenhöhe, BSL-3, SIA 261, Inselspital + sitem-insel + BAG-Nähe. Ab Werk Albstadt verzollt in 8–14 Wochen.";
const canonical = "/laborcontainer-bern";

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "serviceType": "Laborcontainer und modularer Laborbau Bern",
  "provider": {
    "@type": "Organization",
    "name": "Planexus GmbH",
    "image": "https://planexus.de/android-chrome-512x512.png",
    "url": "https://planexus.de",
    "telephone": "+49 7435 7519 700",
    "email": "info@planexus.de",
    "address": { "@type": "PostalAddress", "streetAddress": "Emil-Mayer-Straße 1", "addressLocality": "Albstadt", "postalCode": "72461", "addressCountry": "DE" },
    "parentOrganization": { "@type": "Organization", "name": "Wesemann Holding GmbH" }
  },
  "areaServed": [
    { "@type": "City", "name": "Bern" },
    { "@type": "AdministrativeArea", "name": "Kanton Bern" },
    { "@type": "Country", "name": "Schweiz" }
  ],
  "description": "Containerlabore, mobile Labore und modulare Laborgebäude für Standorte und Einrichtungen wie die Universität Bern, das Inselspital, sitem-insel, das Bundesamt für Gesundheit BAG, Swissmedic und Agroscope – ab Werk Albstadt verzollt nach Bern über Schaffhausen oder Basel.",
  "offers": { "@type": "AggregateOffer", "priceCurrency": "CHF", "availability": "https://schema.org/InStock" }
};

const localBusinessSchema = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "name": "Planexus GmbH – Laborcontainer Bern",
      "image": "https://planexus.de/images/labtogo-industrie.webp",
  "url": "https://planexus.de/laborcontainer-bern",
  "telephone": "+49 7435 7519 700",
  "email": "info@planexus.de",
  "address": { "@type": "PostalAddress", "streetAddress": "Emil-Mayer-Straße 1", "addressLocality": "Albstadt", "postalCode": "72461", "addressCountry": "DE" },
  "areaServed": { "@type": "City", "name": "Bern", "containedInPlace": { "@type": "Country", "name": "Schweiz" } },
  "priceRange": "CHF",
  "openingHoursSpecification": [{ "@type": "OpeningHoursSpecification", "dayOfWeek": ["Monday","Tuesday","Wednesday","Thursday","Friday"], "opens": "08:00", "closes": "17:00" }]
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Start", "item": "https://planexus.de/" },
    { "@type": "ListItem", "position": 2, "name": "Standorte", "item": "https://planexus.de/standorte" },
    { "@type": "ListItem", "position": 3, "name": "Laborcontainer Bern", "item": "https://planexus.de/laborcontainer-bern" }
  ]
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Wie lange dauert die Lieferung eines Laborcontainers nach Bern vom Werk Albstadt?",
      "acceptedAnswer": { "@type": "Answer", "text": "Die Schwerlastroute Werk Albstadt → Bern führt über die A81 südwärts via Singen, Verzollung am Zollamt Schaffhausen-Thayngen, dann auf Schweizer Seite über A4 → A1 westwärts via Zürich → Solothurn → Bern. Reine Fahrzeit beträgt rund 3,5 Stunden bei circa 220 Kilometern Distanz, mit Verzollung Schaffhausen typischerweise ein Transporttag. Alternativ Verzollung am Zollamt Weil am Rhein und A2 → A1 (~250 km) – wir wählen je nach Tagesauslastung der Zollämter. Standardanlieferpunkte: Inselareal Freiburgstrasse für Inselspital und sitem-insel, Liebefeld für BAG und Agroscope, Länggasse für Universität Bern, Wankdorf für Bundesämter und Industriequartiere. Vom Auftrag bis zur betriebsbereiten Übergabe in Bern vergehen 8 bis 14 Wochen." }
    },
    {
      "@type": "Question",
      "name": "Welche Bewilligungen brauche ich für einen Laborcontainer im Kanton Bern?",
      "acceptedAnswer": { "@type": "Answer", "text": "Im Kanton Bern gilt das Baugesetz Bern (BauG) sowie die Bauverordnung (BauV). Auf städtischer Ebene greift die Bauordnung der Stadt Bern (BO Stadt Bern). Zuständig für die Stadt ist das Bauinspektorat an der Bundesgasse 38, 3011 Bern. Container gelten als Bauten und Anlagen, eine Baubewilligung ist in den meisten Fällen nötig. Bei temporärer Aufstellung unter 3 Monaten ist je nach Standort ein Meldeverfahren möglich. Der grosse Vorteil Berns: Sowohl das Bundesamt für Gesundheit (BAG) als auch Swissmedic sitzen in Bern – bei BSL-3-Containern und GMP-Pilotanlagen ist der Behördenweg deutlich kürzer als von Zürich oder Basel aus. Wir prüfen Ihren Standort vorab und legen verfahrenstaugliche Bauunterlagen vor." }
    },
    {
      "@type": "Question",
      "name": "Was bedeutet die Nähe zu BAG und Swissmedic für GMP- und BSL-3-Container in Bern?",
      "acceptedAnswer": { "@type": "Answer", "text": "Für jedes gentechnische Containment in der Schweiz braucht es eine Anzeige nach Einschliessungsverordnung (ESV) bei BAFU und BAG – das BAG sitzt an der Schwarzenburgstrasse 157, 3003 Bern (Liebefeld). Für jedes GMP-Reinraumcontainer-Projekt mit Heilmittel-Bezug ist Swissmedic an der Hallerstrasse 7, 3012 Bern, die zuständige Inspektionsbehörde. Wenn Ihr Standort in Bern liegt, sind beide Behörden über öffentliche Verkehrsmittel in 15 bis 30 Minuten erreichbar – Vor-Ort-Inspektionen können kurzfristig terminiert werden, schriftliche Rückfragen werden in der Regel in 5 bis 10 Werktagen beantwortet. Aus Zürich oder Basel sind das stets Reisetage – aus Bern eine Tramfahrt. Wir nutzen diese Nähe und reichen unsere Antragsunterlagen direkt mit den richtigen Sachbearbeitern ab." }
    },
    {
      "@type": "Question",
      "name": "Welche Erdbeben- und Energie-Anforderungen gelten für Laborcontainer in Bern nach SIA 261 / SIA 380/1?",
      "acceptedAnswer": { "@type": "Answer", "text": "Bern liegt nach SIA 261 in Erdbebenzone Z1a mit einer horizontalen Bemessungs-Bodenbeschleunigung von agd = 0,6 m/s² – wie Zürich, deutlich tiefer als Basel (Z2, agd 1,0 m/s²). Statisch-konstruktiv ist die Anforderung also moderat, allerdings müssen Container für das Inselspital oder sitem-insel in Bauwerksklasse II eingestuft werden, weil hier sicherheitsrelevante Funktionen abgebildet werden. SIA 380/1 (Thermische Energie im Hochbau) verlangt ähnlich strenge U-Werte wie in Zürich – die deutsche GEG reicht nicht. Wir liefern für Bern statisch nach SIA 261 mit Z1a-Faktor und SIA 263-Verankerungskonzept sowie energetisch nach SIA 380/1 mit U ≤ 0,17 W/m²K und Wärmerückgewinnung ≥ 75 % – verfahrenstauglich für das Bauinspektorat Bundesgasse 38." }
    },
    {
      "@type": "Question",
      "name": "Wie funktioniert die Verzollung Schaffhausen-Thayngen für Container nach Bern?",
      "acceptedAnswer": { "@type": "Answer", "text": "Wir verzollen über T1-Versandverfahren mit Abfertigung am Zollamt Thayngen (DE-Seite) und Schaffhausen-Thayngen (CH-Seite). Bei dauerhafter Einfuhr fällt die Schweizer Mehrwertsteuer von 8,1 Prozent an (Stand 2026). Bei temporärer Einfuhr (zum Beispiel Mietcontainer für eine klinische Studie am Inselspital, eine zeitlich befristete Lehr-Reinraum-Anwendung an der Universität Bern oder ein Pilotcontainer bei sitem-insel) ist eine Verzollung im Verfahren der vorübergehenden Verwendung mit ATA-Carnet möglich – ohne MwSt, mit Sicherheitsleistung. Thayngen ist von Albstadt aus die direkteste Route nach Bern (~220 km, ~3,5 h)." }
    },
    {
      "@type": "Question",
      "name": "Welche Anwendungen sind in Bern besonders nachgefragt?",
      "acceptedAnswer": { "@type": "Answer", "text": "Bern ist das Public-Health- und Translational-Medicine-Zentrum der Schweiz. Typische Einsatzfelder für Laborcontainer ergeben sich rund um Standorte wie das Inselspital (Universitätsspital Bern, Freiburgstrasse 18, 3010 Bern, rund 8.500 Mitarbeitende, zweitgrösstes Spital der Schweiz nach USZ) – BSL-2-Studien-Container während Klinik-Sanierungen und Pandemie-Vorhaltung; sitem-insel (Swiss Institute for Translational and Entrepreneurial Medicine, Freiburgstrasse 3, 3010 Bern, direkt auf dem Inselareal) – translationale Forschungs-Container an der Schnittstelle Universitätsspital, Universität, Industrie und Start-ups; die Universität Bern (Hauptgebäude Hochschulstrasse 4, 3012 Bern, ~19.000 Studierende, 8 Fakultäten) und das Department of Biomedical Research DBM (Murtenstrasse 35, 3008 Bern) – BSL-2-Forschungscontainer und SNF-Drittmittelprojekte; das Bundesamt für Gesundheit BAG (Schwarzenburgstrasse 157, 3003 Bern-Liebefeld) und das Bundesamt für Lebensmittelsicherheit BLV (Schwarzenburgstrasse 155) – Public-Health-Container und Pandemie-Vorbereitung; Swissmedic (Hallerstrasse 7, 3012 Bern) – interne Lehr- und Inspektionscontainer; sowie Agroscope (Forschungsanstalt Liebefeld-Posieux/Reckenholz/Tänikon) – Lebensmittelsicherheits- und Veterinär-Container." }
    },
    {
      "@type": "Question",
      "name": "Können Sie BSL-3-Container für das Inselspital oder sitem-insel liefern?",
      "acceptedAnswer": { "@type": "Answer", "text": "Ja. Wir bauen BSL-3-Container für klinische Forschung, infektiologische Diagnostik und translationale Pharma-Pilotierung im Werk Albstadt – HEPA-H14-Doppelfilterung, autoklavierte Schleuse, Unterdruck mit Drei-Stufen-Kaskade, Notstromversorgung und Datenlogger. Anzeige nach Einschliessungsverordnung (ESV) bei BAFU und BAG – aufgrund der BAG-Nähe in Bern in der Regel beschleunigt. Statik nach SIA 261 Z1a + 263, Energie nach SIA 380/1, Brandschutz nach VKF. Für Studien-Container an einem Standort wie dem Inselspital wäre die Abstimmung mit der Bau-Direktion der Insel Gruppe erforderlich, für sitem-insel mit der zuständigen Translational-Medicine-Abteilung. IQ/OQ/PQ Swissmedic-tauglich – die kurze Behördendistanz in Bern kann dabei von Vorteil sein." }
    }
  ]
};
---

<Layout title={title} description={description} canonical={canonical}>
  <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(localBusinessSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <div class="bg-white">

    <!-- HERO -->
    <section class="relative bg-slate-900 text-white overflow-hidden">
      <div class="relative z-10 container mx-auto px-4 py-20 md:py-28">
        <div class="max-w-4xl">
          <nav class="flex items-center gap-2 text-sm text-gray-400 mb-8" aria-label="Breadcrumb">
            <a href="/" class="hover:text-primary transition-colors">Start</a>
            <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m9 18 6-6-6-6"/></svg>
            <span>Standorte</span>
            <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m9 18 6-6-6-6"/></svg>
            <span class="text-primary">Bern</span>
          </nav>

          <div class="text-primary font-medium text-sm uppercase tracking-wider mb-4">Ihr Spezialist für Laborcontainer · Bundeshauptstadt mit BAG + Swissmedic vor Ort</div>

          <h1 class="text-4xl md:text-5xl lg:text-6xl font-heading font-bold mb-6 leading-tight">
            Laborcontainer Bern – Inselareal-nahe BSL-3-Labore mit BAG- und Swissmedic-Direktzugang
          </h1>

          <p class="text-xl text-gray-300 leading-relaxed mb-4">
            <strong class="text-white">Ihr Fachplaner für Containerlabore mit mehr als 10 Jahren Erfahrung.</strong> Modular, SIA-261-konform, T1-verzollt. Wir realisieren flexible Forschungs-, Klinik- und Public-Health-Umgebungen für Standorte und Einrichtungen wie das Inselspital, sitem-insel, die Universität Bern, das Bundesamt für Gesundheit BAG, Swissmedic und Agroscope – aus dem Werk Albstadt direkt nach Bern, über A81 und Verzollung Schaffhausen-Thayngen in nur 220 km.
          </p>
          <p class="text-base text-gray-400 mb-8">Während andere noch planen, forschen Sie bereits.</p>

          <div class="flex flex-col sm:flex-row gap-4 mb-8">
            <a href="#anfrage" data-testid="button-cta-hero" class="bg-primary text-slate-900 font-bold px-8 py-4 rounded-lg hover:bg-primary/90 transition-colors inline-flex items-center justify-center gap-2 shadow-[0_0_20px_rgba(132,189,0,0.3)]">Kostenfreies Standort-Audit Bern<svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg></a>
            <a href="tel:+4974357519700" class="border border-white/20 text-white font-medium px-8 py-4 rounded-lg hover:bg-white/10 transition-colors inline-flex items-center justify-center gap-2"><svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>+49 7435 7519 700</a>
          </div>

          <div class="flex flex-wrap items-center gap-x-6 gap-y-2 text-sm text-gray-400">
            <div class="flex items-center gap-2"><svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6 9 17l-5-5"/></svg>Pioniere im Modulbau seit 2016</div>
            <div class="flex items-center gap-2"><svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6 9 17l-5-5"/></svg>Award 2026 EU Business News</div>
            <div class="flex items-center gap-2"><svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6 9 17l-5-5"/></svg>Verzollung Schaffhausen inkl.</div>
            <div class="flex items-center gap-2"><svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6 9 17l-5-5"/></svg>Wesemann-Gruppe · 60+ Jahre Laborbau</div>
          </div>
        </div>
      </div>
    </section>

    <AuthorBio city="Bern" />

    <!-- LABtoGO -->
    <section class="py-16 md:py-20 bg-gradient-to-br from-primary/5 via-white to-primary/10 border-y border-primary/20">
      <div class="container mx-auto px-4">
        <div class="max-w-5xl mx-auto">
          <div class="grid md:grid-cols-2 gap-10 items-center mb-10">
            <div>
              <div class="text-primary font-bold text-sm uppercase tracking-wider mb-3">Pattern-Interrupt · Weltpremiere analytica 2026</div>
              <h2 class="text-3xl md:text-4xl font-heading font-bold mb-4 text-slate-900">Planexus zeigt Bern, was ein Laborcontainer 2026 wirklich kann</h2>
              <p class="text-lg text-gray-700 leading-relaxed mb-4">Ein gewöhnlicher Laborcontainer hat 2.400 mm Innenhöhe. Aufrecht arbeiten unter einem Abzug ist mühsam.</p>
              <p class="text-lg text-slate-900 font-bold leading-relaxed mb-4">Der LABtoGO von Planexus hat 2.750 mm Innenhöhe. 9,5 m Außenlänge. 3 m Außenbreite. Vollverglaste Front, die echtes Tageslicht in jedes Berner Insel-, sitem-, Uni- oder BAG-Forschungslabor bringt.</p>
              <p class="text-lg text-gray-700 leading-relaxed"><strong>Ein gewöhnlicher Laborcontainer passt komplett in einen LABtoGO hinein.</strong> Wir konfigurieren ihn für Bern nach SIA 261 Erdbebenzone Z1a, SIA 380/1 Energie strenger als die deutsche GEG, Verzollung T1 ab Werk Albstadt über Schaffhausen-Thayngen und T13/T15-Schweizer-Stromanschluss nach NIN 2020.</p>
            </div>
            <div class="grid grid-cols-2 gap-4">
              <div class="bg-slate-900 text-white rounded-2xl p-6 text-center"><div class="text-4xl font-bold text-primary mb-1">2.750</div><div class="text-xs text-gray-400 uppercase tracking-wider">mm Innenhöhe</div><div class="text-xs text-gray-500 mt-1">Standard: 2.400 mm</div></div>
              <div class="bg-slate-900 text-white rounded-2xl p-6 text-center"><div class="text-4xl font-bold text-primary mb-1">9.500</div><div class="text-xs text-gray-400 uppercase tracking-wider">mm Außenlänge</div><div class="text-xs text-gray-500 mt-1">3.000 mm Breite</div></div>
              <div class="bg-slate-900 text-white rounded-2xl p-6 text-center"><div class="text-4xl font-bold text-primary mb-1">SIA Z1a</div><div class="text-xs text-gray-400 uppercase tracking-wider">Erdbeben agd 0,6 m/s²</div><div class="text-xs text-gray-500 mt-1">wie Zürich</div></div>
              <div class="bg-slate-900 text-white rounded-2xl p-6 text-center"><div class="text-4xl font-bold text-primary mb-1">220 km</div><div class="text-xs text-gray-400 uppercase tracking-wider">Werk → Bern</div><div class="text-xs text-gray-500 mt-1">3,5 h via Thayngen</div></div>
            </div>
          </div>
          <div class="text-center"><a href="/laborcontainer/labtogo" class="inline-flex items-center gap-2 text-primary font-bold hover:underline">LABtoGO Plattform und alle Konfigurationen ansehen<svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg></a></div>
        </div>
      </div>
    </section>

    <!-- PROBLEM-AGITATION -->
    <section class="py-16 md:py-20">
      <div class="container mx-auto px-4">
        <div class="max-w-5xl mx-auto">
          <h2 class="text-3xl md:text-4xl font-heading font-bold mb-10 text-slate-900">Planexus löst die drei Berner Engpässe, an denen Public-Health- und Klinik-Container regelmässig scheitern</h2>
          <div class="grid md:grid-cols-3 gap-6">
            <div class="bg-slate-50 border-l-4 border-primary rounded-xl p-6">
              <div class="text-slate-900 font-bold text-lg mb-2">BAG- und Swissmedic-Nähe falsch genutzt</div>
              <p class="text-gray-700 text-sm leading-relaxed">Beide Schweizer Bundesgesundheitsbehörden – BAG (Schwarzenburgstrasse 157, Liebefeld) und Swissmedic (Hallerstrasse 7) – sitzen in Bern. Das ist ein gewaltiger Vorteil für ESV-Anzeigen, GMP-Inspektionen und Heilmittel-Zulassungen. Wer Standardspediteure aus Zürich oder Basel beauftragt, lässt diesen Vorteil komplett liegen und macht aus Tagen Wochen.</p>
              <p class="text-sm text-slate-900 font-semibold mt-3 pt-3 border-t border-gray-200">Planexus-Antwort: Antragsunterlagen direkt bei BAG/Swissmedic eingereicht, Vor-Ort-Termine in Bern.</p>
            </div>
            <div class="bg-slate-50 border-l-4 border-primary rounded-xl p-6">
              <div class="text-slate-900 font-bold text-lg mb-2">Inselareal Freiburgstrasse – Klinik + Translational gemeinsam</div>
              <p class="text-gray-700 text-sm leading-relaxed">Das Inselspital (Freiburgstrasse 18) und sitem-insel (Freiburgstrasse 3) liegen direkt nebeneinander – einzigartig in der Schweiz. Container, die hier landen, müssen gleichzeitig Klinik-tauglich (USB-Hygiene, BSL-2/3) und translational-tauglich (Pharma-Pilot, IP-Schutz, ISO 14644) sein. Standardcontainer können das eine oder das andere – nie beides.</p>
              <p class="text-sm text-slate-900 font-semibold mt-3 pt-3 border-t border-gray-200">Planexus-Antwort: Hybrid-Container Klinik+Translational ab Werk Albstadt.</p>
            </div>
            <div class="bg-slate-50 border-l-4 border-primary rounded-xl p-6">
              <div class="text-slate-900 font-bold text-lg mb-2">SIA + Verzollung Schaffhausen – Schweizer Standards ab Tag 1</div>
              <p class="text-gray-700 text-sm leading-relaxed">Schweizer Bauinspektorate akzeptieren keine reine DIN-Statik. SIA 261 Z1a, SIA 263 Verankerung, SIA 380/1 Energie – und Verzollung Schaffhausen-Thayngen mit T1 oder ATA-Carnet (CH-MwSt 8,1 % oder ohne MwSt). Spediteure, die Schweizer Verzollung als Pauschale rechnen, liegen oft tausende CHF daneben.</p>
              <p class="text-sm text-slate-900 font-semibold mt-3 pt-3 border-t border-gray-200">Planexus-Antwort: SIA-Statik + SIA-Energie + transparente Verzollung Schaffhausen ab Werk.</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- STRATEGISCHE FUSION -->
    <section class="py-16 md:py-20 bg-slate-50">
      <div class="container mx-auto px-4">
        <div class="max-w-4xl mx-auto">
          <h2 class="text-3xl md:text-4xl font-heading font-bold mb-8 text-slate-900">Laborcontainer für Bern: Was BAG, Swissmedic, Inselspital und sitem-insel vom Engineering verlangen</h2>
          <div class="prose prose-lg max-w-none text-gray-700 space-y-6">
            <p><strong>Bern ist die Bundeshauptstadt der Schweiz – und das Public-Health-, Heilmittel- und Translational-Medicine-Zentrum des Landes.</strong> Hier sitzen das Bundesamt für Gesundheit BAG (Schwarzenburgstrasse 157, 3003 Bern, im Stadtteil Liebefeld), das CH-Pendant zu BfArM, RKI und PEI in Personalunion. Hier sitzt Swissmedic (Hallerstrasse 7, 3012 Bern), die Schweizer Heilmittelaufsicht. Hier sitzt das Bundesamt für Lebensmittelsicherheit und Veterinärwesen BLV (Schwarzenburgstrasse 155). Und hier sitzen das Inselspital (Universitätsspital Bern, Freiburgstrasse 18, 3010 Bern, ~8.500 Mitarbeitende, zweitgrösstes Spital der Schweiz nach USZ), sitem-insel (Swiss Institute for Translational and Entrepreneurial Medicine, Freiburgstrasse 3, 3010 Bern, direkt auf dem Inselareal), die Universität Bern (Hauptgebäude Hochschulstrasse 4, 3012 Bern, ~19.000 Studierende, 8 Fakultäten), das Department of Biomedical Research DBM (Murtenstrasse 35, 3008 Bern), das Theodor Kocher Institute der Universität sowie die Forschungsanstalt Agroscope (Standorte Liebefeld, Posieux, Reckenholz, Tänikon).</p>
            <p><strong>Planexus baut für diesen Markt seit 2016.</strong> Wir wissen, dass das Bauinspektorat der Stadt Bern an der Bundesgasse 38, 3011 Bern, nach Baugesetz BauG und Bauverordnung BauV des Kantons Bern entscheidet. Wir wissen, dass SIA 261 für Bern Erdbebenzone Z1a mit agd = 0,6 m/s² definiert – moderat, aber Bauwerksklasse II für Inselspital- und sitem-insel-Standorte ist Pflicht. Wir wissen, dass Container für klinische Forschung am Inselspital praktisch immer gleichzeitig Klinik-tauglich (Hygienestandards der Insel Gruppe) und Studien-tauglich (IRB-konforme Datenintegrität) sein müssen. Wir kennen den entscheidenden Berner Vorteil: BAG- und Swissmedic-Sachbearbeiter sind in 15 Minuten per Tram erreichbar – Vor-Ort-Inspektionen für ESV (BSL-3) und GMP (Heilmittel) lassen sich kurzfristig terminieren, schriftliche Rückfragen werden in 5 bis 10 Werktagen beantwortet. Aus Zürich oder Basel sind das Reisetage – aus Bern Tramfahrten. Diese Details stehen nicht in unserem Angebot – sie sind das Engineering- und Behördenfundament jedes Containers, der unser Werk Albstadt verlässt.</p>
            <p><strong>Made in Albstadt, verzollt in Schaffhausen-Thayngen, schlüsselfertig in Bern.</strong> Endmontage und Innenausbau erfolgen mit Wesemann-Möbeln im eigenen Werk – Werksbesichtigung beidseitig planbar. Über die A81 südwärts via Singen, Verzollung am Zollamt Thayngen, dann auf Schweizer Seite über A4 → A1 westwärts via Zürich → Solothurn → Bern beträgt die Schwerlastdistanz rund 220 Kilometer (~3,5 h). Standardanlieferpunkte: Inselareal Freiburgstrasse für Inselspital und sitem-insel, Liebefeld für BAG und Agroscope, Länggasse für Universität Bern, Murtenstrasse für DBM, Wankdorf für Bundesämter und Industrie.</p>
            <p>Ob Sie ein <strong>mobiles Labor Bern</strong> für eine befristete Inselspital-Sanierungsphase brauchen, einen <strong>modularen Laborcontainer Bern</strong> für die translationale Forschung an sitem-insel oder ein <strong>Containerlabor Bern</strong> mit BSL-3-Containment und Swissmedic-tauglicher GMP für Berner Pharma-Spinoffs – wir liefern alle drei Antworten aus derselben Plattform: dem LABtoGO unseres Werks Albstadt, mit Schweizer Verzollungs-, SIA-Statik-, SIA-Energie- und BAG-/Swissmedic-Behördenpfad ab Werk dokumentiert.</p>
