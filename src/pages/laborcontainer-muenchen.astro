---
import Layout from '../layouts/Layout.astro';

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": "Laborcontainer München",
  "description": "Mobile Containerlabore für Münchens Pharma- und Biotech-Cluster. GMP-Reinräume, BSL-2/BSL-3, Interimslabore für Martinsried, Großhadern und den Pharma-Korridor Südbayern.",
  "provider": {
    "@type": "Organization",
    "name": "Planexus GmbH",
    "url": "https://www.planexus.de"
  },
  "areaServed": [
    { "@type": "City", "name": "München" },
    { "@type": "State", "name": "Bayern" }
  ],
  "serviceType": ["Laborcontainer", "GMP-Reinraum", "BSL-2 Container", "BSL-3 Container", "Pharma-Labor"],
  "url": "https://www.planexus.de/laborcontainer-muenchen"
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Start", "item": "https://www.planexus.de/" },
    { "@type": "ListItem", "position": 2, "name": "Laborcontainer München", "item": "https://www.planexus.de/laborcontainer-muenchen" }
  ]
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Können Laborcontainer GMP-Anforderungen erfüllen?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Ja. Unsere Containerlabore sind so konzipiert, dass sie die Anforderungen der Guten Herstellungspraxis (GMP) nach EU-GMP-Leitfaden Annex 1 erfüllen können. Das umfasst kontrollierte Reinraumklassen, qualifizierte Lüftungstechnik, glatte und desinfizierfähige Oberflächen sowie lückenlose Dokumentation. Für den Münchner Pharma-Standort ist das besonders relevant."
      }
    },
    {
      "@type": "Question",
      "name": "Ist eine Baugenehmigung für Laborcontainer in Bayern erforderlich?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Die Bayerische Bauordnung (BayBO) regelt in Art. 57 die verfahrensfreien Bauvorhaben. Temporäre bauliche Anlagen können unter bestimmten Voraussetzungen ohne Baugenehmigung aufgestellt werden. Bei Laboren mit Gefahrstoffen oder als Sonderbauten ist in der Regel ein Bauantrag bei der unteren Bauaufsichtsbehörde – in München beim Referat für Stadtplanung und Bauordnung – erforderlich. Wir klären die Genehmigungslage vorab."
      }
    },
    {
      "@type": "Question",
      "name": "Wie weit ist es von Albstadt nach München?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Unser Werk in Albstadt liegt nur rund 200 km von München entfernt – etwa 2,5 Stunden über die A8. Das macht München zu einem unserer am schnellsten erreichbaren Standorte. Kurze Wege bedeuten: schnellere Projektabwicklung, unkomplizierte Standortbegehungen und reduzierte Transportkosten."
      }
    },
    {
      "@type": "Question",
      "name": "Gibt es Laborcontainer für den Biotech-Campus Martinsried?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Ja. Für den Campus Martinsried mit seinem Cluster aus LMU-Instituten, Max-Planck-Instituten und Biotech-Startups bieten wir Containerlabore, die sich in die vorhandene Infrastruktur einfügen. Ob Zellkultur-Labor, Analytik oder BSL-2-Arbeitsplatz – wir planen passend zum jeweiligen Forschungsbedarf."
      }
    },
    {
      "@type": "Question",
      "name": "Was kostet ein Laborcontainer in München?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Die Kosten hängen von Ausstattung, Größe und Sicherheitsstufe ab. Ein einfaches Analytiklabor liegt in einer anderen Größenordnung als ein GMP-Reinraum. Durch die kurze Distanz von Albstadt nach München sind die Transportkosten geringer als bei norddeutschen Standorten. Sprechen Sie mit uns – wir nennen Ihnen nach der Bedarfsanalyse eine belastbare Größenordnung."
      }
    },
    {
      "@type": "Question",
      "name": "Können Laborcontainer für die analytica-Messe genutzt werden?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Ja. Einige unserer Kunden nutzen Containerlabore als funktionsfähige Demonstrationseinheiten oder temporäre Laborerweiterungen rund um die analytica. Die Messe findet alle zwei Jahre in München statt – zuletzt 2024 mit über 1.000 Ausstellern und 34.000 Fachbesuchern. Wir unterstützen bei der Planung und Logistik."
      }
    }
  ]
};

const localBusinessSchema = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "name": "Planexus GmbH – Laborcontainer München",
  "description": "Laborcontainer für München, Oberbayern und den Pharma-Korridor Südbayern. GMP-Reinräume, Biotech-Labore und BSL-Container.",
  "url": "https://www.planexus.de",
  "telephone": "+49 7435 7519 700",
  "email": "info@planexus.de",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "Am Steinbach 8",
    "addressLocality": "Albstadt",
    "postalCode": "72459",
    "addressCountry": "DE"
  },
  "areaServed": [
    { "@type": "City", "name": "München" },
    { "@type": "State", "name": "Bayern" }
  ]
};
---

<Layout
  title="Laborcontainer München – Pharma, Biotech & GMP-Reinraum | Planexus GmbH"
  description="Containerlabore für Münchens Pharma-Cluster: Martinsried, Großhadern, Roche Penzberg. GMP-konform, BSL-2/BSL-3, 200 km ab Werk. Ihr Fachplaner für bayerische Laborinfrastruktur."
  canonical="/laborcontainer-muenchen"
  schema={serviceSchema}
  ogImage="/attached_assets/Kopf_green-scaled_1768306688943.jpg"
>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} slot="head" />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} slot="head" />
  <script type="application/ld+json" set:html={JSON.stringify(localBusinessSchema)} slot="head" />

  <div class="pt-20 min-h-screen bg-white">

    <!-- Hero: Pharma-Pipeline-Narrativ -->
    <section class="relative py-32 bg-slate-900 text-white overflow-hidden">
      <div class="absolute inset-0 bg-gradient-to-br from-primary/10 via-transparent to-transparent"></div>
      <div class="absolute top-0 right-0 w-96 h-96 bg-primary/5 rounded-full blur-[100px]"></div>

      <div class="container mx-auto px-4 relative z-10">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
          <div>
            <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-white/10 text-primary text-sm font-medium mb-8 backdrop-blur-sm border border-white/10">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
              München & Oberbayern
            </div>
            <h1 class="text-4xl md:text-5xl font-heading font-bold mb-6 leading-tight">
              Bayerns Pharma-Standort braucht <span class="text-primary">flexible Labore</span>
            </h1>
            <p class="text-xl text-gray-300 mb-4 leading-relaxed font-light">
              540 Biotech- und Pharmaunternehmen, zwei Max-Planck-Institute, das Helmholtz Zentrum und Deutschlands größter Diagnostik-Standort – alles im Umkreis von 50 Kilometern. München ist Deutschlands Pharma-Hauptstadt. Und Laborraum ist Mangelware.
            </p>
            <p class="text-lg text-gray-400 mb-10">
              Unser Werk in Albstadt liegt nur 200 km entfernt. Kein Standort in Deutschland ist schneller versorgt.
            </p>
            <div class="flex flex-col sm:flex-row gap-4">
              <a href="/kontakt" class="bg-primary text-slate-900 font-bold px-8 py-4 rounded-lg hover:bg-primary/90 transition-colors flex items-center justify-center gap-2 group shadow-[0_0_20px_rgba(187,215,0,0.3)]">
                Pharma-Projekt besprechen
                <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 group-hover:translate-x-1 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
              </a>
              <a href="tel:+4974357519700" class="border border-white/20 text-white font-medium px-8 py-4 rounded-lg hover:bg-white/10 transition-colors backdrop-blur-sm flex items-center justify-center gap-2">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
                +49 7435 7519 700
              </a>
            </div>
          </div>
          <div class="hidden lg:block">
            <div class="bg-white/5 backdrop-blur-sm border border-white/10 rounded-2xl p-8">
              <h3 class="text-primary font-heading font-bold text-lg mb-6">Pharma-Cluster München in Zahlen</h3>
              <div class="grid grid-cols-2 gap-6">
                <div>
                  <div class="text-3xl font-heading font-bold">540</div>
                  <p class="text-gray-400 text-sm mt-1">Biotech- & Pharma-Unternehmen in Bayern</p>
                </div>
                <div>
                  <div class="text-3xl font-heading font-bold">910 Mio.</div>
                  <p class="text-gray-400 text-sm mt-1">EUR Risikokapital 2024 – bayerisches Rekordjahr</p>
                </div>
                <div>
                  <div class="text-3xl font-heading font-bold">~57.000</div>
                  <p class="text-gray-400 text-sm mt-1">Beschäftigte im bayerischen Biotech-Cluster</p>
                </div>
                <div>
                  <div class="text-3xl font-heading font-bold">~200 km</div>
                  <p class="text-gray-400 text-sm mt-1">Albstadt → München – unser kürzester Großstadt-Transport</p>
                </div>
              </div>
              <p class="text-gray-500 text-xs mt-6">Quelle: BioM Biotech Cluster Development, Report 2024/25</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Breadcrumb -->
    <nav class="bg-gray-50 border-b border-gray-100 py-3">
      <div class="container mx-auto px-4">
        <ol class="flex items-center gap-2 text-sm text-gray-500">
          <li><a href="/" class="hover:text-primary transition-colors">Start</a></li>
          <li><svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg></li>
          <li class="text-primary font-medium">Laborcontainer München</li>
        </ol>
      </div>
    </nav>

    <!-- Section 1: Wo Container in die Pharma-Wertschöpfungskette passen -->
    <section class="py-20 bg-white">
      <div class="container mx-auto px-4">
        <div class="max-w-5xl mx-auto">
          <h2 class="text-3xl md:text-4xl font-heading font-bold mb-6 text-slate-900">
            Von der Wirkstoffforschung bis zur Chargenfreigabe – wo ein Containerlabor ansetzt
          </h2>
          <p class="text-gray-600 text-lg mb-12 leading-relaxed max-w-3xl">
            Die pharmazeutische Wertschöpfungskette ist lang und reguliert. An mehreren Stellen entstehen Engpässe, die ein Containerlabor gezielt auflöst – schneller als jeder Neubau und flexibler als jede Anmietung.
          </p>

          <div class="relative">
            <div class="hidden md:block absolute left-8 top-0 bottom-0 w-0.5 bg-gradient-to-b from-primary via-primary/50 to-primary/10"></div>

            <div class="space-y-12">
              <div class="md:pl-20 relative">
                <div class="hidden md:flex absolute left-4 w-8 h-8 bg-primary rounded-full items-center justify-center text-slate-900 font-bold text-sm">1</div>
                <div class="bg-slate-50 rounded-xl p-8 border border-gray-100">
                  <div class="flex items-center gap-3 mb-3">
                    <h3 class="text-xl font-heading font-bold text-slate-900">Präklinische Forschung & Wirkstoff-Screening</h3>
                    <span class="bg-primary/10 text-[#7a9900] text-xs font-bold px-3 py-1 rounded-full">Phase 0</span>
                  </div>
                  <p class="text-gray-600 leading-relaxed">
                    Am Campus Martinsried untersuchen Institute wie das Max-Planck-Institut für Biochemie (~750 Mitarbeitende, davon ~350 Wissenschaftler:innen aus über 50 Nationen) und das LMU Biomedizinische Centrum (18.000 m², 8 Lehrstühle, eröffnet 2015) potenzielle Wirkstoffkandidaten. Ein Laborcontainer dient hier als Erweiterung für Zellkultur, Hochdurchsatz-Screening oder Probenaufbereitung – ohne den laufenden Laborbetrieb zu stören.
                  </p>
                </div>
              </div>

              <div class="md:pl-20 relative">
                <div class="hidden md:flex absolute left-4 w-8 h-8 bg-primary rounded-full items-center justify-center text-slate-900 font-bold text-sm">2</div>
                <div class="bg-slate-50 rounded-xl p-8 border border-gray-100">
                  <div class="flex items-center gap-3 mb-3">
                    <h3 class="text-xl font-heading font-bold text-slate-900">Klinische Studien & Diagnostik</h3>
                    <span class="bg-primary/10 text-[#7a9900] text-xs font-bold px-3 py-1 rounded-full">Phase I–III</span>
                  </div>
                  <p class="text-gray-600 leading-relaxed">
                    Das LMU Klinikum Großhadern versorgt jährlich rund 500.000 Patient:innen in 28 Fachkliniken und zählt zu den forschungsstärksten Universitätsklinika Europas. Klinische Studien erfordern dedizierte Laborkapazitäten für Probenverarbeitung, Biomarker-Analytik und Begleitdiagnostik. Ein BSL-2-Containerlabor auf dem Klinikgelände schafft zusätzliche Kapazität, ohne in den Klinikbetrieb einzugreifen.
                  </p>
                </div>
              </div>

              <div class="md:pl-20 relative">
                <div class="hidden md:flex absolute left-4 w-8 h-8 bg-primary rounded-full items-center justify-center text-slate-900 font-bold text-sm">3</div>
                <div class="bg-slate-50 rounded-xl p-8 border border-gray-100">
                  <div class="flex items-center gap-3 mb-3">
                    <h3 class="text-xl font-heading font-bold text-slate-900">GMP-Produktion & Qualitätskontrolle</h3>
                    <span class="bg-primary/10 text-[#7a9900] text-xs font-bold px-3 py-1 rounded-full">Produktion</span>
                  </div>
                  <p class="text-gray-600 leading-relaxed">
                    Roche betreibt in Penzberg (~40 km südlich, ~7.700 Beschäftigte aus über 80 Nationen) einen der größten Biotech-Produktionsstandorte Europas. Für die Qualitätskontrolle bei Chargenfreigaben, Stabilitätsstudien oder Prozessvalidierungen braucht es dedizierte Laborfläche – oft schneller, als ein Anbau geplant werden kann. Ein GMP-konformer Reinraumcontainer ist in 10–16 Wochen betriebsbereit.
                  </p>
                </div>
              </div>

              <div class="md:pl-20 relative">
                <div class="hidden md:flex absolute left-4 w-8 h-8 bg-primary rounded-full items-center justify-center text-slate-900 font-bold text-sm">4</div>
                <div class="bg-slate-50 rounded-xl p-8 border border-gray-100">
                  <div class="flex items-center gap-3 mb-3">
                    <h3 class="text-xl font-heading font-bold text-slate-900">Post-Market-Analytik & Umgebungsmonitoring</h3>
                    <span class="bg-primary/10 text-[#7a9900] text-xs font-bold px-3 py-1 rounded-full">Phase IV</span>
                  </div>
                  <p class="text-gray-600 leading-relaxed">
                    Nach der Zulassung läuft das Monitoring weiter: Stabilitätstests, Rückhalteproben, Umgebungsüberwachung in Produktionsräumen. Unternehmen wie Sandoz/Hexal in Holzkirchen oder Biotech-Startups in Martinsried nutzen Containerlabore als dedizierte Analytik-Einheiten – getrennt von der Produktion und GMP-konform dokumentiert.
                  </p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Section 2: Campus Martinsried Deep Dive -->
    <section class="py-20 bg-slate-900 text-white">
      <div class="container mx-auto px-4">
        <div class="max-w-6xl mx-auto">
          <span class="text-primary text-sm font-bold uppercase tracking-wider">Münchens Life-Science-Epizentrum</span>
          <h2 class="text-3xl md:text-4xl font-heading font-bold mt-3 mb-6">
            Campus Martinsried – Europas dichtestes Biotech-Cluster
          </h2>
          <p class="text-gray-400 text-lg leading-relaxed mb-12 max-w-3xl">
            Auf dem Campus Martinsried/Planegg sind Grundlagenforschung, klinische Forschung und unternehmerische Innovation auf einem Standort vereint. Die Dichte an wissenschaftlicher Exzellenz ist in Europa nahezu einmalig.
          </p>

          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            <div class="bg-white/5 border border-white/10 rounded-xl p-6 hover:border-primary/30 transition-colors">
              <h3 class="font-heading font-bold text-lg mb-3">Max-Planck-Institut für Biochemie</h3>
              <div class="space-y-2 text-sm mb-4">
                <div class="flex justify-between"><span class="text-gray-400">Mitarbeitende</span><span class="text-white font-medium">~750</span></div>
                <div class="flex justify-between"><span class="text-gray-400">Wissenschaftler:innen</span><span class="text-white font-medium">~350</span></div>
                <div class="flex justify-between"><span class="text-gray-400">Nationen</span><span class="text-white font-medium">50+</span></div>
              </div>
              <p class="text-gray-400 text-sm">Eines der größten Institute der Max-Planck-Gesellschaft. Schwerpunkte: Proteomik, Strukturbiologie, zelluläre Biochemie.</p>
            </div>

            <div class="bg-white/5 border border-white/10 rounded-xl p-6 hover:border-primary/30 transition-colors">
              <h3 class="font-heading font-bold text-lg mb-3">LMU Biomedizinisches Centrum</h3>
              <div class="space-y-2 text-sm mb-4">
                <div class="flex justify-between"><span class="text-gray-400">Eröffnung</span><span class="text-white font-medium">2015</span></div>
                <div class="flex justify-between"><span class="text-gray-400">Fläche</span><span class="text-white font-medium">18.000 m²</span></div>
                <div class="flex justify-between"><span class="text-gray-400">Lehrstühle</span><span class="text-white font-medium">8</span></div>
              </div>
              <p class="text-gray-400 text-sm">Vereint acht Lehrstühle der Medizinischen Fakultät. Forschungsschwerpunkte: Molekulare Medizin, Zellbiologie, Physiologie.</p>
            </div>

            <div class="bg-white/5 border border-white/10 rounded-xl p-6 hover:border-primary/30 transition-colors">
              <h3 class="font-heading font-bold text-lg mb-3">Max-Planck-Institut für Neurobiologie</h3>
              <div class="space-y-2 text-sm mb-4">
                <div class="flex justify-between"><span class="text-gray-400">Standort</span><span class="text-white font-medium">Martinsried</span></div>
                <div class="flex justify-between"><span class="text-gray-400">Schwerpunkt</span><span class="text-white font-medium">Neurowissenschaften</span></div>
                <div class="flex justify-between"><span class="text-gray-400">Status</span><span class="text-white font-medium">Max-Planck-Institut</span></div>
              </div>
              <p class="text-gray-400 text-sm">Grundlagenforschung zu neuronalen Schaltkreisen, synaptischer Plastizität und Verhaltensbiologie.</p>
            </div>

            <div class="bg-white/5 border border-white/10 rounded-xl p-6 hover:border-primary/30 transition-colors">
              <h3 class="font-heading font-bold text-lg mb-3">Helmholtz Munich (Neuherberg)</h3>
              <div class="space-y-2 text-sm mb-4">
                <div class="flex justify-between"><span class="text-gray-400">Schwerpunkt</span><span class="text-white font-medium">Gesundheit & Umwelt</span></div>
                <div class="flex justify-between"><span class="text-gray-400">Mitarbeitende</span><span class="text-white font-medium">~2.500</span></div>
                <div class="flex justify-between"><span class="text-gray-400">Entfernung</span><span class="text-white font-medium">~15 km nördlich</span></div>
              </div>
              <p class="text-gray-400 text-sm">Deutsches Forschungszentrum für Gesundheit und Umwelt. Schwerpunkte: Diabetes, Lungenforschung, Umweltmedizin.</p>
            </div>

            <div class="bg-white/5 border border-white/10 rounded-xl p-6 hover:border-primary/30 transition-colors">
              <h3 class="font-heading font-bold text-lg mb-3">BioM Cluster Management</h3>
              <div class="space-y-2 text-sm mb-4">
                <div class="flex justify-between"><span class="text-gray-400">Betreute Unternehmen</span><span class="text-white font-medium">540</span></div>
                <div class="flex justify-between"><span class="text-gray-400">Reine Biotech-Firmen</span><span class="text-white font-medium">313</span></div>
                <div class="flex justify-between"><span class="text-gray-400">VC-Finanzierung 2024</span><span class="text-white font-medium">>910 Mio. €</span></div>
              </div>
              <p class="text-gray-400 text-sm">Das Cluster-Management der bayerischen Biotechnologie-Branche. Vernetzt Forschung, Startups und Industrie. Quelle: BioM Report 2024/25.</p>
            </div>

            <div class="bg-white/5 border border-white/10 rounded-xl p-6 hover:border-primary/30 transition-colors">
              <h3 class="font-heading font-bold text-lg mb-3">LMU Klinikum Großhadern</h3>
              <div class="space-y-2 text-sm mb-4">
                <div class="flex justify-between"><span class="text-gray-400">Patient:innen/Jahr</span><span class="text-white font-medium">~500.000</span></div>
                <div class="flex justify-between"><span class="text-gray-400">Fachkliniken</span><span class="text-white font-medium">28</span></div>
                <div class="flex justify-between"><span class="text-gray-400">Rang</span><span class="text-white font-medium">Top-5 Deutschland</span></div>
              </div>
              <p class="text-gray-400 text-sm">Eines der größten und forschungsstärksten Universitätsklinika Europas. Klinische Studien erfordern dedizierte Laborkapazitäten.</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Section 3: Pharma-Achse Südbayern -->
    <section class="py-20 bg-gradient-to-b from-white to-slate-50">
      <div class="container mx-auto px-4">
        <div class="max-w-5xl mx-auto">
          <h2 class="text-3xl font-heading font-bold mb-6 text-slate-900">
            Die Pharma-Achse Südbayern: Von Penzberg über Holzkirchen bis München
          </h2>
          <p class="text-gray-600 text-lg mb-12 leading-relaxed max-w-3xl">
            München ist nicht nur akademische Forschung. Südlich der Stadt erstreckt sich ein Korridor pharmazeutischer Produktion, der zu den bedeutendsten in Europa zählt.
          </p>

          <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
