        <Picture src="/attached_assets/Laborcontainer_006_1769688326917.jpg" alt="Laborcontainer München – Planexus LABtoGO mit 2,75 m Innenhöhe für TUM Garching, LMU Großhadern, MPI Martinsried und Helmholtz Zentrum München" class="w-full h-full object-cover opacity-20" loading="eager" fetchpriority="high" width={1980} height={1485} />
      </div>
      <div class="absolute inset-0 bg-gradient-to-r from-slate-900 via-slate-900/95 to-slate-900/70"></div>

      <div class="container mx-auto px-4 relative z-10">
        <div class="max-w-3xl">
          <nav class="flex items-center gap-2 text-sm text-gray-400 mb-8" aria-label="Breadcrumb">
