    { "@type": "ListItem", "position": 3, "name": "Laborcontainer Berlin", "item": "https://www.planexus.de/laborcontainer-berlin" }
  ]
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Was kostet ein Laborcontainer in Berlin?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Die Investition richtet sich nach Sicherheitsstufe, Reinraumklasse, Gründungsart und Standortlage. Ein Analytikcontainer in Adlershof liegt in einer anderen Größenordnung als ein BSL-3-Container mit HEPA-H14-Schleuse für die Charité oder das Robert Koch-Institut. Wir kalkulieren projektspezifisch – inklusive Pfahlgründung bei hohem Spree-Grundwasserspiegel, Vibrationsentkopplung am Adlershofer Forschungscampus und KhBauVO-Brandschutz auf Klinikgelände. Senden Sie uns Ihre Standortdaten, wir melden uns binnen 24 Stunden mit einer indikativen Spanne."
      }
    },
    {
      "@type": "Question",
      "name": "Welches Berliner Bezirksamt ist für mein Containerlabor zuständig?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Berlin hat keine zentrale Bauaufsicht – jedes der 12 Bezirksämter führt eine eigene Bauaufsicht mit eigener Praxis. Mitte (Charité CCM, RKI) prüft anders als Treptow-Köpenick (WISTA Adlershof) oder Pankow (MDC Buch). Maßgeblich ist immer die Bauordnung Berlin (BauO Bln). Wir identifizieren das zuständige Bezirksamt anhand Ihrer Adresse und reichen prüffähige Bauvorlagen passend zur Bezirkspraxis ein – das spart Wochen gegenüber einem Standard-Bauantrag, der dreimal nachgebessert werden muss."
      }
    },
    {
      "@type": "Question",
      "name": "Wie lange dauert die Lieferung eines Laborcontainers von Albstadt nach Berlin?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Die Strecke beträgt rund 720 km – per Schwerlasttransport über A81 nordwärts, A6 ostwärts, A9 nordwärts via Würzburg und Nürnberg bis Berliner Ring (A10) und Anschlussstellen Berlin-Schönefeld, Berlin-Süd oder Berlin-Spandau. Reine Fahrzeit ca. 7,5 Stunden, mit Genehmigungspflicht und Begleitfahrzeugen typischerweise ein Transporttag. Vom Auftrag bis zur betriebsbereiten Übergabe in Berlin vergehen 8 bis 14 Wochen."
      }
    },
    {
      "@type": "Question",
      "name": "Hält ein Standard-Container dem Berliner Sandboden und Spree-Grundwasser stand?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Berlin liegt im Berlin-Warschauer Urstromtal auf Sandboden mit Bodenklasse 3 nach DIN 18196. Innerstädtisch liegt der Grundwasserspiegel oft 2 bis 4 m unter Gelände – in Spreenähe phasenweise höher. Standard-Punktfundamente setzen sich auf solchem Untergrund nach 18 bis 36 Monaten erkennbar. Wir kalkulieren standortbezogen Pfahlgründung oder Plattengründung nach DIN 4017/4020 mit hydraulischem Auftriebsschutz – Messgeräte behalten ihre Justage, Reinraumklassen ihre Zertifizierbarkeit."
      }
    },
    {
      "@type": "Question",
      "name": "Kann Planexus einen Laborcontainer auf einem Charité-Campus oder am MDC Berlin-Buch aufstellen?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Ja. Auf dem Campus Charité Mitte, Virchow-Klinikum, Benjamin Franklin oder am Berlin-Buch-Campus koordinieren wir mit dem jeweiligen Klinikbauamt und der Berliner Hochschulbauverwaltung. Brandschutz nach KhBauVO Berlin, sterile Anlieferung über vorgesehene Logistik-Achsen und Abstimmung mit der Branddirektion sind Standard. Am MDC Berlin-Buch und an HELIOS-Campussen führen wir die Aufstellung kranbasiert und campus-konform durch – ohne Beeinträchtigung des laufenden Klinikbetriebs."
      }
    },
    {
      "@type": "Question",
      "name": "Welche Auflagen gelten für BSL-3-Container in Berlin?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "BSL-3 in Berlin verlangt Genehmigung nach BioStoffV (Bundesrecht), Anzeige beim LAGeSo (Landesamt für Gesundheit und Soziales Berlin) sowie ggf. dem zuständigen Bezirks-Gesundheitsamt. Für gentechnische Anlagen S1/S2/S3 zusätzlich Anzeige nach GenTG. Technisch fordert der Verordnungsgeber: Unterdruckkaskade min. -50 Pa, HEPA-H14 im Abluftstrang, autoklavierte Schleusen, redundante Lüftung. Wir liefern Risikobewertung, Sicherheitskonzept und vollständige Antragsunterlagen – Container werden nach TRBA 100 geprüft und mit IQ/OQ/PQ übergeben."
      }
    },
    {
      "@type": "Question",
      "name": "Mieten oder kaufen – was lohnt sich für Berliner Pharma- oder Forschungsprojekte?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Faustregel: Bei Projektlaufzeiten unter 24 Monaten – etwa Interimslabore während Charité-Sanierungen, befristete Drittmittel-Projekte am MDC Buch oder kurzfristige Pharma-Studienkampagnen – rechnet sich Miete. Bei dauerhafter Erweiterung am Forschungscampus Adlershof, im BBB-Pharma-Cluster Berlin-Brandenburg oder am Berlin-Buch-Campus überwiegt der Kauf, oft mit Mietkauf-Option. Wir vergleichen für Ihr Berliner Projekt beide Modelle inklusive Bilanzwirkung und Restwert."
      }
    }
  ]
};
---

<Layout
