---
import Layout from '../layouts/Layout.astro';
import Map from '../components/Map';
import ContactForm from '../components/ContactForm';
---

<Layout
  title="Laborcontainer anfragen – Kontakt"
  description="Laborcontainer anfragen: Antwort in der Regel innerhalb von 48 Stunden (werktags), unverbindlich und kostenfrei. Telefon +49 7435 7519 700."
  canonical="/kontakt"
  ogImage="/attached_assets/Kopf_green-scaled_1768306688943.jpg"
>
  <div class="pt-20 min-h-screen bg-white">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Start", "item": "https://planexus.de/" },
        { "@type": "ListItem", "position": 2, "name": "Kontakt", "item": "https://planexus.de/kontakt" }
      ]
    })} />
    <section class="relative py-24 bg-slate-900 text-white overflow-hidden">
      <div class="absolute inset-0 bg-[url('/images/backgrounds/kontakt-bg.webp')] bg-cover bg-center opacity-10"></div>
      <div class="absolute inset-0 bg-gradient-to-b from-slate-900 via-slate-900/95 to-slate-900"></div>
      <div class="container mx-auto px-4 text-center relative z-10">
        <h1 class="text-4xl md:text-6xl font-heading font-bold mb-6">Laborcontainer anfragen</h1>
        <p class="text-xl text-gray-300 max-w-2xl mx-auto">
          Starten Sie Ihr Laborprojekt mit einem starken Partner – von der <a href="/leistungen/beratung" class="text-primary hover:underline">Beratung</a> bis zur schlüsselfertigen Übergabe.
        </p>
        <p class="mt-6 text-base md:text-lg text-white font-semibold">Auf Anfragen antworten wir in der Regel innerhalb von 48 Stunden (werktags) – unverbindlich und kostenfrei.</p>
      </div>
    </section>

    <section class="py-12 md:py-20">
      <div class="container mx-auto px-4">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-16">
          <div class="space-y-12 order-2 lg:order-1">
            <div>
              <h2 class="text-2xl font-bold mb-6 text-slate-900">Unsere Kontaktdaten</h2>
              <p class="text-gray-600 mb-8">
                Wir stehen Ihnen jederzeit für Fragen zu <strong>Laborcontainern</strong> und Planungsleistungen zur Verfügung.
              </p>

              <div class="space-y-6">
                <div class="flex items-start gap-4 group">
                  <div class="w-12 h-12 bg-primary/10 rounded-lg flex items-center justify-center shrink-0 group-hover:bg-primary transition-colors">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary group-hover:text-slate-900 transition-colors"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
                  </div>
                  <div>
                    <h3 class="font-bold text-lg mb-1 text-slate-900">Büro</h3>
                    <p class="text-gray-600">Am Steinbach 8<br />72459 Albstadt – Laufen</p>
                  </div>
                </div>

                <div class="flex items-start gap-4 group">
                  <div class="w-12 h-12 bg-primary/10 rounded-lg flex items-center justify-center shrink-0 group-hover:bg-primary transition-colors">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary group-hover:text-slate-900 transition-colors"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
                  </div>
                  <div>
                    <h3 class="font-bold text-lg mb-1 text-slate-900">Fertigung</h3>
                    <p class="text-gray-600">Hospach 1<br />72401 Haigerloch</p>
                    <a href="tel:+4974744273000" class="text-gray-600 hover:text-primary transition-colors block">+49 7474 / 4273000</a>
                  </div>
                </div>

                <div class="flex items-start gap-4 group">
                  <div class="w-12 h-12 bg-primary/10 rounded-lg flex items-center justify-center shrink-0 group-hover:bg-primary transition-colors">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary group-hover:text-slate-900 transition-colors"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
                  </div>
                  <div>
                    <h3 class="font-bold text-lg mb-1 text-slate-900">Telefon</h3>
                    <a href="tel:+4974357519700" class="text-gray-600 hover:text-primary transition-colors block">
                      +49 7435 7519 700
                    </a>
                  </div>
                </div>

                <div class="flex items-start gap-4 group">
                  <div class="w-12 h-12 bg-primary/10 rounded-lg flex items-center justify-center shrink-0 group-hover:bg-primary transition-colors">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary group-hover:text-slate-900 transition-colors"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
                  </div>
                  <div>
                    <h3 class="font-bold text-lg mb-1 text-slate-900">Email</h3>
                    <a href="mailto:info@planexus.de" class="text-gray-600 hover:text-primary transition-colors block">
                      info@planexus.de
                    </a>
                  </div>
                </div>
              </div>
            </div>

            <div class="bg-slate-50 p-6 rounded-xl border border-gray-100 mb-6">
              <p class="text-gray-600 text-sm leading-relaxed">
                Erfahren Sie mehr über unsere <a href="/leistungen" class="font-semibold text-slate-900 hover:text-primary transition-colors">Leistungen</a>, sehen Sie sich unsere <a href="/projekte" class="font-semibold text-slate-900 hover:text-primary transition-colors">Referenzprojekte</a> an oder lernen Sie unser <a href="/team" class="font-semibold text-slate-900 hover:text-primary transition-colors">Team</a> und <a href="/partner" class="font-semibold text-slate-900 hover:text-primary transition-colors">Partner-Netzwerk</a> kennen. In unserem <a href="/magazin" class="font-semibold text-slate-900 hover:text-primary transition-colors">Magazin</a> finden Sie Fachwissen rund um den <a href="/leistungen/modulbau" class="font-semibold text-slate-900 hover:text-primary transition-colors">modularen Laborbau</a>.
              </p>
            </div>

            <div class="h-64 bg-slate-100 rounded-xl overflow-hidden border border-gray-200">
              <Map
                client:only="react"
                lat={48.2808}
                lng={8.8553}
                zoom={10}
                markers={[
                  { lat: 48.2180461, lng: 8.9140541, popupText: "Planexus GmbH - Büro\nAm Steinbach 8, 72459 Albstadt-Laufen" },
                  { lat: 48.3437, lng: 8.7965, popupText: "Planexus GmbH - Fertigung\nHospach 1, 72401 Haigerloch" }
                ]}
              />
            </div>
          </div>

          <div class="order-1 lg:order-2 space-y-8">
            <ContactForm client:load />
            <div class="bg-slate-50 border border-gray-100 rounded-xl p-6" data-contact-steps>
              <h2 class="text-xl font-bold text-slate-900 mb-5">Was nach Ihrer Anfrage passiert</h2>
              <ol class="space-y-4">
                <li class="flex gap-4">
                  <span class="w-8 h-8 shrink-0 rounded-full bg-primary text-slate-900 font-bold flex items-center justify-center" aria-hidden="true">1</span>
                  <div><p class="font-bold text-slate-900">Rückmeldung</p><p class="text-gray-600 text-sm leading-relaxed">Wir melden uns in der Regel innerhalb von 48 Stunden (werktags).</p></div>
                </li>
                <li class="flex gap-4">
                  <span class="w-8 h-8 shrink-0 rounded-full bg-primary text-slate-900 font-bold flex items-center justify-center" aria-hidden="true">2</span>
                  <div><p class="font-bold text-slate-900">Bedarf klären</p><p class="text-gray-600 text-sm leading-relaxed">Gemeinsam klären wir Nutzung, Sicherheitsstufe, Standort und Zeitrahmen.</p></div>
                </li>
                <li class="flex gap-4">
                  <span class="w-8 h-8 shrink-0 rounded-full bg-primary text-slate-900 font-bold flex items-center justify-center" aria-hidden="true">3</span>
                  <div><p class="font-bold text-slate-900">Erste Einschätzung</p><p class="text-gray-600 text-sm leading-relaxed">Sie erhalten eine erste schriftliche Indikation – unverbindlich und kostenfrei.</p></div>
                </li>
              </ol>
            </div>
            <div class="flex items-center gap-5 border border-gray-200 rounded-xl p-6" data-contact-person>
              <img src="/team/sven-biewald-192.webp" alt="Sven Biewald, Geschäftsführer der Planexus GmbH" width="96" height="96" loading="lazy" decoding="async" class="w-20 h-20 md:w-24 md:h-24 rounded-full object-cover shrink-0" />
              <div>
                <h2 class="text-sm font-semibold uppercase tracking-wider text-gray-500 mb-1">Ihr Ansprechpartner</h2>
                <p class="font-bold text-slate-900 text-lg">Sven Biewald</p>
                <p class="text-gray-600 text-sm mb-2">Geschäftsführer, Planexus GmbH</p>
                <a href="tel:+4974357519700" class="block font-semibold text-slate-900 underline decoration-primary underline-offset-4 hover:text-[#5c7300]">+49 7435 7519 700</a>
                <a href="/team/sven-biewald" class="text-sm text-[#5c7300] underline underline-offset-4">Profil ansehen</a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>
  </div>
</Layout>
