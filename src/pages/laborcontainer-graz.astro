---
import Layout from '../layouts/Layout.astro';
import ContactForm from '../components/ContactForm.tsx';
import AuthorBio from '../components/AuthorBio.astro';
import CityCrossLinks from '../components/CityCrossLinks.astro';

const title = "Laborcontainer Graz | BSL-3, AVL + BioTechMed | Planexus";
const description = "Laborcontainer Graz: LABtoGO 2.0, BSL-3, ATEX, OIB + ÖNORM Z3, AVL List + Magna + BioTechMed. EU-Binnenmarkt, A9 Pyhrn, schlüsselfertig in 14 Wochen.";
const canonical = "/laborcontainer-graz";

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "serviceType": "Laborcontainer und modularer Laborbau Graz",
  "provider": {
    "@type": "Organization",
    "name": "Planexus GmbH",
    "url": "https://www.planexus.de",
    "telephone": "+49 7435 7519 700",
    "email": "info@planexus.de",
    "address": { "@type": "PostalAddress", "streetAddress": "Emil-Mayer-Straße 1", "addressLocality": "Albstadt", "postalCode": "72461", "addressCountry": "DE" },
    "parentOrganization": { "@type": "Organization", "name": "Wesemann Holding GmbH" }
  },
  "areaServed": [
    { "@type": "City", "name": "Graz" },
    { "@type": "AdministrativeArea", "name": "Steiermark" },
    { "@type": "Country", "name": "Österreich" }
  ],
  "description": "Containerlabore, mobile Labore und modulare Laborgebäude für AVL List, Magna Steyr, BioTechMed-Graz (Uni Graz+MedUni+TU Graz), JOANNEUM RESEARCH, ACIB, Med-Uni Graz und das LKH-Univ. Klinikum – ab Werk Albstadt EU-binnenmarktkonform nach Graz über A8 + A1 + A9 Pyhrn.",
  "offers": { "@type": "AggregateOffer", "priceCurrency": "EUR", "availability": "https://schema.org/InStock" }
};

const localBusinessSchema = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "name": "Planexus GmbH – Laborcontainer Graz",
  "url": "https://www.planexus.de/laborcontainer-graz",
  "telephone": "+49 7435 7519 700",
  "email": "info@planexus.de",
  "address": { "@type": "PostalAddress", "streetAddress": "Emil-Mayer-Straße 1", "addressLocality": "Albstadt", "postalCode": "72461", "addressCountry": "DE" },
  "areaServed": { "@type": "City", "name": "Graz", "containedInPlace": { "@type": "Country", "name": "Österreich" } },
  "priceRange": "EUR",
  "openingHoursSpecification": [{ "@type": "OpeningHoursSpecification", "dayOfWeek": ["Monday","Tuesday","Wednesday","Thursday","Friday"], "opens": "08:00", "closes": "17:00" }]
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Start", "item": "https://www.planexus.de/" },
    { "@type": "ListItem", "position": 2, "name": "Standorte", "item": "https://www.planexus.de/standorte" },
    { "@type": "ListItem", "position": 3, "name": "Laborcontainer Graz", "item": "https://www.planexus.de/laborcontainer-graz" }
  ]
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Wie lange dauert die Lieferung eines Laborcontainers nach Graz vom Werk Albstadt?",
      "acceptedAnswer": { "@type": "Answer", "text": "Die Schwerlastroute Werk Albstadt → Graz führt über die A81 nordostwärts bis Stuttgart, dann A8 ostwärts via München → Salzburg, Grenzübergang Walserberg (DE/AT EU-Binnenmarkt, kein Stopp seit Schengen), weiter A1 ostwärts via Linz → Knoten Voralpenkreuz und A9 Pyhrn-Autobahn südostwärts via Bosrucktunnel und Gleinalmtunnel nach Graz. Reine Fahrzeit beträgt rund 7 Stunden bei circa 660 Kilometern Distanz – ein vollständiger Transporttag mit Pflichtpause. Die A9 Pyhrn ist mautpflichtig (zusätzlich zur GO-Box-Streckenmaut die Sondermaut Bosrucktunnel und Gleinalmtunnel). Standardanlieferpunkte: AVL List Hans-List-Platz 1 in Liebenau, Magna Steyr Liebenauer Hauptstrasse 317, LKH-Univ. Klinikum Auenbruggerplatz 1-31, TU Graz Rechbauerstrasse 12 und Inffeldgasse Campus, JOANNEUM RESEARCH Leonhardstrasse 59. Vom Auftrag bis zur betriebsbereiten Übergabe in Graz vergehen 10 bis 14 Wochen." }
    },
    {
      "@type": "Question",
      "name": "Welche Bewilligungen brauche ich für einen Laborcontainer in Graz?",
      "acceptedAnswer": { "@type": "Answer", "text": "In Graz gilt das Steiermärkische Baugesetz (Stmk. BauG, LGBl. 59/1995 idgF) als steirisches Landesgesetz, ergänzt durch die OIB-Richtlinien 1 bis 6 des Österreichischen Institut für Bautechnik. Zuständig ist die Magistratsabteilung Baurechtsamt am Europaplatz 20, 8011 Graz, im Verbund mit der Baudirektion. Container gelten als Bauten gemäss § 19 Stmk. BauG, eine Bauanzeige oder Baubewilligung ist in den meisten Fällen nötig. Bei temporärer Aufstellung unter sechs Monaten und Industriegrundstücken (AVL List Liebenau, Magna Steyr Liebenau-Süd) ist je nach Standort ein vereinfachtes Anzeigeverfahren möglich. Wir prüfen den Standort vorab und reichen verfahrenstaugliche Bauunterlagen direkt am Europaplatz ein – inklusive ÖNORM-Statik mit Erdbebenzone Z3, OIB-Energienachweis und Brandschutzkonzept nach OIB-RL 2." }
    },
    {
      "@type": "Question",
      "name": "Welche Erdbeben-Anforderungen gelten für Laborcontainer in Graz nach ÖNORM B 1998-1?",
      "acceptedAnswer": { "@type": "Answer", "text": "Graz liegt nach ÖNORM B 1998-1 (Eurocode 8 Erdbeben) in Erdbebenzone Z3 mit einer horizontalen Bemessungs-Bodenbeschleunigung agR von rund 0,8 bis 1,0 m/s² – das ist die höchste Zone unter den österreichischen Landeshauptstädten und höher als Wien (Z2/Z3) oder Linz (Z1/Z2). Die Steiermark liegt im seismisch aktiven östlichen Alpenrand. Statisch-konstruktiv bedeutet das: Bedeutungskategorie II für AVL-, Magna-, BioTechMed- und LKH-Standorte ist Pflicht, Verankerungskonzept und kapazitätsbemessenes Gesamtsystem nach ÖNORM B 1998-1 sind nicht optional. Wir liefern für Graz statisch nach ÖNORM B 1998-1 mit Z3-Faktor und ÖNORM B 1991-1-3 Schneelast (Graz Zone 3, sk je nach Höhenlage 1,5-2,0 kN/m²) sowie energetisch nach OIB-RL 6 mit U ≤ 0,20 W/m²K und Wärmerückgewinnung ≥ 75 % – verfahrenstauglich für das Baurechtsamt Europaplatz." }
    },
    {
      "@type": "Question",
      "name": "Was ist der Mobilitäts-Engineering-Cluster Graz und welche Container braucht er?",
      "acceptedAnswer": { "@type": "Answer", "text": "Graz ist Österreichs unangefochtenes Zentrum für Powertrain- und Fahrzeug-Engineering. AVL List GmbH am Hans-List-Platz 1, 8020 Graz – mit ~5.000 Mitarbeitenden in Graz und ~12.500 weltweit – ist das grösste unabhängige Powertrain-Engineering-Unternehmen weltweit, mit Fokus Verbrennungsmotor, Brennstoffzelle, Batterie-Test und E-Mobility. Magna Steyr an der Liebenauer Hauptstrasse 317, 8041 Graz – mit ~10.000 Mitarbeitenden – ist die führende Auftragsfertigung Premium-Automotive in Europa (BMW Z4, Toyota GR Supra, Jaguar I-Pace, Mercedes G-Klasse). Beide Cluster brauchen H2-/Battery-Test-Container nach ATEX-Zone 2/22 (EX-II 3G/3D), Klimaräume für Motoren-Prüfstände, Werkstoff- und Korrosionslabore. Wir bauen ATEX-konforme Test-Container mit explosionsgeschützter Elektrik nach EN 60079, Doppelfilterung und H2-Sensorik mit automatischer Notabschaltung – verfahrenstauglich für AVL-Liebenau und Magna-Liebenau-Süd." }
    },
    {
      "@type": "Question",
      "name": "Welche Anwendungen sind in Graz besonders nachgefragt?",
      "acceptedAnswer": { "@type": "Answer", "text": "Graz ist Mobilitäts- und Life-Science-Doppelcluster. Wesentliche Nachfrage kommt vom Mobilitäts-Engineering-Cluster (AVL List für Powertrain-/H2-/Battery-Test-Container ATEX-konform, Magna Steyr für Werkstoff- und Klimakammer-Container) – beide in Graz-Liebenau. Vom BioTechMed-Graz-Forschungsverbund (Uni Graz + Med-Uni Graz + TU Graz, gemeinsame Forschungsplattform für medizinisch-naturwissenschaftliche Forschung) für BSL-2-Forschungs-Container. Vom LKH-Univ. Klinikum Graz (Auenbruggerplatz 1-31, 8036 Graz, ~7.500 Mitarbeitende, ~1.600 Betten, 22 Universitätskliniken – grösstes Spital der Steiermark) für Studien-Container während Klinik-Sanierungen. Vom JOANNEUM RESEARCH (Leonhardstrasse 59, 8010 Graz – grösste außeruniversitäre Forschungsgesellschaft Österreichs nach AIT) für Materials-, Sensorik- und Robotik-Container. Vom ACIB – Austrian Centre of Industrial Biotechnology (Krenngasse 37, 8010 Graz) für Biotech-Pilot-Container. Von der TU Graz (Rechbauerstrasse 12 und Inffeldgasse-Campus, ~13.500 Studierende, Schwerpunkte Maschinenbau, Elektrotechnik, Mechatronik) und der Karl-Franzens-Universität (Universitätsplatz 3, 8010 Graz, ~30.000 Studierende, NAWI-Graz-Verbund mit TU)." }
    },
    {
      "@type": "Question",
      "name": "Wie liefern Sie nach Österreich? EU-Binnenmarkt, A9 Pyhrn, GO-Box?",
      "acceptedAnswer": { "@type": "Answer", "text": "Deutschland und Österreich sind beide EU-Mitgliedstaaten und Teil des Binnenmarkts – es gibt keine Zollverzollung. Wir liefern ab Werk Albstadt als innergemeinschaftliche Lieferung mit österreichischer USt-IdNr (ATU-Nummer) – steuerfrei in Deutschland, Reverse Charge in Österreich. Der Preisvorteil gegenüber Schweizer Standorten beträgt bis zu 8,1 % (Schweizer MwSt entfällt komplett). Für den Schwerlasttransport ist die österreichische LKW-Maut (GO-Box, ASFINAG) auf allen Autobahnen und Schnellstrassen obligatorisch. Auf der A9 Pyhrn-Autobahn fallen zusätzliche Sondermaut-Gebühren für Bosrucktunnel und Gleinalmtunnel an – beide für Schwertransporte > 3,5 t verpflichtend zu passieren. Standardroute via Salzburg-Walserberg (Schengen, kein Stopp), Linz, Voralpenkreuz, A9 Pyhrn nach Graz. Vom Werk Albstadt nach Graz: ~660 km, ~7 h Fahrzeit + Pflichtpause." }
    },
    {
      "@type": "Question",
      "name": "Können Sie BSL-3- und ATEX-Container für AVL List, BioTechMed und LKH-Klinikum liefern?",
      "acceptedAnswer": { "@type": "Answer", "text": "Ja. Wir bauen für Graz drei Container-Linien parallel. Erstens: BSL-3-Container für klinische Forschung (LKH-Univ. Klinikum, Med-Uni Graz, BioTechMed-Verbund) – HEPA-H14-Doppelfilterung, autoklavierte Schleuse, Unterdruck mit Drei-Stufen-Kaskade, Notstromversorgung. Anzeige nach Gentechnikgesetz (GTG) beim BMSGPK Wien Stubenring, Stellungnahme der wissenschaftlichen Kommission. Zweitens: ATEX-Container für AVL List H2- und Battery-Test (EX-II 2G T3 oder T4 nach EN 60079) mit explosionsgeschützter Elektrik, H2-Sensorik mit automatischer Notabschaltung, Berstmembranen und Inertgas-System. Drittens: GMP-Reinraum-Container für ACIB-Industriebiotech-Pilotierung mit BASG-Inspektionsbereitschaft – ISO Klasse 8/7. Statik aller drei Linien nach ÖNORM B 1998-1 (Z3) und ÖNORM B 1991, Energie nach OIB-RL 6, Brandschutz nach OIB-RL 2 verfahrenstauglich für das Baurechtsamt Europaplatz." }
    }
  ]
};
---

<Layout title={title} description={description} canonical={canonical}>
  <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(localBusinessSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <div class="bg-white">

    <!-- HERO -->
    <section class="relative bg-slate-900 text-white overflow-hidden">
      <div class="relative z-10 container mx-auto px-4 py-20 md:py-28">
        <div class="max-w-4xl">
          <nav class="flex items-center gap-2 text-sm text-gray-400 mb-8" aria-label="Breadcrumb">
            <a href="/" class="hover:text-primary transition-colors">Start</a>
            <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m9 18 6-6-6-6"/></svg>
            <span>Standorte</span>
            <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m9 18 6-6-6-6"/></svg>
            <span class="text-primary">Graz</span>
          </nav>

          <div class="text-primary font-medium text-sm uppercase tracking-wider mb-4">Ihr Spezialist für Laborcontainer · Mobilitäts-Engineering-Hauptstadt + BioTechMed-Verbund</div>

          <h1 class="text-4xl md:text-5xl lg:text-6xl font-heading font-bold mb-6 leading-tight">
            Laborcontainer Graz – ATEX-Mobilitäts- und BioTechMed-Labore für AVL, Magna Steyr und MedUni
          </h1>

          <p class="text-xl text-gray-300 leading-relaxed mb-4">
            <strong class="text-white">Ihr Fachplaner für Containerlabore mit mehr als 10 Jahren Erfahrung.</strong> Modular, OIB-konform, ÖNORM-statisch nach Erdbebenzone Z3. Wir realisieren Forschungs-, Klinik- und Powertrain-Test-Umgebungen für AVL List, Magna Steyr, BioTechMed-Graz (Uni Graz + Med-Uni Graz + TU Graz), JOANNEUM RESEARCH, ACIB, Med-Uni Graz und das LKH-Univ. Klinikum – aus dem Werk Albstadt direkt nach Graz, EU-binnenmarktkonform ohne Zollverzollung über A8 + A1 + A9 Pyhrn-Autobahn.
          </p>
          <p class="text-base text-gray-400 mb-8">Während andere noch planen, forschen und testen Sie bereits.</p>

          <div class="flex flex-col sm:flex-row gap-4 mb-8">
            <a href="#anfrage" data-testid="button-cta-hero" class="bg-primary text-slate-900 font-bold px-8 py-4 rounded-lg hover:bg-primary/90 transition-colors inline-flex items-center justify-center gap-2 shadow-[0_0_20px_rgba(132,189,0,0.3)]">Kostenfreies Standort-Audit Graz<svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg></a>
            <a href="tel:+4974357519700" class="border border-white/20 text-white font-medium px-8 py-4 rounded-lg hover:bg-white/10 transition-colors inline-flex items-center justify-center gap-2"><svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>+49 7435 7519 700</a>
          </div>

          <div class="flex flex-wrap items-center gap-x-6 gap-y-2 text-sm text-gray-400">
            <div class="flex items-center gap-2"><svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6 9 17l-5-5"/></svg>Pioniere im Modulbau seit 2016</div>
            <div class="flex items-center gap-2"><svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6 9 17l-5-5"/></svg>Award 2026 EU Business News</div>
            <div class="flex items-center gap-2"><svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6 9 17l-5-5"/></svg>EU-Binnenmarkt: ohne Zoll</div>
            <div class="flex items-center gap-2"><svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6 9 17l-5-5"/></svg>Wesemann-Gruppe · 60+ Jahre Laborbau</div>
          </div>
        </div>
      </div>
    </section>

    <AuthorBio city="Graz" />

    <!-- LABtoGO 2.0 -->
    <section class="py-16 md:py-20 bg-gradient-to-br from-primary/5 via-white to-primary/10 border-y border-primary/20">
      <div class="container mx-auto px-4">
        <div class="max-w-5xl mx-auto">
          <div class="grid md:grid-cols-2 gap-10 items-center mb-10">
            <div>
              <div class="text-primary font-bold text-sm uppercase tracking-wider mb-3">Pattern-Interrupt · Weltpremiere analytica 2026</div>
              <h2 class="text-3xl md:text-4xl font-heading font-bold mb-4 text-slate-900">Planexus zeigt Graz, was ein Laborcontainer 2026 wirklich kann</h2>
              <p class="text-lg text-gray-700 leading-relaxed mb-4">Ein gewöhnlicher Laborcontainer hat 2.400 mm Innenhöhe. Aufrecht arbeiten unter einem Abzug oder einer ATEX-Belüftung ist mühsam.</p>
              <p class="text-lg text-slate-900 font-bold leading-relaxed mb-4">Der LABtoGO 2.0 von Planexus hat 2.750 mm Innenhöhe. 9,5 m Außenlänge. 3 m Außenbreite. Vollverglaste Front, die echtes Tageslicht in jedes AVL-, Magna-, BioTechMed-, LKH- oder JOANNEUM-Forschungslabor bringt.</p>
              <p class="text-lg text-gray-700 leading-relaxed"><strong>Ein gewöhnlicher Laborcontainer passt komplett in einen LABtoGO hinein.</strong> Wir konfigurieren ihn für Graz nach ÖNORM B 1998-1 Erdbebenzone Z3 (höchste Zone in AT-Hauptstädten), OIB-Richtlinie 6 Energie strenger als die deutsche GEG, EU-Binnenmarktkonform ohne Zollverzollung ab Werk Albstadt über A8 + A1 + A9 Pyhrn-Autobahn (Bosrucktunnel + Gleinalmtunnel).</p>
            </div>
            <div class="grid grid-cols-2 gap-4">
              <div class="bg-slate-900 text-white rounded-2xl p-6 text-center"><div class="text-4xl font-bold text-primary mb-1">2.750</div><div class="text-xs text-gray-400 uppercase tracking-wider">mm Innenhöhe</div><div class="text-xs text-gray-500 mt-1">Standard: 2.400 mm</div></div>
              <div class="bg-slate-900 text-white rounded-2xl p-6 text-center"><div class="text-4xl font-bold text-primary mb-1">9.500</div><div class="text-xs text-gray-400 uppercase tracking-wider">mm Außenlänge</div><div class="text-xs text-gray-500 mt-1">3.000 mm Breite</div></div>
              <div class="bg-slate-900 text-white rounded-2xl p-6 text-center"><div class="text-4xl font-bold text-primary mb-1">ÖNORM Z3</div><div class="text-xs text-gray-400 uppercase tracking-wider">Erdbeben agR ~0,8-1,0</div><div class="text-xs text-gray-500 mt-1">höchste AT-Hauptstadt</div></div>
              <div class="bg-slate-900 text-white rounded-2xl p-6 text-center"><div class="text-4xl font-bold text-primary mb-1">660 km</div><div class="text-xs text-gray-400 uppercase tracking-wider">Werk → Graz</div><div class="text-xs text-gray-500 mt-1">~7 h via A9 Pyhrn</div></div>
            </div>
          </div>
          <div class="text-center"><a href="/laborcontainer/labtogo" class="inline-flex items-center gap-2 text-primary font-bold hover:underline">LABtoGO 2.0 Plattform und alle Konfigurationen ansehen<svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg></a></div>
        </div>
      </div>
    </section>

    <!-- PROBLEM-AGITATION -->
    <section class="py-16 md:py-20">
      <div class="container mx-auto px-4">
        <div class="max-w-5xl mx-auto">
          <h2 class="text-3xl md:text-4xl font-heading font-bold mb-10 text-slate-900">Planexus löst die drei Grazer Engpässe, an denen Powertrain- und Klinik-Container regelmässig scheitern</h2>
          <div class="grid md:grid-cols-3 gap-6">
            <div class="bg-slate-50 border-l-4 border-primary rounded-xl p-6">
              <div class="text-slate-900 font-bold text-lg mb-2">Z3-Erdbebenzone unterschätzt</div>
              <p class="text-gray-700 text-sm leading-relaxed">Graz liegt nach ÖNORM B 1998-1 in Erdbebenzone Z3 mit agR ~0,8-1,0 m/s² – die höchste Zone unter den österreichischen Landeshauptstädten. Container ohne kapazitätsbemessenes Verankerungskonzept und Bedeutungskategorie II (für AVL-, BioTechMed- und LKH-Standorte) werden vom Baurechtsamt Europaplatz in der Bauanzeige gestoppt – und nachträgliche Statik-Korrekturen kosten Wochen.</p>
              <p class="text-sm text-slate-900 font-semibold mt-3 pt-3 border-t border-gray-200">Planexus-Antwort: Z3-Statik ab Werk, Bedeutungskategorie II Standard.</p>
            </div>
            <div class="bg-slate-50 border-l-4 border-primary rounded-xl p-6">
              <div class="text-slate-900 font-bold text-lg mb-2">ATEX/H2-Test-Pfad unterspezifiziert</div>
              <p class="text-gray-700 text-sm leading-relaxed">AVL List ist das weltweit grösste unabhängige Powertrain-Engineering – mit Schwerpunkten Brennstoffzelle, H2-Test und Battery-Test. Container für diese Anwendungen brauchen ATEX-Zone 2/22 (EX-II 3G/3D), explosionsgeschützte Elektrik nach EN 60079, H2-Sensorik mit automatischer Notabschaltung und Inertgas-System. Standard-Container haben das nicht – und Nachrüstung im Feld ist nicht zertifizierbar.</p>
              <p class="text-sm text-slate-900 font-semibold mt-3 pt-3 border-t border-gray-200">Planexus-Antwort: ATEX EN 60079 ab Werk, H2-Sensorik vorinstalliert.</p>
            </div>
            <div class="bg-slate-50 border-l-4 border-primary rounded-xl p-6">
              <div class="text-slate-900 font-bold text-lg mb-2">A9-Pyhrn-Logistik schlecht geplant</div>
              <p class="text-gray-700 text-sm leading-relaxed">Die A9 Pyhrn-Autobahn ist die einzige sinnvolle Schwerlast-Route Salzburg → Graz und enthält Bosrucktunnel und Gleinalmtunnel als kostenpflichtige Sondermaut-Strecken (zusätzlich zur GO-Box-Streckenmaut). Für Schwertransporte > 18 t Tunnel-Genehmigung erforderlich. Wer das übersieht, verliert einen Tag – und Hochsaison im Sommer ist Bosrucktunnel-Stau Standard.</p>
              <p class="text-sm text-slate-900 font-semibold mt-3 pt-3 border-t border-gray-200">Planexus-Antwort: A9-Pyhrn-Tunnel-Genehmigung und Maut ab Werk eingeplant.</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- STRATEGISCHE FUSION -->
    <section class="py-16 md:py-20 bg-slate-50">
      <div class="container mx-auto px-4">
        <div class="max-w-4xl mx-auto">
          <h2 class="text-3xl md:text-4xl font-heading font-bold mb-8 text-slate-900">Laborcontainer für Graz: Was AVL List, Magna Steyr, BioTechMed und das LKH-Klinikum vom Engineering verlangen</h2>
          <div class="prose prose-lg max-w-none text-gray-700 space-y-6">
