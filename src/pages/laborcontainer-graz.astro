---
import Layout from '../layouts/Layout.astro';

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": "Laborcontainer Graz",
  "description": "Laborcontainer für Graz und die Steiermark: Planung, Fertigung und schlüsselfertige Übergabe. BSL-2/BSL-3 Container, mobile Forschungslabore und Reinraumlösungen für Biotech, Pharma und Forschung.",
  "provider": {
    "@type": "Organization",
    "name": "Planexus GmbH",
    "url": "https://www.planexus.de"
  },
  "areaServed": [
    { "@type": "City", "name": "Graz" },
    { "@type": "AdministrativeArea", "name": "Steiermark" }
  ],
  "url": "https://www.planexus.de/laborcontainer-graz"
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Start", "item": "https://www.planexus.de/" },
    { "@type": "ListItem", "position": 2, "name": "Laborcontainer Graz", "item": "https://www.planexus.de/laborcontainer-graz" }
  ]
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Was kostet ein Laborcontainer in Graz?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Die Kosten richten sich nach Größe, Ausstattung und Sicherheitsstufe. Transport DE→AT und alle Formalitäten werden inklusive kalkuliert. Sprechen Sie mit uns – nach einem ersten Gespräch nennen wir Ihnen eine realistische Einschätzung."
      }
    },
    {
      "@type": "Question",
      "name": "Brauche ich in Graz eine Baubewilligung für einen Laborcontainer?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "In der Regel ja. Das Steiermärkische Baugesetz (Stmk. BauG) sieht für Container, die länger als 3 Tage aufgestellt werden, eine Baubewilligung im vereinfachten Verfahren vor (§20). Für temporäre Aufstellungen kann eine befristete Baubewilligung nach §30 erteilt werden (max. 6 Monate). Wir übernehmen die Abstimmung mit der Baubehörde."
      }
    },
    {
      "@type": "Question",
      "name": "Wie schnell kann ein Laborcontainer nach Graz geliefert werden?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Von der Auftragserteilung bis zur schlüsselfertigen Übergabe vergehen in der Regel 8 bis 12 Wochen. Der Transport von unserem Werk in Albstadt nach Graz erfolgt per Tieflader über die A8 und die A9 – rund 5,5 Stunden Fahrzeit."
      }
    },
    {
      "@type": "Question",
      "name": "Kann ich einen Laborcontainer in Graz auch mieten?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Ja. Miete, Kauf oder Mietkauf – wir bieten flexible Modelle. Besonders sinnvoll für befristete Forschungsprojekte, Drittmittelprojekte oder als Interimslabor während Sanierungen an den Universitäten."
      }
    },
    {
      "@type": "Question",
      "name": "Erfüllen Ihre Container österreichische Normen und Universitätsanforderungen?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Ja. ÖNORM-Standards, ArbeitnehmerInnenschutzgesetz (ASchG), Arbeitsstättenverordnung (AStV). Auf Wunsch BSL-2/BSL-3 oder GMP-konform. Wir arbeiten mit den Sicherheitsbeauftragten der jeweiligen Einrichtung zusammen."
      }
    },
    {
      "@type": "Question",
      "name": "Eignet sich ein Containerlabor für Forschungsprojekte an der TU Graz oder Med Uni?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Ideal. BioTechMed-Graz, acib und CBmed schaffen permanenten Bedarf an flexibler Laborkapazität. Ein Containerlabor ist in 8–12 Wochen einsatzbereit – ideal für Drittmittelprojekte, neue Arbeitsgruppen oder befristete Kooperationen."
      }
    }
  ]
};

const localBusinessSchema = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "name": "Planexus GmbH",
  "description": "Laborcontainer für Graz und die Steiermark",
  "url": "https://www.planexus.de",
  "telephone": "+49 7435 7519 700",
  "email": "info@planexus.de",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "Am Steinbach 8",
    "addressLocality": "Albstadt",
    "postalCode": "72459",
    "addressCountry": "DE"
  },
  "areaServed": [
    { "@type": "City", "name": "Graz" },
    { "@type": "AdministrativeArea", "name": "Steiermark" }
  ]
};
---

<Layout
  title="Laborcontainer Graz – Technik & Life Sciences | Planexus GmbH"
  description="Containerlabore für Graz: TU Graz, Med Uni, Joanneum Research. BSL-2, Werkstoffprüfung. DACH-weite Lieferung. Jetzt Projekt besprechen."
  canonical="/laborcontainer-graz"
  schema={serviceSchema}
  ogImage="/attached_assets/Kopf_green-scaled_1768306688943.jpg"
>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} slot="head" />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} slot="head" />
  <script type="application/ld+json" set:html={JSON.stringify(localBusinessSchema)} slot="head" />

  <div class="pt-20 min-h-screen bg-white">

    <section class="relative py-28 bg-slate-900 text-white overflow-hidden">
      <div class="absolute inset-0 bg-[url('https://images.unsplash.com/photo-1551610122-39d8e2aff65b?q=80&w=2070')] bg-cover bg-center opacity-15"></div>
      <div class="absolute inset-0 bg-gradient-to-r from-slate-900 via-slate-900/95 to-slate-900/80"></div>

      <div class="container mx-auto px-4 relative z-10">
        <div class="max-w-4xl">
          <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-primary text-slate-900 font-medium text-sm mb-6">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
            <span>Graz & Steiermark</span>
          </div>
          <h1 class="text-4xl md:text-6xl font-heading font-bold mb-6 leading-tight">
            Laborcontainer für <span class="text-primary">Graz</span>
          </h1>
          <p class="text-xl text-gray-300 leading-relaxed max-w-3xl mb-8">
            Drei Universitäten, ein interuniversitärer Forschungsverbund und Österreichs stärkster Biotech-Cluster – Graz verbindet Spitzenforschung mit industrieller Biotechnologie. Wir planen, bauen und liefern betriebsfertige Containerlabore für Graz und die gesamte Steiermark.
          </p>
          <div class="flex flex-col sm:flex-row gap-4">
            <a href="/kontakt" class="bg-primary text-slate-900 font-bold px-8 py-4 rounded-lg hover:bg-primary/90 transition-colors inline-flex items-center gap-2 shadow-[0_0_20px_rgba(132,189,0,0.3)]">
              Projekt besprechen <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
            </a>
            <a href="tel:+4974357519700" class="border border-white/20 text-white font-medium px-8 py-4 rounded-lg hover:bg-white/10 transition-colors inline-flex items-center gap-2">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg> +49 7435 7519 700
            </a>
          </div>
        </div>
      </div>
    </section>

    <div class="bg-slate-50 border-b border-gray-100 py-4">
      <div class="container mx-auto px-4">
        <div class="flex items-center gap-2 text-sm text-gray-500">
          <a href="/" class="hover:text-primary">Start</a>
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
          <span class="text-primary font-medium">Laborcontainer Graz</span>
        </div>
      </div>
    </div>

    <section class="py-20">
      <div class="container mx-auto px-4">
        <div class="max-w-4xl mx-auto">
          <h2 class="text-3xl font-heading font-bold mb-8 text-slate-900">
            Warum Graz auf Containerlabore setzt
          </h2>
          <div class="prose prose-lg text-gray-600 max-w-none space-y-6">
            <p>
              Graz ist Österreichs zweitgrößter Life-Sciences-Standort. Die Stadt beherbergt mit BioTechMed-Graz einen einzigartigen interuniversitären Forschungsverbund aus TU Graz, Medizinischer Universität Graz und Karl-Franzens-Universität Graz. Das CBmed (Center for Biomarker Research in Medicine), Joanneum Research und das Austrian Centre of Industrial Biotechnology (acib) bilden das angewandte Forschungsfundament. Rund 65.000 Studierende, vier Universitäten und zwei Fachhochschulen schaffen einen der dichtesten Wissenschaftsstandorte im deutschsprachigen Raum.
            </p>
            <p>
              Die Herausforderung: Forschungsprojekte in Graz wachsen – von Drug Targeting über Biomarker-Diagnostik bis zur industriellen Biotechnologie. Neue Laborflächen werden gebraucht, aber konventionelle Laborbauten dauern Jahre. Gerade für befristete Forschungsvorhaben oder Startup-Labore ist das zu langsam.
            </p>
            <p>
              Planexus löst dieses Problem. Wir planen und bauen voll ausgestattete, normkonforme <strong>Containerlabore</strong> – maßgeschneidert für Ihren Standort in Graz. Von der ersten Skizze bis zur betriebsfertige Übergabe alles aus einer Hand. <a href="/leistungen" class="text-primary font-medium hover:underline">Unsere Leistungen im Überblick →</a>
            </p>
          </div>
        </div>
      </div>
    </section>

    <section class="py-20 bg-slate-50 border-y border-gray-100">
      <div class="container mx-auto px-4">
        <div class="max-w-4xl mx-auto">
          <h2 class="text-3xl font-heading font-bold mb-4 text-slate-900">
            TU, Klinik, Automotive – vier Laborszenarien in Graz
          </h2>
          <p class="text-gray-600 text-lg mb-12">
            Graz vereint universitäre Spitzenforschung mit angewandter Biotechnologie – ein ideales Umfeld für flexible Laborlösungen.
          </p>

          <div class="space-y-8">
            <div class="bg-white p-8 rounded-2xl border border-gray-100 hover:shadow-lg transition-shadow">
              <div class="flex items-start gap-5">
                <div class="w-14 h-14 bg-primary/10 rounded-lg flex items-center justify-center text-primary shrink-0">
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-7 h-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z"/><path d="m3.3 7 8.7 5 8.7-5"/><path d="M12 22V12"/></svg>
                </div>
                <div>
                  <h3 class="text-xl font-bold mb-3 text-slate-900">Biomedizinische Forschung an der Med Uni Graz</h3>
                  <p class="text-gray-600 leading-relaxed">
                    Die Medizinische Universität Graz und das LKH-Universitätsklinikum treiben klinische Studien, translationale Medizin und Precision Medicine voran. BSL-2-Container für Mikrobiologie, Virologie und molekulare Medizin ergänzen die bestehende Infrastruktur – ohne Eingriff in den laufenden Klinikbetrieb. <a href="/magazin/bsl-2-bsl-3-container-labor" class="text-primary font-medium hover:underline">Mehr zu BSL-2/BSL-3 im Container →</a>
                  </p>
                </div>
              </div>
            </div>

            <div class="bg-white p-8 rounded-2xl border border-gray-100 hover:shadow-lg transition-shadow">
              <div class="flex items-start gap-5">
                <div class="w-14 h-14 bg-primary/10 rounded-lg flex items-center justify-center text-primary shrink-0">
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-7 h-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10"/><path d="m9 12 2 2 4-4"/></svg>
                </div>
                <div>
                  <h3 class="text-xl font-bold mb-3 text-slate-900">Industrielle Biotechnologie am acib</h3>
                  <p class="text-gray-600 leading-relaxed">
                    Das Austrian Centre of Industrial Biotechnology (acib) mit über 300 wissenschaftlichen Publikationen ist führend in Enzymtechnologie, Biokatalyse und industrieller Prozessentwicklung. Pilotanlagen-Labore als Container ermöglichen die schnelle Skalierung von Laborprozessen in den industriellen Massstab. <a href="/leistungen/ausstattung" class="text-primary font-medium hover:underline">Mehr zur Laborausstattung →</a>
                  </p>
                </div>
              </div>
            </div>

            <div class="bg-white p-8 rounded-2xl border border-gray-100 hover:shadow-lg transition-shadow">
              <div class="flex items-start gap-5">
                <div class="w-14 h-14 bg-primary/10 rounded-lg flex items-center justify-center text-primary shrink-0">
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-7 h-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 18h8"/><path d="M3 22h18"/><path d="M14 22a7 7 0 1 0 0-14h-1"/><path d="M9 14h2"/><path d="M9 12a2 2 0 0 1-2-2V6h6v4a2 2 0 0 1-2 2Z"/><path d="M12 6V3a1 1 0 0 0-1-1H9a1 1 0 0 0-1 1v3"/></svg>
                </div>
                <div>
                  <h3 class="text-xl font-bold mb-3 text-slate-900">Drug Targeting bei BioTechMed-Graz</h3>
                  <p class="text-gray-600 leading-relaxed">
                    Der interuniversitäre Verbund BioTechMed-Graz (TU Graz + Med Uni + Uni Graz) hat den Schwerpunkt Drug Targeting – gezielte Wirkstoffapplikation. Analytik-, Synthese- und Charakterisierungslabore als Container schaffen die nötige Kapazität für pharmazeutische Forschungsprojekte. <a href="/magazin/gmp-reinraum-container-pharma-produktion" class="text-primary font-medium hover:underline">Mehr zu GMP-Reinraum im Container →</a>
                  </p>
                </div>
              </div>
            </div>

            <div class="bg-white p-8 rounded-2xl border border-gray-100 hover:shadow-lg transition-shadow">
              <div class="flex items-start gap-5">
                <div class="w-14 h-14 bg-primary/10 rounded-lg flex items-center justify-center text-primary shrink-0">
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-7 h-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                </div>
                <div>
                  <h3 class="text-xl font-bold mb-3 text-slate-900">Biomarker-Forschung am CBmed</h3>
                  <p class="text-gray-600 leading-relaxed">
                    Das Center for Biomarker Research in Medicine (CBmed) fokussiert auf Diabetes, Osteoporose und Krebs. Das OMICS Center Graz liefert Genomik-, Proteomik- und Metabolomik-Analysen. Qualitätskontroll-Container für klinische Proben sichern die Forschungsqualität – schnell verfügbar und normgerecht. <a href="/leistungen/beratung" class="text-primary font-medium hover:underline">Mehr zur Beratung →</a>
                  </p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

        <section class="py-16">
      <div class="container mx-auto px-4">
        <div class="max-w-4xl mx-auto">
          <div class="bg-slate-50 border border-gray-100 rounded-2xl p-8">
            <h2 class="text-2xl font-heading font-bold mb-4 text-slate-900">So realisieren wir Ihr Grazer Laborprojekt</h2>
            <p class="text-gray-600 leading-relaxed mb-4">
              Grazer Projekte betreuen wir von der Fachplanung nach ÖNORM-Standards über die Fertigung bis zur Aufstellung. Transport über die A8/A9, Kranaufstellung auf Uni-Campi und in Industriearealen. Laborausstattung wird eingebaut und betriebsbereit übergeben.
            </p>
            <div class="flex flex-wrap gap-3">
              <a href="/leistungen/planung" class="text-primary font-medium hover:underline text-sm">Fachplanung →</a>
              <a href="/leistungen/modulbau" class="text-primary font-medium hover:underline text-sm">Modulbau →</a>
              <a href="/leistungen/logistik" class="text-primary font-medium hover:underline text-sm">Logistik →</a>
              <a href="/leistungen/ausstattung" class="text-primary font-medium hover:underline text-sm">Ausstattung →</a>
              <a href="/leistungen/beratung" class="text-primary font-medium hover:underline text-sm">Beratung →</a>
              <a href="/leistungen/smart-lab" class="text-primary font-medium hover:underline text-sm">Smart Lab →</a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="py-20 bg-slate-50 border-y border-gray-100">
      <div class="container mx-auto px-4">
        <div class="max-w-4xl mx-auto">
          <h2 class="text-3xl font-heading font-bold mb-8 text-slate-900">
            TU Graz, Joanneum Research und Automotive – Grazer Forschungslandschaft
          </h2>
          <div class="prose prose-lg text-gray-600 max-w-none space-y-6">
            <p>
              Graz ist eine Universitätsstadt mit vier Universitäten, 65.000 Studierenden und einer einzigartigen Verbindung von Grundlagenforschung und angewandter Biotechnologie. Diese Dichte schafft permanenten Bedarf an flexibler Laborkapazität.
            </p>
            <h3 class="text-xl font-bold text-slate-900">Universitäten und Forschungsverbünde</h3>
            <p>
              <strong>BioTechMed-Graz</strong> vereint TU Graz, Med Uni Graz und Uni Graz in einem interuniversitären Verbund mit den Schwerpunkten Drug Targeting und pharmazeutische Technologien. Die <strong>TU Graz</strong> bietet den MSc Biotechnology im NAWI-Graz-Programm (Curriculum 2024), mit Forschung in Prozesstechnologie und Synthetischer Biologie (iGEM-Teilnahmen). Die <strong>Medizinische Universität Graz</strong> betreibt das LKH-Universitätsklinikum, klinische Forschung und die Biobank Graz. Die <strong>Karl-Franzens-Universität Graz</strong> ergänzt mit Pharmazeutischen Wissenschaften, Chemie und Biologie.
            </p>
            <h3 class="text-xl font-bold text-slate-900">Angewandte Forschung und Kompetenzzentren</h3>
            <p>
              Das <strong>CBmed – Center for Biomarker Research in Medicine</strong> (Eigentümer: Med Uni Graz, Med Uni Wien, TU Graz, Uni Graz, Joanneum Research, AIT) forscht an Biomarkern für Diabetes, Osteoporose und Krebs. Das <strong>acib – Austrian Centre of Industrial Biotechnology</strong> ist führend in Enzymtechnologie und Biokatalyse mit über 300 Publikationen. <strong>Joanneum Research</strong>, die Forschungsgesellschaft des Landes Steiermark, hat Life Sciences als einen ihrer Schwerpunkte. Das <strong>OMICS Center Graz</strong> liefert Genomik-, Proteomik- und Metabolomik-Analysen.
            </p>
            <h3 class="text-xl font-bold text-slate-900">Industrie und Startups</h3>
            <p>
              Die <strong>Andritz AG</strong> (Separation, Zellstoff- und Papiertechnologie) und <strong>Sappi</strong> (Biotechnologie-Forschung) sind industrielle Anker. M-ERA.NET-Projekte fördern materialwissenschaftliche Forschung. Eine wachsende Startup-Szene im Bereich Digital Health und Biotech nutzt den <strong>Science Park Graz</strong> als Inkubator. <a href="/magazin/laborcontainer-klimatisierung-lueftung-normen" class="text-primary font-medium hover:underline">Mehr zur Klimatisierung im Container →</a>
            </p>
          </div>
        </div>
      </div>
    </section>

    <section class="py-20">
      <div class="container mx-auto px-4">
        <div class="max-w-4xl mx-auto">
          <h2 class="text-3xl font-heading font-bold mb-8 text-slate-900">
            Steiermärkisches Baugesetz – Genehmigungswege in Graz
          </h2>
          <div class="prose prose-lg text-gray-600 max-w-none space-y-6">
            <p>
              In der Steiermark gilt das <strong>Steiermärkische Baugesetz (Stmk. BauG)</strong>. Seit der Novelle 2020 gibt es nur noch Baubewilligungsverfahren oder Meldepflicht – die frühere Bauanzeige wurde abgeschafft.
            </p>
            <p>
              <strong>§20 Stmk. BauG</strong> regelt das vereinfachte Baubewilligungsverfahren. Container, die länger als 3 Tage aufgestellt werden, sind bewilligungspflichtig. Die Entscheidung erfolgt binnen 3 Monaten – ohne Bauverhandlung.
            </p>
            <p>
              <strong>§30 Stmk. BauG</strong> ermöglicht eine befristete Baubewilligung für temporäre Bauten (max. 6 Monate mit Verlängerungsmöglichkeit). Das ist besonders relevant für Interimslabore und befristete Forschungsprojekte.
            </p>
            <p>
              <strong>§19 Stmk. BauG</strong> regelt das normale Verfahren mit Bauverhandlung für dauerhafte Aufstellungen. <strong>§21 Stmk. BauG</strong> definiert meldepflichtige Vorhaben für kleinere Maßnahmen.
            </p>
            <p>
              ÖNORM-Standards und das <strong>ArbeitnehmerInnenschutzgesetz (ASchG)</strong> gelten zusätzlich. Wir übernehmen die gesamte Abstimmung mit der Baubehörde der Stadt Graz. <a href="/magazin/laborcontainer-genehmigung-baurecht-vorschriften" class="text-primary font-medium hover:underline">Alles zum Thema Genehmigung im Detail →</a>
            </p>
          </div>
        </div>
      </div>
    </section>

    

        <section class="py-20 bg-slate-900 text-white">
      <div class="container mx-auto px-4">
        <div class="max-w-4xl mx-auto">
          <h2 class="text-3xl font-heading font-bold mb-4">Graz in Zahlen – Technik-Hochburg mit wachsendem Laborbedarf</h2>
          <p class="text-gray-400 text-lg mb-12">Sechs Fakten zur Grazer Forschungs- und Industrielandschaft.</p>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div class="flex items-start gap-4 p-6 rounded-xl border border-white/10 hover:border-primary/30 transition-colors">
              <div class="w-12 h-12 bg-primary/10 rounded-lg flex items-center justify-center text-primary shrink-0">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
              </div>
