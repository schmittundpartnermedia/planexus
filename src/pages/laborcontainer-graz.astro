---
import Layout from '../layouts/Layout.astro';

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": "Laborcontainer Graz",
  "description": "Mobile Containerlabore für Graz: AVL List Prüfstandtechnik, Magna Steyr Automotive, TU Graz, Green Tech Cluster. Werkstoffprüfung, Emissionslabor, BSL-2 – ÖNORM-konform.",
  "provider": {
    "@type": "Organization",
    "name": "Planexus GmbH",
    "url": "https://www.planexus.de"
  },
  "areaServed": [
    { "@type": "City", "name": "Graz" },
    { "@type": "AdministrativeArea", "name": "Steiermark" }
  ],
  "serviceType": ["Laborcontainer", "Prüflabor", "Emissionslabor", "Werkstoffprüfung", "BSL-2 Container"],
  "url": "https://www.planexus.de/laborcontainer-graz"
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Start", "item": "https://www.planexus.de/" },
    { "@type": "ListItem", "position": 2, "name": "Laborcontainer Graz", "item": "https://www.planexus.de/laborcontainer-graz" }
  ]
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Warum ist Graz ein Hotspot für Laborcontainer?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Graz vereint Automotive-Engineering (AVL List mit ~4.100 Beschäftigten, Magna Steyr mit ~8.000 MA), universitäre Spitzenforschung (TU Graz) und den Green Tech Cluster auf engem Raum. Diese Dichte erzeugt permanenten Bedarf an Prüf- und Analytiklaboren – oft schneller, als Gebäude gebaut werden können."
      }
    },
    {
      "@type": "Question",
      "name": "Welche Laborcontainer eignen sich für Automotive-Testing?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Für AVL-Prüfstände und Magna-Steyr-Testprogramme liefern wir Emissionsmesslabore, Werkstoffprüfcontainer und klimatisierte Analytikräume. Schwingungsisolierte Fundamente, Abgasabsaugung und kontrollierte Umgebungsbedingungen nach ISO 17025 sind Standard."
      }
    },
    {
      "@type": "Question",
      "name": "Brauche ich in der Steiermark eine Baubewilligung?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Seit der Novelle 2020 des Steiermärkischen Baugesetzes gibt es zwei Verfahrensarten: Baubewilligung (§ 20 Stmk. BauG) oder Meldepflicht (§ 21). Laborcontainer mit besonderen Anforderungen erfordern in der Regel eine Baubewilligung. Wir klären die Verfahrensstufe und bereiten alle Unterlagen vor."
      }
    },
    {
      "@type": "Question",
      "name": "Wie weit ist Albstadt von Graz entfernt?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Rund 470 km über die A8 via München und Salzburg – etwa 5 Stunden Fahrzeit. Kein Zoll innerhalb der EU, lediglich GO-Box-Maut für LKW auf österreichischen Autobahnen. Die Werksabnahme (FAT) findet in Albstadt statt."
      }
    },
    {
      "@type": "Question",
      "name": "Gibt es Containerlabore für den Green Tech Cluster?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Ja. Der Green Tech Cluster Steiermark ('Green Tech Valley') umfasst über 300 Unternehmen in Umwelt- und Energietechnologie. Analytiklabore für Wasser, Boden, Emissionen und Materialprüfung im Container sind ideal für Projektphasen und Feldstudien."
      }
    },
    {
      "@type": "Question",
      "name": "Was kostet ein Prüflabor-Container für Graz?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Die Kosten hängen von Ausstattung und Prüfnormen ab. Die Transportkosten für Graz (~470 km) liegen im mittleren DACH-Bereich. Kontaktieren Sie uns für eine projektspezifische Kalkulation – inklusive ÖNORM-konformer Dokumentation."
      }
    }
  ]
};

const localBusinessSchema = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "name": "Planexus GmbH – Laborcontainer Graz",
  "description": "Containerlabore für Graz und die Steiermark: AVL List, Magna Steyr, TU Graz, Green Tech Cluster. Automotive-Prüflabore, Werkstoffprüfung, Analytik.",
  "url": "https://www.planexus.de",
  "telephone": "+49 7435 7519 700",
  "email": "info@planexus.de",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "Am Steinbach 8",
    "addressLocality": "Albstadt",
    "postalCode": "72459",
    "addressCountry": "DE"
  },
  "areaServed": [
    { "@type": "City", "name": "Graz" },
    { "@type": "AdministrativeArea", "name": "Steiermark" }
  ]
};
---

<Layout
  title="Laborcontainer Graz – AVL List, Magna Steyr & Automotive Testing | Planexus GmbH"
  description="Containerlabore für Graz: AVL List (~4.100 MA), Magna Steyr (~8.000 MA), TU Graz, Green Tech Cluster. Prüfstandlabore, Emissionsmessung, Werkstoffprüfung – ÖNORM-konform."
  canonical="/laborcontainer-graz"
  schema={serviceSchema}
  ogImage="/attached_assets/Kopf_green-scaled_1768306688943.jpg"
>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} slot="head" />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} slot="head" />
  <script type="application/ld+json" set:html={JSON.stringify(localBusinessSchema)} slot="head" />

  <div class="pt-20 min-h-screen bg-white">

    <!-- Hero: Automotive Testing Hub -->
    <section class="relative py-32 bg-slate-900 text-white overflow-hidden">
      <div class="absolute inset-0 bg-[conic-gradient(from_180deg_at_80%_20%,rgba(187,215,0,0.06),transparent_40%,rgba(187,215,0,0.03))]"></div>
      <div class="absolute bottom-0 right-0 w-[500px] h-[500px] bg-primary/3 rounded-full blur-[180px]"></div>

      <div class="container mx-auto px-4 relative z-10">
        <div class="max-w-4xl">
          <div class="flex items-center gap-3 mb-8">
            <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-white/10 text-primary text-sm font-medium backdrop-blur-sm border border-white/10">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
              Graz & Steiermark
            </div>
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-red-700/20 text-red-400 text-xs font-bold border border-red-700/20">
              <span class="w-2 h-2 bg-red-400 rounded-full"></span>
              Österreich
            </div>
          </div>

          <h1 class="text-4xl md:text-5xl lg:text-6xl font-heading font-bold mb-6 leading-tight">
            13.000 Ingenieure testen Antriebe – <span class="text-primary">Labore müssen mithalten</span>
          </h1>
          <p class="text-xl text-gray-300 mb-4 leading-relaxed font-light max-w-3xl">
            AVL List ist der weltgrößte unabhängige Entwickler von Antriebssystemen – gegründet 1948, Hauptsitz Graz, über 2 Milliarden Euro Umsatz. Magna Steyr baut ganze Fahrzeuge für die größten Marken. Die TU Graz liefert die Forschung dazu. Und der Green Tech Cluster treibt die Transformation.
          </p>
          <p class="text-lg text-gray-400 mb-10 max-w-2xl">
            Graz ist Österreichs Ingenieur-Hauptstadt. Und Ingenieure brauchen Prüflabore.
          </p>

          <div class="flex flex-col sm:flex-row gap-4 mb-16">
            <a href="/kontakt" class="bg-primary text-slate-900 font-bold px-8 py-4 rounded-lg hover:bg-primary/90 transition-colors flex items-center justify-center gap-2 group shadow-[0_0_20px_rgba(187,215,0,0.3)]">
              Prüflabor anfragen
              <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 group-hover:translate-x-1 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
            </a>
            <a href="tel:+4974357519700" class="border border-white/20 text-white font-medium px-8 py-4 rounded-lg hover:bg-white/10 transition-colors backdrop-blur-sm flex items-center justify-center gap-2">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
              +49 7435 7519 700
            </a>
          </div>

          <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
            <div class="bg-white/5 border border-white/10 rounded-xl p-4 text-center">
              <div class="text-2xl font-heading font-bold text-primary">~4.100</div>
              <p class="text-gray-400 text-xs mt-1">AVL-Beschäftigte Graz</p>
            </div>
            <div class="bg-white/5 border border-white/10 rounded-xl p-4 text-center">
              <div class="text-2xl font-heading font-bold text-primary">~8.000</div>
              <p class="text-gray-400 text-xs mt-1">Magna Steyr Graz</p>
            </div>
            <div class="bg-white/5 border border-white/10 rounded-xl p-4 text-center">
              <div class="text-2xl font-heading font-bold text-primary">2,03 Mrd.</div>
              <p class="text-gray-400 text-xs mt-1">AVL Umsatz 2024</p>
            </div>
            <div class="bg-white/5 border border-white/10 rounded-xl p-4 text-center">
              <div class="text-2xl font-heading font-bold text-primary">~470 km</div>
              <p class="text-gray-400 text-xs mt-1">Albstadt → Graz</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Breadcrumb -->
    <nav class="bg-gray-50 border-b border-gray-100 py-3">
      <div class="container mx-auto px-4">
        <ol class="flex items-center gap-2 text-sm text-gray-500">
          <li><a href="/" class="hover:text-primary transition-colors">Start</a></li>
          <li><svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg></li>
          <li class="text-primary font-medium">Laborcontainer Graz</li>
        </ol>
      </div>
    </nav>

    <!-- Section 1: AVL List Deep Dive -->
    <section class="py-20 bg-white">
      <div class="container mx-auto px-4">
        <div class="max-w-5xl mx-auto">
          <h2 class="text-3xl md:text-4xl font-heading font-bold mb-6 text-slate-900">
            AVL List: Wo Antriebe der Zukunft getestet werden
          </h2>
          <p class="text-gray-600 text-lg mb-12 leading-relaxed max-w-3xl">
            AVL List GmbH ist der weltgrößte unabhängige Entwickler von Antriebssystemen und Prüfstandtechnik. Was 1948 als Ingenieurbüro von Prof. Hans List begann, ist heute ein globaler Technologiekonzern mit über 13.000 Mitarbeitenden – davon rund 4.100 am Hauptsitz Graz.
          </p>

          <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
            <div class="bg-gradient-to-br from-slate-50 to-white rounded-2xl p-8 border border-gray-100">
              <h3 class="text-xl font-heading font-bold text-slate-900 mb-4">AVL List GmbH – Kennzahlen</h3>
              <div class="space-y-3 text-sm mb-6">
                <div class="flex justify-between"><span class="text-gray-500">Hauptsitz</span><span class="font-bold text-slate-900">Graz, Österreich</span></div>
                <div class="flex justify-between"><span class="text-gray-500">Gegründet</span><span class="font-bold text-slate-900">1948</span></div>
                <div class="flex justify-between"><span class="text-gray-500">MA weltweit</span><span class="font-bold text-slate-900">~13.000</span></div>
                <div class="flex justify-between"><span class="text-gray-500">MA Graz</span><span class="font-bold text-slate-900">~4.100</span></div>
                <div class="flex justify-between"><span class="text-gray-500">Umsatz 2024</span><span class="font-bold text-slate-900">2,03 Mrd. EUR</span></div>
                <div class="flex justify-between"><span class="text-gray-500">Rechtsform</span><span class="font-bold text-slate-900">GmbH (Privatunternehmen)</span></div>
              </div>
              <p class="text-gray-600 text-sm leading-relaxed">
                AVL entwickelt und testet Antriebe – vom Verbrennungsmotor über Hybride bis zum vollelektrischen Antrieb. Die Prüfstände am Grazer Hauptsitz laufen rund um die Uhr. Jeder Prüfstand braucht begleitende Analytik: Emissionsmessung, Werkstoffprüfung, Kühlmittelanalyse.
              </p>
              <p class="text-xs text-gray-400 mt-3">Quelle: AVL List GmbH, Geschäftsbericht</p>
            </div>

            <div class="bg-white rounded-2xl p-8 border border-gray-200 shadow-sm">
              <h3 class="font-heading font-bold text-lg mb-6 text-slate-900">Prüfstandnahe Labortypen</h3>
              <div class="space-y-5">
                <div class="flex gap-4">
                  <div class="w-10 h-10 bg-primary/10 rounded-lg flex items-center justify-center shrink-0">
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-[#7a9900]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2v20M2 12h20"/></svg>
                  </div>
                  <div>
                    <h4 class="font-bold text-sm text-slate-900 mb-1">Emissionsmesslabor</h4>
                    <p class="text-gray-600 text-xs">Abgasanalyse nach Euro 7, Partikelzählung, gasförmige Emissionen. Klimatisiert und schwingungsisoliert direkt neben den Prüfständen.</p>
                  </div>
                </div>
                <div class="flex gap-4">
                  <div class="w-10 h-10 bg-primary/10 rounded-lg flex items-center justify-center shrink-0">
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-[#7a9900]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="m4.93 4.93 14.14 14.14"/></svg>
                  </div>
                  <div>
                    <h4 class="font-bold text-sm text-slate-900 mb-1">Werkstoffprüfung</h4>
                    <p class="text-gray-600 text-xs">Metallografie, Härteprüfung, Korrosionstest. Für Motorenkomponenten, Getriebeteile, Batteriegehäuse – temperiert und staubarm.</p>
                  </div>
                </div>
                <div class="flex gap-4">
                  <div class="w-10 h-10 bg-primary/10 rounded-lg flex items-center justify-center shrink-0">
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-[#7a9900]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 4v10.54a4 4 0 1 1-4 0V4a2 2 0 0 1 4 0Z"/></svg>
                  </div>
                  <div>
                    <h4 class="font-bold text-sm text-slate-900 mb-1">Kühlmittel- & Ölanalytik</h4>
                    <p class="text-gray-600 text-xs">Betriebsflüssigkeitsanalyse für Dauerläufer: Verschleißmetalle, Oxidation, Viskosität. Container direkt am Prüfstandgebäude.</p>
                  </div>
                </div>
                <div class="flex gap-4">
                  <div class="w-10 h-10 bg-primary/10 rounded-lg flex items-center justify-center shrink-0">
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-[#7a9900]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="7" width="20" height="14" rx="2" ry="2"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/></svg>
                  </div>
                  <div>
                    <h4 class="font-bold text-sm text-slate-900 mb-1">Batterie-Testlabor</h4>
                    <p class="text-gray-600 text-xs">Zellcharakterisierung, thermisches Management, Sicherheitstests. Explosionsgeschützt, klimakontrolliert, nach UN 38.3.</p>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Section 2: Magna Steyr & Automotive-Ökosystem -->
    <section class="py-20 bg-slate-900 text-white">
      <div class="container mx-auto px-4">
        <div class="max-w-5xl mx-auto">
          <h2 class="text-3xl md:text-4xl font-heading font-bold mb-6">
            Magna Steyr und Graz' Automotive-Ökosystem
          </h2>
          <p class="text-gray-400 text-lg mb-12 leading-relaxed max-w-3xl">
            Neben AVL ist Magna Steyr der zweite Automotive-Gigant in Graz. Mit rund 8.000 Beschäftigten und über 70.000 produzierten Fahrzeugen pro Jahr ist das Werk eines der flexibelsten Produktionswerke Europas – es baut Fahrzeuge für BMW, Mercedes und andere.
          </p>

          <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            <div class="bg-white/5 border border-white/10 rounded-xl p-6">
              <div class="text-3xl font-heading font-bold text-primary mb-3">~8.000</div>
              <h3 class="font-bold text-white mb-2">Magna Steyr Graz</h3>
              <p class="text-gray-400 text-sm leading-relaxed">
                Auftragsfertigung für Premium-Marken. QC-Labore für Lack, Oberfläche, Korrosion und Materialprüfung. Containerlabore ergänzen bei Modellwechseln und Produktionshochläufen.
              </p>
            </div>
            <div class="bg-white/5 border border-white/10 rounded-xl p-6">
              <div class="text-3xl font-heading font-bold text-primary mb-3">300+</div>
              <h3 class="font-bold text-white mb-2">Zulieferer Steiermark</h3>
              <p class="text-gray-400 text-sm leading-relaxed">
                Die Steiermark ist Österreichs Automobil-Bundesland. Über 300 Zulieferer – von Elektronik bis Guss – benötigen eigene Prüf- und Analytikkapazitäten. Viele davon sind KMU ohne eigenes Labor.
              </p>
            </div>
            <div class="bg-white/5 border border-white/10 rounded-xl p-6">
              <div class="text-3xl font-heading font-bold text-primary mb-3">24/7</div>
              <h3 class="font-bold text-white mb-2">Prüfstand-Rhythmus</h3>
              <p class="text-gray-400 text-sm leading-relaxed">
                Automotive-Tests laufen im Schichtbetrieb. Das begleitende Labor muss mithalten: Emissionsmessungen, Betriebsflüssigkeitsanalysen, Werkstoffproben – rund um die Uhr, ohne Wartezeiten.
              </p>
            </div>
          </div>

          <p class="text-gray-500 text-xs mt-8">Quelle: Magna Steyr Fahrzeugtechnik, Graz; Standortdaten 2024</p>
        </div>
      </div>
    </section>

    <!-- Section 3: TU Graz & Forschungsinstitute -->
    <section class="py-20 bg-white">
      <div class="container mx-auto px-4">
        <div class="max-w-5xl mx-auto">
          <span class="text-primary text-sm font-bold uppercase tracking-wider">Forschung & Wissenschaft</span>
          <h2 class="text-3xl font-heading font-bold mt-3 mb-6 text-slate-900">
            TU Graz, Joanneum Research und CBmed: Forschung auf Weltniveau
          </h2>
          <p class="text-gray-600 text-lg mb-12 leading-relaxed max-w-3xl">
            Graz hat eine der höchsten Forschungsdichten pro Kopf in Österreich. Die Technische Universität, außeruniversitäre Forschungseinrichtungen und spezialisierte Kompetenzzentren bilden ein dichtes Netzwerk.
          </p>

          <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
            <div class="bg-slate-50 rounded-2xl p-8 border border-gray-100">
              <div class="w-12 h-12 bg-slate-900 rounded-xl flex items-center justify-center mb-4">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 10v6M2 10l10-5 10 5-10 5z"/><path d="M6 12v5c0 1 4 3 6 3s6-2 6-3v-5"/></svg>
              </div>
              <h3 class="text-xl font-heading font-bold text-slate-900 mb-3">TU Graz</h3>
              <p class="text-gray-600 text-sm leading-relaxed mb-3">
                Das Institut für Fahrzeugtechnik (FTG) und die Fakultät für Maschinenbau sind europaweit führend in Automotive-Forschung. Prüfstände, Crash-Tests, Batterieforschung – und der ständige Bedarf an flexibler Laborinfrastruktur.
              </p>
              <p class="text-gray-600 text-sm leading-relaxed">
                Containerlabore ergänzen bei Drittmittelprojekten, EU-Forschungsprogrammen und Kooperationen mit der Industrie.
              </p>
            </div>

            <div class="bg-slate-50 rounded-2xl p-8 border border-gray-100">
              <div class="w-12 h-12 bg-slate-900 rounded-xl flex items-center justify-center mb-4">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9.5 2A2.5 2.5 0 0 1 12 4.5v15a2.5 2.5 0 0 1-4.96.44 2.5 2.5 0 0 1-2.96-3.08 3 3 0 0 1-.34-5.58 2.5 2.5 0 0 1 1.32-4.24 2.5 2.5 0 0 1 1.98-3A2.5 2.5 0 0 1 9.5 2Z"/><path d="M14.5 2A2.5 2.5 0 0 0 12 4.5v15a2.5 2.5 0 0 0 4.96.44 2.5 2.5 0 0 0 2.96-3.08 3 3 0 0 0 .34-5.58 2.5 2.5 0 0 0-1.32-4.24 2.5 2.5 0 0 0-1.98-3A2.5 2.5 0 0 0 14.5 2Z"/></svg>
              </div>
              <h3 class="text-xl font-heading font-bold text-slate-900 mb-3">Joanneum Research</h3>
              <p class="text-gray-600 text-sm leading-relaxed mb-3">
                Rund 500 Mitarbeitende aus 25 Ländern arbeiten in Bereichen wie Materials, Health, Digital und Robotics. Als größtes außeruniversitäres Forschungsinstitut der Steiermark sind flexiblen Laborlösungen essenziell.
              </p>
              <p class="text-xs text-gray-400">Quelle: Joanneum Research, Graz</p>
            </div>

            <div class="bg-slate-50 rounded-2xl p-8 border border-gray-100">
              <div class="w-12 h-12 bg-slate-900 rounded-xl flex items-center justify-center mb-4">
