const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Start", "item": "https://planexus.de/" },
    { "@type": "ListItem", "position": 2, "name": "Laborcontainer", "item": "https://planexus.de/laborcontainer" }
  ]
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Was ist ein Laborcontainer?",
      "acceptedAnswer": { "@type": "Answer", "text": "Ein Laborcontainer ist ein werksseitig gefertigtes Raummodul, das nach den Anforderungen an Laboratorien ausgelegt ist: mit Laborlüftung, Medienanschlüssen, chemikalienbeständigen Oberflächen und Sicherheitseinrichtungen wie Abzügen und Notduschen. Er wird fertig ausgebaut angeliefert und am Standort angeschlossen. Mehrere Module lassen sich zu größeren Laborflächen verbinden. Statt Laborcontainer sagt man auch Containerlabor." }
    },
    {
      "@type": "Question",
      "name": "Was ist der Unterschied zwischen Laborcontainer, Containerlabor und Modullabor?",
      "acceptedAnswer": { "@type": "Answer", "text": "Laborcontainer und Containerlabor meinen dasselbe: ein einzelnes Labormodul. Ein Modullabor oder modularer Laborbau besteht aus mehreren solchen Raummodulen, die zu einem Laborgebäude verbunden werden. Ein mobiles Labor ist ein Container oder Aufbau, der regelmäßig den Einsatzort wechselt, etwa auf einem Anhänger. Ein umgebauter ISO-Seecontainer ist eine eigene Variante mit festen Normmaßen." }
    },
    {
      "@type": "Question",
      "name": "Welche Maße hat ein Laborcontainer?",
      "acceptedAnswer": { "@type": "Answer", "text": "Das hängt von der Bauart ab. ISO-Container haben nach ISO 668 eine Außenbreite von 2.438 mm und eine Länge von 6.058 mm (20 Fuß) oder 12.192 mm (40 Fuß). Labormodule sind oft breiter gebaut. Der Planexus LABtoGO misst außen 9.500 × 3.000 × 3.400 mm (Länge × Breite × Höhe) und innen 2.750 mm lichte Raumhöhe." }
    },
    {
      "@type": "Question",
      "name": "Reicht ein umgebauter Seecontainer als Labor?",
      "acceptedAnswer": { "@type": "Answer", "text": "Oft nicht, wegen der Raumhöhe. Ein 20-Fuß-Standardcontainer hat innen typischerweise rund 2.393 mm. Die ASR A1.2 verlangt für Arbeitsräume bis 50 m² mindestens 2,50 m lichte Höhe; Ausnahmen regelt Nr. 6 Abs. 4. Ein 40-Fuß-High-Cube erreicht innen rund 2.698 mm. Dazu kommen die innere Breite von rund 2,35 m und der Platzbedarf von Lüftungskanälen unter der Decke." }
    },
    {
      "@type": "Question",
      "name": "Welcher Luftwechsel gilt in einem Laborcontainer?",
      "acceptedAnswer": { "@type": "Answer", "text": "Dieselben Regeln wie in jedem Labor. Die TRGS 526 nennt in Nr. 6.2.5 als Maßstab 25 Kubikmeter Luft pro Stunde je Quadratmeter Labornutzfläche. Weniger ist nur zulässig, wenn die Gefährdungsbeurteilung das dauerhaft als ausreichend ergibt. Geplant wird die Lüftung nach DIN 1946-7 (Raumlufttechnische Anlagen in Laboratorien, Ausgabe 2022-08)." }
    },
    {
      "@type": "Question",
      "name": "Kann man einen Laborcontainer mieten oder kaufen?",
      "acceptedAnswer": { "@type": "Answer", "text": "Beides ist möglich. Miete eignet sich für zeitlich befristete Forschungsprojekte (typischerweise 12 bis 24 Monate, etwa während Klinik-Sanierungen, Studien oder Drittmittelphasen). Der Kauf ist die wirtschaftlichere Wahl bei dauerhaften Kapazitätserweiterungen. Wir beraten herstellerneutral zur passenden Variante." }
    },
    {
      "@type": "Question",
      "name": "Wie lange dauert die Lieferung eines Laborcontainers?",
      "acceptedAnswer": { "@type": "Answer", "text": "Vom Auftrag bis zur betriebsbereiten Übergabe rechnen wir mit 8 bis 14 Wochen – abhängig von Sicherheitsstufe, Reinraumklasse und Spezialausstattung. Klassischer Festbau benötigt für vergleichbare Labore meist 24 Monate und länger. Standard-LABtoGO-Container sind oft schneller verfügbar." }
    },
    {
      "@type": "Question",
      "name": "Welche Genehmigungen werden für einen Laborcontainer benötigt?",
      "acceptedAnswer": { "@type": "Answer", "text": "Ein aufgestellter Laborcontainer ist in der Regel eine bauliche Anlage: Nach § 2 Abs. 1 der Musterbauordnung gilt das auch für Anlagen, die nur durch ihr eigenes Gewicht auf dem Boden ruhen. Welches Verfahren nötig ist, hängt vom Bundesland und Standort ab. In Deutschland greifen die jeweiligen Landesbauordnungen (HBO Hessen, BayBO Bayern, LBO BW etc.), in Österreich die Bauordnung des jeweiligen Bundeslandes (z. B. Bauordnung für Wien) mit den OIB-Richtlinien, in der Schweiz das kantonale Baubewilligungsverfahren. Wir liefern alle verfahrenstauglichen Bauvorlagen direkt mit und übernehmen auf Wunsch die Begleitung im Genehmigungsprozess." }
    },
    {
      "@type": "Question",
      "name": "Sind die Laborcontainer für BSL-3 geeignet?",
      "acceptedAnswer": { "@type": "Answer", "text": "Ja. Wir realisieren Hochsicherheitslabore der Stufen BSL-2 und BSL-3 inklusive Schleusensystemen, Personendusche, wenn die Gefährdungsbeurteilung sie verlangt, Autoklav, redundanter HEPA-Lüftung mit Unterdruckkaskade und kontinuierlicher Druckdifferenz-Überwachung. Ausgelegt nach BioStoffV, GenTG und TRBA 100." }
    },
    {
      "@type": "Question",
      "name": "Ist GMP-konforme Pilotproduktion in einem Container möglich?",
      "acceptedAnswer": { "@type": "Answer", "text": "Ja. Wir bauen Reinräume bis Klasse C und D nach EU-GMP-Annex 1, optional mit ISO-Klassen 5 bis 8 nach ISO 14644-1. Schleusenkonzept, Materialfluss-Trennung, validierbare Lüftung und IQ/OQ/PQ-fähige Dokumentation sind Standard. Geeignet für klinische Studien, Zellkulturen und kleinformatige Wirkstoffherstellung." }
    },
    {
      "@type": "Question",
      "name": "Welche Innenhöhe haben die Laborcontainer?",
      "acceptedAnswer": { "@type": "Answer", "text": "Ein 20-Fuß-Standardcontainer hat innen typischerweise rund 2.393 mm, ein 40-Fuß-High-Cube rund 2.698 mm (Herstellerdatenblätter). Die Arbeitsstättenregel ASR A1.2 verlangt für Arbeitsräume bis 50 m² Grundfläche mindestens 2,50 m lichte Höhe, über 50 m² mindestens 2,75 m. Der Planexus LABtoGO bietet 2.750 mm lichte Höhe und damit Platz für volle Abzugshauben und große HPLC-Systeme." }
    },
    {
      "@type": "Question",
      "name": "Was kostet ein Laborcontainer?",
      "acceptedAnswer": { "@type": "Answer", "text": "Wir kommunizieren keine Standardpreise, weil jedes Projekt individuell bewertet wird. Sicherheitsstufe (BSL-2/3, GMP, ATEX), Reinraumklasse, Lüftungstechnik, Spezialausstattung, Laufzeit (Miete vs. Kauf) und Standortgegebenheiten bestimmen die Investitionsstruktur. Auf Basis Ihres Lastenhefts oder einer kurzen Beratung liefern wir innerhalb von 48 Stunden eine schriftliche Indikation." }
    }
  ]
};

const features = [
  { icon: "ruler", title: "2.750 mm Innenhöhe", text: "Maximale Ergonomie und Platz für volle Abzugshauben, große HPLC-Systeme und Analysegeräte." },
  { icon: "sun", title: "Maximale Transparenz", text: "Vollverglaste Fronten für natürliches Tageslicht – einzigartig im modularen Laborbau." },
  { icon: "shield", title: "High-End-Isolierung", text: "U-Wert 0,20 W/m²K für präzise Temperaturführung, stabile Klimazonen und Energieeffizienz." },
  { icon: "cpu", title: "Smart-Lab-Ready", text: "Vorbereitet für LIMS, ELN, Sensorik und digitale Labor-Management-Systeme – Plug & Play." }
];

const branchen = [
  { title: "Pharma & Diagnostik", text: "GMP-Reinräume nach ISO 14644 und EU-GMP-Annex 1 für Pilotproduktionen, klinische Studien und Diagnostik. Schleusenkonzepte, Material-/Personenfluss-Trennung und IQ/OQ/PQ-fähige Dokumentation.", img: "/attached_assets/Laborcontainer_001_1769688326918.jpg", imgW: 1980, imgH: 1980 },
  { title: "Biotech & Virologie", text: "Sicherheitslabore der Stufen BSL-2 und BSL-3 mit Unterdruckkaskaden, redundanter HEPA-Filtration, Schleuse, Autoklav und Notabsaugung. Ausgelegt nach BioStoffV, GenTG und TRBA 100.", img: "/attached_assets/Laborcontainer_007_1769688326918.jpg", imgW: 1980, imgH: 1485 },
  { title: "Qualitätskontrolle & Analytik", text: "Analytiklabore mit HPLC-, GC- und Spektrometrie-Arbeitsplätzen, vibrationsentkoppelten Wägetischen, schwingungsisolierten Aufstellungen und unterbrechungsfreier Stromversorgung.", img: "/attached_assets/Laborcontainer_008_1769688326918.jpg", imgW: 1980, imgH: 1485 },
  { title: "Interimslösungen", text: "Vollwertiger Laborersatz während Klinik-Sanierungen, Universitäts-Umbauten oder Industrie-Stillständen. Aufstellung in 48 Stunden, Rücknahme oder Mietkauf am Projektende.", img: "/attached_assets/Laborcontainer_010_1769690502589.jpg", imgW: 1980, imgH: 1485 }
];

const regionen = [
  { stadt: "Hamburg", url: "/laborcontainer-hamburg", fokus: "Hafenklima C5-M, HPA-Genehmigungen, Sturmflutniveau" },
  { stadt: "Berlin", url: "/laborcontainer-berlin", fokus: "12 Bezirksämter, Klinik- und Forschungscampus, Spree-Sandboden" },
  { stadt: "München", url: "/laborcontainer-muenchen", fokus: "Forschungscampus Garching, Föhn-HVAC, Biotech-Cluster Martinsried" },
  { stadt: "Stuttgart", url: "/laborcontainer-stuttgart", fokus: "70 km vom Werk Haigerloch, A81-Logistik, Filderebene" },
  { stadt: "Frankfurt", url: "/laborcontainer-frankfurt", fokus: "Industriepark Höchst, Pharma-Cluster Rhein-Main" },
  { stadt: "Düsseldorf", url: "/laborcontainer-duesseldorf", fokus: "Chemiepark Krefeld-Uerdingen, NRW-BauO" },
  { stadt: "Wien", url: "/laborcontainer-wien", fokus: "Life-Science-Cluster, OIB-Richtlinien, BO Wien" },
  { stadt: "Zürich", url: "/laborcontainer-zuerich", fokus: "Hochschul-Standards, kantonale Baubewilligung" },
  { stadt: "Basel", url: "/laborcontainer-basel", fokus: "Pharma-Cluster, BAFU-Auflagen" }
];
---

<Layout
  title="Laborcontainer – Typen, BSL-Stufen, Ausstattung | Planexus"
  description="Was ein Laborcontainer ist: Typen, BSL-2/3, GMP-Reinraum, ATEX. Schlüsselfertig in 8–14 Wochen ab Werk Haigerloch. LABtoGO-Serie. Beratung anfordern."
  canonical="/laborcontainer"
  ogImage="https://planexus.de/attached_assets/Laborcontainer_001_1769688326918.jpg"
>
  <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <!-- 1. HERO -->
  <section class="relative pt-32 pb-20 bg-slate-900 text-white overflow-hidden">
    <img
      src="/attached_assets/Laborcontainer_001_1769688326918-1600.webp"
      srcset="/attached_assets/Laborcontainer_001_1769688326918-800.webp 800w, /attached_assets/Laborcontainer_001_1769688326918-1200.webp 1200w, /attached_assets/Laborcontainer_001_1769688326918-1600.webp 1600w"
      sizes="100vw"
      alt=""
      width="1600"
      height="1600"
      fetchpriority="high"
      decoding="async"
      class="absolute inset-0 w-full h-full object-cover object-center opacity-30"
    />
    <div class="absolute inset-0 bg-gradient-to-r from-slate-900 via-slate-900/85 to-slate-900/40"></div>
    <div class="container mx-auto px-4 relative z-10">
      <div class="max-w-4xl">
        <div class="inline-flex items-center gap-2 bg-primary/15 border border-primary/40 text-primary px-4 py-1.5 rounded-full text-sm font-semibold mb-6">
          <span class="w-2 h-2 rounded-full bg-primary animate-pulse"></span>
          Made in Germany · Werk Haigerloch
        </div>
        <h1 class="text-4xl md:text-6xl font-bold mb-6 leading-tight">
          Laborcontainer: schlüsselfertige Labore statt jahrelangem Festbau
        </h1>
        <p class="text-xl text-slate-200 leading-relaxed mb-8 max-w-3xl">
          Ein Laborcontainer ist ein werksseitig gefertigtes, anschlussfertiges Labor – vom Analytiklabor bis BSL-3 und GMP-Reinraum. Betriebsbereit in 8 bis 14 Wochen. <a href="/laborcontainer-mieten" class="text-primary underline hover:no-underline">Mieten</a> oder <a href="/laborcontainer-kaufen" class="text-primary underline hover:no-underline">kaufen</a> Sie je nach Nutzungsdauer.
        </p>
        <div class="flex flex-wrap gap-4">
          <a href="/laborcontainer-mieten" class="bg-primary text-slate-900 font-bold px-8 py-4 rounded-lg hover:bg-primary/90 transition-all flex items-center gap-2 shadow-[0_0_24px_rgba(187,215,0,0.35)] group" data-testid="link-hero-mieten">
            Laborcontainer mieten
            <svg class="w-5 h-5 group-hover:translate-x-1 transition-transform" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"/></svg>
          </a>
          <a href="/laborcontainer-kaufen" class="bg-white/10 hover:bg-white/20 backdrop-blur border border-white/30 text-white font-bold px-8 py-4 rounded-lg transition-all flex items-center gap-2" data-testid="link-hero-kaufen">
            Laborcontainer kaufen
          </a>
          <a href="/laborcontainer/labtogo" class="bg-white/10 hover:bg-white/20 backdrop-blur border border-white/30 text-white font-bold px-8 py-4 rounded-lg transition-all flex items-center gap-2" data-testid="link-hero-labtogo">
            LABtoGO entdecken
          </a>
        </div>
        <div class="mt-12 grid grid-cols-2 md:grid-cols-4 gap-6 max-w-3xl">
          <div><div class="text-3xl font-bold text-primary">8–14</div><div class="text-sm text-slate-400">Wochen Lieferzeit</div></div>
          <div><div class="text-3xl font-bold text-primary">2.750</div><div class="text-sm text-slate-400">mm Innenhöhe</div></div>
          <div><div class="text-3xl font-bold text-primary">BSL-3</div><div class="text-sm text-slate-400">Sicherheitsstufe</div></div>
          <div><div class="text-3xl font-bold text-primary">DACH</div><div class="text-sm text-slate-400">DE · AT · CH</div></div>
        </div>
      </div>
    </div>
  </section>

  <!-- Breadcrumb -->
  <div class="bg-slate-50 border-b border-slate-200 py-3">
    <div class="container mx-auto px-4">
      <nav class="flex items-center gap-2 text-sm text-slate-500" aria-label="Breadcrumb">
        <a href="/" class="hover:text-primary">Start</a>
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg>
        <span class="text-[#5c7300] font-medium">Laborcontainer</span>
      </nav>
    </div>
  </div>

  <!-- 2. PROBLEM & LÖSUNG -->
  <section class="py-20 bg-white">
    <div class="container mx-auto px-4">
      <div class="max-w-5xl mx-auto">
        <h2 class="text-3xl md:text-4xl font-bold text-slate-900 mb-6">
          Warum ein Laborcontainer von Planexus die Antwort auf klassische Bauverzögerungen ist
        </h2>
        <p class="text-lg text-slate-600 leading-relaxed mb-8">
          Ein herkömmlicher Labor-Festbau dauert von der Planung bis zur Inbetriebnahme oft 24 Monate und länger. In dieser Zeit hat sich der Markt längst weiterbewegt, Förderfristen sind abgelaufen und Forschungsprojekte gestoppt. Unser <a href="/leistungen/modulbau">Modulbau-Konzept</a> bricht diese Ketten auf – ohne Kompromiss bei Sicherheit, Konformität oder Qualität.
        </p>
        <p class="text-lg text-slate-600 leading-relaxed mb-8">
          Je nach Nutzungsdauer und Bilanzziel können Sie einen <a href="/laborcontainer-mieten" class="text-[#5c7300] font-semibold hover:underline">Laborcontainer mieten</a> oder <a href="/laborcontainer-kaufen" class="text-[#5c7300] font-semibold hover:underline">Laborcontainer kaufen</a>. Für befristete Projekte ist die Miete meist wirtschaftlicher, bei dauerhaftem Bedarf der Kauf.
        </p>
        <div class="flex flex-wrap gap-4 mb-12">
          <a href="/laborcontainer-mieten" class="inline-flex items-center gap-2 bg-primary text-slate-900 font-bold px-6 py-3 rounded-lg hover:bg-primary/90 transition-colors">
            Laborcontainer mieten
            <svg class="w-5 h-5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"/></svg>
          </a>
          <a href="/laborcontainer-kaufen" class="inline-flex items-center gap-2 border-2 border-slate-300 text-slate-900 font-bold px-6 py-3 rounded-lg hover:border-primary transition-colors">
            Laborcontainer kaufen
            <svg class="w-5 h-5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"/></svg>
          </a>
        </div>
        <div class="grid md:grid-cols-3 gap-6">
          <div class="bg-slate-50 rounded-xl p-8 border-l-4 border-primary">
            <div class="w-12 h-12 bg-primary/15 rounded-lg flex items-center justify-center mb-4">
              <svg class="w-6 h-6 text-primary" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
            </div>
            <h3 class="text-xl font-bold text-slate-900 mb-2">Schnelligkeit</h3>
            <p class="text-slate-600">In 8 bis 14 Wochen vom Auftrag zur betriebsbereiten Übergabe – statt 24+ Monate beim Festbau.</p>
          </div>
          <div class="bg-slate-50 rounded-xl p-8 border-l-4 border-primary">
            <div class="w-12 h-12 bg-primary/15 rounded-lg flex items-center justify-center mb-4">
              <svg class="w-6 h-6 text-primary" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>
            </div>
            <h3 class="text-xl font-bold text-slate-900 mb-2">Flexibilität</h3>
            <p class="text-slate-600">Skalierbar, versetzbar, modular erweiterbar. Wachsen Forschungsteams oder Projekte, wächst die Infrastruktur mit.</p>
          </div>
          <div class="bg-slate-50 rounded-xl p-8 border-l-4 border-primary">
            <div class="w-12 h-12 bg-primary/15 rounded-lg flex items-center justify-center mb-4">
              <svg class="w-6 h-6 text-primary" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
            </div>
            <h3 class="text-xl font-bold text-slate-900 mb-2">Sicherheit & Konformität</h3>
            <p class="text-slate-600">Ausgelegt nach BioStoffV, GenTG, TRBA 100, EU-GMP Annex 1, ISO 14644 und den ATEX-Richtlinien.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 2a. BEGRIFF -->
  <section class="py-20 bg-slate-50" id="was-ist-ein-laborcontainer">
    <div class="container mx-auto px-4">
      <div class="max-w-5xl mx-auto">
        <h2 class="text-3xl md:text-4xl font-bold text-slate-900 mb-6">Was ist ein Laborcontainer?</h2>
        <p class="text-lg text-slate-600 leading-relaxed mb-6">
          Ein Laborcontainer ist ein werksseitig gefertigtes Raummodul, das nach den Anforderungen an Laboratorien ausgelegt ist. Er kommt mit Laborlüftung, Medienanschlüssen, chemikalienbeständigen Oberflächen und Sicherheitseinrichtungen wie Abzügen und Notduschen fertig ausgebaut auf die Baustelle und wird dort angeschlossen. Statt Laborcontainer sagen viele auch Containerlabor. Gemeint ist dasselbe.
        </p>
        <p class="text-lg text-slate-600 leading-relaxed mb-8">
          Im Alltag werden mehrere Begriffe vermischt. Die Unterschiede sind für die Planung wichtig, weil sie Maße, Genehmigung und Nutzungsdauer bestimmen:
        </p>
        <div class="overflow-x-auto rounded-xl border border-slate-200 bg-white">
          <table class="w-full text-sm md:text-base">
            <thead><tr><th class="px-4 py-3 text-left font-bold text-slate-900 bg-slate-100">Begriff</th><th class="px-4 py-3 text-left font-bold text-slate-900 bg-slate-100">Was gemeint ist</th></tr></thead>
            <tbody class="text-slate-600">
              <tr><td class="px-4 py-3 border-b border-slate-200"><strong class="text-slate-900">Laborcontainer / Containerlabor</strong></td><td class="px-4 py-3 border-b border-slate-200">Einzelnes Raummodul, werksgefertigt und als Labor ausgebaut</td></tr>
              <tr><td class="px-4 py-3 border-b border-slate-200"><strong class="text-slate-900">Modullabor, modularer Laborbau</strong></td><td class="px-4 py-3 border-b border-slate-200">Mehrere Raummodule, die zu einem Laborgebäude verbunden werden (siehe <a href="/leistungen/modulbau" class="text-[#5c7300] font-medium underline underline-offset-2 hover:no-underline">Modulbau</a>)</td></tr>
              <tr><td class="px-4 py-3 border-b border-slate-200"><strong class="text-slate-900">Mobiles Labor</strong></td><td class="px-4 py-3 border-b border-slate-200">Container oder Aufbau, der regelmäßig den Einsatzort wechselt, zum Beispiel auf einem Anhänger</td></tr>
              <tr><td class="px-4 py-3 border-b border-slate-200"><strong class="text-slate-900">Umgebauter ISO-Seecontainer</strong></td><td class="px-4 py-3 border-b border-slate-200">Frachtcontainer mit festen Normmaßen nach ISO 668, nachträglich zum Labor ausgebaut</td></tr>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </section>

  <!-- 2b. MASSE UND RAUMHÖHE -->
  <section class="py-20 bg-white" id="masse" data-section="masse">
    <div class="container mx-auto px-4">
      <div class="max-w-5xl mx-auto">
        <h2 class="text-3xl md:text-4xl font-bold text-slate-900 mb-6">Größen und Maße: ISO-Container und Labormodul im Vergleich</h2>
        <p class="text-lg text-slate-600 leading-relaxed mb-8">
          ISO-Container haben feste Außenmaße. Für ein Labor zählt aber vor allem die lichte Höhe innen, denn unter der Decke laufen Lüftungskanäle, und Abzüge brauchen Raum nach oben. Die Tabelle zeigt die Normmaße nach ISO 668, typische Innenhöhen aus Herstellerdatenblättern und den LABtoGO.
        </p>
        <div class="overflow-x-auto rounded-xl border border-slate-200 mb-4">
          <table class="w-full text-sm md:text-base">
            <thead><tr><th class="px-4 py-3 text-left font-bold text-slate-900 bg-slate-100">Bauart</th><th class="px-4 py-3 text-left font-bold text-slate-900 bg-slate-100">Außen (L × B × H)</th><th class="px-4 py-3 text-left font-bold text-slate-900 bg-slate-100">Lichte Höhe innen</th></tr></thead>
            <tbody class="text-slate-600">
              <tr><td class="px-4 py-3 border-b border-slate-200">ISO-Container 20 Fuß</td><td class="px-4 py-3 border-b border-slate-200">6.058 × 2.438 × 2.591 mm</td><td class="px-4 py-3 border-b border-slate-200">ca. 2.393 mm</td></tr>
              <tr><td class="px-4 py-3 border-b border-slate-200">ISO-Container 40 Fuß</td><td class="px-4 py-3 border-b border-slate-200">12.192 × 2.438 × 2.591 mm</td><td class="px-4 py-3 border-b border-slate-200">ca. 2.393 mm</td></tr>
              <tr><td class="px-4 py-3 border-b border-slate-200">ISO-Container 40 Fuß High Cube</td><td class="px-4 py-3 border-b border-slate-200">12.192 × 2.438 × 2.896 mm</td><td class="px-4 py-3 border-b border-slate-200">ca. 2.698 mm</td></tr>
              <tr><td class="px-4 py-3 border-b border-slate-200"><strong class="text-slate-900">Planexus <a href="/laborcontainer/labtogo" class="text-[#5c7300] underline underline-offset-2 hover:no-underline">LABtoGO</a></strong></td><td class="px-4 py-3 border-b border-slate-200">9.500 × 3.000 × 3.400 mm</td><td class="px-4 py-3 border-b border-slate-200"><strong class="text-slate-900">2.750 mm</strong></td></tr>
            </tbody>
          </table>
        </div>
        <p class="text-xs text-gray-600 mb-10">Quellen: ISO 668:2020/Amd 1:2022, Tabelle 2 (Außenmaße); Innenhöhen ISO-Container laut Datenblättern von Peters &amp; May und Triton, je nach Serie abweichend; LABtoGO: Planexus.</p>

        <h3 class="text-2xl font-bold text-slate-900 mb-4">Welche Raumhöhe braucht ein Laborcontainer?</h3>
        <p class="text-lg text-slate-600 leading-relaxed mb-6">
          Ein Laborcontainer ist ein Arbeitsraum. Damit gilt die Arbeitsstättenregel ASR A1.2: Arbeitsräume bis 50 m² Grundfläche brauchen mindestens 2,50 m lichte Höhe, über 50 m² mindestens 2,75 m und über 100 m² mindestens 3,00 m (Nr. 6). Ein 20-Fuß-Standardcontainer liegt innen mit rund 2,39 m darunter. Ausnahmen für kleine Räume mit überwiegend leichter oder sitzender Tätigkeit regelt Nr. 6 Abs. 4.
        </p>
        <p class="text-lg text-slate-600 leading-relaxed">
          Verbindet man mehrere Module zu einer Laborfläche über 50 m², steigt die Mindesthöhe auf 2,75 m; eine Minderung um 0,25 m ist nach Nr. 6 möglich, wenn keine gesundheitlichen Bedenken bestehen, aber nicht unter 2,50 m. Der LABtoGO ist mit 2.750 mm lichter Höhe darauf ausgelegt. Wie die Raumhöhe mit Lüftung und Abzügen zusammenhängt, steht im Beitrag <a href="/magazin/anforderungen-laborraeume" class="text-[#5c7300] font-medium underline underline-offset-2 hover:no-underline">Anforderungen an Laborräume</a>.
        </p>
      </div>
    </div>
  </section>

  <!-- 2c. REGELN -->
  <section class="py-20 bg-slate-50" id="normen">
    <div class="container mx-auto px-4">
      <div class="max-w-5xl mx-auto">
        <h2 class="text-3xl md:text-4xl font-bold text-slate-900 mb-6">Normen und Regeln für Laborcontainer</h2>
        <p class="text-lg text-slate-600 leading-relaxed mb-8">
          Für einen Laborcontainer gelten dieselben Arbeitsschutzregeln wie für ein Labor im Massivbau. Die Bauweise ändert daran nichts. Die wichtigsten Vorgaben mit Fundstelle:
        </p>
        <div class="grid md:grid-cols-2 gap-4 mb-8">
          <div class="bg-white rounded-xl p-6 border border-slate-200"><h3 class="font-bold text-slate-900 mb-2">Lüftung</h3><p class="text-slate-600 text-sm">25 m³ Luft pro Stunde je m² Labornutzfläche als Maßstab (TRGS 526 Nr. 6.2.5). Planung der Anlage nach DIN 1946-7, Ausgabe 2022-08.</p></div>
          <div class="bg-white rounded-xl p-6 border border-slate-200"><h3 class="font-bold text-slate-900 mb-2">Türen und Fluchtwege</h3><p class="text-slate-600 text-sm">Labortüren schlagen in Fluchtrichtung auf, Schiebetüren sind nicht zulässig (TRGS 526 Nr. 6.2.3).</p></div>
          <div class="bg-white rounded-xl p-6 border border-slate-200"><h3 class="font-bold text-slate-900 mb-2">Boden</h3><p class="text-slate-600 text-sm">Fußböden und Leitungsdurchführungen müssen wasserdicht sein (TRGS 526 Nr. 6.2.4).</p></div>
          <div class="bg-white rounded-xl p-6 border border-slate-200"><h3 class="font-bold text-slate-900 mb-2">Notduschen</h3><p class="text-slate-600 text-sm">Körpernotduschen mit mindestens 30 Litern pro Minute, Augennotduschen mit mindestens 6 Litern pro Minute (TRGS 526 Nr. 6.6).</p></div>
          <div class="bg-white rounded-xl p-6 border border-slate-200"><h3 class="font-bold text-slate-900 mb-2">Biologische Arbeitsstoffe</h3><p class="text-slate-600 text-sm">Schutzstufen nach BioStoffV und TRBA 100, für gentechnische Arbeiten Sicherheitsstufen nach GenTSV. Mehr dazu im Beitrag <a href="/magazin/bsl-2-bsl-3-container-labor" class="text-[#5c7300] font-medium underline underline-offset-2 hover:no-underline">BSL-2 und BSL-3 im Container</a>.</p></div>
          <div class="bg-white rounded-xl p-6 border border-slate-200"><h3 class="font-bold text-slate-900 mb-2">Abzüge</h3><p class="text-slate-600 text-sm">Laborabzüge nach DIN EN 14175, mit Prüfung vor Ort. Was dabei geprüft wird, steht unter <a href="/magazin/laborabzug-pruefen" class="text-[#5c7300] font-medium underline underline-offset-2 hover:no-underline">Laborabzug prüfen</a>.</p></div>
        </div>
        <p class="text-xs text-gray-600">Quellen: TRGS 526 „Laboratorien“, Ausgabe Februar 2008 (GMBl Nr. 15 vom 2.4.2008); ASR A1.2 Nr. 6; DIN 1946-7:2022-08.</p>
      </div>
    </div>
  </section>

