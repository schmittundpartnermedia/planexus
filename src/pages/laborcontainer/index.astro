---
import Layout from '../../layouts/Layout.astro';
import ContactForm from '../../components/ContactForm.tsx';

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": "Laborcontainer – Schlüsselfertige modulare Labore von Planexus",
  "serviceType": "Vermietung, Verkauf und schlüsselfertige Lieferung von Laborcontainern",
  "description": "Schlüsselfertige Laborcontainer für Pharma, Biotech, Forschung und Industrie. BSL-2, BSL-3, GMP-Reinraum, ATEX und Analytik – betriebsbereit in 8 bis 14 Wochen. Made in Germany aus dem Werk Albstadt. Pioniere im Modulbau seit 2016, ausgezeichnet bei den German CEO Excellence Awards 2026.",
  "url": "https://www.planexus.de/laborcontainer",
  "provider": {
    "@type": "Organization",
    "name": "Planexus GmbH",
    "url": "https://www.planexus.de",
    "logo": "https://www.planexus.de/images/planexus-logo.png",
    "parentOrganization": { "@type": "Organization", "name": "Wesemann Holding GmbH" },
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "Emil-Mayer-Straße 1",
      "addressLocality": "Albstadt",
      "postalCode": "72461",
      "addressCountry": "DE"
    },
    "telephone": "+49 7435 7519 700",
    "email": "info@planexus.de",
    "award": "EU Business News – German CEO Excellence Awards 2026"
  },
  "areaServed": [
    { "@type": "Country", "name": "Deutschland" },
    { "@type": "Country", "name": "Österreich" },
    { "@type": "Country", "name": "Schweiz" }
  ],
  "audience": {
    "@type": "BusinessAudience",
    "audienceType": "Pharma, Biotech, Forschungseinrichtungen, Diagnostiklabore, Industrielle Qualitätskontrolle"
  }
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Start", "item": "https://www.planexus.de/" },
    { "@type": "ListItem", "position": 2, "name": "Laborcontainer", "item": "https://www.planexus.de/laborcontainer" }
  ]
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Kann man einen Laborcontainer mieten oder kaufen?",
      "acceptedAnswer": { "@type": "Answer", "text": "Beides ist möglich. Miete eignet sich für zeitlich befristete Forschungsprojekte (typischerweise 12 bis 24 Monate, etwa während Klinik-Sanierungen, Studien oder Drittmittelphasen). Der Kauf ist die wirtschaftlichere Wahl bei dauerhaften Kapazitätserweiterungen. Wir beraten herstellerneutral zur passenden Variante." }
    },
    {
      "@type": "Question",
      "name": "Wie lange dauert die Lieferung eines Laborcontainers?",
      "acceptedAnswer": { "@type": "Answer", "text": "Vom Auftrag bis zur betriebsbereiten Übergabe rechnen wir mit 8 bis 14 Wochen – abhängig von Sicherheitsstufe, Reinraumklasse und Spezialausstattung. Klassischer Festbau benötigt für vergleichbare Labore meist 24 Monate und länger. Standard-LABtoGO-Container sind oft schneller verfügbar." }
    },
    {
      "@type": "Question",
      "name": "Welche Genehmigungen werden für einen Laborcontainer benötigt?",
      "acceptedAnswer": { "@type": "Answer", "text": "Das hängt vom Bundesland und Standort ab. In Deutschland greifen die jeweiligen Landesbauordnungen (HBO Hessen, BayBO Bayern, LBO BW etc.), in Österreich die ÖNORM B 1300 und das Bauordnungsrecht des jeweiligen Bundeslandes (z. B. BO Wien), in der Schweiz das kantonale Baubewilligungsverfahren. Wir liefern alle verfahrenstauglichen Bauvorlagen direkt mit und übernehmen auf Wunsch die Begleitung im Genehmigungsprozess." }
    },
    {
      "@type": "Question",
      "name": "Sind die Laborcontainer für BSL-3 geeignet?",
      "acceptedAnswer": { "@type": "Answer", "text": "Ja. Wir realisieren Hochsicherheitslabore der Stufen BSL-2 und BSL-3 inklusive Schleusensystemen, Personen- und Materialdusche, Autoklav, redundanter HEPA-Lüftung mit Unterdruckkaskade und kontinuierlicher Druckdifferenz-Überwachung. Konform mit BioStoffV, GenTG und TRBA 100." }
    },
    {
      "@type": "Question",
      "name": "Ist GMP-konforme Pilotproduktion in einem Container möglich?",
      "acceptedAnswer": { "@type": "Answer", "text": "Ja. Wir bauen Reinräume bis Klasse C und D nach EU-GMP-Annex 1, optional mit ISO-Klassen 5 bis 8 nach ISO 14644-1. Schleusenkonzept, Materialfluss-Trennung, validierbare Lüftung und IQ/OQ/PQ-fähige Dokumentation sind Standard. Geeignet für klinische Studien, Zellkulturen und kleinformatige Wirkstoffherstellung." }
    },
    {
      "@type": "Question",
      "name": "Welche Innenhöhe haben die Laborcontainer?",
      "acceptedAnswer": { "@type": "Answer", "text": "Standard-Bürocontainer haben rund 2,40 m Innenhöhe – das reicht für moderne Laborgeräte und Abzüge oft nicht aus. Der Planexus LABtoGO bietet 2.750 mm lichte Höhe und damit Platz für volle Abzugshauben, große HPLC-Systeme und ergonomische Arbeitsbedingungen." }
    },
    {
      "@type": "Question",
      "name": "Was kostet ein Laborcontainer?",
      "acceptedAnswer": { "@type": "Answer", "text": "Wir kommunizieren keine Standardpreise, weil jedes Projekt individuell bewertet wird. Sicherheitsstufe (BSL-2/3, GMP, ATEX), Reinraumklasse, Lüftungstechnik, Spezialausstattung, Laufzeit (Miete vs. Kauf) und Standortgegebenheiten bestimmen die Investitionsstruktur. Auf Basis Ihres Lastenhefts oder einer kurzen Beratung liefern wir innerhalb von 48 Stunden eine schriftliche Indikation." }
    }
  ]
};

const features = [
  { icon: "ruler", title: "2.750 mm Innenhöhe", text: "Maximale Ergonomie und Platz für volle Abzugshauben, große HPLC-Systeme und Analysegeräte." },
  { icon: "sun", title: "Maximale Transparenz", text: "Vollverglaste Fronten für natürliches Tageslicht – einzigartig im modularen Laborbau." },
  { icon: "shield", title: "High-End-Isolierung", text: "U-Wert 0,20 W/m²K für präzise Temperaturführung, stabile Klimazonen und Energieeffizienz." },
  { icon: "cpu", title: "Smart-Lab-Ready", text: "Vorbereitet für LIMS, ELN, Sensorik und digitale Labor-Management-Systeme – Plug & Play." }
];

const branchen = [
  { title: "Pharma & Diagnostik", text: "GMP-Reinräume nach ISO 14644 und EU-GMP-Annex 1 für Pilotproduktionen, klinische Studien und Diagnostik. Schleusenkonzepte, Material-/Personenfluss-Trennung und IQ/OQ/PQ-fähige Dokumentation.", img: "/attached_assets/Laborcontainer_001_1769688326918.jpg" },
  { title: "Biotech & Virologie", text: "Sicherheitslabore der Stufen BSL-2 und BSL-3 mit Unterdruckkaskaden, redundanter HEPA-Filtration, Schleuse, Autoklav und Notabsaugung. Konform mit BioStoffV, GenTG, TRBA 100.", img: "/attached_assets/Laborcontainer_007_1769688326918.jpg" },
  { title: "Qualitätskontrolle & Analytik", text: "Analytiklabore mit HPLC-, GC- und Spektrometrie-Arbeitsplätzen, vibrationsentkoppelten Wägetischen, schwingungsisolierten Aufstellungen und unterbrechungsfreier Stromversorgung.", img: "/attached_assets/Laborcontainer_008_1769688326918.jpg" },
  { title: "Interimslösungen", text: "Vollwertiger Laborersatz während Klinik-Sanierungen, Universitäts-Umbauten oder Industrie-Stillständen. Aufstellung in 48 Stunden, Rücknahme oder Mietkauf am Projektende.", img: "/attached_assets/Laborcontainer_010_1769690502589.jpg" }
];

const regionen = [
  { stadt: "Hamburg", url: "/laborcontainer-hamburg", fokus: "Hafenklima C5-M, HPA-Genehmigungen, Sturmflutniveau" },
  { stadt: "Berlin", url: "/laborcontainer-berlin", fokus: "12 Bezirksämter, Charité-RKI-MDC, Spree-Sandboden" },
  { stadt: "München", url: "/laborcontainer-muenchen", fokus: "TUM Garching, FRM II, Föhn-HVAC, Martinsried-Cluster" },
  { stadt: "Stuttgart", url: "/laborcontainer-stuttgart", fokus: "80 km vom Werk Albstadt, A81-Logistik, Filderebene" },
  { stadt: "Frankfurt", url: "/laborcontainer-frankfurt", fokus: "Industriepark Höchst, Pharma-Cluster Rhein-Main" },
  { stadt: "Düsseldorf", url: "/laborcontainer-duesseldorf", fokus: "Chemiepark Krefeld-Uerdingen, NRW-BauO" },
  { stadt: "Wien", url: "/laborcontainer-wien", fokus: "Vienna BioCenter, ÖNORM B 1300, BO Wien" },
  { stadt: "Zürich", url: "/laborcontainer-zuerich", fokus: "ETH-Standards, kantonale Baubewilligung" },
  { stadt: "Basel", url: "/laborcontainer-basel", fokus: "Pharma-Cluster Roche/Novartis, BAFU-Auflagen" }
];
---

<Layout
  title="Laborcontainer kaufen & mieten | Modulbau | Planexus"
  description="Hochwertige Laborcontainer für Pharma, Biotech & Forschung. BSL-2, BSL-3 & GMP-konform. In 8–14 Wochen betriebsbereit. LABtoGO – Made in Germany."
  canonical="/laborcontainer"
  ogImage="https://www.planexus.de/attached_assets/Laborcontainer_001_1769688326918.jpg"
>
  <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <!-- 1. HERO -->
  <section class="relative pt-32 pb-20 bg-slate-900 text-white overflow-hidden">
    <div class="absolute inset-0 bg-[url('/attached_assets/Laborcontainer_001_1769688326918.jpg')] bg-cover bg-center opacity-30"></div>
    <div class="absolute inset-0 bg-gradient-to-r from-slate-900 via-slate-900/85 to-slate-900/40"></div>
    <div class="container mx-auto px-4 relative z-10">
      <div class="max-w-4xl">
        <div class="inline-flex items-center gap-2 bg-primary/15 border border-primary/40 text-primary px-4 py-1.5 rounded-full text-sm font-semibold mb-6">
          <span class="w-2 h-2 rounded-full bg-primary animate-pulse"></span>
          Made in Germany · Werk Albstadt · seit 2016
        </div>
        <h1 class="text-4xl md:text-6xl font-bold mb-6 leading-tight">
          Laborcontainer: <span class="text-primary">schlüsselfertige modulare Labore</span> für Forschung und Industrie
        </h1>
        <p class="text-xl text-slate-200 leading-relaxed mb-8 max-w-3xl">
          Wenn Raum zum Engpass für Ihre Forschung wird, liefern wir die Lösung. Hochmoderne, mobile Laborumgebungen – vom Analytiklabor bis zum BSL-3-Hochsicherheitsbereich. Betriebsbereit in 8 bis 14 Wochen.
        </p>
        <div class="flex flex-wrap gap-4">
          <a href="/kontakt" class="bg-primary text-slate-900 font-bold px-8 py-4 rounded-lg hover:bg-primary/90 transition-all flex items-center gap-2 shadow-[0_0_24px_rgba(187,215,0,0.35)] group" data-testid="link-hero-beratung">
            Jetzt beraten lassen
            <svg class="w-5 h-5 group-hover:translate-x-1 transition-transform" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"/></svg>
          </a>
          <a href="/laborcontainer/labtogo" class="bg-white/10 hover:bg-white/20 backdrop-blur border border-white/30 text-white font-bold px-8 py-4 rounded-lg transition-all flex items-center gap-2" data-testid="link-hero-labtogo">
            LABtoGO entdecken
            <svg class="w-5 h-5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M7 7h10v10"/><path d="M7 17 17 7"/></svg>
          </a>
        </div>
        <div class="mt-12 grid grid-cols-2 md:grid-cols-4 gap-6 max-w-3xl">
          <div><div class="text-3xl font-bold text-primary">8–14</div><div class="text-sm text-slate-400">Wochen Lieferzeit</div></div>
          <div><div class="text-3xl font-bold text-primary">2.750</div><div class="text-sm text-slate-400">mm Innenhöhe</div></div>
          <div><div class="text-3xl font-bold text-primary">BSL-3</div><div class="text-sm text-slate-400">Sicherheitsstufe</div></div>
          <div><div class="text-3xl font-bold text-primary">DACH</div><div class="text-sm text-slate-400">DE · AT · CH</div></div>
        </div>
      </div>
    </div>
  </section>

  <!-- Breadcrumb -->
  <div class="bg-slate-50 border-b border-slate-200 py-3">
    <div class="container mx-auto px-4">
      <nav class="flex items-center gap-2 text-sm text-slate-500" aria-label="Breadcrumb">
        <a href="/" class="hover:text-primary">Start</a>
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg>
        <span class="text-primary font-medium">Laborcontainer</span>
      </nav>
    </div>
  </div>

  <!-- 2. PROBLEM & LÖSUNG -->
  <section class="py-20 bg-white">
    <div class="container mx-auto px-4">
      <div class="max-w-5xl mx-auto">
        <h2 class="text-3xl md:text-4xl font-bold text-slate-900 mb-6">
          Warum ein Laborcontainer von Planexus die Antwort auf klassische Bauverzögerungen ist
        </h2>
        <p class="text-lg text-slate-600 leading-relaxed mb-12">
          Ein herkömmlicher Labor-Festbau dauert von der Planung bis zur Inbetriebnahme oft 3 bis 5 Jahre. In dieser Zeit hat sich der Markt längst weiterbewegt, Förderfristen sind abgelaufen und Forschungsprojekte gestoppt. Unsere Modulbauweise bricht diese Ketten auf – ohne Kompromiss bei Sicherheit, Konformität oder Qualität.
        </p>
        <div class="grid md:grid-cols-3 gap-6">
          <div class="bg-slate-50 rounded-xl p-8 border-l-4 border-primary">
            <div class="w-12 h-12 bg-primary/15 rounded-lg flex items-center justify-center mb-4">
              <svg class="w-6 h-6 text-primary" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
            </div>
            <h3 class="text-xl font-bold text-slate-900 mb-2">Schnelligkeit</h3>
            <p class="text-slate-600">In 8 bis 14 Wochen vom Auftrag zur betriebsbereiten Übergabe – statt 24+ Monate beim Festbau.</p>
          </div>
          <div class="bg-slate-50 rounded-xl p-8 border-l-4 border-primary">
            <div class="w-12 h-12 bg-primary/15 rounded-lg flex items-center justify-center mb-4">
              <svg class="w-6 h-6 text-primary" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>
            </div>
            <h3 class="text-xl font-bold text-slate-900 mb-2">Flexibilität</h3>
            <p class="text-slate-600">Skalierbar, versetzbar, modular erweiterbar. Wachsen Forschungsteams oder Projekte, wächst die Infrastruktur mit.</p>
          </div>
          <div class="bg-slate-50 rounded-xl p-8 border-l-4 border-primary">
            <div class="w-12 h-12 bg-primary/15 rounded-lg flex items-center justify-center mb-4">
              <svg class="w-6 h-6 text-primary" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
            </div>
            <h3 class="text-xl font-bold text-slate-900 mb-2">Sicherheit & Konformität</h3>
            <p class="text-slate-600">Volle Konformität mit BioStoffV, GenTG, TRBA 100, EU-GMP Annex 1, ISO 14644 und ATEX-Richtlinien.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 3. LABTOGO -->
  <section class="py-20 bg-slate-900 text-white relative overflow-hidden">
    <div class="absolute top-0 right-0 w-1/2 h-full bg-[url('/attached_assets/Laborcontainer_013_1769690552935.jpg')] bg-cover bg-center opacity-20"></div>
    <div class="absolute inset-0 bg-gradient-to-r from-slate-900 via-slate-900 to-transparent"></div>
    <div class="container mx-auto px-4 relative z-10">
      <div class="max-w-3xl">
        <span class="inline-block bg-primary text-slate-900 px-3 py-1 rounded text-xs font-bold mb-4">FLAGGSCHIFF</span>
        <h2 class="text-3xl md:text-4xl font-bold mb-6">
          LABtoGO – die neue Dimension des mobilen Arbeitens
        </h2>
        <p class="text-lg text-slate-300 mb-12 leading-relaxed">
          Vergessen Sie den Standard-Bürocontainer. Der LABtoGO wurde von Planexus speziell für die Anforderungen moderner Wissenschaftler entwickelt – und setzt im Modulbau neue Maßstäbe in Höhe, Lichtdurchlässigkeit und digitaler Anschlussfähigkeit.
        </p>
      </div>
      <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6 max-w-6xl">
        {features.map(f => (
          <div class="bg-white/5 backdrop-blur border border-white/10 rounded-xl p-6 hover:border-primary/40 transition-colors">
            <div class="w-12 h-12 bg-primary/20 rounded-lg flex items-center justify-center mb-4 text-primary">
              {f.icon === "ruler" && <svg class="w-6 h-6" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21.3 15.3a2.4 2.4 0 0 1 0 3.4l-2.6 2.6a2.4 2.4 0 0 1-3.4 0L2.7 8.7a2.41 2.41 0 0 1 0-3.4l2.6-2.6a2.41 2.41 0 0 1 3.4 0Z"/><path d="m14.5 12.5 2-2"/><path d="m11.5 9.5 2-2"/><path d="m8.5 6.5 2-2"/><path d="m17.5 15.5 2-2"/></svg>}
              {f.icon === "sun" && <svg class="w-6 h-6" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="4"/><path d="M12 2v2"/><path d="M12 20v2"/><path d="m4.93 4.93 1.41 1.41"/><path d="m17.66 17.66 1.41 1.41"/><path d="M2 12h2"/><path d="M20 12h2"/><path d="m6.34 17.66-1.41 1.41"/><path d="m19.07 4.93-1.41 1.41"/></svg>}
              {f.icon === "shield" && <svg class="w-6 h-6" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>}
              {f.icon === "cpu" && <svg class="w-6 h-6" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="4" y="4" width="16" height="16" rx="2"/><rect x="9" y="9" width="6" height="6"/><path d="M15 2v2"/><path d="M15 20v2"/><path d="M2 15h2"/><path d="M2 9h2"/><path d="M20 15h2"/><path d="M20 9h2"/><path d="M9 2v2"/><path d="M9 20v2"/></svg>}
            </div>
            <h3 class="text-lg font-bold mb-2 text-white">{f.title}</h3>
            <p class="text-sm text-slate-300 leading-relaxed">{f.text}</p>
          </div>
        ))}
      </div>
      <div class="mt-12">
        <a href="/laborcontainer/labtogo" class="inline-flex items-center gap-2 bg-primary text-slate-900 font-bold px-8 py-4 rounded-lg hover:bg-primary/90 transition-colors group" data-testid="link-labtogo-detail">
          Komplette LABtoGO Spezifikationen ansehen
          <svg class="w-5 h-5 group-hover:translate-x-1 transition-transform" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"/></svg>
        </a>
      </div>
    </div>
  </section>

  <!-- 4. BRANCHEN / ANWENDUNGEN -->
  <section class="py-20 bg-slate-50">
    <div class="container mx-auto px-4">
      <div class="max-w-3xl mb-12">
        <h2 class="text-3xl md:text-4xl font-bold text-slate-900 mb-4">
          Maßgeschneiderte Konfigurationen für jede Disziplin
        </h2>
        <p class="text-lg text-slate-600">
          Vier Konfigurationsfamilien, hunderte realisierte Projekte. Jeder Container wird auf Ihre Sicherheitsstufe, Reinraumklasse und Ausstattung individuell geplant.
        </p>
      </div>
      <div class="grid md:grid-cols-2 gap-6">
        {branchen.map(b => (
          <div class="bg-white rounded-xl overflow-hidden shadow-sm hover:shadow-lg transition-shadow border border-slate-200 group">
            <div class="aspect-[16/9] overflow-hidden">
              <img src={b.img} alt={b.title} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy" />
            </div>
            <div class="p-6">
              <h3 class="text-xl font-bold text-slate-900 mb-3">{b.title}</h3>
              <p class="text-slate-600 leading-relaxed">{b.text}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 5. VERGLEICHSMATRIX -->
  <section class="py-20 bg-white">
    <div class="container mx-auto px-4">
      <div class="max-w-5xl mx-auto">
        <h2 class="text-3xl md:text-4xl font-bold text-slate-900 mb-4">
          Festbau vs. Standard-Container vs. Planexus LABtoGO
        </h2>
        <p class="text-lg text-slate-600 mb-12">
          Drei Bauarten, drei völlig unterschiedliche Realitäten. Diese Tabelle hilft Ihnen bei der Investitionsentscheidung.
        </p>
        <div class="overflow-x-auto rounded-xl border border-slate-200 shadow-sm">
          <table class="w-full text-sm md:text-base">
            <caption class="sr-only">Vergleich von Festbau, Standard-Container und Planexus LABtoGO anhand zentraler Bau- und Betriebskriterien.</caption>
            <thead class="bg-slate-900 text-white">
              <tr>
                <th scope="col" class="text-left px-6 py-4 font-bold">Kriterium</th>
                <th scope="col" class="text-center px-6 py-4 font-bold">Festbau</th>
                <th scope="col" class="text-center px-6 py-4 font-bold">Standard-Container</th>
                <th scope="col" class="text-center px-6 py-4 font-bold bg-primary/20 text-primary">Planexus LABtoGO</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-200">
              <tr class="hover:bg-slate-50">
                <td class="px-6 py-4 font-semibold text-slate-900">Lieferzeit</td>
                <td class="text-center px-6 py-4 text-slate-600">24+ Monate</td>
                <td class="text-center px-6 py-4 text-slate-600">~16 Wochen</td>
                <td class="text-center px-6 py-4 font-bold text-primary bg-primary/5">8–14 Wochen</td>
              </tr>
              <tr class="hover:bg-slate-50">
                <td class="px-6 py-4 font-semibold text-slate-900">Innenhöhe</td>
                <td class="text-center px-6 py-4 text-slate-600">3,00 m+</td>
                <td class="text-center px-6 py-4 text-slate-600">2,40 m</td>
                <td class="text-center px-6 py-4 font-bold text-primary bg-primary/5">2,75 m</td>
              </tr>
              <tr class="hover:bg-slate-50">
                <td class="px-6 py-4 font-semibold text-slate-900">Tageslicht</td>
                <td class="text-center px-6 py-4 text-slate-600">Hoch</td>
                <td class="text-center px-6 py-4 text-slate-600">Sehr gering</td>
                <td class="text-center px-6 py-4 font-bold text-primary bg-primary/5">Maximal (vollverglast)</td>
              </tr>
              <tr class="hover:bg-slate-50">
                <td class="px-6 py-4 font-semibold text-slate-900">Sicherheitsstufen</td>
                <td class="text-center px-6 py-4 text-slate-600">Alle</td>
                <td class="text-center px-6 py-4 text-slate-600">Bedingt</td>
                <td class="text-center px-6 py-4 font-bold text-primary bg-primary/5">BSL-1 bis BSL-3 / GMP</td>
              </tr>
              <tr class="hover:bg-slate-50">
                <td class="px-6 py-4 font-semibold text-slate-900">Mobilität</td>
                <td class="text-center px-6 py-4 text-slate-600">Keine</td>
                <td class="text-center px-6 py-4 text-slate-600">Hoch</td>
                <td class="text-center px-6 py-4 font-bold text-primary bg-primary/5">Hoch</td>
              </tr>
              <tr class="hover:bg-slate-50">
                <td class="px-6 py-4 font-semibold text-slate-900">Skalierbarkeit</td>
                <td class="text-center px-6 py-4 text-slate-600">Aufwändig</td>
                <td class="text-center px-6 py-4 text-slate-600">Mittel</td>
                <td class="text-center px-6 py-4 font-bold text-primary bg-primary/5">Modular jederzeit</td>
              </tr>
              <tr class="hover:bg-slate-50">
                <td class="px-6 py-4 font-semibold text-slate-900">Wiederverwendbarkeit</td>
                <td class="text-center px-6 py-4 text-slate-600">Keine</td>
                <td class="text-center px-6 py-4 text-slate-600">Hoch</td>
                <td class="text-center px-6 py-4 font-bold text-primary bg-primary/5">Sehr hoch (Mietkauf möglich)</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </section>

  <!-- 6. REGIONAL-HUB -->
  <section class="py-20 bg-slate-50">
    <div class="container mx-auto px-4">
      <div class="max-w-3xl mb-12">
        <h2 class="text-3xl md:text-4xl font-bold text-slate-900 mb-4">
          Regionale Expertise in ganz DACH
        </h2>
        <p class="text-lg text-slate-600">
          Wir kennen die lokalen Bauordnungen, Klima-Anforderungen und Forschungs-Cluster. Entdecken Sie unsere standortspezifischen Lösungen für die wichtigsten Wissenschafts- und Industriezentren in Deutschland, Österreich und der Schweiz.
        </p>
      </div>
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-4">
        {regionen.map(r => (
          <a href={r.url} class="bg-white rounded-xl p-6 border border-slate-200 hover:border-primary hover:shadow-lg transition-all group block" data-testid={`link-region-${r.stadt.toLowerCase()}`}>
            <div class="flex items-start justify-between mb-3">
              <h3 class="text-xl font-bold text-slate-900 group-hover:text-primary transition-colors">Laborcontainer {r.stadt}</h3>
              <svg class="w-5 h-5 text-slate-400 group-hover:text-primary group-hover:translate-x-1 transition-all flex-shrink-0 mt-1" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg>
            </div>
            <p class="text-sm text-slate-600">{r.fokus}</p>
          </a>
        ))}
      </div>
      <div class="text-center mt-8">
        <a href="/#standorte" class="inline-flex items-center gap-2 text-primary font-semibold hover:underline" data-testid="link-all-locations">
          Alle 12 DACH-Standorte ansehen
          <svg class="w-4 h-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg>
        </a>
      </div>
    </div>
  </section>

  <!-- 7. FAQ -->
  <section class="py-20 bg-white">
    <div class="container mx-auto px-4">
      <div class="max-w-4xl mx-auto">
        <h2 class="text-3xl md:text-4xl font-bold text-slate-900 mb-4">
          Häufige Fragen zum Thema Laborcontainer
        </h2>
        <p class="text-lg text-slate-600 mb-12">
          Die wichtigsten Antworten zu Lieferzeit, Genehmigungen, Sicherheitsstufen, GMP-Konformität und Investition.
        </p>
        <div class="space-y-4">
          {faqSchema.mainEntity.map((q, i) => (
            <details class="bg-slate-50 rounded-xl border border-slate-200 group" open={i === 0}>
              <summary class="cursor-pointer p-6 font-bold text-slate-900 flex items-center justify-between gap-4 list-none">
                <span class="flex-1">{q.name}</span>
                <svg class="w-5 h-5 text-primary group-open:rotate-180 transition-transform flex-shrink-0" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="6 9 12 15 18 9"/></svg>
              </summary>
              <div class="px-6 pb-6 text-slate-600 leading-relaxed">
                {q.acceptedAnswer.text}
              </div>
            </details>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- 8. FINALER CTA + KONTAKTFORMULAR -->
  <section class="py-20 bg-slate-900 text-white relative overflow-hidden">
    <div class="absolute inset-0 bg-[url('/attached_assets/Laborcontainer_017_1769688326919.jpg')] bg-cover bg-center opacity-15"></div>
    <div class="absolute inset-0 bg-gradient-to-b from-slate-900 via-slate-900/95 to-slate-900"></div>
    <div class="container mx-auto px-4 relative z-10">
      <div class="max-w-6xl mx-auto grid lg:grid-cols-2 gap-12">
