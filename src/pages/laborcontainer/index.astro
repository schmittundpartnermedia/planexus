    "parentOrganization": { "@type": "Organization", "name": "Wesemann Holding GmbH" },
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "Am Steinbach 8",
      "addressLocality": "Albstadt-Laufen",
      "addressRegion": "Baden-Württemberg",
      "postalCode": "72459",
      "addressCountry": "DE"
    }, "location": [{ "@type": "Place", "name": "Planexus GmbH – Büro (Firmensitz)", "address": { "@type": "PostalAddress", "streetAddress": "Am Steinbach 8", "addressLocality": "Albstadt-Laufen", "addressRegion": "Baden-Württemberg", "postalCode": "72459", "addressCountry": "DE" } }, { "@type": "Place", "name": "Planexus GmbH – Fertigung", "telephone": "+49 7474 4273000", "address": { "@type": "PostalAddress", "streetAddress": "Hospach 1", "addressLocality": "Haigerloch", "addressRegion": "Baden-Württemberg", "postalCode": "72401", "addressCountry": "DE" } }],
    "telephone": "+49 7435 7519 700",
    "email": "info@planexus.de"
  },
  "areaServed": [
