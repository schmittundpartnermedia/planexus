---
import Layout from '../../layouts/Layout.astro';
import Footer from '../../components/Footer.astro';
---

<Layout
  title="LABtoGO – Der Laborcontainer 2.0 | Planexus"
  description="LABtoGO von Planexus: Der standardisierte Plug & Play Laborcontainer. 100% vorgefertigt, sofort einsatzbereit. 3D-Modell, Innenrundgang & alle Fakten."
  canonical="/laborcontainer/lab-to-go"
  ogImage="/images/labtogo-logo.png"
>

  <section id="hero-3d" class="relative w-full bg-[#13161c]" style="height:100vh;">
    <canvas id="c" class="absolute inset-0 w-full h-full cursor-grab active:cursor-grabbing" style="z-index:1;"></canvas>

    <div id="hero-overlay" class="absolute inset-0 z-10 pointer-events-none">
      <div class="absolute top-24 left-0 right-0 flex flex-col items-center gap-4" id="headline">
        <img src="/images/labtogo-logo.png" alt="LABtoGO – Der Laborcontainer 2.0 von Planexus" class="h-14 md:h-20 w-auto" />
        <p class="text-[11px] text-[#7a8fa8] tracking-[3px] uppercase">Der Laborcontainer 2.0 · 100% Plug & Play · planexus.de</p>
      </div>

      <button id="cta-btn" class="pointer-events-auto absolute left-1/2 -translate-x-1/2 bottom-28 md:bottom-32 flex items-center gap-3 bg-[#297a38] hover:bg-[#38a049] text-white font-semibold px-7 py-4 text-[11px] tracking-[3px] uppercase transition-all" style="clip-path:polygon(0 0,calc(100% - 9px) 0,100% 9px,100% 100%,9px 100%,0 calc(100% - 9px));font-family:'Barlow Condensed',sans-serif;">
        <div class="w-0 h-0 border-t-[5px] border-t-transparent border-b-[5px] border-b-transparent border-l-[9px] border-l-white shrink-0"></div>
        Innenansicht erleben
      </button>

      <div id="controls" class="pointer-events-auto absolute right-7 bottom-10 flex gap-3 items-center transition-opacity duration-500">
        <button class="text-[10px] tracking-[2px] uppercase text-[#7a8fa8] bg-[rgba(19,22,28,0.8)] backdrop-blur-sm border border-[rgba(122,143,168,0.16)] px-4 py-2 cursor-pointer hover:text-white hover:border-[rgba(126,211,33,0.35)] transition-all" id="btn-reset" style="font-family:'Barlow Condensed',sans-serif;">Reset</button>
        <span class="text-[10px] tracking-[1.5px] text-[rgba(122,143,168,0.38)] uppercase hidden md:inline">Drag · Scroll</span>
        <button class="text-[10px] tracking-[2px] uppercase bg-[rgba(19,22,28,0.8)] backdrop-blur-sm border border-[rgba(126,211,33,0.18)] px-4 py-2 cursor-pointer hover:text-white transition-all" id="btn-auto" style="font-family:'Barlow Condensed',sans-serif;color:rgba(126,211,33,.65);">Auto &bull;</button>
      </div>

      <div id="specs" class="absolute top-1/2 right-7 -translate-y-1/2 flex-col gap-2 transition-opacity duration-500 hidden md:flex">
        <div class="flex items-center gap-2 text-[10px] tracking-[2px] uppercase text-[rgba(122,143,168,0.45)]" style="font-family:'Barlow Condensed',sans-serif;">
          <div class="w-1 h-1 rounded-full bg-[rgba(126,211,33,0.55)] shrink-0"></div>Typ <strong class="text-[#7a8fa8] font-normal">LABtoGO 2.0</strong>
        </div>
        <div class="flex items-center gap-2 text-[10px] tracking-[2px] uppercase text-[rgba(122,143,168,0.45)]" style="font-family:'Barlow Condensed',sans-serif;">
          <div class="w-1 h-1 rounded-full bg-[rgba(126,211,33,0.55)] shrink-0"></div>Außenlänge <strong class="text-[#7a8fa8] font-normal">9.500 mm</strong>
        </div>
        <div class="flex items-center gap-2 text-[10px] tracking-[2px] uppercase text-[rgba(122,143,168,0.45)]" style="font-family:'Barlow Condensed',sans-serif;">
          <div class="w-1 h-1 rounded-full bg-[rgba(126,211,33,0.55)] shrink-0"></div>Außenbreite <strong class="text-[#7a8fa8] font-normal">3.000 mm</strong>
        </div>
        <div class="flex items-center gap-2 text-[10px] tracking-[2px] uppercase text-[rgba(122,143,168,0.45)]" style="font-family:'Barlow Condensed',sans-serif;">
          <div class="w-1 h-1 rounded-full bg-[rgba(126,211,33,0.55)] shrink-0"></div>Außenhöhe <strong class="text-[#7a8fa8] font-normal">3.400 mm</strong>
        </div>
        <div class="flex items-center gap-2 text-[10px] tracking-[2px] uppercase text-[rgba(122,143,168,0.45)]" style="font-family:'Barlow Condensed',sans-serif;">
          <div class="w-1 h-1 rounded-full bg-[rgba(126,211,33,0.55)] shrink-0"></div>Labortiefe <strong class="text-[#7a8fa8] font-normal">&gt; 6.200 mm</strong>
        </div>
        <div class="flex items-center gap-2 text-[10px] tracking-[2px] uppercase text-[rgba(122,143,168,0.45)]" style="font-family:'Barlow Condensed',sans-serif;">
          <div class="w-1 h-1 rounded-full bg-[rgba(126,211,33,0.55)] shrink-0"></div>Raumhöhe <strong class="text-[#7a8fa8] font-normal">2.750 mm</strong>
        </div>
        <div class="flex items-center gap-2 text-[10px] tracking-[2px] uppercase text-[rgba(122,143,168,0.45)]" style="font-family:'Barlow Condensed',sans-serif;">
          <div class="w-1 h-1 rounded-full bg-[rgba(126,211,33,0.55)] shrink-0"></div>Glasfront <strong class="text-[#7a8fa8] font-normal">Vollverglast</strong>
        </div>
        <div class="flex items-center gap-2 text-[10px] tracking-[2px] uppercase text-[rgba(122,143,168,0.45)]" style="font-family:'Barlow Condensed',sans-serif;">
          <div class="w-1 h-1 rounded-full bg-[rgba(126,211,33,0.55)] shrink-0"></div>Lackierung <strong class="text-[#7a8fa8] font-normal">RAL 7016 Anthrazit</strong>
        </div>
      </div>
    </div>

    <div class="cm fixed z-20 w-6 h-6 pointer-events-none top-[62px] left-7 border-t border-l border-[rgba(126,211,33,0.35)]"></div>
    <div class="cm fixed z-20 w-6 h-6 pointer-events-none bottom-8 right-7 border-b border-r border-[rgba(126,211,33,0.35)]"></div>

    <div id="vign" class="fixed inset-0 z-[25] pointer-events-none transition-opacity duration-400" style="opacity:0;background:radial-gradient(ellipse at center,transparent 0%,#000 100%);"></div>

    <div id="vid-ov" class="fixed inset-0 z-[30] bg-black flex flex-col items-center justify-center pointer-events-none transition-opacity duration-600" style="opacity:0;">
      <div id="vid-wrap" class="w-[min(90vw,1080px)] bg-black border border-[rgba(187,215,0,0.35)] overflow-hidden transition-transform duration-600" style="aspect-ratio:16/9;transform:scale(0.93);cursor:grab;">
        <div id="vid-screen" class="relative w-full h-full overflow-hidden" style="background:linear-gradient(135deg,#0a160b,#162814,#0a160b);">
          <div id="scan-line" class="absolute left-0 right-0 h-[2px]" style="background:linear-gradient(90deg,transparent,#bbd700,transparent);animation:scanAnim 3s linear infinite;"></div>
          <div class="absolute top-4 left-4 text-[9px] tracking-[3px] uppercase text-[#bbd700] border border-[rgba(187,215,0,0.2)] bg-[rgba(187,215,0,0.07)] px-3 py-1" style="font-family:'Barlow Condensed',sans-serif;">Imagefilm — LABtoGO Innenansicht</div>
          <div id="vid-branding" class="flex flex-col items-center justify-center h-full gap-4">
            <button id="play-big" class="w-16 h-16 rounded-full border-2 border-[rgba(187,215,0,0.38)] flex items-center justify-center cursor-pointer hover:border-[#bbd700] transition-all" style="animation:pulse-glow 2s ease-in-out infinite;">
              <div class="w-0 h-0 border-t-[12px] border-t-transparent border-b-[12px] border-b-transparent border-l-[20px] border-l-[#bbd700] ml-1"></div>
            </button>
            <div class="text-center">
              <h2 class="text-xl md:text-2xl font-bold tracking-[4px] uppercase text-white" style="font-family:'Barlow Condensed',sans-serif;">LABtoGO Innenansicht</h2>
              <p class="text-[11px] text-[#7a8fa8] tracking-[2px] uppercase mt-1" style="font-family:'Barlow Condensed',sans-serif;">Klicken zum Starten</p>
            </div>
          </div>
          <div id="vid-hint" class="absolute bottom-4 left-0 right-0 text-center hidden">
            <div class="inline-flex items-center gap-3 bg-[rgba(0,0,0,0.7)] backdrop-blur-sm border border-[rgba(187,215,0,0.2)] rounded-full px-5 py-2">
              <svg class="w-4 h-4 text-[#bbd700] shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 15l-2 5L9 9l11 4-5 2zm0 0l5 5M7.188 2.239l.777 2.897M5.136 7.965l-2.898-.777M13.95 4.05l-2.122 2.122m-5.657 5.656l-2.12 2.122"></path></svg>
              <span class="text-[10px] tracking-[2px] uppercase text-[#bbd700]" style="font-family:'Barlow Condensed',sans-serif;">Maus ziehen: Rundgang steuern</span>
              <span class="text-[10px] text-[rgba(122,143,168,0.5)]">|</span>
              <span class="text-[10px] tracking-[2px] uppercase text-[#7a8fa8]" style="font-family:'Barlow Condensed',sans-serif;">Regler: Position wählen</span>
            </div>
          </div>
          <video id="lab-video" class="absolute inset-0 w-full h-full object-cover hidden" muted playsinline preload="auto">
            <source src="/videos/laborcontainer-innenansicht.mp4" type="video/mp4" />
          </video>
        </div>
      </div>

      <div class="w-[min(90vw,1080px)] mt-3">
        <div id="scrub-bar" class="cursor-pointer">
          <div class="relative h-1 bg-[rgba(122,143,168,0.2)] rounded-full overflow-hidden">
            <div id="scrub-progress" class="absolute inset-y-0 left-0 bg-[#bbd700] rounded-full" style="width:0%;"></div>
          </div>
        </div>
        <div class="flex items-center justify-between mt-2">
          <div class="flex items-center gap-3">
            <button id="play-pause" class="text-[10px] tracking-[2px] uppercase text-[#7a8fa8] hover:text-white transition-colors cursor-pointer" style="font-family:'Barlow Condensed',sans-serif;">&#9654; Abspielen</button>
            <span id="time-display" class="text-[10px] tracking-[2px] text-[rgba(122,143,168,0.45)]" style="font-family:'Barlow Condensed',sans-serif;">0:00 / 0:00</span>
          </div>
          <div class="text-[11px] tracking-[3px] uppercase text-[#7a8fa8] hidden md:block" style="font-family:'Barlow Condensed',sans-serif;">
            <strong class="text-white">Planexus</strong> — LABtoGO Laborcontainer
          </div>
        </div>
      </div>

      <div class="w-[min(90vw,1080px)] flex items-center justify-between mt-4">
        <p class="text-[10px] tracking-[2px] uppercase text-[rgba(122,143,168,0.45)] hidden md:block" style="font-family:'Barlow Condensed',sans-serif;">Ziehen Sie über das Video oder den Regler</p>
        <button id="close-btn" class="text-[10px] tracking-[3px] uppercase text-[#7a8fa8] bg-transparent border border-[rgba(122,143,168,0.2)] px-5 py-2 cursor-pointer hover:text-white hover:border-[#bbd700] transition-all flex gap-2 items-center ml-auto" style="font-family:'Barlow Condensed',sans-serif;">
          &#10005; Zurück zum Modell
        </button>
      </div>
    </div>

    <style>
      @keyframes scanAnim { 0% { top: -2px; } 100% { top: 100%; } }
      @keyframes pulse-glow { 0%, 100% { box-shadow: 0 0 0 0 rgba(187,215,0,0.28); } 50% { box-shadow: 0 0 0 12px rgba(187,215,0,0); } }
    </style>
  </section>

  <section class="bg-white py-20 md:py-28">
    <div class="container mx-auto px-4 max-w-5xl">
      <div class="text-center mb-16">
        <p class="text-[#bbd700] font-semibold text-sm tracking-widest uppercase mb-4">Der Laborcontainer 2.0</p>
        <h1 class="text-3xl md:text-5xl font-bold text-slate-900 mb-6 leading-tight">
          Ein normaler Laborcontainer passt<br class="hidden md:block" /> <span class="text-[#bbd700]">in unseren rein.</span>
        </h1>
        <p class="text-lg text-slate-600 max-w-3xl mx-auto leading-relaxed">
          Herkömmliche Laborcontainer basieren auf Standard-Containermaßen — klein, beengt, voller Kompromisse. 
          Der LABtoGO von Planexus ist so groß, dass ein konventioneller Laborcontainer komplett hineinpassen würde. 
          Das Ergebnis: echte Labortiefe, echte Raumhöhe, echtes Arbeiten.
        </p>
      </div>

      <div class="relative bg-slate-50 rounded-2xl p-8 md:p-12 mb-16">
        <h2 class="text-xl font-bold text-slate-900 mb-8 text-center">Größenvergleich: Standard vs. LABtoGO</h2>
        <div class="grid md:grid-cols-2 gap-8 items-end">
          <div class="bg-white rounded-xl p-8 border border-slate-200 relative">
            <div class="absolute top-4 right-4 bg-slate-200 text-slate-600 text-xs font-bold px-3 py-1 rounded-full uppercase tracking-wider">Standard</div>
            <div class="flex items-end justify-center mb-6" style="height:160px;">
              <svg viewBox="0 0 200 100" class="w-full max-w-[280px]" style="height:auto;max-height:143px;" xmlns="http://www.w3.org/2000/svg">
                <rect x="2" y="10" width="126" height="88" rx="1" fill="#e2e8f0" stroke="#94a3b8" stroke-width="2"/>
                <rect x="6" y="14" width="8" height="80" rx="0.5" fill="#cbd5e1"/>
                <rect x="116" y="14" width="8" height="80" rx="0.5" fill="#cbd5e1"/>
                <line x1="18" y1="14" x2="18" y2="94" stroke="#cbd5e1" stroke-width="0.5"/>
                <line x1="30" y1="14" x2="30" y2="94" stroke="#cbd5e1" stroke-width="0.5"/>
                <line x1="42" y1="14" x2="42" y2="94" stroke="#cbd5e1" stroke-width="0.5"/>
                <line x1="54" y1="14" x2="54" y2="94" stroke="#cbd5e1" stroke-width="0.5"/>
                <line x1="66" y1="14" x2="66" y2="94" stroke="#cbd5e1" stroke-width="0.5"/>
                <line x1="78" y1="14" x2="78" y2="94" stroke="#cbd5e1" stroke-width="0.5"/>
                <line x1="90" y1="14" x2="90" y2="94" stroke="#cbd5e1" stroke-width="0.5"/>
                <line x1="102" y1="14" x2="102" y2="94" stroke="#cbd5e1" stroke-width="0.5"/>
                <rect x="2" y="6" width="126" height="6" rx="1" fill="#94a3b8"/>
                <rect x="2" y="96" width="126" height="4" rx="1" fill="#94a3b8"/>
                <line x1="0" y1="100" x2="130" y2="100" stroke="#94a3b8" stroke-width="0.5"/>
                <text x="65" y="58" text-anchor="middle" fill="#64748b" font-size="7" font-family="sans-serif">6.050 × 3.050</text>
              </svg>
            </div>
            <h3 class="font-bold text-slate-900 text-lg mb-3">Konventioneller Laborcontainer</h3>
            <div class="space-y-2 text-sm text-slate-600">
              <div class="flex justify-between border-b border-slate-100 pb-1">
                <span>Außenlänge</span><span class="font-semibold text-slate-800">6.050 mm</span>
              </div>
              <div class="flex justify-between border-b border-slate-100 pb-1">
                <span>Außenbreite</span><span class="font-semibold text-slate-800">3.000 mm</span>
              </div>
              <div class="flex justify-between border-b border-slate-100 pb-1">
                <span>Außenhöhe</span><span class="font-semibold text-slate-800">3.050 mm</span>
              </div>
              <div class="flex justify-between">
                <span>Raumhöhe innen</span><span class="font-semibold text-slate-800">~ 2.400 mm</span>
              </div>
            </div>
          </div>

          <div class="bg-white rounded-xl p-8 border-2 border-[#bbd700] relative shadow-lg">
            <div class="absolute top-4 right-4 bg-[#bbd700] text-slate-900 text-xs font-bold px-3 py-1 rounded-full uppercase tracking-wider">LABtoGO</div>
            <div class="flex items-end justify-center mb-6" style="height:160px;">
              <svg viewBox="0 0 200 100" class="w-full max-w-[340px]" style="height:auto;max-height:160px;" xmlns="http://www.w3.org/2000/svg">
                <rect x="2" y="2" width="196" height="96" rx="1" fill="#f0f5d4" stroke="#bbd700" stroke-width="2"/>
                <rect x="5" y="5" width="8" height="89" rx="0.5" fill="#d4e157"/>
                <rect x="185" y="5" width="8" height="89" rx="0.5" fill="#d4e157"/>
                <line x1="17" y1="5" x2="17" y2="94" stroke="#d4e157" stroke-width="0.5"/>
                <line x1="29" y1="5" x2="29" y2="94" stroke="#d4e157" stroke-width="0.5"/>
                <line x1="41" y1="5" x2="41" y2="94" stroke="#d4e157" stroke-width="0.5"/>
                <line x1="53" y1="5" x2="53" y2="94" stroke="#d4e157" stroke-width="0.5"/>
                <line x1="65" y1="5" x2="65" y2="94" stroke="#d4e157" stroke-width="0.5"/>
                <line x1="77" y1="5" x2="77" y2="94" stroke="#d4e157" stroke-width="0.5"/>
                <line x1="89" y1="5" x2="89" y2="94" stroke="#d4e157" stroke-width="0.5"/>
                <line x1="101" y1="5" x2="101" y2="94" stroke="#d4e157" stroke-width="0.5"/>
                <line x1="113" y1="5" x2="113" y2="94" stroke="#d4e157" stroke-width="0.5"/>
                <line x1="125" y1="5" x2="125" y2="94" stroke="#d4e157" stroke-width="0.5"/>
                <line x1="137" y1="5" x2="137" y2="94" stroke="#d4e157" stroke-width="0.5"/>
                <line x1="149" y1="5" x2="149" y2="94" stroke="#d4e157" stroke-width="0.5"/>
                <line x1="161" y1="5" x2="161" y2="94" stroke="#d4e157" stroke-width="0.5"/>
                <line x1="173" y1="5" x2="173" y2="94" stroke="#d4e157" stroke-width="0.5"/>
                <rect x="2" y="0" width="196" height="4" rx="1" fill="#9aad00"/>
                <rect x="2" y="96" width="196" height="4" rx="1" fill="#9aad00"/>
                <rect x="130" y="28" width="26" height="66" rx="0.5" fill="rgba(187,215,0,0.15)" stroke="#bbd700" stroke-width="1" stroke-dasharray="2,1"/>
                <rect x="158" y="15" width="24" height="50" rx="0.5" fill="rgba(187,215,0,0.1)" stroke="#bbd700" stroke-width="0.5"/>
                <rect class="standard-ghost" x="20" y="12" width="124" height="82" rx="1" fill="none" stroke="#94a3b8" stroke-width="1.5" stroke-dasharray="4,3" opacity="0.6"/>
                <text x="82" y="56" text-anchor="middle" fill="#94a3b8" font-size="5.5" font-family="sans-serif" opacity="0.7">Standard</text>
                <text x="82" y="63" text-anchor="middle" fill="#94a3b8" font-size="4.5" font-family="sans-serif" opacity="0.6">passt hier rein</text>
                <text x="100" y="46" text-anchor="middle" fill="#7a9900" font-size="7" font-family="sans-serif" font-weight="bold">9.500 × 3.400</text>
              </svg>
            </div>
            <h3 class="font-bold text-slate-900 text-lg mb-3">LABtoGO – Laborcontainer 2.0</h3>
            <div class="space-y-2 text-sm text-slate-600">
              <div class="flex justify-between border-b border-slate-100 pb-1">
                <span>Außenlänge</span><span class="font-bold text-[#7a9900]">9.500 mm</span>
              </div>
              <div class="flex justify-between border-b border-slate-100 pb-1">
                <span>Außenbreite</span><span class="font-bold text-[#7a9900]">3.000 mm</span>
              </div>
              <div class="flex justify-between border-b border-slate-100 pb-1">
                <span>Außenhöhe</span><span class="font-bold text-[#7a9900]">3.400 mm</span>
              </div>
              <div class="flex justify-between border-b border-slate-100 pb-1">
                <span>Labortiefe</span><span class="font-bold text-[#7a9900]">&gt; 6.200 mm</span>
              </div>
              <div class="flex justify-between">
                <span>Raumhöhe innen</span><span class="font-bold text-[#7a9900]">2.750 mm</span>
              </div>
            </div>
          </div>
        </div>
        <p class="text-center text-sm text-slate-500 mt-6 italic">Der gestrichelte Umriss zeigt: Ein konventioneller Laborcontainer passt komplett in den LABtoGO hinein.</p>
      </div>
    </div>
  </section>

  <section class="bg-slate-900 py-20 md:py-28 text-white">
    <div class="container mx-auto px-4 max-w-5xl">
      <div class="text-center mb-16">
        <p class="text-[#bbd700] font-semibold text-sm tracking-widest uppercase mb-4">Die entscheidende Frage</p>
        <h2 class="text-3xl md:text-4xl font-bold mb-6">
          Wann wird ein Container zu einem <span class="text-[#bbd700]">Laborcontainer?</span>
        </h2>
        <p class="text-lg text-slate-400 max-w-3xl mx-auto">
          Ein Container mit Labormöbeln ist noch lange kein Laborcontainer. Erst durch eine Vielzahl funktionaler, 
          technischer und sicherheitsrelevanter Merkmale wird aus einem Raumcontainer ein vollwertiges Labor.
        </p>
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6 mb-16">
        <div class="bg-slate-800/60 border border-slate-700/50 rounded-xl p-6 hover:border-[#bbd700]/30 transition-colors">
          <div class="w-12 h-12 bg-[#bbd700]/10 rounded-lg flex items-center justify-center mb-4">
            <svg class="w-6 h-6 text-[#bbd700]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z"></path></svg>
          </div>
          <h3 class="text-white font-bold text-lg mb-2">Zweck & Nutzung</h3>
          <p class="text-slate-400 text-sm leading-relaxed">Vollumfängliche Containerbasis, die die gängigsten Laborvarianten abdeckt. Durch minimale Eingriffe wird z.B. aus einem Gerätelabor ein Chemielabor. Jeder Container ist ein eigenständiges, autarkes System.</p>
        </div>

        <div class="bg-slate-800/60 border border-slate-700/50 rounded-xl p-6 hover:border-[#bbd700]/30 transition-colors">
          <div class="w-12 h-12 bg-[#bbd700]/10 rounded-lg flex items-center justify-center mb-4">
