---
import Layout from '../layouts/Layout.astro';

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": "Laborcontainer Frankfurt",
  "description": "Mobile GMP-Labore und Pharma-Container für Frankfurts Industriepark Höchst, die Rhein-Main-Region und den Cargo-Hub FRA. Planexus – Ihr Fachplaner für pharmazeutische Laborinfrastruktur.",
  "provider": {
    "@type": "Organization",
    "name": "Planexus GmbH",
    "url": "https://www.planexus.de"
  },
  "areaServed": [
    { "@type": "City", "name": "Frankfurt am Main" },
    { "@type": "State", "name": "Hessen" }
  ],
  "serviceType": ["Laborcontainer", "GMP-Labor", "Pharma-Container", "QC-Labor", "BSL-2 Container"],
  "url": "https://www.planexus.de/laborcontainer-frankfurt"
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Start", "item": "https://www.planexus.de/" },
    { "@type": "ListItem", "position": 2, "name": "Laborcontainer Frankfurt", "item": "https://www.planexus.de/laborcontainer-frankfurt" }
  ]
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Können Containerlabore im Industriepark Höchst aufgestellt werden?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Ja. Der Industriepark Höchst mit seinen 460 Hektar und rund 90 Unternehmen bietet die Infrastruktur für temporäre Laborerweiterungen. Die Aufstellung erfordert die Zustimmung des Betreibers Infraserv Höchst sowie ggf. eine Baugenehmigung. Wir koordinieren den gesamten Genehmigungsprozess."
      }
    },
    {
      "@type": "Question",
      "name": "Erfüllen die Container GMP-Anforderungen für die Pharma-Produktion?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Ja. Unsere GMP-Container erfüllen die Anforderungen des EU-GMP-Leitfadens Annex 1: kontrollierte Reinraumklassen (ISO 7/ISO 8), HEPA-gefilterte Lüftung, desinfizierbare Oberflächen, lückenlose Dokumentation und Monitoring. Die Qualifizierung (IQ/OQ/PQ) begleiten wir aktiv."
      }
    },
    {
      "@type": "Question",
      "name": "Ist eine Baugenehmigung in Hessen erforderlich?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Die Hessische Bauordnung (HBO) regelt in § 55 die baugenehmigungsfreien Vorhaben. Temporäre Anlagen können unter bestimmten Voraussetzungen ohne Baugenehmigung aufgestellt werden. Bei Laboren mit Gefahrstoffen oder als Sonderbauten ist ein Bauantrag erforderlich. Wir klären die Genehmigungslage vorab."
      }
    },
    {
      "@type": "Question",
      "name": "Wie weit ist es von Albstadt nach Frankfurt?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Rund 280 km über die A5 – etwa 3 Stunden Fahrzeit. Frankfurt liegt damit in komfortabler Reichweite für kurzfristige Standortbegehungen und schnelle Schwerlasttransporte."
      }
    },
    {
      "@type": "Question",
      "name": "Können Containerlabore für GDP-konforme Pharma-Logistik genutzt werden?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Ja. Am Frankfurter Flughafen – mit 2,1 Millionen Tonnen Cargo (2024) Europas größter Fracht-Hub – werden Pharmaprodukte unter GDP-Bedingungen (Good Distribution Practice) umgeschlagen. Containerlabore eignen sich als Qualitätskontroll-Stationen für Wareneingangs- und Ausgangsanalytik im Logistikumfeld."
      }
    },
    {
      "@type": "Question",
      "name": "Was kostet ein GMP-Container für Frankfurt?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Die Kosten hängen von Reinraumklasse, Ausstattung und Qualifizierungsumfang ab. Nach der Bedarfsanalyse erstellen wir eine projektspezifische Kalkulation. Durch die moderate Distanz ab Albstadt (~280 km) bleiben die Transportkosten im Rahmen."
      }
    }
  ]
};

const localBusinessSchema = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "name": "Planexus GmbH – Laborcontainer Frankfurt",
  "description": "GMP-Container und Pharma-Labore für Frankfurt, Industriepark Höchst und die Rhein-Main-Region.",
  "url": "https://www.planexus.de",
  "telephone": "+49 7435 7519 700",
  "email": "info@planexus.de",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "Am Steinbach 8",
    "addressLocality": "Albstadt",
    "postalCode": "72459",
    "addressCountry": "DE"
  },
  "areaServed": [
    { "@type": "City", "name": "Frankfurt am Main" },
    { "@type": "State", "name": "Hessen" }
  ]
};
---

<Layout
  title="Laborcontainer Frankfurt – GMP, Industriepark Höchst & Pharma-Logistik | Planexus GmbH"
  description="Containerlabore für Frankfurts Pharma-Standort: Industriepark Höchst (Sanofi), GMP-Compliance, GDP-Logistik am Flughafen. 280 km ab Werk – Ihr Fachplaner für pharmazeutische Labore."
  canonical="/laborcontainer-frankfurt"
  schema={serviceSchema}
  ogImage="/attached_assets/Kopf_green-scaled_1768306688943.jpg"
>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} slot="head" />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} slot="head" />
  <script type="application/ld+json" set:html={JSON.stringify(localBusinessSchema)} slot="head" />

  <div class="pt-20 min-h-screen bg-white">

    <!-- Hero: Pharma-Produktionsstandort -->
    <section class="relative py-32 bg-slate-900 text-white overflow-hidden">
      <div class="absolute inset-0">
        <div class="absolute inset-0 bg-[conic-gradient(from_180deg_at_50%_50%,rgba(187,215,0,0.06)_0deg,transparent_120deg,rgba(187,215,0,0.04)_240deg,transparent_360deg)]"></div>
      </div>

      <div class="container mx-auto px-4 relative z-10">
        <div class="grid grid-cols-1 lg:grid-cols-5 gap-12 items-center">
          <div class="lg:col-span-3">
            <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-white/10 text-primary text-sm font-medium mb-8 backdrop-blur-sm border border-white/10">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
              Frankfurt & Rhein-Main
            </div>
            <h1 class="text-4xl md:text-5xl lg:text-6xl font-heading font-bold mb-6 leading-tight">
              Wo Pharma produziert wird, braucht es <span class="text-primary">GMP-Labore</span>
            </h1>
            <p class="text-xl text-gray-300 mb-4 leading-relaxed font-light max-w-3xl">
              Der Industriepark Höchst ist einer der größten Pharma-Produktionsstandorte Europas: 460 Hektar, 90 Unternehmen, rund 22.000 Beschäftigte. Qualitätskontrolle, Chargenfreigabe und Prozessvalidierung laufen hier im Schichtbetrieb – und der Bedarf an dedizierter Laborfläche wächst stetig.
            </p>
            <p class="text-lg text-gray-400 mb-10 max-w-2xl">
              Dazu kommt Europas größter Fracht-Flughafen. Frankfurt ist der Knotenpunkt für GDP-konforme Pharma-Logistik.
            </p>

            <div class="flex flex-col sm:flex-row gap-4">
              <a href="/kontakt" class="bg-primary text-slate-900 font-bold px-8 py-4 rounded-lg hover:bg-primary/90 transition-colors flex items-center justify-center gap-2 group shadow-[0_0_20px_rgba(187,215,0,0.3)]">
                GMP-Projekt anfragen
                <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 group-hover:translate-x-1 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
              </a>
              <a href="tel:+4974357519700" class="border border-white/20 text-white font-medium px-8 py-4 rounded-lg hover:bg-white/10 transition-colors backdrop-blur-sm flex items-center justify-center gap-2">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
                +49 7435 7519 700
              </a>
            </div>
          </div>
          <div class="lg:col-span-2 hidden lg:block">
            <div class="space-y-4">
              <div class="bg-white/5 border border-white/10 rounded-xl p-5">
                <div class="text-3xl font-heading font-bold text-primary">460 ha</div>
                <p class="text-gray-400 text-sm mt-1">Industriepark Höchst – einer der größten in Europa</p>
              </div>
              <div class="bg-white/5 border border-white/10 rounded-xl p-5">
                <div class="text-3xl font-heading font-bold text-primary">~6.200</div>
                <p class="text-gray-400 text-sm mt-1">Sanofi-Beschäftigte in Frankfurt – größter Standort in DE</p>
              </div>
              <div class="bg-white/5 border border-white/10 rounded-xl p-5">
                <div class="text-3xl font-heading font-bold text-primary">2,1 Mio. t</div>
                <p class="text-gray-400 text-sm mt-1">Cargo am Flughafen Frankfurt 2024 – Nr. 1 in Europa</p>
              </div>
              <div class="bg-white/5 border border-white/10 rounded-xl p-5">
                <div class="text-3xl font-heading font-bold text-primary">~280 km</div>
                <p class="text-gray-400 text-sm mt-1">Albstadt → Frankfurt über die A5</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Breadcrumb -->
    <nav class="bg-gray-50 border-b border-gray-100 py-3">
      <div class="container mx-auto px-4">
        <ol class="flex items-center gap-2 text-sm text-gray-500">
          <li><a href="/" class="hover:text-primary transition-colors">Start</a></li>
          <li><svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg></li>
          <li class="text-primary font-medium">Laborcontainer Frankfurt</li>
        </ol>
      </div>
    </nav>

    <!-- Section 1: Industriepark Höchst Deep Dive -->
    <section class="py-20 bg-white">
      <div class="container mx-auto px-4">
        <div class="max-w-5xl mx-auto">
          <h2 class="text-3xl md:text-4xl font-heading font-bold mb-6 text-slate-900">
            Industriepark Höchst: Europas Pharma-Herzstück braucht Laborkapazität
          </h2>
          <p class="text-gray-600 text-lg mb-12 leading-relaxed max-w-3xl">
            Der ehemalige Hoechst-Standort hat sich zu einem offenen Industriepark mit rund 90 Unternehmen gewandelt. Infraserv Höchst betreibt die gemeinsame Infrastruktur – von Energieversorgung über Abwasserbehandlung bis zum Werkschutz. Was fehlt: flexible Laborfläche, die mit dem Produktionstakt mithält.
          </p>

          <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
            <div class="bg-gradient-to-br from-slate-50 to-white rounded-2xl p-8 border border-gray-100">
              <h3 class="text-xl font-heading font-bold text-slate-900 mb-4">Sanofi – Ankermieter und Pharma-Gigant</h3>
              <div class="space-y-3 text-sm mb-4">
                <div class="flex justify-between"><span class="text-gray-500">Beschäftigte in Frankfurt</span><span class="font-bold text-slate-900">~6.200</span></div>
                <div class="flex justify-between"><span class="text-gray-500">Auszubildende</span><span class="font-bold text-slate-900">~400</span></div>
                <div class="flex justify-between"><span class="text-gray-500">Status</span><span class="font-bold text-slate-900">Größter Sanofi-Standort DE</span></div>
              </div>
              <p class="text-gray-600 text-sm leading-relaxed">
                Sanofi ist das größte Einzelunternehmen im Industriepark Höchst. Mit rund 6.200 Beschäftigten und 400 Auszubildenden ist der Standort für Forschung, Entwicklung und Produktion von strategischer Bedeutung. Die Qualitätskontrolle für Wirkstoffe und Fertigarzneimittel erfordert umfangreiche Laborkapazitäten – Containerlabore ergänzen bei Chargenfreigaben, Stabilitätsstudien und Validierungsprojekten.
              </p>
              <p class="text-xs text-gray-400 mt-3">Quelle: Sanofi Deutschland, Standort Frankfurt-Höchst</p>
            </div>

            <div class="bg-gradient-to-br from-slate-50 to-white rounded-2xl p-8 border border-gray-100">
              <h3 class="text-xl font-heading font-bold text-slate-900 mb-4">Infraserv Höchst – Der Parkbetreiber</h3>
              <div class="space-y-3 text-sm mb-4">
                <div class="flex justify-between"><span class="text-gray-500">Parkfläche</span><span class="font-bold text-slate-900">460 Hektar</span></div>
                <div class="flex justify-between"><span class="text-gray-500">Unternehmen</span><span class="font-bold text-slate-900">~90</span></div>
                <div class="flex justify-between"><span class="text-gray-500">Beschäftigte (Park gesamt)</span><span class="font-bold text-slate-900">~22.000</span></div>
              </div>
              <p class="text-gray-600 text-sm leading-relaxed">
                Infraserv Höchst betreibt die gemeinsame Infrastruktur und ist der zentrale Ansprechpartner für Neuansiedlungen und temporäre Aufstellungen. Für die Errichtung eines Containerlabors im Park ist neben der behördlichen Genehmigung auch die Zustimmung von Infraserv erforderlich. Wir koordinieren beide Wege.
              </p>
            </div>
          </div>

          <div class="mt-8 grid grid-cols-1 md:grid-cols-3 gap-6">
            <div class="bg-white rounded-xl p-6 border border-gray-100 shadow-sm">
              <h4 class="font-bold text-slate-900 mb-2">Pharma & Biotech</h4>
              <p class="text-gray-600 text-sm">Wirkstoffproduktion, Fertigarzneimittel, Biopharmazeutika. QC-Labore im Schichtbetrieb für Chargenfreigabe und In-Prozess-Kontrolle.</p>
            </div>
            <div class="bg-white rounded-xl p-6 border border-gray-100 shadow-sm">
              <h4 class="font-bold text-slate-900 mb-2">Spezialchemie</h4>
              <p class="text-gray-600 text-sm">Lebensmittelzusatzstoffe, Pflanzenschutz, Feinchemie. Analytiklabore für Reinheitsprüfung und Prozessoptimierung.</p>
            </div>
            <div class="bg-white rounded-xl p-6 border border-gray-100 shadow-sm">
              <h4 class="font-bold text-slate-900 mb-2">Dienstleistung & Service</h4>
              <p class="text-gray-600 text-sm">Umweltanalytik, Abwassermonitoring, Emissionsmessung. Containerlabore als Vor-Ort-Analytik für Routineproben.</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Section 2: GMP-Compliance — Frankfurts Kernthema -->
    <section class="py-20 bg-slate-900 text-white">
      <div class="container mx-auto px-4">
        <div class="max-w-5xl mx-auto">
          <h2 class="text-3xl md:text-4xl font-heading font-bold mb-6">
            GMP-Compliance im Container: Frankfurts Pharma-Standard
          </h2>
          <p class="text-gray-400 text-lg mb-12 leading-relaxed max-w-3xl">
            Am Pharma-Standort Frankfurt ist GMP nicht verhandelbar. Jede Charge wird analytisch geprüft, jede Oberfläche dokumentiert, jeder Prozess validiert. Ein Containerlabor muss diesen Standard halten – von der ersten Qualifizierung bis zum letzten Audit.
          </p>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
            <div class="relative">
              <div class="absolute left-4 top-0 bottom-0 w-0.5 bg-gradient-to-b from-primary via-primary/50 to-primary/10 hidden md:block"></div>
              <div class="space-y-8">
                <div class="md:pl-12 relative">
                  <div class="hidden md:block absolute left-1.5 top-1 w-5 h-5 bg-primary rounded-full border-2 border-slate-900"></div>
                  <h3 class="text-primary font-bold mb-2">Chargenfreigabe & QC</h3>
                  <p class="text-gray-300 text-sm leading-relaxed">Jede produzierte Charge wird analytisch geprüft: Identität, Reinheit, Gehalt, Endotoxine, Sterilität. Ein QC-Containerlabor neben der Produktion verkürzt Freigabezeiten von Tagen auf Stunden.</p>
                </div>
                <div class="md:pl-12 relative">
                  <div class="hidden md:block absolute left-1.5 top-1 w-5 h-5 bg-primary rounded-full border-2 border-slate-900"></div>
                  <h3 class="text-primary font-bold mb-2">Stabilitätsstudien</h3>
                  <p class="text-gray-300 text-sm leading-relaxed">Langzeit- und Stressstudien nach ICH Q1A erfordern Klimakammern und dedizierte Analytik. Containerlabore bieten den Platz, den die Bestandsgebäude nicht hergeben.</p>
                </div>
                <div class="md:pl-12 relative">
                  <div class="hidden md:block absolute left-1.5 top-1 w-5 h-5 bg-primary rounded-full border-2 border-slate-900"></div>
                  <h3 class="text-primary font-bold mb-2">Prozessvalidierung</h3>
                  <p class="text-gray-300 text-sm leading-relaxed">Bei Prozessänderungen oder neuen Produktlinien müssen Validierungschargen analytisch begleitet werden. Ein temporäres Labor deckt diesen Peak ab – ohne Umbauten am Bestandsgebäude.</p>
                </div>
                <div class="md:pl-12 relative">
                  <div class="hidden md:block absolute left-1.5 top-1 w-5 h-5 bg-primary rounded-full border-2 border-slate-900"></div>
                  <h3 class="text-primary font-bold mb-2">Umgebungsmonitoring</h3>
                  <p class="text-gray-300 text-sm leading-relaxed">Partikelzählung, Keimzahlbestimmung, Differenzdrucküberwachung. Unser IoT-Monitoring liefert Echtzeitdaten und unterstützt die Audit-Trail-Anforderungen nach EU-GMP Annex 11.</p>
                </div>
              </div>
            </div>

            <div class="bg-white/5 border border-white/10 rounded-2xl p-8">
              <h3 class="font-heading font-bold text-lg text-primary mb-6">GMP-Container Ausstattung</h3>
              <div class="space-y-4">
                <div class="flex items-start gap-3">
                  <div class="w-6 h-6 bg-primary/10 rounded-full flex items-center justify-center shrink-0 mt-0.5">
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
                  </div>
                  <div><span class="font-medium text-sm">Reinraumklassen ISO 7/ISO 8</span><p class="text-gray-500 text-xs">HEPA-Filter H13/H14, kontrollierter Raumdruck</p></div>
                </div>
                <div class="flex items-start gap-3">
                  <div class="w-6 h-6 bg-primary/10 rounded-full flex items-center justify-center shrink-0 mt-0.5">
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
                  </div>
                  <div><span class="font-medium text-sm">Pharmataugliche Oberflächen</span><p class="text-gray-500 text-xs">Corian, PVC-verschweißt, Edelstahl V2A/V4A</p></div>
                </div>
                <div class="flex items-start gap-3">
                  <div class="w-6 h-6 bg-primary/10 rounded-full flex items-center justify-center shrink-0 mt-0.5">
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
                  </div>
                  <div><span class="font-medium text-sm">Schleusen & Materialtransfer</span><p class="text-gray-500 text-xs">Personal- und Materialschleuse, Pass-Through</p></div>
                </div>
                <div class="flex items-start gap-3">
                  <div class="w-6 h-6 bg-primary/10 rounded-full flex items-center justify-center shrink-0 mt-0.5">
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
                  </div>
                  <div><span class="font-medium text-sm">Monitoring & Audit Trail</span><p class="text-gray-500 text-xs">Partikelzähler, T/F-Logger, Differenzdruck</p></div>
                </div>
                <div class="flex items-start gap-3">
                  <div class="w-6 h-6 bg-primary/10 rounded-full flex items-center justify-center shrink-0 mt-0.5">
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
                  </div>
                  <div><span class="font-medium text-sm">IQ/OQ/PQ-Qualifizierung</span><p class="text-gray-500 text-xs">FAT in Albstadt, SAT am Standort, Dokumentation</p></div>
                </div>
                <div class="flex items-start gap-3">
                  <div class="w-6 h-6 bg-primary/10 rounded-full flex items-center justify-center shrink-0 mt-0.5">
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
                  </div>
                  <div><span class="font-medium text-sm">Wesemann-Labormöbel</span><p class="text-gray-500 text-xs">Laboreinrichtung vom Marktführer – aus der Wesemann Holding</p></div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Section 3: Pharma-Achse Rhein-Main -->
    <section class="py-20 bg-white">
      <div class="container mx-auto px-4">
        <div class="max-w-5xl mx-auto">
          <span class="text-primary text-sm font-bold uppercase tracking-wider">Über den Industriepark hinaus</span>
          <h2 class="text-3xl font-heading font-bold mt-3 mb-6 text-slate-900">
            Rhein-Main: Pharma-Dichte auf engem Raum
          </h2>
          <p class="text-gray-600 text-lg mb-12 leading-relaxed max-w-3xl">
            Frankfurt liegt im Zentrum einer Region, die zu den pharma- und chemiestärksten Europas zählt. Im Umkreis von 50 km befinden sich Weltkonzerne, Bundesinstitute und eines der größten Universitätsklinika Deutschlands.
          </p>

          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
