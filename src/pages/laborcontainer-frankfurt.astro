---
import Layout from '../layouts/Layout.astro';

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": "Laborcontainer Frankfurt",
  "description": "Laborcontainer für Frankfurt am Main und das Rhein-Main-Gebiet: Planung, Fertigung und schlüsselfertige Übergabe. BSL-2/BSL-3 Container, mobile Forschungslabore und Reinraumlösungen für Pharma, Biotech und Chemie.",
  "provider": {
    "@type": "Organization",
    "name": "Planexus GmbH",
    "url": "https://www.planexus.de"
  },
  "areaServed": [
    { "@type": "City", "name": "Frankfurt am Main" },
    { "@type": "State", "name": "Hessen" }
  ],
  "url": "https://www.planexus.de/laborcontainer-frankfurt"
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Start", "item": "https://www.planexus.de/" },
    { "@type": "ListItem", "position": 2, "name": "Laborcontainer Frankfurt", "item": "https://www.planexus.de/laborcontainer-frankfurt" }
  ]
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Was kostet ein Laborcontainer in Frankfurt?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Die Kosten richten sich nach Größe, Ausstattung und Sicherheitsstufe. Ein GMP-konformes Pharmalabor liegt in einer anderen Größenordnung als ein einfaches Analyselabor. Sprechen Sie mit uns – wir nennen Ihnen eine realistische Einschätzung für Ihr Projekt."
      }
    },
    {
      "@type": "Question",
      "name": "Welche Genehmigungen brauche ich in Hessen für einen Laborcontainer?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Die Hessische Bauordnung (HBO) regelt das. Temporäre bauliche Anlagen sind in vielen Fällen verfahrensfrei. Im Industriepark Höchst gelten vereinfachte Genehmigungsverfahren über Infraserv als Standortbetreiber. Wir übernehmen die Abstimmung mit dem Bauaufsichtsamt Frankfurt."
      }
    },
    {
      "@type": "Question",
      "name": "Wie schnell kann ein Laborcontainer nach Frankfurt geliefert werden?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Von der Auftragserteilung bis zur schlüsselfertigen Übergabe vergehen in der Regel 8 bis 12 Wochen. Der Transport von unserem Werk in Albstadt erfolgt per Tieflader über die A81 und A6/A67 in rund 3,5 Stunden. Aufstellung und Inbetriebnahme planen wir gemeinsam mit Ihnen."
      }
    },
    {
      "@type": "Question",
      "name": "Kann ich einen Laborcontainer in Frankfurt auch mieten?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Ja. Wir bieten Miete, Kauf und Mietkauf an. Besonders für befristete Projekte im Industriepark Höchst oder klinische Studien am Universitätsklinikum Frankfurt ist ein Mietmodell sinnvoll – so bleibt Ihr Budget planbar."
      }
    },
    {
      "@type": "Question",
      "name": "Sind GMP-konforme Containerlabore für die Pharma-Industrie möglich?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Ja. Wir realisieren Reinräume nach GMP-Klassen A bis D im Container – inklusive Qualifizierung (IQ/OQ/PQ), Partikelmonitoring und lückenloser Dokumentation. Ideal für Pharma-Standorte in Frankfurt und dem Rhein-Main-Gebiet."
      }
    },
    {
      "@type": "Question",
      "name": "Eignet sich ein Containerlabor für den Industriepark Höchst?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Ja. Unsere Container erfüllen die strengen Sicherheits- und Umweltauflagen des Industrieparks. Die Abstimmung mit Infraserv als Standortbetreiber übernehmen wir. Auch Ex-Schutz und chemikalienresistente Ausstattung sind realisierbar."
      }
    }
  ]
};

const localBusinessSchema = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "name": "Planexus GmbH",
  "description": "Laborcontainer für Frankfurt am Main und das Rhein-Main-Gebiet",
  "url": "https://www.planexus.de",
  "telephone": "+49 7435 7519 700",
  "email": "info@planexus.de",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "Am Steinbach 8",
    "addressLocality": "Albstadt",
    "postalCode": "72459",
    "addressCountry": "DE"
  },
  "areaServed": [
    { "@type": "City", "name": "Frankfurt am Main" },
    { "@type": "State", "name": "Hessen" }
  ]
};
---

<Layout
  title="Laborcontainer Frankfurt – Planung & Bau"
  description="Laborcontainer für Frankfurt am Main: Mobile Labore für Pharma, Biotech und Chemie. BSL-2/BSL-3, schlüsselfertig. Jetzt beraten lassen."
  canonical="/laborcontainer-frankfurt"
  schema={serviceSchema}
  ogImage="/attached_assets/Kopf_green-scaled_1768306688943.jpg"
>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} slot="head" />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} slot="head" />
  <script type="application/ld+json" set:html={JSON.stringify(localBusinessSchema)} slot="head" />

  <div class="pt-20 min-h-screen bg-white">

    <section class="relative py-28 bg-slate-900 text-white overflow-hidden">
      <div class="absolute inset-0 bg-[url('https://images.unsplash.com/photo-1467269204594-9661b134dd2b?q=80&w=2070')] bg-cover bg-center opacity-15"></div>
      <div class="absolute inset-0 bg-gradient-to-r from-slate-900 via-slate-900/95 to-slate-900/80"></div>

      <div class="container mx-auto px-4 relative z-10">
        <div class="max-w-4xl">
          <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-primary text-slate-900 font-medium text-sm mb-6">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
            <span>Frankfurt am Main & Rhein-Main-Gebiet</span>
          </div>
          <h1 class="text-4xl md:text-6xl font-heading font-bold mb-6 leading-tight">
            Laborcontainer für Frankfurt – <span class="text-primary">vom Auftrag zur Übergabe in Wochen</span>
          </h1>
          <p class="text-xl text-gray-300 leading-relaxed max-w-3xl mb-8">
            Europas Pharma-Hauptstadt und Finanzzentrum – mit wachsendem Bedarf an flexibler Laborinfrastruktur. Wir planen, bauen und liefern schlüsselfertige Containerlabore für das gesamte Rhein-Main-Gebiet.
          </p>
          <div class="flex flex-col sm:flex-row gap-4">
            <a href="/kontakt" class="bg-primary text-slate-900 font-bold px-8 py-4 rounded-lg hover:bg-primary/90 transition-colors inline-flex items-center gap-2 shadow-[0_0_20px_rgba(132,189,0,0.3)]">
              Projekt besprechen <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
            </a>
            <a href="tel:+4974357519700" class="border border-white/20 text-white font-medium px-8 py-4 rounded-lg hover:bg-white/10 transition-colors inline-flex items-center gap-2">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg> +49 7435 7519 700
            </a>
          </div>
        </div>
      </div>
    </section>

    <div class="bg-slate-50 border-b border-gray-100 py-4">
      <div class="container mx-auto px-4">
        <div class="flex items-center gap-2 text-sm text-gray-500">
          <a href="/" class="hover:text-primary">Start</a>
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
          <span class="text-primary font-medium">Laborcontainer Frankfurt</span>
        </div>
      </div>
    </div>

    <section class="py-20">
      <div class="container mx-auto px-4">
        <div class="max-w-4xl mx-auto">
          <h2 class="text-3xl font-heading font-bold mb-8 text-slate-900">
            Laborcontainer für Pharma, Biotech und Chemie in Frankfurt
          </h2>
          <div class="prose prose-lg text-gray-600 max-w-none space-y-6">
            <p>
              Frankfurt am Main ist das Zentrum der deutschen Pharmaindustrie. Die Stadt und das umliegende Rhein-Main-Gebiet beherbergen Global Player wie <strong>Sanofi</strong>, <strong>Merck</strong> (Darmstadt, ~30 km) und den ehemaligen Hoechst-Campus – heute <strong>Industriepark Höchst</strong> mit über 90 Unternehmen und 22.000 Beschäftigten. Die <strong>Goethe-Universität Frankfurt</strong>, die <strong>Senckenberg Gesellschaft für Naturforschung</strong> und zahlreiche Fraunhofer- und Max-Planck-Institute bilden ein dichtes Forschungsökosystem. Das Ergebnis: ein permanenter Bedarf an Laborkapazität, den konventioneller Bau nicht decken kann.
            </p>
            <p>
              Die Herausforderung ist klar: Laborfläche in Frankfurt ist knapp und teuer. Zwischen strengen städtebaulichen Vorgaben im Bankenviertel, dichter Bebauung entlang des Mains und steigenden Immobilienpreisen dauert der Bau neuer Laboreinrichtungen Jahre. Aber Forschung und Produktion können nicht warten – klinische Studien, Chargenprüfungen und Qualitätskontrolle brauchen Laborkapazität jetzt.
            </p>
            <p>
              Planexus-Containerlabore schließen diese Lücke. Wir planen und bauen voll ausgestattete, normkonforme Containerlabore – maßgeschneidert für Ihren Standort in Frankfurt. Vom Konzept bis zur schlüsselfertigen Übergabe alles aus einer Hand. <a href="/leistungen" class="text-primary font-medium hover:underline">Unsere Leistungen im Überblick →</a>
            </p>
          </div>
        </div>
      </div>
    </section>

    <section class="py-20 bg-slate-50 border-y border-gray-100">
      <div class="container mx-auto px-4">
        <div class="max-w-4xl mx-auto">
          <h2 class="text-3xl font-heading font-bold mb-4 text-slate-900">
            Wo Laborcontainer in Frankfurt gebraucht werden
          </h2>
          <p class="text-gray-600 text-lg mb-12">
            Frankfurt und das Rhein-Main-Gebiet verbinden Pharma-Industrie, akademische Spitzenforschung und internationale Logistik – ideale Voraussetzungen für flexible Laborlösungen.
          </p>

          <div class="space-y-8">
            <div class="bg-white p-8 rounded-2xl border border-gray-100 hover:shadow-lg transition-shadow">
              <div class="flex items-start gap-5">
                <div class="w-14 h-14 bg-primary/10 rounded-lg flex items-center justify-center text-primary shrink-0">
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-7 h-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z"/><path d="m3.3 7 8.7 5 8.7-5"/><path d="M12 22V12"/></svg>
                </div>
                <div>
                  <h3 class="text-xl font-bold mb-3 text-slate-900">Pharma-Produktion im Industriepark Höchst</h3>
                  <p class="text-gray-600 leading-relaxed">
                    Über 90 Unternehmen und 22.000 Beschäftigte arbeiten im Industriepark Höchst – einem der größten Pharma- und Chemiestandorte Europas. Bei Werkserweiterungen, Anlagenumbauten oder neuen Produktionslinien brauchen Unternehmen schnell zusätzliche QC-Labore. <a href="/magazin/gmp-reinraum-container-pharma-produktion" class="text-primary font-medium hover:underline">GMP-konforme Containerlösungen</a> liefern die nötige Kapazität – ohne den laufenden Betrieb zu unterbrechen.
                  </p>
                </div>
              </div>
            </div>

            <div class="bg-white p-8 rounded-2xl border border-gray-100 hover:shadow-lg transition-shadow">
              <div class="flex items-start gap-5">
                <div class="w-14 h-14 bg-primary/10 rounded-lg flex items-center justify-center text-primary shrink-0">
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-7 h-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10"/><path d="m9 12 2 2 4-4"/></svg>
                </div>
                <div>
                  <h3 class="text-xl font-bold mb-3 text-slate-900">Biomedizinische Forschung an der Goethe-Universität</h3>
                  <p class="text-gray-600 leading-relaxed">
                    Am Campus Riedberg (Chemie, Pharmazie, Biowissenschaften) und Campus Niederrad (Universitätsklinikum) wird an vorderster Front geforscht. Wenn laufende Studien zusätzliche <a href="/magazin/bsl-2-bsl-3-container-labor" class="text-primary font-medium hover:underline">BSL-2-Laborkapazität</a> für Virologie oder Mikrobiologie erfordern, ist im Bestandsgebäude oft kein Platz. Ein Containerlabor steht auf dem Campus – betriebsbereit in Wochen.
                  </p>
                </div>
              </div>
            </div>

            <div class="bg-white p-8 rounded-2xl border border-gray-100 hover:shadow-lg transition-shadow">
              <div class="flex items-start gap-5">
                <div class="w-14 h-14 bg-primary/10 rounded-lg flex items-center justify-center text-primary shrink-0">
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-7 h-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 18h8"/><path d="M3 22h18"/><path d="M14 22a7 7 0 1 0 0-14h-1"/><path d="M9 14h2"/><path d="M9 12a2 2 0 0 1-2-2V6h6v4a2 2 0 0 1-2 2Z"/><path d="M12 6V3a1 1 0 0 0-1-1H9a1 1 0 0 0-1 1v3"/></svg>
                </div>
                <div>
                  <h3 class="text-xl font-bold mb-3 text-slate-900">Chemie und Analytik im Rhein-Main-Gebiet</h3>
                  <p class="text-gray-600 leading-relaxed">
                    Merck (Darmstadt), Evonik (Hanau) und weitere BASF-Standorte in der Region brauchen regelmäßig QC-Labore, Umweltmonitoring oder Prozessanalytik direkt auf dem Werksgelände. Ein mobiles Containerlabor liefert <a href="/leistungen/ausstattung" class="text-primary font-medium hover:underline">vollwertige Laborausstattung</a> genau dort, wo sie gebraucht wird – ohne langwierige Bauvorhaben.
                  </p>
                </div>
              </div>
            </div>

            <div class="bg-white p-8 rounded-2xl border border-gray-100 hover:shadow-lg transition-shadow">
              <div class="flex items-start gap-5">
                <div class="w-14 h-14 bg-primary/10 rounded-lg flex items-center justify-center text-primary shrink-0">
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-7 h-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                </div>
                <div>
                  <h3 class="text-xl font-bold mb-3 text-slate-900">Flughafen-Analytik und Umweltmonitoring</h3>
                  <p class="text-gray-600 leading-relaxed">
                    Der Flughafen Frankfurt (Fraport) ist einer der größten Europas und eine zentrale Logistik-Drehscheibe. Umweltmonitoring, Treibstoffqualitätsprüfungen und Fracht-Inspektionslabore erfordern flexible Lösungen direkt auf dem Gelände. Ein Containerlabor mit <a href="/leistungen/smart-lab" class="text-primary font-medium hover:underline">Smart-Lab-Technologie</a> liefert Ergebnisse vor Ort – ohne lange Transportwege für Proben.
                  </p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="py-20">
      <div class="container mx-auto px-4">
        <div class="text-center max-w-2xl mx-auto mb-16">
          <h2 class="text-3xl md:text-4xl font-heading font-bold mb-4 text-slate-900">Was wir für Frankfurt übernehmen</h2>
          <p class="text-gray-600 text-lg">
            Von der ersten Idee bis zum betriebsfertigen Labor – als Hersteller mit eigener Fertigung, nicht als Vermittler.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          <div class="bg-white border border-gray-100 p-6 rounded-xl hover:shadow-xl hover:shadow-gray-200/50 transition-all group relative overflow-hidden">
            <div class="absolute top-0 left-0 w-1 h-full bg-primary opacity-0 group-hover:opacity-100 transition-opacity"></div>
            <div class="w-14 h-14 bg-primary/10 rounded-lg flex items-center justify-center mb-4 text-primary group-hover:bg-primary group-hover:text-slate-900 transition-colors">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="7" height="9" x="3" y="3" rx="1"/><rect width="7" height="5" x="14" y="3" rx="1"/><rect width="7" height="9" x="14" y="12" rx="1"/><rect width="7" height="5" x="3" y="16" rx="1"/></svg>
            </div>
            <h3 class="text-lg font-bold mb-2 text-slate-900">Technische Fachplanung</h3>
            <p class="text-gray-600 text-sm mb-4">CAD-Entwürfe, 3D-Visualisierungen und TGA-Konzepte – abgestimmt auf die komplexen Standortbedingungen in Frankfurt, ob Industriepark Höchst, Klinik-Campus oder Flughafengelände.</p>
            <a href="/leistungen/planung" class="text-primary font-bold text-sm flex items-center gap-2 group-hover:translate-x-1 transition-transform">
              Mehr erfahren <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
            </a>
          </div>

          <div class="bg-white border border-gray-100 p-6 rounded-xl hover:shadow-xl hover:shadow-gray-200/50 transition-all group relative overflow-hidden">
            <div class="absolute top-0 left-0 w-1 h-full bg-primary opacity-0 group-hover:opacity-100 transition-opacity"></div>
            <div class="w-14 h-14 bg-primary/10 rounded-lg flex items-center justify-center mb-4 text-primary group-hover:bg-primary group-hover:text-slate-900 transition-colors">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m12.83 2.18a2 2 0 0 0-1.66 0L2.6 6.08a1 1 0 0 0 0 1.83l8.58 3.91a2 2 0 0 0 1.66 0l8.58-3.9a1 1 0 0 0 0-1.83Z"/><path d="m22 17.65-9.17 4.16a2 2 0 0 1-1.66 0L2 17.65"/><path d="m22 12.65-9.17 4.16a2 2 0 0 1-1.66 0L2 12.65"/></svg>
            </div>
            <h3 class="text-lg font-bold mb-2 text-slate-900">Modulbau & Fertigung</h3>
            <p class="text-gray-600 text-sm mb-4">Maßfertigung in unserem Werk in Albstadt. Für das Rhein-Main-Gebiet produzieren wir nach den gleichen Standards wie für unsere Projekte in ganz Deutschland.</p>
            <a href="/leistungen/modulbau" class="text-primary font-bold text-sm flex items-center gap-2 group-hover:translate-x-1 transition-transform">
              Mehr erfahren <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
            </a>
          </div>

          <div class="bg-white border border-gray-100 p-6 rounded-xl hover:shadow-xl hover:shadow-gray-200/50 transition-all group relative overflow-hidden">
            <div class="absolute top-0 left-0 w-1 h-full bg-primary opacity-0 group-hover:opacity-100 transition-opacity"></div>
            <div class="w-14 h-14 bg-primary/10 rounded-lg flex items-center justify-center mb-4 text-primary group-hover:bg-primary group-hover:text-slate-900 transition-colors">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M13 13h8"/><path d="M13 17h8"/><path d="M13 9h8"/><path d="M1 5h4l2 10h10l2-8H5"/></svg>
            </div>
            <h3 class="text-lg font-bold mb-2 text-slate-900">Logistik & Montage</h3>
            <p class="text-gray-600 text-sm mb-4">Transport per Tieflader über die A81 und A6/A67 nach Frankfurt. Aufstellung per Kran – auch auf Industriearealen mit begrenzter Zufahrt.</p>
            <a href="/leistungen/logistik" class="text-primary font-bold text-sm flex items-center gap-2 group-hover:translate-x-1 transition-transform">
              Mehr erfahren <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
            </a>
          </div>

          <div class="bg-white border border-gray-100 p-6 rounded-xl hover:shadow-xl hover:shadow-gray-200/50 transition-all group relative overflow-hidden">
            <div class="absolute top-0 left-0 w-1 h-full bg-primary opacity-0 group-hover:opacity-100 transition-opacity"></div>
            <div class="w-14 h-14 bg-primary/10 rounded-lg flex items-center justify-center mb-4 text-primary group-hover:bg-primary group-hover:text-slate-900 transition-colors">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 18h8"/><path d="M3 22h18"/><path d="M14 22a7 7 0 1 0 0-14h-1"/><path d="M9 14h2"/><path d="M9 12a2 2 0 0 1-2-2V6h6v4a2 2 0 0 1-2 2Z"/><path d="M12 6V3a1 1 0 0 0-1-1H9a1 1 0 0 0-1 1v3"/></svg>
            </div>
            <h3 class="text-lg font-bold mb-2 text-slate-900">Laborausstattung</h3>
