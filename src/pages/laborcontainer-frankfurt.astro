---
import Layout from '../layouts/Layout.astro';
import ContactForm from '../components/ContactForm.tsx';
import AuthorBio from '../components/AuthorBio.astro';
import CityCrossLinks from '../components/CityCrossLinks.astro';

const title = "Laborcontainer Frankfurt | BSL-3, GMP, Pharma | Planexus";
const description = "Laborcontainer Frankfurt: LABtoGO, 2,75 m Innenhöhe, BSL-3, GMP-Reinraum, Hitzeinsel-HVAC. Werk Albstadt via A81/A8/A5 in 8–14 Wochen.";
const canonical = "/laborcontainer-frankfurt";

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "serviceType": "Laborcontainer und modularer Laborbau Frankfurt am Main",
  "provider": {
    "@type": "Organization",
    "name": "Planexus GmbH",
    "image": "https://planexus.de/android-chrome-512x512.png",
    "url": "https://planexus.de",
    "telephone": "+49 7435 7519 700",
    "email": "info@planexus.de",
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "Emil-Mayer-Straße 1",
      "addressLocality": "Albstadt",
      "postalCode": "72461",
      "addressCountry": "DE"
    },
    "parentOrganization": { "@type": "Organization", "name": "Wesemann Holding GmbH" }
  },
  "areaServed": [
    { "@type": "City", "name": "Frankfurt am Main" },
    { "@type": "AdministrativeArea", "name": "Hessen" },
    { "@type": "AdministrativeArea", "name": "Rhein-Main-Gebiet" }
  ],
  "description": "Containerlabore, mobile Labore und modulare Laborgebäude für Pharma, Biotech, Uniklinikum Frankfurt, Sanofi Industriepark Höchst, Goethe-Universität, MPI Biophysik/Hirnforschung Riedberg, Merck Darmstadt und BioNTech Mainz – ab Werk Albstadt schlüsselfertig nach Frankfurt.",
  "offers": { "@type": "AggregateOffer", "priceCurrency": "EUR", "availability": "https://schema.org/InStock" }
};

const localBusinessSchema = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "name": "Planexus GmbH – Laborcontainer Frankfurt",
      "image": "https://planexus.de/images/labtogo-industrie.webp",
  "url": "https://planexus.de/laborcontainer-frankfurt",
  "telephone": "+49 7435 7519 700",
  "email": "info@planexus.de",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "Emil-Mayer-Straße 1",
    "addressLocality": "Albstadt",
    "postalCode": "72461",
    "addressCountry": "DE"
  },
  "areaServed": {
    "@type": "City",
    "name": "Frankfurt am Main",
    "containedInPlace": { "@type": "AdministrativeArea", "name": "Hessen" }
  },
  "priceRange": "€€€",
  "openingHoursSpecification": [{
    "@type": "OpeningHoursSpecification",
    "dayOfWeek": ["Monday","Tuesday","Wednesday","Thursday","Friday"],
    "opens": "08:00","closes": "17:00"
  }]
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Start", "item": "https://planexus.de/" },
    { "@type": "ListItem", "position": 2, "name": "Standorte", "item": "https://planexus.de/standorte" },
    { "@type": "ListItem", "position": 3, "name": "Laborcontainer Frankfurt", "item": "https://planexus.de/laborcontainer-frankfurt" }
  ]
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Wie lange dauert die Lieferung eines Laborcontainers nach Frankfurt vom Werk Albstadt?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Die Schwerlastroute Werk Albstadt → Frankfurt führt über A81 nordwärts via Stuttgart, A8 westwärts bis Karlsruhe und A5 nordwärts ins Rhein-Main-Gebiet. Reine Fahrzeit beträgt rund 3,5 Stunden bei circa 320 Kilometern Distanz, mit genehmigungspflichtigem Schwertransport typischerweise ein Transporttag. Standardanlieferpunkte sind die Anschlussstellen Frankfurt-Süd (A5/A648) für UKF Niederrad und Goethe-Uni Westend, Frankfurter Kreuz (A5/A3) für Industriepark Höchst und Frankfurt-Nordwestkreuz (A5/A66) für Riedberg-Campus mit MPI Biophysik und MPI Hirnforschung. Vom Auftrag bis zur betriebsbereiten Übergabe in Frankfurt vergehen 8 bis 14 Wochen."
      }
    },
    {
      "@type": "Question",
      "name": "Welche Genehmigungen brauche ich für einen Laborcontainer in Frankfurt am Main?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Maßgebend ist die Hessische Bauordnung (HBO 2018, letzte Änderung 2024). § 63 HBO regelt verfahrensfreie Vorhaben, die genaue Eingruppierung hängt von Größe, Standort und Nutzung ab. Für GMP, BSL-3 und größere Anlagen greift die Bauanzeige bei der Bauaufsicht Frankfurt am Main, Kurt-Schumacher-Straße 10, 60311 Frankfurt. Für gentechnische Anlagen S1/S2/S3 zusätzlich Anzeige nach Gentechnikgesetz beim Regierungspräsidium Darmstadt als zuständiger Landesbehörde. BSL-3 verlangt Genehmigung nach BioStoffV. Für Aufstellungen im Industriepark Höchst gelten zusätzlich werksinterne Genehmigungspfade des Standortbetreibers Infraserv Höchst. Wir prüfen die Eingruppierung Ihres Frankfurter Standorts vorab und legen verfahrenstaugliche Bauvorlagen vor."
      }
    },
    {
      "@type": "Question",
      "name": "Welche Korrosivitätskategorie und welches Klima gelten für Frankfurt nach DIN EN ISO 12944-2?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Frankfurt am Main ist mit rund 700 mm Jahresniederschlag die niederschlagsärmste deutsche Großstadt. Jahresmitteltemperatur liegt bei circa 11 °C, Tendenz steigend. DIN EN ISO 12944-2 ordnet Frankfurter Stadtgebiete der Korrosivitätskategorie C3 zu (urbane Atmosphäre, mäßige SO₂-Belastung), in der Nähe des Industrieparks Höchst und entlang der Hafenanlagen kann lokal C4 angesetzt werden. Wichtiger als Korrosion ist in Frankfurt jedoch die sommerliche Hitzeinsel: Die Anzahl der Tropentage über 30 °C steigt nach DWD-Auswertungen kontinuierlich. Planexus liefert HVAC-Pakete mit redundanter Kälteleistung und Sonnenschutz-Verglasung für Frankfurter Standorte ab Werk."
      }
    },
    {
      "@type": "Question",
      "name": "Wie hoch muss ein Laborcontainer am Frankfurter Main gegen Hochwasser stehen?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Maßgebender Pegel ist Frankfurt-Osthafen am Main mit Pegelnullpunkt +88,757 m NN. Höchster gemessener Hochwasserstand seit 1990 war im Januar 2003 mit 4,49 m. Die historische Marke aus dem Jahr 1882 liegt bei circa 7,80 m. Die Schifffahrt am Main wird ab circa 4,0 m am Pegel Frankfurt-Osthafen eingestellt. Für Aufstellungen im Hochwassergefährdungsgebiet (Osthafen, Westhafen, Niederrad-Mainufer, Sachsenhausen-Ufer) verlangt die Stadt Frankfurt Aufständerung über die örtliche Hochwasserschutzlinie und ggf. mobile Hochwasserschutzwände. Wir liefern statisch geprüfte Pfahlgründungen oder Stahlrahmen-Aufständerung mit Höhenanpassung."
      }
    },
    {
      "@type": "Question",
      "name": "Können Sie Container für den Industriepark Höchst und Sanofi liefern?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Ja. Der Industriepark Höchst (65926 Frankfurt am Main) ist mit rund 460 Hektar Gesamtfläche und über 22.000 Beschäftigten der größte integrierte Chemie- und Pharmaindustriepark Europas. Hauptmieter sind Sanofi mit circa 7.500 Mitarbeitenden, dazu Clariant, Celanese, Lyondell Basell, Allessa und über 90 weitere Unternehmen. Wir liefern GMP-Reinräume nach EU Annex 1 mit ISO 14644 Klasse 5–7, ATEX-zonierte Lösungsmittel-Container nach Zone 1/21 und BSL-2-Container für Pilotproduktion. Aufstellungen im Industriepark koordinieren wir mit dem Standortbetreiber Infraserv Höchst, der für werksinterne Versorgung, Werksbahn und Genehmigungspfade zuständig ist."
      }
    },
    {
      "@type": "Question",
      "name": "Welche Container-Spezifikation passt für UKF Niederrad oder die Goethe-Universität?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Universitätsklinikum Frankfurt (Theodor-Stern-Kai 7, 60590 Frankfurt-Niederrad) betreibt 33 Kliniken und Institute mit rund 6.500 Mitarbeitenden. Hier sind BSL-2-Studien-Container während Klinik-Sanierungen, Interimslabore mit KhBauVO-Hessen-konformem Brandschutz und mobile Diagnostik-Container typische Spezifikationen. Goethe-Universität verteilt sich auf Campus Westend, Campus Riedberg (Naturwissenschaften, Pharmazie, Biochemie) und Campus Niederrad (Klinik). Auf dem Riedberg-Campus arbeiten zusätzlich MPI für Biophysik und MPI für Hirnforschung (Max-von-Laue-Straße 3 und 4, 60438) sowie das Frankfurt Institute for Advanced Studies (FIAS) – hier liefern wir BSL-2-Drittmittelcontainer und Reinraum-Module nach DFG-Förderbedingungen."
      }
    },
    {
      "@type": "Question",
      "name": "Welche Förderung und welcher Pharma-Korridor greift im Rhein-Main-Gebiet?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Das Rhein-Main-Gebiet ist Deutschlands stärkster Pharma-Cluster nach Wertschöpfung. Wesentliche Spieler im 60-km-Radius sind Sanofi Industriepark Höchst (~7.500 MA), Merck KGaA Darmstadt (Frankfurter Straße 250, 64293 Darmstadt, ~12.000 MA), BioNTech Mainz (An der Goldgrube 12, 55131 Mainz, mRNA-Technologie), Boehringer Ingelheim (Binger Straße 173, 55216 Ingelheim) sowie das Helmholtz-Institut für Pharmazeutische Forschung Saarland mit Standort in Frankfurt. Förderprogramme laufen über LOEWE (Landesförderprogramm Hessen), House of Pharma & Healthcare Initiative und Bundesprogramme wie ZIM und KMU-innovativ. Mietmodelle laufen off-balance – wir beraten zur kalkulatorischen Einordnung."
      }
    }
  ]
};
---

<Layout title={title} description={description} canonical={canonical}>
  <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(localBusinessSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <div class="bg-white">

    <!-- HERO -->
    <section class="relative bg-slate-900 text-white overflow-hidden">
      <div class="relative z-10 container mx-auto px-4 py-20 md:py-28">
        <div class="max-w-4xl">
          <nav class="flex items-center gap-2 text-sm text-gray-400 mb-8" aria-label="Breadcrumb">
            <a href="/" class="hover:text-primary transition-colors">Start</a>
            <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m9 18 6-6-6-6"/></svg>
            <span>Standorte</span>
            <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m9 18 6-6-6-6"/></svg>
            <span class="text-primary">Frankfurt</span>
          </nav>

          <div class="text-primary font-medium text-sm uppercase tracking-wider mb-4">Ihr Spezialist für Laborcontainer · Pharma-Cluster Rhein-Main</div>

          <h1 class="text-4xl md:text-5xl lg:text-6xl font-heading font-bold mb-6 leading-tight">
            Laborcontainer Frankfurt – hitzeinselfeste GMP-Labore für Industriepark Höchst und Rhein-Main
          </h1>

          <p class="text-xl text-gray-300 leading-relaxed mb-4">
            <strong class="text-white">Ihr Fachplaner für Containerlabore mit mehr als 10 Jahren Erfahrung.</strong> Modular, HBO-konform, Pharma-tauglich. Wir realisieren flexible Forschungsumgebungen für Sanofi Industriepark Höchst, UKF Niederrad, Goethe-Uni, MPI Riedberg, Merck Darmstadt und BioNTech Mainz – aus dem Werk Albstadt direkt nach Frankfurt, über A81 / A8 / A5.
          </p>
          <p class="text-base text-gray-400 mb-8">
            Während andere noch planen, forschen Sie bereits.
          </p>

          <div class="flex flex-col sm:flex-row gap-4 mb-8">
            <a href="#anfrage" data-testid="button-cta-hero" class="bg-primary text-slate-900 font-bold px-8 py-4 rounded-lg hover:bg-primary/90 transition-colors inline-flex items-center justify-center gap-2 shadow-[0_0_20px_rgba(132,189,0,0.3)]">
              Kostenfreies Standort-Audit Frankfurt
              <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
            </a>
            <a href="tel:+4974357519700" class="border border-white/20 text-white font-medium px-8 py-4 rounded-lg hover:bg-white/10 transition-colors inline-flex items-center justify-center gap-2">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
              +49 7435 7519 700
            </a>
          </div>

          <div class="flex flex-wrap items-center gap-x-6 gap-y-2 text-sm text-gray-400">
            <div class="flex items-center gap-2"><svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6 9 17l-5-5"/></svg>Pioniere im Modulbau seit 2016</div>
            <div class="flex items-center gap-2"><svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6 9 17l-5-5"/></svg>Award 2026 EU Business News</div>
            <div class="flex items-center gap-2"><svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6 9 17l-5-5"/></svg>HBO § 63 Bauanzeige inklusive</div>
            <div class="flex items-center gap-2"><svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6 9 17l-5-5"/></svg>Wesemann-Gruppe · 60+ Jahre Laborbau</div>
          </div>
        </div>
      </div>
    </section>

    <AuthorBio city="Frankfurt am Main" />

    <!-- PATTERN-INTERRUPT: LABtoGO -->
    <section class="py-16 md:py-20 bg-gradient-to-br from-primary/5 via-white to-primary/10 border-y border-primary/20">
      <div class="container mx-auto px-4">
        <div class="max-w-5xl mx-auto">
          <div class="grid md:grid-cols-2 gap-10 items-center mb-10">
            <div>
              <div class="text-primary font-bold text-sm uppercase tracking-wider mb-3">Pattern-Interrupt · Weltpremiere analytica 2026</div>
              <h2 class="text-3xl md:text-4xl font-heading font-bold mb-4 text-slate-900">Planexus zeigt Frankfurt, was ein Laborcontainer 2026 wirklich kann</h2>
              <p class="text-lg text-gray-700 leading-relaxed mb-4">Ein gewöhnlicher Laborcontainer hat 2.400 mm Innenhöhe. Sie passen rein – aufrecht arbeiten unter einem Abzug aber kaum.</p>
              <p class="text-lg text-slate-900 font-bold leading-relaxed mb-4">Der LABtoGO von Planexus hat 2.750 mm Innenhöhe. 9,5 m Außenlänge. 3 m Außenbreite. Vollverglaste Front, die echtes Tageslicht in jedes Frankfurter Pharma-, Klinik- oder Forschungslabor bringt.</p>
              <p class="text-lg text-gray-700 leading-relaxed"><strong>Ein gewöhnlicher Laborcontainer passt komplett in einen LABtoGO hinein.</strong> Wir nennen ihn nicht ohne Grund LABtoGO – er ist die Plattform, auf der wir für Frankfurt BSL-2, BSL-3, GMP-Reinraum nach EU Annex 1, ATEX-Zonierung für Lösungsmittel und HVAC-Pakete für die innerstädtische Hitzeinsel konfigurieren.</p>
            </div>
            <div class="grid grid-cols-2 gap-4">
              <div class="bg-slate-900 text-white rounded-2xl p-6 text-center"><div class="text-4xl font-bold text-primary mb-1">2.750</div><div class="text-xs text-gray-400 uppercase tracking-wider">mm Innenhöhe</div><div class="text-xs text-gray-500 mt-1">Standard: 2.400 mm</div></div>
              <div class="bg-slate-900 text-white rounded-2xl p-6 text-center"><div class="text-4xl font-bold text-primary mb-1">9.500</div><div class="text-xs text-gray-400 uppercase tracking-wider">mm Außenlänge</div><div class="text-xs text-gray-500 mt-1">3.000 mm Breite</div></div>
              <div class="bg-slate-900 text-white rounded-2xl p-6 text-center"><div class="text-4xl font-bold text-primary mb-1">100%</div><div class="text-xs text-gray-400 uppercase tracking-wider">vollverglast</div><div class="text-xs text-gray-500 mt-1">Tageslicht-Labor</div></div>
              <div class="bg-slate-900 text-white rounded-2xl p-6 text-center"><div class="text-4xl font-bold text-primary mb-1">U 0,20</div><div class="text-xs text-gray-400 uppercase tracking-wider">W/m²K Sandwich</div><div class="text-xs text-gray-500 mt-1">80–120 mm Dämmung</div></div>
            </div>
          </div>
          <div class="text-center">
            <a href="/laborcontainer/labtogo" class="inline-flex items-center gap-2 text-primary font-bold hover:underline">LABtoGO Plattform und alle Konfigurationen ansehen
              <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- PROBLEM-AGITATION -->
    <section class="py-16 md:py-20">
      <div class="container mx-auto px-4">
        <div class="max-w-5xl mx-auto">
          <h2 class="text-3xl md:text-4xl font-heading font-bold mb-10 text-slate-900">Planexus löst die drei Frankfurter Engpässe, an denen Laborprojekte regelmäßig scheitern</h2>
          <div class="grid md:grid-cols-3 gap-6">
            <div class="bg-slate-50 border-l-4 border-primary rounded-xl p-6">
              <div class="text-slate-900 font-bold text-lg mb-2">Hitzeinsel-Innenstadt zerstört Standard-HVAC im Sommer</div>
              <p class="text-gray-700 text-sm leading-relaxed">Frankfurt ist die niederschlagsärmste deutsche Großstadt mit nur 700 mm Niederschlag pro Jahr und steigender Anzahl Tropentage über 30 °C. Standard-Klimasplits für Bürocontainer schaffen die Lastspitzen für Reinraum-Klassen ISO 14644 oder PCR-Diagnostik nicht – Geräte fallen aus, Validierungen brechen, Studien sind verloren.</p>
              <p class="text-sm text-slate-900 font-semibold mt-3 pt-3 border-t border-gray-200">Planexus-Antwort: HVAC-Paket mit redundanter Kälteleistung, Sonnenschutz-Verglasung und Außenbeschattung ab Werk konfiguriert.</p>
            </div>
            <div class="bg-slate-50 border-l-4 border-primary rounded-xl p-6">
              <div class="text-slate-900 font-bold text-lg mb-2">Industriepark Höchst – werksinterne Genehmigung neben HBO</div>
              <p class="text-gray-700 text-sm leading-relaxed">Aufstellungen im Industriepark Höchst (460 ha, 22.000 Beschäftigte, 90+ Unternehmen) durchlaufen einen doppelten Genehmigungspfad: HBO-Bauanzeige bei der Bauaufsicht Frankfurt UND werksinterne Freigabe durch Standortbetreiber Infraserv Höchst für Werksbahn-Anschluss, Medienanbindung und Brandschutz. Wer nur einen Pfad bedient, wartet zwei Monate.</p>
              <p class="text-sm text-slate-900 font-semibold mt-3 pt-3 border-t border-gray-200">Planexus-Antwort: Doppelte Antragsstrecke parallel, Infraserv-Schnittstelle ab Tag 1.</p>
            </div>
            <div class="bg-slate-50 border-l-4 border-primary rounded-xl p-6">
              <div class="text-slate-900 font-bold text-lg mb-2">Rhein-Main-Pharma fordert GMP, ATEX und BSL aus einer Plattform</div>
              <p class="text-gray-700 text-sm leading-relaxed">Sanofi Höchst, Merck Darmstadt (30 km), BioNTech Mainz (40 km) und Boehringer Ingelheim verlangen ein Lieferspektrum aus einer Hand: GMP-Reinraum nach EU Annex 1, ATEX-Zonierung 1/21 für Lösungsmittel, BSL-2/-3 nach BioStoffV und IQ/OQ/PQ-Dokumentation. Drei Hersteller koordinieren bedeutet vier Wochen Verzug pro Übergabe.</p>
              <p class="text-sm text-slate-900 font-semibold mt-3 pt-3 border-t border-gray-200">Planexus-Antwort: Eine Plattform LABtoGO, alle vier Konfigurationen, ein Ansprechpartner.</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- STRATEGISCHE FUSION INTRO -->
    <section class="py-16 md:py-20 bg-slate-50">
      <div class="container mx-auto px-4">
        <div class="max-w-4xl mx-auto">
          <h2 class="text-3xl md:text-4xl font-heading font-bold mb-8 text-slate-900">Laborcontainer für Frankfurt: Was der Pharma-Cluster Rhein-Main, die Hitzeinsel und der Industriepark Höchst vom Engineering verlangen</h2>
          <div class="prose prose-lg max-w-none text-gray-700 space-y-6">
            <p><strong>Frankfurt ist Deutschlands stärkster Pharma-Cluster nach Wertschöpfung.</strong> Auf 248 Quadratkilometern und in 16 Ortsbezirken konkurriert die Banken-City mit dem Industriepark Höchst (460 Hektar, über 22.000 Beschäftigte, 90+ Unternehmen, Hauptmieter Sanofi mit rund 7.500 Mitarbeitenden), dem Universitätsklinikum Frankfurt am Theodor-Stern-Kai 7 in Niederrad mit 33 Kliniken und Instituten und rund 6.500 Mitarbeitenden, der Goethe-Universität mit Campus Westend, Riedberg und Niederrad und 45.000 Studierenden, den Max-Planck-Instituten für Biophysik und Hirnforschung am Riedberg-Campus (Max-von-Laue-Straße 3 und 4) und dem Frankfurt Institute for Advanced Studies um Flächen, Genehmigungen und Engineering-Kapazität. Im 60-Kilometer-Radius liegen Merck KGaA Darmstadt, BioNTech Mainz und Boehringer Ingelheim. Wer hier ein Containerlabor bestellt, kauft kein Standardprodukt – er kauft Standortintelligenz für den deutschsprachigen Pharma-Korridor mit der höchsten Forschungs- und Produktionsdichte.</p>
            <p><strong>Planexus baut für diesen Markt seit 2016.</strong> Wir wissen, dass die Bauaufsicht Frankfurt am Main in der Kurt-Schumacher-Straße 10 nach HBO 2018 entscheidet und § 63 verfahrensfreie Vorhaben definiert. Wir wissen, dass der Pegel Frankfurt-Osthafen mit Pegelnullpunkt +88,757 m NN seit Jahrzehnten beobachtet wird und das Hochwasser im Januar 2003 mit 4,49 m den Höchstwert seit 1990 markierte. Wir wissen, dass Frankfurt mit 700 mm Jahresniederschlag die niederschlagsärmste deutsche Großstadt ist und nach DIN EN ISO 12944-2 in Korrosivitätskategorie C3 fällt – aber mit der höchsten Hitzeinselbelastung aller deutschen Top-Lagen. Wir wissen, dass Aufstellungen im Industriepark Höchst nur über die Doppelgenehmigung HBO-Bauaufsicht plus Infraserv-Höchst-Freigabe funktionieren. Diese Details stehen nicht in unserem Angebot – sie sind das Engineering-Fundament jedes Containers, der unser Werk Albstadt verlässt.</p>
