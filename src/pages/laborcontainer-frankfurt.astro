---
import Layout from '../layouts/Layout.astro';
import ContactForm from '../components/ContactForm.tsx';

const serviceSchema = { "@context": "https://schema.org", "@type": "Service", "name": "Laborcontainer Frankfurt", "description": "Schlüsselfertige Laborcontainer für Frankfurt und das Rhein-Main-Gebiet. BSL-2/BSL-3, Reinraum, Analytik – betriebsbereit in 8 bis 14 Wochen.",
  "provider": { "@type": "Organization", "name": "Planexus GmbH", "url": "https://www.planexus.de", "parentOrganization": { "@type": "Organization", "name": "Wesemann Holding GmbH" } },
  "serviceType": ["Laborcontainer", "Mobile Labore", "BSL-2 Labor", "BSL-3 Labor", "Reinraumlabor"],
  "areaServed": [{ "@type": "City", "name": "Frankfurt am Main" }, { "@type": "State", "name": "Hessen" }],
  "url": "https://www.planexus.de/laborcontainer-frankfurt"
};
const breadcrumbSchema = { "@context": "https://schema.org", "@type": "BreadcrumbList", "itemListElement": [
  { "@type": "ListItem", "position": 1, "name": "Start", "item": "https://www.planexus.de/" },
  { "@type": "ListItem", "position": 2, "name": "Standorte", "item": "https://www.planexus.de/#standorte" },
  { "@type": "ListItem", "position": 3, "name": "Laborcontainer Frankfurt", "item": "https://www.planexus.de/laborcontainer-frankfurt" }
]};
const faqSchema = { "@context": "https://schema.org", "@type": "FAQPage", "mainEntity": [
  { "@type": "Question", "name": "Was kostet ein Laborcontainer in Frankfurt?", "acceptedAnswer": { "@type": "Answer", "text": "Die Kosten richten sich nach Größe, Ausstattung und Sicherheitsstufe. Ein Analytiklabor liegt in einer anderen Größenordnung als ein BSL-3-Container. Wir erstellen ein individuelles Angebot nach Ihrem Lastenheft." } },
  { "@type": "Question", "name": "Wie lange dauert die Lieferung nach Frankfurt?", "acceptedAnswer": { "@type": "Answer", "text": "Von Auftragserteilung bis Übergabe: 8 bis 14 Wochen. Der Transport von Albstadt nach Frankfurt dauert per Tieflader rund 4 Stunden (ca. 320 km über A81/A6)." } },
  { "@type": "Question", "name": "Brauche ich in Hessen eine Baugenehmigung?", "acceptedAnswer": { "@type": "Answer", "text": "Das regelt die Hessische Bauordnung (HBO). Container gelten als bauliche Anlagen. Bei temporärer Nutzung häufig verfahrensfrei. Wir klären das vorab mit dem zuständigen Bauamt." } },
  { "@type": "Question", "name": "Kann ich einen Laborcontainer in Frankfurt mieten?", "acceptedAnswer": { "@type": "Answer", "text": "Ja. Miete, Kauf und Mietkauf sind möglich. Miete eignet sich besonders bei befristeten Projekten oder Übergangslösungen während Sanierungen." } },
  { "@type": "Question", "name": "Welche Branchen nutzen Laborcontainer in Frankfurt?", "acceptedAnswer": { "@type": "Answer", "text": "Pharma (Sanofi, Merck in Darmstadt), Biotech, Uniklinikum Frankfurt, Umweltanalytik und Materialforschung. Das Rhein-Main-Gebiet ist einer der stärksten Life-Science-Standorte Deutschlands." } }
]};
const localBusinessSchema = { "@context": "https://schema.org", "@type": "LocalBusiness", "name": "Planexus GmbH – Laborcontainer Frankfurt", "description": "Schlüsselfertige Laborcontainer für Frankfurt und das Rhein-Main-Gebiet", "url": "https://www.planexus.de", "telephone": "+49 7435 7519 700", "email": "info@planexus.de",
  "address": { "@type": "PostalAddress", "streetAddress": "Am Steinbach 8", "addressLocality": "Albstadt", "postalCode": "72459", "addressCountry": "DE" },
  "areaServed": [{ "@type": "City", "name": "Frankfurt am Main" }, { "@type": "State", "name": "Hessen" }]
};
---

<Layout title="Laborcontainer Frankfurt – vom Auftrag zur Übergabe in Wochen | Planexus" description="Laborcontainer für Frankfurt: BSL-2/BSL-3, Reinraum & Analytik. Nur 320 km ab Werk. Schlüsselfertig in 8–14 Wochen. Jetzt anfragen." canonical="/laborcontainer-frankfurt" schema={serviceSchema} ogImage="/attached_assets/Laborcontainer_014_1769690552936.jpg">
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} slot="head" />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} slot="head" />
  <script type="application/ld+json" set:html={JSON.stringify(localBusinessSchema)} slot="head" />

  <div class="pt-20 min-h-screen bg-white">

    <section class="relative py-24 md:py-32 bg-slate-900 text-white overflow-hidden">
      <div class="absolute inset-0"><img src="/attached_assets/Laborcontainer_014_1769690552936.jpg" alt="Laborcontainer von Planexus – schlüsselfertig für Frankfurt" class="w-full h-full object-cover opacity-20" loading="eager" /></div>
      <div class="absolute inset-0 bg-gradient-to-r from-slate-900 via-slate-900/95 to-slate-900/70"></div>
      <div class="container mx-auto px-4 relative z-10"><div class="max-w-3xl">
        <nav class="flex items-center gap-2 text-sm text-gray-400 mb-8"><a href="/" class="hover:text-primary transition-colors">Start</a><svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m9 18 6-6-6-6"/></svg><span>Standorte</span><svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m9 18 6-6-6-6"/></svg><span class="text-primary">Frankfurt</span></nav>
        <h1 class="text-4xl md:text-5xl lg:text-6xl font-heading font-bold mb-6 leading-tight">Laborcontainer für Frankfurt – <span class="text-primary">vom Auftrag zur Übergabe in Wochen</span></h1>
        <p class="text-xl text-gray-300 leading-relaxed mb-8">Das Rhein-Main-Gebiet ist Europas Pharma-Drehscheibe. Wir liefern schlüsselfertige Containerlabore – nur 320 km ab Werk, betriebsbereit in 8 bis 14 Wochen.</p>
        <div class="flex flex-col sm:flex-row gap-4 mb-8">
          <a href="#anfrage" class="bg-primary text-slate-900 font-bold px-8 py-4 rounded-lg hover:bg-primary/90 transition-colors inline-flex items-center justify-center gap-2 shadow-[0_0_20px_rgba(132,189,0,0.3)]">Kostenlos anfragen <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg></a>
          <a href="tel:+4974357519700" class="border border-white/20 text-white font-medium px-8 py-4 rounded-lg hover:bg-white/10 transition-colors inline-flex items-center justify-center gap-2"><svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg> +49 7435 7519 700</a>
        </div>
        <div class="flex flex-wrap items-center gap-6 text-sm text-gray-400">
          <div class="flex items-center gap-2"><svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10"/><path d="m9 12 2 2 4-4"/></svg>Teil der Wesemann Holding</div>
          <div class="flex items-center gap-2"><svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10"/><path d="m9 12 2 2 4-4"/></svg>Eigene Fertigung in Deutschland</div>
          <div class="flex items-center gap-2"><svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10"/><path d="m9 12 2 2 4-4"/></svg>Schlüsselfertig inkl. Qualifizierung</div>
        </div>
      </div></div>
    </section>

    <section class="py-16 md:py-20"><div class="container mx-auto px-4"><div class="max-w-4xl mx-auto">
      <h2 class="text-3xl md:text-4xl font-heading font-bold mb-8 text-slate-900">Pharma-Drehscheibe Rhein-Main – Laborkapazität wird knapp</h2>
      <div class="grid md:grid-cols-3 gap-6 mb-10">
        <div class="bg-red-50 border border-red-100 rounded-xl p-6"><div class="text-red-600 font-bold text-lg mb-2">Sanofi, Merck, BioNTech</div><p class="text-gray-600 text-sm">Frankfurts Pharma-Nachbarschaft wächst: Sanofi am Industriepark Höchst, Merck in Darmstadt, BioNTech in Mainz – alle brauchen mehr Laborkapazität.</p></div>
        <div class="bg-red-50 border border-red-100 rounded-xl p-6"><div class="text-red-600 font-bold text-lg mb-2">Uniklinik unter Druck</div><p class="text-gray-600 text-sm">Das Uniklinikum Frankfurt forscht an vorderster Front – aber die Laborgebäude sind teilweise Jahrzehnte alt. Sanierungen stehen an, der Betrieb darf nicht stillstehen.</p></div>
        <div class="bg-red-50 border border-red-100 rounded-xl p-6"><div class="text-red-600 font-bold text-lg mb-2">Industriepark Höchst</div><p class="text-gray-600 text-sm">Europas größter Pharma-Standort mit über 90 Unternehmen. Der Bedarf an flexibler Laborinfrastruktur für Analytik und QC steigt stetig.</p></div>
      </div>
      <div class="bg-slate-900 text-white rounded-2xl p-8 md:p-10"><div class="flex items-start gap-4">
        <div class="w-12 h-12 bg-primary rounded-lg flex items-center justify-center shrink-0"><svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-slate-900" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10"/><path d="m9 12 2 2 4-4"/></svg></div>
        <div><div class="text-xl font-bold mb-2">Die Lösung: Containerlabore in Wochen statt Jahren</div><p class="text-gray-300">Planexus plant, baut und liefert normkonforme Laborcontainer für das Rhein-Main-Gebiet. Nur 320 km ab Werk, betriebsbereit in 8 bis 14 Wochen. Kein Neubau nötig.</p></div>
      </div></div>
    </div></div></section>

    <section class="py-16 md:py-20 bg-slate-50 border-y border-gray-100"><div class="container mx-auto px-4">
      <div class="text-center max-w-2xl mx-auto mb-12"><h2 class="text-3xl md:text-4xl font-heading font-bold mb-4 text-slate-900">Warum Planexus für Frankfurt?</h2><p class="text-gray-600 text-lg">Alles aus einer Hand – vom Engineering bis zur Qualifizierung.</p></div>
      <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6 max-w-6xl mx-auto">
        <div class="bg-white rounded-xl p-6 border border-gray-100 hover:shadow-lg transition-shadow text-center"><div class="w-14 h-14 bg-primary/10 rounded-full flex items-center justify-center mx-auto mb-4"><svg xmlns="http://www.w3.org/2000/svg" class="w-7 h-7 text-[#7a9900]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg></div><div class="font-bold text-slate-900 text-lg mb-2">8–14 Wochen</div><p class="text-gray-600 text-sm">Von Auftrag bis schlüsselfertige Übergabe.</p></div>
        <div class="bg-white rounded-xl p-6 border border-gray-100 hover:shadow-lg transition-shadow text-center"><div class="w-14 h-14 bg-primary/10 rounded-full flex items-center justify-center mx-auto mb-4"><svg xmlns="http://www.w3.org/2000/svg" class="w-7 h-7 text-[#7a9900]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z"/><path d="m3.3 7 8.7 5 8.7-5"/><path d="M12 22V12"/></svg></div><div class="font-bold text-slate-900 text-lg mb-2">Schlüsselfertig</div><p class="text-gray-600 text-sm">Planung, Fertigung, Transport, Aufstellung, Qualifizierung.</p></div>
        <div class="bg-white rounded-xl p-6 border border-gray-100 hover:shadow-lg transition-shadow text-center"><div class="w-14 h-14 bg-primary/10 rounded-full flex items-center justify-center mx-auto mb-4"><svg xmlns="http://www.w3.org/2000/svg" class="w-7 h-7 text-[#7a9900]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10"/><path d="m9 12 2 2 4-4"/></svg></div><div class="font-bold text-slate-900 text-lg mb-2">Normkonform</div><p class="text-gray-600 text-sm">BSL-2/BSL-3, GMP-Reinräume, DIN/ISO – vollständig qualifiziert.</p></div>
        <div class="bg-white rounded-xl p-6 border border-gray-100 hover:shadow-lg transition-shadow text-center"><div class="w-14 h-14 bg-primary/10 rounded-full flex items-center justify-center mx-auto mb-4"><svg xmlns="http://www.w3.org/2000/svg" class="w-7 h-7 text-[#7a9900]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg></div><div class="font-bold text-slate-900 text-lg mb-2">Kauf, Miete, Leasing</div><p class="text-gray-600 text-sm">Flexibel finanziert – Interim oder Dauerlösung.</p></div>
      </div>
      <div class="text-center mt-10"><a href="#anfrage" class="inline-flex items-center gap-2 bg-primary text-slate-900 font-bold px-8 py-4 rounded-lg hover:bg-primary/90 transition-colors shadow-[0_0_20px_rgba(132,189,0,0.3)]">Jetzt unverbindlich beraten lassen <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg></a></div>
    </div></section>

    <section class="py-16 md:py-20"><div class="container mx-auto px-4"><div class="max-w-5xl mx-auto">
      <h2 class="text-3xl md:text-4xl font-heading font-bold mb-4 text-slate-900">Laborcontainer-Typen für Frankfurt</h2>
      <p class="text-gray-600 text-lg mb-10">Individuell geplant und gefertigt – kein Standard von der Stange.</p>
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
        <a href="/leistungen/ausstattung" class="group bg-white border border-gray-100 rounded-xl p-6 hover:shadow-xl hover:border-primary/30 transition-all"><div class="w-12 h-12 bg-primary/10 rounded-lg flex items-center justify-center mb-4 group-hover:bg-primary transition-colors"><svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-[#7a9900] group-hover:text-slate-900 transition-colors" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 18h8"/><path d="M3 22h18"/><path d="M14 22a7 7 0 1 0 0-14h-1"/><path d="M9 14h2"/><path d="M9 12a2 2 0 0 1-2-2V6h6v4a2 2 0 0 1-2 2Z"/><path d="M12 6V3a1 1 0 0 0-1-1H9a1 1 0 0 0-1 1v3"/></svg></div><h3 class="font-bold text-slate-900 mb-2">Analytiklabor</h3><p class="text-gray-600 text-sm">HPLC, GC, Spektroskopie – klimatisierte Geräteräume und Medienversorgung.</p></a>
        <a href="/magazin/bsl-2-bsl-3-container-labor" class="group bg-white border border-gray-100 rounded-xl p-6 hover:shadow-xl hover:border-primary/30 transition-all"><div class="w-12 h-12 bg-primary/10 rounded-lg flex items-center justify-center mb-4 group-hover:bg-primary transition-colors"><svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-[#7a9900] group-hover:text-slate-900 transition-colors" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10"/><path d="m9 12 2 2 4-4"/></svg></div><h3 class="font-bold text-slate-900 mb-2">BSL-2 / BSL-3 Sicherheitslabor</h3><p class="text-gray-600 text-sm">Unterdruck, HEPA-Filtration, Schleusen – nach BioStoffV und TRBA 100.</p></a>
        <a href="/magazin/gmp-reinraum-container-pharma-produktion" class="group bg-white border border-gray-100 rounded-xl p-6 hover:shadow-xl hover:border-primary/30 transition-all"><div class="w-12 h-12 bg-primary/10 rounded-lg flex items-center justify-center mb-4 group-hover:bg-primary transition-colors"><svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-[#7a9900] group-hover:text-slate-900 transition-colors" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="18" height="18" x="3" y="3" rx="2"/><path d="M3 9h18"/><path d="M9 21V9"/></svg></div><h3 class="font-bold text-slate-900 mb-2">GMP-Reinraumlabor</h3><p class="text-gray-600 text-sm">Reinraumklassen nach ISO 14644 – für Pharma und Biopharma.</p></a>
        <a href="/leistungen/ausstattung" class="group bg-white border border-gray-100 rounded-xl p-6 hover:shadow-xl hover:border-primary/30 transition-all"><div class="w-12 h-12 bg-primary/10 rounded-lg flex items-center justify-center mb-4 group-hover:bg-primary transition-colors"><svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-[#7a9900] group-hover:text-slate-900 transition-colors" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 11a3 3 0 1 0 6 0a3 3 0 0 0-6 0"/><path d="M12.5 2a9.5 9.5 0 0 0-7.14 15.73L12 22l6.64-4.27A9.5 9.5 0 0 0 12.5 2Z"/></svg></div><h3 class="font-bold text-slate-900 mb-2">QC-Labor</h3><p class="text-gray-600 text-sm">Qualitätskontrolle – Wareneingangsprüfung, Prozess- und Freigabeanalytik.</p></a>
        <a href="/leistungen/ausstattung" class="group bg-white border border-gray-100 rounded-xl p-6 hover:shadow-xl hover:border-primary/30 transition-all"><div class="w-12 h-12 bg-primary/10 rounded-lg flex items-center justify-center mb-4 group-hover:bg-primary transition-colors"><svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-[#7a9900] group-hover:text-slate-900 transition-colors" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 3v18h18"/><path d="m19 9-5 5-4-4-3 3"/></svg></div><h3 class="font-bold text-slate-900 mb-2">Wägelabor</h3><p class="text-gray-600 text-sm">Vibrationsarme Wägetische, kontrollierte Klimabedingungen.</p></a>
        <a href="/leistungen" class="group bg-white border border-gray-100 rounded-xl p-6 hover:shadow-xl hover:border-primary/30 transition-all"><div class="w-12 h-12 bg-primary/10 rounded-lg flex items-center justify-center mb-4 group-hover:bg-primary transition-colors"><svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-[#7a9900] group-hover:text-slate-900 transition-colors" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="7" height="9" x="3" y="3" rx="1"/><rect width="7" height="5" x="14" y="3" rx="1"/><rect width="7" height="9" x="14" y="12" rx="1"/><rect width="7" height="5" x="3" y="16" rx="1"/></svg></div><h3 class="font-bold text-slate-900 mb-2">Containeranlage / Mehrstöckig</h3><p class="text-gray-600 text-sm">Mehrere Container verbunden – skalierbar nach Bedarf.</p></a>
      </div>
    </div></div></section>

    <section class="py-16 md:py-20 bg-slate-50 border-y border-gray-100"><div class="container mx-auto px-4"><div class="max-w-4xl mx-auto">
      <h2 class="text-3xl md:text-4xl font-heading font-bold mb-8 text-slate-900">Lieferung nach Frankfurt – 320 km ab Werk</h2>
      <div class="grid md:grid-cols-3 gap-6 mb-10">
        <div class="bg-white rounded-xl p-6 border border-gray-100 text-center"><div class="text-3xl font-heading font-bold text-[#7a9900] mb-1">~320 km</div><p class="text-gray-600 text-sm">Albstadt → Frankfurt</p></div>
        <div class="bg-white rounded-xl p-6 border border-gray-100 text-center"><div class="text-3xl font-heading font-bold text-[#7a9900] mb-1">~4 Std.</div><p class="text-gray-600 text-sm">Transport per Tieflader über A81/A6</p></div>
        <div class="bg-white rounded-xl p-6 border border-gray-100 text-center"><div class="text-3xl font-heading font-bold text-[#7a9900] mb-1">8–14 Wo.</div><p class="text-gray-600 text-sm">Bis zur schlüsselfertigen Übergabe</p></div>
      </div>
      <div class="bg-white rounded-xl p-8 border border-gray-100 space-y-6">
        <div><h3 class="font-bold text-slate-900 mb-2">Aufstellung im Rhein-Main-Gebiet</h3><p class="text-gray-600">Unsere Container stehen auf Industrieparks, Klinikgeländen und Forschungsarealen – vom Industriepark Höchst über das Uniklinikum bis nach Darmstadt und Wiesbaden. Aufstellung per Kran, Medienanschlüsse vor Ort.</p></div>
        <div><h3 class="font-bold text-slate-900 mb-2">Baugenehmigung in Hessen</h3><p class="text-gray-600">Die Hessische Bauordnung (HBO) stuft Container als bauliche Anlagen ein. Bei temporärer Nutzung häufig verfahrensfrei. Bei Daueraufstellung klären wir die Genehmigung mit dem zuständigen Bauamt.</p></div>
        <div><h3 class="font-bold text-slate-900 mb-2">Life-Sciences-Standort Rhein-Main</h3><p class="text-gray-600">Das Rhein-Main-Gebiet ist einer der stärksten Life-Science-Cluster Europas: Sanofi, Merck, BioNTech, über 500 Pharma- und Biotech-Unternehmen, das Paul-Ehrlich-Institut und drei Universitätskliniken. Laborfläche ist hier chronisch knapp.</p></div>
      </div>
    </div></div></section>

    <section class="py-16 md:py-20"><div class="container mx-auto px-4"><div class="max-w-4xl mx-auto">
      <h2 class="text-3xl md:text-4xl font-heading font-bold mb-4 text-slate-900">So entsteht Ihr Containerlabor in Frankfurt</h2>
      <p class="text-gray-600 text-lg mb-12">Von der Idee bis zum betriebsbereiten Labor – in 5 klaren Schritten.</p>
      <div class="space-y-0">
