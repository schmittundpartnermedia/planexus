---
import Layout from '../layouts/Layout.astro';
import ContactForm from '../components/ContactForm.tsx';
import Picture from '../components/Picture.astro';
import AuthorBio from '../components/AuthorBio.astro';
import CityCrossLinks from '../components/CityCrossLinks.astro';

const title = "Laborcontainer Linz | LABtoGO 2.0, BSL-3, Voestalpine + JKU – schlüsselfertig";
const description = "Laborcontainer Linz: LABtoGO 2.0, BSL-3, ATEX, OIB + ÖNORM Z2, Voestalpine + Borealis + JKU + Kepler Klinikum. EU-Binnenmarkt, A1 direkt, in 14 Wochen.";
const canonicalUrl = "https://planexus.de/laborcontainer-linz";
const ogImage = "https://planexus.de/assets/laborcontainer-modulbau.jpg";

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "serviceType": "Laborcontainer und modularer Laborbau Linz",
  "provider": {
    "@type": "Organization",
    "name": "Planexus GmbH",
    "url": "https://planexus.de",
    "telephone": "+49 7435 7519 700",
    "email": "info@planexus.de",
    "address": { "@type": "PostalAddress", "streetAddress": "Emil-Mayer-Straße 1", "addressLocality": "Albstadt", "postalCode": "72461", "addressCountry": "DE" },
    "parentOrganization": { "@type": "Organization", "name": "Wesemann Holding GmbH" }
  },
  "areaServed": [
    { "@type": "City", "name": "Linz" },
    { "@type": "AdministrativeArea", "name": "Oberösterreich" },
    { "@type": "Country", "name": "Österreich" }
  ],
  "description": "Containerlabore, mobile Labore und modulare Laborgebäude für Voestalpine, Borealis, Chemiepark Linz, JKU + LIT Open Innovation Center, Kepler Universitätsklinikum und das Mechatronik-Cluster OÖ – ab Werk Albstadt EU-binnenmarktkonform nach Linz über A8 + A1 direkt ohne Tunnel-Maut.",
  "offers": { "@type": "AggregateOffer", "priceCurrency": "EUR", "availability": "https://schema.org/InStock" }
};

const localBusinessSchema = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "name": "Planexus GmbH – Laborcontainer Linz",
  "image": "https://planexus.de/assets/laborcontainer-modulbau.jpg",
  "url": "https://planexus.de/laborcontainer-linz",
  "telephone": "+49 7435 7519 700",
  "email": "info@planexus.de",
  "address": { "@type": "PostalAddress", "streetAddress": "Emil-Mayer-Straße 1", "addressLocality": "Albstadt", "postalCode": "72461", "addressCountry": "DE" },
  "areaServed": { "@type": "City", "name": "Linz", "containedInPlace": { "@type": "Country", "name": "Österreich" } },
  "priceRange": "EUR",
  "openingHoursSpecification": [{ "@type": "OpeningHoursSpecification", "dayOfWeek": ["Monday","Tuesday","Wednesday","Thursday","Friday"], "opens": "08:00", "closes": "17:00" }]
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Start", "item": "https://planexus.de/" },
    { "@type": "ListItem", "position": 2, "name": "Standorte", "item": "https://planexus.de/standorte" },
    { "@type": "ListItem", "position": 3, "name": "Laborcontainer Linz", "item": "https://planexus.de/laborcontainer-linz" }
  ]
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Wie lange dauert die Lieferung eines Laborcontainers nach Linz vom Werk Albstadt?",
      "acceptedAnswer": { "@type": "Answer", "text": "Die Schwerlastroute Werk Albstadt → Linz führt über die A81 nordostwärts bis Stuttgart, dann A8 ostwärts via München → Salzburg, Grenzübergang Walserberg (DE/AT EU-Binnenmarkt, kein Stopp seit Schengen), weiter A1 ostwärts direkt nach Linz – ohne Umweg über A9 Pyhrn und ohne mautpflichtige Sondertunnel. Reine Fahrzeit beträgt rund 5,5 Stunden bei circa 470 Kilometern Distanz – die direkteste Route nach Österreich neben Salzburg, deutlich schneller und mautgünstiger als Graz oder Wien. Standardanlieferpunkte: Voestalpine-Str. 1 in Linz-Pichling, Borealis Innovation Headquarters St. Peter-Str. 25, Chemiepark Linz Bauernstr., JKU Altenberger Str. 69 in Auhof, Kepler Universitätsklinikum Krankenhausstr. 9 in Bulgariplatz, LIT Open Innovation Center JKU. Vom Auftrag bis zur betriebsbereiten Übergabe in Linz vergehen 10 bis 14 Wochen." }
    },
    {
      "@type": "Question",
      "name": "Welche Bewilligungen brauche ich für einen Laborcontainer in Linz?",
      "acceptedAnswer": { "@type": "Answer", "text": "In Linz gilt die Oberösterreichische Bauordnung 1994 (OÖ BauO LGBl. 66/1994 idgF) und das OÖ Bautechnikgesetz (OÖ BauTG LGBl. 67/1994 idgF) als oberösterreichische Landesgesetze, ergänzt durch die OIB-Richtlinien 1 bis 6 des Österreichischen Institut für Bautechnik. Zuständig ist der Magistrat Linz Baurechtsamt am Hauptplatz 1-5, 4041 Linz. Container gelten als Bauten gemäss § 24 OÖ BauO, eine Bauanzeige oder Baubewilligung ist in den meisten Fällen nötig. Auf Industriegrundstücken im Chemiepark Linz, am Voestalpine-Werksgelände oder an Borealis-Standorten gilt zusätzlich die innerbetriebliche Genehmigung der Werkleitung. Bei temporärer Aufstellung unter sechs Monaten und Industriegrundstücken ist je nach Standort ein vereinfachtes Anzeigeverfahren möglich. Wir prüfen den Standort vorab und reichen verfahrenstaugliche Bauunterlagen direkt am Hauptplatz ein – inklusive ÖNORM-Statik mit Erdbebenzone Z2, OIB-Energienachweis und Brandschutzkonzept nach OIB-RL 2." }
    },
    {
      "@type": "Question",
      "name": "Welche Erdbeben-Anforderungen gelten für Laborcontainer in Linz nach ÖNORM B 1998-1?",
      "acceptedAnswer": { "@type": "Answer", "text": "Linz liegt nach ÖNORM B 1998-1 (Eurocode 8 Erdbeben) in Erdbebenzone Z2 mit einer horizontalen Bemessungs-Bodenbeschleunigung agR von rund 0,4 bis 0,8 m/s² – moderater als Graz (Z3) oder Wien (Z2/Z3), aber weiterhin statisch relevant. Die Donau-Ebene Oberösterreichs ist seismisch ruhiger als die Steiermark, erlaubt aber keine Vereinfachung – jeder Container für die Voestalpine-Schwerindustrie, das Kepler Klinikum oder die JKU braucht ein verifiziertes Verankerungskonzept. Statisch-konstruktiv bedeutet das: Bedeutungskategorie II für Voestalpine-, Borealis-, JKU- und Kepler-Klinikum-Standorte ist Pflicht, kapazitätsbemessenes Gesamtsystem nach ÖNORM B 1998-1 ist nicht optional. Wir liefern für Linz statisch nach ÖNORM B 1998-1 mit Z2-Faktor und ÖNORM B 1991-1-3 Schneelast (Linz Zone 2-3, sk je nach Höhenlage 1,4-2,0 kN/m²) sowie energetisch nach OIB-RL 6 mit U ≤ 0,20 W/m²K und Wärmerückgewinnung ≥ 75 % – verfahrenstauglich für das Baurechtsamt Hauptplatz." }
    },
    {
      "@type": "Question",
      "name": "Was ist der Stahl-Chemie-Cluster Linz und welche Container braucht er?",
      "acceptedAnswer": { "@type": "Answer", "text": "Linz ist der grösste Stahl- und Chemie-Cluster Mitteleuropas. Voestalpine AG mit Stammsitz Voestalpine-Str. 1, 4020 Linz – mit ~22.000 Mitarbeitenden in Linz und ~50.000 weltweit – ist weltweit Top-3 in Spezialstahl, Schienen, Bahnsystemen und High-Tech-Stahl. Das R&D-Headquarter liegt direkt am Linzer Werk. Borealis AG mit Innovation Headquarters St. Peter-Str. 25, 4021 Linz – mit ~1.500 Mitarbeitenden in Linz – ist europäischer Polyolefin-Marktführer mit Schwerpunkt Polypropylen und Polyethylen. Beide Unternehmen sind eingebunden in den Chemiepark Linz, der zusätzlich AMI Agrolinz Melamine, DSM Fine Chemicals Austria und weitere Spezialchemie-Standorte umfasst. Diese Cluster brauchen Werkstoffprüf-Container nach ÖNORM EN ISO 17025, Korrosionslabore, Polymer-Charakterisierungs-Container, Hochtemperatur-Mess-Container und – für Borealis-Pilotierung – ATEX-Container nach EN 60079 EX-II 2G/3G für brennbare Gase und Dämpfe. Wir bauen all das ab Werk Albstadt verfahrenstauglich für Voestalpine-Werksgelände und Chemiepark Linz." }
    },
    {
      "@type": "Question",
      "name": "Welche Anwendungen sind in Linz besonders nachgefragt?",
      "acceptedAnswer": { "@type": "Answer", "text": "Linz ist Stahl-Chemie- und Life-Science-Doppelcluster. Wesentliche Nachfrage kommt von der Voestalpine-Schwerindustrie (Voestalpine-Str. 1, 4020 Linz, ~22.000 Mitarbeitende Linz, R&D-HQ Linz – Werkstoffprüf-, Korrosions- und Hochtemperatur-Mess-Container nach ÖNORM EN ISO 17025), von Borealis (St. Peter-Str. 25, 4021 Linz, ~1.500 Mitarbeitende Linz – Polymer-Charakterisierungs- und ATEX-Pilot-Container EN 60079), vom Chemiepark Linz (AMI Agrolinz, DSM Fine Chemicals Austria – GMP- und Reinraum-Container ISO 14644 Klasse 7/8), von der JKU – Johannes Kepler Universität (Altenberger Str. 69, 4040 Linz Auhof, ~24.000 Studierende, seit 2014 mit Med-Fakultät – BSL-2-Forschungs- und Lehr-Container für Medizin, Mechatronik und Materialwissenschaften), vom Kepler Universitätsklinikum (Krankenhausstr. 9, 4020 Linz, ~6.000 Mitarbeitende, ~1.800 Betten – 2.-grösstes Spital Österreichs nach AKH Wien, Fusion 2016 aus AKh Linz + Wagner-Jauregg + Kinderspital – BSL-2-Studien-Container während Klinik-Sanierung), vom LIT Open Innovation Center JKU (Mechatronik-, Robotik- und Software-Container) und vom OÖ Mechatronik-Cluster, Kunststoff-Cluster, Automotive-Cluster und Cleantech-Cluster (jeweils Pilotierungs- und Test-Container)." }
    },
    {
      "@type": "Question",
      "name": "Wie liefern Sie nach Österreich? EU-Binnenmarkt, A1 direkt, GO-Box?",
      "acceptedAnswer": { "@type": "Answer", "text": "Deutschland und Österreich sind beide EU-Mitgliedstaaten und Teil des Binnenmarkts – es gibt keine Zollverzollung. Wir liefern ab Werk Albstadt als innergemeinschaftliche Lieferung mit österreichischer USt-IdNr (ATU-Nummer) – steuerfrei in Deutschland, Reverse Charge in Österreich. Der Preisvorteil gegenüber Schweizer Standorten beträgt bis zu 8,1 % (Schweizer MwSt entfällt komplett). Für den Schwerlasttransport ist die österreichische LKW-Maut (GO-Box, ASFINAG) auf allen Autobahnen und Schnellstrassen obligatorisch. Nach Linz fahren wir die A1 direkt von Salzburg-Walserberg nach Linz – ohne Umweg über A9 Pyhrn, ohne Bosruck- oder Gleinalmtunnel-Sondermaut. Damit ist Linz die mautgünstigste österreichische Landeshauptstadt-Anfahrt nach Salzburg. Standardroute: ~470 km, ~5,5 h Schwerlastfahrzeit. Anschlussstellen: Linz-Asten und Linz-Süd für Voestalpine-Werksgelände und Chemiepark, Linz-Auhof für JKU und Borealis, Linz-Mitte für Kepler Universitätsklinikum." }
    },
    {
      "@type": "Question",
      "name": "Können Sie ATEX-, GMP- und BSL-Container für Voestalpine, Borealis, Kepler Klinikum und JKU liefern?",
      "acceptedAnswer": { "@type": "Answer", "text": "Ja. Wir bauen für Linz vier Container-Linien parallel. Erstens: Werkstoffprüf-Container für Voestalpine nach ÖNORM EN ISO 17025 mit Druckprüfung, Vibration, Korrosionsprüfung, Hochtemperatur-Spektroskopie. Zweitens: ATEX-Container für Borealis-Pilotierung im Chemiepark Linz (EX-II 2G T3/T4 nach EN 60079) mit explosionsgeschützter Elektrik, Gas-Sensorik mit automatischer Notabschaltung, Berstmembranen und Inertgas-System. Drittens: GMP-Reinraum-Container für ACIB- oder DSM-Pilotierung mit BASG-Inspektionsbereitschaft – ISO Klasse 8/7. Viertens: BSL-2/3-Container für klinische Forschung (Kepler Universitätsklinikum, JKU Med-Fakultät) – HEPA-H14-Doppelfilterung, autoklavierte Schleuse, Unterdruck mit Drei-Stufen-Kaskade, Notstromversorgung. Anzeige nach Gentechnikgesetz (GTG) beim BMSGPK Wien Stubenring, Stellungnahme der wissenschaftlichen Kommission. Statik aller vier Linien nach ÖNORM B 1998-1 (Z2) und ÖNORM B 1991, Energie nach OIB-RL 6, Brandschutz nach OIB-RL 2 verfahrenstauglich für das Baurechtsamt Hauptplatz." }
    }
  ]
};
---

<Layout title={title} description={description} canonicalUrl={canonicalUrl} ogImage={ogImage}>
  <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(localBusinessSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <div class="bg-white">

    <!-- HERO -->
    <section class="relative bg-slate-900 text-white overflow-hidden">
      <div class="absolute inset-0 z-0">
        <Picture src="/assets/laborcontainer-modulbau.jpg" alt="Laborcontainer Linz – modulare Containerlabore für Voestalpine, Borealis, Chemiepark Linz, JKU, Kepler Universitätsklinikum und das Mechatronik-Cluster OÖ" class="w-full h-full object-cover opacity-30" loading="eager" fetchpriority="high" />
        <div class="absolute inset-0 bg-gradient-to-r from-slate-900 via-slate-900/95 to-slate-900/70"></div>
      </div>

      <div class="relative z-10 container mx-auto px-4 py-20 md:py-28">
        <div class="max-w-4xl">
          <nav class="flex items-center gap-2 text-sm text-gray-400 mb-8" aria-label="Breadcrumb">
            <a href="/" class="hover:text-primary transition-colors">Start</a>
            <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m9 18 6-6-6-6"/></svg>
            <span>Standorte</span>
            <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m9 18 6-6-6-6"/></svg>
            <span class="text-primary">Linz</span>
          </nav>

          <div class="text-primary font-medium text-sm uppercase tracking-wider mb-4">Ihr Spezialist für Laborcontainer · Stahl-Chemie-Hauptstadt + JKU + Kepler Klinikum</div>

          <h1 class="text-4xl md:text-5xl lg:text-6xl font-heading font-bold mb-6 leading-tight">
            Laborcontainer Linz <span class="text-primary">|</span> 2,75 m, BSL-3, ATEX, OIB + ÖNORM Z2, Voestalpine + Borealis + JKU – schlüsselfertig in 14 Wochen
          </h1>

          <p class="text-xl text-gray-300 leading-relaxed mb-4">
            <strong class="text-white">Ihr Fachplaner für Containerlabore mit mehr als 10 Jahren Erfahrung.</strong> Modular, OIB-konform, ÖNORM-statisch nach Erdbebenzone Z2. Wir realisieren Werkstoff-, Polymer-, Klinik- und Forschungs-Container für Voestalpine, Borealis, Chemiepark Linz, JKU + LIT Open Innovation Center, Kepler Universitätsklinikum (2.-grösstes AT-Spital nach AKH Wien) und das Mechatronik-Cluster Oberösterreich – aus dem Werk Albstadt direkt nach Linz, EU-binnenmarktkonform ohne Zollverzollung über A8 + A1 direkt ohne Tunnel-Maut.
          </p>
          <p class="text-base text-gray-400 mb-8">Während andere noch planen, prüfen und pilotieren Sie bereits.</p>

          <div class="flex flex-col sm:flex-row gap-4 mb-8">
            <a href="#anfrage" data-testid="button-cta-hero" class="bg-primary text-slate-900 font-bold px-8 py-4 rounded-lg hover:bg-primary/90 transition-colors inline-flex items-center justify-center gap-2 shadow-[0_0_20px_rgba(132,189,0,0.3)]">Kostenfreies Standort-Audit Linz<svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg></a>
            <a href="tel:+4974357519700" class="border border-white/20 text-white font-medium px-8 py-4 rounded-lg hover:bg-white/10 transition-colors inline-flex items-center justify-center gap-2"><svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>+49 7435 7519 700</a>
          </div>

          <div class="flex flex-wrap items-center gap-x-6 gap-y-2 text-sm text-gray-400">
            <div class="flex items-center gap-2"><svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6 9 17l-5-5"/></svg>Pioniere im Modulbau seit 2016</div>
            <div class="flex items-center gap-2"><svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6 9 17l-5-5"/></svg>Award 2026 EU Business News</div>
            <div class="flex items-center gap-2"><svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6 9 17l-5-5"/></svg>EU-Binnenmarkt: ohne Zoll, A1 direkt</div>
            <div class="flex items-center gap-2"><svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6 9 17l-5-5"/></svg>Wesemann-Gruppe · 60+ Jahre Laborbau</div>
          </div>
        </div>
      </div>
    </section>

    <AuthorBio city="Linz" />

    <!-- LABtoGO 2.0 -->
    <section class="py-16 md:py-20 bg-gradient-to-br from-primary/5 via-white to-primary/10 border-y border-primary/20">
      <div class="container mx-auto px-4">
        <div class="max-w-5xl mx-auto">
          <div class="grid md:grid-cols-2 gap-10 items-center mb-10">
            <div>
              <div class="text-primary font-bold text-sm uppercase tracking-wider mb-3">Pattern-Interrupt · Weltpremiere analytica 2026</div>
              <h2 class="text-3xl md:text-4xl font-heading font-bold mb-4 text-slate-900">Planexus zeigt Linz, was ein Laborcontainer 2026 wirklich kann</h2>
              <p class="text-lg text-gray-700 leading-relaxed mb-4">Ein gewöhnlicher Laborcontainer hat 2.400 mm Innenhöhe. Aufrecht arbeiten unter einem Abzug oder einer ATEX-Belüftung ist mühsam.</p>
              <p class="text-lg text-slate-900 font-bold leading-relaxed mb-4">Der LABtoGO 2.0 von Planexus hat 2.750 mm Innenhöhe. 9,5 m Außenlänge. 3 m Außenbreite. Vollverglaste Front, die echtes Tageslicht in jedes Voestalpine-, Borealis-, JKU-, Kepler-Klinikum- oder Chemiepark-Forschungslabor bringt.</p>
              <p class="text-lg text-gray-700 leading-relaxed"><strong>Ein gewöhnlicher Laborcontainer passt komplett in einen LABtoGO hinein.</strong> Wir konfigurieren ihn für Linz nach ÖNORM B 1998-1 Erdbebenzone Z2, OIB-Richtlinie 6 Energie strenger als die deutsche GEG, EU-Binnenmarktkonform ohne Zollverzollung ab Werk Albstadt über A8 + A1 direkt nach Linz – ohne Umweg über A9 Pyhrn, ohne Bosruck- oder Gleinalmtunnel-Sondermaut.</p>
            </div>
            <div class="grid grid-cols-2 gap-4">
              <div class="bg-slate-900 text-white rounded-2xl p-6 text-center"><div class="text-4xl font-bold text-primary mb-1">2.750</div><div class="text-xs text-gray-400 uppercase tracking-wider">mm Innenhöhe</div><div class="text-xs text-gray-500 mt-1">Standard: 2.400 mm</div></div>
              <div class="bg-slate-900 text-white rounded-2xl p-6 text-center"><div class="text-4xl font-bold text-primary mb-1">9.500</div><div class="text-xs text-gray-400 uppercase tracking-wider">mm Außenlänge</div><div class="text-xs text-gray-500 mt-1">3.000 mm Breite</div></div>
              <div class="bg-slate-900 text-white rounded-2xl p-6 text-center"><div class="text-4xl font-bold text-primary mb-1">ÖNORM Z2</div><div class="text-xs text-gray-400 uppercase tracking-wider">Erdbeben agR ~0,4-0,8</div><div class="text-xs text-gray-500 mt-1">moderate AT-Zone</div></div>
              <div class="bg-slate-900 text-white rounded-2xl p-6 text-center"><div class="text-4xl font-bold text-primary mb-1">470 km</div><div class="text-xs text-gray-400 uppercase tracking-wider">Werk → Linz</div><div class="text-xs text-gray-500 mt-1">~5,5 h via A1 direkt</div></div>
            </div>
          </div>
          <div class="text-center"><a href="/laborcontainer/labtogo" class="inline-flex items-center gap-2 text-primary font-bold hover:underline">LABtoGO 2.0 Plattform und alle Konfigurationen ansehen<svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg></a></div>
        </div>
      </div>
    </section>

    <!-- PROBLEM-AGITATION -->
    <section class="py-16 md:py-20">
      <div class="container mx-auto px-4">
        <div class="max-w-5xl mx-auto">
          <h2 class="text-3xl md:text-4xl font-heading font-bold mb-10 text-slate-900">Planexus löst die drei Linzer Engpässe, an denen Stahl-, Chemie- und Klinik-Container regelmässig scheitern</h2>
          <div class="grid md:grid-cols-3 gap-6">
            <div class="bg-slate-50 border-l-4 border-primary rounded-xl p-6">
              <div class="text-slate-900 font-bold text-lg mb-2">Werks-Doppelgenehmigung unterschätzt</div>
              <p class="text-gray-700 text-sm leading-relaxed">Container im Voestalpine-Werksgelände, im Chemiepark Linz oder am Borealis-Standort brauchen zwei Genehmigungspfade parallel: Bauanzeige beim Magistrat Linz Hauptplatz UND innerbetriebliche Werkleitungs-Genehmigung. Wer nur einen Pfad bedient, wird vom Werkschutz vor dem Tor abgewiesen.</p>
              <p class="text-sm text-slate-900 font-semibold mt-3 pt-3 border-t border-gray-200">Planexus-Antwort: beide Pfade ab Werk parallel vorbereitet.</p>
            </div>
            <div class="bg-slate-50 border-l-4 border-primary rounded-xl p-6">
              <div class="text-slate-900 font-bold text-lg mb-2">Borealis-ATEX-Pfad unterspezifiziert</div>
              <p class="text-gray-700 text-sm leading-relaxed">Borealis-Pilotierung im Chemiepark verlangt ATEX-Container EX-II 2G T3/T4 nach EN 60079 mit explosionsgeschützter Elektrik, Gas-Sensorik mit automatischer Notabschaltung, Berstmembranen und Inertgas-System. Standard-Container ohne TÜV-Austria-Zertifizierung werden nicht ans Werksnetz angeschlossen.</p>
              <p class="text-sm text-slate-900 font-semibold mt-3 pt-3 border-t border-gray-200">Planexus-Antwort: ATEX EN 60079 ab Werk, TÜV-Austria-konforme Dokumentation.</p>
            </div>
            <div class="bg-slate-50 border-l-4 border-primary rounded-xl p-6">
              <div class="text-slate-900 font-bold text-lg mb-2">Kepler-Klinikum-Innenhof-Logistik</div>
