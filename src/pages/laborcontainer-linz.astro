---
import Layout from '../layouts/Layout.astro';

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": "Laborcontainer Linz",
  "description": "Mobile Containerlabore für Linz und Oberösterreich: voestalpine Stahlanalytik, Chemiepark Linz, JKU Mechatronik, Lenzing Faserforschung. Werkstoffprüfung, QC-Labor, Analytik – ÖNORM-konform.",
  "provider": {
    "@type": "Organization",
    "name": "Planexus GmbH",
    "url": "https://www.planexus.de"
  },
  "areaServed": [
    { "@type": "City", "name": "Linz" },
    { "@type": "AdministrativeArea", "name": "Oberösterreich" }
  ],
  "serviceType": ["Laborcontainer", "Werkstoffprüfung", "Chemie-Labor", "QC-Container", "Analytiklabor"],
  "url": "https://www.planexus.de/laborcontainer-linz"
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Start", "item": "https://www.planexus.de/" },
    { "@type": "ListItem", "position": 2, "name": "Laborcontainer Linz", "item": "https://www.planexus.de/laborcontainer-linz" }
  ]
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Warum braucht der Industriestandort Linz Laborcontainer?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Linz ist Österreichs Industrie-Hauptstadt: voestalpine (rund 49.000 Beschäftigte weltweit, Hauptsitz Linz), der Chemiepark Linz mit rund 30 Unternehmen und die JKU mit dem weltweit ersten Mechatronik-Studium. Die Dichte an Stahl, Chemie und Technologie erzeugt permanenten Bedarf an Qualitätskontrolle und Werkstoffprüfung."
      }
    },
    {
      "@type": "Question",
      "name": "Welche Container eignen sich für Stahlanalytik?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Für voestalpine und andere Stahlproduzenten liefern wir Werkstoffprüf-Container: Metallografie, Spektrometrie, Zugprüfung, Härtemessung. Klimatisiert, schwingungsarm und mit Absaugung für Schleif- und Ätzarbeiten – ideal für QC am Hochofen."
      }
    },
    {
      "@type": "Question",
      "name": "Brauche ich in Oberösterreich eine Baubewilligung?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Nach der Oö. Bauordnung 1994 gilt: Container sind Gebäude und damit grundsätzlich bewilligungspflichtig. Es gibt Ausnahmen für bestimmte untergeordnete Bauvorhaben, aber Labore mit besonderen Anforderungen fallen in der Regel unter die Bewilligungspflicht."
      }
    },
    {
      "@type": "Question",
      "name": "Wie weit ist Albstadt von Linz entfernt?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Rund 330 km über die A8 via München – etwa 3,5 Stunden Fahrzeit. Kein Zoll innerhalb der EU. Für LKW über 3,5 t fällt GO-Box-Maut auf österreichischen Autobahnen an. Linz ist damit einer der am schnellsten erreichbaren Standorte in Österreich."
      }
    },
    {
      "@type": "Question",
      "name": "Gibt es Container für den Chemiepark Linz?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Ja. Der Chemiepark Linz umfasst rund 30 Unternehmen auf dem ehemaligen Gelände der Chemie Linz AG. Analytik-Container für Prozessüberwachung, Umweltanalytik und QC sind ideal für die chemische Industrie – inklusive Gefahrstoff-Ausstattung und EX-Schutz."
      }
    },
    {
      "@type": "Question",
      "name": "Was kostet ein Industrielabor-Container für Linz?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Die Kosten richten sich nach Ausstattung und Prüfnormen. Die Transportkosten für Linz (~330 km) sind moderat und vergleichbar mit süddeutschen Städten. Kontaktieren Sie uns für eine projektspezifische Kalkulation."
      }
    }
  ]
};

const localBusinessSchema = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "name": "Planexus GmbH – Laborcontainer Linz",
  "description": "Containerlabore für Linz und Oberösterreich: voestalpine, Chemiepark, JKU, Lenzing. Werkstoffprüfung, Chemie-Analytik, QC-Labor – ÖNORM-konform.",
  "url": "https://www.planexus.de",
  "telephone": "+49 7435 7519 700",
  "email": "info@planexus.de",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "Am Steinbach 8",
    "addressLocality": "Albstadt",
    "postalCode": "72459",
    "addressCountry": "DE"
  },
  "areaServed": [
    { "@type": "City", "name": "Linz" },
    { "@type": "AdministrativeArea", "name": "Oberösterreich" }
  ]
};
---

<Layout
  title="Laborcontainer Linz – voestalpine, Chemiepark & Industrie 4.0 | Planexus GmbH"
  description="Containerlabore für Linz: voestalpine Stahlanalytik (~49.000 MA), Chemiepark (~30 Firmen), JKU Mechatronik, Lenzing Fasertechnologie. Werkstoffprüfung, QC – 330 km ab Werk."
  canonical="/laborcontainer-linz"
  schema={serviceSchema}
  ogImage="/attached_assets/Kopf_green-scaled_1768306688943.jpg"
>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} slot="head" />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} slot="head" />
  <script type="application/ld+json" set:html={JSON.stringify(localBusinessSchema)} slot="head" />

  <div class="pt-20 min-h-screen bg-white">

    <!-- Hero: Industrielabor an der Donau -->
    <section class="relative py-32 bg-slate-900 text-white overflow-hidden">
      <div class="absolute inset-0 bg-[linear-gradient(160deg,rgba(187,215,0,0.05)_0%,transparent_40%,rgba(187,215,0,0.04)_100%)]"></div>
      <div class="absolute top-1/3 left-0 w-[400px] h-[400px] bg-primary/3 rounded-full blur-[160px]"></div>

      <div class="container mx-auto px-4 relative z-10">
        <div class="max-w-4xl">
          <div class="flex items-center gap-3 mb-8">
            <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-white/10 text-primary text-sm font-medium backdrop-blur-sm border border-white/10">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
              Linz & Oberösterreich
            </div>
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-red-700/20 text-red-400 text-xs font-bold border border-red-700/20">
              <span class="w-2 h-2 bg-red-400 rounded-full"></span>
              Österreich
            </div>
          </div>

          <h1 class="text-4xl md:text-5xl lg:text-6xl font-heading font-bold mb-6 leading-tight">
            Stahl, Chemie, Mechatronik – <span class="text-primary">Österreichs Industrielabor</span>
          </h1>
          <p class="text-xl text-gray-300 mb-4 leading-relaxed font-light max-w-3xl">
            voestalpine hat hier ihren Hauptsitz – ein Technologiekonzern mit rund 49.000 Beschäftigten weltweit. Der Chemiepark Linz vereint rund 30 Unternehmen auf einem Gelände. Und die JKU hat 1990 das weltweit erste Mechatronik-Studium eingeführt. Linz ist Österreichs industrielles Rückgrat.
          </p>
          <p class="text-lg text-gray-400 mb-10 max-w-2xl">
            Wo Stahl geprüft, Chemie analysiert und Materialien getestet werden – braucht man Labore.
          </p>

          <div class="flex flex-col sm:flex-row gap-4 mb-16">
            <a href="/kontakt" class="bg-primary text-slate-900 font-bold px-8 py-4 rounded-lg hover:bg-primary/90 transition-colors flex items-center justify-center gap-2 group shadow-[0_0_20px_rgba(187,215,0,0.3)]">
              Industrielabor anfragen
              <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 group-hover:translate-x-1 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
            </a>
            <a href="tel:+4974357519700" class="border border-white/20 text-white font-medium px-8 py-4 rounded-lg hover:bg-white/10 transition-colors backdrop-blur-sm flex items-center justify-center gap-2">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
              +49 7435 7519 700
            </a>
          </div>

          <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
            <div class="bg-white/5 border border-white/10 rounded-xl p-4 text-center">
              <div class="text-2xl font-heading font-bold text-primary">~49.000</div>
              <p class="text-gray-400 text-xs mt-1">voestalpine MA weltweit</p>
            </div>
            <div class="bg-white/5 border border-white/10 rounded-xl p-4 text-center">
              <div class="text-2xl font-heading font-bold text-primary">~30</div>
              <p class="text-gray-400 text-xs mt-1">Chemiepark-Firmen</p>
            </div>
            <div class="bg-white/5 border border-white/10 rounded-xl p-4 text-center">
              <div class="text-2xl font-heading font-bold text-primary">1990</div>
              <p class="text-gray-400 text-xs mt-1">JKU: 1. Mechatronik</p>
            </div>
            <div class="bg-white/5 border border-white/10 rounded-xl p-4 text-center">
              <div class="text-2xl font-heading font-bold text-primary">~330 km</div>
              <p class="text-gray-400 text-xs mt-1">Albstadt → Linz</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Breadcrumb -->
    <nav class="bg-gray-50 border-b border-gray-100 py-3">
      <div class="container mx-auto px-4">
        <ol class="flex items-center gap-2 text-sm text-gray-500">
          <li><a href="/" class="hover:text-primary transition-colors">Start</a></li>
          <li><svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg></li>
          <li class="text-primary font-medium">Laborcontainer Linz</li>
        </ol>
      </div>
    </nav>

    <!-- Section 1: voestalpine -->
    <section class="py-20 bg-white">
      <div class="container mx-auto px-4">
        <div class="max-w-5xl mx-auto">
          <h2 class="text-3xl md:text-4xl font-heading font-bold mb-6 text-slate-900">
            voestalpine: Stahlanalytik auf Konzernniveau
          </h2>
          <p class="text-gray-600 text-lg mb-12 leading-relaxed max-w-3xl">
            Die voestalpine AG ist ein börsennotierter Stahl- und Technologiekonzern mit Hauptsitz in Linz. In vier Divisionen – Steel, High Performance Metals, Metal Engineering und Metal Forming – arbeiten rund 49.000 Menschen weltweit. Fast die Hälfte davon in Österreich, ein Großteil am Standort Linz.
          </p>

          <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
            <div class="bg-gradient-to-br from-slate-50 to-white rounded-2xl p-8 border border-gray-100">
              <h3 class="text-xl font-heading font-bold text-slate-900 mb-4">voestalpine AG – Kennzahlen</h3>
              <div class="space-y-3 text-sm mb-6">
                <div class="flex justify-between"><span class="text-gray-500">Hauptsitz</span><span class="font-bold text-slate-900">Linz, Österreich</span></div>
                <div class="flex justify-between"><span class="text-gray-500">MA weltweit</span><span class="font-bold text-slate-900">~49.000</span></div>
                <div class="flex justify-between"><span class="text-gray-500">MA Österreich</span><span class="font-bold text-slate-900">~23.600 (45,8%)</span></div>
                <div class="flex justify-between"><span class="text-gray-500">Divisionen</span><span class="font-bold text-slate-900">4 (Steel, HPM, ME, MF)</span></div>
                <div class="flex justify-between"><span class="text-gray-500">Fokus</span><span class="font-bold text-slate-900">Stahl & Technologie</span></div>
              </div>
              <p class="text-gray-600 text-sm leading-relaxed">
                Die Qualitätskontrolle bei voestalpine ist so umfangreich wie die Produktion selbst: Jede Charge wird geprüft, jeder Stahl analysiert, jedes Bauteil dokumentiert. Metallografie, Spektrometrie, Zugversuche und Korrosionsprüfung laufen im Dreischichtbetrieb.
              </p>
              <p class="text-xs text-gray-400 mt-3">Quelle: voestalpine AG, Geschäftsbericht 2023/24</p>
            </div>

            <div class="bg-white rounded-2xl p-8 border border-gray-200 shadow-sm">
              <h3 class="font-heading font-bold text-lg mb-6 text-slate-900">Werkstoffprüfung im Container</h3>
              <div class="space-y-5">
                <div class="flex gap-4">
                  <div class="w-10 h-10 bg-primary/10 rounded-lg flex items-center justify-center shrink-0">
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-[#7a9900]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="m4.93 4.93 14.14 14.14"/></svg>
                  </div>
                  <div>
                    <h4 class="font-bold text-sm text-slate-900 mb-1">Metallografie</h4>
                    <p class="text-gray-600 text-xs">Gefügeanalyse, Schliffpräparation, mikroskopische Auswertung. Direkt am Stahlwerk – keine Transportwege für Proben.</p>
                  </div>
                </div>
                <div class="flex gap-4">
                  <div class="w-10 h-10 bg-primary/10 rounded-lg flex items-center justify-center shrink-0">
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-[#7a9900]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2v20M2 12h20"/></svg>
                  </div>
                  <div>
                    <h4 class="font-bold text-sm text-slate-900 mb-1">Spektrometrie (OES/XRF)</h4>
                    <p class="text-gray-600 text-xs">Elementanalyse von Stahl und Legierungen. Funken-OES und Röntgenfluoreszenz im klimatisierten Container.</p>
                  </div>
                </div>
                <div class="flex gap-4">
                  <div class="w-10 h-10 bg-primary/10 rounded-lg flex items-center justify-center shrink-0">
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-[#7a9900]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 4v10.54a4 4 0 1 1-4 0V4a2 2 0 0 1 4 0Z"/></svg>
                  </div>
                  <div>
                    <h4 class="font-bold text-sm text-slate-900 mb-1">Mechanische Prüfung</h4>
                    <p class="text-gray-600 text-xs">Zugversuch, Kerbschlagbiegeversuch, Härteprüfung. Schwingungsisolierte Fundamente für präzise Messungen.</p>
                  </div>
                </div>
                <div class="flex gap-4">
                  <div class="w-10 h-10 bg-primary/10 rounded-lg flex items-center justify-center shrink-0">
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-[#7a9900]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 2v7.527a2 2 0 0 1-.211.896L4.72 20.55a1 1 0 0 0 .9 1.45h12.76a1 1 0 0 0 .9-1.45l-5.069-10.127A2 2 0 0 1 14 9.527V2"/><path d="M8.5 2h7"/></svg>
                  </div>
                  <div>
                    <h4 class="font-bold text-sm text-slate-900 mb-1">Korrosionsprüfung</h4>
                    <p class="text-gray-600 text-xs">Salzsprühtest, Wechselklima, elektrochemische Analyse. Klimakammer und Probenexposition im dedizierten Container.</p>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Section 2: Chemiepark Linz -->
    <section class="py-20 bg-slate-900 text-white">
      <div class="container mx-auto px-4">
        <div class="max-w-5xl mx-auto">
          <h2 class="text-3xl md:text-4xl font-heading font-bold mb-6">
            Chemiepark Linz: 30 Unternehmen, ein Industriestandort
          </h2>
          <p class="text-gray-400 text-lg mb-12 leading-relaxed max-w-3xl">
            Der Chemiepark Linz ging aus der historischen Chemie Linz AG (ehemals Stickstoffwerke Linz) hervor. Heute arbeiten hier rund 30 Unternehmen der chemischen Industrie – von Düngemittelproduktion bis Spezialchemie. Die Qualitätskontrolle ist so vielfältig wie die Produktpalette.
          </p>

          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            <div class="bg-white/5 border border-white/10 rounded-xl p-6">
              <h3 class="text-primary font-bold mb-3">Prozessanalytik</h3>
              <p class="text-gray-300 text-sm leading-relaxed">
                Laufende Überwachung chemischer Prozesse: pH, Leitfähigkeit, Konzentration, Viskosität. Container direkt neben der Produktionsanlage für Echtzeit-Analytik ohne Probenversand.
              </p>
            </div>
            <div class="bg-white/5 border border-white/10 rounded-xl p-6">
              <h3 class="text-primary font-bold mb-3">Umweltanalytik</h3>
              <p class="text-gray-300 text-sm leading-relaxed">
                Abwasser, Emissionen, Bodenproben – die chemische Industrie steht unter permanenter Umweltüberwachung. Containerlabore für akkreditierte Umweltanalysen direkt am Standort.
              </p>
            </div>
            <div class="bg-white/5 border border-white/10 rounded-xl p-6">
              <h3 class="text-primary font-bold mb-3">Gefahrstoff-Labor</h3>
              <p class="text-gray-300 text-sm leading-relaxed">
                Analyse von Gefahrstoffen unter kontrollierten Bedingungen: EX-geschützte Ausstattung, Abzüge, Gaswarnanlage. Container mit Sicherheitsausstattung nach ATEX und ASchG.
              </p>
            </div>
          </div>

          <div class="mt-8 bg-white/5 border border-white/10 rounded-xl p-6">
            <div class="flex items-start gap-4">
              <div class="w-10 h-10 bg-primary/15 rounded-lg flex items-center justify-center shrink-0 text-primary font-bold">!</div>
              <div>
                <h4 class="font-bold text-white text-sm mb-1">Industriegebiet-Hafen</h4>
                <p class="text-gray-400 text-sm leading-relaxed">Der Chemiepark liegt im Bezirk Industriegebiet-Hafen, direkt an der Donau und neben dem voestalpine-Gelände. Die Infrastruktur ist auf Schwerlast ausgelegt – Containeranlieferung ist logistisch unkompliziert.</p>
              </div>
            </div>
          </div>

          <p class="text-gray-500 text-xs mt-8">Quelle: Chemiepark Linz</p>
        </div>
      </div>
    </section>

    <!-- Section 3: Lenzing & regionale Industrie -->
    <section class="py-20 bg-white">
      <div class="container mx-auto px-4">
        <div class="max-w-5xl mx-auto">
          <span class="text-primary text-sm font-bold uppercase tracking-wider">Regionale Industriekraft</span>
          <h2 class="text-3xl font-heading font-bold mt-3 mb-6 text-slate-900">
            Lenzing, TIGER Coatings und Oberösterreichs Industriecluster
          </h2>
          <p class="text-gray-600 text-lg mb-12 leading-relaxed max-w-3xl">
            Oberösterreich ist mehr als Linz. Die Lenzing AG (57 km entfernt) ist Weltmarktführer bei holzbasierten Cellulosefasern. TIGER Coatings in Wels entwickelt Pulverlacke. Das Bundesland ist ein Netzwerk aus Hidden Champions – alle mit Analytik-Bedarf.
          </p>

          <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
            <div class="bg-slate-50 rounded-2xl p-8 border border-gray-100">
              <h3 class="text-xl font-heading font-bold text-slate-900 mb-3">Lenzing AG</h3>
              <div class="space-y-2 text-sm mb-4">
                <div class="flex justify-between"><span class="text-gray-500">Standort</span><span class="font-bold text-slate-900">Lenzing (57 km ab Linz)</span></div>
                <div class="flex justify-between"><span class="text-gray-500">MA weltweit</span><span class="font-bold text-slate-900">~7.800</span></div>
                <div class="flex justify-between"><span class="text-gray-500">Umsatz 2024</span><span class="font-bold text-slate-900">~2,7 Mrd. EUR</span></div>
              </div>
              <p class="text-gray-600 text-sm leading-relaxed">
                Die Lenzing AG produziert Cellulosefasern (TENCEL, LENZING ECOVERO) für die Textil- und Vliesstoffindustrie. Faserforschung, Rohstoffanalyse und Prozessüberwachung erfordern spezialisierte Laborinfrastruktur.
              </p>
              <p class="text-xs text-gray-400 mt-3">Quelle: Lenzing AG, Geschäftsbericht 2024</p>
            </div>

            <div class="bg-slate-50 rounded-2xl p-8 border border-gray-100">
              <h3 class="text-xl font-heading font-bold text-slate-900 mb-3">JKU Linz</h3>
              <div class="space-y-2 text-sm mb-4">
                <div class="flex justify-between"><span class="text-gray-500">Mechatronik seit</span><span class="font-bold text-slate-900">1990 (weltweit erstes)</span></div>
                <div class="flex justify-between"><span class="text-gray-500">Institute</span><span class="font-bold text-slate-900">15 (Mechatronik)</span></div>
              </div>
              <p class="text-gray-600 text-sm leading-relaxed">
                Die Johannes Kepler Universität hat 1990 weltweit das erste Mechatronik-Studium eingeführt. Mit 15 Instituten im Fachbereich ist sie Europas größte Mechatronik-Fakultät. Forschungsprojekte mit Industrie erfordern flexible Laborkapazität.
              </p>
              <p class="text-xs text-gray-400 mt-3">Quelle: JKU Linz</p>
            </div>

            <div class="bg-slate-50 rounded-2xl p-8 border border-gray-100">
              <h3 class="text-xl font-heading font-bold text-slate-900 mb-3">Industriecluster OÖ</h3>
              <p class="text-gray-600 text-sm leading-relaxed mb-4">
                Oberösterreich ist Österreichs exportstärkstes Bundesland. Neben Stahl und Chemie sind Maschinenbau, Kunststoff und Automotive stark vertreten. Hidden Champions wie TIGER Coatings (Wels), Fronius (Pettenbach) und Engel Austria (Schwertberg) benötigen Prüf- und Analytiklabore.
              </p>
              <p class="text-gray-600 text-sm leading-relaxed">
