---
import Layout from '../layouts/Layout.astro';

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": "Laborcontainer Hamburg",
  "description": "Mobile Containerlabore für Hamburgs maritime Forschung, Hafenanalytik und Life Sciences. BSL-2/BSL-3, GLP-konform, korrosionsgeschützt für Küstenklima. Planung bis Übergabe aus einer Hand.",
  "provider": {
    "@type": "Organization",
    "name": "Planexus GmbH",
    "url": "https://www.planexus.de"
  },
  "areaServed": [
    { "@type": "City", "name": "Hamburg" },
    { "@type": "State", "name": "Hamburg" },
    { "@type": "State", "name": "Schleswig-Holstein" },
    { "@type": "State", "name": "Niedersachsen" }
  ],
  "serviceType": ["Laborcontainer", "Mobile Labore", "BSL-2 Container", "BSL-3 Container", "Hafenanalytik-Labor"],
  "url": "https://www.planexus.de/laborcontainer-hamburg"
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Start", "item": "https://www.planexus.de/" },
    { "@type": "ListItem", "position": 2, "name": "Laborcontainer Hamburg", "item": "https://www.planexus.de/laborcontainer-hamburg" }
  ]
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Halten Laborcontainer dem Hamburger Küstenklima stand?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Ja. Unsere Container für den norddeutschen Einsatz erhalten serienmäßig eine C4-Korrosionsschutzbeschichtung nach ISO 12944, feuchtigkeitsresistente Innenflächen und verstärkte Klimatisierung mit Entfeuchtung. Salzhaltige Luft, Schlagregen und Temperaturschwankungen zwischen -15 °C und +35 °C sind konstruktiv berücksichtigt."
      }
    },
    {
      "@type": "Question",
      "name": "Welche Genehmigungen braucht ein Laborcontainer im Hamburger Hafengebiet?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Im Hafengebiet gelten neben der Hamburgischen Bauordnung (HBauO) die Vorschriften der Hamburg Port Authority (HPA). Temporäre Aufstellungen unter 2 Jahren sind häufig verfahrensfrei. Für den Umgang mit Gefahrstoffen ist zusätzlich die Abstimmung mit der Behörde für Umwelt, Klima, Energie und Agrarwirtschaft (BUKEA) erforderlich. Wir übernehmen die komplette Behördenkoordination."
      }
    },
    {
      "@type": "Question",
      "name": "Kann ein Laborcontainer direkt an der Kaikante aufgestellt werden?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Ja. Wir haben Erfahrung mit Aufstellungen in hafennahen Bereichen. Die Container werden per Tieflader angeliefert und mit Mobilkran positioniert. Voraussetzung ist eine tragfähige, ebene Aufstellfläche. Medienanschlüsse (Strom, Wasser, Abwasser) klären wir im Vorfeld mit dem Hafenbetreiber."
      }
    },
    {
      "@type": "Question",
      "name": "Wie schnell ist ein Laborcontainer in Hamburg einsatzbereit?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Von der Auftragserteilung bis zur schlüsselfertigen Übergabe vergehen 8 bis 14 Wochen – abhängig von Ausstattung und Sicherheitsstufe. Der Transport von unserem Werk in Albstadt dauert per Schwerlast-LKW über die A7 einen Tag. Aufstellung und Inbetriebnahme planen wir so, dass Ihr Laborbetrieb nahtlos starten kann."
      }
    },
    {
      "@type": "Question",
      "name": "Gibt es BSL-3-Containerlabore für die Hamburger Infektionsforschung?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Ja. Wir realisieren Containerlabore bis Schutzstufe BSL-3 mit Schleusenkonzept, Unterdruckführung, HEPA-Filtration und Autoklav-Integration – konform zu BioStoffV und TRBA 100. Für Hamburger Einrichtungen wie das BNITM oder das UKE ist das besonders relevant, da Erweiterungsbauten dort oft Jahre dauern."
      }
    },
    {
      "@type": "Question",
      "name": "Was kostet ein Laborcontainer für den Hamburger Markt?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Die Kosten variieren stark nach Ausstattung: Ein Basis-Analyselabor liegt in einer anderen Größenordnung als ein BSL-3-Container mit redundanter Lüftung. Für den Hamburger Markt kalkulieren wir auch den Korrosionsschutz und die Hafenlogistik mit ein. Sprechen Sie mit uns – wir nennen Ihnen nach der Bedarfsanalyse eine belastbare Größenordnung."
      }
    }
  ]
};

const localBusinessSchema = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "name": "Planexus GmbH – Laborcontainer Hamburg",
  "description": "Laborcontainer für Hamburg, Norddeutschland und die Metropolregion. Maritime Forschung, Life Sciences und Hafenanalytik.",
  "url": "https://www.planexus.de",
  "telephone": "+49 7435 7519 700",
  "email": "info@planexus.de",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "Am Steinbach 8",
    "addressLocality": "Albstadt",
    "postalCode": "72459",
    "addressCountry": "DE"
  },
  "areaServed": [
    { "@type": "City", "name": "Hamburg" },
    { "@type": "State", "name": "Schleswig-Holstein" },
    { "@type": "State", "name": "Niedersachsen" }
  ]
};
---

<Layout
  title="Laborcontainer Hamburg – Maritime Forschung & Hafenanalytik | Planexus GmbH"
  description="Containerlabore für Hamburgs Hafen, UKE, BNITM und DESY. Korrosionsgeschützt, BSL-2/BSL-3, 8–14 Wochen betriebsbereit. Ihr Fachplaner für norddeutsche Laborinfrastruktur."
  canonical="/laborcontainer-hamburg"
  schema={serviceSchema}
  ogImage="/attached_assets/Kopf_green-scaled_1768306688943.jpg"
>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} slot="head" />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} slot="head" />
  <script type="application/ld+json" set:html={JSON.stringify(localBusinessSchema)} slot="head" />

  <div class="pt-20 min-h-screen bg-white">

    <!-- Hero: Maritime Forschungsnarrative -->
    <section class="relative py-32 bg-slate-900 text-white overflow-hidden">
      <div class="absolute inset-0 bg-[url('https://images.unsplash.com/photo-1567016376408-0226e4d0c1ea?q=80&w=2070')] bg-cover bg-center opacity-15"></div>
      <div class="absolute inset-0 bg-gradient-to-r from-slate-900 via-slate-900/95 to-slate-900/80"></div>

      <div class="container mx-auto px-4 relative z-10">
        <div class="max-w-4xl">
          <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-white/10 text-primary text-sm font-medium mb-8 backdrop-blur-sm border border-white/10">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
            Hamburg & Metropolregion Nord
          </div>
          <h1 class="text-4xl md:text-6xl font-heading font-bold mb-6 leading-tight">
            Wo Hafen auf <span class="text-primary">Forschung</span> trifft
          </h1>
          <p class="text-xl md:text-2xl text-gray-300 mb-4 leading-relaxed max-w-3xl font-light">
            Hamburg ist Deutschlands Tor zur Welt – und einer der forschungsintensivsten Standorte Europas. Zwischen Elbphilharmonie und Containerterminal fehlt vor allem eines: flexible Laborfläche.
          </p>
          <p class="text-lg text-gray-400 mb-10 max-w-2xl">
            Wir bauen Labore, die das maritime Klima vertragen, Hafenbehörden überzeugen und in 8–14 Wochen betriebsbereit stehen.
          </p>
          <div class="flex flex-col sm:flex-row gap-4">
            <a href="/kontakt" class="bg-primary text-slate-900 font-bold px-8 py-4 rounded-lg hover:bg-primary/90 transition-colors flex items-center justify-center gap-2 group shadow-[0_0_20px_rgba(187,215,0,0.3)]">
              Hafenprojekt besprechen
              <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 group-hover:translate-x-1 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
            </a>
            <a href="tel:+4974357519700" class="border border-white/20 text-white font-medium px-8 py-4 rounded-lg hover:bg-white/10 transition-colors backdrop-blur-sm flex items-center justify-center gap-2">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
              +49 7435 7519 700
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- Breadcrumb -->
    <nav class="bg-gray-50 border-b border-gray-100 py-3">
      <div class="container mx-auto px-4">
        <ol class="flex items-center gap-2 text-sm text-gray-500">
          <li><a href="/" class="hover:text-primary transition-colors">Start</a></li>
          <li><svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg></li>
          <li class="text-primary font-medium">Laborcontainer Hamburg</li>
        </ol>
      </div>
    </nav>

    <!-- Section 1: Das Hamburger Dilemma — Problem-orientierter Einstieg -->
    <section class="py-20 bg-white">
      <div class="container mx-auto px-4">
        <div class="max-w-4xl mx-auto">
          <h2 class="text-3xl md:text-4xl font-heading font-bold mb-8 text-slate-900">
            7.200 Hektar Hafen, 44 Hochschulen – und chronischer Labormangel
          </h2>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-12">
            <div class="space-y-6 text-gray-600 text-lg leading-relaxed">
              <p>
                Hamburg vereint, was anderswo getrennt existiert: einen der größten Seehäfen Europas, ein dichtes Netz biomedizinischer Forschungseinrichtungen und eine wachsende Pharma- und Medtech-Industrie. Was fehlt, ist Laborfläche, die mit dem Tempo der Forschung Schritt hält.
              </p>
              <p>
                Am Universitätsklinikum Eppendorf (UKE) werden klinische Studien durch fehlende Laborkapazität gebremst. Am Bernhard-Nocht-Institut (BNITM) warten BSL-3-Projekte auf Erweiterungsflächen. Im Hafen mangelt es an mobilen Analyseeinheiten für Wasserproben, Ballastwasser und Gefahrgutkontrollen.
              </p>
            </div>
            <div class="space-y-6 text-gray-600 text-lg leading-relaxed">
              <p>
                Konventionelle Laborbauten brauchen in Hamburg 3–5 Jahre: Bauleitplanung, Architekturwettbewerb, Ausschreibung, Bau. Ein Laborcontainer von Planexus steht in 8–14 Wochen – betriebsfertig, normkonform und auf Wunsch rückstandsfrei rückbaubar.
              </p>
              <p>
                Für die Metropolregion – von Harburg bis Norderstedt, von Bergedorf bis Wedel – planen und fertigen wir Containerlabore, die exakt auf den Hamburger Bedarf zugeschnitten sind: salzluftresistent, hafentauglich und mit dem Anspruch, den die Hamburger Forschungslandschaft verdient.
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Section 2: Hafenanalytik — Hamburgs einzigartiger Use Case -->
    <section class="py-20 bg-slate-900 text-white">
      <div class="container mx-auto px-4">
        <div class="max-w-6xl mx-auto">
          <div class="grid grid-cols-1 lg:grid-cols-5 gap-12 items-start">
            <div class="lg:col-span-2">
              <span class="text-primary text-sm font-bold uppercase tracking-wider">Nur in Hamburg</span>
              <h2 class="text-3xl font-heading font-bold mt-3 mb-6">
                Hafenanalytik: Labore zwischen Kaikante und Containerbrücke
              </h2>
              <p class="text-gray-400 text-lg leading-relaxed mb-6">
                Der Hamburger Hafen bewegt jährlich rund 130 Millionen Tonnen Güter. Jedes Schiff, das anlegt, bringt potenziell kontaminiertes Ballastwasser, unbekannte Ladungsdämpfe oder meldepflichtige Gefahrstoffe mit. Die Analytik muss vor Ort stattfinden – schnell, verlässlich und unter kontrollierten Bedingungen.
              </p>
              <p class="text-gray-400 leading-relaxed">
                Mobile Labore im Hafengebiet analysieren Wasserproben nach dem Ballastwasser-Übereinkommen (BWM-Konvention), prüfen Luftqualität in Laderäumen und untersuchen Verdachtsproben bei Gefahrgut-Zwischenfällen. Die Anforderung: GLP-konforme Ergebnisse innerhalb von Stunden, nicht Tagen.
              </p>
            </div>
            <div class="lg:col-span-3 grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div class="bg-white/5 border border-white/10 rounded-xl p-6 hover:border-primary/30 transition-colors">
                <div class="w-10 h-10 bg-primary/10 rounded-lg flex items-center justify-center text-primary mb-4">
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 16.3c2.2 0 4-1.83 4-4.05 0-1.16-.57-2.26-1.71-3.19S7.29 6.75 7 5.3c-.29 1.45-1.14 2.84-2.29 3.76S3 11.1 3 12.25c0 2.22 1.8 4.05 4 4.05z"/><path d="M12.56 6.6A10.97 10.97 0 0 0 14 3.02c.5 2.5 2 4.9 4 6.5s3 3.5 3 5.5a6.98 6.98 0 0 1-11.91 4.97"/></svg>
                </div>
                <h3 class="font-bold text-lg mb-2">Ballastwasser-Analytik</h3>
                <p class="text-gray-400 text-sm">Probenahme und Auswertung nach BWM-Konvention direkt am Liegeplatz. Ergebnisse in unter 4 Stunden.</p>
              </div>
              <div class="bg-white/5 border border-white/10 rounded-xl p-6 hover:border-primary/30 transition-colors">
                <div class="w-10 h-10 bg-primary/10 rounded-lg flex items-center justify-center text-primary mb-4">
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10"/><path d="m9 12 2 2 4-4"/></svg>
                </div>
                <h3 class="font-bold text-lg mb-2">Gefahrgut-Screening</h3>
                <p class="text-gray-400 text-sm">Container-Atmosphäre, Ladungsprüfung und Stoffidentifikation bei Verdacht auf verbotene oder falsch deklarierte Güter.</p>
              </div>
              <div class="bg-white/5 border border-white/10 rounded-xl p-6 hover:border-primary/30 transition-colors">
                <div class="w-10 h-10 bg-primary/10 rounded-lg flex items-center justify-center text-primary mb-4">
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22c5.523 0 10-4.477 10-10S17.523 2 12 2 2 6.477 2 12s4.477 10 10 10z"/><path d="m2 12 5.1 5.1"/><path d="m22 12-5.1 5.1"/><path d="M8.56 2.75 12 12"/><path d="M15.44 2.75 12 12"/></svg>
                </div>
                <h3 class="font-bold text-lg mb-2">Umweltmonitoring</h3>
                <p class="text-gray-400 text-sm">Elbwasser-Analytik, Sedimentproben und Luftgütemessung im Hafengebiet – normkonform nach Bundes-Immissionsschutzgesetz.</p>
              </div>
              <div class="bg-white/5 border border-white/10 rounded-xl p-6 hover:border-primary/30 transition-colors">
                <div class="w-10 h-10 bg-primary/10 rounded-lg flex items-center justify-center text-primary mb-4">
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 18h8"/><path d="M3 22h18"/><path d="M14 22a7 7 0 1 0 0-14h-1"/><path d="M9 14h2"/><path d="M9 12a2 2 0 0 1-2-2V6h6v4a2 2 0 0 1-2 2Z"/><path d="M12 6V3a1 1 0 0 0-1-1H9a1 1 0 0 0-1 1v3"/></svg>
                </div>
                <h3 class="font-bold text-lg mb-2">Lebensmittelkontrolle</h3>
                <p class="text-gray-400 text-sm">Importkontrollen für Lebensmittel und Futtermittel am Hamburger Hafen – Mikrobiologie, Rückstandsanalytik, Sensorik.</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Section 3: Life-Science-Korridor Hamburg — Deep Dive in Forschungsstandorte -->
    <section class="py-20 bg-white">
      <div class="container mx-auto px-4">
        <div class="max-w-6xl mx-auto">
          <div class="text-center mb-16">
            <h2 class="text-3xl md:text-4xl font-heading font-bold mb-4 text-slate-900">
              Drei Forschungsachsen, ein gemeinsames Problem
            </h2>
            <p class="text-gray-600 text-lg max-w-3xl mx-auto">
              Hamburgs biomedizinische Forschung konzentriert sich auf drei Standorte – jeder mit eigenen Anforderungen an Laborinfrastruktur.
            </p>
          </div>

          <div class="space-y-8">
            <!-- UKE/Eppendorf -->
            <div class="bg-gradient-to-r from-slate-50 to-white rounded-2xl p-8 md:p-10 border border-gray-100">
              <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
                <div class="md:col-span-2">
                  <div class="flex items-center gap-3 mb-4">
                    <span class="bg-primary text-slate-900 text-xs font-bold px-3 py-1 rounded-full uppercase tracking-wider">Achse 1</span>
                    <span class="text-gray-400 text-sm">Hamburg-Eppendorf</span>
                  </div>
                  <h3 class="text-2xl font-heading font-bold text-slate-900 mb-4">UKE – Universitätsklinikum Hamburg-Eppendorf</h3>
                  <p class="text-gray-600 leading-relaxed mb-4">
                    Das UKE zählt mit über 80 Kliniken und Instituten zu den größten Universitätskliniken Europas. Im Bereich Infektiologie, Onkologie und Neurowissenschaften laufen permanente klinische Studien, die dedizierte Laborkapazitäten erfordern. Die bestehende Infrastruktur aus den 1990er-Jahren stößt an ihre Grenzen – Erweiterungsbauten sind geplant, aber nicht vor 2028 fertig.
                  </p>
                  <p class="text-gray-600 leading-relaxed">
                    Ein Laborcontainer auf dem UKE-Campusgelände schließt die Lücke: als Interimsforschungslabor während der Sanierung, als Erweiterung für klinische Studienlabore oder als eigenständiges BSL-2-Labor für die Infektionsforschung.
                  </p>
                </div>
                <div class="bg-white rounded-xl p-6 border border-gray-100 flex flex-col justify-center">
                  <div class="space-y-4 text-sm">
                    <div class="flex justify-between items-center"><span class="text-gray-500">Kliniken & Institute</span><span class="font-bold text-slate-900">80+</span></div>
                    <div class="border-t border-gray-100"></div>
                    <div class="flex justify-between items-center"><span class="text-gray-500">Mitarbeitende</span><span class="font-bold text-slate-900">~16.100</span></div>
                    <div class="border-t border-gray-100"></div>
                    <div class="flex justify-between items-center"><span class="text-gray-500">Klinische Studien/Jahr</span><span class="font-bold text-slate-900">~1.200</span></div>
                    <div class="border-t border-gray-100"></div>
                    <div class="flex justify-between items-center"><span class="text-gray-500">Typischer Bedarf</span><span class="font-bold text-primary">BSL-2, Reinraum</span></div>
                  </div>
                </div>
              </div>
            </div>

            <!-- BNITM -->
            <div class="bg-gradient-to-r from-slate-50 to-white rounded-2xl p-8 md:p-10 border border-gray-100">
              <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
                <div class="md:col-span-2">
                  <div class="flex items-center gap-3 mb-4">
                    <span class="bg-primary text-slate-900 text-xs font-bold px-3 py-1 rounded-full uppercase tracking-wider">Achse 2</span>
                    <span class="text-gray-400 text-sm">Hamburg-St. Pauli / Eppendorf</span>
                  </div>
                  <h3 class="text-2xl font-heading font-bold text-slate-900 mb-4">BNITM – Bernhard-Nocht-Institut für Tropenmedizin</h3>
                  <p class="text-gray-600 leading-relaxed mb-4">
                    Das BNITM ist Deutschlands größtes Institut für Tropenmedizin und eines der weltweit führenden Zentren für Erregerforschung. Hier werden Ebola-, Lassa- und SARS-CoV-2-Viren untersucht – unter strengsten Biosicherheitsauflagen. Die bestehenden BSL-4-Labore sind chronisch ausgelastet, Erweiterungen am historischen Standort an der Bernhard-Nocht-Straße sind baulich kaum möglich.
                  </p>
                  <p class="text-gray-600 leading-relaxed">
                    Containerlabore auf BSL-2- oder BSL-3-Niveau schaffen hier zusätzliche Kapazität für Diagnostik, Probenvorbereitung und Schulungen – ohne in die denkmalgeschützte Bausubstanz einzugreifen.
                  </p>
                </div>
                <div class="bg-white rounded-xl p-6 border border-gray-100 flex flex-col justify-center">
                  <div class="space-y-4 text-sm">
                    <div class="flex justify-between items-center"><span class="text-gray-500">Forschungsschwerpunkt</span><span class="font-bold text-slate-900">Tropenkrankheiten</span></div>
                    <div class="border-t border-gray-100"></div>
                    <div class="flex justify-between items-center"><span class="text-gray-500">Biosicherheitsstufen</span><span class="font-bold text-slate-900">BSL-2 bis BSL-4</span></div>
                    <div class="border-t border-gray-100"></div>
                    <div class="flex justify-between items-center"><span class="text-gray-500">WHO-Referenzlabor</span><span class="font-bold text-slate-900">Ja (Ebola, Lassa)</span></div>
                    <div class="border-t border-gray-100"></div>
                    <div class="flex justify-between items-center"><span class="text-gray-500">Typischer Bedarf</span><span class="font-bold text-primary">BSL-3, Diagnostik</span></div>
                  </div>
                </div>
              </div>
            </div>

            <!-- DESY -->
            <div class="bg-gradient-to-r from-slate-50 to-white rounded-2xl p-8 md:p-10 border border-gray-100">
              <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
                <div class="md:col-span-2">
                  <div class="flex items-center gap-3 mb-4">
