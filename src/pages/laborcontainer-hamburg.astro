const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Start", "item": "https://planexus.de/" },
    { "@type": "ListItem", "position": 2, "name": "Standorte", "item": "https://planexus.de/#standorte" },
    { "@type": "ListItem", "position": 3, "name": "Laborcontainer Hamburg", "item": "https://planexus.de/laborcontainer-hamburg" }
  ]
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Was kostet ein Laborcontainer in Hamburg?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Die Investition richtet sich nach Sicherheitsstufe, Reinraumklasse und Hafenklima-Ausstattung. Ein Analytikcontainer für Bahrenfeld liegt in einer anderen Größenordnung als ein BSL-3-Container mit HEPA-H14-Schleuse für ein Universitätsklinikum oder eine tropenmedizinische Forschungseinrichtung. Wir kalkulieren projektspezifisch – inklusive C5-M-Korrosionsschutz, ggf. Warftaufständerung in der HafenCity und HBauO-Statik. Senden Sie uns Ihre Standortdaten, wir melden uns binnen 24 Stunden mit einer indikativen Spanne."
      }
    },
    {
      "@type": "Question",
      "name": "Brauche ich für die HafenCity eine Sondergenehmigung der Hamburg Port Authority?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Ja. Innerhalb der Hafenflächen ist die Hamburg Port Authority (HPA) zuständig statt des regulären Bezirksamts. Da die HafenCity nur etwa 1 m über NHN liegt, das Bemessungshochwasser aber 7,30 m über NHN beträgt, ist die Aufstellung an eine Warftaufständerung von mindestens +1,30 m gekoppelt. Wir liefern den Container vorbereitet und stimmen die Statik mit HPA und LSBG ab."
      }
    },
    {
      "@type": "Question",
      "name": "Wie lange dauert die Lieferung eines Laborcontainers von Albstadt nach Hamburg?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Die Strecke beträgt rund 720 km – per Schwerlasttransport über A81 nordwärts, A6 ostwärts und A7 nordwärts via Würzburg, Kassel und Hannover bis Anschlussstelle Hamburg-Stillhorn oder Hamburg-Heimfeld. Reine Fahrzeit ca. 7 Stunden, mit Genehmigungspflicht und Begleitfahrzeugen typischerweise ein Transporttag. Vom Auftrag bis zur betriebsbereiten Übergabe in Hamburg vergehen 8 bis 14 Wochen."
      }
    },
    {
      "@type": "Question",
      "name": "Hält ein Laborcontainer der Salzluft im Hamburger Hafen stand?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Standard-Bürocontainer halten dem Hamburger Hafenklima nicht dauerhaft stand. Wir fertigen Laborcontainer für Hafenstandorte in Korrosivitätskategorie C5-M (Marine) nach DIN EN ISO 12944-2 – mit Edelstahl-Außenpaneelen oder Duplex-Beschichtung, geschlossenen Schweißnähten und EPDM-Dichtprofilen, die der maritimen Westwindlage und 78 % Jahresluftfeuchte standhalten. Auf Wunsch mit 25 Jahren Korrosionsgarantie."
      }
    },
    {
      "@type": "Question",
      "name": "Kann Planexus einen Laborcontainer auf einem Hamburger Universitätsklinikum oder Forschungscampus Bahrenfeld aufstellen?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Ja. Auf dem Universitätsklinik-Gelände in Eppendorf koordinieren wir mit dem jeweiligen Klinikbauamt – dort sind Brandschutz nach KhBauVO Hamburg und sterile Logistik kritisch. Auf dem Forschungscampus Bahrenfeld ist Vibrationsentkopplung Klasse VC-D nach VDI 2038 maßgebend, da Synchrotron-Strahlungsquellen, Forschungslaser und Freie-Elektronen-Laser-Anlagen Schwingungstoleranzen unter 1 µm/s verlangen. Wir stellen mit Federkern-Lagerung auf, kein Direktkontakt zur Forschungs-Bodenplatte."
      }
    },
    {
      "@type": "Question",
      "name": "Welche Auflagen gelten für BSL-3-Container in Hamburg?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "BSL-3 in Hamburg verlangt Genehmigung nach BioStoffV (Bundesrecht) sowie Anzeige bei der BUKEA (Behörde für Umwelt, Klima, Energie und Agrarwirtschaft) und gegebenenfalls dem Hamburger Gesundheitsamt. Technisch fordert der Verordnungsgeber: Unterdruckkaskade min. -50 Pa, HEPA-H14 im Abluftstrang, autoklavierte Schleusen, redundante Lüftung. Unsere Container werden vor Auslieferung gemäß TRBA 100 geprüft und mit IQ/OQ/PQ übergeben."
      }
    },
    {
      "@type": "Question",
      "name": "Mieten oder kaufen – was lohnt sich für ein Hamburger Pharma- oder Forschungsprojekt?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Faustregel: Bei Projektlaufzeiten unter 24 Monaten – etwa Interimslösungen während Klinik-Sanierungen oder befristete tropenmedizinische Forschungsprojekte – rechnet sich Miete. Bei dauerhafter Erweiterung am Standort Bahrenfeld, Hammerbrook oder im Pharma-Cluster Eimsbüttel überwiegt der Kauf, oft mit Mietkauf-Option. Wir vergleichen für Ihr Hamburger Projekt beide Modelle inklusive Bilanzwirkung und Restwert."
      }
    }
  ]
};
---

<Layout
  title="Laborcontainer Hamburg | BSL-3, C5-M Hafenklima | Planexus"
  description="Laborcontainer Hamburg: LABtoGO, BSL-3, C5-M-Salzluftschutz, VC-D für DESY/XFEL Bahrenfeld. Lieferung A7. Schlüsselfertig in 12 Wochen."
  canonical="/laborcontainer-hamburg"
  schema={serviceSchema}
  ogImage="/attached_assets/Laborcontainer_001_1769688326918.jpg"
>
  <script type="application/ld+json" set:html={JSON.stringify(localBusinessSchema)} slot="head" />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} slot="head" />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} slot="head" />

  <div class="pt-20 min-h-screen bg-white">

    <!-- STICKY SIDE-CTA (desktop only) -->
    <aside class="hidden xl:block fixed right-6 top-1/2 -translate-y-1/2 z-40 w-60">
      <div class="bg-white rounded-2xl shadow-2xl border border-gray-200 overflow-hidden">
        <div class="bg-slate-900 px-5 py-3">
          <div class="text-primary text-xs font-bold uppercase tracking-wider">Standort Hamburg</div>
        </div>
        <div class="p-5 space-y-3 text-sm">
          <p class="text-gray-700 leading-snug">Werk Albstadt – Lieferung in 8–14 Wochen via A81/A6/A7. Kostenfreies Standort-Audit für Ihr Containerlabor.</p>
          <a href="#anfrage" class="block bg-primary text-slate-900 font-bold text-center py-3 rounded-lg hover:bg-primary/90 transition-colors text-sm">Anfrage starten</a>
          <a href="tel:+4974357519700" class="block text-center text-xs text-slate-600 hover:text-primary transition-colors">+49 7435 7519 700</a>
        </div>
      </div>
    </aside>

    <!-- HERO -->
    <section class="relative py-24 md:py-32 bg-slate-900 text-white overflow-hidden">
      <div class="absolute inset-0">
        <Picture src="/attached_assets/Laborcontainer_001_1769688326918.jpg" alt="Laborcontainer Hamburg – Planexus LABtoGO mit 2,75 m Innenhöhe für HafenCity, UKE Eppendorf und Forschungscampus Bahrenfeld" class="w-full h-full object-cover opacity-20" loading="eager" fetchpriority="high" />
      </div>
      <div class="absolute inset-0 bg-gradient-to-r from-slate-900 via-slate-900/95 to-slate-900/70"></div>

      <div class="container mx-auto px-4 relative z-10">
        <div class="max-w-3xl">
          <nav class="flex items-center gap-2 text-sm text-gray-400 mb-8" aria-label="Breadcrumb">
            <a href="/" class="hover:text-primary transition-colors">Start</a>
            <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m9 18 6-6-6-6"/></svg>
            <span>Standorte</span>
            <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m9 18 6-6-6-6"/></svg>
            <span class="text-primary">Hamburg</span>
          </nav>

          <div class="text-primary font-medium text-sm uppercase tracking-wider mb-4">Ihr Spezialist für Laborcontainer · Metropolregion Hamburg</div>

          <h1 class="text-4xl md:text-5xl lg:text-6xl font-heading font-bold mb-6 leading-tight">
            Laborcontainer Hamburg – salzwasserfeste BSL-3-Labore für Hafenklima und Sturmflutgebiet
          </h1>

          <p class="text-xl text-gray-300 leading-relaxed mb-4">
            <strong class="text-white">Ihr Fachplaner für Containerlabore mit mehr als 10 Jahren Erfahrung.</strong> Intelligent, nachhaltig und modular. Wir realisieren flexible Forschungsumgebungen für die Zukunft – aus dem Werk Albstadt direkt nach Hamburg, über A81 / A6 / A7.
          </p>
          <p class="text-base text-gray-400 mb-8">
            Während andere noch planen, forschen Sie bereits.
          </p>

          <div class="flex flex-col sm:flex-row gap-4 mb-8">
            <a href="#anfrage" class="bg-primary text-slate-900 font-bold px-8 py-4 rounded-lg hover:bg-primary/90 transition-colors inline-flex items-center justify-center gap-2 shadow-[0_0_20px_rgba(132,189,0,0.3)]">
              Kostenfreies Standort-Audit Hamburg
              <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
            </a>
            <a href="tel:+4974357519700" class="border border-white/20 text-white font-medium px-8 py-4 rounded-lg hover:bg-white/10 transition-colors inline-flex items-center justify-center gap-2">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
              +49 7435 7519 700
            </a>
          </div>

          <div class="flex flex-wrap items-center gap-x-6 gap-y-2 text-sm text-gray-400">
            <div class="flex items-center gap-2"><svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6 9 17l-5-5"/></svg>Pioniere im Modulbau seit 2016</div>
            <div class="flex items-center gap-2"><svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6 9 17l-5-5"/></svg>Award 2026 EU Business News</div>
            <div class="flex items-center gap-2"><svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6 9 17l-5-5"/></svg>C5-M Hafenklima ab Werk</div>
            <div class="flex items-center gap-2"><svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6 9 17l-5-5"/></svg>Wesemann-Gruppe · 60+ Jahre Laborbau</div>
          </div>
        </div>
      </div>
    </section>

    <AuthorBio city="Hamburg" />


    <!-- PATTERN-INTERRUPT: LABtoGO -->
    <section class="py-16 md:py-20 bg-gradient-to-br from-primary/5 via-white to-primary/10 border-y border-primary/20">
      <div class="container mx-auto px-4">
        <div class="max-w-5xl mx-auto">
          <div class="grid md:grid-cols-2 gap-10 items-center mb-10">
            <div>
              <div class="text-primary font-bold text-sm uppercase tracking-wider mb-3">Pattern-Interrupt · Weltpremiere analytica 2026</div>
              <h2 class="text-3xl md:text-4xl font-heading font-bold mb-4 text-slate-900">Planexus zeigt Hamburg, was ein Laborcontainer 2026 wirklich kann</h2>
              <p class="text-lg text-gray-700 leading-relaxed mb-4">
                Ein gewöhnlicher Laborcontainer hat 2.400 mm Innenhöhe. Sie passen rein – aufrecht arbeiten unter einem Abzug aber kaum.
              </p>
              <p class="text-lg text-slate-900 font-bold leading-relaxed mb-4">
                Der LABtoGO von Planexus hat 2.750 mm Innenhöhe. 9,5 m Außenlänge. 3 m Außenbreite. Vollverglaste Front, die echtes Tageslicht in jedes Hamburger Hafen-, Klinik- oder Forschungslabor bringt.
              </p>
              <p class="text-lg text-gray-700 leading-relaxed">
                <strong>Ein gewöhnlicher Laborcontainer passt komplett in einen LABtoGO hinein.</strong> Wir nennen ihn nicht ohne Grund LABtoGO – er ist die Plattform, auf der wir für Hamburg BSL-2, BSL-3, GMP-Reinraum, C5-M-Hafenklima und VC-D-Vibrationsentkopplung konfigurieren.
              </p>
            </div>
            <div class="grid grid-cols-2 gap-4">
              <div class="bg-slate-900 text-white rounded-2xl p-6 text-center">
                <div class="text-4xl font-bold text-primary mb-1">2.750</div>
                <div class="text-xs text-gray-400 uppercase tracking-wider">mm Innenhöhe</div>
                <div class="text-xs text-gray-500 mt-1">Standard: 2.400 mm</div>
              </div>
              <div class="bg-slate-900 text-white rounded-2xl p-6 text-center">
                <div class="text-4xl font-bold text-primary mb-1">9.500</div>
                <div class="text-xs text-gray-400 uppercase tracking-wider">mm Außenlänge</div>
                <div class="text-xs text-gray-500 mt-1">3.000 mm Breite</div>
              </div>
              <div class="bg-slate-900 text-white rounded-2xl p-6 text-center">
                <div class="text-4xl font-bold text-primary mb-1">100%</div>
                <div class="text-xs text-gray-400 uppercase tracking-wider">vollverglast</div>
                <div class="text-xs text-gray-500 mt-1">Tageslicht-Labor</div>
              </div>
              <div class="bg-slate-900 text-white rounded-2xl p-6 text-center">
                <div class="text-4xl font-bold text-primary mb-1">U 0,20</div>
                <div class="text-xs text-gray-400 uppercase tracking-wider">W/m²K Sandwich</div>
                <div class="text-xs text-gray-500 mt-1">80–120 mm Dämmung</div>
              </div>
            </div>
          </div>
          <div class="text-center">
            <a href="/laborcontainer/labtogo" class="inline-flex items-center gap-2 text-primary font-bold hover:underline">
              LABtoGO Plattform und alle Konfigurationen ansehen
              <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- PROBLEM-AGITATION -->
    <section class="py-16 md:py-20">
      <div class="container mx-auto px-4">
        <div class="max-w-5xl mx-auto">
          <h2 class="text-3xl md:text-4xl font-heading font-bold mb-10 text-slate-900">
            Planexus löst die drei Hamburger Engpässe, an denen Laborprojekte regelmäßig scheitern
          </h2>
          <div class="grid md:grid-cols-3 gap-6">
            <div class="bg-slate-50 border-l-4 border-primary rounded-xl p-6">
              <div class="text-slate-900 font-bold text-lg mb-2">HafenCity-Sturmflut macht Standardstatik zur Fehlplanung</div>
              <p class="text-gray-700 text-sm leading-relaxed">Die HafenCity liegt nur etwa 1 m über NHN. Das Bemessungshochwasser beträgt 7,30 m über NHN. Wer Container ohne Warftaufständerung auf mindestens +1,30 m plant, bekommt von der Hamburg Port Authority keine Aufstellungsgenehmigung – Sturmflutsaison Oktober bis März verbietet alles andere.</p>
              <p class="text-sm text-slate-900 font-semibold mt-3 pt-3 border-t border-gray-200">Planexus-Antwort: HPA-konforme Warftaufständerung ab Werk vorbereitet.</p>
            </div>
            <div class="bg-slate-50 border-l-4 border-primary rounded-xl p-6">
              <div class="text-slate-900 font-bold text-lg mb-2">HBauO + HPA + BUKEA – drei Behörden, ein Antrag</div>
              <p class="text-gray-700 text-sm leading-relaxed">Hamburg ist die einzige deutsche Großstadt, in der drei Behörden für ein einziges Labor-Containerprojekt zuständig sein können: HBauO über das Bezirksamt, HPA in Hafenflächen, BUKEA bei BSL-3. Ein einziger Formfehler bedeutet zwei bis drei Wochen Stillstand pro Behörde.</p>
              <p class="text-sm text-slate-900 font-semibold mt-3 pt-3 border-t border-gray-200">Planexus-Antwort: Verfahrenstaugliche Bauvorlagen für alle drei Behörden gleichzeitig.</p>
            </div>
            <div class="bg-slate-50 border-l-4 border-primary rounded-xl p-6">
              <div class="text-slate-900 font-bold text-lg mb-2">Salzluft zerstört Standardcontainer in 18 Monaten</div>
              <p class="text-gray-700 text-sm leading-relaxed">Westwindlage, 78 % Jahresluftfeuchte, Salzaerosol vom Hafen. Wer einen verzinkten Bürocontainer als Labor in der HafenCity, in Bahrenfeld oder in Wilhelmsburg aufstellt, sieht nach 18 Monaten Korrosionsfraß an den Schweißnähten – Messgeräte verlieren Präzision, Reinraumklassen sind nicht mehr zertifizierbar.</p>
              <p class="text-sm text-slate-900 font-semibold mt-3 pt-3 border-t border-gray-200">Planexus-Antwort: C5-M nach DIN EN ISO 12944-2 ab Werk – Edelstahl, Duplex, EPDM.</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- STRATEGISCHE FUSION INTRO -->
    <section class="py-16 md:py-20 bg-slate-50">
      <div class="container mx-auto px-4">
        <div class="max-w-4xl mx-auto">
          <h2 class="text-3xl md:text-4xl font-heading font-bold mb-8 text-slate-900">
            Laborcontainer für Hamburg: Was Hafenklima, Sturmflutstatik und Forschungs-Vibrationen vom Engineering verlangen
          </h2>
