    "addressLocality": "Albstadt",
    "postalCode": "72459",
    "addressRegion": "Baden-Württemberg",
    "addressCountry": "DE"
  },
  "areaServed": {
    "@type": "City",
    "name": "Hamburg",
    "containedInPlace": [
      { "@type": "AdministrativeArea", "name": "Hamburg-Mitte" },
      { "@type": "AdministrativeArea", "name": "Altona" },
      { "@type": "AdministrativeArea", "name": "Eimsbüttel" },
      { "@type": "AdministrativeArea", "name": "Hamburg-Nord" },
      { "@type": "AdministrativeArea", "name": "Wandsbek" },
      { "@type": "AdministrativeArea", "name": "Bergedorf" },
