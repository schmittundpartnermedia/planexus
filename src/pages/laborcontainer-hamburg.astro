const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": "Laborcontainer Hamburg – LABtoGO, BSL-2/3, GMP-Reinraum & Hafenklima",
  "description": "Schlüsselfertige Laborcontainer für Hamburg und die Metropolregion. LABtoGO mit 2.750 mm Innenhöhe, BSL-2/3, GMP-Reinraum, C5-M-Hafenklima-Konfiguration und VC-D-Vibrationsentkopplung für DESY/XFEL Bahrenfeld. Lieferung über A81/A6/A7 ab Werk Albstadt – 720 km. Pioniere im modularen Laborbau seit 2016, ausgezeichnet bei den German CEO Excellence Awards 2026.",
  "provider": {
    "@type": "Organization",
    "name": "Planexus GmbH",
    "image": "https://planexus.de/android-chrome-512x512.png",
    "url": "https://planexus.de",
    "parentOrganization": { "@type": "Organization", "name": "Wesemann Holding GmbH" }
  },
  "serviceType": [
    "Laborcontainer Hamburg",
    "Containerlabor Hamburg",
    "Mobiles Labor Hamburg",
    "BSL-2 Containerlabor",
    "BSL-3 Containerlabor",
    "GMP-Reinraumlabor",
    "Reinraum-Container",
    "Modulbau Labor",
    "Technische Fachplanung Labor",
    "Laborausstattung",
    "Smart Lab Integration"
  ],
  "areaServed": [
    { "@type": "City", "name": "Hamburg", "containedInPlace": { "@type": "State", "name": "Freie und Hansestadt Hamburg" } },
    { "@type": "State", "name": "Hamburg" },
