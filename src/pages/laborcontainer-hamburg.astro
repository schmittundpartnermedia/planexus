const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Start", "item": "https://www.planexus.de/" },
    { "@type": "ListItem", "position": 2, "name": "Standorte", "item": "https://www.planexus.de/#standorte" },
    { "@type": "ListItem", "position": 3, "name": "Laborcontainer Hamburg", "item": "https://www.planexus.de/laborcontainer-hamburg" }
  ]
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Was kostet ein Laborcontainer in Hamburg?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Die Investition für einen Laborcontainer in Hamburg richtet sich nach Sicherheitsstufe, Reinraumklasse und Hafenklima-Ausstattung. Ein Analytikcontainer für Bahrenfeld liegt in einer anderen Größenordnung als ein BSL-3-Container mit HEPA-H14-Schleuse für das Universitätsklinikum oder das tropenmedizinische Forschungseinrichtungen. Wir kalkulieren projektspezifisch – inklusive Korrosionsschutz für Salzluft, ggf. Warftaufständerung in der HafenCity und HBauO-Statik. Senden Sie uns Ihre Standortdaten, wir melden uns binnen 24 Stunden mit einer indikativen Spanne."
      }
    },
    {
      "@type": "Question",
      "name": "Brauche ich für die HafenCity eine Sondergenehmigung der Hamburg Port Authority?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Ja. Innerhalb der Hafenflächen ist die Hamburg Port Authority (HPA) zuständig statt des regulären Bezirksamts. Da die HafenCity nur etwa 1 Meter über Normalhöhennull (NHN) liegt, das Bemessungshochwasser aber 7,30 m über NHN beträgt, ist die Aufstellung von Laborcontainern an eine Warftaufständerung von mindestens +1,30 m gekoppelt. Wir liefern den Container vorbereitet und stimmen die Statik mit der HPA und dem Landesbetrieb Straßen, Brücken und Gewässer (LSBG) ab."
      }
    },
    {
      "@type": "Question",
      "name": "Wie lange dauert die Lieferung eines Laborcontainers von Albstadt nach Hamburg?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Die Strecke vom Werk Albstadt nach Hamburg beträgt rund 720 km – per Schwerlasttransport über A81 nordwärts, A6 ostwärts und A7 nordwärts via Würzburg, Kassel und Hannover bis zur Anschlussstelle Hamburg-Stillhorn oder Hamburg-Heimfeld. Reine Fahrzeit ca. 7 Stunden, mit Genehmigungspflichten und Begleitfahrzeugen typischerweise ein Transporttag. Aufstellung per Mobilkran erfolgt direkt am Folgetag. Vom Auftrag bis zur betriebsbereiten Übergabe in Hamburg vergehen 8 bis 14 Wochen."
      }
    },
    {
      "@type": "Question",
      "name": "Hält ein Laborcontainer der Salzluft im Hamburger Hafen stand?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Standard-Bürocontainer halten dem Hamburger Hafenklima nicht dauerhaft stand. Wir fertigen Laborcontainer für Hafenstandorte in Korrosivitätskategorie C5-M (Marine) nach DIN EN ISO 12944-2 – mit Edelstahl-Außenpaneelen oder Duplex-Beschichtung, geschlossenen Schweißnähten und Gummidichtprofilen, die der maritimen Westwindlage und einer Jahresluftfeuchte von rund 78 Prozent standhalten. Auf Wunsch mit 25 Jahren Korrosionsgarantie."
      }
    },
    {
      "@type": "Question",
      "name": "Kann Planexus einen Laborcontainer auf dem einem Hamburger Universitätsklinikum oder Forschungscampus Bahrenfeld aufstellen?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Ja. Aufstellungen auf dem Universitätsklinik-Gelände in Eppendorf koordinieren wir über das das jeweilige Klinikbauamt – dort ist Brandschutz nach Krankenhaushausverordnung Hamburg und sterile Logistik kritisch. Auf dem Forschungscampus Bahrenfeld ist Vibrationsentkopplung Klasse VC-D nach VDI 2038 maßgebend, da die Synchrotron-Halle Schwingungen unter 1 µm/s verlangt. Wir stellen entkoppelt mit Federkern-Lagerung auf, kein Direktkontakt zur Forschungs-Bodenplatte."
      }
    },
    {
      "@type": "Question",
      "name": "Welche Auflagen gelten für BSL-3-Container in Hamburg?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "BSL-3 in Hamburg verlangt Genehmigung nach BioStoffV (Bundesrecht) sowie Anzeige bei der BUKEA (Behörde für Umwelt, Klima, Energie und Agrarwirtschaft) und gegebenenfalls dem Hamburger Gesundheitsamt. Technisch fordern wir und der Verordnungsgeber: Unterdruckkaskade min. -50 Pa, HEPA-H14-Filter im Abluftstrang, autoklavierte Schleusen, redundante Lüftung. Unsere Container werden vor Auslieferung gemäß TRBA 100 geprüft und mit IQ/OQ/PQ-Dokumentation übergeben."
      }
    },
    {
      "@type": "Question",
      "name": "Mieten oder kaufen – was lohnt sich für ein Hamburger Pharma- oder Forschungsprojekt?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Faustregel: Bei Projektlaufzeiten unter 24 Monaten – etwa Interimslösungen während Klinik-Sanierungen oder befristete tropenmedizinische Forschungsprojekte – rechnet sich Miete. Bei dauerhafter Erweiterung am Standort Bahrenfeld, Hammerbrook oder im Pharma-Cluster Eimsbüttel überwiegt der Kauf, oft mit Mietkauf-Option. Wir vergleichen für Ihr Hamburger Projekt beide Modelle inklusive Bilanzwirkung und Restwert nach Bundesnetzagentur-AfA."
      }
    }
  ]
};
---

<Layout
  title="Laborcontainer Hamburg | BSL-3 schlüsselfertig in 12 Wochen"
  description="Laborcontainer für Hamburg: BSL-3, GMP & Reinraum für Pharma, Klinik und Forschung. Salzluft-tauglich, HBauO-konform. 720 km Lieferung via A81/A7. Jetzt anfragen."
  canonical="/laborcontainer-hamburg"
  schema={serviceSchema}
  ogImage="/attached_assets/Laborcontainer_001_1769688326918.jpg"
>
  <script type="application/ld+json" set:html={JSON.stringify(localBusinessSchema)} slot="head" />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} slot="head" />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} slot="head" />

  <div class="pt-20 min-h-screen bg-white">

    <!-- HERO -->
    <section class="relative py-24 md:py-32 bg-slate-900 text-white overflow-hidden">
      <div class="absolute inset-0">
        <img src="/attached_assets/Laborcontainer_001_1769688326918.jpg" alt="Laborcontainer Hamburg HafenCity – Planexus GmbH, salzluft-taugliches BSL-3-Containerlabor" class="w-full h-full object-cover opacity-20" loading="eager" />
      </div>
      <div class="absolute inset-0 bg-gradient-to-r from-slate-900 via-slate-900/95 to-slate-900/70"></div>

      <div class="container mx-auto px-4 relative z-10">
        <div class="max-w-3xl">
          <nav class="flex items-center gap-2 text-sm text-gray-400 mb-8" aria-label="Breadcrumb">
            <a href="/" class="hover:text-primary transition-colors">Start</a>
            <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m9 18 6-6-6-6"/></svg>
            <span>Standorte</span>
            <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m9 18 6-6-6-6"/></svg>
            <span class="text-primary">Hamburg</span>
          </nav>

          <h1 class="text-4xl md:text-5xl lg:text-6xl font-heading font-bold mb-6 leading-tight">
            Laborcontainer Hamburg <span class="text-primary">|</span> BSL-3, GMP & Reinraum für Pharma, Klinik und Forschung
          </h1>
          <p class="text-xl text-gray-300 leading-relaxed mb-8">
            Schlüsselfertige Containerlabore für Hamburgs Pharma-, Klinik- und Forschungslandschaft. Salzluft-tauglich nach DIN EN ISO 12944-2 (C5-M), HBauO-konform, geliefert über A81/A7 ab Werk Albstadt – betriebsbereit in 8 bis 14 Wochen.
          </p>

          <div class="flex flex-col sm:flex-row gap-4 mb-8">
            <a href="#anfrage" class="bg-primary text-slate-900 font-bold px-8 py-4 rounded-lg hover:bg-primary/90 transition-colors inline-flex items-center justify-center gap-2 shadow-[0_0_20px_rgba(132,189,0,0.3)]">
              Hamburger Projekt anfragen
              <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
            </a>
            <a href="tel:+4974357519700" class="border border-white/20 text-white font-medium px-8 py-4 rounded-lg hover:bg-white/10 transition-colors inline-flex items-center justify-center gap-2">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
              +49 7435 7519 700
            </a>
          </div>

          <div class="flex flex-wrap items-center gap-6 text-sm text-gray-400">
            <div class="flex items-center gap-2">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10"/><path d="m9 12 2 2 4-4"/></svg>
              C5-M Salzluft-Korrosionsschutz
            </div>
            <div class="flex items-center gap-2">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10"/><path d="m9 12 2 2 4-4"/></svg>
              HBauO §63 + HPA-erprobt
            </div>
            <div class="flex items-center gap-2">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10"/><path d="m9 12 2 2 4-4"/></svg>
              Teil der Wesemann Holding
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- PROBLEM-AGITATION -->
    <section class="py-16 md:py-20">
      <div class="container mx-auto px-4">
        <div class="max-w-4xl mx-auto">
          <h2 class="text-3xl md:text-4xl font-heading font-bold mb-8 text-slate-900">
            Laborcontainer in Hamburg: 3 Hürden, an denen Pharma- und Forschungsprojekte regelmäßig hängenbleiben
          </h2>
          <div class="grid md:grid-cols-3 gap-6 mb-10">
            <div class="bg-red-50 border border-red-100 rounded-xl p-6">
              <div class="text-red-600 font-bold text-lg mb-2">HBauO-Marathon im Bezirksamt</div>
              <p class="text-gray-600 text-sm">Sieben Bezirksämter, jedes mit eigenem Fachamt Bauprüfung. Für die HafenCity zusätzlich die Hamburg Port Authority. Zwischen Voranfrage, Statik nach HBauO §63 und Brandschutzkonzept vergehen für klassische Massivbauten in Hamburg häufig 18 bis 24 Monate.</p>
            </div>
            <div class="bg-red-50 border border-red-100 rounded-xl p-6">
              <div class="text-red-600 font-bold text-lg mb-2">Flächen am Universitätsklinikum und in Bahrenfeld unbezahlbar</div>
              <p class="text-gray-600 text-sm">Auf dem einem Hamburger Universitätsklinikum, im Innovationspark Altona und auf dem Forschungscampus Bahrenfeld zählt jeder Quadratmeter. Laborflächen in Hamburg gehören mit über 22 €/m²/Monat zu den teuersten in Deutschland – Neubau bedeutet jahrelange Bindung knapper Areale.</p>
            </div>
            <div class="bg-red-50 border border-red-100 rounded-xl p-6">
              <div class="text-red-600 font-bold text-lg mb-2">Hafenklima zerstört Standardcontainer</div>
              <p class="text-gray-600 text-sm">Westwind, 78 % Jahresluftfeuchte und Salzaerosol aus dem Hafenbecken setzen Standard-Bürocontainer in unter 5 Jahren außer Betrieb. Wer in Speicherstadt, HafenCity oder Steinwerder mit handelsüblicher Beschichtung baut, baut zweimal.</p>
            </div>
          </div>

          <div class="bg-slate-900 text-white rounded-2xl p-8 md:p-10">
            <div class="flex items-start gap-4">
              <div class="w-12 h-12 bg-primary rounded-lg flex items-center justify-center shrink-0">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-slate-900" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10"/><path d="m9 12 2 2 4-4"/></svg>
              </div>
              <div>
                <div class="text-xl font-bold mb-2">Die Antwort: Containerlabore, gebaut für Hamburg</div>
                <p class="text-gray-300">Planexus liefert Laborcontainer, deren Engineering die Hamburger Standortbedingungen einrechnet – Korrosionsschutz nach C5-M für Hafenflächen, Warftaufständerung für die HafenCity, BSL-3-Schleusenkonzept abgestimmt auf tropenmedizinische Forschungsinstitute- und klinikspezifische Anforderungen, Vibrationsentkopplung für großforschungsnahe Analytik. Schlüsselfertig in 8 bis 14 Wochen, ab Werk Albstadt direkt über A81/A7.</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- STRATEGISCHE FUSION INTRO -->
    <section class="py-16 md:py-20 bg-slate-50 border-y border-gray-100">
      <div class="container mx-auto px-4">
        <div class="max-w-4xl mx-auto">
          <h2 class="text-3xl md:text-4xl font-heading font-bold mb-6 text-slate-900">
            Warum ein Laborcontainer in Hamburg anders gebaut werden muss als in München oder Stuttgart
          </h2>
          <div class="space-y-4 text-gray-700 text-lg leading-relaxed">
            <p>Hamburgs Life-Science-Cluster umfasst rund <strong>600 Unternehmen mit über 55.000 Beschäftigten</strong> – verteilt auf einen Standort, der drei Besonderheiten gleichzeitig aufweist: maritime Klimazone, tide-beeinflusstes Norddeutsches Tiefland und siebengeteilte Bezirksverwaltung. Wer hier ein Containerlabor plant, muss die Hardware an diese Realität anpassen, nicht umgekehrt.</p>
            <p>Aufgrund der dauerhaften Westwindlage über der Elbe und der daraus resultierenden Salzbelastung an Speicherstadt, HafenCity und Steinwerder dimensionieren wir Außenpaneele und Dichtsysteme nach <strong>Korrosionsschutzklasse C5-M (DIN EN ISO 12944-2)</strong> – derselben Kategorie, die für Offshore-Anlagen verwendet wird. Aufgrund der Höhenlage der HafenCity bei nur etwa 1 m über NHN bei einem Bemessungshochwasser von 7,30 m über NHN setzen wir Container dort grundsätzlich auf <strong>Warftfundamente mit +1,30 m Aufständerung</strong>. Aufgrund der Forschungsdichte an das Hamburger Universitätsklinikum in Eppendorf, tropenmedizinische Institute in St. Pauli und Großforschung in Bahrenfeld liefern wir BSL-3-Schleusenkonzepte, die mit dem jeweiligen Sicherheitsbeauftragten abstimmbar sind.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- 3x2 TECHNICAL DEPTH MATRIX -->
    <section class="py-16 md:py-20">
      <div class="container mx-auto px-4">
        <div class="max-w-6xl mx-auto">
          <h2 class="text-3xl md:text-4xl font-heading font-bold mb-4 text-slate-900">
            Laborcontainer Hamburg: 6 Engineering-Disziplinen für Hamburger Standortbedingungen
          </h2>
          <p class="text-gray-600 text-lg mb-12">Jede Disziplin lösen wir mit einer konkreten technischen Antwort, abgestimmt auf einen real existierenden Hamburger Mikrostandort.</p>

          <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
            <div class="bg-white border border-gray-100 rounded-xl p-6 hover:shadow-xl hover:border-primary/30 transition-all">
              <div class="text-xs font-bold text-[#7a9900] uppercase tracking-wider mb-2">01 · Korrosionsschutz</div>
              <h3 class="font-bold text-slate-900 text-lg mb-2">C5-M nach DIN EN ISO 12944-2</h3>
              <p class="text-gray-600 text-sm mb-3">Edelstahl-Außenpaneele, Duplex-Beschichtung, geschlossene Schweißnähte mit EPDM-Dichtungen.</p>
              <p class="text-xs text-gray-500"><strong class="text-slate-900">Hamburg-Bezug:</strong> Salzaerosol HafenCity, Speicherstadt, Steinwerder – getestet im Hamburger Hafenklima.</p>
            </div>

            <div class="bg-white border border-gray-100 rounded-xl p-6 hover:shadow-xl hover:border-primary/30 transition-all">
              <div class="text-xs font-bold text-[#7a9900] uppercase tracking-wider mb-2">02 · Hochwasserschutz</div>
              <h3 class="font-bold text-slate-900 text-lg mb-2">Warftaufständerung +1,30 m</h3>
              <p class="text-gray-600 text-sm mb-3">Stahl-Fachwerk-Unterbau, Schraubfundamente in Marsch, Verankerung gegen Auftrieb.</p>
              <p class="text-xs text-gray-500"><strong class="text-slate-900">Hamburg-Bezug:</strong> HafenCity 1 m über NHN, Bemessungshochwasser 7,30 m – HPA-konforme Statik.</p>
            </div>

            <div class="bg-white border border-gray-100 rounded-xl p-6 hover:shadow-xl hover:border-primary/30 transition-all">
              <div class="text-xs font-bold text-[#7a9900] uppercase tracking-wider mb-2">03 · BSL-3 Schleuse</div>
              <h3 class="font-bold text-slate-900 text-lg mb-2">HEPA-H14 Unterdruckkaskade</h3>
              <p class="text-gray-600 text-sm mb-3">Drei-Zonen-Schleuse, -50 Pa Vorraum, -100 Pa Hochrisiko, redundante Lüftung nach TRBA 100.</p>
              <p class="text-xs text-gray-500"><strong class="text-slate-900">Hamburg-Bezug:</strong> das Hamburger Universitätsklinikum in Eppendorf, tropenmedizinische Forschungseinrichtungen in St. Pauli, virologische Forschungsinstitute.</p>
            </div>

            <div class="bg-white border border-gray-100 rounded-xl p-6 hover:shadow-xl hover:border-primary/30 transition-all">
              <div class="text-xs font-bold text-[#7a9900] uppercase tracking-wider mb-2">04 · Vibration</div>
              <h3 class="font-bold text-slate-900 text-lg mb-2">Entkopplung Klasse VC-D</h3>
              <p class="text-gray-600 text-sm mb-3">Federkern-Lagerung nach VDI 2038, Schwingungstoleranz unter 1 µm/s.</p>
              <p class="text-xs text-gray-500"><strong class="text-slate-900">Hamburg-Bezug:</strong> Forschungscampus Bahrenfeld Bahrenfeld – Synchrotron-Strahlungsquellen, Forschungslaser und Freie-Elektronen-Laser-Anlagen fordern Mikrometer-Präzision.</p>
            </div>

