---
import Layout from '../layouts/Layout.astro';

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": "Laborcontainer Wien",
  "description": "Mobile Containerlabore für Wiens Biotech-Cluster: Vienna BioCenter (IMP/IMBA), AKH/MedUni Wien, Boehringer Ingelheim. BSL-2, Reinraum, klinische Studien – schlüsselfertig von Planexus.",
  "provider": {
    "@type": "Organization",
    "name": "Planexus GmbH",
    "url": "https://www.planexus.de"
  },
  "areaServed": [
    { "@type": "City", "name": "Wien" },
    { "@type": "Country", "name": "Österreich" }
  ],
  "serviceType": ["Laborcontainer", "BSL-2 Container", "Biotech-Labor", "Reinraum-Container", "Klinisches Labor"],
  "url": "https://www.planexus.de/laborcontainer-wien"
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Start", "item": "https://www.planexus.de/" },
    { "@type": "ListItem", "position": 2, "name": "Laborcontainer Wien", "item": "https://www.planexus.de/laborcontainer-wien" }
  ]
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Können Containerlabore am Vienna BioCenter aufgestellt werden?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Ja. Das Vienna BioCenter im 3. Bezirk beherbergt sieben Forschungsinstitute mit über 100 Forschungsgruppen und rund 1.800 Beschäftigten. Containerlabore ergänzen die vorhandene Infrastruktur – für neue Forschungsgruppen, Kapazitätsspitzen oder Gebäudesanierungen."
      }
    },
    {
      "@type": "Question",
      "name": "Brauche ich in Wien eine Baugenehmigung für Laborcontainer?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Die Wiener Bauordnung kennt verschiedene Verfahrensstufen: bewilligungsfrei (§ 62a), Bauanzeige (§ 62) und Baubewilligungsverfahren (§ 70a/b). Laborcontainer mit besonderen Anforderungen (BSL, Gefahrstoffe) erfordern in der Regel eine Baubewilligung bei der MA 37. Wir klären die Verfahrensstufe im Vorfeld."
      }
    },
    {
      "@type": "Question",
      "name": "Wie weit ist Albstadt von Wien entfernt?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Rund 660 km über die A8 und A1 via Salzburg – etwa 6 bis 7 Stunden Fahrzeit. Wien ist der am weitesten entfernte Standort im DACH-Raum. Für Schwerlasttransporte planen wir zwei Tage ein (Transport + Aufstellung). Die Werksabnahme findet in Albstadt statt."
      }
    },
    {
      "@type": "Question",
      "name": "Gibt es Containerlabore für klinische Studien am AKH Wien?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Ja. Das AKH Wien / MedUni Wien ist mit 29 Universitätskliniken und über 400 Ambulanzen Europas größtes Klinikum. Klinische Studien erfordern dedizierte Laborkapazitäten – BSL-2-Container und Probenaufbereitungslabore auf dem Klinikgelände schaffen Entlastung."
      }
    },
    {
      "@type": "Question",
      "name": "Erfüllen die Container österreichische Normen (ÖNORM, ASchG)?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Ja. Unsere Container werden auf die Anforderungen des österreichischen Marktes angepasst: ÖNORM-Konformität, ArbeitnehmerInnenschutzgesetz (ASchG), Grenzwerteverordnung (GKV). Die Dokumentation erfolgt nach österreichischen Standards."
      }
    },
    {
      "@type": "Question",
      "name": "Was kostet ein Biotech-Container für Wien?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Die Kosten hängen von Ausstattung und Sicherheitsstufe ab. Die Transportkosten für Wien sind aufgrund der Distanz (~660 km) höher als für süddeutsche Standorte, aber durch effiziente Routenplanung (A8/A1, GO-Box-Maut für LKW über 3,5 t auf AT-Autobahnen) kalkulierbar."
      }
    }
  ]
};

const localBusinessSchema = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "name": "Planexus GmbH – Laborcontainer Wien",
  "description": "Containerlabore für Wien: Vienna BioCenter, AKH/MedUni Wien, Boehringer Ingelheim. Biotech, klinische Forschung, BSL-2 – ÖNORM-konform.",
  "url": "https://www.planexus.de",
  "telephone": "+49 7435 7519 700",
  "email": "info@planexus.de",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "Am Steinbach 8",
    "addressLocality": "Albstadt",
    "postalCode": "72459",
    "addressCountry": "DE"
  },
  "areaServed": [
    { "@type": "City", "name": "Wien" },
    { "@type": "Country", "name": "Österreich" }
  ]
};
---

<Layout
  title="Laborcontainer Wien – Vienna BioCenter, AKH & Biotech-Cluster | Planexus GmbH"
  description="Containerlabore für Wiens Life-Science-Hub: Vienna BioCenter (IMP/IMBA), AKH/MedUni Wien, Boehringer Ingelheim. BSL-2, GMP, klinische Studien – ÖNORM-konform."
  canonical="/laborcontainer-wien"
  schema={serviceSchema}
  ogImage="/attached_assets/Kopf_green-scaled_1768306688943.jpg"
>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} slot="head" />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} slot="head" />
  <script type="application/ld+json" set:html={JSON.stringify(localBusinessSchema)} slot="head" />

  <div class="pt-20 min-h-screen bg-white">

    <!-- Hero: Biotech-Cluster Donaustadt -->
    <section class="relative py-32 bg-slate-900 text-white overflow-hidden">
      <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_bottom_right,rgba(187,215,0,0.08),transparent_60%)]"></div>
      <div class="absolute top-0 left-1/3 w-[600px] h-[400px] bg-primary/4 rounded-full blur-[150px]"></div>

      <div class="container mx-auto px-4 relative z-10">
        <div class="max-w-4xl">
          <div class="flex items-center gap-3 mb-8">
            <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-white/10 text-primary text-sm font-medium backdrop-blur-sm border border-white/10">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
              Wien & Österreich
            </div>
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-red-700/20 text-red-400 text-xs font-bold border border-red-700/20">
              <span class="w-2 h-2 bg-red-400 rounded-full"></span>
              Österreich
            </div>
          </div>

          <h1 class="text-4xl md:text-5xl lg:text-6xl font-heading font-bold mb-6 leading-tight">
            Sieben Forschungsinstitute, ein Campus – <span class="text-primary">Wiens Biotech-Motor</span>
          </h1>
          <p class="text-xl text-gray-300 mb-4 leading-relaxed font-light max-w-3xl">
            Das Vienna BioCenter vereint IMP, IMBA und fünf weitere Institute auf einem Campus. Mit über 100 Forschungsgruppen und rund 1.800 Beschäftigten ist es eines der führenden Biotech-Zentren Europas. Dazu kommen Europas größtes Klinikum (AKH/MedUni Wien) und Boehringer Ingelheims größter Forschungsstandort außerhalb Deutschlands.
          </p>
          <p class="text-lg text-gray-400 mb-10 max-w-2xl">
            Wien ist Österreichs Life-Science-Hauptstadt – und das Tor nach Mittel- und Osteuropa.
          </p>

          <div class="flex flex-col sm:flex-row gap-4 mb-16">
            <a href="/kontakt" class="bg-primary text-slate-900 font-bold px-8 py-4 rounded-lg hover:bg-primary/90 transition-colors flex items-center justify-center gap-2 group shadow-[0_0_20px_rgba(187,215,0,0.3)]">
              Biotech-Projekt anfragen
              <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 group-hover:translate-x-1 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
            </a>
            <a href="tel:+4974357519700" class="border border-white/20 text-white font-medium px-8 py-4 rounded-lg hover:bg-white/10 transition-colors backdrop-blur-sm flex items-center justify-center gap-2">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
              +49 7435 7519 700
            </a>
          </div>

          <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
            <div class="bg-white/5 border border-white/10 rounded-xl p-4 text-center">
              <div class="text-2xl font-heading font-bold text-primary">7</div>
              <p class="text-gray-400 text-xs mt-1">Institute am VBC</p>
            </div>
            <div class="bg-white/5 border border-white/10 rounded-xl p-4 text-center">
              <div class="text-2xl font-heading font-bold text-primary">100+</div>
              <p class="text-gray-400 text-xs mt-1">Forschungsgruppen</p>
            </div>
            <div class="bg-white/5 border border-white/10 rounded-xl p-4 text-center">
              <div class="text-2xl font-heading font-bold text-primary">29</div>
              <p class="text-gray-400 text-xs mt-1">Unikliniken am AKH</p>
            </div>
            <div class="bg-white/5 border border-white/10 rounded-xl p-4 text-center">
              <div class="text-2xl font-heading font-bold text-primary">~660 km</div>
              <p class="text-gray-400 text-xs mt-1">Albstadt → Wien</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Breadcrumb -->
    <nav class="bg-gray-50 border-b border-gray-100 py-3">
      <div class="container mx-auto px-4">
        <ol class="flex items-center gap-2 text-sm text-gray-500">
          <li><a href="/" class="hover:text-primary transition-colors">Start</a></li>
          <li><svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg></li>
          <li class="text-primary font-medium">Laborcontainer Wien</li>
        </ol>
      </div>
    </nav>

    <!-- Section 1: Vienna BioCenter -->
    <section class="py-20 bg-white">
      <div class="container mx-auto px-4">
        <div class="max-w-5xl mx-auto">
          <h2 class="text-3xl md:text-4xl font-heading font-bold mb-6 text-slate-900">
            Vienna BioCenter: Sieben Institute, ein Biotech-Ökosystem
          </h2>
          <p class="text-gray-600 text-lg mb-12 leading-relaxed max-w-3xl">
            Das Vienna BioCenter (VBC) im 3. Bezirk hat sich in drei Jahrzehnten zu einem der führenden biologischen Forschungszentren Europas entwickelt. Sieben Einrichtungen arbeiten hier an Grundlagenforschung, die in Therapien und Technologien mündet.
          </p>

          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            <div class="bg-white rounded-xl border border-gray-200 p-6 hover:shadow-lg transition-shadow">
              <h3 class="font-bold text-slate-900 mb-2">IMP – Institut für Molekulare Pathologie</h3>
              <p class="text-gray-600 text-sm leading-relaxed">Grundlagenforschung in Molekularbiologie. Gegründet 1985 als Kooperation mit Boehringer Ingelheim. Rund 200 Forschende aus über 40 Nationen.</p>
            </div>
            <div class="bg-white rounded-xl border border-gray-200 p-6 hover:shadow-lg transition-shadow">
              <h3 class="font-bold text-slate-900 mb-2">IMBA – Institut für Molekulare Biotechnologie</h3>
              <p class="text-gray-600 text-sm leading-relaxed">Biomedizinische Grundlagenforschung der ÖAW. Bekannt für Organoid-Forschung. Publiziert regelmäßig in Nature und Cell.</p>
            </div>
            <div class="bg-white rounded-xl border border-gray-200 p-6 hover:shadow-lg transition-shadow">
              <h3 class="font-bold text-slate-900 mb-2">GMI – Gregor Mendel Institut</h3>
              <p class="text-gray-600 text-sm leading-relaxed">Pflanzenbiologie und Epigenetik. Basisforschung mit Implikationen für Agrarbiotechnologie und Umweltforschung.</p>
            </div>
            <div class="bg-white rounded-xl border border-gray-200 p-6 hover:shadow-lg transition-shadow">
              <h3 class="font-bold text-slate-900 mb-2">Max Perutz Labs</h3>
              <p class="text-gray-600 text-sm leading-relaxed">Kooperation von Universität Wien und MedUni Wien. Strukturbiologie, Biochemie und Zellbiologie unter einem Dach.</p>
            </div>
            <div class="bg-white rounded-xl border border-gray-200 p-6 hover:shadow-lg transition-shadow">
              <h3 class="font-bold text-slate-900 mb-2">CeMESS & weitere</h3>
              <p class="text-gray-600 text-sm leading-relaxed">Center for Molecular Evolution and Systematics. Ergänzt durch die VBC PhD Programme und Infrastruktureinheiten.</p>
            </div>
            <div class="bg-primary/5 rounded-xl border border-primary/20 p-6">
              <h3 class="font-bold text-slate-900 mb-2">Laborcontainer am VBC</h3>
              <p class="text-gray-600 text-sm leading-relaxed">Neue Forschungsgruppen, Kapazitätserweiterungen, Gebäudesanierungen – Containerlabore liefern BSL-2, Zellkultur und Analytik in Wochen statt Jahren.</p>
            </div>
          </div>
          <p class="text-xs text-gray-400 mt-6">Quelle: Vienna BioCenter, vbc.ac.at</p>
        </div>
      </div>
    </section>

    <!-- Section 2: AKH & MedUni Wien -->
    <section class="py-20 bg-slate-900 text-white">
      <div class="container mx-auto px-4">
        <div class="max-w-5xl mx-auto">
          <h2 class="text-3xl md:text-4xl font-heading font-bold mb-6">
            AKH Wien & MedUni Wien: Europas größtes Klinikum braucht Laborraum
          </h2>
          <p class="text-gray-400 text-lg mb-12 leading-relaxed max-w-3xl">
            Das Allgemeine Krankenhaus der Stadt Wien (AKH) und die Medizinische Universität Wien bilden zusammen Europas größtes Universitätsklinikum. Mit 29 Universitätskliniken und über 400 Ambulanzen ist die Infrastruktur gewaltig – und der Bedarf an zusätzlicher Laborkapazität permanent.
          </p>

          <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
            <div class="bg-white/5 border border-white/10 rounded-2xl p-8">
              <h3 class="font-heading font-bold text-lg text-primary mb-6">AKH Wien – Kennzahlen</h3>
              <div class="space-y-4">
                <div class="flex items-center justify-between">
                  <span class="text-gray-300">Universitätskliniken</span>
                  <span class="font-bold text-white text-lg">29</span>
                </div>
                <div class="border-t border-white/10"></div>
                <div class="flex items-center justify-between">
                  <span class="text-gray-300">Klinische Abteilungen</span>
                  <span class="font-bold text-white text-lg">35</span>
                </div>
                <div class="border-t border-white/10"></div>
                <div class="flex items-center justify-between">
                  <span class="text-gray-300">Ambulanzen</span>
                  <span class="font-bold text-white text-lg">>400</span>
                </div>
                <div class="border-t border-white/10"></div>
                <div class="flex items-center justify-between">
                  <span class="text-gray-300">Klinische Studien</span>
                  <span class="font-bold text-primary text-lg">Hunderte/Jahr</span>
                </div>
              </div>
              <p class="text-gray-500 text-xs mt-6">Quelle: AKH Wien / MedUni Wien</p>
            </div>

            <div class="space-y-6">
              <div class="bg-white/5 border border-white/10 rounded-xl p-6">
                <h3 class="text-primary font-bold mb-3">Klinische Studien</h3>
                <p class="text-gray-300 text-sm leading-relaxed">
                  Die MedUni Wien ist einer der aktivsten klinischen Forschungsstandorte Europas. Hunderte klinische Studien laufen parallel – jede mit eigenen Laboranforderungen. BSL-2-Container und Probenaufbereitungslabore entlasten die Bestandsinfrastruktur.
                </p>
              </div>
              <div class="bg-white/5 border border-white/10 rounded-xl p-6">
                <h3 class="text-primary font-bold mb-3">Gebäudesanierung</h3>
                <p class="text-gray-300 text-sm leading-relaxed">
                  Das AKH-Gebäude stammt aus den 1990er-Jahren. Laborbereiche werden sukzessive modernisiert – der Betrieb muss weiterlaufen. Containerlabore auf dem Klinikgelände ermöglichen ununterbrochene Diagnostik und Forschung.
                </p>
              </div>
              <div class="bg-white/5 border border-white/10 rounded-xl p-6">
                <h3 class="text-primary font-bold mb-3">CEE-Gateway</h3>
                <p class="text-gray-300 text-sm leading-relaxed">
                  Wien ist das Tor zu Mittel- und Osteuropa. Internationale klinische Studien mit CEE-Partnern werden häufig von Wien aus koordiniert. Dedizierte Laborkapazität vor Ort ist dafür unerlässlich.
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Section 3: Boehringer Ingelheim -->
    <section class="py-20 bg-white">
      <div class="container mx-auto px-4">
        <div class="max-w-5xl mx-auto">
          <span class="text-primary text-sm font-bold uppercase tracking-wider">Pharmaindustrie</span>
          <h2 class="text-3xl font-heading font-bold mt-3 mb-6 text-slate-900">
            Boehringer Ingelheim Wien – seit 1948 in Österreich
          </h2>

          <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-start">
            <div>
              <p class="text-gray-600 text-lg leading-relaxed mb-6">
                Boehringer Ingelheims Regional Center Vienna (RCV) in Wien-Meidling ist der erste internationale Standort des Familienunternehmens – gegründet 1948. Von hier aus werden über 30 Länder in Mittel- und Osteuropa sowie Zentralasien gesteuert.
              </p>
              <p class="text-gray-600 leading-relaxed mb-6">
                Das RCV vereint Forschung, Entwicklung und Produktion. Mit einem Umsatz von über 1,3 Milliarden Euro (2023) ist es ein wirtschaftliches Schwergewicht in Österreich. Die pharmazeutische Qualitätskontrolle am Standort erfordert permanente Laborkapazität – Containerlabore ergänzen bei Produktionserweiterungen und Validierungsprojekten.
              </p>
              <div class="bg-primary/5 border border-primary/20 rounded-xl p-5">
                <p class="text-slate-700 text-sm leading-relaxed">
                  <strong>IMP-Kooperation:</strong> Das IMP am Vienna BioCenter wurde 1985 als Grundlagenforschungsinstitut in Kooperation mit Boehringer Ingelheim gegründet. Die Nähe zwischen industrieller F&E und akademischer Forschung ist ein Alleinstellungsmerkmal Wiens.
                </p>
              </div>
            </div>

            <div class="bg-gradient-to-br from-slate-50 to-white rounded-2xl p-8 border border-gray-100">
              <h3 class="text-xl font-heading font-bold text-slate-900 mb-4">Boehringer Ingelheim RCV</h3>
              <div class="space-y-3 text-sm mb-4">
                <div class="flex justify-between"><span class="text-gray-500">Standort</span><span class="font-bold text-slate-900">Wien-Meidling</span></div>
                <div class="flex justify-between"><span class="text-gray-500">Gegründet</span><span class="font-bold text-slate-900">1948</span></div>
                <div class="flex justify-between"><span class="text-gray-500">Umsatz RCV 2023</span><span class="font-bold text-slate-900">>1,3 Mrd. EUR</span></div>
                <div class="flex justify-between"><span class="text-gray-500">Verantwortungsbereich</span><span class="font-bold text-slate-900">>30 Länder (CEE/CIS)</span></div>
              </div>
              <p class="text-xs text-gray-400 mt-3">Quelle: Boehringer Ingelheim RCV, Wien</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Section 4: ÖNORM & Wiener Bauordnung -->
    <section class="py-20 bg-slate-50 border-t border-gray-100">
      <div class="container mx-auto px-4">
        <div class="max-w-4xl mx-auto">
          <h2 class="text-3xl font-heading font-bold mb-4 text-slate-900">
            Wiener Bauordnung und ÖNORM: Was in Österreich gilt
          </h2>
          <p class="text-gray-600 text-lg mb-10 leading-relaxed">
            Wien hat eine eigene Bauordnung (BO für Wien), die sich von den Bauordnungen der Bundesländer unterscheidet. Für Laborcontainer ist die zuständige Behörde die MA 37 (Baupolizei).
          </p>

          <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            <div class="bg-white rounded-xl p-6 border border-gray-200">
              <div class="w-10 h-10 bg-slate-900 rounded-lg flex items-center justify-center text-primary mb-4 text-sm font-bold">§</div>
              <h3 class="font-bold text-lg mb-3 text-slate-900">Wiener Bauordnung</h3>
              <p class="text-gray-600 text-sm leading-relaxed">
                Die BO für Wien kennt drei Verfahrensstufen: bewilligungsfrei (§ 62a), Bauanzeige (§ 62) und Baubewilligungsverfahren (§ 70a/b). Labore mit Gefahrstoffen oder BSL-Ausstattung erfordern in der Regel eine Baubewilligung.
              </p>
            </div>
            <div class="bg-white rounded-xl p-6 border border-gray-200">
              <div class="w-10 h-10 bg-slate-900 rounded-lg flex items-center justify-center text-primary mb-4 text-sm font-bold">ÖN</div>
              <h3 class="font-bold text-lg mb-3 text-slate-900">ÖNORM-Konformität</h3>
              <p class="text-gray-600 text-sm leading-relaxed">
                Österreichische Normen (ÖNORM) definieren technische Anforderungen an Bauwerke, Haustechnik und Arbeitssicherheit. Unsere Container werden auf ÖNORM-Konformität angepasst – von Elektrik bis Brandschutz.
              </p>
            </div>
            <div class="bg-white rounded-xl p-6 border border-gray-200">
              <div class="w-10 h-10 bg-slate-900 rounded-lg flex items-center justify-center text-primary mb-4 text-sm font-bold">AS</div>
              <h3 class="font-bold text-lg mb-3 text-slate-900">ASchG – Arbeitssicherheit</h3>
              <p class="text-gray-600 text-sm leading-relaxed">
                Das ArbeitnehmerInnenschutzgesetz (ASchG) und die Grenzwerteverordnung (GKV) stellen spezifische Anforderungen an Labore. Belüftung, Beleuchtung, Fluchtwege und Gefahrstoffhandhabung – alles nach österreichischem Recht.
              </p>
            </div>
          </div>

          <div class="mt-8 bg-primary/5 border border-primary/20 rounded-xl p-6">
            <p class="text-slate-700 text-sm leading-relaxed">
